export let SPEC_FORMAT = 4;      // u16
export let SPEC_CHANNELS = 6;    // u8
export let SPEC_SILENCE = 7;     // u8
export let SPEC_SAMPLES = 8;     // u16
export let SPEC_SIZE = 12;       // u32 (bytes in the device buffer)
export let SPEC_CALLBACK = 16;   // ptr  <- MUST be NULL for queue mode
