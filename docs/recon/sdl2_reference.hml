// sdl2_reference.hml — the complete, verified SDL2 FFI surface for Nightshade.
//
// STATUS: every signature and constant here was verified against the SDL2
// headers on this machine (see docs/recon/SDL_FFI.md and docs/recon/sdl_abi_dump.txt)
// and every risky call was exercised from Hemlock, interpreted AND compiled,
// headless AND on a real GPU (tools/probes/).
//
// This file is a reference/drop-in: copy to src/sdl2.hml (or import directly).
// It intentionally contains ONLY bindings + tiny accessors — no game logic.
//
// Runtime dependency: libSDL2-2.0.so.0 (verified SDL 2.0.20). Nothing else.
// SDL2_mixer is NOT used and NOT required.

import "libSDL2-2.0.so.0";

// ===========================================================================
// LIFECYCLE / ERROR
// ===========================================================================
export extern fn SDL_Init(flags: u32): i32;
export extern fn SDL_InitSubSystem(flags: u32): i32;
export extern fn SDL_QuitSubSystem(flags: u32): void;
export extern fn SDL_Quit(): void;
export extern fn SDL_GetError(): string;
export extern fn SDL_ClearError(): void;
export extern fn SDL_SetHint(name: string, value: string): i32;
export extern fn SDL_GetCurrentVideoDriver(): string;
export extern fn SDL_GetCurrentAudioDriver(): string;
export extern fn SDL_GetVersion(ver: ptr): void;

// ===========================================================================
// WINDOW / RENDERER
// ===========================================================================
