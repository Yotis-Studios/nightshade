export let SDL_FLIP_VERTICAL = 2;

// Pixel formats. On little-endian x86-64, RGBA32 == ABGR8888 and its BYTE order
// in memory is R,G,B,A — this is the one to use for 32-bit RGBA pixel uploads.
export let SDL_PIXELFORMAT_RGB24 = 386930691;           // byte order R,G,B
export let SDL_PIXELFORMAT_RGBA32 = 376840196;          // byte order R,G,B,A
export let SDL_PIXELFORMAT_ARGB8888 = 372645892;        // byte order B,G,R,A
export let SDL_PIXELFORMAT_RGB565 = 353701890;

