export extern fn SDL_GetRendererOutputSize(ren: ptr, w: ptr, h: ptr): i32;
export extern fn SDL_RenderSetLogicalSize(ren: ptr, w: i32, h: i32): i32;
export extern fn SDL_RenderGetLogicalSize(ren: ptr, w: ptr, h: ptr): void;
