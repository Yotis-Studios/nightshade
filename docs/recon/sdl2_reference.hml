export extern fn SDL_SetWindowFullscreen(win: ptr, flags: u32): i32;
export extern fn SDL_GetWindowFlags(win: ptr): u32;
export extern fn SDL_GetWindowSize(win: ptr, w: ptr, h: ptr): void;
export extern fn SDL_SetWindowSize(win: ptr, w: i32, h: i32): void;
export extern fn SDL_RaiseWindow(win: ptr): void;
export extern fn SDL_SetWindowGrab(win: ptr, grabbed: i32): void;

export extern fn SDL_CreateRenderer(win: ptr, index: i32, flags: u32): ptr;
export extern fn SDL_DestroyRenderer(ren: ptr): void;
