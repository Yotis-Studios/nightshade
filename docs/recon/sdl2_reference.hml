export let CVT_NEEDED = 0;       // i32
export let CVT_BUF = 16;         // ptr
export let CVT_LEN = 24;         // i32
export let CVT_LEN_CVT = 28;     // i32
export let CVT_LEN_MULT = 32;    // i32

// Scancodes (index into SDL_GetKeyboardState) — held-key polling.
export let SC_A = 4;  export let SC_B = 5;  export let SC_C = 6;  export let SC_D = 7;
export let SC_E = 8;  export let SC_F = 9;  export let SC_G = 10; export let SC_Q = 20;
export let SC_R = 21; export let SC_S = 22; export let SC_T = 23; export let SC_V = 25;
export let SC_W = 26; export let SC_X = 27; export let SC_Z = 29;
export let SC_1 = 30; export let SC_2 = 31; export let SC_3 = 32; export let SC_4 = 33;
export let SC_5 = 34; export let SC_0 = 39;
export let SC_RETURN = 40; export let SC_ESCAPE = 41; export let SC_BACKSPACE = 42;
export let SC_TAB = 43;    export let SC_SPACE = 44;  export let SC_GRAVE = 53;
export let SC_F1 = 58;     export let SC_F5 = 62;     export let SC_F11 = 68;
export let SC_LCTRL = 224; export let SC_LSHIFT = 225; export let SC_LALT = 226;
export let SC_RCTRL = 228; export let SC_RSHIFT = 229;
export let SC_RIGHT = 79;  export let SC_LEFT = 80;   export let SC_DOWN = 81; export let SC_UP = 82;
export let SDL_NUM_SCANCODES = 512;

// Keycodes (event.key.keysym.sym at offset 20)
export let SDLK_ESCAPE = 27;  export let SDLK_SPACE = 32; export let SDLK_RETURN = 13;
export let SDLK_TAB = 9;      export let SDLK_BACKQUOTE = 96;
export let SDLK_w = 119; export let SDLK_a = 97;  export let SDLK_s = 115; export let SDLK_d = 100;
export let SDLK_e = 101; export let SDLK_q = 113; export let SDLK_r = 114;  export let SDLK_f = 102;
export let SDLK_F1 = 1073741882; export let SDLK_F5 = 1073741886; export let SDLK_F11 = 1073741892;
export let SDLK_LSHIFT = 1073742049; export let SDLK_LCTRL = 1073742048;

// SDL_Vertex (SDL_RenderGeometry) is 20 bytes:
//   0  position.x : f32
//   4  position.y : f32
//   8  color.r,g,b,a : u8 x4
//   12 tex_coord.x : f32
//   16 tex_coord.y : f32
export let SDL_VERTEX_SIZE = 20;
export let VTX_X = 0;
export let VTX_Y = 4;
export let VTX_RGBA = 8;
export let VTX_U = 12;
export let VTX_V = 16;

// SDL_Rect / SDL_FRect are 16 bytes (x,y,w,h); SDL_Point / SDL_FPoint are 8.
export let SDL_RECT_SIZE = 16;
export let SDL_POINT_SIZE = 8;

// ===========================================================================
// SMALL HELPERS (pure Hemlock, no state)
// ===========================================================================

// Allocate and fill an SDL_Rect. Caller owns the pointer.
export fn rect(x: i32, y: i32, w: i32, h: i32): ptr {
    let r = alloc(SDL_RECT_SIZE);
    ptr_write_i32(r, x);
    ptr_write_i32(ptr_offset(r, 1, 4), y);
    ptr_write_i32(ptr_offset(r, 2, 4), w);
    ptr_write_i32(ptr_offset(r, 3, 4), h);
    return r;
}
// Overwrite an existing SDL_Rect in place — use this in the frame loop so you
// are not calling alloc() per draw call.
export fn rect_set(r: ptr, x: i32, y: i32, w: i32, h: i32) {
    ptr_write_i32(r, x);
    ptr_write_i32(ptr_offset(r, 1, 4), y);
    ptr_write_i32(ptr_offset(r, 2, 4), w);
    ptr_write_i32(ptr_offset(r, 3, 4), h);
}

export fn ev_type(ev: ptr): i32 { return ptr_deref_u32(ev); }
export fn ev_i32(ev: ptr, off: i32): i32 { return ptr_deref_i32(ptr_offset(ev, off, 1)); }
export fn ev_u8(ev: ptr, off: i32): i32 { return ptr_deref_u8(ptr_offset(ev, off, 1)); }

// Held-key polling: `state` comes from SDL_GetKeyboardState(null).
export fn held(state: ptr, scancode: i32): bool {
    return ptr_deref_u8(ptr_offset(state, scancode, 1)) != 0;
}

// Write one SDL_Vertex into a packed array.
export fn vertex_set(base: ptr, i: i32, x: f64, y: f64,
                     r: i32, g: i32, b: i32, a: i32, u: f64, v: f64) {
    let p = ptr_offset(base, i * SDL_VERTEX_SIZE, 1);
    ptr_write_f32(p, x);
    ptr_write_f32(ptr_offset(p, 4, 1), y);
    ptr_write_u8(ptr_offset(p, 8, 1), r);
    ptr_write_u8(ptr_offset(p, 9, 1), g);
    ptr_write_u8(ptr_offset(p, 10, 1), b);
    ptr_write_u8(ptr_offset(p, 11, 1), a);
    ptr_write_f32(ptr_offset(p, 12, 1), u);
    ptr_write_f32(ptr_offset(p, 16, 1), v);
}

// Build an SDL_AudioSpec for QUEUE mode (callback = NULL).
export fn audiospec_new(freq: i32, fmt: i32, channels: i32, samples: i32): ptr {
    let s = alloc(SDL_AUDIOSPEC_SIZE);
    let i = 0;
    while (i < SDL_AUDIOSPEC_SIZE) { ptr_write_u8(ptr_offset(s, i, 1), 0); i = i + 1; }
    ptr_write_i32(ptr_offset(s, SPEC_FREQ, 1), freq);
    ptr_write_u16(ptr_offset(s, SPEC_FORMAT, 1), fmt);
    ptr_write_u8(ptr_offset(s, SPEC_CHANNELS, 1), channels);
    ptr_write_u16(ptr_offset(s, SPEC_SAMPLES, 1), samples);
    ptr_write_ptr(ptr_offset(s, SPEC_CALLBACK, 1), null);
    ptr_write_ptr(ptr_offset(s, SPEC_USERDATA, 1), null);
    return s;
}
export fn spec_freq(s: ptr): i32     { return ptr_deref_i32(ptr_offset(s, SPEC_FREQ, 1)); }
export fn spec_format(s: ptr): i32   { return ptr_deref_u16(ptr_offset(s, SPEC_FORMAT, 1)); }
export fn spec_channels(s: ptr): i32 { return ptr_deref_u8(ptr_offset(s, SPEC_CHANNELS, 1)); }
export fn spec_samples(s: ptr): i32  { return ptr_deref_u16(ptr_offset(s, SPEC_SAMPLES, 1)); }
export fn spec_bufsize(s: ptr): i32  { return ptr_deref_u32(ptr_offset(s, SPEC_SIZE, 1)); }

// Seconds elapsed between two SDL_GetPerformanceCounter() samples.
export fn perf_seconds(t0: u64, t1: u64, freq: u64): f64 {
    return (t1 - t0) / freq;
}
