// hudgen.hml — ATLAS_HUD generator.  Nightshade W2-7.
//
//   128 x 128 RGBA8, uploaded with BLEND_BLEND.  ARCHITECTURE.md §4 layer 3.
//   Contains: FONT_MICRO (4x6), FONT_BIG (8x12), the icon set, the crosshair
//   and hitmarker parts, the compass and minimap chrome, and the vignette
//   gradient strip.  Laid out to ART_BIBLE §9 in exact 320x240 pixel terms.
//
// ---------------------------------------------------------------------------
// WHY THE ATLAS IS WHITE AND THE COLOUR IS IN THE VERTEX
// ---------------------------------------------------------------------------
// The HUD layer is BLEND and vertex colour MULTIPLIES the texel (CLAUDE.md §6),
// so a glyph baked at (255,255,255) tinted by `g_UI_AMBER` produces EXACTLY
// `g_UI_AMBER`, while a glyph baked at some warm white produces amber times
// that white — close, but never the palette value the art bible specifies.
// (255,255,255) here is therefore not a colour choice, it is the TINT IDENTITY;
// this file names no colour and contains no hex literal.  The one colour it
// does import is `g_UI_BLACK`, for the 1-px outline that ART_BIBLE §9.1 makes
// mandatory — an outline cannot be vertex-tinted because it shares its quad
// with the thing it outlines.
//
// ---------------------------------------------------------------------------
// WHY FONT_BIG IS DRAWN, NOT SCALED (ART_BIBLE §9.4, anti-goal §13.8)
// ---------------------------------------------------------------------------
// A 4x6 font scaled 2x is a 4x6 font with fat pixels: the stems double from
// 1 px to 2 px but so do the counters, so the digit fills in and reads as a
// blur at 320x240.  FONT_BIG is an independent 8x12 face with a UNIFORM 2-px
// stroke and 1-px counters — `hudgen_selftest` asserts the 2-px weight by
// run-length over the bitfields, in both axes, on all ten digits, so nobody
// can quietly replace it with a scaled micro font.
//
// ---------------------------------------------------------------------------
// TEXEL MAP (all coordinates in atlas texels)
// ---------------------------------------------------------------------------
//   y  0 .. 11   FONT_MICRO, 32 glyph cells per row x 4 px = 128, 2 rows of 6
//   y 12 .. 23   FONT_BIG,   16 glyph cells per row x 8 px = 128, 1 row of 12
//   y 24 .. 31   icons (8x8 and smaller)
//   y 32 .. 47   crosshair / hitmarker / compass parts
//   y 48 .. 55   minimap chrome
//   y 56 .. 59   vignette gradient strip + the solid white block
//   y 60 .. 127  reserved

import { divi } from "@stdlib/math";
import { bayer4 } from "../core/mathx.hml";
import { g_UI_BLACK, pal_r, pal_g, pal_b } from "./palette.hml";
import { atlas_new, atlas_data, atlas_base, atlas_fill, atlas_rect_uv,
         atlas_get } from "../../../wobbleweed/src/atlas.hml";
import { font_new, font_add_glyph, font_bake, font_glyph_index,
         font_glyph_count, font_set_glyph_advance,
         font_width } from "../../../wobbleweed/src/font.hml";

export let HUD_ATLAS_W = 128;
export let HUD_ATLAS_H = 128;

// FONT_MICRO — 4x6 cell, 3-px ink (4-px for M/N/W), 8-px line pitch (§9.4).
export let HUD_MICRO_W    = 4;
export let HUD_MICRO_H    = 6;
export let HUD_MICRO_ADV  = 4;
export let HUD_MICRO_LINE = 8;
export let HUD_MICRO_N    = 50;
export let HUD_MICRO_COLS = 32;

// FONT_BIG — 8x12 cell, 7-px ink with a uniform 2-px stroke, 14-px line pitch.
export let HUD_BIG_W    = 8;
export let HUD_BIG_H    = 12;
export let HUD_BIG_ADV  = 8;
export let HUD_BIG_LINE = 14;
export let HUD_BIG_N    = 12;
export let HUD_BIG_COLS = 16;
export let HUD_BIG_Y    = 12;

// ---------------------------------------------------------------------------
// sprite ids.  `hudgen_rect(id, out, off)` gives texels, `hudgen_uv` gives the
// half-texel-inset uv rect.  Every icon is drawn with a 1-px transparent gutter
// so the mandatory UI_BLACK outline lands INSIDE its own rect and can never
// bleed into a neighbour.
// ---------------------------------------------------------------------------

export let HUD_ICON_HEART    = 0;    // health numeral prefix, 8x8 at (10,208)
export let HUD_ICON_AMMO     = 1;
export let HUD_ICON_SKULL    = 2;    // killfeed
export let HUD_ICON_XP       = 3;
export let HUD_ICON_LANTERN  = 4;
export let HUD_ICON_SHIELD   = 5;
export let HUD_ICON_HEADSHOT = 6;
export let HUD_ICON_WEAPON   = 7;    // 8x6, sits between killfeed names
export let HUD_ICON_DIAMOND  = 8;    // objective marker, 5x5 outline in a 7x7
export let HUD_ICON_ARROW    = 9;    // off-screen objective / hit direction
export let HUD_ICON_PLAYER   = 10;   // minimap player triangle
export let HUD_ICON_ENEMY    = 11;   // minimap enemy blip, 2x2 in a 4x4
export let HUD_ICON_OBJDOT   = 12;   // minimap objective diamond, 3x3 in a 5x5
export let HUD_XH_TICK_V     = 13;   // crosshair vertical tick, 1x4 + outline
export let HUD_XH_TICK_H     = 14;   // crosshair horizontal tick, 4x1 + outline
export let HUD_XH_DOT        = 15;
export let HUD_HITMARK       = 16;   // all four diagonal ticks in one 16x16
export let HUD_CHEVRON       = 17;   // compass centre marker at (160,4)
export let HUD_TICK_MINOR    = 18;   // compass 10-degree tick
export let HUD_TICK_MAJOR    = 19;   // compass 45-degree tick
export let HUD_PIP           = 20;   // compass objective pip
export let HUD_MM_CORNER     = 21;   // minimap corner bracket, 4x with uv flips
export let HUD_MM_EDGE_H     = 22;
export let HUD_MM_EDGE_V     = 23;
export let HUD_VIGNETTE      = 24;   // 64x4 alpha ramp, dithered
export let HUD_SOLID         = 25;   // opaque white block: bars, plates, lines
export let HUD_RECT_COUNT    = 26;

// ---------------------------------------------------------------------------
// module state
// ---------------------------------------------------------------------------

let g_hud_atlas = null;
let g_hud_micro = null;
let g_hud_big = null;
let g_hud_rect: array<i32> = [];

export fn hudgen_atlas() { return g_hud_atlas; }
export fn hud_font_micro() { return g_hud_micro; }
export fn hud_font_big() { return g_hud_big; }

// Texel rect of a sprite: out[off..off+3] = x, y, w, h.
export fn hudgen_rect(id: i32, out: array<i32>, off: i32) {
    if (id < 0 || id >= HUD_RECT_COUNT) {
        out[off] = 0; out[off + 1] = 0; out[off + 2] = 0; out[off + 3] = 0;
        return;
    }
    let s: i32 = id * 4;
    out[off] = g_hud_rect[s];
    out[off + 1] = g_hud_rect[s + 1];
    out[off + 2] = g_hud_rect[s + 2];
    out[off + 3] = g_hud_rect[s + 3];
}

// Half-texel-inset uv rect of a sprite: out[off..off+3] = u0, v0, u1, v1.
export fn hudgen_uv(id: i32, out: array<f64>, off: i32) {
    if (g_hud_atlas == null || id < 0 || id >= HUD_RECT_COUNT) {
        out[off] = 0.0; out[off + 1] = 0.0; out[off + 2] = 0.0; out[off + 3] = 0.0;
        return;
    }
    let s: i32 = id * 4;
    atlas_rect_uv(g_hud_atlas, g_hud_rect[s], g_hud_rect[s + 1],
                  g_hud_rect[s + 2], g_hud_rect[s + 3], out, off);
}

export fn hudgen_sprite_name(id: i32): string {
    if (id == HUD_ICON_HEART) { return "HEART"; }
    if (id == HUD_ICON_AMMO) { return "AMMO"; }
    if (id == HUD_ICON_SKULL) { return "SKULL"; }
    if (id == HUD_ICON_XP) { return "XP"; }
    if (id == HUD_ICON_LANTERN) { return "LANTERN"; }
    if (id == HUD_ICON_SHIELD) { return "SHIELD"; }
    if (id == HUD_ICON_HEADSHOT) { return "HEADSHOT"; }
    if (id == HUD_ICON_WEAPON) { return "WEAPON"; }
    if (id == HUD_ICON_DIAMOND) { return "DIAMOND"; }
    if (id == HUD_ICON_ARROW) { return "ARROW"; }
    if (id == HUD_ICON_PLAYER) { return "PLAYER"; }
    if (id == HUD_ICON_ENEMY) { return "ENEMY"; }
    if (id == HUD_ICON_OBJDOT) { return "OBJDOT"; }
    if (id == HUD_XH_TICK_V) { return "XH TICK V"; }
    if (id == HUD_XH_TICK_H) { return "XH TICK H"; }
    if (id == HUD_XH_DOT) { return "XH DOT"; }
    if (id == HUD_HITMARK) { return "HITMARK"; }
    if (id == HUD_CHEVRON) { return "CHEVRON"; }
    if (id == HUD_TICK_MINOR) { return "TICK MINOR"; }
    if (id == HUD_TICK_MAJOR) { return "TICK MAJOR"; }
    if (id == HUD_PIP) { return "PIP"; }
    if (id == HUD_MM_CORNER) { return "MM CORNER"; }
    if (id == HUD_MM_EDGE_H) { return "MM EDGE H"; }
    if (id == HUD_MM_EDGE_V) { return "MM EDGE V"; }
    if (id == HUD_VIGNETTE) { return "VIGNETTE"; }
    if (id == HUD_SOLID) { return "SOLID"; }
    return "";
}

// ===========================================================================
// FONT_MICRO — 4x6 cells.  One i32 per row, top row first, leftmost pixel in
// bit 3 (font.hml's encoding).  3-px ink leaves bit 0 as the 1-px inter-
// character gutter that ART_BIBLE §9.4 asks for; M, N and W use the full 4 px
// and take an advance of 5 instead, because a 3-px M is a blob.
// ===========================================================================

fn micro_rows(i: i32): array<i32> {
    if (i == 0) { return [0b0100, 0b1010, 0b1110, 0b1010, 0b1010, 0b0000]; }   // A
    if (i == 1) { return [0b1100, 0b1010, 0b1100, 0b1010, 0b1100, 0b0000]; }   // B
    if (i == 2) { return [0b0110, 0b1000, 0b1000, 0b1000, 0b0110, 0b0000]; }   // C
    if (i == 3) { return [0b1100, 0b1010, 0b1010, 0b1010, 0b1100, 0b0000]; }   // D
    if (i == 4) { return [0b1110, 0b1000, 0b1100, 0b1000, 0b1110, 0b0000]; }   // E
    if (i == 5) { return [0b1110, 0b1000, 0b1100, 0b1000, 0b1000, 0b0000]; }   // F
    if (i == 6) { return [0b0110, 0b1000, 0b1010, 0b1010, 0b0110, 0b0000]; }   // G
    if (i == 7) { return [0b1010, 0b1010, 0b1110, 0b1010, 0b1010, 0b0000]; }   // H
    if (i == 8) { return [0b1110, 0b0100, 0b0100, 0b0100, 0b1110, 0b0000]; }   // I
    if (i == 9) { return [0b0010, 0b0010, 0b0010, 0b1010, 0b0100, 0b0000]; }   // J
    if (i == 10) { return [0b1010, 0b1010, 0b1100, 0b1010, 0b1010, 0b0000]; }  // K
    if (i == 11) { return [0b1000, 0b1000, 0b1000, 0b1000, 0b1110, 0b0000]; }  // L
    if (i == 12) { return [0b1001, 0b1111, 0b1111, 0b1001, 0b1001, 0b0000]; }  // M  (4 wide, adv 5)
    if (i == 13) { return [0b1001, 0b1101, 0b1111, 0b1011, 0b1001, 0b0000]; }  // N  (4 wide, adv 5)
    if (i == 14) { return [0b0100, 0b1010, 0b1010, 0b1010, 0b0100, 0b0000]; }  // O
    if (i == 15) { return [0b1100, 0b1010, 0b1100, 0b1000, 0b1000, 0b0000]; }  // P
    if (i == 16) { return [0b0100, 0b1010, 0b1010, 0b0100, 0b0010, 0b0000]; }  // Q
    if (i == 17) { return [0b1100, 0b1010, 0b1100, 0b1010, 0b1010, 0b0000]; }  // R
    if (i == 18) { return [0b0110, 0b1000, 0b0100, 0b0010, 0b1100, 0b0000]; }  // S
    if (i == 19) { return [0b1110, 0b0100, 0b0100, 0b0100, 0b0100, 0b0000]; }  // T
    if (i == 20) { return [0b1010, 0b1010, 0b1010, 0b1010, 0b1110, 0b0000]; }  // U
    if (i == 21) { return [0b1010, 0b1010, 0b1010, 0b1010, 0b0100, 0b0000]; }  // V
    if (i == 22) { return [0b1001, 0b1001, 0b1001, 0b1111, 0b0110, 0b0000]; }  // W  (4 wide, adv 5)
    if (i == 23) { return [0b1010, 0b1010, 0b0100, 0b1010, 0b1010, 0b0000]; }  // X
    if (i == 24) { return [0b1010, 0b1010, 0b0100, 0b0100, 0b0100, 0b0000]; }  // Y
    if (i == 25) { return [0b1110, 0b0010, 0b0100, 0b1000, 0b1110, 0b0000]; }  // Z
    if (i == 26) { return [0b1110, 0b1010, 0b1010, 0b1010, 0b1110, 0b0000]; }  // 0  (square, so it never reads as O)
    if (i == 27) { return [0b0100, 0b1100, 0b0100, 0b0100, 0b1110, 0b0000]; }  // 1
    if (i == 28) { return [0b1100, 0b0010, 0b0100, 0b1000, 0b1110, 0b0000]; }  // 2
    if (i == 29) { return [0b1100, 0b0010, 0b0100, 0b0010, 0b1100, 0b0000]; }  // 3
    if (i == 30) { return [0b1010, 0b1010, 0b1110, 0b0010, 0b0010, 0b0000]; }  // 4
    if (i == 31) { return [0b1110, 0b1000, 0b1100, 0b0010, 0b1100, 0b0000]; }  // 5
    if (i == 32) { return [0b0110, 0b1000, 0b1100, 0b1010, 0b0100, 0b0000]; }  // 6
    if (i == 33) { return [0b1110, 0b0010, 0b0100, 0b0100, 0b0100, 0b0000]; }  // 7
    if (i == 34) { return [0b0100, 0b1010, 0b0100, 0b1010, 0b0100, 0b0000]; }  // 8
    if (i == 35) { return [0b0100, 0b1010, 0b0110, 0b0010, 0b1100, 0b0000]; }  // 9
    if (i == 36) { return [0b0000, 0b0000, 0b0000, 0b0000, 0b0100, 0b0000]; }  // .
    if (i == 37) { return [0b0000, 0b0000, 0b0000, 0b0100, 0b1000, 0b0000]; }  // ,
    if (i == 38) { return [0b0000, 0b0100, 0b0000, 0b0100, 0b0000, 0b0000]; }  // :
    if (i == 39) { return [0b0010, 0b0010, 0b0100, 0b1000, 0b1000, 0b0000]; }  // /
    if (i == 40) { return [0b1010, 0b0010, 0b0100, 0b1000, 0b1010, 0b0000]; }  // %
    if (i == 41) { return [0b0000, 0b0100, 0b1110, 0b0100, 0b0000, 0b0000]; }  // +
    if (i == 42) { return [0b0000, 0b0000, 0b1110, 0b0000, 0b0000, 0b0000]; }  // -
    if (i == 43) { return [0b0110, 0b0100, 0b0100, 0b0100, 0b0110, 0b0000]; }  // [
    if (i == 44) { return [0b1100, 0b0100, 0b0100, 0b0100, 0b1100, 0b0000]; }  // ]
    if (i == 45) { return [0b0010, 0b0100, 0b1000, 0b0100, 0b0010, 0b0000]; }  // <
    if (i == 46) { return [0b1000, 0b0100, 0b0010, 0b0100, 0b1000, 0b0000]; }  // >
    if (i == 47) { return [0b0100, 0b1010, 0b0100, 0b0000, 0b0000, 0b0000]; }  // degree  U+00B0
    if (i == 48) { return [0b1010, 0b1110, 0b1110, 0b0100, 0b0000, 0b0000]; }  // heart   U+2665
    return [0b0010, 0b0110, 0b1100, 0b0100, 0b1000, 0b0000];                   // bolt    U+2301
}

// Codepoint of micro glyph slot `i`.  Hemlock strings index by CODEPOINT, not
// by UTF-8 byte (verified on v2.9.1), so "12°" and "♥ 100" work in a literal.
export fn hud_micro_cp(i: i32): i32 {
    if (i >= 0 && i <= 25) { let up: i32 = 65 + i; return up; }        // A..Z
    if (i >= 26 && i <= 35) { let dg: i32 = 22 + i; return dg; }       // 0..9
    if (i == 36) { let c: i32 = 46; return c; }                        // .
    if (i == 37) { let c: i32 = 44; return c; }                        // ,
    if (i == 38) { let c: i32 = 58; return c; }                        // :
    if (i == 39) { let c: i32 = 47; return c; }                        // /
    if (i == 40) { let c: i32 = 37; return c; }                        // %
    if (i == 41) { let c: i32 = 43; return c; }                        // +
    if (i == 42) { let c: i32 = 45; return c; }                        // -
    if (i == 43) { let c: i32 = 91; return c; }                        // [
    if (i == 44) { let c: i32 = 93; return c; }                        // ]
    if (i == 45) { let c: i32 = 60; return c; }                        // <
    if (i == 46) { let c: i32 = 62; return c; }                        // >
    if (i == 47) { let c: i32 = 176; return c; }                       // U+00B0 degree
    if (i == 48) { let c: i32 = 9829; return c; }                      // U+2665 heart
    let c2: i32 = 8961; return c2;                                     // U+2301 bolt
}

fn micro_adv(i: i32): i32 {
    if (i == 12 || i == 13 || i == 22) { let wide: i32 = 5; return wide; }
    let n: i32 = HUD_MICRO_ADV;
    return n;
}

// ===========================================================================
// FONT_BIG — 8x12 cells, 7-px ink, bit 0 is the gutter.  UNIFORM 2-PX STROKE:
// every horizontal and every vertical run of set bits in every digit is at
// least 2 long, which is what makes this read as a display face rather than a
// blur.  `hudgen_selftest` proves it rather than trusting the comment.
// ===========================================================================

fn big_rows(i: i32): array<i32> {
    if (i == 0) {   // 0
        return [0b01111100, 0b11111110, 0b11000110, 0b11000110, 0b11000110, 0b11000110,
                0b11000110, 0b11000110, 0b11000110, 0b11000110, 0b11111110, 0b01111100];
    }
    if (i == 1) {   // 1
        return [0b00110000, 0b01110000, 0b01110000, 0b00110000, 0b00110000, 0b00110000,
                0b00110000, 0b00110000, 0b00110000, 0b00110000, 0b11111100, 0b11111100];
    }
    if (i == 2) {   // 2
        return [0b01111100, 0b11111110, 0b11000110, 0b00000110, 0b00000110, 0b00001100,
                0b00011000, 0b00110000, 0b01100000, 0b11000000, 0b11111110, 0b11111110];
    }
    if (i == 3) {   // 3
        return [0b01111100, 0b11111110, 0b11000110, 0b00000110, 0b00011110, 0b00011110,
                0b00000110, 0b00000110, 0b11000110, 0b11000110, 0b11111110, 0b01111100];
    }
    if (i == 4) {   // 4
        return [0b00001100, 0b00011100, 0b00111100, 0b01101100, 0b11001100, 0b11001100,
                0b11111110, 0b11111110, 0b00001100, 0b00001100, 0b00001100, 0b00001100];
    }
    if (i == 5) {   // 5
        return [0b11111110, 0b11111110, 0b11000000, 0b11000000, 0b11111100, 0b11111110,
                0b00000110, 0b00000110, 0b00000110, 0b11000110, 0b11111110, 0b01111100];
    }
    if (i == 6) {   // 6
        return [0b00111100, 0b01111100, 0b01100000, 0b11000000, 0b11111100, 0b11111110,
                0b11000110, 0b11000110, 0b11000110, 0b11000110, 0b11111110, 0b01111100];
    }
    if (i == 7) {   // 7
        return [0b11111110, 0b11111110, 0b00000110, 0b00001100, 0b00001100, 0b00011000,
                0b00011000, 0b00110000, 0b00110000, 0b01100000, 0b01100000, 0b01100000];
    }
    if (i == 8) {   // 8
        return [0b01111100, 0b11111110, 0b11000110, 0b11000110, 0b11111110, 0b01111100,
                0b11000110, 0b11000110, 0b11000110, 0b11000110, 0b11111110, 0b01111100];
    }
    if (i == 9) {   // 9 — a 180-degree rotation of 6, so the pair reads as a set
        return [0b01111100, 0b11111110, 0b11000110, 0b11000110, 0b11000110, 0b11000110,
                0b11111110, 0b01111110, 0b00000110, 0b00001100, 0b01111100, 0b01111000];
    }
    if (i == 10) { // /
        return [0b00000110, 0b00000110, 0b00001100, 0b00001100, 0b00011000, 0b00011000,
                0b00110000, 0b00110000, 0b01100000, 0b01100000, 0b11000000, 0b11000000];
    }
    // %
    return [0b11000110, 0b11000110, 0b00001100, 0b00011000, 0b00011000, 0b00110000,
            0b00110000, 0b01100000, 0b01100000, 0b11000110, 0b11000110, 0b00000000];
}

export fn hud_big_cp(i: i32): i32 {
    if (i >= 0 && i <= 9) { let d: i32 = 48 + i; return d; }
    if (i == 10) { let s: i32 = 47; return s; }
    let p: i32 = 37;
    return p;
}

// ===========================================================================
// icon ink.  Each returns `h` rows of `w` bits, leftmost pixel in bit (w-1).
// Every icon is drawn 1 texel inside its rect so `hud_outline` has room.
// ===========================================================================

fn icon_rows(id: i32): array<i32> {
    if (id == HUD_ICON_HEART) {
        return [0b011011, 0b111111, 0b111111, 0b011110, 0b001100, 0b000000];
    }
    if (id == HUD_ICON_AMMO) {          // a cartridge, nose up
        return [0b001100, 0b011110, 0b011110, 0b111111, 0b111111, 0b111111];
    }
    if (id == HUD_ICON_SKULL) {
        return [0b011110, 0b111111, 0b101101, 0b111111, 0b011110, 0b010100];
    }
    if (id == HUD_ICON_XP) {            // diamond — same shape language as FX_XP_MOTE
        return [0b001100, 0b011110, 0b111111, 0b111111, 0b011110, 0b001100];
    }
    if (id == HUD_ICON_LANTERN) {
        return [0b001100, 0b010010, 0b111111, 0b101101, 0b111111, 0b011110];
    }
    if (id == HUD_ICON_SHIELD) {
        return [0b111111, 0b111111, 0b111111, 0b011110, 0b011110, 0b001100];
    }
    if (id == HUD_ICON_HEADSHOT) {
        return [0b010010, 0b001100, 0b110011, 0b110011, 0b001100, 0b010010];
    }
    if (id == HUD_ICON_WEAPON) {        // 6x4: front sight, receiver, grip
        return [0b000110, 0b111111, 0b011100, 0b001100];
    }
    if (id == HUD_ICON_DIAMOND) {       // 5x5 outline
        return [0b00100, 0b01010, 0b10001, 0b01010, 0b00100];
    }
    if (id == HUD_ICON_ARROW) {
        return [0b00100, 0b01110, 0b11111, 0b00100, 0b00100];
    }
    if (id == HUD_ICON_PLAYER) {
        return [0b00100, 0b01110, 0b01110, 0b11111, 0b00000];
    }
    if (id == HUD_ICON_ENEMY) {
        return [0b11, 0b11];
    }
    if (id == HUD_ICON_OBJDOT) {
        return [0b010, 0b111, 0b010];
    }
    if (id == HUD_XH_TICK_V) {
        return [0b1, 0b1, 0b1, 0b1];
    }
    if (id == HUD_XH_TICK_H) {
        return [0b1111];
    }
    if (id == HUD_XH_DOT) {
        return [0b1];
    }
    if (id == HUD_CHEVRON) {            // 3x2, points down at the compass strip
        return [0b111, 0b010];
    }
    if (id == HUD_TICK_MINOR) {
        return [0b1, 0b1];
    }
    if (id == HUD_TICK_MAJOR) {
        return [0b1, 0b1, 0b1, 0b1];
    }
    if (id == HUD_PIP) {
        return [0b010, 0b111, 0b010];
    }
    if (id == HUD_MM_CORNER) {          // top-left bracket; flip uvs for the other three
        return [0b111111, 0b100000, 0b100000, 0b100000, 0b100000, 0b100000];
    }
    if (id == HUD_MM_EDGE_H) {
        return [0b111111];
    }
    if (id == HUD_MM_EDGE_V) {
        return [0b1, 0b1, 0b1, 0b1, 0b1, 0b1];
    }
    return [];
}

// The rect table, in the order of the ids above: x, y, w, h.
fn rect_table(): array<i32> {
    return [   0, 24, 8, 8,      // HEART
               8, 24, 8, 8,      // AMMO
              16, 24, 8, 8,      // SKULL
              24, 24, 8, 8,      // XP
              32, 24, 8, 8,      // LANTERN
              40, 24, 8, 8,      // SHIELD
              48, 24, 8, 8,      // HEADSHOT
              56, 24, 8, 6,      // WEAPON
              66, 24, 7, 7,      // DIAMOND
              74, 24, 7, 7,      // ARROW
              82, 24, 7, 7,      // PLAYER
              90, 24, 4, 4,      // ENEMY
              95, 24, 5, 5,      // OBJDOT
               0, 32, 3, 6,      // XH TICK V
               4, 32, 6, 3,      // XH TICK H
              11, 32, 3, 3,      // XH DOT
              16, 32, 16, 16,    // HITMARK
              34, 32, 5, 4,      // CHEVRON
              40, 32, 3, 4,      // TICK MINOR
              44, 32, 3, 6,      // TICK MAJOR
              48, 32, 5, 5,      // PIP
               0, 48, 8, 8,      // MM CORNER
              10, 48, 8, 3,      // MM EDGE H
              20, 48, 3, 8,      // MM EDGE V
               0, 56, 64, 4,     // VIGNETTE
              66, 56, 4, 4 ];    // SOLID
}

// ---------------------------------------------------------------------------
// blitters
// ---------------------------------------------------------------------------

// Write `rows` of `w` bits at (x0, y0) as opaque white; leave clear bits alone.
fn hud_ink(d: buffer, x0: i32, y0: i32, w: i32, rows: array<i32>) {
    let h: i32 = rows.length;
    for (let y = 0; y < h; y++) {
        let bits: i32 = rows[y];
        for (let x = 0; x < w; x++) {
            if (((bits >> (w - 1 - x)) & 1) == 1) {
                let o: i32 = ((y0 + y) * HUD_ATLAS_W + x0 + x) * 4;
                d[o] = 255;
                d[o + 1] = 255;
                d[o + 2] = 255;
                d[o + 3] = 255;
            }
        }
    }
}

// The mandatory 1-px UI_BLACK outline (ART_BIBLE §9.1): every transparent texel
// of the rect that touches an opaque one, in any of the 8 directions, becomes
// UI_BLACK.  Computed from a snapshot of the alpha channel so the outline never
// grows into itself.
fn hud_outline(d: buffer, x0: i32, y0: i32, w: i32, h: i32) {
    let obr: i32 = pal_r(g_UI_BLACK);
    let obg: i32 = pal_g(g_UI_BLACK);
    let obb: i32 = pal_b(g_UI_BLACK);
    let mark: array<i32> = [];
    for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
            let o: i32 = ((y0 + y) * HUD_ATLAS_W + x0 + x) * 4;
            if (d[o + 3] != 0) { continue; }
            let touch: i32 = 0;
            for (let ny = y - 1; ny <= y + 1; ny++) {
                for (let nx = x - 1; nx <= x + 1; nx++) {
                    if (nx < 0 || ny < 0 || nx >= w || ny >= h) { continue; }
                    let no: i32 = ((y0 + ny) * HUD_ATLAS_W + x0 + nx) * 4;
                    if (d[no + 3] == 255 && d[no] == 255) { touch = 1; }
                }
            }
            if (touch == 1) { mark.push(o); }
        }
    }
    let n: i32 = mark.length;
    for (let i = 0; i < n; i++) {
        let o: i32 = mark[i];
        d[o] = obr;
        d[o + 1] = obg;
        d[o + 2] = obb;
        d[o + 3] = 255;
    }
}

// The four diagonal ticks of the hitmarker, drawn into the 16x16 rect: each is
// 4 texels long with a 4-texel gap from centre, exactly ART_BIBLE §9.3.
fn hud_hitmark(d: buffer, x0: i32, y0: i32) {
    for (let k = 0; k < 4; k++) {
        let a: i32 = 2 + k;          // 2..5 from the ink origin
        let b: i32 = 13 - k;         // mirrored
        hud_dot(d, x0 + 1 + a, y0 + 1 + a);
        hud_dot(d, x0 + 1 + b, y0 + 1 + a);
        hud_dot(d, x0 + 1 + a, y0 + 1 + b);
        hud_dot(d, x0 + 1 + b, y0 + 1 + b);
    }
}
fn hud_dot(d: buffer, x: i32, y: i32) {
    let o: i32 = (y * HUD_ATLAS_W + x) * 4;
    d[o] = 255;
    d[o + 1] = 255;
    d[o + 2] = 255;
    d[o + 3] = 255;
}

// The vignette gradient strip: white RGB with alpha ramping 0 -> 255 across
// 64 texels, ordered-dithered so the 4-per-step ramp has no visible bands when
// it is stretched across a 42-px screen inset (ART_BIBLE §13.12).
fn hud_vignette(d: buffer, x0: i32, y0: i32, w: i32, h: i32) {
    let fw: f64 = f64(w - 1);
    for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
            let t: f64 = f64(x) / fw;
            let a: i32 = i32(t * 255.0 + bayer4(x, y));
            if (a > 255) { a = 255; }
            if (a < 0) { a = 0; }
            let o: i32 = ((y0 + y) * HUD_ATLAS_W + x0 + x) * 4;
            d[o] = 255;
            d[o + 1] = 255;
            d[o + 2] = 255;
            d[o + 3] = a;
        }
    }
}

// ---------------------------------------------------------------------------
// build
// ---------------------------------------------------------------------------

// Generate FONT_MICRO, FONT_BIG, every sprite, and the gradient strip into a
// fresh 128x128 atlas.  Returns the atlas (upload it with BLEND_BLEND), or
// null if the atlas or a font could not be built.
export fn hudgen_build_atlas() {
    let a = atlas_new(HUD_ATLAS_W, HUD_ATLAS_H, 1, 1);
    if (a == null) { return null; }
    atlas_fill(a, 0, 0, 0, 0);
    let d: buffer = atlas_data(a);
    let base: ptr = atlas_base(a);

    // --- the two fonts ----------------------------------------------------
    let fm = font_new(HUD_MICRO_W, HUD_MICRO_H, HUD_MICRO_ADV, HUD_MICRO_LINE, 64);
    for (let i = 0; i < HUD_MICRO_N; i++) {
        font_add_glyph(fm, hud_micro_cp(i), micro_rows(i));
    }
    for (let i = 0; i < HUD_MICRO_N; i++) {
        let adv: i32 = micro_adv(i);
        if (adv != HUD_MICRO_ADV) { font_set_glyph_advance(fm, hud_micro_cp(i), adv); }
    }
    if (font_bake(fm, base, HUD_ATLAS_W, HUD_ATLAS_H, 0, 0, HUD_MICRO_COLS,
                  255, 255, 255, 255) < 0) { return null; }

    let fb = font_new(HUD_BIG_W, HUD_BIG_H, HUD_BIG_ADV, HUD_BIG_LINE, 16);
    for (let i = 0; i < HUD_BIG_N; i++) {
        font_add_glyph(fb, hud_big_cp(i), big_rows(i));
    }
    if (font_bake(fb, base, HUD_ATLAS_W, HUD_ATLAS_H, 0, HUD_BIG_Y, HUD_BIG_COLS,
                  255, 255, 255, 255) < 0) { return null; }

    // --- sprites ----------------------------------------------------------
    let rt: array<i32> = rect_table();
    g_hud_rect = rt;
    for (let id = 0; id < HUD_RECT_COUNT; id++) {
        let s: i32 = id * 4;
        let rx: i32 = rt[s];
        let ry: i32 = rt[s + 1];
        let rw: i32 = rt[s + 2];
        let rh: i32 = rt[s + 3];
        if (id == HUD_VIGNETTE) {
            hud_vignette(d, rx, ry, rw, rh);
            continue;
        }
        if (id == HUD_SOLID) {
            for (let y = 0; y < rh; y++) {
                for (let x = 0; x < rw; x++) { hud_dot(d, rx + x, ry + y); }
            }
            continue;
        }
        if (id == HUD_HITMARK) {
            hud_hitmark(d, rx, ry);
        } else {
            let rows: array<i32> = icon_rows(id);
            hud_ink(d, rx + 1, ry + 1, rw - 2, rows);
        }
        hud_outline(d, rx, ry, rw, rh);
    }

    g_hud_atlas = a;
    g_hud_micro = fm;
    g_hud_big = fb;
    return a;
}

// ===========================================================================
// self-test — the W2-7 acceptance criteria.  Returns the failure count.
// ===========================================================================

let g_hud_checks: i32 = 0;
let g_hud_fails: i32 = 0;

export fn hudgen_checks(): i32 { let o: i32 = g_hud_checks; return o; }

fn hck(name: string, ok: i32) {
    g_hud_checks++;
    if (ok != 1) { g_hud_fails++; eprint(`hudgen FAIL: ${name}`); }
}

// Longest run of set bits in `bits` over `w` columns must be >= 2 wherever a
// run exists at all.  Returns 1 when every run is >= 2.
fn runs2_row(bits: i32, w: i32): i32 {
    let n: i32 = 0;
    for (let x = 0; x < w; x++) {
        if (((bits >> (w - 1 - x)) & 1) == 1) { n++; }
        else {
            if (n == 1) { let bad: i32 = 0; return bad; }
            n = 0;
        }
    }
    if (n == 1) { let bad2: i32 = 0; return bad2; }
    let ok: i32 = 1;
    return ok;
}

export fn hudgen_selftest(): i32 {
    g_hud_checks = 0;
    g_hud_fails = 0;
    let a = g_hud_atlas;
    if (a == null) { a = hudgen_build_atlas(); }
    hck("atlas built", (a != null) ? 1 : 0);
    if (a == null) { let bad: i32 = 1; return bad; }
    let fm = g_hud_micro;
    let fb = g_hud_big;

    // --- ACCEPTANCE: glyph coverage ---------------------------------------
    hck("FONT_MICRO registered every glyph", (font_glyph_count(fm) == HUD_MICRO_N) ? 1 : 0);
    hck("FONT_BIG registered every glyph", (font_glyph_count(fb) == HUD_BIG_N) ? 1 : 0);
    let az: i32 = 1;
    for (let c = 65; c <= 90; c++) { if (font_glyph_index(fm, c) < 0) { az = 0; } }
    hck("FONT_MICRO covers A-Z", az);
    let dg: i32 = 1;
    for (let c = 48; c <= 57; c++) { if (font_glyph_index(fm, c) < 0) { dg = 0; } }
    hck("FONT_MICRO covers 0-9", dg);
    // the named punctuation of ART_BIBLE §9.4:  . , : / % + - [ ] < > deg heart bolt
    let punct: i32 = 1;
    for (let i = 36; i < HUD_MICRO_N; i++) {
        if (font_glyph_index(fm, hud_micro_cp(i)) < 0) { punct = 0; }
    }
    hck("FONT_MICRO covers the named punctuation, degree, heart and bolt", punct);
    // SPACE IS DELIBERATELY UNMAPPED.  font.hml advances the cursor by the font
    // default for an unmapped codepoint and emits nothing, so a registered
    // blank space glyph would cost 2 triangles per space and 4 per shadowed
    // space for zero pixels.  "AUTO  AR-9 VESPER" alone carries three spaces;
    // across the ART_BIBLE §9.2 HUD that is 44 wasted triangles out of a
    // 250-triangle budget.  The advance must still be identical, which is what
    // the width check below proves.
    hck("space is unmapped, so it costs zero triangles",
        (font_glyph_index(fm, 32) < 0) ? 1 : 0);
    hck("an unmapped space still advances exactly one cell",
        (font_width(fm, "A B") == 3 * HUD_MICRO_ADV) ? 1 : 0);
    let bdg: i32 = 1;
    for (let c = 48; c <= 57; c++) { if (font_glyph_index(fb, c) < 0) { bdg = 0; } }
    if (font_glyph_index(fb, 47) < 0) { bdg = 0; }
    if (font_glyph_index(fb, 37) < 0) { bdg = 0; }
    hck("FONT_BIG covers 0-9, / and %", bdg);
    hck("FONT_BIG is a separate face, not a scaled FONT_MICRO",
        (HUD_BIG_W == 2 * HUD_MICRO_W && HUD_BIG_H == 2 * HUD_MICRO_H) ? 1 : 0);

    // --- ACCEPTANCE: FONT_BIG digits have a 2-px stroke weight -------------
    // Every maximal run of set bits, in every row AND every column, of all ten
    // digits, must be at least 2 long.  A run of 1 is a hairline, which is the
    // exact failure mode of a scaled-up micro font.
    let stroke: i32 = 1;
    for (let gi = 0; gi < 10; gi++) {
        let rows: array<i32> = big_rows(gi);
        for (let y = 0; y < HUD_BIG_H; y++) {
            if (runs2_row(rows[y], HUD_BIG_W) == 0) { stroke = 0; }
        }
        for (let x = 0; x < HUD_BIG_W; x++) {
            let col: i32 = 0;
            for (let y = 0; y < HUD_BIG_H; y++) {
                col = (col << 1) | ((rows[y] >> (HUD_BIG_W - 1 - x)) & 1);
            }
            if (runs2_row(col, HUD_BIG_H) == 0) { stroke = 0; }
        }
    }
    hck("FONT_BIG digits have a 2-px stroke weight in both axes", stroke);

    // --- ACCEPTANCE: the bake is texel-exact against the bitfields ---------
    let mexact: i32 = 1;
    for (let i = 0; i < HUD_MICRO_N; i++) {
        let rows: array<i32> = micro_rows(i);
        let cx: i32 = (i % HUD_MICRO_COLS) * HUD_MICRO_W;
        let cy: i32 = divi(i, HUD_MICRO_COLS) * HUD_MICRO_H;
        for (let y = 0; y < HUD_MICRO_H; y++) {
            for (let x = 0; x < HUD_MICRO_W; x++) {
                let want: i32 = (rows[y] >> (HUD_MICRO_W - 1 - x)) & 1;
                let p: u32 = atlas_get(a, cx + x, cy + y);
                let al: i32 = i32((p >> 24) & 255);
                if (want == 1) { if (al != 255 || (p & 16777215) != 16777215) { mexact = 0; } }
                else { if (al != 0) { mexact = 0; } }
            }
        }
    }
    hck("FONT_MICRO bakes texel-exact against its bitfields", mexact);
    let bexact: i32 = 1;
    for (let i = 0; i < HUD_BIG_N; i++) {
        let rows: array<i32> = big_rows(i);
        let cx: i32 = (i % HUD_BIG_COLS) * HUD_BIG_W;
        let cy: i32 = HUD_BIG_Y + divi(i, HUD_BIG_COLS) * HUD_BIG_H;
        for (let y = 0; y < HUD_BIG_H; y++) {
            for (let x = 0; x < HUD_BIG_W; x++) {
                let want: i32 = (rows[y] >> (HUD_BIG_W - 1 - x)) & 1;
                let p: u32 = atlas_get(a, cx + x, cy + y);
                let al: i32 = i32((p >> 24) & 255);
                if (want == 1) { if (al != 255) { bexact = 0; } }
                else { if (al != 0) { bexact = 0; } }
            }
        }
    }
    hck("FONT_BIG bakes texel-exact against its bitfields", bexact);

    // --- sprite rects: inside the atlas, and not on top of each other ------
    let inb: i32 = 1;
    let clash: i32 = 0;
    let rt: array<i32> = rect_table();
    for (let i = 0; i < HUD_RECT_COUNT; i++) {
        let ix: i32 = rt[i * 4];
        let iy: i32 = rt[i * 4 + 1];
        let iw: i32 = rt[i * 4 + 2];
        let ih: i32 = rt[i * 4 + 3];
        if (ix < 0 || iy < 0 || ix + iw > HUD_ATLAS_W || iy + ih > HUD_ATLAS_H) { inb = 0; }
        if (iy < HUD_BIG_Y + HUD_BIG_H) { inb = 0; }   // must not collide with the fonts
        for (let j = i + 1; j < HUD_RECT_COUNT; j++) {
            let jx: i32 = rt[j * 4];
            let jy: i32 = rt[j * 4 + 1];
            let jw: i32 = rt[j * 4 + 2];
            let jh: i32 = rt[j * 4 + 3];
            if (ix < jx + jw && jx < ix + iw && iy < jy + jh && jy < iy + ih) { clash++; }
        }
    }
    hck("every sprite rect is inside the atlas and clear of both fonts", inb);
    hck("no two sprite rects overlap", (clash == 0) ? 1 : 0);
    let named: i32 = 1;
    for (let i = 0; i < HUD_RECT_COUNT; i++) {
        if (hudgen_sprite_name(i).length == 0) { named = 0; }
    }
    hck("every sprite has a texview label", named);

    // --- every icon carries a COMPLETE 1-px UI_BLACK outline ---------------
    let obr: i32 = pal_r(g_UI_BLACK);
    let outlined: i32 = 1;
    let leaked: i32 = 0;
    for (let id = 0; id < HUD_RECT_COUNT; id++) {
        if (id == HUD_VIGNETTE || id == HUD_SOLID) { continue; }
        let rx: i32 = rt[id * 4];
        let ry: i32 = rt[id * 4 + 1];
        let rw: i32 = rt[id * 4 + 2];
        let rh: i32 = rt[id * 4 + 3];
        for (let y = 0; y < rh; y++) {
            for (let x = 0; x < rw; x++) {
                let p: u32 = atlas_get(a, rx + x, ry + y);
                if (i32((p >> 24) & 255) != 255) { continue; }
                if (i32(p & 255) != 255) { continue; }          // only white ink
                // every 8-neighbour must be ink or outline, never transparent
                for (let ny = y - 1; ny <= y + 1; ny++) {
                    for (let nx = x - 1; nx <= x + 1; nx++) {
                        if (nx < 0 || ny < 0 || nx >= rw || ny >= rh) { leaked++; }
                        else {
                            let q: u32 = atlas_get(a, rx + nx, ry + ny);
                            if (i32((q >> 24) & 255) != 255) { outlined = 0; }
                            else {
                                let qr: i32 = i32(q & 255);
                                if (qr != 255 && qr != obr) { outlined = 0; }
                            }
                        }
                    }
                }
            }
        }
    }
    hck("every icon's ink is fully enclosed by a 1-px UI_BLACK outline", outlined);
    hck("no icon ink touches its own rect edge", (leaked == 0) ? 1 : 0);

    // --- the vignette strip is a clean, band-free ramp ---------------------
    let vx: i32 = rt[HUD_VIGNETTE * 4];
    let vy: i32 = rt[HUD_VIGNETTE * 4 + 1];
    let vw: i32 = rt[HUD_VIGNETTE * 4 + 2];
    let mono: i32 = 1;
    let maxstep: i32 = 0;
    let prev: i32 = 0 - 1;
    for (let x = 0; x < vw; x++) {
        let al: i32 = i32((atlas_get(a, vx + x, vy) >> 24) & 255);
        if (prev >= 0) {
            let s: i32 = al - prev;
            if (s < 0) { mono = 0; s = 0 - s; }
            if (s > maxstep) { maxstep = s; }
        }
        prev = al;
    }
    hck("vignette strip ramps monotonically", mono);
    hck("vignette strip has no visible band (max adjacent step <= 8)",
        (maxstep <= 8) ? 1 : 0);
    hck("vignette strip spans the full alpha range",
        (i32((atlas_get(a, vx, vy) >> 24) & 255) <= 2
         && i32((atlas_get(a, vx + vw - 1, vy) >> 24) & 255) >= 250) ? 1 : 0);

    // --- ART_BIBLE §9.2 layout arithmetic ---------------------------------
    // The atlas is only useful if the strings it has to draw actually fit the
    // rects §9.2 gives them.  These are the two that bite: the killfeed line
    // (16 chars, right-aligned to x 311) and the 3-digit ammo counter.
    let kf: i32 = HUD_MICRO_ADV * 16;                 // 64 px
    hck("a 16-char killfeed line fits between the minimap edge and x 311",
        (311 - kf >= 240) ? 1 : 0);
    let ammo3: i32 = HUD_BIG_ADV * 3;                 // 24 px
    hck("a 3-digit FONT_BIG magazine count fits right-aligned to x 310",
        (310 - ammo3 >= 280) ? 1 : 0);
    hck("FONT_MICRO line pitch matches the 8 px killfeed pitch of §9.2",
        (HUD_MICRO_LINE == 8) ? 1 : 0);

    // --- determinism: a rebuild must be byte-identical ---------------------
    // The atlas is regenerated at every boot; if it is not reproducible then
    // neither is `shot.hml`'s golden PNG, and every visual regression test
    // downstream of it becomes noise.
    let nbytes: i32 = HUD_ATLAS_W * HUD_ATLAS_H * 4;
    let d1: buffer = atlas_data(a);
    let h1: u64 = 14695981039346656037;
    for (let i = 0; i < nbytes; i++) { h1 = (h1 ^ u64(d1[i])) * 1099511628211; }
    g_hud_atlas = null;
    let a2 = hudgen_build_atlas();
    let d2: buffer = atlas_data(a2);
    let h2: u64 = 14695981039346656037;
    for (let i = 0; i < nbytes; i++) { h2 = (h2 ^ u64(d2[i])) * 1099511628211; }
    hck("hudgen is deterministic (two builds hash identically)", (h1 == h2) ? 1 : 0);

    let out: i32 = g_hud_fails;
    return out;
}
