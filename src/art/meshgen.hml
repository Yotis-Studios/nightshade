fn build_weapon(p_m, p_id: i32) {
    let m = p_m;
    if (p_id == MESH_SPARROW_VM) {
        wpn_parts(m, g_wp_sparrow, 21, g_GUNMETAL_HI, g_GUNMETAL_LO, g_POLYMER, g_STEEL_HI);
        return;
    }
    if (p_id == MESH_TINKER_VM) {
        wpn_parts(m, g_wp_tinker, 20, g_STEEL_MID, g_STEEL_LO, g_POLYMER, g_STEEL_HI);
        return;
    }
    if (p_id == MESH_BELLOWS_VM) {
        wpn_parts(m, g_wp_bellows, 20, g_GUNMETAL_HI, g_GUNMETAL_LO, g_WOOD_MID, g_STEEL_HI);
        return;
    }
    if (p_id == MESH_LONGSHADOW_VM) {
        wpn_parts(m, g_wp_longshadow, 21, g_GUNMETAL_HI, g_GUNMETAL_LO, g_WOOD_HI, g_STEEL_HI);
        return;
    }
    if (p_id == MESH_KESTREL_VM) {
        wpn_parts(m, g_wp_kestrel, 21, g_STEEL_MID, g_STEEL_LO, g_WOOD_HI, g_BRASS);
        return;
    }
    wpn_parts(m, g_wp_emberlance, 21, g_GUNMETAL_HI, g_GUNMETAL_LO, g_BRASS_LO, g_BRASS);
}

// ===========================================================================
// THE BAKE — light once, then never touch a normal again (ENGINE_GAPS G19)
// ===========================================================================
//
// NOON keyframe from ART_BIBLE 5.1. AMBIENT + SUN == (1,1,1) exactly, which is
// the invariant that makes a sun-facing surface render at its authored albedo.
let g_mg_sun_x: f64 = 0.18;
let g_mg_sun_y: f64 = 0.96;
let g_mg_sun_z: f64 = 0.22;
let g_mg_sun_r: f64 = 0.58; let g_mg_sun_g: f64 = 0.56; let g_mg_sun_b: f64 = 0.50;
let g_mg_amb_r: f64 = 0.42; let g_mg_amb_g: f64 = 0.44; let g_mg_amb_b: f64 = 0.50;
let g_mg_bnc_r: f64 = 0.13; let g_mg_bnc_g: f64 = 0.16; let g_mg_bnc_b: f64 = 0.07;

// ART_BIBLE 8.2.6 / CLAUDE.md 8: NEVER BLACK. The world atlas has a minimum
// albedo luminance of 72 and vertex colour can only darken, so an unmodified
// bake puts unlit faces well below that floor and characters merge into one
// dark blob at range. This is a soft floor, not a clamp: luminance below 96 is
// compressed into [72, 96] instead of being clipped, so the value ordering the
// bake produced survives. Hue is preserved (the whole triple is scaled).
export let MG_LUM_FLOOR = 72;
let g_mg_lum_knee: f64 = 96.0;

fn mg_lift_floor(p_m): i32 {
    let m = p_m;
    let n: i32 = mesh_vert_count(m);
    let vb: ptr = mesh_buf(m);
    let cache: array<i32> = m.ac;
    let knee: f64 = g_mg_lum_knee;
    let floor_l: f64 = f64(MG_LUM_FLOOR);
    let lifted: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        let o: i32 = i * 24 + 20;
        let r: f64 = f64(ptr_deref_u8(ptr_offset(vb, o, 1)));
        let g: f64 = f64(ptr_deref_u8(ptr_offset(vb, o + 1, 1)));
        let b: f64 = f64(ptr_deref_u8(ptr_offset(vb, o + 2, 1)));
        let lum: f64 = 0.299 * r + 0.587 * g + 0.114 * b;
        if (lum < knee) {
            let want: f64 = floor_l + (knee - floor_l) * (lum / knee);
            let s: f64 = 1.0;
            if (lum > 0.5) { s = want / lum; } else { r = want; g = want; b = want; }
            if (lum > 0.5) { r = r * s; g = g * s; b = b * s; }
            let ir: i32 = i32(r + 0.5); let ig: i32 = i32(g + 0.5); let ib: i32 = i32(b + 0.5);
            if (ir > 255) { ir = 255; } if (ig > 255) { ig = 255; } if (ib > 255) { ib = 255; }
            ptr_write_u8(ptr_offset(vb, o, 1), ir);
            ptr_write_u8(ptr_offset(vb, o + 1, 1), ig);
            ptr_write_u8(ptr_offset(vb, o + 2, 1), ib);
            cache[i] = ir + ig * 256 + ib * 65536;
            lifted++;
        }
        i++;
    }
    let out: i32 = lifted;
    return out;
}

// Re-light every mesh. `tod.hml` may call this when the keyframe moves far
// enough to matter; it is a build-time cost, not a frame cost, and it is the
// ONLY thing in the whole game that transforms a mesh normal.
export fn meshgen_bake_all(p_lx: f64, p_ly: f64, p_lz: f64,
                           p_sr: f64, p_sg: f64, p_sb: f64,
                           p_ar: f64, p_ag: f64, p_ab: f64,
                           p_br: f64, p_bg: f64, p_bb: f64): i32 {
    let total: i32 = 0;
    let i: i32 = 0;
    while (i < MESH_COUNT) {
        let m = g_mg_mesh[i];
        total = total + mesh_bake_light(m, p_lx, p_ly, p_lz,
                                        p_sr, p_sg, p_sb,
                                        p_ar, p_ag, p_ab,
                                        p_br, p_bg, p_bb);
        mg_lift_floor(m);
        i++;
    }
    let out: i32 = total;
    return out;
}

// ===========================================================================
// meshgen_build_all — the whole asset library, ~40 meshes, once, at boot
// ===========================================================================

fn mg_measure_class(p_class: i32, p_id: i32, p_before_v: i32) {
    // The signature protrusion is always the last thing a class builder adds,
    // so "how far does the mesh reach beyond the body it had before the
    // protrusion" is measurable rather than asserted. ART_BIBLE 8.2.3.
    let m = g_mg_mesh[p_id];
    let n: i32 = mesh_vert_count(m);
    let x0: f64 = 0.0; let x1: f64 = 0.0;
    let y0: f64 = 0.0; let y1: f64 = 0.0;
    let z0: f64 = 0.0; let z1: f64 = 0.0;
    let i: i32 = 0;
    while (i < p_before_v) {
        let x: f64 = mesh_vert_pos(m, i, 0);
        let y: f64 = mesh_vert_pos(m, i, 1);
        let z: f64 = mesh_vert_pos(m, i, 2);
        if (i == 0) { x0 = x; x1 = x; y0 = y; y1 = y; z0 = z; z1 = z; }
        if (x < x0) { x0 = x; } if (x > x1) { x1 = x; }
        if (y < y0) { y0 = y; } if (y > y1) { y1 = y; }
        if (z < z0) { z0 = z; } if (z > z1) { z1 = z; }
        i++;
    }
    let best: f64 = 0.0;
    i = p_before_v;
    while (i < n) {
        let x: f64 = mesh_vert_pos(m, i, 0);
        let y: f64 = mesh_vert_pos(m, i, 1);
        let z: f64 = mesh_vert_pos(m, i, 2);
        let d: f64 = 0.0;
        if (x0 - x > d) { d = x0 - x; }
        if (x - x1 > d) { d = x - x1; }
        if (y0 - y > d) { d = y0 - y; }
        if (y - y1 > d) { d = y - y1; }
        if (z0 - z > d) { d = z0 - z; }
        if (z - z1 > d) { d = z - z1; }
        if (d > best) { best = d; }
        i++;
    }
    g_mg_prot_len[p_class] = best;
}

fn mg_finish(p_id: i32) {
    mesh_end(g_mg_mesh[p_id]);
}

export fn meshgen_build_all(): i32 {
    g_mg_mesh = []; g_mg_name = []; g_mg_budget = [];
    g_mg_kind = []; g_mg_view = [];
    let i: i32 = 0;
    while (i < MESH_COUNT) {
        g_mg_mesh.push(0); g_mg_name.push(""); g_mg_budget.push(0);
        g_mg_kind.push(0); g_mg_view.push(0.0);
        i++;
    }
    g_mg_head_w = []; g_mg_sh_w = []; g_mg_prot_len = []; g_mg_prot_axis = [];
    i = 0;
    while (i < ENEMY_COUNT) {
        g_mg_head_w.push(g_hu_head_hw[i] * 2.0);
        g_mg_sh_w.push(g_hu_sh_hw[i] * 2.0);
        g_mg_prot_len.push(0.0);
        g_mg_prot_axis.push(g_hu_axis[i]);
        i++;
    }

    let three_q: f64 = 0.62;      // 3/4 view for props and characters
    let side: f64 = 1.5708;       // weapons read side-on

    // ---- props ----------------------------------------------------------
    mg_register(MESH_TREE0,   "tree_lod0",  96, MG_KIND_PROP, three_q, 128);
    mg_register(MESH_TREE1,   "tree_lod1",  34, MG_KIND_PROP, three_q, 64);
    mg_register(MESH_TREE2,   "tree_lod2",   8, MG_KIND_PROP, three_q, 16);
    mg_register(MESH_BUSH,    "bush",       22, MG_KIND_PROP, three_q, 48);
    mg_register(MESH_ROCK,    "rock",       18, MG_KIND_PROP, three_q, 32);
    mg_register(MESH_CRATE,   "crate",      12, MG_KIND_PROP, three_q, 24);
    mg_register(MESH_BARREL,  "barrel",     24, MG_KIND_PROP, three_q, 40);
    mg_register(MESH_LANTERN, "lantern",    48, MG_KIND_PROP, three_q, 72);
    mg_register(MESH_BLOB,    "contact_blob", 2, MG_KIND_PROP, 0.0, 4);

    mesh_begin(g_mg_mesh[MESH_TREE0]);   build_tree0(g_mg_mesh[MESH_TREE0], 3);   mg_finish(MESH_TREE0);
    mesh_begin(g_mg_mesh[MESH_TREE1]);   build_tree1(g_mg_mesh[MESH_TREE1], 3);   mg_finish(MESH_TREE1);
    mesh_begin(g_mg_mesh[MESH_TREE2]);   build_tree2(g_mg_mesh[MESH_TREE2], 3);   mg_finish(MESH_TREE2);
    mesh_begin(g_mg_mesh[MESH_BUSH]);    build_bush(g_mg_mesh[MESH_BUSH], 9);     mg_finish(MESH_BUSH);
    mesh_begin(g_mg_mesh[MESH_ROCK]);    build_rock(g_mg_mesh[MESH_ROCK], 17);    mg_finish(MESH_ROCK);
    mesh_begin(g_mg_mesh[MESH_CRATE]);   build_crate(g_mg_mesh[MESH_CRATE]);      mg_finish(MESH_CRATE);
    mesh_begin(g_mg_mesh[MESH_BARREL]);  build_barrel(g_mg_mesh[MESH_BARREL], 23); mg_finish(MESH_BARREL);
    mesh_begin(g_mg_mesh[MESH_LANTERN]); build_lantern(g_mg_mesh[MESH_LANTERN]);  mg_finish(MESH_LANTERN);
    mesh_begin(g_mg_mesh[MESH_BLOB]);    build_blob(g_mg_mesh[MESH_BLOB]);        mg_finish(MESH_BLOB);

    // ---- enemies --------------------------------------------------------
    let names: array<string> = ["wisp", "mote", "husk", "spitter", "warden", "bulwark"];
    let bud0: array<i32> = [24, 32, 180, 180, 180, 180];
    let bud1: array<i32> = [12, 16, 90, 90, 90, 90];
    let bud2: array<i32> = [6, 8, 28, 28, 28, 28];
    let cls: i32 = 0;
    while (cls < ENEMY_COUNT) {
        let lod: i32 = 0;
        while (lod < 3) {
            let id: i32 = MESH_WISP0 + cls * 3 + lod;
            let bud: i32 = bud0[cls];
            if (lod == 1) { bud = bud1[cls]; }
            if (lod == 2) { bud = bud2[cls]; }
            mg_register(id, names[cls] + "_lod" + lod, bud, MG_KIND_ENEMY,
                        three_q, bud * 2 + 24);
            let m = g_mg_mesh[id];
            mesh_begin(m);
            if (cls == ENEMY_WISP) {
                build_wisp(m, lod);
            } else {
                if (cls == ENEMY_MOTE) {
                    build_mote(m, lod);
                } else {
                    build_humanoid(m, cls, lod);
                }
            }
            // measure the protrusion off the LOD0 mesh only
            if (lod == 0) {
                mg_measure_class(cls, id, mesh_vert_count(m) - 12);
            }
            mg_finish(id);
            lod++;
        }
        cls++;
    }

    // ---- NPC ------------------------------------------------------------
    mg_register(MESH_NPC, "npc", 220, MG_KIND_NPC, three_q, 260);
    mesh_begin(g_mg_mesh[MESH_NPC]); build_npc(g_mg_mesh[MESH_NPC]); mg_finish(MESH_NPC);

    // ---- viewmodels -----------------------------------------------------
    mg_register(MESH_SPARROW_VM,    "sparrow_vm",    260, MG_KIND_WEAPON, side, 300);
    mg_register(MESH_TINKER_VM,     "tinker_vm",     260, MG_KIND_WEAPON, side, 300);
    mg_register(MESH_BELLOWS_VM,    "bellows_vm",    260, MG_KIND_WEAPON, side, 300);
    mg_register(MESH_LONGSHADOW_VM, "longshadow_vm", 260, MG_KIND_WEAPON, side, 300);
    mg_register(MESH_KESTREL_VM,    "kestrel_vm",    260, MG_KIND_WEAPON, side, 300);
    mg_register(MESH_EMBERLANCE_VM, "emberlance_vm", 260, MG_KIND_WEAPON, side, 300);
    let w: i32 = MESH_SPARROW_VM;
    while (w <= MESH_EMBERLANCE_VM) {
        mesh_begin(g_mg_mesh[w]);
        build_weapon(g_mg_mesh[w], w);
        mg_finish(w);
        w++;
    }

    // ---- light it, once -------------------------------------------------
    meshgen_bake_all(g_mg_sun_x, g_mg_sun_y, g_mg_sun_z,
                     g_mg_sun_r, g_mg_sun_g, g_mg_sun_b,
                     g_mg_amb_r, g_mg_amb_g, g_mg_amb_b,
                     g_mg_bnc_r, g_mg_bnc_g, g_mg_bnc_b);

    g_mg_built = 1;
    let total: i32 = 0;
    i = 0;
    while (i < MESH_COUNT) { total = total + mesh_tri_count(g_mg_mesh[i]); i++; }
    let out: i32 = total;
    return out;
}
