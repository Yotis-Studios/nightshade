// meshgen.hml — the procedural mesh DSL and every mesh in Nightshade.
//
// Nightshade W2-8. Implements ARCHITECTURE.md D5 ("assets/ stays empty"):
// there is no OBJ file, no modelling tool and no importer. Every triangle the
// game ever draws that is not terrain, HUD or FX is built HERE, at boot, by a
// five-primitive DSL, and lit ONCE by `mesh_bake_light` so that a static prop
// costs ZERO normal transforms per frame (ENGINE_GAPS G19).
//
//   mg_box       an axis-aligned box, optionally skewed and tapered   12 tris
//   mg_prism     an n-sided prism about +Y, optional fan caps      2n..4n tris
//   mg_taper     a tapered n-sided tube between two arbitrary points   2n tris
//   mg_fan_disc  an n-sided fan disc, up- or down-facing               n tris
//   mg_lathe     a surface of revolution through a radius profile   2n(k-1) tris
//
// Everything else in this file is composition. That is the whole point: a
// parametric builder is *better* than a modelling tool below ~260 triangles,
// because per-instance variation (yaw, scale, colour jitter) is free and the
// asset is a diff, not a binary.
//
// ---------------------------------------------------------------------------
// THE FIVE RULES THIS FILE OBEYS
// ---------------------------------------------------------------------------
// 1. ART_BIBLE 8.2.1 — ASYMMETRY IS MANDATORY. A bilaterally symmetric
//    silhouette has no orientation cue at 12 px. Every mesh here has at least
//    one feature that breaks the x = 0 mirror, and `tools/meshgen.hml --verify`
//    measures it by mirroring the 32x32 silhouette and counting the mismatch.
// 2. ART_BIBLE 8.2.2 — a distinct head:shoulder ratio per enemy class. It is
//    the primary class read at 12 px. Exported as `mg_head_shoulder(class)`.
// 3. ART_BIBLE 8.2.3 — one signature protrusion per class, >= 0.45 m so it is
//    3 px at 30 m. Measured geometrically at build time against the AABB of
//    the body built BEFORE the protrusion was added.
// 4. ART_BIBLE 8.2.5/8.2.6 — value-block every model in vertex colour, and
//    NEVER black. `mg_bake_all` applies a soft luminance floor of 72 after the
//    light bake, so no vertex in the game is darker than the atlas minimum.
// 5. CLAUDE.md 8 — no colour is named here. Every colour is a `g_` constant
//    imported from `palette.hml`. There is not one hex literal in this file.
//
// ---------------------------------------------------------------------------
// TEXTURE COORDINATES
// ---------------------------------------------------------------------------
// A mesh vertex carries a UV into ATLAS_WORLD, whose cell layout belongs to
// `texgen.hml` (W2-5). meshgen does not — must not — know which cell is bark.
// It works in MATERIAL IDS (`MG_MAT_*`) and keeps a UV rect per material, which
// `assets.hml` overrides from texgen's `CELL_*` before calling
// `meshgen_build_all()`:
//
//     meshgen_set_material_uv(MG_MAT_BARK, u0, v0, u1, v1);   // from atlas_cell_uv
//     meshgen_build_all();
//
// The defaults are an 8x8 grid with a half-texel inset on a 256x256 atlas, so
// the meshes are correct-looking even if nobody calls the setter.
//
// Each face maps the whole cell rect (no tiling): the atlas cannot repeat
// without bleeding, and at 4 cm/texel a prop face is smaller than a cell
// anyway.

import { sqrt, sin, cos, atan2, PI } from "@stdlib/math";

import { mesh_new, mesh_begin, mesh_vert, mesh_vert_n, mesh_vert_ao,
         mesh_tri, mesh_quad, mesh_end, mesh_bake_light,
         mesh_tri_count, mesh_vert_count, mesh_vert_pos, mesh_vert_rgb,
         mesh_buf, mesh_radius } from "../../../wobbleweed/src/mesh.hml";

import { pal_r, pal_g, pal_b, pal_pack,
         g_BARK_HI, g_BARK_LO, g_LEAF_HI, g_LEAF_MID, g_LEAF_LO,
         g_LEAF_SICK, g_PINE_HI, g_PINE_LO,
         g_GRASS_DRY, g_DIRT_MID, g_DIRT_LO, g_MUD, g_SAND,
         g_STONE_HI, g_STONE_MID, g_STONE_LO, g_STONE_MOSS,
         g_GRANITE_HI, g_GRANITE_LO,
         g_CONCRETE_HI, g_CONCRETE_MID,
         g_WOOD_HI, g_WOOD_MID, g_WOOD_LO,
         g_RUST, g_RUST_DARK,
         g_STEEL_HI, g_STEEL_MID, g_STEEL_LO,
         g_GUNMETAL_HI, g_GUNMETAL_LO, g_BRASS, g_BRASS_LO, g_POLYMER,
         g_NS_MID, g_NS_CORE, g_NS_HALO, g_NIGHTSHADE_FLORA, g_ICHOR,
         g_FABRIC_RED, g_FABRIC_CREAM, g_PAINT_TEAL, g_PAINT_OCHRE,
         g_MUZZLE_CORE, g_MUZZLE_MID, g_EMBER, g_WINDOW_LIGHT,
         g_UI_BLACK } from "./palette.hml";

// ---------------------------------------------------------------------------
// materials
// ---------------------------------------------------------------------------

export let MG_MAT_BARK     = 0;
export let MG_MAT_LEAF     = 1;
export let MG_MAT_STONE    = 2;
export let MG_MAT_WOOD     = 3;
export let MG_MAT_METAL    = 4;
export let MG_MAT_CONCRETE = 5;
export let MG_MAT_CLOTH    = 6;
// MG_MAT_HIDE moved 7 -> 10 in round 2 to free slot 7 for MG_MAT_SPEC; see the
// self-binding note below. Nothing outside this file refers to a material by
// its number — the harness binds through the exported constants — so this is a
// rename, not an API change.
export let MG_MAT_HIDE     = 10;
export let MG_MAT_DIRT     = 8;
export let MG_MAT_GLASS    = 9;

// ---------------------------------------------------------------------------
// SELF-BINDING MATERIALS — id == atlas cell index
// ---------------------------------------------------------------------------
// The ten materials above are bound by the harness (`art_bind_materials`) to a
// cell of the real ATLAS_WORLD. These two are NOT, and do not need to be: the
// default UV grid built by `mg_uv_defaults` below is (m % 8, m / 8) of an 8x8
// grid on a 256 px atlas with a half-texel inset, and `atlas_new(256,256,8,8)`
// computes `(px + 0.5) / 256` for exactly the same cell. The two arithmetics
// are identical, so material id N addresses atlas cell N with no binding call.
//
// That matters because meshgen must not depend on a caller remembering to bind
// a new material, and because the art-direction gate's cruellest measurement
// was that ATLAS_WORLD ships 41 legible cells and the player only ever sees
// grass. These two put two more of them on screen.
//
// THE TRAP, which cost an hour: a self-binding id must not collide with a
// material the harness DOES bind, because the binding wins. MG_MAT_SPEC was
// first written as 7 while MG_MAT_HIDE was also 7 and bound to cell 17
// (CELL_WOOD_LOG). The weapon's highlight slot therefore sampled a wood tile
// whose brightest texel is luminance 138 — and the weapon's measured peak came
// out at exactly 137, repeated pixel-for-pixel as (175,131,80). MG_MAT_HIDE was
// moved to 10 to free the slot. If you add a self-binding material, check it
// against `art_bind_materials` first.
//
// The two self-binding materials:
//
//   MG_MAT_NSFLORA  cell 23  CELL_NS_FLORA   132, 79,171   the violet plant
//   MG_MAT_SPEC     cell  7  CELL_SNOW       182,193,206, max texel 242
//
// MG_MAT_SPEC is the only surface in the world atlas that can render above
// luminance 220 (every other cell tops out at 219, and CELL_METAL_PANEL — what
// the viewmodel used to be built from end to end — tops out at 187). It is a
// highlight tile, not snow: at 4 cm/texel a 6 cm rail is two pixels of bright
// grain, which is exactly what a specular band is.
//
// 🛑 ROUND 5 — DO NOT USE THIS CELL TO SATISFY CLAUDE.md §8 ON THE VIEWMODEL.
// Rounds 1-4 read §8 as "the weapon is the only object in every frame, so put
// the >220 anchor on the weapon". That is the fifth incarnation of the
// anti-gaming loophole and it is now closed by measurement: with the rail
// clipping to this tile the gun was the brightest object in a MIDNIGHT frame,
// and in ridge_golden / hub_dawn / ns_bloom it was the only >220 region in the
// image. §8's anchor must be WORLD GEOMETRY that implies light on its
// surroundings — a lightning bolt, a muzzle flash, a lamp — never a painted
// stripe on a first-person prop. The weapon's slot 3 still uses this cell,
// because it is the flattest bright window in the atlas and a rail wants a
// flat bright window; it is now lit like every other slot and tops out at 186.
//
// ✅ THE LANTERN VIEWMODEL DOES USE THIS CELL FOR ITS FLAME, AND HERE IS WHY
// THAT IS NOT A SIXTH INCARNATION OF THE LOOPHOLE.
//
// Round 5's sentence is the right rule and this obeys it: "§8's anchor must be
// world geometry that implies light on its surroundings — a lightning bolt, a
// muzzle flash, A LAMP". The thing above 220 is now a LAMP. It is not paint on
// a prop; it is the burning wick of a lantern, it sits inside a cage that casts
// its own graded halo, and it is the object the entire game is named after.
// Three things separate it from the rail it replaced:
//
//   * it is a SOURCE, not a surface. Its vertices are written after the light
//     bake, not clipped through it, so it neither dims at dusk nor blows out at
//     noon — and a "highlight" that is equally bright at midnight was always
//     the tell that the rail was faking it;
//   * it has a FALLOFF. Heat runs 1.00 at the core through 0.46 amber at the
//     flame's edge to 0.50-at-most on the halo behind it and 0 at the cage.
//     The rail had one value and a hard edge;
//   * the lantern's own HARDWARE is capped under 188 like everything else. Only
//     the fire is bright. If you find iron or brass over that ceiling, that IS
//     the bug and it should be fixed at `g_lamp_lum_*`.
//
// If a later round wants the anchor off the viewmodel entirely, the honest fix
// is to make the lantern light the WORLD (a dynamic light at the player, which
// `world_render.hml` already has a ground-glow path for) — not to dim the lamp.
export let MG_MAT_SPEC     = 7;
export let MG_MAT_NSFLORA  = 23;

// ---------------------------------------------------------------------------
// THE TWO VIEWMODEL MATERIALS — round 4. THIS IS THE FIX FOR "THE GUN IS A
// DARK LUMP". Read the measurement before you change either number.
// ---------------------------------------------------------------------------
// The rendered pixel is `albedo x light x AO x TEXEL`. Rounds 1-3 tuned the
// first three terms and never measured the fourth, and the fourth was eating
// the model. Measured on the real ATLAS_WORLD (texgen seed 1337), per texel of
// a 32x32 cell:
//
//     CELL_METAL_PANEL (27)   min  84   mean 153   max 188     -> x0.33 .. x0.74
//     CELL_SNOW         (7)   min 127   mean 192   max 243     -> x0.50 .. x0.95
//
// Two separate failures come out of that:
//
// 1. THE MEAN. The whole weapon except the highlight slot was MG_MAT_METAL, so
//    the four-step ladder arrived on screen multiplied by 0.60 on average and
//    by 0.33 wherever a face happened to land on a seam texel. A DARK face
//    authored at 46 rendered at 11. That is the p5 = 12 the gate measured.
//
// 2. THE VARIANCE, which is worse. The tile swings 84..188 — a 104-luminance
//    random field — while the ladder's own steps are ~70 apart. At 4 cm/texel
//    on an object that is 90 px across, that field is not detail, it is noise
//    that is LOUDER than the value structure it is painted on. It is why the
//    round-3 rail read as a mottled smear rather than an edge.
//
// So the viewmodel gets its own two materials, each a small WINDOW inside a
// cell the harness already binds, chosen by scanning every window of the real
// atlas for the flattest bright patch:
//
//   MG_MAT_VMSKIN  METAL_PANEL texels x10..17, y4..11   lum 176.3 .. 187.6
//                  the interior of the top plate, clear of the rivet bosses
//                  (x6..9, x24..27), the vertical seams (x1..2, x29..30) and
//                  the tile's lower half where it darkens. x0.691 .. x0.736 —
//                  a +-5.6 grain, which is exactly the "grain at +-6" CLAUDE.md
//                  §9 rule 2 asks for, instead of a +-52 one.
//
//   MG_MAT_VMRAIL  SNOW texels x22..29, y2..3           lum 240 .. 243
//                  the flat bright band of the highlight tile. x0.94 .. x0.95,
//                  so the rail is a SOLID band rather than salt-and-pepper
//                  between 127 and 243. This is what makes the rail an edge.
//                  ROUND 5: the flatness is the point, the brightness is NOT —
//                  the slot-3 vertex byte no longer clips (see wpn_parts), so
//                  what this window buys is a +-1.5 grain instead of a +-58
//                  one, and the rail's VALUE comes from g_vm_lum_spec alone.
//
// Both are derived at build time from the rect the harness bound to
// MG_MAT_METAL / MG_MAT_SPEC (see mg_uv_window in meshgen_build_all), so they
// follow the atlas rather than hardcoding a UV. Ids 11 and 12 are free: the
// harness binds 0-6 and 8-10, and meshgen self-binds 7 and 23.
export let MG_MAT_VMSKIN   = 11;
export let MG_MAT_VMRAIL   = 12;
export let MG_MAT_COUNT    = 24;

// u0,v0,u1,v1 per material. Default: cell (m%8, m/8) of an 8x8 grid with a
// half-texel inset for a 256x256 atlas (0.5/256 == 0.001953125).
let g_mg_uv: array<f64> = [];

fn mg_uv_defaults() {
    g_mg_uv = [];
    let inset: f64 = 0.001953125;
    let i: i32 = 0;
    while (i < MG_MAT_COUNT) {
        let cx: f64 = f64(i % 8);
        let cy: f64 = f64(i32(i / 8));   // `/` yields f64 in Hemlock; truncate explicitly
        g_mg_uv.push(cx * 0.125 + inset);
        g_mg_uv.push(cy * 0.125 + inset);
        g_mg_uv.push((cx + 1.0) * 0.125 - inset);
        g_mg_uv.push((cy + 1.0) * 0.125 - inset);
        i++;
    }
}
mg_uv_defaults();

// Bind a material to an atlas cell rect. Call BEFORE meshgen_build_all():
// UVs are baked into the vertex arena and are not patchable afterwards.
export fn meshgen_set_material_uv(p_mat: i32, p_u0: f64, p_v0: f64,
                                  p_u1: f64, p_v1: f64) {
    let i: i32 = p_mat * 4;
    g_mg_uv[i] = p_u0; g_mg_uv[i + 1] = p_v0;
    g_mg_uv[i + 2] = p_u1; g_mg_uv[i + 3] = p_v1;
}

// Point one material at a TEXEL WINDOW inside another material's bound rect.
// x/y are texel indices 0..31 inside the source cell. `atlas_cell_uv` hands
// meshgen the rect spanning texel CENTRES 0.5 .. 31.5, so the centre of texel
// k sits at fraction k/31 across it — which is what makes this exact under
// nearest sampling (SDL_RENDER_SCALE_QUALITY is 0) with no bleed into the
// neighbouring texels.
fn mg_uv_window(p_dst: i32, p_src: i32,
                p_x0: f64, p_y0: f64, p_x1: f64, p_y1: f64) {
    let s: i32 = p_src * 4;
    let u0: f64 = g_mg_uv[s];      let v0: f64 = g_mg_uv[s + 1];
    let du: f64 = (g_mg_uv[s + 2] - u0) / 31.0;
    let dv: f64 = (g_mg_uv[s + 3] - v0) / 31.0;
    let d: i32 = p_dst * 4;
    g_mg_uv[d]     = u0 + du * p_x0;
    g_mg_uv[d + 1] = v0 + dv * p_y0;
    g_mg_uv[d + 2] = u0 + du * p_x1;
    g_mg_uv[d + 3] = v0 + dv * p_y1;
}

fn mg_u(p_mat: i32, p_s: f64): f64 {
    let i: i32 = p_mat * 4;
    let a: f64 = g_mg_uv[i];
    let b: f64 = g_mg_uv[i + 2];
    let out: f64 = a + (b - a) * p_s;
    return out;
}
fn mg_vv(p_mat: i32, p_t: f64): f64 {
    let i: i32 = p_mat * 4;
    let a: f64 = g_mg_uv[i + 1];
    let b: f64 = g_mg_uv[i + 3];
    let out: f64 = a + (b - a) * p_t;
    return out;
}

// ---------------------------------------------------------------------------
// deterministic build-time noise (A13: every mix in u64, never i32)
// ---------------------------------------------------------------------------

fn mg_hash(p_i: i32): i32 {
    let x: u64 = u64(p_i) + 2654435769;
    x = x * 6364136223846793005;
    x = x ^ (x >> 31);
    x = x * 11400714819323198485;
    x = x ^ (x >> 29);
    let out: i32 = i32(x & 1073741823);
    return out;
}

// 0..1
fn mg_h01(p_i: i32): f64 {
    let h: i32 = mg_hash(p_i);
    let out: f64 = f64(h) / 1073741824.0;
    return out;
}

// -1..1
fn mg_hs(p_i: i32): f64 {
    let out: f64 = mg_h01(p_i) * 2.0 - 1.0;
    return out;
}

// Radial jitter applied by the round builders. This is what makes a rock a
// rock and not a hexagon, and it is what makes a hexagonal canopy disc read as
// mass. Set it, build, set it back to zero.
let g_mg_jit: f64 = 0.0;
let g_mg_seed: i32 = 0;

export fn mg_set_jitter(p_amt: f64, p_seed: i32) {
    g_mg_jit = p_amt;
    g_mg_seed = p_seed;
}

fn mg_ring_scale(p_k: i32): f64 {
    if (g_mg_jit <= 0.0) { let one: f64 = 1.0; return one; }
    let out: f64 = 1.0 + g_mg_jit * mg_hs(g_mg_seed * 131 + p_k * 7 + 3);
    return out;
}

// Same, but varying per profile RING as well as per side. mg_lathe uses this so
// a stack of rings is irregular in both axes instead of being a scaled copy of
// one outline — a lathe jittered only around the axis is still a solid of
// revolution and still mirror-symmetric. The (ring, k) pair is the only input,
// so the shared ring between two bands gets the same radius from both and the
// surface never cracks.
fn mg_ring_scale2(p_ring: i32, p_k: i32): f64 {
    if (g_mg_jit <= 0.0) { let one: f64 = 1.0; return one; }
    let out: f64 = 1.0 + g_mg_jit * mg_hs(g_mg_seed * 131 + p_ring * 911 + p_k * 7 + 3);
    return out;
}

// ---------------------------------------------------------------------------
// colour helpers — packed 0xRRGGBB in, packed out. No colour is NAMED here.
// ---------------------------------------------------------------------------

fn mg_mix(p_a: i32, p_b: i32, p_t: f64): i32 {
    let t: f64 = p_t;
    if (t < 0.0) { t = 0.0; }
    if (t > 1.0) { t = 1.0; }
    let r: i32 = i32(f64(pal_r(p_a)) + (f64(pal_r(p_b)) - f64(pal_r(p_a))) * t + 0.5);
    let g: i32 = i32(f64(pal_g(p_a)) + (f64(pal_g(p_b)) - f64(pal_g(p_a))) * t + 0.5);
    let b: i32 = i32(f64(pal_b(p_a)) + (f64(pal_b(p_b)) - f64(pal_b(p_a))) * t + 0.5);
    let out: i32 = pal_pack(r, g, b);
    return out;
}

fn mg_scale(p_c: i32, p_f: f64): i32 {
    let r: i32 = i32(f64(pal_r(p_c)) * p_f + 0.5);
    let g: i32 = i32(f64(pal_g(p_c)) * p_f + 0.5);
    let b: i32 = i32(f64(pal_b(p_c)) * p_f + 0.5);
    if (r > 255) { r = 255; } if (g > 255) { g = 255; } if (b > 255) { b = 255; }
    let out: i32 = pal_pack(r, g, b);
    return out;
}

fn mg_clamp255(p_v: f64): i32 {
    let v: f64 = p_v;
    if (v < 0.0) { v = 0.0; }
    if (v > 255.0) { v = 255.0; }
    let out: i32 = i32(v + 0.5);
    return out;
}

// Force a colour to an exact luminance and a bounded saturation. A VIEWMODEL
// slot has to be a VALUE first and a hue second, and round 2 had no mechanism
// for that at all: it handed four raw palette constants of four different
// chromas to the light rig, which then multiplied that chroma by a scene tint.
// The measured result was a near-neutral gun rendering at saturation 0.62 with
// a hue that swung 239 degrees across four scenes — "a lump taking the light's
// chroma at full saturation instead of reading as metal". This is the clamp.
fn mg_norm_col(p_c: i32, p_lum: f64, p_satcap: f64): i32 {
    let r: f64 = f64(pal_r(p_c));
    let g: f64 = f64(pal_g(p_c));
    let b: f64 = f64(pal_b(p_c));
    let l: f64 = 0.299 * r + 0.587 * g + 0.114 * b;
    if (l < 1.0) { l = 1.0; }
    let dr: f64 = r - l; let dg: f64 = g - l; let db: f64 = b - l;
    let mx: f64 = dr;  if (mx < 0.0) { mx = 0.0 - mx; }
    let ag: f64 = dg;  if (ag < 0.0) { ag = 0.0 - ag; }
    let ab: f64 = db;  if (ab < 0.0) { ab = 0.0 - ab; }
    if (ag > mx) { mx = ag; }
    if (ab > mx) { mx = ab; }
    let k: f64 = 1.0;
    let allow: f64 = p_satcap * l;
    if (mx > allow) { k = allow / mx; }
    let s: f64 = p_lum / l;
    let out: i32 = pal_pack(mg_clamp255((l + dr * k) * s),
                            mg_clamp255((l + dg * k) * s),
                            mg_clamp255((l + db * k) * s));
    return out;
}

// The sun azimuth used for the build-time "lit side / shadow side" albedo split
// on round things (ART_BIBLE 8.4: BARK_HI on the +SUN_DIR side, BARK_LO
// opposite). NOON SUN_DIR is (0.18, 0.96, 0.22); its horizontal part is what
// matters here.
let g_mg_sun_ax: f64 = 0.6325;
let g_mg_sun_az: f64 = 0.7746;

export fn meshgen_set_sun_azimuth(p_x: f64, p_z: f64) {
    let l: f64 = sqrt(p_x * p_x + p_z * p_z);
    if (l > 0.0) { g_mg_sun_ax = p_x / l; g_mg_sun_az = p_z / l; }
}

// Albedo for a surface whose outward horizontal direction is (dx,dz).
fn mg_side_col(p_lo: i32, p_hi: i32, p_dx: f64, p_dz: f64): i32 {
    let l: f64 = sqrt(p_dx * p_dx + p_dz * p_dz);
    let t: f64 = 0.5;
    if (l > 0.0) {
        t = 0.5 + 0.5 * ((p_dx / l) * g_mg_sun_ax + (p_dz / l) * g_mg_sun_az);
    }
    let out: i32 = mg_mix(p_lo, p_hi, t);
    return out;
}

// ===========================================================================
// 🛑 THE WINDING RULE — READ THIS BEFORE YOU ADD A FACE
// ===========================================================================
// `emit.hml` culls on SCREEN SIGNED AREA (`EMIT_BF_CCW` for world meshes,
// `MESH_CULL_NEG` for props — the two are the same predicate) and screen y
// points DOWN. Both reject
//
//     (sxB - sxA) * (syC - syA) - (sxC - sxA) * (syB - syA)   <= 0
//
// so a triangle survives iff it winds CLOCKWISE ON SCREEN. In world space that
// is the same statement as:
//
//     cross(B - A, C - A) must point AWAY from the camera —
//     i.e. it must be the INWARD direction, the NEGATIVE of the face's
//     outward normal.
//
// -------------------------------------------------------------------------
// THIS FILE GOT IT BACKWARDS IN SIX OF ITS NINE BUILDERS. FIXED 2026-07-28.
// -------------------------------------------------------------------------
// Audited by building each primitive about the origin and testing
// dot(cross(B-A, C-A), centroid) — positive means the outward face is the one
// being culled. Result before the fix:
//
//     mg_box_ex      12/12 inverted     <- crates, barrels, every enemy limb
//     mg_taper       16/16 inverted     <- every trunk, every stem
//     mg_fan_disc     8/8  inverted     <- every canopy layer, every prism cap
//     mg_spike        3/4  inverted     <- every petal, every protrusion
//     mg_panel        2/2  inverted     <- accent plates
//     build_tree2      4/4 inverted     <- the crossed leaf cards
//     mg_prism        CORRECT
//     mg_lathe        CORRECT
//     mg_ground_quad  CORRECT  (fixed in round 2; its comment states the rule)
//
// An inside-out CLOSED mesh is not invisible — it draws its FAR faces instead
// of its near ones — which is why this survived so long. What it costs is:
//
//   1. every box shows the wrong facet. Look down at a crate and you see the
//      BOTTOM face (`p_clo`, AO x0.72) where the top (`p_chi`, AO x1.0) should
//      be. Proven by emitting a box with chi = (240,0,16) and clo = (16,0,240)
//      from a camera directly above: the surviving horizontal face came back
//      rgb(16,0,240).
//   2. every OPEN mesh is visible from exactly the wrong side. A canopy fan
//      disc built face-up could only be seen from BELOW — which is why flying
//      over the world showed things "not rendering all sides".
//   3. the painter's sort key is the far side of every prop, so a prop sorts
//      one mesh-diameter too far away and swaps order with its neighbours as
//      the camera moves. There is no z-buffer here by design, so that reads as
//      surfaces cutting into each other.
//
// `rej.backface` was 1900+/frame and an earlier round wrote it off as
// "legitimate box interiors". It was the interiors being KEPT and the exteriors
// being rejected.
//
// ⚠ THE ONE BUILDER DELIBERATELY LEFT INVERTED IS `mg_vm_shell`. See its own
// header: the viewmodel was rebuilt AROUND this bug — its face set and the
// sign of `g_mg_vm_lx/ly/lz` both encode it — and the project owner has asked
// for the weapon to be replaced rather than retuned. Fixing it means building
// the (+Y, -Z, +X) set instead of (-Y, +Z, -X) AND un-negating the key.
//
// -------------------------------------------------------------------------
// HOW TO ADD A FACE NOW
// -------------------------------------------------------------------------
// Author the corners in the natural "counter-clockwise seen from outside"
// order — which is what every builder below still reads as — then:
//   * call `mg_face_n` on the first three corners to get the OUTWARD normal,
//   * create the vertices with `mg_vn` carrying that normal,
//   * hand them to `mesh_quad` / `mesh_tri` REVERSED: (a,d,c,b) / (a,c,b).
// The reversal is what the rasteriser wants; the explicit normal is what keeps
// `mesh_bake_light` lighting the face from outside. Reversing the winding
// WITHOUT supplying a normal flips the light too, because `mesh_tri` derives a
// missing normal from the winding — that is the trap, and it is why this fix
// is not a one-line swap.
// ===========================================================================

// The outward normal of a face, from three corners in the natural
// outward-counter-clockwise order. Written to three globals rather than
// returned because Hemlock has no multiple return and a 3-field object literal
// costs 260 ns (CLAUDE.md §1 rule 2) — this is build-time code, but there is
// no reason to allocate here at all.
let g_mg_nx: f64 = 0.0;
let g_mg_ny: f64 = 1.0;
let g_mg_nz: f64 = 0.0;

fn mg_face_n(p_ax: f64, p_ay: f64, p_az: f64,
             p_bx: f64, p_by: f64, p_bz: f64,
             p_cx: f64, p_cy: f64, p_cz: f64) {
    let ux: f64 = p_bx - p_ax; let uy: f64 = p_by - p_ay; let uz: f64 = p_bz - p_az;
    let wx: f64 = p_cx - p_ax; let wy: f64 = p_cy - p_ay; let wz: f64 = p_cz - p_az;
    let nx: f64 = uy * wz - uz * wy;
    let ny: f64 = uz * wx - ux * wz;
    let nz: f64 = ux * wy - uy * wx;
    let l: f64 = sqrt(nx * nx + ny * ny + nz * nz);
    // A degenerate face keeps the previous normal rather than emitting a zero
    // one: a zero normal reads as "unset" to mesh.hml's `has_n`, which would
    // silently fall back to the REVERSED face normal and re-introduce the bug
    // on exactly the faces nobody looks at.
    if (l > 0.0) {
        g_mg_nx = nx / l; g_mg_ny = ny / l; g_mg_nz = nz / l;
    }
}

// ---------------------------------------------------------------------------
// build-time rigid transform — THE VIEWMODEL CANT (ART_BIBLE 8.5)
// ---------------------------------------------------------------------------
// A viewmodel built axis-aligned and emitted straight down the camera's own
// forward axis is seen END-ON. The barrel foreshortens to a point and barrel,
// receiver, magazine and stock stack into one lump: that is exactly the "grey
// blob" the art-direction gate measured. Every first-person shooter since
// GoldenEye fixes it the same way — the weapon is CANTED in model space so the
// player gets a three-quarter view with the muzzle swung back toward the
// crosshair and the whole length of the gun on screen.
//
// It is a BUILD-time transform applied inside mg_v/mg_vn, which means:
//   * zero per-frame cost (the emit path never learns about it),
//   * no new primitive — every existing builder keeps working unchanged,
//   * `mesh_tri` recomputes each face normal from the transformed positions,
//     so the light bake follows the cant for free.
//
// Angles are degrees. yaw swings the muzzle (+Z) toward +X; pitch raises the
// muzzle; roll rolls the top of the weapon toward +X. Offsets are applied
// AFTER the rotation, in the same space.
let g_mg_xf: i32 = 0;
let g_mg_a00: f64 = 1.0; let g_mg_a01: f64 = 0.0; let g_mg_a02: f64 = 0.0;
let g_mg_a10: f64 = 0.0; let g_mg_a11: f64 = 1.0; let g_mg_a12: f64 = 0.0;
let g_mg_a20: f64 = 0.0; let g_mg_a21: f64 = 0.0; let g_mg_a22: f64 = 1.0;
let g_mg_ox: f64 = 0.0;  let g_mg_oy: f64 = 0.0;  let g_mg_oz: f64 = 0.0;

export fn mg_set_cant(p_yaw: f64, p_pitch: f64, p_roll: f64,
                      p_ox: f64, p_oy: f64, p_oz: f64) {
    let d: f64 = 0.017453292519943295;
    let ya: f64 = p_yaw * d;
    let pa: f64 = 0.0 - p_pitch * d;      // +pitch must RAISE the muzzle
    let ra: f64 = 0.0 - p_roll * d;       // +roll must tip the top toward +X
    let cy: f64 = cos(ya); let sy: f64 = sin(ya);
    let cp: f64 = cos(pa); let sp: f64 = sin(pa);
    let cr: f64 = cos(ra); let sr: f64 = sin(ra);
    // B = Rx(pa) * Rz(ra)
    let b00: f64 = cr;          let b01: f64 = 0.0 - sr;    let b02: f64 = 0.0;
    let b10: f64 = cp * sr;     let b11: f64 = cp * cr;     let b12: f64 = 0.0 - sp;
    let b20: f64 = sp * sr;     let b21: f64 = sp * cr;     let b22: f64 = cp;
    // A = Ry(ya) * B
    g_mg_a00 = cy * b00 + sy * b20;
    g_mg_a01 = cy * b01 + sy * b21;
    g_mg_a02 = cy * b02 + sy * b22;
    g_mg_a10 = b10; g_mg_a11 = b11; g_mg_a12 = b12;
    g_mg_a20 = cy * b20 - sy * b00;
    g_mg_a21 = cy * b21 - sy * b01;
    g_mg_a22 = cy * b22 - sy * b02;
    g_mg_ox = p_ox; g_mg_oy = p_oy; g_mg_oz = p_oz;
    g_mg_xf = 1;
}

export fn mg_clear_cant() {
    g_mg_xf = 0;
    g_mg_a00 = 1.0; g_mg_a01 = 0.0; g_mg_a02 = 0.0;
    g_mg_a10 = 0.0; g_mg_a11 = 1.0; g_mg_a12 = 0.0;
    g_mg_a20 = 0.0; g_mg_a21 = 0.0; g_mg_a22 = 1.0;
    g_mg_ox = 0.0; g_mg_oy = 0.0; g_mg_oz = 0.0;
}

// ---------------------------------------------------------------------------
// vertex helpers
// ---------------------------------------------------------------------------

fn mg_v(p_m, p_x: f64, p_y: f64, p_z: f64, p_s: f64, p_t: f64,
        p_mat: i32, p_col: i32, p_ao: f64): i32 {
    let x: f64 = p_x; let y: f64 = p_y; let z: f64 = p_z;
    if (g_mg_xf == 1) {
        x = g_mg_a00 * p_x + g_mg_a01 * p_y + g_mg_a02 * p_z + g_mg_ox;
        y = g_mg_a10 * p_x + g_mg_a11 * p_y + g_mg_a12 * p_z + g_mg_oy;
        z = g_mg_a20 * p_x + g_mg_a21 * p_y + g_mg_a22 * p_z + g_mg_oz;
    }
    let i: i32 = mesh_vert(p_m, x, y, z,
                           mg_u(p_mat, p_s), mg_vv(p_mat, p_t),
                           pal_r(p_col), pal_g(p_col), pal_b(p_col));
    mesh_vert_ao(p_m, i, p_ao);
    let out: i32 = i;
    return out;
}

fn mg_vn(p_m, p_x: f64, p_y: f64, p_z: f64, p_s: f64, p_t: f64,
         p_mat: i32, p_col: i32, p_ao: f64,
         p_nx: f64, p_ny: f64, p_nz: f64): i32 {
    let x: f64 = p_x; let y: f64 = p_y; let z: f64 = p_z;
    let nx: f64 = p_nx; let ny: f64 = p_ny; let nz: f64 = p_nz;
    if (g_mg_xf == 1) {
        x = g_mg_a00 * p_x + g_mg_a01 * p_y + g_mg_a02 * p_z + g_mg_ox;
        y = g_mg_a10 * p_x + g_mg_a11 * p_y + g_mg_a12 * p_z + g_mg_oy;
        z = g_mg_a20 * p_x + g_mg_a21 * p_y + g_mg_a22 * p_z + g_mg_oz;
        nx = g_mg_a00 * p_nx + g_mg_a01 * p_ny + g_mg_a02 * p_nz;
        ny = g_mg_a10 * p_nx + g_mg_a11 * p_ny + g_mg_a12 * p_nz;
        nz = g_mg_a20 * p_nx + g_mg_a21 * p_ny + g_mg_a22 * p_nz;
    }
    let i: i32 = mesh_vert_n(p_m, x, y, z,
                             mg_u(p_mat, p_s), mg_vv(p_mat, p_t),
                             pal_r(p_col), pal_g(p_col), pal_b(p_col),
                             nx, ny, nz);
    mesh_vert_ao(p_m, i, p_ao);
    let out: i32 = i;
    return out;
}

// ---------------------------------------------------------------------------
// mg_box — the workhorse. 12 triangles.
// ---------------------------------------------------------------------------
// `p_tdx`/`p_tdz` shear the top face and `p_ts` scales it: a box, a wedge, a
// tapered post and a leaning crate are all the same call. AO carries a vertical
// gradient (bottom x0.84) so every box has a built-in top-lit read even before
// the light bake — ART_BIBLE 8.2.5.
export fn mg_box_ex(p_m, p_cx: f64, p_cy: f64, p_cz: f64,
                    p_hx: f64, p_hy: f64, p_hz: f64,
                    p_tdx: f64, p_tdz: f64, p_ts: f64,
                    p_mat: i32, p_chi: i32, p_clo: i32, p_ao: f64): i32 {
    let m = p_m;
    let mat: i32 = p_mat;
    let ao: f64 = p_ao;
    let aob: f64 = p_ao * 0.84;
    let cmid: i32 = mg_mix(p_clo, p_chi, 0.58);

    let x0b: f64 = p_cx - p_hx;          let x1b: f64 = p_cx + p_hx;
    let z0b: f64 = p_cz - p_hz;          let z1b: f64 = p_cz + p_hz;
    let x0t: f64 = p_cx + p_tdx - p_hx * p_ts;
    let x1t: f64 = p_cx + p_tdx + p_hx * p_ts;
    let z0t: f64 = p_cz + p_tdz - p_hz * p_ts;
    let z1t: f64 = p_cz + p_tdz + p_hz * p_ts;
    let yb: f64 = p_cy - p_hy;           let yt: f64 = p_cy + p_hy;

    let t0: i32 = mesh_tri_count(m);

    // THE WINDING RULE: corners are authored outward-counter-clockwise as they
    // always were, the normal comes from `mg_face_n` on the first three, and
    // `mesh_quad` gets them REVERSED (a,d,c,b). The top and bottom faces are
    // horizontal whatever the shear does — every top corner sits at `yt` — so
    // their normals are exact constants and skip the cross product.

    // +Y  (top)
    let a = mg_vn(m, x0t, yt, z0t, 0.0, 0.0, mat, p_chi, ao, 0.0, 1.0, 0.0);
    let b = mg_vn(m, x0t, yt, z1t, 0.0, 1.0, mat, p_chi, ao, 0.0, 1.0, 0.0);
    let c = mg_vn(m, x1t, yt, z1t, 1.0, 1.0, mat, p_chi, ao, 0.0, 1.0, 0.0);
    let d = mg_vn(m, x1t, yt, z0t, 1.0, 0.0, mat, p_chi, ao, 0.0, 1.0, 0.0);
    mesh_quad(m, a, d, c, b);

    // -Y  (bottom) — the darkest face, it only ever sees bounce
    let e = mg_vn(m, x0b, yb, z0b, 0.0, 0.0, mat, p_clo, aob * 0.86, 0.0, -1.0, 0.0);
    let f = mg_vn(m, x1b, yb, z0b, 1.0, 0.0, mat, p_clo, aob * 0.86, 0.0, -1.0, 0.0);
    let g = mg_vn(m, x1b, yb, z1b, 1.0, 1.0, mat, p_clo, aob * 0.86, 0.0, -1.0, 0.0);
    let h = mg_vn(m, x0b, yb, z1b, 0.0, 1.0, mat, p_clo, aob * 0.86, 0.0, -1.0, 0.0);
    mesh_quad(m, e, h, g, f);

    // +Z
    let sc_pz: i32 = mg_side_col(p_clo, p_chi, 0.0, 1.0);
    mg_face_n(x0b, yb, z1b, x1b, yb, z1b, x1t, yt, z1t);
    let i0 = mg_vn(m, x0b, yb, z1b, 0.0, 1.0, mat, sc_pz, aob, g_mg_nx, g_mg_ny, g_mg_nz);
    let i1 = mg_vn(m, x1b, yb, z1b, 1.0, 1.0, mat, sc_pz, aob, g_mg_nx, g_mg_ny, g_mg_nz);
    let i2 = mg_vn(m, x1t, yt, z1t, 1.0, 0.0, mat, sc_pz, ao,  g_mg_nx, g_mg_ny, g_mg_nz);
    let i3 = mg_vn(m, x0t, yt, z1t, 0.0, 0.0, mat, sc_pz, ao,  g_mg_nx, g_mg_ny, g_mg_nz);
    mesh_quad(m, i0, i3, i2, i1);

    // -Z
    let sc_nz: i32 = mg_side_col(p_clo, p_chi, 0.0, -1.0);
    mg_face_n(x1b, yb, z0b, x0b, yb, z0b, x0t, yt, z0t);
    let j0 = mg_vn(m, x1b, yb, z0b, 0.0, 1.0, mat, sc_nz, aob, g_mg_nx, g_mg_ny, g_mg_nz);
    let j1 = mg_vn(m, x0b, yb, z0b, 1.0, 1.0, mat, sc_nz, aob, g_mg_nx, g_mg_ny, g_mg_nz);
    let j2 = mg_vn(m, x0t, yt, z0t, 1.0, 0.0, mat, sc_nz, ao,  g_mg_nx, g_mg_ny, g_mg_nz);
    let j3 = mg_vn(m, x1t, yt, z0t, 0.0, 0.0, mat, sc_nz, ao,  g_mg_nx, g_mg_ny, g_mg_nz);
    mesh_quad(m, j0, j3, j2, j1);

    // +X
    let sc_px: i32 = mg_side_col(p_clo, p_chi, 1.0, 0.0);
    mg_face_n(x1b, yb, z1b, x1b, yb, z0b, x1t, yt, z0t);
    let k0 = mg_vn(m, x1b, yb, z1b, 0.0, 1.0, mat, sc_px, aob, g_mg_nx, g_mg_ny, g_mg_nz);
    let k1 = mg_vn(m, x1b, yb, z0b, 1.0, 1.0, mat, sc_px, aob, g_mg_nx, g_mg_ny, g_mg_nz);
    let k2 = mg_vn(m, x1t, yt, z0t, 1.0, 0.0, mat, sc_px, ao,  g_mg_nx, g_mg_ny, g_mg_nz);
    let k3 = mg_vn(m, x1t, yt, z1t, 0.0, 0.0, mat, sc_px, ao,  g_mg_nx, g_mg_ny, g_mg_nz);
    mesh_quad(m, k0, k3, k2, k1);

    // -X
    let sc_nx: i32 = mg_side_col(p_clo, p_chi, -1.0, 0.0);
    mg_face_n(x0b, yb, z0b, x0b, yb, z1b, x0t, yt, z1t);
    let l0 = mg_vn(m, x0b, yb, z0b, 0.0, 1.0, mat, sc_nx, aob, g_mg_nx, g_mg_ny, g_mg_nz);
    let l1 = mg_vn(m, x0b, yb, z1b, 1.0, 1.0, mat, sc_nx, aob, g_mg_nx, g_mg_ny, g_mg_nz);
    let l2 = mg_vn(m, x0t, yt, z1t, 1.0, 0.0, mat, sc_nx, ao,  g_mg_nx, g_mg_ny, g_mg_nz);
    let l3 = mg_vn(m, x0t, yt, z0t, 0.0, 0.0, mat, sc_nx, ao,  g_mg_nx, g_mg_ny, g_mg_nz);
    mesh_quad(m, l0, l3, l2, l1);

    let out: i32 = mesh_tri_count(m) - t0;
    return out;
}

export fn mg_box(p_m, p_cx: f64, p_cy: f64, p_cz: f64,
                 p_hx: f64, p_hy: f64, p_hz: f64,
                 p_mat: i32, p_chi: i32, p_clo: i32, p_ao: f64): i32 {
    let out: i32 = mg_box_ex(p_m, p_cx, p_cy, p_cz, p_hx, p_hy, p_hz,
                             0.0, 0.0, 1.0, p_mat, p_chi, p_clo, p_ao);
    return out;
}

// ---------------------------------------------------------------------------
// mg_vm_shell — a viewmodel box with its three invisible faces deleted.
// 6 triangles, not 12.
// ---------------------------------------------------------------------------
// A viewmodel is the one object in the game whose view direction is a BUILD
// TIME CONSTANT: the weapon is emitted at a fixed offset from the eye and
// carries a fixed cant, so the same three faces of every part are drawn in
// every frame of the whole game. Which three was MEASURED, not derived, and
// the answer is NOT the one the rest of this file assumed — see the block
// below `g_wp_side_ax`. Building the Sparrow as +Y / -Z / +X shells and
// rendering it produced `tris.drawn` 1500 -> 1381 and an EMPTY SCREEN: all 120
// were backface-rejected. The set the rasteriser keeps is:
//
//     -Y   45.0 % of the drawn area   the big plate the eye reads as the body
//     +Z   27.7 %                     the trailing facet
//     -X   27.3 %                     the flank
//
// so those are the three built here. The three deleted ones need the view
// direction to swing 19 deg in weapon space (the tightest pair is +-X, |dot|
// 0.326) before any of them could appear; weapon sway is a couple of degrees.
// The three kept faces exactly tile a box's projected hexagon, so the
// silhouette is bit-identical to the 12-triangle version.
//
// This is where the viewmodel triangle budget comes from: 20 parts at 12 tris
// was 240 submitted of which 120 were rejected every single frame; 20 parts at
// 6 is 120 submitted and 120 drawn. Same model, same silhouette, half the
// submission and no wasted transform.
//
// Colour: -Y is the biggest drawn facet, so it takes `chi` at full AO — it is
// this model's "top plate" in everything but name. The other two take the
// side split, which `g_wp_side_ax/az` aims at -X (hi) and +Z (the step below).
//
// 🛑 2026-07-28 — EVERYTHING ABOVE IS A DESCRIPTION OF A BUG, NOT OF A DESIGN.
// The three faces this builder keeps are the three the rasteriser keeps *only
// because this file's winding was inverted* (see THE WINDING RULE above, and
// the same correction in the g_mg_vm_lx block). With correct winding the
// camera-facing set is the (+Y, -Z, +X) one the original author reached for,
// and the "EMPTY SCREEN" experiment quoted above was measuring the inversion,
// not the view direction.
//
// This one builder is LEFT INVERTED ON PURPOSE. It is self-contained —
// `build_weapon` reaches the box primitive only through here, never through
// `mg_box_ex` — so fixing the rest of the file does not disturb it, and the
// project owner's playtest note is "you can ignore the gun for now ... maybe
// do something easier for fps pov? like a torch?". Retuning five rounds of
// viewmodel value work to then delete it would be the wrong trade.
//
// WHEN THE VIEWMODEL IS REPLACED, the correct build is: keep the authored
// corner order, take the outward normal from `mg_face_n`, emit the quad
// reversed, build the (+Y, -Z, +X) faces, and NEGATE `g_mg_vm_lx/ly/lz` back
// to (0.500, 0.570, -0.652) — the round-4 "correction" that negated the key
// was compensating for this same inversion.
fn mg_vm_shell(p_m, p_cx: f64, p_cy: f64, p_cz: f64,
               p_hx: f64, p_hy: f64, p_hz: f64,
               p_mat: i32, p_chi: i32, p_clo: i32, p_ao: f64): i32 {
    let m = p_m;
    let mat: i32 = p_mat;
    let ao: f64 = p_ao;
    let aob: f64 = p_ao * 0.86;
    let x0: f64 = p_cx - p_hx;  let x1: f64 = p_cx + p_hx;
    let z0: f64 = p_cz - p_hz;  let z1: f64 = p_cz + p_hz;
    let yb: f64 = p_cy - p_hy;  let yt: f64 = p_cy + p_hy;
    let t0: i32 = mesh_tri_count(m);

    // -Y — the largest drawn facet. Windings are copied verbatim from
    // mg_box_ex so the baked face normals are identical to a full box's.
    let e = mg_v(m, x0, yb, z0, 0.0, 0.0, mat, p_chi, ao);
    let f = mg_v(m, x1, yb, z0, 1.0, 0.0, mat, p_chi, ao);
    let g = mg_v(m, x1, yb, z1, 1.0, 1.0, mat, p_chi, ao);
    let h = mg_v(m, x0, yb, z1, 0.0, 1.0, mat, p_chi, ao);
    mesh_quad(m, e, f, g, h);

    // +Z — the trailing facet
    let sc_pz: i32 = mg_side_col(p_clo, p_chi, 0.0, 1.0);
    let i0 = mg_v(m, x0, yb, z1, 0.0, 1.0, mat, sc_pz, aob);
    let i1 = mg_v(m, x1, yb, z1, 1.0, 1.0, mat, sc_pz, aob);
    let i2 = mg_v(m, x1, yt, z1, 1.0, 0.0, mat, sc_pz, ao);
    let i3 = mg_v(m, x0, yt, z1, 0.0, 0.0, mat, sc_pz, ao);
    mesh_quad(m, i0, i1, i2, i3);

    // -X — the flank the player looks at
    let sc_nx: i32 = mg_side_col(p_clo, p_chi, -1.0, 0.0);
    let l0 = mg_v(m, x0, yb, z0, 0.0, 1.0, mat, sc_nx, aob);
    let l1 = mg_v(m, x0, yb, z1, 1.0, 1.0, mat, sc_nx, aob);
    let l2 = mg_v(m, x0, yt, z1, 1.0, 0.0, mat, sc_nx, ao);
    let l3 = mg_v(m, x0, yt, z0, 0.0, 0.0, mat, sc_nx, ao);
    mesh_quad(m, l0, l1, l2, l3);

    let out: i32 = mesh_tri_count(m) - t0;
    return out;
}

// ---------------------------------------------------------------------------
// mg_prism — n-sided prism about +Y. caps: 0 none, 1 top, 2 bottom, 3 both.
// ---------------------------------------------------------------------------
export fn mg_prism(p_m, p_cx: f64, p_cy: f64, p_cz: f64,
                   p_r: f64, p_h: f64, p_sides: i32, p_yaw: f64, p_caps: i32,
                   p_mat: i32, p_chi: i32, p_clo: i32, p_ao: f64): i32 {
    let m = p_m;
    let n: i32 = p_sides;
    let yb: f64 = p_cy - p_h * 0.5;
    let yt: f64 = p_cy + p_h * 0.5;
    let t0: i32 = mesh_tri_count(m);
    let step: f64 = 2.0 * PI / f64(n);
    let ao: f64 = p_ao;
    let aob: f64 = p_ao * 0.84;

    let k: i32 = 0;
    while (k < n) {
        let a0: f64 = p_yaw + step * f64(k);
        let a1: f64 = p_yaw + step * f64(k + 1);
        let s0: f64 = mg_ring_scale(k);
        let s1: f64 = mg_ring_scale((k + 1) % n);
        let dx0: f64 = cos(a0); let dz0: f64 = sin(a0);
        let dx1: f64 = cos(a1); let dz1: f64 = sin(a1);
        let x0: f64 = p_cx + dx0 * p_r * s0; let z0: f64 = p_cz + dz0 * p_r * s0;
        let x1: f64 = p_cx + dx1 * p_r * s1; let z1: f64 = p_cz + dz1 * p_r * s1;
        let c0: i32 = mg_side_col(p_clo, p_chi, dx0, dz0);
        let c1: i32 = mg_side_col(p_clo, p_chi, dx1, dz1);
        let u0: f64 = f64(k) / f64(n);
        let u1: f64 = f64(k + 1) / f64(n);
        let v0 = mg_vn(m, x0, yb, z0, u0, 1.0, p_mat, c0, aob, dx0, 0.0, dz0);
        let v1 = mg_vn(m, x1, yb, z1, u1, 1.0, p_mat, c1, aob, dx1, 0.0, dz1);
        let v2 = mg_vn(m, x1, yt, z1, u1, 0.0, p_mat, c1, ao,  dx1, 0.0, dz1);
        let v3 = mg_vn(m, x0, yt, z0, u0, 0.0, p_mat, c0, ao,  dx0, 0.0, dz0);
        mesh_quad(m, v0, v1, v2, v3);
        k++;
    }

    if ((p_caps & 1) == 1) {
        mg_fan_disc(m, p_cx, yt, p_cz, p_r, n, p_yaw, p_mat, p_chi, p_chi, ao, 1.0);
    }
    if ((p_caps & 2) == 2) {
        mg_fan_disc(m, p_cx, yb, p_cz, p_r, n, p_yaw, p_mat, p_clo, p_clo,
                    aob * 0.86, -1.0);
    }

    let out: i32 = mesh_tri_count(m) - t0;
    return out;
}

// ---------------------------------------------------------------------------
// mg_taper — a tapered tube between two arbitrary points. 2n triangles, no
// caps. This is the primitive that makes a KINKED trunk possible (ART_BIBLE
// 8.4: "Segment 2 kinks 8-12 degrees. NEVER straight.").
// ---------------------------------------------------------------------------
export fn mg_taper(p_m, p_x0: f64, p_y0: f64, p_z0: f64,
                   p_x1: f64, p_y1: f64, p_z1: f64,
                   p_r0: f64, p_r1: f64, p_sides: i32,
                   p_mat: i32, p_chi: i32, p_clo: i32, p_ao: f64): i32 {
    let m = p_m;
    let n: i32 = p_sides;
    let t0: i32 = mesh_tri_count(m);

    // orthonormal frame around the axis
    let ax: f64 = p_x1 - p_x0; let ay: f64 = p_y1 - p_y0; let az: f64 = p_z1 - p_z0;
    let al: f64 = sqrt(ax * ax + ay * ay + az * az);
    if (al <= 0.0) { let zero: i32 = 0; return zero; }
    ax = ax / al; ay = ay / al; az = az / al;
    let ux: f64 = 1.0; let uy: f64 = 0.0; let uz: f64 = 0.0;
    if (ay * ay < 0.9) { ux = 0.0; uy = 1.0; uz = 0.0; }
    // e0 = normalize(cross(u, a)), e1 = cross(a, e0)
    let e0x: f64 = uy * az - uz * ay;
    let e0y: f64 = uz * ax - ux * az;
    let e0z: f64 = ux * ay - uy * ax;
    let e0l: f64 = sqrt(e0x * e0x + e0y * e0y + e0z * e0z);
    e0x = e0x / e0l; e0y = e0y / e0l; e0z = e0z / e0l;
    let e1x: f64 = ay * e0z - az * e0y;
    let e1y: f64 = az * e0x - ax * e0z;
    let e1z: f64 = ax * e0y - ay * e0x;

    let step: f64 = 2.0 * PI / f64(n);
    let ao: f64 = p_ao;
    let aob: f64 = p_ao * 0.88;

    let k: i32 = 0;
    while (k < n) {
        let a0: f64 = step * f64(k);
        let a1: f64 = step * f64(k + 1);
        let c0: f64 = cos(a0); let s0: f64 = sin(a0);
        let c1: f64 = cos(a1); let s1: f64 = sin(a1);
        let j0: f64 = mg_ring_scale(k);
        let j1: f64 = mg_ring_scale((k + 1) % n);

        let n0x: f64 = e0x * c0 + e1x * s0;
        let n0y: f64 = e0y * c0 + e1y * s0;
        let n0z: f64 = e0z * c0 + e1z * s0;
        let n1x: f64 = e0x * c1 + e1x * s1;
        let n1y: f64 = e0y * c1 + e1y * s1;
        let n1z: f64 = e0z * c1 + e1z * s1;

        let b0x: f64 = p_x0 + n0x * p_r0 * j0;
        let b0y: f64 = p_y0 + n0y * p_r0 * j0;
        let b0z: f64 = p_z0 + n0z * p_r0 * j0;
        let b1x: f64 = p_x0 + n1x * p_r0 * j1;
        let b1y: f64 = p_y0 + n1y * p_r0 * j1;
        let b1z: f64 = p_z0 + n1z * p_r0 * j1;
        let t1x: f64 = p_x1 + n1x * p_r1 * j1;
        let t1y: f64 = p_y1 + n1y * p_r1 * j1;
        let t1z: f64 = p_z1 + n1z * p_r1 * j1;
        let t2x: f64 = p_x1 + n0x * p_r1 * j0;
        let t2y: f64 = p_y1 + n0y * p_r1 * j0;
        let t2z: f64 = p_z1 + n0z * p_r1 * j0;

        let col0: i32 = mg_side_col(p_clo, p_chi, n0x, n0z);
        let col1: i32 = mg_side_col(p_clo, p_chi, n1x, n1z);
        let u0: f64 = f64(k) / f64(n);
        let u1: f64 = f64(k + 1) / f64(n);

        let q0 = mg_vn(m, b0x, b0y, b0z, u0, 1.0, p_mat, col0, aob, n0x, n0y, n0z);
        let q1 = mg_vn(m, b1x, b1y, b1z, u1, 1.0, p_mat, col1, aob, n1x, n1y, n1z);
        let q2 = mg_vn(m, t1x, t1y, t1z, u1, 0.0, p_mat, col1, ao,  n1x, n1y, n1z);
        let q3 = mg_vn(m, t2x, t2y, t2z, u0, 0.0, p_mat, col0, ao,  n0x, n0y, n0z);
        // REVERSED — THE WINDING RULE. `mg_taper`'s ring frame is
        // e0 x e1 = +axis, the OPPOSITE handedness to `mg_prism`'s
        // ex x ez = -ey, so the identical vertex order that is correct there
        // was inverted here. Every trunk, stem and barrel body in the game
        // came through this line. The normals are explicit, so only the
        // traversal changes and the light bake is untouched.
        mesh_quad(m, q0, q3, q2, q1);
        k++;
    }
    let out: i32 = mesh_tri_count(m) - t0;
    return out;
}

// ---------------------------------------------------------------------------
// mg_fan_disc — n triangles. p_face is +1 (up) or -1 (down).
// The rim normal is tilted outward so the disc reads as a dome rather than a
// plate once the light is baked: this is what turns "hexagon" into "canopy".
// ---------------------------------------------------------------------------
export fn mg_fan_disc(p_m, p_cx: f64, p_cy: f64, p_cz: f64,
                      p_r: f64, p_sides: i32, p_yaw: f64,
                      p_mat: i32, p_ccen: i32, p_crim: i32,
                      p_ao: f64, p_face: f64): i32 {
    let m = p_m;
    let n: i32 = p_sides;
    let t0: i32 = mesh_tri_count(m);
    let step: f64 = 2.0 * PI / f64(n);
    let fy: f64 = 1.0;
    if (p_face < 0.0) { fy = -1.0; }

    // The centre is raised by 28 % of the radius. A flat fan reads as a plate
    // edge-on and a canopy built from plates looks like a palm tree; a domed
    // fan keeps a silhouette from every angle for the same triangle count.
    let cen = mg_vn(m, p_cx, p_cy + 0.28 * p_r * fy, p_cz, 0.5, 0.5,
                    p_mat, p_ccen, p_ao, 0.0, fy, 0.0);
    let k: i32 = 0;
    while (k < n) {
        let a0: f64 = p_yaw + step * f64(k);
        let a1: f64 = p_yaw + step * f64(k + 1);
        let j0: f64 = mg_ring_scale(k);
        let j1: f64 = mg_ring_scale((k + 1) % n);
        let dx0: f64 = cos(a0); let dz0: f64 = sin(a0);
        let dx1: f64 = cos(a1); let dz1: f64 = sin(a1);
        let x0: f64 = p_cx + dx0 * p_r * j0; let z0: f64 = p_cz + dz0 * p_r * j0;
        let x1: f64 = p_cx + dx1 * p_r * j1; let z1: f64 = p_cz + dz1 * p_r * j1;
        let c0: i32 = mg_side_col(mg_scale(p_crim, 0.88), p_crim, dx0, dz0);
        let c1: i32 = mg_side_col(mg_scale(p_crim, 0.88), p_crim, dx1, dz1);
        let v0 = mg_vn(m, x0, p_cy, z0, 0.5 + dx0 * 0.5, 0.5 + dz0 * 0.5,
                       p_mat, c0, p_ao * 0.92, dx0 * 0.55, fy, dz0 * 0.55);
        let v1 = mg_vn(m, x1, p_cy, z1, 0.5 + dx1 * 0.5, 0.5 + dz1 * 0.5,
                       p_mat, c1, p_ao * 0.92, dx1 * 0.55, fy, dz1 * 0.55);
        // REVERSED — THE WINDING RULE. Both branches were the wrong way round,
        // so an up-facing disc was visible only from BELOW and a down-facing
        // one only from ABOVE. That is the "flying over it didn't render all
        // sides" report: a canopy layer, a prism cap and a lantern base are all
        // this primitive, and all of them vanished when you got above them.
        if (fy > 0.0) { mesh_tri(m, cen, v0, v1); } else { mesh_tri(m, cen, v1, v0); }
        k++;
    }
    let out: i32 = mesh_tri_count(m) - t0;
    return out;
}

// ---------------------------------------------------------------------------
// mg_lathe — surface of revolution through (radius, y) profile rings.
// Rings with r == 0 collapse into a fan, so a bottle, a barrel and a bulb are
// one call. 2 * sides * (rings-1) triangles at most.
// ---------------------------------------------------------------------------
export fn mg_lathe(p_m, p_cx: f64, p_cy: f64, p_cz: f64,
                   p_prof_r: array<f64>, p_prof_y: array<f64>, p_rings: i32,
                   p_sides: i32, p_mat: i32,
                   p_chi: i32, p_clo: i32, p_ao: f64): i32 {
    let m = p_m;
    let n: i32 = p_sides;
    let rings: i32 = p_rings;
    let t0: i32 = mesh_tri_count(m);
    let step: f64 = 2.0 * PI / f64(n);
    let ymin: f64 = p_prof_y[0];
    let ymax: f64 = p_prof_y[rings - 1];
    let yspan: f64 = ymax - ymin;
    if (yspan <= 0.0) { yspan = 1.0; }

    let ri: i32 = 0;
    while (ri < rings - 1) {
        let r0: f64 = p_prof_r[ri];
        let r1: f64 = p_prof_r[ri + 1];
        let y0: f64 = p_cy + p_prof_y[ri];
        let y1: f64 = p_cy + p_prof_y[ri + 1];
        let tv0: f64 = 1.0 - (p_prof_y[ri] - ymin) / yspan;
        let tv1: f64 = 1.0 - (p_prof_y[ri + 1] - ymin) / yspan;
        let ao0: f64 = p_ao * (0.84 + 0.16 * (1.0 - tv0));
        let ao1: f64 = p_ao * (0.84 + 0.16 * (1.0 - tv1));
        // outward slope for the normal
        let dr: f64 = r1 - r0;
        let dy: f64 = y1 - y0;
        let sl: f64 = sqrt(dr * dr + dy * dy);
        let ny: f64 = 0.0;
        if (sl > 0.0) { ny = 0.0 - dr / sl; }

        let k: i32 = 0;
        while (k < n) {
            let a0: f64 = step * f64(k);
            let a1: f64 = step * f64(k + 1);
            let j0: f64 = mg_ring_scale2(ri, k);
            let j1: f64 = mg_ring_scale2(ri, (k + 1) % n);
            let k0: f64 = mg_ring_scale2(ri + 1, k);
            let k1: f64 = mg_ring_scale2(ri + 1, (k + 1) % n);
            let dx0: f64 = cos(a0); let dz0: f64 = sin(a0);
            let dx1: f64 = cos(a1); let dz1: f64 = sin(a1);
            let c0: i32 = mg_side_col(p_clo, p_chi, dx0, dz0);
            let c1: i32 = mg_side_col(p_clo, p_chi, dx1, dz1);
            let u0: f64 = f64(k) / f64(n);
            let u1: f64 = f64(k + 1) / f64(n);

            if (r0 <= 0.0) {
                if (r1 > 0.0) {
                    let a = mg_vn(m, p_cx, y0, p_cz, 0.5, tv0, p_mat, c0, ao0, 0.0, -1.0, 0.0);
                    let b = mg_vn(m, p_cx + dx0 * r1 * k0, y1, p_cz + dz0 * r1 * k0,
                                  u0, tv1, p_mat, c0, ao1, dx0, ny, dz0);
                    let c = mg_vn(m, p_cx + dx1 * r1 * k1, y1, p_cz + dz1 * r1 * k1,
                                  u1, tv1, p_mat, c1, ao1, dx1, ny, dz1);
                    mesh_tri(m, a, c, b);
                }
            } else {
                if (r1 <= 0.0) {
                    let a = mg_vn(m, p_cx, y1, p_cz, 0.5, tv1, p_mat, c0, ao1, 0.0, 1.0, 0.0);
                    let b = mg_vn(m, p_cx + dx0 * r0 * j0, y0, p_cz + dz0 * r0 * j0,
                                  u0, tv0, p_mat, c0, ao0, dx0, ny, dz0);
                    let c = mg_vn(m, p_cx + dx1 * r0 * j1, y0, p_cz + dz1 * r0 * j1,
                                  u1, tv0, p_mat, c1, ao0, dx1, ny, dz1);
                    mesh_tri(m, a, b, c);
                } else {
                    let q0 = mg_vn(m, p_cx + dx0 * r0 * j0, y0, p_cz + dz0 * r0 * j0,
                                   u0, tv0, p_mat, c0, ao0, dx0, ny, dz0);
                    let q1 = mg_vn(m, p_cx + dx1 * r0 * j1, y0, p_cz + dz1 * r0 * j1,
                                   u1, tv0, p_mat, c1, ao0, dx1, ny, dz1);
                    let q2 = mg_vn(m, p_cx + dx1 * r1 * k1, y1, p_cz + dz1 * r1 * k1,
                                   u1, tv1, p_mat, c1, ao1, dx1, ny, dz1);
                    let q3 = mg_vn(m, p_cx + dx0 * r1 * k0, y1, p_cz + dz0 * r1 * k0,
                                   u0, tv1, p_mat, c0, ao1, dx0, ny, dz0);
                    mesh_quad(m, q0, q1, q2, q3);
                }
            }
            k++;
        }
        ri++;
    }
    let out: i32 = mesh_tri_count(m) - t0;
    return out;
}

// ---------------------------------------------------------------------------
// mg_spike — a 4-triangle tetrahedral protrusion from base point to tip.
// This is the signature-protrusion primitive (antenna, spine, tendril, barrel).
// ---------------------------------------------------------------------------
export fn mg_spike(p_m, p_bx: f64, p_by: f64, p_bz: f64,
                   p_tx: f64, p_ty: f64, p_tz: f64, p_w: f64,
                   p_mat: i32, p_chi: i32, p_clo: i32, p_ao: f64): i32 {
    let m = p_m;
    let t0: i32 = mesh_tri_count(m);
    let ax: f64 = p_tx - p_bx; let ay: f64 = p_ty - p_by; let az: f64 = p_tz - p_bz;
    let al: f64 = sqrt(ax * ax + ay * ay + az * az);
    if (al <= 0.0) { let zero: i32 = 0; return zero; }
    ax = ax / al; ay = ay / al; az = az / al;
    let ux: f64 = 1.0; let uy: f64 = 0.0; let uz: f64 = 0.0;
    if (ay * ay < 0.9) { ux = 0.0; uy = 1.0; uz = 0.0; }
    let e0x: f64 = uy * az - uz * ay;
    let e0y: f64 = uz * ax - ux * az;
    let e0z: f64 = ux * ay - uy * ax;
    let e0l: f64 = sqrt(e0x * e0x + e0y * e0y + e0z * e0z);
    e0x = e0x / e0l; e0y = e0y / e0l; e0z = e0z / e0l;
    let e1x: f64 = ay * e0z - az * e0y;
    let e1y: f64 = az * e0x - ax * e0z;
    let e1z: f64 = ax * e0y - ay * e0x;

    let px: array<f64> = [];
    let py: array<f64> = [];
    let pz: array<f64> = [];
    let k: i32 = 0;
    while (k < 3) {
        let a: f64 = 2.0 * PI * f64(k) / 3.0;
        let c: f64 = cos(a); let s: f64 = sin(a);
        px.push(p_bx + (e0x * c + e1x * s) * p_w);
        py.push(p_by + (e0y * c + e1y * s) * p_w);
        pz.push(p_bz + (e0z * c + e1z * s) * p_w);
        k++;
    }

    // THE WINDING RULE. This builder used `mg_v`, i.e. it let `mesh_tri`
    // derive each face normal from the winding — so simply reversing the
    // traversal would have flipped the light with it. The four pool vertices
    // were also SHARED across the four faces, and a shared pool vertex can
    // only carry one explicit normal, which would smooth a shape whose whole
    // job is to be a hard-edged spike. So each face now gets its own three
    // pool vertices with the face's own outward normal.
    //
    // This costs POOL entries only. The arena is non-indexed — `mesh_tri`
    // copies three vertices per triangle whatever the pool looks like — so the
    // triangle count, the vertex count and the per-frame cost are unchanged:
    // still exactly 4 triangles.
    let uu: array<f64> = [0.0, 1.0, 0.5];
    let k2: i32 = 0;
    while (k2 < 3) {
        let j: i32 = (k2 + 1) % 3;
        mg_face_n(px[k2], py[k2], pz[k2], px[j], py[j], pz[j], p_tx, p_ty, p_tz);
        let s0 = mg_vn(m, px[k2], py[k2], pz[k2], uu[k2], 1.0, p_mat, p_clo,
                       p_ao * 0.86, g_mg_nx, g_mg_ny, g_mg_nz);
        let s1 = mg_vn(m, px[j], py[j], pz[j], uu[j], 1.0, p_mat, p_clo,
                       p_ao * 0.86, g_mg_nx, g_mg_ny, g_mg_nz);
        let s2 = mg_vn(m, p_tx, p_ty, p_tz, 0.5, 0.0, p_mat, p_chi,
                       p_ao, g_mg_nx, g_mg_ny, g_mg_nz);
        mesh_tri(m, s0, s2, s1);
        k2++;
    }
    // the base cap, authored (b2, b1, b0) as before and emitted reversed
    mg_face_n(px[2], py[2], pz[2], px[1], py[1], pz[1], px[0], py[0], pz[0]);
    let c0 = mg_vn(m, px[2], py[2], pz[2], 0.5, 1.0, p_mat, p_clo,
                   p_ao * 0.86, g_mg_nx, g_mg_ny, g_mg_nz);
    let c1 = mg_vn(m, px[1], py[1], pz[1], 1.0, 1.0, p_mat, p_clo,
                   p_ao * 0.86, g_mg_nx, g_mg_ny, g_mg_nz);
    let c2 = mg_vn(m, px[0], py[0], pz[0], 0.0, 1.0, p_mat, p_clo,
                   p_ao * 0.86, g_mg_nx, g_mg_ny, g_mg_nz);
    mesh_tri(m, c0, c2, c1);
    let out: i32 = mesh_tri_count(m) - t0;
    return out;
}

// A flat 2-triangle panel in the XY plane at z, facing +Z. Used for enemy
// NS_MID accent panels, the contact blob and weapon detail plates.
export fn mg_panel(p_m, p_cx: f64, p_cy: f64, p_cz: f64,
                   p_hx: f64, p_hy: f64, p_mat: i32, p_col: i32, p_ao: f64): i32 {
    let m = p_m;
    let t0: i32 = mesh_tri_count(m);
    let a = mg_vn(m, p_cx - p_hx, p_cy - p_hy, p_cz, 0.0, 1.0, p_mat, p_col, p_ao, 0.0, 0.0, 1.0);
    let b = mg_vn(m, p_cx + p_hx, p_cy - p_hy, p_cz, 1.0, 1.0, p_mat, p_col, p_ao, 0.0, 0.0, 1.0);
    let c = mg_vn(m, p_cx + p_hx, p_cy + p_hy, p_cz, 1.0, 0.0, p_mat, p_col, p_ao, 0.0, 0.0, 1.0);
    let d = mg_vn(m, p_cx - p_hx, p_cy + p_hy, p_cz, 0.0, 0.0, p_mat, p_col, p_ao, 0.0, 0.0, 1.0);
    mesh_quad(m, a, d, c, b);   // REVERSED — THE WINDING RULE
    let out: i32 = mesh_tri_count(m) - t0;
    return out;
}

// A flat 2-triangle quad in the XZ plane facing +Y.
//
// WINDING — this was WRONG until round 2 and it is why the gate reported "no
// contact shadow anywhere in the entire set" while the harness was dutifully
// emitting one under every prop. The renderer culls on SCREEN signed area
// (`mesh_set_cull(MESH_CULL_NEG)`, emit rejects `area <= 0`, screen y down), so
// an upward-facing horizontal quad must traverse its footprint in the same
// order the terrain does: (-x,-z) (+x,-z) (+x,+z) (-x,+z). The old order walked
// it the other way round, which makes an upward face wind counter-clockwise on
// screen and be dropped as a backface — silently, invisibly, and counted only
// in `rej.backface`, which is 1900+ per frame from legitimate box interiors.
//
// If you add a horizontal face anywhere in this file, copy this order.
export fn mg_ground_quad(p_m, p_r: f64, p_mat: i32, p_col: i32, p_ao: f64): i32 {
    let m = p_m;
    let t0: i32 = mesh_tri_count(m);
    let a = mg_vn(m, -p_r, 0.0, -p_r, 0.0, 0.0, p_mat, p_col, p_ao, 0.0, 1.0, 0.0);
    let b = mg_vn(m,  p_r, 0.0, -p_r, 1.0, 0.0, p_mat, p_col, p_ao, 0.0, 1.0, 0.0);
    let c = mg_vn(m,  p_r, 0.0,  p_r, 1.0, 1.0, p_mat, p_col, p_ao, 0.0, 1.0, 0.0);
    let d = mg_vn(m, -p_r, 0.0,  p_r, 0.0, 1.0, p_mat, p_col, p_ao, 0.0, 1.0, 0.0);
    mesh_quad(m, a, b, c, d);
    let out: i32 = mesh_tri_count(m) - t0;
    return out;
}

// ===========================================================================
// THE REGISTRY
// ===========================================================================

export let MESH_TREE0     = 0;
export let MESH_TREE1     = 1;
export let MESH_TREE2     = 2;
export let MESH_BUSH      = 3;
export let MESH_ROCK      = 4;
export let MESH_CRATE     = 5;
export let MESH_BARREL    = 6;
export let MESH_LANTERN   = 7;
export let MESH_BLOB      = 8;

export let MESH_WISP0     = 9;
export let MESH_WISP1     = 10;
export let MESH_WISP2     = 11;
export let MESH_MOTE0     = 12;
export let MESH_MOTE1     = 13;
export let MESH_MOTE2     = 14;
export let MESH_HUSK0     = 15;
export let MESH_HUSK1     = 16;
export let MESH_HUSK2     = 17;
export let MESH_SPITTER0  = 18;
export let MESH_SPITTER1  = 19;
export let MESH_SPITTER2  = 20;
export let MESH_WARDEN0   = 21;
export let MESH_WARDEN1   = 22;
export let MESH_WARDEN2   = 23;
export let MESH_BULWARK0  = 24;
export let MESH_BULWARK1  = 25;
export let MESH_BULWARK2  = 26;

// ---------------------------------------------------------------------------
// THE VILLAGER — THREE LODs, because a town is thirty of these.
// ---------------------------------------------------------------------------
// `MESH_NPC` was one slot and one 220-triangle mesh, always drawn in full.
// DIRECTION.md §6 measured what that costs: ten villagers is 2200 triangles,
// the entire steady budget, for people standing still — "this, not building
// geometry, is what stands between us and a town that feels inhabited".
//
// So the villager now has the same three-tier shape every other character
// asset has. `MESH_NPC` is KEPT as an alias of `MESH_NPC0` so that every
// existing caller (`main.hml`, `shot.hml`, `walk.hml`, `benchframe.hml` — none
// of them owned by this task) keeps compiling and keeps getting the full mesh.
// A caller that wants the LODs asks `meshgen_npc_mesh(lod)` and passes the
// switch distances `MG_NPC_LOD1_M` / `MG_NPC_LOD2_M`.
export let MESH_NPC0      = 27;
export let MESH_NPC       = 27;   // alias of MESH_NPC0 — the full mesh
export let MESH_NPC1      = 28;
export let MESH_NPC2      = 29;

// ---------------------------------------------------------------------------
// THE VIEWMODEL SLOT — the first viewmodel slot is the LANTERN, not a gun.
// ---------------------------------------------------------------------------
// First human playtest, verbatim: "the gun is just like floating in front of
// the pov camera ... i think you can ignore the gun for now and maybe do
// something easier for fps pov? like a torch?"
//
// The first viewmodel slot builds `build_lantern_vm`. `MESH_SPARROW_VM` is kept
// as an ALIAS of the same id so that `tools/walk.hml`, `tools/shot.hml` and
// `tools/meshgen.hml` — none of which this task owns — bind the lantern with no
// edit. The Sparrow AR mesh is GONE; its part table `g_wp_sparrow` is still
// referenced by nothing and is left in place only because the five remaining
// guns share `wpn_parts` with it.
//
// The other five gun meshes are RETAINED, unbound and never drawn, because
// `tools/meshgen.hml` (not owned here) imports `MESH_EMBERLANCE_VM` and runs a
// six-way weapon-silhouette IoU assertion over the six slots. Deleting them
// would break a tool this task may not edit. Nothing in the render path
// references them: `frame_bind_assets` is only ever handed the lantern.
//
// ⚠ THESE SIX MOVED 28..33 -> 30..35 when the villager grew two LOD slots.
// Nothing in the repo names a viewmodel by its NUMBER — every reference goes
// through these constants — so the move is a renumber, not an API change.
export let MESH_LANTERN_VM    = 30;
export let MESH_SPARROW_VM    = 30;   // DEPRECATED alias of MESH_LANTERN_VM
export let MESH_TINKER_VM     = 31;
export let MESH_BELLOWS_VM    = 32;
export let MESH_LONGSHADOW_VM = 33;
export let MESH_KESTREL_VM    = 34;
export let MESH_EMBERLANCE_VM = 35;

export let MESH_COUNT     = 36;

// ---------------------------------------------------------------------------
// THE VILLAGER LOD SWITCH DISTANCES, exported so no caller invents its own.
// ---------------------------------------------------------------------------
// LOD0 (218 tris) is CONVERSATION range only: inside 9 m a villager is 37 px
// tall and every one of its eighteen parts is at least a pixel, so this is the
// only band where the satchel, the scarf, the separate arms and the boots buy
// anything. Outside it they are sub-pixel detail costing 176 triangles.
//
// LOD1 (42 tris) runs 9..26 m — the whole of a town square. 26 m is where the
// villager drops under 13 px, i.e. where ART_BIBLE 8.1's "identifiable by
// class" test stops being about parts and starts being about mass.
//
// LOD2 (12 tris) is everything beyond, out to the fog wall.
export let MG_NPC_LOD1_M: f64 = 9.0;
export let MG_NPC_LOD2_M: f64 = 26.0;

// enemy classes (index into the six-class tables)
export let ENEMY_WISP    = 0;
export let ENEMY_MOTE    = 1;
export let ENEMY_HUSK    = 2;
export let ENEMY_SPITTER = 3;
export let ENEMY_WARDEN  = 4;
export let ENEMY_BULWARK = 5;
export let ENEMY_COUNT   = 6;

// kinds, for tooling
export let MG_KIND_PROP   = 0;
export let MG_KIND_ENEMY  = 1;
export let MG_KIND_NPC    = 2;
export let MG_KIND_WEAPON = 3;
// A ground decal is not a lit object. It is the ABSENCE of light on a surface
// somebody else already lit, so it is neither baked against the sun nor lifted
// off the luminance floor — see `meshgen_bake_all`.
export let MG_KIND_DECAL  = 4;

let g_mg_mesh: array = [];
let g_mg_name: array = [];
let g_mg_budget: array<i32> = [];
let g_mg_kind: array<i32> = [];
let g_mg_view: array<f64> = [];      // preferred contact-sheet yaw, radians
let g_mg_built: i32 = 0;

// Per-class measurements, filled in during the build. These are the numbers
// ART_BIBLE 8.2.2 / 8.2.3 are asserted against.
let g_mg_head_w: array<f64> = [];
let g_mg_sh_w: array<f64> = [];
let g_mg_prot_len: array<f64> = [];
let g_mg_prot_axis: array<i32> = [];

export fn meshgen_count(): i32 { let out: i32 = MESH_COUNT; return out; }
export fn meshgen_is_built(): i32 { let out: i32 = g_mg_built; return out; }
export fn meshgen_mesh(p_id: i32) { return g_mg_mesh[p_id]; }
export fn meshgen_name(p_id: i32): string { let out: string = g_mg_name[p_id]; return out; }
export fn meshgen_budget(p_id: i32): i32 { let out: i32 = g_mg_budget[p_id]; return out; }
export fn meshgen_kind(p_id: i32): i32 { let out: i32 = g_mg_kind[p_id]; return out; }
export fn meshgen_view_yaw(p_id: i32): f64 { let out: f64 = g_mg_view[p_id]; return out; }
export fn meshgen_tris(p_id: i32): i32 {
    let out: i32 = mesh_tri_count(g_mg_mesh[p_id]);
    return out;
}
export fn meshgen_radius(p_id: i32): f64 {
    let out: f64 = mesh_radius(g_mg_mesh[p_id]);
    return out;
}

// The enemy mesh for a class at a LOD level (0 near, 1 mid, 2 far).
export fn meshgen_enemy_mesh(p_class: i32, p_lod: i32): i32 {
    let out: i32 = MESH_WISP0 + p_class * 3 + p_lod;
    return out;
}

// The villager mesh at a LOD level (0 conversation, 1 mid, 2 far). The three
// slots are contiguous exactly like the enemy triples, so a caller can hand
// `meshgen_npc_mesh(0..2)` straight to `world_prop_add` beside
// `MG_NPC_LOD1_M` / `MG_NPC_LOD2_M`.
export fn meshgen_npc_mesh(p_lod: i32): i32 {
    let l: i32 = p_lod;
    if (l < 0) { l = 0; }
    if (l > 2) { l = 2; }
    let out: i32 = MESH_NPC0 + l;
    return out;
}

// shoulder width / head width — ART_BIBLE 8.2.2, the primary 12 px class read.
export fn mg_head_shoulder(p_class: i32): f64 {
    let out: f64 = g_mg_sh_w[p_class] / g_mg_head_w[p_class];
    return out;
}
export fn mg_head_width(p_class: i32): f64 { let out: f64 = g_mg_head_w[p_class]; return out; }
export fn mg_shoulder_width(p_class: i32): f64 { let out: f64 = g_mg_sh_w[p_class]; return out; }
// signature protrusion length in metres — ART_BIBLE 8.2.3, must be >= 0.45.
export fn mg_protrusion(p_class: i32): f64 { let out: f64 = g_mg_prot_len[p_class]; return out; }
export fn mg_protrusion_axis(p_class: i32): i32 { let out: i32 = g_mg_prot_axis[p_class]; return out; }

fn mg_register(p_id: i32, p_name: string, p_budget: i32, p_kind: i32,
               p_view: f64, p_cap: i32) {
    g_mg_mesh[p_id] = mesh_new(p_cap);
    g_mg_name[p_id] = p_name;
    g_mg_budget[p_id] = p_budget;
    g_mg_kind[p_id] = p_kind;
    g_mg_view[p_id] = p_view;
}

// ===========================================================================
// FLORA — ART_BIBLE 8.4
// ===========================================================================
//
// Trunk:  6-sided tapered prism, 3 vertical segments, radius 0.235 -> 0.13 m,
//         BARK_HI on the +SUN_DIR side and BARK_LO opposite (mg_side_col does
//         this for every round primitive), kinked 8-12 degrees at segment 2.
// Canopy: FOUR hexagonal discs on a LEANING spiral, radii 1.95/2.15/1.60/1.00.
//         Each disc is a TOP fan (LEAF_HI at the centre, which catches the sun,
//         -> LEAF_MID at the rim) and a BOTTOM fan at LEAF_LO * 0.75. That
//         vertical value break is what turns "hexagon" into "mass".
// Branch: ONE asymmetric stub at 2.4 m, 4 tris.
//
//   3 x 12 (trunk) + 4 x 12 (canopy) + 4 (branch) = 88 tris
//
// ART_BIBLE 8.3 budgets the tree at 96; 88 is -8.3 %, inside the +-10 % band.
//
// ---------------------------------------------------------------------------
// WHY THE CROWN LEANS — the fix for "three identical lollipop trees"
// ---------------------------------------------------------------------------
// The harness already gives every tree instance a random yaw and a 0.85..1.25
// scale. That did nothing, and the round-1 gate correctly reported three trees
// with "the same silhouette": the old crown was three CONCENTRIC discs offset
// 0.15-0.30 m about a vertical axis, i.e. a solid of revolution. Rotating a
// solid of revolution produces the identical silhouette by definition, so all
// the per-instance yaw in the world cannot help it.
//
// The crown is now a LEANING SPIRAL: each layer steps 0.30 + 0.30 * layer
// metres off the axis, swinging 0.62 rad per layer around a lean direction
// tied to the trunk's own kink. The top layer sits ~1.2 m off the trunk on a
// 1.0 m radius, so the crown genuinely hangs to one side — which is what a
// real tree reaching for light does, and it means yaw jitter finally changes
// what you see. It also costs exactly zero triangles: one trunk segment paid
// for the fourth canopy layer, and four layers over 2.9-4.75 m read as MASS
// where three squat ones over 3.05-4.50 m read as a mushroom cap.
fn build_tree0(p_m, p_seed: i32) {
    let m = p_m;
    let seed: i32 = p_seed;

    // --- trunk, 3 segments, kink at segment 2 -----------------------------
    let kink: f64 = (9.0 + 5.0 * mg_h01(seed * 7 + 1)) * PI / 180.0;
    let kdir: f64 = mg_h01(seed * 7 + 2) * 2.0 * PI;
    let ys: array<f64> = [0.0, 1.15, 2.30, 3.40];
    let rs: array<f64> = [0.235, 0.198, 0.164, 0.130];
    let xs: array<f64> = [0.0, 0.0, 0.0, 0.0];
    let zs: array<f64> = [0.0, 0.0, 0.0, 0.0];
    let dx: f64 = 0.0; let dz: f64 = 0.0;
    let s: i32 = 1;
    while (s < 4) {
        if (s >= 2) {
            let seg: f64 = ys[s] - ys[s - 1];
            let lean: f64 = sin(kink) * seg;
            dx = dx + cos(kdir) * lean * (0.70 + 0.60 * f64(s - 1));
            dz = dz + sin(kdir) * lean * (0.70 + 0.60 * f64(s - 1));
        }
        xs[s] = dx; zs[s] = dz;
        s++;
    }
    mg_set_jitter(0.05, seed + 11);
    s = 0;
    while (s < 3) {
        mg_taper(m, xs[s], ys[s], zs[s], xs[s + 1], ys[s + 1], zs[s + 1],
                 rs[s], rs[s + 1], 6, MG_MAT_BARK, g_BARK_HI, g_BARK_LO, 0.94);
        s++;
    }
    mg_set_jitter(0.0, 0);

    // The crown leans roughly with the trunk kink but not exactly, so trunk
    // and canopy do not read as one rigid bent stick.
    let cdir: f64 = kdir + 0.85;

    // --- one asymmetric branch stub, reaching with the crown --------------
    let bdir: f64 = cdir - 0.35;
    let bx: f64 = xs[2] * 0.9; let bz: f64 = zs[2] * 0.9;
    mg_spike(m, bx, 2.35, bz,
             bx + cos(bdir) * 1.25, 3.10, bz + sin(bdir) * 1.25, 0.085,
             MG_MAT_BARK, g_BARK_HI, g_BARK_LO, 0.90);

    // --- canopy: 4 hexagonal discs on a leaning spiral ---------------------
    let cr: array<f64> = [1.95, 2.15, 1.62, 1.00];
    let ch: array<f64> = [2.92, 3.55, 4.18, 4.75];
    let leaf_bot: i32 = mg_scale(g_LEAF_LO, 0.75);
    let d: i32 = 0;
    while (d < 4) {
        let off: f64 = 0.30 + 0.30 * f64(d) + 0.12 * mg_h01(seed * 13 + d * 3 + 6);
        let ang: f64 = cdir + 0.62 * f64(d);
        let ox: f64 = xs[3] * 0.7 + cos(ang) * off;
        let oz: f64 = zs[3] * 0.7 + sin(ang) * off;
        let yaw: f64 = f64(d) * 22.0 * PI / 180.0;
        mg_set_jitter(0.16, seed + d * 29 + 3);
        mg_fan_disc(m, ox, ch[d], oz, cr[d], 6, yaw, MG_MAT_LEAF,
                    g_LEAF_HI, g_LEAF_MID, 1.0, 1.0);
        mg_fan_disc(m, ox, ch[d] - 0.32, oz, cr[d] * 0.94, 6, yaw, MG_MAT_LEAF,
                    leaf_bot, leaf_bot, 0.80, -1.0);
        mg_set_jitter(0.0, 0);
        d++;
    }
}

// LOD1: 8-sided single-segment trunk (16) + one hex disc top+bottom (12) +
// one hex top fan (6) = 34 tris, exactly the ART_BIBLE 8.3 budget.
//
// This is the mesh that carries ridge_golden and hub_dawn — 18-46 m is where
// almost every tree in a 64 m fog volume actually lives — so it gets the same
// two-lobed asymmetry as LOD0 rather than being a tidy lollipop. The lower lobe
// sits 0.62 m one way, the upper lobe 0.95 m the other, which at 30 m is 6-9 px
// of offset: enough that a yawed instance is visibly a different tree.
fn build_tree1(p_m, p_seed: i32) {
    let m = p_m;
    let seed: i32 = p_seed;
    let kdir: f64 = mg_h01(seed * 7 + 2) * 2.0 * PI;
    let lean: f64 = 0.20;
    mg_set_jitter(0.04, seed + 5);
    // SIX sides, not eight (ART_BIBLE 8.3 costed this LOD with an 8-sided
    // trunk, hence its 34). LOD1 is only ever seen from 18-46 m, where the
    // trunk is 2-4 px wide and the two extra facets are provably invisible,
    // and the four triangles they cost are spent 20+ times in `budget_worst`.
    // The saving pays for the contact shadows, which are NOT invisible.
    // Registered budget updated to 30 to match — see mg_register below.
    mg_taper(m, 0.0, 0.0, 0.0,
             cos(kdir) * lean, 3.35, sin(kdir) * lean,
             0.220, 0.132, 6, MG_MAT_BARK, g_BARK_HI, g_BARK_LO, 0.94);
    mg_set_jitter(0.13, seed + 6);
    let ox: f64 = cos(kdir) * 0.62;
    let oz: f64 = sin(kdir) * 0.62;
    let ux: f64 = cos(kdir + 2.35) * 0.95;
    let uz: f64 = sin(kdir + 2.35) * 0.95;
    mg_fan_disc(m, ox, 3.25, oz, 2.00, 6, 0.0, MG_MAT_LEAF,
                g_LEAF_HI, g_LEAF_MID, 1.0, 1.0);
    mg_fan_disc(m, ox, 2.93, oz, 1.86, 6, 0.0, MG_MAT_LEAF,
                mg_scale(g_LEAF_LO, 0.75), mg_scale(g_LEAF_LO, 0.75), 0.80, -1.0);
    // THE UPPER TIER FACES DOWN. It is the only UNPAIRED `mg_fan_disc` in the
    // file whose viewer is below it: a 1.7 m eye is under a 4.10 m canopy from
    // every distance this LOD is ever drawn at (18-46 m), so its underside is
    // the only side that can be seen. The other three unpaired discs in this
    // file — the barrel lid at 0.85 m, the lantern base at 0.10 m and the
    // flora/enemy head caps at 0.56-0.74 m — are all BELOW eye height and
    // correctly stay face-up.
    //
    // This was authored face-up and read correctly only because the winding
    // was inverted: a face-up disc could then be seen from below and nowhere
    // else. With the winding fixed, leaving it up-facing deletes the tree's
    // whole second tier at eye level — measured on `ridge_golden`, the LOD1
    // trees went from a two-tier crown to a single thin parasol.
    //
    // It costs ZERO triangles and it takes the same UNDERSIDE value the main
    // lens uses, one step lighter so the two tiers separate rather than
    // merging into one dark mass. The honest cost is that the top tier is not
    // drawn when the camera is ABOVE it — from up there the 2.00 m main crown
    // is directly beneath it and carries the read. Closing it properly is
    // +6 triangles on the most-instanced mesh in the game (+120 on
    // `budget_worst`, which sits at 2462 of 2500) and does not fit.
    mg_fan_disc(m, ux, 4.10, uz, 1.34, 6, 0.6,
                MG_MAT_LEAF, g_LEAF_LO, mg_scale(g_LEAF_LO, 0.88), 0.88, -1.0);
    mg_set_jitter(0.0, 0);
}

// LOD2: two crossed quads, both faces, 8 tris. No texture detail survives at
// 45 m; what survives is a dark mass with a lit top.
fn build_tree2(p_m, p_seed: i32) {
    let m = p_m;
    let w: f64 = 1.95;
    let y0: f64 = 0.85;
    let y1: f64 = 5.05;
    let top: i32 = g_LEAF_MID;
    let bot: i32 = mg_scale(g_LEAF_LO, 0.82);
    let k: i32 = 0;
    while (k < 2) {
        let a: f64 = 0.35 + f64(k) * PI * 0.5;
        let dx: f64 = cos(a) * w; let dz: f64 = sin(a) * w;
        // asymmetric: the second card is narrower, offset and taller, so the
        // silhouette has a shoulder on one side. Two identical crossed quads
        // are a plus sign from every angle and read as a bush, not a tree.
        let sx: f64 = 0.0; let sz: f64 = 0.0;
        let hy: f64 = 0.0;
        if (k == 1) { sx = 1.05; sz = -0.25; hy = 0.70; }
        let a0 = mg_vn(m, sx - dx, y0, sz - dz, 0.0, 1.0, MG_MAT_LEAF, bot, 0.86, -dz, 0.35, dx);
        let a1 = mg_vn(m, sx + dx, y0, sz + dz, 1.0, 1.0, MG_MAT_LEAF, bot, 0.86, -dz, 0.35, dx);
        let a2 = mg_vn(m, sx + dx, y1 + hy, sz + dz, 1.0, 0.0, MG_MAT_LEAF, top, 1.0, -dz, 0.35, dx);
        let a3 = mg_vn(m, sx - dx, y1 + hy, sz - dz, 0.0, 0.0, MG_MAT_LEAF, top, 1.0, -dz, 0.35, dx);
        // REVERSED — THE WINDING RULE. These two quads are a deliberate
        // double-sided pair, and BOTH of them were inverted, so the card the
        // player saw was always the one whose normal pointed away. The
        // silhouette was identical, which is why it hid: what was wrong was
        // that the lit face and the drawn face were never the same face.
        mesh_quad(m, a0, a3, a2, a1);
        let b0 = mg_vn(m, sx + dx, y0, sz + dz, 0.0, 1.0, MG_MAT_LEAF, bot, 0.86, dz, 0.35, -dx);
        let b1 = mg_vn(m, sx - dx, y0, sz - dz, 1.0, 1.0, MG_MAT_LEAF, bot, 0.86, dz, 0.35, -dx);
        let b2 = mg_vn(m, sx - dx, y1 + hy, sz - dz, 1.0, 0.0, MG_MAT_LEAF, top, 1.0, dz, 0.35, -dx);
        let b3 = mg_vn(m, sx + dx, y1 + hy, sz + dz, 0.0, 0.0, MG_MAT_LEAF, top, 1.0, dz, 0.35, -dx);
        mesh_quad(m, b0, b3, b2, b1);
        k++;
    }
}

// ---------------------------------------------------------------------------
// THE NIGHTSHADE FLORA — 22 tris. This mesh IS the ns_bloom money shot.
// ---------------------------------------------------------------------------
// It is registered as MESH_BUSH for historical reasons and the harness places
// 46 of them for `--scene ns_bloom` and 30 for `budget_worst`; it is placed
// nowhere else, so this asset is the nightshade plant and nothing else.
//
// It used to be a hexagonal dome with a sprig, textured CELL_LEAF_PINE, i.e. a
// dark green tent. The gate's verdict on ART_BIBLE 12.4 — "the violet money
// shot" — was 1.3 % violet, and the only violet in the frame was the additive
// halo card the harness parks on top of this mesh. A green tent under a violet
// blob is not a nightshade bloom.
//
// So: a STEM and a SPLAYED THREE-PETAL HEAD, because at 320x240 and 12 m a
// plant is nine pixels and the only thing that survives is the silhouette, and
// a three-point star says "flower" where a dome says "rock".
//
//   stem    3-sided taper, leaning              6 tris   LEAF, green
//   petals  3 x mg_spike splayed 120 deg apart 12 tris   NSFLORA, violet
//   leaf    1 x mg_spike at the base            4 tris   LEAF, green
//                                              -------
//                                               22 tris  (ART_BIBLE 8.3: 22)
//
// The petals are textured MG_MAT_NSFLORA — CELL_NS_FLORA, the violet tile
// texgen has been building all along and that nothing in the game had ever
// sampled. Vertex colour can only darken, so violet-on-violet would crush to
// mud; the petals therefore carry NS_HALO at the tip and NS_MID at the base,
// and the tile supplies the saturation. Measured on the atlas the product is
// (120,51,171) at the tip, which is unambiguously NS violet at any exposure.
//
// The head sits at 0.44-0.70 m on purpose: the harness parks an FX_GLOW_S
// NS_HALO card at y + 0.45 * scale with radius 0.8 * scale, so the additive
// halo lands ON the petals instead of hovering above a dome.
fn build_bush(p_m, p_seed: i32) {
    let m = p_m;
    let seed: i32 = p_seed;
    // stem, leaning a little so a field of them is not a field of posts
    let sd: f64 = mg_h01(seed * 3 + 5) * 2.0 * PI;
    let hx: f64 = cos(sd) * 0.10;
    let hz: f64 = sin(sd) * 0.10;
    mg_set_jitter(0.10, seed + 21);
    mg_taper(m, 0.0, 0.0, 0.0, hx, 0.46, hz, 0.060, 0.034, 3,
             MG_MAT_LEAF, g_LEAF_MID, mg_scale(g_LEAF_LO, 0.80), 0.90);
    mg_set_jitter(0.0, 0);
    // the three-petal head: splayed out and up, one petal rolled lower than
    // the other two so the head is not a perfect trefoil (ART_BIBLE 8.2.1).
    let p0: f64 = mg_h01(seed * 3 + 7) * 2.0 * PI;
    let k: i32 = 0;
    while (k < 3) {
        let a: f64 = p0 + f64(k) * 2.0943951023931953;
        let drop: f64 = 0.0;
        if (k == 1) { drop = 0.14; }
        mg_spike(m, hx, 0.44, hz,
                 hx + cos(a) * 0.31, 0.70 - drop, hz + sin(a) * 0.31, 0.075,
                 MG_MAT_NSFLORA, g_NS_HALO, g_NS_MID, 1.0);
        k++;
    }
    // one basal leaf, the orientation cue and the only green mass
    let la: f64 = p0 + 3.6;
    mg_spike(m, 0.02, 0.09, 0.0,
             0.02 + cos(la) * 0.36, 0.19, sin(la) * 0.36, 0.075,
             MG_MAT_LEAF, g_LEAF_HI, g_LEAF_MID, 0.90);
}

// Rock, 18 tris: a 6-sided lathe through three profile rings, the last one
// collapsed to a point so the top closes into a cone (12 + 6). Heavy radial
// jitter means no two facets match and no two instances look alike under a
// random yaw. Sits ON the ground: no bottom cap, nobody sees it.
let g_rock_r: array<f64> = [0.58, 0.40, 0.0];
let g_rock_y: array<f64> = [0.0, 0.30, 0.46];
fn build_rock(p_m, p_seed: i32) {
    let m = p_m;
    mg_set_jitter(0.36, p_seed + 41);
    mg_lathe(m, 0.0, 0.0, 0.0, g_rock_r, g_rock_y, 3, 6,
             MG_MAT_STONE, g_STONE_HI, g_STONE_LO, 0.94);
    mg_set_jitter(0.0, 0);
}

// Crate, 12 tris: a single skewed, tapered box. A cube is the most symmetric
// object possible, so this one leans and its lid is offset — at 12 px that lean
// is the entire read.
fn build_crate(p_m) {
    mg_box_ex(p_m, 0.0, 0.42, 0.0, 0.40, 0.42, 0.40,
              0.09, -0.05, 0.93, MG_MAT_WOOD, g_WOOD_HI, g_WOOD_LO, 0.95);
}

// Barrel, 24 tris: 8-sided body band (16) + top fan (8), staves dented by the
// radial jitter. It LEANS: a plumb-vertical cylinder is mirror-symmetric from
// every horizontal angle and therefore invisible as an orientation cue, and a
// leaning barrel also reads as debris rather than as level furniture.
fn build_barrel(p_m, p_seed: i32) {
    let m = p_m;
    mg_set_jitter(0.13, p_seed + 61);
    mg_taper(m, 0.0, 0.0, 0.0, 0.155, 0.845, 0.05, 0.31, 0.28, 8,
             MG_MAT_METAL, g_RUST, g_RUST_DARK, 0.93);
    mg_fan_disc(m, 0.155, 0.845, 0.05, 0.28, 8, 0.2, MG_MAT_METAL,
                g_STEEL_MID, g_RUST, 1.0, 1.0);
    mg_set_jitter(0.0, 0);
}

// Lantern post, 40 tris: 6-sided post (12) + base flare fan (6) + lantern head
// box (12) + a side bracket arm (12 -> 4 with a spike). The arm is on ONE side.
// This is the object the whole game's progression hangs off, so it gets a
// silhouette nobody can mistake at 30 m.
fn build_lantern(p_m) {
    let m = p_m;
    mg_prism(m, 0.0, 1.15, 0.0, 0.088, 2.30, 6, 0.0, 0,
             MG_MAT_METAL, g_STEEL_MID, g_STEEL_LO, 0.92);          // 12
    mg_fan_disc(m, 0.0, 0.10, 0.0, 0.26, 6, 0.0, MG_MAT_STONE,
                g_STONE_HI, g_STONE_MID, 0.92, 1.0);                 // 6
    mg_box(m, 0.0, 2.52, 0.0, 0.17, 0.22, 0.17,
           MG_MAT_METAL, g_BRASS, g_BRASS_LO, 1.0);                  // 12
    mg_box(m, 0.0, 2.76, 0.0, 0.21, 0.04, 0.21,
           MG_MAT_METAL, g_BRASS, g_BRASS_LO, 1.0);                  // 12
    mg_spike(m, 0.14, 2.40, 0.0, 0.62, 2.62, 0.0, 0.05,
             MG_MAT_METAL, g_STEEL_HI, g_STEEL_LO, 0.95);            // 4
    // THE LAMP. Round 3: this was MG_MAT_GLASS (CELL_WINDOW, max texel 187)
    // at unit AO, so the one thing in the world that is supposed to be a LIGHT
    // rendered darker than the brass box around it. It is now the world's
    // specular tile at a light gain, with an albedo whose red and blue clip and
    // whose green does not — so the panel renders at the tile's ceiling in two
    // channels and holds a violet cast in the third instead of going flat white.
    // A lantern is the only object in the world atlas's reach that can honestly
    // sit above luminance 220, and CLAUDE.md §8 wants one such object in every
    // frame; `flat_debug` is the scene that has no viewmodel to supply it.
    mg_panel(m, 0.0, 2.52, 0.175, 0.11, 0.15, MG_MAT_SPEC,
             mg_scale(g_NS_HALO, 1.10), 2.40);
}

// ---------------------------------------------------------------------------
// THE CONTACT / CAST SHADOW DECAL — 2 triangles, rebuilt every bake
// ---------------------------------------------------------------------------
// ART_BIBLE 4.3.1: "the highest-value 2 triangles in the project". CLAUDE.md §9
// rule 6: every prop and every entity gets one, no exceptions.
//
// The round-1 gate said "no cast shadow anywhere in the entire set" and it was
// right even though this mesh was already being emitted under every prop. Two
// things were wrong with it and both are fixed here.
//
// 1. IT WAS NOT DARK. The blob was an ordinary prop: `mesh_bake_light` gave it
//    ambient PLUS a full sun term (its normal is +Y, so at noon it took the sun
//    almost head-on and lit up like the ground it was supposed to be darkening)
//    and then `mg_lift_floor` dragged it up to luminance 72. Measured under the
//    hub_dawn NPC it rendered at (62,53,41) against ground at (70,72,20) — a
//    warm patch of dirt, not a shadow. A decal is now its own KIND: it is never
//    baked and never lifted, and its colour is written directly as
//    "this surface receives the AMBIENT and nothing else, times an occlusion
//    term". That is what a shadow physically is, it costs one multiply, and it
//    is automatically right at every hour — the shadow deepens exactly as much
//    as the sun's share of the light grows, and at midnight it degrades to a
//    plain ambient-occlusion smudge instead of a black hole.
//
// 2. IT NEVER MOVED. The geometry was built once, at boot, from the NOON sun
//    azimuth, so at 18:15 with the sun on the horizon the shadows still pointed
//    where the noon sun would have put them and were still round. The mesh is
//    now REBUILT inside `meshgen_bake_all` from the keyframe's own light
//    vector: it points away from the sun and its length is set by the sun's
//    ELEVATION, so golden hour gets long raking shadows and noon gets tight
//    ones. Rebuilding two triangles is ~microseconds and happens once per
//    keyframe change, never per frame.
//
// Shape: a DIAMOND, not a square. Two triangles cannot make an ellipse and a
// square reads as a crate lid lying on the grass; a diamond is the closest
// 4-gon to an ellipse and its long axis is the shadow direction, which is the
// cast-shadow cue doing double duty as the contact cue.
//
// Texture: MG_MAT_CONCRETE (CELL_CONCRETE, 143,137,122) rather than DIRT. The
// pixel is vertex x texel, so a warm dirt texel makes a warm shadow, and
// CLAUDE.md §8 says shadows are COOL. Concrete is the most neutral cell bound.
// ---------------------------------------------------------------------------
// ROUND-3 REVISION — "a detached, misaligned, differently-coloured smear"
// ---------------------------------------------------------------------------
// The round-2 decal was dark, it moved with the sun, and it still read wrong.
// Three separate faults, all fixed here.
//
// 1. IT WAS NOT ANCHORED. `build_blob` translated the WHOLE diamond down-sun by
//    `dir * (len - 1) * 0.62`, so the widest part of the shape — the part the
//    eye reads as "the object is HERE" — sat up to a metre away from the object
//    that cast it, with clear lit ground in between. A cast shadow must stay
//    WELDED to its caster's footprint and grow out of it; only the far tip may
//    travel. The shape is now a KITE, not a centred diamond: the waist (the
//    widest points, b and d) is at s = 0, i.e. exactly the emitted origin, which
//    `shot.hml` places at `terrain_h(prop_x, prop_z)`. The up-sun tip reaches
//    0.82 behind the footprint and only the down-sun tip runs out to `len`.
//    Nothing is translated any more.
//
// 2. THERE WAS NO CONTACT CORE. One flat colour over the whole quad is a cast
//    shadow with no ambient occlusion, and AO is what actually welds an object
//    to the ground. The critic asked for a separate short-radius high-opacity
//    core plus a long soft cast. Two triangles cannot carry two shapes — and
//    they must stay two, because `budget_worst` draws 28 props at 2472 of 2500
//    triangles and a second quad per prop is +56, which is over budget. So the
//    core is carried in VERTEX COLOUR instead of in geometry: the waist and the
//    up-sun tip are the core (occ 0.50, i.e. the ground darkened to half), and
//    the down-sun tip is the soft end of the cast (occ 0.86, barely darker than
//    lit ground). Gouraud across the quad gives a real falloff along the sun
//    axis, it costs zero triangles, and it is the thing that makes the decal
//    read as attached instead of as a sticker.
//
// 3. IT WAS THE WRONG HUE. Round 2 pulled the shadow 55 % toward neutral grey
//    to stop `tod.hml`'s near-cyan ambient staining it. That trades one wrong
//    hue for another: a neutral grey-blue patch on saturated green grass still
//    reads as DIFFERENT GROUND, which is exactly what the critic measured. A
//    shadow is the same ground receiving less light, so it must keep the
//    ground's hue and lose only value. This function already receives the
//    ground's chromaticity and nobody noticed: `p_br..p_bb` is the BOUNCE, the
//    light the ground throws back, so its chromaticity IS the ground albedo's.
//    The shadow colour is now (ground chromaticity) x (ambient chromaticity,
//    at reduced strength so it stays cool per CLAUDE.md §8) x (ambient level).
//    The desaturation constant is gone.
let g_mg_sh_dx: f64 = -0.6325;    // unit horizontal direction the shadow falls
let g_mg_sh_dz: f64 = -0.7746;
let g_mg_sh_len: f64 = 1.30;      // down-sun reach; the half-width is 1
// core = the contact patch under the caster; tail = the far end of the cast.
let g_mg_sh_r: i32 = 46;  let g_mg_sh_g: i32 = 50;  let g_mg_sh_b: i32 = 44;
let g_mg_sh_tr: i32 = 80; let g_mg_sh_tg: i32 = 86; let g_mg_sh_tb: i32 = 76;

// Occlusion at the contact point and at the far tip of the cast, as a fraction
// of the ambient the open ground receives. 0.50 is the "AO darkening 0.35-0.45
// within 0.3 m of the base" the critic asked for once the CELL_CONCRETE texel
// (mean 143/255 = 0.56) is folded in; 0.86 is a cast edge that fades out
// instead of ending on a hard line.
let g_mg_sh_occ_core: f64 = 0.42;
let g_mg_sh_occ_tail: f64 = 0.86;
// The up-sun tip is 30 % of the way from core to tail (an effective occlusion
// of 0.61): the sun cannot reach behind the prop either, but the sky partly
// can, so the kite is not a flat slab.
// How much of the GROUND's own chromaticity the shadow keeps (1.0 = the shadow
// is the same hue as the grass), and how much of the AMBIENT's it takes on
// (1.0 = a fully sky-coloured shadow, which is the cyan-on-green failure).
let g_mg_sh_ground: f64 = 0.80;
let g_mg_sh_sky: f64 = 0.38;
// Shadow length as a multiple of the half-width, at the two extremes of sun
// elevation. Clamped so a sun ON the horizon does not produce an infinite bar.
let g_mg_sh_len_min: f64 = 1.05;
let g_mg_sh_len_max: f64 = 2.60;

// Read-only accessors so a caller that draws its OWN ground geometry — the
// harness's `sm_building`, which has a footprint far too big for MESH_BLOB and
// currently meets the grass with no darkening at all — can plant it with the
// same colour, direction and length this file uses for props. See the task
// report: the building half of the contact-shadow fix needs one call site in
// `tools/shot.hml`, which this task does not own.
export fn meshgen_shadow_core_rgb(): i32 {
    let out: i32 = pal_pack(g_mg_sh_r, g_mg_sh_g, g_mg_sh_b);
    return out;
}
export fn meshgen_shadow_tail_rgb(): i32 {
    let out: i32 = pal_pack(g_mg_sh_tr, g_mg_sh_tg, g_mg_sh_tb);
    return out;
}
export fn meshgen_shadow_dx(): f64 { let out: f64 = g_mg_sh_dx; return out; }
export fn meshgen_shadow_dz(): f64 { let out: f64 = g_mg_sh_dz; return out; }
export fn meshgen_shadow_len(): f64 { let out: f64 = g_mg_sh_len; return out; }

fn build_blob(p_m) {
    let m = p_m;
    let core: i32 = pal_pack(g_mg_sh_r, g_mg_sh_g, g_mg_sh_b);
    let tail: i32 = pal_pack(g_mg_sh_tr, g_mg_sh_tg, g_mg_sh_tb);
    let back: i32 = mg_mix(core, tail, 0.30);
    let dx: f64 = g_mg_sh_dx;  let dz: f64 = g_mg_sh_dz;
    let px: f64 = 0.0 - dz;    let pz: f64 = dx;          // perpendicular
    let ln: f64 = g_mg_sh_len;
    let bk: f64 = 0.82;                                   // up-sun reach
    // Winding: the ring must run so that (b-a) x (c-b) points at -Y, which is
    // what the terrain's own quad order produces and what survives the screen
    // signed-area cull. See mg_ground_quad. Get this backwards and the whole
    // shadow system is invisible while every counter says it is working — which
    // is exactly what happened in round 1.
    let a = mg_vn(m, dx * ln, 0.0, dz * ln, 0.5, 0.0,
                  MG_MAT_CONCRETE, tail, 1.0, 0.0, 1.0, 0.0);
    let b = mg_vn(m, px, 0.0, pz, 1.0, 0.5,
                  MG_MAT_CONCRETE, core, 1.0, 0.0, 1.0, 0.0);
    let c = mg_vn(m, 0.0 - dx * bk, 0.0, 0.0 - dz * bk, 0.5, 1.0,
                  MG_MAT_CONCRETE, back, 1.0, 0.0, 1.0, 0.0);
    let d = mg_vn(m, 0.0 - px, 0.0, 0.0 - pz, 0.0, 0.5,
                  MG_MAT_CONCRETE, core, 1.0, 0.0, 1.0, 0.0);
    mesh_quad(m, a, b, c, d);
}

// ===========================================================================
// ENEMIES — six classes, three LODs, rigid part hierarchies
// ===========================================================================
//
// ART_BIBLE 8.2.2 head:shoulder ratios, spread so that no two classes are
// within 0.25 of each other:
//
//   Wisp 1.05 | Spitter 1.35 | Husk 1.70 | Mote 2.10 | Warden 2.60 | Bulwark 3.20
//
// and 8.2.3 signature protrusions, each >= 0.45 m and each on a different axis:
//
//   Wisp     trailing tail spike        -Z
//   Mote     hanging tendril            -Y
//   Husk     backpack antenna           +Y
//   Spitter  side-mounted spout          +X
//   Warden   forward shoulder ram        +Z
//   Bulwark  oversized left arm + spike -X

// per-class body proportions, indexed by ENEMY_*
//                                 wisp  mote  husk  spit  ward  bulw
let g_hu_height: array<f64>   = [ 0.55, 0.90, 1.85, 2.05, 2.30, 3.20 ];
// head half-width, then shoulder half-width == head * the ratio above. The
// heads are deliberately large: a 0.26 m head on a 1.85 m body is 1.4 px wide
// at 30 m and disappears. PS1 characters are chunky for exactly this reason.
let g_hu_head_hw: array<f64>  = [ 0.180,0.115,0.155,0.150,0.150,0.175 ];
let g_hu_sh_hw: array<f64>    = [ 0.189,0.2415,0.2635,0.2025,0.390,0.560 ];
// Protrusion lengths are the SPIKE lengths; what ART_BIBLE 8.2.3 asks for is
// how far the spike reaches BEYOND the body, which is what mg_measure_class
// reports and what --verify asserts. These values were tuned until every class
// measures >= 0.50 m of clear overhang.
let g_hu_prot: array<f64>     = [ 0.62, 0.66, 1.02, 0.86, 1.20, 1.50 ];
// Six classes, six DIFFERENT protrusion axes, so no two classes read the same
// at 12 px: 0 = +X, 1 = -X, 2 = +Y, 3 = -Y, 4 = +Z, 5 = -Z.
let g_hu_axis: array<i32>     = [ 5,    3,    2,    0,    4,    1 ];

fn hu_body_col(p_class: i32): i32 {
    if (p_class == ENEMY_WISP)    { let c: i32 = g_NIGHTSHADE_FLORA; return c; }
    if (p_class == ENEMY_MOTE)    { let c: i32 = g_ICHOR; return c; }
    if (p_class == ENEMY_HUSK)    { let c: i32 = g_MUD; return c; }
    if (p_class == ENEMY_SPITTER) { let c: i32 = g_STONE_MOSS; return c; }
    if (p_class == ENEMY_WARDEN)  { let c: i32 = g_GRANITE_LO; return c; }
    let c: i32 = g_STONE_MID;
    return c;
}
fn hu_limb_col(p_class: i32): i32 {
    if (p_class == ENEMY_WISP)    { let c: i32 = g_NS_MID; return c; }
    if (p_class == ENEMY_MOTE)    { let c: i32 = g_NS_MID; return c; }
    if (p_class == ENEMY_HUSK)    { let c: i32 = g_DIRT_MID; return c; }
    if (p_class == ENEMY_SPITTER) { let c: i32 = g_LEAF_SICK; return c; }
    if (p_class == ENEMY_WARDEN)  { let c: i32 = g_STEEL_MID; return c; }
    let c: i32 = g_GRANITE_HI;
    return c;
}

// ---------------------------------------------------------------------------
// THE HUMANOID LOD1/LOD2 READ, AND WHY IT WAS BROKEN. Read before "simplifying".
// ---------------------------------------------------------------------------
// MEASURED, before this change, with `lodread` (silhouettes rasterized at true
// 320x240 pixel density, feet on a common ground line, centroids aligned,
// worst-of-8-yaws IoU — the number the player actually has to beat):
//
//     villager vs husk_lod1  @20 m   0.737        villager vs husk_lod2  @40 m  0.889
//     villager vs spit_lod1  @30 m   0.737        villager vs husk_lod2  @55 m  0.917
//     husk_lod1 vs spit_lod1 @20 m   0.702        husk_lod2 vs spit_lod2 @40 m  0.900
//
// i.e. at LOD2 a Husk, a Spitter and a villager are the SAME nine-pixel bar.
// Three separate causes, all fixed here, none of which cost a triangle each:
//
// 1. THE VIOLET WAS LOD0-ONLY. `NS_CORE` is the whole long-range hostile
//    contract (CLAUDE.md §8, ART_BIBLE S2) and the chest panel that carries it
//    existed on the LOD0 branch alone — so a hostile LOST its hostile marker at
//    exactly the range where the marker is the only thing left. The 2-triangle
//    panel is now on all three tiers. LOD1 90 tris (was 88, budget 90), LOD2 30
//    (was 28; the registered budget moves 28 -> 30 with it).
//
// 2. THE SIGNATURE PROTRUSION SHRANK WITH THE BODY. ART_BIBLE 8.2.3 sizes it
//    at ">= 3 px at 30 m"; at 45 m the same 1.02 m antenna is 2 px and at 60 m
//    it is 1.5 px, so the one feature that separates the four humanoid classes
//    dissolves precisely on the tier that has nothing else. The spike is scaled
//    1.00 / 1.14 / 1.42 by tier and thickened 1.0 / 1.35 / 1.9, which is free:
//    it is 4 triangles at every tier. It is measured for ART_BIBLE 8.2.3 off
//    LOD0 only, so the assertion still describes the mesh the player meets.
//
// 3. LOD2 THREW AWAY THE CLASS AND KEPT THE POSE. The box-man was one body box
//    of `sw * 0.86` for everybody, so Husk and Spitter differed only by 11 % of
//    width. LOD2 now spends its two boxes on the two proportions that survive
//    at 10 px — the shoulder:hip taper and the head:shoulder ratio — with the
//    Bulwark's body slabbed sideways so its oversized arm reads as lopsided
//    mass rather than vanishing with the arm boxes.
//
// The humanoid classes (Husk, Spitter, Warden, Bulwark) share one part
// hierarchy driven by the proportion table. LOD0 186 tris, LOD1 90, LOD2 30
// against ART_BIBLE 8.3's 180 / 90 / 28.
fn build_humanoid(p_m, p_class: i32, p_lod: i32) {
    let m = p_m;
    let cls: i32 = p_class;
    let h: f64 = g_hu_height[cls];
    let hw: f64 = g_hu_head_hw[cls];
    let sw: f64 = g_hu_sh_hw[cls];
    let body: i32 = hu_body_col(cls);
    let limb: i32 = hu_limb_col(cls);
    let dark: i32 = mg_scale(body, 0.78);
    // ART_BIBLE 8.2.5 — value-block the model at build time: head and upper
    // torso brighter, legs darker. This is a built-in top-lit gradient that
    // survives any lighting condition and is what stops a character reading as
    // one flat blob at 12 px, where no lighting detail survives.
    let vhi: i32 = mg_scale(body, 1.30);
    let vlo: i32 = mg_scale(limb, 0.82);
    let lhi: i32 = mg_scale(limb, 1.14);

    let leg_top: f64 = h * 0.47;
    let hip_y: f64 = leg_top + h * 0.05;
    let torso_y: f64 = h * 0.68;
    let sh_y: f64 = h * 0.80;
    let head_y: f64 = h - hw * 1.05;
    let lean: f64 = h * 0.035;          // forward lean, every class hunches a little
    let hip_hw: f64 = sw * 0.74;
    let arm_r: f64 = sw * 0.30;
    let leg_r: f64 = sw * 0.34;
    // The Bulwark's read at 12 px is "one arm is wrong". It gets an oversized
    // LEFT arm — by scaling the existing boxes, not by adding new ones, so the
    // miniboss stays inside the same 186/88/28 triangle envelope as the rest.
    let larm_r: f64 = arm_r;
    if (cls == ENEMY_BULWARK) { larm_r = arm_r * 1.75; }

    if (p_lod == 2) {
        // box-man: body + head + violet + protrusion. 30 tris.
        //
        // The body is no longer a straight slab. `p_ts` carries the class's
        // shoulder:hip taper (the Warden and the Bulwark are top-heavy, the
        // Spitter is a stalk) and `p_tdx` leans the Bulwark's mass over its
        // oversized side. Both are free — mg_box_ex takes them anyway.
        let ts2: f64 = 0.72 + (sw / hw) * 0.10;      // 0.90 wisp-ish .. 1.04 bulwark
        if (ts2 > 1.10) { ts2 = 1.10; }
        let tdx2: f64 = 0.0;
        if (cls == ENEMY_BULWARK) { tdx2 = 0.0 - sw * 0.34; }
        if (cls == ENEMY_WARDEN) { tdx2 = sw * 0.12; }
        mg_box_ex(m, 0.0, h * 0.42, lean * 0.4, sw * 0.86, h * 0.42, sw * 0.70,
                  tdx2, lean * 0.6, ts2, MG_MAT_HIDE, body, vlo, 0.95);
        mg_box_ex(m, hw * 0.30 + tdx2, head_y, lean, hw, hw * 1.05, hw * 0.92,
                  hw * 0.22, 0.0, 0.92, MG_MAT_HIDE, vhi, body, 1.0);
        // the hostile marker, at the tier where it is the ONLY class-independent
        // "this one wants to kill you" signal left (ART_BIBLE S2)
        mg_panel(m, 0.0 - sw * 0.16, sh_y - h * 0.06, sw * 0.72 + 0.010,
                 sw * 0.34, h * 0.055, MG_MAT_NSFLORA, g_NS_HALO, 1.0);
    } else {
        if (p_lod == 1) {
            // head, torso, pelvis, 2 arms, 2 legs = 84
            mg_box_ex(m, hw * 0.28, head_y, lean, hw, hw * 1.05, hw * 0.92,
                      hw * 0.24, 0.0, 0.92, MG_MAT_HIDE, vhi, body, 1.0);
            mg_box_ex(m, 0.0, torso_y, lean * 0.7, sw, h * 0.13, sw * 0.72,
                      0.0, lean * 0.5, 0.86, MG_MAT_HIDE, vhi, dark, 0.98);
            mg_box(m, 0.0, hip_y, 0.0, hip_hw, h * 0.07, hip_hw * 0.66,
                   MG_MAT_HIDE, body, dark, 0.92);
            mg_box_ex(m, 0.0 - sw - larm_r * 0.7, torso_y - h * 0.06, lean * 0.4,
                      larm_r, h * 0.20, larm_r,
                      0.0 - larm_r * 0.9, larm_r * 1.4, 0.86,
                      MG_MAT_HIDE, limb, dark, 0.92);
            mg_box_ex(m, sw + arm_r * 0.7, torso_y - h * 0.09, lean * 0.4,
                      arm_r * 0.92, h * 0.22, arm_r * 0.92,
                      arm_r * 0.5, 0.0 - arm_r * 1.8, 0.86,
                      MG_MAT_HIDE, limb, dark, 0.92);
            mg_box(m, 0.0 - hip_hw * 0.55, leg_top * 0.5, 0.0,
                   leg_r, leg_top * 0.5, leg_r, MG_MAT_HIDE, vlo, dark, 0.86);
            mg_box_ex(m, hip_hw * 0.55, leg_top * 0.5, 0.0,
                      leg_r, leg_top * 0.5, leg_r, 0.0, leg_r * 1.2, 1.0,
                      MG_MAT_HIDE, vlo, dark, 0.86);
            // ... + the violet chest panel = 90. At 18..36 m this is the
            // dominant hostile cue and LOD1 used to be the tier that dropped it.
            mg_panel(m, 0.0 - sw * 0.18, torso_y + h * 0.02, sw * 0.74 + 0.010,
                     sw * 0.30, h * 0.050, MG_MAT_NSFLORA, g_NS_HALO, 1.0);
        } else {
            // LOD0: 14 boxes + pauldron + panel + spike
            // head (cocked: skewed and offset, ART_BIBLE 8.2.1)
            mg_box_ex(m, hw * 0.30, head_y, lean, hw, hw * 1.05, hw * 0.92,
                      hw * 0.26, hw * 0.10, 0.90, MG_MAT_HIDE, vhi, body, 1.0);
            // upper torso / lower torso / pelvis — a descending value ramp
            mg_box_ex(m, 0.0, sh_y - h * 0.04, lean * 0.8, sw, h * 0.08, sw * 0.70,
                      0.0, lean * 0.4, 0.94, MG_MAT_HIDE, vhi, body, 1.0);
            mg_box_ex(m, 0.0, torso_y - h * 0.03, lean * 0.5, sw * 0.86, h * 0.09, sw * 0.66,
                      0.0, lean * 0.4, 0.90, MG_MAT_HIDE, body, dark, 0.96);
            mg_box(m, 0.0, hip_y, 0.0, hip_hw, h * 0.06, hip_hw * 0.66,
                   MG_MAT_HIDE, body, dark, 0.90);
            // left arm (upper + lower), hanging — oversized on the Bulwark
            mg_box_ex(m, 0.0 - sw - larm_r * 0.8, sh_y - h * 0.10, lean * 0.5,
                      larm_r, h * 0.11, larm_r, 0.0 - larm_r * 0.6, larm_r, 0.90,
                      MG_MAT_HIDE, limb, dark, 0.94);
            mg_box_ex(m, 0.0 - sw - larm_r * 1.6, sh_y - h * 0.29, lean * 0.9,
                      larm_r * 0.86, h * 0.10, larm_r * 0.86, 0.0, larm_r * 1.6, 0.86,
                      MG_MAT_HIDE, limb, dark, 0.90);
            // right arm (upper + lower), raised — the asymmetric pose
            mg_box_ex(m, sw + arm_r * 0.8, sh_y - h * 0.06, lean * 0.5,
                      arm_r * 0.94, h * 0.11, arm_r * 0.94, arm_r * 0.8, 0.0 - arm_r, 0.90,
                      MG_MAT_HIDE, lhi, limb, 0.96);
            mg_box_ex(m, sw + arm_r * 2.0, sh_y - h * 0.20, 0.0 - lean * 1.2,
                      arm_r * 0.80, h * 0.10, arm_r * 0.80, arm_r * 0.4, 0.0 - arm_r * 2.0, 0.86,
                      MG_MAT_HIDE, limb, dark, 0.90);
            // legs
            mg_box(m, 0.0 - hip_hw * 0.56, leg_top * 0.74, 0.0,
                   leg_r, leg_top * 0.26, leg_r, MG_MAT_HIDE, vlo, dark, 0.88);
            mg_box_ex(m, 0.0 - hip_hw * 0.58, leg_top * 0.26, 0.02,
                      leg_r * 0.86, leg_top * 0.26, leg_r * 0.86, 0.0, 0.0 - leg_r * 0.5, 0.94,
                      MG_MAT_HIDE, vlo, dark, 0.84);
            mg_box(m, hip_hw * 0.56, leg_top * 0.74, 0.03,
                   leg_r, leg_top * 0.26, leg_r, MG_MAT_HIDE, vlo, dark, 0.88);
            mg_box_ex(m, hip_hw * 0.58, leg_top * 0.26, 0.05,
                      leg_r * 0.86, leg_top * 0.26, leg_r * 0.86, 0.0, leg_r * 0.6, 0.94,
                      MG_MAT_HIDE, vlo, dark, 0.84);
            // feet — the right one is planted forward, the left is dragged
            mg_box(m, 0.0 - hip_hw * 0.58, leg_r * 0.55, 0.0 - leg_r * 0.4,
                   leg_r * 0.92, leg_r * 0.55, leg_r * 1.7, MG_MAT_HIDE, dark, dark, 0.82);
            mg_box(m, hip_hw * 0.58, leg_r * 0.55, leg_r * 1.1,
                   leg_r * 0.92, leg_r * 0.55, leg_r * 1.9, MG_MAT_HIDE, dark, dark, 0.82);
            // ONE pauldron, left shoulder only (ART_BIBLE 8.2.1)
            mg_box_ex(m, 0.0 - sw - arm_r * 0.5, sh_y + h * 0.01, lean * 0.5,
                      sw * 0.42, h * 0.045, sw * 0.50, 0.0 - sw * 0.16, 0.0, 0.72,
                      MG_MAT_METAL, limb, dark, 1.0);
            // NS_MID accent panel on the chest (violet = hostile, CLAUDE.md 8)
            // The violet chest plate is the long-range hostile read, so it is
            // textured from the nightshade tile: over CELL_WOOD_LOG it came out
            // brown and the class read as "man in a brown coat" at 30 m.
            mg_panel(m, 0.0 - sw * 0.18, sh_y - h * 0.05, sw * 0.62 + 0.008,
                     sw * 0.26, h * 0.045, MG_MAT_NSFLORA, g_NS_HALO, 1.0);
        }
    }

    // --- the signature protrusion, always last so it can be measured -------
    // Scaled UP as the body gets smaller on screen, because the protrusion is
    // the class read and ART_BIBLE 8.2.3 sizes it in PIXELS, not metres. It is
    // 4 triangles at every tier, so this costs nothing. `mg_measure_class`
    // runs on LOD0 only, where the scale is exactly 1.0 — the 8.2.3 assertion
    // still describes the mesh the player stands next to.
    let pscale: f64 = 1.0;
    let pwide: f64 = 1.0;
    if (p_lod == 1) { pscale = 1.14; pwide = 1.35; }
    if (p_lod == 2) { pscale = 1.42; pwide = 1.90; }
    let plen: f64 = g_hu_prot[cls] * pscale;
    let ax: i32 = g_hu_axis[cls];
    let bxx: f64 = 0.0; let byy: f64 = 0.0; let bzz: f64 = 0.0;
    let txx: f64 = 0.0; let tyy: f64 = 0.0; let tzz: f64 = 0.0;
    if (ax == 2) {
        // backpack antenna / shoulder spine: up and back, off-centre
        bxx = 0.0 - sw * 0.55; byy = sh_y; bzz = 0.0 - sw * 0.45;
        txx = bxx - plen * 0.26; tyy = byy + plen * 0.92; tzz = bzz - plen * 0.24;
    } else {
        if (ax == 0) {
            // side spout, right side, angled forward and up
            bxx = sw * 0.75; byy = sh_y - h * 0.02; bzz = 0.0;
            txx = bxx + plen * 0.86; tyy = byy + plen * 0.34; tzz = bzz + plen * 0.36;
        } else {
            if (ax == 1) {
                // oversized left arm terminating in a spike
                bxx = 0.0 - sw * 1.05; byy = sh_y - h * 0.16; bzz = 0.0;
                txx = bxx - plen * 0.80; tyy = byy - plen * 0.50; tzz = bzz + plen * 0.30;
            } else {
                // forward shoulder ram: the Warden's whole design is "stop
                // shooting the front, go around", so its signature reaches
                // FORWARD off one shoulder rather than up off its back.
                bxx = 0.0 - sw * 0.42; byy = sh_y + h * 0.01; bzz = sw * 0.55;
                txx = bxx - plen * 0.22; tyy = byy + plen * 0.24; tzz = bzz + plen * 0.94;
            }
        }
    }
    let w: f64 = sw * 0.28;
    if (w > 0.12) { w = 0.12; }
    w = w * pwide;
    mg_spike(m, bxx, byy, bzz, txx, tyy, tzz, w,
             MG_MAT_METAL, hu_limb_col(cls), mg_scale(hu_limb_col(cls), 0.72), 1.0);
}

// Wisp — a floating shard cluster, no humanoid form at all. 24 / 12 / 6 tris.
//
// Wisp and Mote are the two classes whose ALBEDO is violet rather than merely
// accented with it, so both are textured MG_MAT_NSFLORA (CELL_NS_FLORA) rather
// than MG_MAT_HIDE (CELL_WOOD_LOG, 135,99,59). Vertex colour multiplies the
// texel, so NS_CORE over a warm brown log tile is brown; over the nightshade
// tile it is violet. This is the same defect the flora had and it is the same
// fix. CLAUDE.md §8 sanctions it: both classes are hostile.
fn build_wisp(p_m, p_lod: i32) {
    let m = p_m;
    let core: i32 = g_NIGHTSHADE_FLORA;
    let hot: i32 = g_NS_CORE;
    if (p_lod == 2) {
        mg_fan_disc(m, 0.0, 0.42, 0.0, 0.17, 3, 0.4, MG_MAT_NSFLORA, hot, core, 1.0, 1.0);
        mg_fan_disc(m, 0.0, 0.38, 0.0, 0.16, 3, 0.4, MG_MAT_NSFLORA, core, core, 0.9, -1.0);
        return;
    }
    if (p_lod == 1) {
        mg_set_jitter(0.18, 71);
        mg_taper(m, 0.0, 0.30, 0.0, 0.03, 0.52, 0.0, 0.17, 0.10, 3,
                 MG_MAT_NSFLORA, hot, core, 1.0);                      // 6
        mg_set_jitter(0.0, 0);
        mg_spike(m, 0.0, 0.40, 0.06, 0.0, 0.30, 0.62, 0.07,
                 MG_MAT_NSFLORA, hot, core, 0.94);                     // 4
        mg_panel(m, 0.06, 0.44, 0.14, 0.06, 0.05, MG_MAT_NSFLORA, hot, 1.0);  // 2
        return;
    }
    // LOD0: 24
    mg_set_jitter(0.22, 73);
    mg_taper(m, 0.0, 0.24, 0.0, 0.04, 0.56, 0.02, 0.18, 0.09, 4,
             MG_MAT_NSFLORA, hot, core, 1.0);                          // 8
    mg_set_jitter(0.0, 0);
    mg_fan_disc(m, 0.04, 0.56, 0.02, 0.09, 4, 0.3, MG_MAT_NSFLORA, hot, core, 1.0, 1.0);  // 4
    // one big shard on the left, one small on the right — asymmetry
    mg_spike(m, -0.10, 0.44, 0.0, -0.46, 0.60, -0.10, 0.06,
             MG_MAT_NSFLORA, hot, core, 0.96);                         // 4
    mg_spike(m, 0.11, 0.34, 0.0, 0.30, 0.24, 0.06, 0.045,
             MG_MAT_NSFLORA, hot, core, 0.96);                         // 4
    // trailing tail spike, -Z, 0.55 m — the signature protrusion
    mg_spike(m, 0.0, 0.36, -0.10, 0.0, 0.30, -0.62, 0.05,
             MG_MAT_NSFLORA, hot, core, 0.94);                         // 4
}

// Mote — a slow bulb with a hanging tendril. 32 / 16 / 8 tris.
fn build_mote(p_m, p_lod: i32) {
    let m = p_m;
    let body: i32 = g_ICHOR;
    let skin: i32 = g_NS_MID;
    if (p_lod == 2) {
        mg_taper(m, 0.0, 0.30, 0.0, 0.0, 0.62, 0.0, 0.21, 0.10, 3,
                 MG_MAT_NSFLORA, body, skin, 1.0);                      // 6
        // the tendril survives as a 2-tri card at 9 px; a tetrahedron would
        // cost 4 and blow the 8-triangle budget
        mg_panel(m, 0.07, 0.06, 0.03, 0.035, 0.26, MG_MAT_NSFLORA, skin, 0.9);  // 2
        return;
    }
    if (p_lod == 1) {
        mg_set_jitter(0.12, 83);
        mg_taper(m, 0.0, 0.24, 0.0, 0.02, 0.64, 0.0, 0.21, 0.09, 4,
                 MG_MAT_NSFLORA, body, skin, 1.0);                      // 8
        mg_set_jitter(0.0, 0);
        mg_fan_disc(m, 0.02, 0.64, 0.0, 0.09, 4, 0.0, MG_MAT_NSFLORA, skin, body, 1.0, 1.0); // 4
        mg_spike(m, 0.06, 0.26, 0.02, 0.10, 0.0 - 0.32, 0.05, 0.05,
                 MG_MAT_NSFLORA, skin, body, 0.9);                      // 4
        return;
    }
    // LOD0: 32
    mg_set_jitter(0.14, 87);
    mg_taper(m, 0.0, 0.20, 0.0, 0.03, 0.50, 0.0, 0.21, 0.17, 6,
             MG_MAT_NSFLORA, body, skin, 1.0);                          // 12
    mg_taper(m, 0.03, 0.50, 0.0, 0.05, 0.74, 0.02, 0.17, 0.06, 6,
             MG_MAT_NSFLORA, skin, body, 1.0);                          // 12
    mg_set_jitter(0.0, 0);
    mg_fan_disc(m, 0.05, 0.74, 0.02, 0.06, 4, 0.0, MG_MAT_NSFLORA, skin, body, 1.0, 1.0); // 4
    // hanging tendril, -Y, 0.60 m — the signature protrusion
    mg_spike(m, 0.07, 0.22, 0.03, 0.13, 0.0 - 0.38, 0.07, 0.05,
             MG_MAT_NSFLORA, skin, body, 0.88);                         // 4
}

// ===========================================================================
// THE VILLAGER — three LODs. 218 / 42 / 12 triangles.
// ===========================================================================
// Warm palette, NO violet: violet means hostile (CLAUDE.md §8).
//
// ---------------------------------------------------------------------------
// THE HAT IS THE ASSET. Everything else is detail.
// ---------------------------------------------------------------------------
// The brief is not "make the villager cheap", it is "make the villager cheap
// AND never mistakable for a Husk at 20 m". Those pull in opposite directions
// everywhere except one place: a feature no enemy has, held at a size that
// survives the pixel grid. That feature is the brimmed hat, and MEASURED, the
// old one did not survive anything:
//
//     old brim  hw * 1.85 = 0.426 m wide     villager shoulders 0.460 m wide
//
// The hat was NARROWER THAN THE SHOULDERS. It contributed zero pixels to the
// outline at any distance, which is why the villager measured IoU 0.737
// against a Husk at 20 m — the two really were the same bar. The brim is now
//
//     new brim  hw * 2.45 = 0.564 m wide     22 % wider than the shoulders
//
// which at 20 m is 5.2 px against a 4 px body: a T, and no enemy in the game
// is a T. It is the ONE shape carried identically through all three tiers, so
// the villager's class read does not change when the tier does.
//
// The second rule is negative: NOTHING ABOVE THE HAT, EVER. The Husk's
// signature is a 0.94 m antenna reaching above its shoulders and the Warden's
// is a forward ram; "silhouette continues above the head" is the game's
// hostile grammar and the villager must never speak it. The held tool is
// therefore capped below the chin and hangs to the side, where it reads as
// "carrying something" instead of "armed".
//
// ---------------------------------------------------------------------------
// WHAT EACH TIER SPENDS ITS TRIANGLES ON
// ---------------------------------------------------------------------------
//   LOD0  218   < 9 m, 37 px+. Conversation. Eighteen parts: separate arms and
//               hands, boots, satchel, scarf, hat crown AND brim, held tool.
//               This is the only band where any of that is over a pixel.
//   LOD1   42   9..26 m, 37..13 px. Legs column 8 + coat 12 + head 6 + hat 12
//               + tool 4. The coat FLARES (A-shaped) where every enemy torso
//               is a straight slab over a leg gap (I-shaped) — the second
//               class cue after the brim, and it costs nothing because
//               mg_box_ex takes a taper anyway.
//   LOD2   12   > 26 m, < 13 px. Two 3-sided tubes: the body and the brim.
//               NOT a billboard — a card has a yaw at which it is a line, and
//               a villager that disappears when they turn round is worse than
//               one that costs 6 more triangles. A 3-gon tube always presents
//               a face, fogs correctly and needs no camera-facing pass.
// ---------------------------------------------------------------------------
let g_npc_h: f64 = 1.75;
let g_npc_hw: f64 = 0.115;
let g_npc_sw: f64 = 0.230;      // head:shoulder 2.00, distinct from every enemy
let g_npc_brim: f64 = 2.45;     // brim half-width, as a multiple of hw

fn build_npc(p_m, p_lod: i32) {
    let m = p_m;
    let h: f64 = g_npc_h;
    let hw: f64 = g_npc_hw;
    let sw: f64 = g_npc_sw;
    let cloth: i32 = g_FABRIC_CREAM;
    let coat: i32 = g_PAINT_TEAL;
    let skin: i32 = g_SAND;
    let dark: i32 = mg_scale(coat, 0.74);
    let hatc: i32 = g_PAINT_OCHRE;
    let hatlo: i32 = mg_scale(g_PAINT_OCHRE, 0.70);
    let brim_hw: f64 = hw * g_npc_brim;

    let leg_top: f64 = h * 0.46;
    let hip_y: f64 = leg_top + h * 0.05;
    let sh_y: f64 = h * 0.80;
    let head_y: f64 = h - hw * 1.15;
    let arm_r: f64 = sw * 0.26;
    let leg_r: f64 = sw * 0.30;
    let hip_hw: f64 = sw * 0.74;
    let brim_y: f64 = head_y + hw * 0.92;
    // ⚠ A BRIM IS A HORIZONTALLY THIN FEATURE AND THIN FEATURES DIE FIRST.
    // LOD0's brim is a 3.7 cm slab, which is fine at 37 px and useless at 13:
    // 3.7 cm is 0.27 px at 26 m, so it misses every pixel centre and the hat —
    // the entire villager read — silently stops existing. MEASURED with a
    // 4.6 cm brim tube at LOD2: the whole mesh rasterized to an EMPTY 55 m
    // mask at yaw 0, and to 3 px of height where the Husk beside it had 9.
    //
    // So at LOD1 and LOD2 the hat is not a disc on a head, it is a CONE with
    // 18 cm of vertical extent flaring to the same brim width. 18 cm is 1.3 px
    // at 26 m and still 0.6 px at 64 m, and unlike a disc it is solid all the
    // way down, so the hat contributes width at every distance and every yaw.
    // It also happens to be what a straw sun-hat looks like.
    // The cone's BRIM LINE is pinned to LOD0's brim (`brim_y`, minus half the
    // slab's own thickness) so the hat sits at the same height on the head in
    // all three tiers. Dropping it lower made the coarse tiers read as a
    // mushroom: the hat swallowed the head and the villager lost its neck.
    let hat_y0: f64 = brim_y - hw * 0.45;
    let hat_y1: f64 = hat_y0 + hw * 1.45;

    if (p_lod == 2) {
        // -------------------------------------------------------------------
        // LOD2 — 12 triangles, beyond 26 m. Two 3-sided tubes.
        // -------------------------------------------------------------------
        // The body is ONE tapered tube from the ground to the chin, flared at
        // the hem: an A, where every humanoid enemy at its own LOD2 is a slab
        // over a leg gap. The brim is a second tube, 4.6 cm tall and 1.10x the
        // authored half-width, because a 3-gon seen across a FLAT is only 75 %
        // as wide as one seen across a corner and the hat has to beat the
        // shoulders at every yaw, not on average.
        //
        // ⚠ THE HEM RADIUS IS A DISAPPEARANCE FLOOR, NOT A TASTE CALL. At
        // `sw * 0.72` the coat measured 0.32 m across its flats, which is
        // 0.95 px at 55 m — and MEASURED, the villager rasterized to a
        // COMPLETELY EMPTY MASK at yaw 0 and 55 m, because a run of quads
        // under one pixel wide can miss every pixel centre. A body that blinks
        // out as the player strafes is a worse bug than any triangle count.
        // `sw * 0.96` puts the narrowest cross-section at 1.28 px at 55 m and
        // 1.10 px at the 64 m fog wall, and it also matches LOD1's 0.45 m coat
        // hem so the tier switch does not change the villager's width.
        mg_set_jitter(0.09, 41);
        mg_taper(m, 0.006, 0.0, 0.0,
                 0.0 - hw * 0.22, hat_y0 + hw * 0.30, 0.02,
                 sw * 0.80, sw * 0.58, 3,
                 MG_MAT_CLOTH, coat, dark, 0.94);                      // 6
        mg_set_jitter(0.15, 29);
        mg_taper(m, 0.0 - hw * 0.24, hat_y0, 0.02,
                 0.0 - hw * 0.20, hat_y1, 0.028,
                 brim_hw * 1.15, brim_hw * 0.34, 3,
                 MG_MAT_CLOTH, hatc, hatlo, 1.0);                      // 6
        mg_set_jitter(0.0, 0);
        return;
    }

    if (p_lod == 1) {
        // -------------------------------------------------------------------
        // LOD1 — 42 triangles, 9..26 m. DIRECTION.md §6's "roughly 40".
        // -------------------------------------------------------------------
        // legs and boots as one lightly tapered column (8)
        mg_set_jitter(0.06, 53);
        mg_taper(m, 0.0, 0.0, 0.01, 0.012, hip_y + h * 0.01, 0.0,
                 hip_hw * 0.85, hip_hw * 0.80, 4,
                 MG_MAT_CLOTH, cloth, mg_scale(cloth, 0.72), 0.88);
        mg_set_jitter(0.0, 0);
        // the coat: hem WIDER than the shoulders (12). An enemy torso is a
        // straight slab with daylight under it; a villager is a triangle.
        mg_box_ex(m, 0.0, (leg_top - h * 0.02 + sh_y + h * 0.055) * 0.5, 0.0,
                  sw * 0.98, (sh_y + h * 0.055 - leg_top + h * 0.02) * 0.5,
                  sw * 0.60, 0.0, 0.0, 0.88,
                  MG_MAT_CLOTH, coat, dark, 0.96);
        // head and neck, three-sided and cocked — the face between the coat
        // collar and the hat brim (6)
        mg_taper(m, 0.0 - hw * 0.16, head_y - hw * 1.15, 0.02,
                 0.0 - hw * 0.24, hat_y0 + hw * 0.35, 0.03,
                 hw * 1.02, hw * 0.85, 3,
                 MG_MAT_CLOTH, skin, mg_scale(skin, 0.76), 0.98);
        // THE HAT (12) — brim and crown in one truncated pyramid. `p_ts` 0.34
        // does the crown for free; two separate boxes would cost 24 and read
        // identically at 13..37 px.
        mg_box_ex(m, 0.0 - hw * 0.24, (hat_y0 + hat_y1) * 0.5, 0.02,
                  brim_hw, (hat_y1 - hat_y0) * 0.5, brim_hw * 0.94,
                  hw * 0.14, 0.0, 0.34, MG_MAT_CLOTH, hatc, hatlo, 1.0);
        // the held tool (4) — asymmetry, and it stops BELOW THE CHIN
        mg_spike(m, sw + arm_r * 1.5, sh_y - h * 0.26, 0.0 - arm_r * 2.2,
                 sw + arm_r * 1.6, sh_y - h * 0.04, 0.0 - arm_r * 6.4, 0.050,
                 MG_MAT_WOOD, g_WOOD_HI, g_WOOD_LO, 0.96);
        return;
    }

    // -----------------------------------------------------------------------
    // LOD0 — 220 triangles, inside 9 m.
    // -----------------------------------------------------------------------
    // head + torso stack (turned head: the "someone is looking at you" cue)
    mg_box_ex(m, 0.0 - hw * 0.24, head_y, 0.02, hw, hw * 1.15, hw * 0.92,
              0.0 - hw * 0.20, hw * 0.16, 0.94, MG_MAT_CLOTH, skin, mg_scale(skin, 0.76), 1.0);
    mg_box_ex(m, 0.0, sh_y - h * 0.04, 0.0, sw, h * 0.08, sw * 0.58,
              0.0, 0.0, 0.96, MG_MAT_CLOTH, coat, dark, 1.0);
    mg_box_ex(m, 0.0, h * 0.66, 0.0, sw * 0.90, h * 0.10, sw * 0.55,
              0.0, 0.0, 0.94, MG_MAT_CLOTH, coat, dark, 0.96);
    mg_box(m, 0.0, hip_y, 0.0, hip_hw, h * 0.06, hip_hw * 0.68,
           MG_MAT_CLOTH, cloth, mg_scale(cloth, 0.78), 0.92);
    // arms
    mg_box_ex(m, 0.0 - sw - arm_r * 0.8, sh_y - h * 0.10, 0.0,
              arm_r, h * 0.11, arm_r, 0.0 - arm_r * 0.4, 0.0, 0.92,
              MG_MAT_CLOTH, coat, dark, 0.94);
    mg_box_ex(m, 0.0 - sw - arm_r * 1.3, sh_y - h * 0.28, arm_r * 1.2,
              arm_r * 0.88, h * 0.10, arm_r * 0.88, 0.0, arm_r * 1.8, 0.90,
              MG_MAT_CLOTH, skin, mg_scale(skin, 0.76), 0.90);
    mg_box_ex(m, sw + arm_r * 0.8, sh_y - h * 0.09, 0.0,
              arm_r, h * 0.11, arm_r, arm_r * 0.4, 0.0, 0.92,
              MG_MAT_CLOTH, coat, dark, 0.94);
    mg_box_ex(m, sw + arm_r * 1.5, sh_y - h * 0.26, 0.0 - arm_r * 1.5,
              arm_r * 0.88, h * 0.10, arm_r * 0.88, 0.0, 0.0 - arm_r * 1.6, 0.90,
              MG_MAT_CLOTH, skin, mg_scale(skin, 0.76), 0.90);
    // legs + boots
    mg_box(m, 0.0 - hip_hw * 0.56, leg_top * 0.72, 0.0,
           leg_r, leg_top * 0.28, leg_r, MG_MAT_CLOTH, cloth, mg_scale(cloth, 0.78), 0.90);
    mg_box(m, 0.0 - hip_hw * 0.56, leg_top * 0.26, 0.0,
           leg_r * 0.9, leg_top * 0.26, leg_r * 0.9, MG_MAT_CLOTH, cloth, mg_scale(cloth, 0.72), 0.86);
    mg_box(m, hip_hw * 0.56, leg_top * 0.72, 0.02,
           leg_r, leg_top * 0.28, leg_r, MG_MAT_CLOTH, cloth, mg_scale(cloth, 0.78), 0.90);
    mg_box(m, hip_hw * 0.56, leg_top * 0.26, 0.04,
           leg_r * 0.9, leg_top * 0.26, leg_r * 0.9, MG_MAT_CLOTH, cloth, mg_scale(cloth, 0.72), 0.86);
    mg_box(m, 0.0 - hip_hw * 0.56, leg_r * 0.5, 0.0 - leg_r * 0.5,
           leg_r * 0.94, leg_r * 0.5, leg_r * 1.8, MG_MAT_CLOTH, g_WOOD_LO, g_WOOD_LO, 0.82);
    mg_box(m, hip_hw * 0.56, leg_r * 0.5, leg_r * 0.6,
           leg_r * 0.94, leg_r * 0.5, leg_r * 1.8, MG_MAT_CLOTH, g_WOOD_LO, g_WOOD_LO, 0.82);
    // charm: brimmed hat (2 boxes), a satchel on ONE hip, a scarf.
    // The BRIM is hw * 2.45 wide, not the hw * 1.85 it was: at 1.85 it was
    // narrower than the villager's own shoulders and contributed nothing to the
    // outline at any range. It is the asset's class read and it is now carried
    // at the same proportion by all three tiers, so the hat does not change
    // size when the tier does.
    mg_box_ex(m, 0.0 - hw * 0.24, head_y + hw * 1.30, 0.02, hw * 1.05, hw * 0.42, hw * 1.05,
              0.0, 0.0, 0.86, MG_MAT_CLOTH, g_PAINT_OCHRE, mg_scale(g_PAINT_OCHRE, 0.72), 1.0);
    mg_box(m, 0.0 - hw * 0.24, brim_y, 0.02, brim_hw, hw * 0.16, brim_hw * 0.94,
           MG_MAT_CLOTH, g_PAINT_OCHRE, mg_scale(g_PAINT_OCHRE, 0.68), 1.0);
    mg_box_ex(m, sw * 1.10, hip_y - h * 0.04, 0.0 - sw * 0.30,
              sw * 0.34, h * 0.070, sw * 0.22, 0.0, 0.0, 0.92,
              MG_MAT_CLOTH, g_WOOD_MID, g_WOOD_LO, 0.94);
    mg_box_ex(m, 0.0, sh_y + h * 0.028, 0.0, sw * 0.62, h * 0.022, sw * 0.52,
              0.0 - sw * 0.30, 0.0, 0.90, MG_MAT_CLOTH, g_FABRIC_RED,
              mg_scale(g_FABRIC_RED, 0.74), 1.0);
    // a tool held in the right hand — the NPC's asymmetric read
    mg_spike(m, sw + arm_r * 1.5, sh_y - h * 0.26, 0.0 - arm_r * 2.2,
             sw + arm_r * 1.5, sh_y - h * 0.02, 0.0 - arm_r * 5.6, 0.045,
             MG_MAT_WOOD, g_WOOD_HI, g_WOOD_LO, 0.96);
}

// ===========================================================================
// VIEWMODEL WEAPONS — ART_BIBLE 8.5
// ===========================================================================
// Local space: origin at the grip, +Z is the muzzle direction, +Y up, +X right.
//
// Each weapon is a flat part table, 8 numbers per part:
//     cx, cy, cz, hx, hy, hz, colour-slot(0..3), ao
// plus a per-weapon 4-colour ramp. 12 tris per part. The table form is what
// makes six weapons tunable without six hundred lines of call sites, and it is
// what lets `--verify` prove the six 32x32 silhouettes differ.
//
// ---------------------------------------------------------------------------
// VALUE LAW (8.5, revised after the art-direction gate)
// ---------------------------------------------------------------------------
// The gate measured the viewmodel as "an indistinct pale mass". The cause was
// not the silhouette table: it was that all four colour slots (GUNMETAL_HI 128,
// GUNMETAL_LO 80, POLYMER 95, STEEL_HI 199) landed inside a ~50-value band once
// the world's ambient/sun split — which sums to (1,1,1) by construction, so no
// face can be more than ~2x brighter than any other — had been applied and the
// luminance floor had compressed everything under 96 into [72, 96].
//
// The fix is a four-slot ramp with a DELIBERATELY WIDE spread, lit by a
// dedicated high-contrast key (see g_mg_vm_* below). The slots are now:
//
//   0  BODY   the receiver / tube: the mid value the eye averages the gun to
//   1  DARK   barrel, sights, ports, butt plate, trigger group. These are the
//             SHADOW SHAPES that cut notches out of the silhouette, and they
//             are what make the gun legible against a BRIGHT background.
//   2  FURN   grip, stock, handguard, magazine — polymer or wood, mid-low,
//             and a different HUE from the metal so the two blocks separate.
//   3  SPEC   the highlight band: top rail, cheek line, mag baseplate, bolt.
//             Pushed 12 % above STEEL_HI so it CLIPS to 255 under the key and
//             renders at the atlas ceiling. This is what makes the gun legible
//             against a DARK background.
//
// Every weapon therefore carries both its own darkest and its own brightest
// value, which is what "separates from ANY background" actually requires.
//
// ---------------------------------------------------------------------------
// ROUND-2 REVISION — the ramp was wide, the RENDER was not
// ---------------------------------------------------------------------------
// The round-1 ramp above is honest and it still did not work. Measured over the
// weapon's own pixels in ridge_golden it produced p5 26 / p95 117 / MAX 148 —
// on a 0..255 scale the gun never got bright and its four slots collapsed
// because of two things this revision fixes.
//
//   * EVERY part was textured CELL_METAL_PANEL, whose brightest texel is 187
//     and whose mean is 153. The pixel is vertex x texel, so 153/255 = 0.60 was
//     a flat 40 % haircut on the whole model and the ceiling was 187 no matter
//     what the vertex colour did. Slot 3 is now textured MG_MAT_SPEC
//     (CELL_SNOW: mean 191, max 242) — the only cell in ATLAS_WORLD that can
//     clear luminance 220, which is what CLAUDE.md §8 demands of every frame
//     and what the gate found missing in four of eight.
//   * `mg_lift_floor` compressed everything under luminance 96 into [72, 96],
//     which is right for a 30 m enemy and catastrophic for the object filling
//     a fifth of the screen. Weapons now use a floor of 26 (see
//     MG_VM_LUM_FLOOR), so the barrel, the ejection port and the butt plate are
//     allowed to be genuinely dark and cut real notches out of the silhouette.
//
// The slot spread is widened to match: furniture drops to 0.70 of its palette
// value (the gate asked for ~35 % off the stock relative to the barrel; the
// barrel here is slot 1 and is already the darkest thing on the gun, so the
// separation is bought at the FURNITURE end instead — same value break, right
// way round), and the specular slot is pushed to 1.24 so a face turned into
// the key clips the vertex byte and renders at the tile's own ceiling.
// ---------------------------------------------------------------------------
// ROUND-3 REVISION — the ramp was wide, and the gun was BLACK
// ---------------------------------------------------------------------------
// Round 2 fixed "pale grey mass" by dropping the viewmodel's luminance floor
// from 72 to 26 and letting the dark slots be genuinely dark. Measured over the
// weapon's own pixels (mask: the pixels that do not change when only the camera
// YAW changes, largest connected component) that produced:
//
//     budget_worst  931 px   median luminance 25   64 % of the weapon < 30
//     ridge_golden 1938 px   median luminance 26   56 % of the weapon < 30
//     saturation median 0.54 / 0.35, mean hue 221 (blue) / 341 (pink)
//
// That is not a legible gun, it is a black hole with four white chips in it,
// and since the viewmodel covers ~2 % of the frame it was also feeding the
// project's own "too much of the frame is below luminance 30" finding.
//
// Three things were wrong and all three are fixed here.
//
// 1. THE SLOTS WERE HUES, NOT VALUES. `mg_scale` multiplies a palette constant,
//    so the slot's luminance AND its chroma came from whatever the caller
//    passed. GUNMETAL_HI is cool (122,128,136), CELL_METAL_PANEL is cool, the
//    ambient is cool: everything stacked the same way and the gun went blue.
//    Slots are now built by `mg_norm_col`, which sets an EXACT luminance and
//    CLAMPS saturation. Metal is capped at 0.10, furniture at 0.26 (furniture
//    is wood/polymer and is allowed to be the one warm block on the model,
//    because a value break alone does not separate a stock from a receiver).
//
// 2. THE SIDE SPLIT WAS RANDOM. `mg_side_col` picks hi-vs-lo from the WORLD
//    sun's azimuth, and the weapon is built in its own space, so which local
//    face got the high albedo depended on where the sun happened to be — an
//    accident that changed per scene. See g_wp_side_* below.
//
// 3. THE FLOOR WAS DOING THE WORK. With every slot landing under luminance 40,
//    `mg_lift_floor` was flattening most of the model into the 26..40 band.
//    With the ladder below almost nothing reaches the floor and the floor is
//    back to being a safety net instead of a look.
//
// The ladder, as ALBEDO luminance. The rendered pixel is albedo x light x
// texel, and all three terms were measured rather than guessed. Dumping the
// baked vertex buffer per part (tools: a probe that groups arena vertices by
// face) gives the light x AO multiplier on the only three faces the camera can
// see — top 1.54, flank 1.12, rear 0.93 — and CELL_METAL_PANEL's texels run
// 67..188 with a mean of 151, i.e. x0.59. So this ladder maps to roughly
//
//     DARK  25 / 30 / 44        (and 12 on the tile's darkest texels)
//     FURN  65 / 78 / 107       warm, the one non-metal block
//     BODY  83 /100 /138        the value the eye averages the gun to
//     SPEC  clips -> the tile   201 mean, 243 ceiling
//
// which is a genuine four-step ramp carrying BOTH halves of CLAUDE.md §8's
// contrast pair on the one object that is in every frame.
// ---------------------------------------------------------------------------
// ROUND-4 REVISION — the ladder above was never wrong, it was never ARRIVING.
// ---------------------------------------------------------------------------
// Round 3 authored DARK 46 / FURN 118 / BODY 152 / SPEC 232 and the gate then
// measured the weapon at median luminance 31 with 43-47 % of its own pixels
// under 30. Both statements were true at once, and here is the whole chain,
// measured rather than argued:
//
//  a) The BAKED VERTEX COLOURS ARE FINE and they are already scene-invariant.
//     Median baked vertex luminance over the Sparrow, by scene keyframe:
//        ridge_golden 74.2   hub_dawn 73.7   ns_bloom 73.8
//        storm 74.1          noon     78.7
//     The dedicated viewmodel rig and its exposure floor work: the weapon does
//     NOT go black at dusk with the world. Weighted by projected area over the
//     faces the camera can see, the baked luminance is 165, and only 4 % of
//     that area is under 45. So "the viewmodel is being lit by the world's
//     ambient/sun term" — the standing hypothesis for this bug — is FALSE.
//     MG_KIND_WEAPON is set and `meshgen_bake_all` takes the weapon branch.
//
//  b) THE TEXEL WAS EATING IT. See MG_MAT_VMSKIN. Calibrated by rebuilding the
//     weapon with a white albedo and a unit rig, so the rendered pixel IS the
//     texel: over the weapon's own mask the multiplier measured p5 0.235,
//     median 0.53. That, not the rig, is the missing 3x.
//
//  c) THE DARK SLOT HAD TAKEN OVER THE MODEL. Rebuilt with one flat hue per
//     slot and counted on the real render, the Sparrow's screen area was
//        BODY 19.6 %   DARK 29.9 %   FURN 27.5 %   SPEC 23.0 %
//     A slot whose job is to CUT NOTCHES was 30 % of the object, and its single
//     largest member was the BUTT PLATE — the nearest, biggest, most-looked-at
//     element on the model — rendering at luminance 11-25. That black mass at
//     the lower right of every frame is what round 2 filed as "a detached
//     floating parallelogram": it is not detached, it is the same value as the
//     vignetted grass behind it, so its silhouette dissolves.
//
// With MG_MAT_VMSKIN's flat x0.72 in place the chain is finally predictable.
// Measured light x AO on the three visible faces is 1.15 (flank), 1.14 (rear)
// and 1.60+ (top, which clips), and `mg_side_col` puts the flank at t = 0.97
// and the rear at t = 0.67 of the way from lo to hi, so:
//
//     rendered_flank ~ albedo x 0.80     rendered_rear ~ albedo x 0.67
//     rendered_top   ~ min(albedo x 1.6, 255) x 0.72
//
// The ladder below therefore lands on screen as roughly
//
//     DARK   27 /  32 /  46      the notches: sights, ports, gas block, guard
//     FURN   75 /  90 / 129      polymer and wood: grip, stock, handguard, mag
//     BODY  112 / 135 / 184      receiver, barrel, magwell, butt plate
//     SPEC  240 .. 243           the rail, flat, on every face it turns
//
// which is a four-step ramp with real gaps between the steps, and it still
// carries both halves of CLAUDE.md §8's contrast pair on the one object that
// is in every frame.
// ROUND-4, SECOND PASS. The values above were set against light multipliers
// measured on the CULLED hemisphere, and once the key was turned around every
// one of them was 40 % too hot: the weapon rendered at median 135 with 23 % of
// its own pixels over luminance 220, i.e. a white plastic prop. Re-measured on
// the faces that are actually drawn, `light x AO` is
//
//     -Y  1.51-1.75   +Z  1.09-1.27   -X  1.09-1.27
//
// and `mg_side_col` puts +Z at t = 0.852 and -X at t = 0.987 of hi. Folding in
// MG_MAT_VMSKIN's flat x0.72, the ladder below lands on screen at
//
//     DARK   24 /  27 /  40      the notches; supplies the sub-30 half of §8
//     FURN   59 /  68 / 103      polymer and wood
//     BODY   95 / 110 / 143      receiver, barrel, magwell, butt plate
//     SPEC  224 .. 243           the rail, and only the rail
//
// in the order (+Z trailing facet / -X flank / -Y plate).
//
// ---------------------------------------------------------------------------
// ROUND 5 — THE LADDER WAS CORRECT AT THE BOTTOM AND UNCAPPED AT THE TOP
// ---------------------------------------------------------------------------
// Round 4 fixed the black lump and then overshot: with SPEC 236 lit at a 1.25
// AO gain, every rail facet clipped its vertex byte and rendered as the flat
// MG_MAT_VMRAIL texel — 240..243 — which made the WEAPON the brightest object
// in every frame including a midnight one, and in ridge_golden / hub_dawn /
// ns_bloom the rail was the only >220 region in the image. Those three scenes
// were passing CLAUDE.md §8's contrast rule off a painted stripe on the gun.
//
// The ceiling is not a taste call, it is measured. Excluding the viewmodel and
// the HUD, the brightest WORLD pixel per scene is
//
//     ns_bloom 188   hub_dawn(p99.9) 177   ridge_golden 239   muzzle_fog 245
//     storm_assault 251   hud_worst_case 255   budget_worst 255
//
// so ns_bloom's 188 is the binding constraint: any viewmodel pixel above ~185
// makes the gun the brightest thing in at least one frame. The rendered value
// of a slot is `albedo x light x AO x texel`, and the two multipliers were
// re-measured on the drawn facets at the exposure floor (expo 1.78):
//
//     BODY (MG_MAT_VMSKIN, texel x0.72)   -Y plate = albedo x 1.174
//     SPEC (MG_MAT_VMRAIL, texel x0.94)   -Y plate = albedo x 1.62
//
// (both from a two-point fit: body 158 -> 185 measured, spec 112 -> 186 and
// spec 98 -> 162 measured, in ridge_golden.) Solving those against the 185
// ceiling gives SPEC 112 and BODY 140, which is what is below. The noon scenes
// run 6.7 % hotter (expo 1.90, see g_mg_vm_expo_*), so the worst case in the
// whole set is the rail at 198 in budget_worst — under 220 with margin, and
// under that frame's own 255.
//
// FURN went 62 -> 76 in the same pass. It is the mid-tone mass (grip, stock,
// handguard, magazine) and dropping the top of the ladder without lifting the
// middle would have moved the median the wrong way; 76 holds the rendered
// median at 105-135 across the seven scenes while the peak comes down by 60.
// DARK stays at 26: it is the sub-30 half of §8's contrast pair and 3-7 % of
// the weapon's pixels are still below 30 after this change.
//
// Rendered, measured on the real frames at native 320x240 (HUD masked, the
// weapon isolated by differencing against a build with the viewmodel deleted):
//
//     slot        round 4          round 5
//     DARK        24 /  27 /  40   24 /  27 /  40    unchanged
//     FURN        59 /  68 / 103   72 /  83 / 126
//     BODY        95 / 110 / 143   89 / 103 / 164
//     SPEC       224 .. 243        116 .. 186        the rail, and only the rail
let g_vm_lum_body: f64 = 140.0;
let g_vm_lum_dark: f64 = 26.0;
let g_vm_lum_furn: f64 = 76.0;
let g_vm_lum_spec: f64 = 112.0;
let g_vm_sat_metal: f64 = 0.10;
let g_vm_sat_furn: f64 = 0.26;
// hi -> lo within a slot. `lo` only ever reaches the screen through the -Z rear
// faces (t = 0.67 of the way to hi), so it is the rear-facet step, not a
// shadow: at 0.55 the rear of a body part renders ~0.85 of its flank.
let g_vm_lo_step: f64 = 0.55;

// ---------------------------------------------------------------------------
// THE WEAPON'S OWN SIDE SPLIT
// ---------------------------------------------------------------------------
// `mg_side_col` gives a box's four vertical faces an albedo interpolated by how
// far each faces the SUN'S AZIMUTH. That is right for a tree. For a viewmodel it
// is nonsense: the parts are authored in weapon space, so "the sun's azimuth"
// lands on an arbitrary local axis and changes per scene. It is measurably why
// the specular band failed §8 in ns_bloom — the rail's visible flank happened to
// get `spec_lo` there, rendered 208.8 instead of clipping, and the frame had no
// pixel over 220 at all.
//
// Dumping the cant matrix A = Ry(21) Rx(6) Rz(26) and mapping the camera and key
// directions back through A^T into the PRE-cant space the tables are written in:
//
//     camera  ( 0.324, 0.581, -0.747)   key  ( 0.361, 0.857, -0.368)
//
// so the three faces the player can ever see are +X (the flank), +Y (the top)
// and -Z (the rear); +Z, -X and -Y are backfacing and never rasterised. The
// azimuth below is chosen so that the flank is essentially `hi` (t = 0.97) and
// the rear is a clear step below it (t = 0.67), which gives every box a lit
// flank and a darker trailing facet instead of the coin-flip it had before.
//
// ROUND-4 CORRECTION — same 180 degree error, same fix. The azimuth below put
// `hi` on +X and the step below it on -Z: both are culled. Negated, it puts
// `hi` on the -X flank (t = 0.97) and the step on the +Z trailing facet
// (t = 0.67), which are two of the three faces that actually reach the screen.
// The third, -Y, is given `chi` outright by `mg_vm_shell`.
let g_wp_side_ax: f64 = -0.940;
let g_wp_side_az: f64 =  0.341;

fn wpn_parts(p_m, p_tab: array<f64>, p_n: i32,
             p_c0: i32, p_c1: i32, p_c2: i32, p_c3: i32) {
    let m = p_m;
    let c_body: i32 = mg_norm_col(p_c0, g_vm_lum_body, g_vm_sat_metal);
    let c_dark: i32 = mg_norm_col(p_c1, g_vm_lum_dark, g_vm_sat_metal);
    let c_furn: i32 = mg_norm_col(p_c2, g_vm_lum_furn, g_vm_sat_furn);
    let c_spec: i32 = mg_norm_col(p_c3, g_vm_lum_spec, 0.05);
    let body_hi: i32 = c_body; let body_lo: i32 = mg_scale(c_body, g_vm_lo_step);
    let dark_hi: i32 = c_dark; let dark_lo: i32 = mg_scale(c_dark, 0.70);
    let furn_hi: i32 = c_furn; let furn_lo: i32 = mg_scale(c_furn, g_vm_lo_step);
    let spec_hi: i32 = c_spec; let spec_lo: i32 = mg_scale(c_spec, 0.86);
    // The weapon's own side split: see g_wp_side_*.
    let save_ax: f64 = g_mg_sun_ax; let save_az: f64 = g_mg_sun_az;
    g_mg_sun_ax = g_wp_side_ax; g_mg_sun_az = g_wp_side_az;
    let i: i32 = 0;
    while (i < p_n) {
        let o: i32 = i * 8;
        let slot: i32 = i32(p_tab[o + 6]);
        let hi: i32 = body_hi;
        let lo: i32 = body_lo;
        let mat: i32 = MG_MAT_VMSKIN;
        if (slot == 1) { hi = dark_hi; lo = dark_lo; }
        if (slot == 2) { hi = furn_hi; lo = furn_lo; }
        let ao: f64 = p_tab[o + 7];
        // ROUND 5 — THE SLOT-3 GAIN IS GONE. It used to be `ao * 1.25`, chosen
        // so that every spec face CLIPPED its vertex byte and the rendered
        // pixel became the raw MG_MAT_VMRAIL texel (240-243). That is precisely
        // what made the rail paint the brightest thing in the frame and let
        // three scenes fake CLAUDE.md §8's >220 anchor off the viewmodel. A
        // clipped face is also a face with no form shading — every rail facet
        // rendered the same 240 no matter which way it turned.
        //
        // With the gain removed the rail is lit like everything else and its
        // value comes from `g_vm_lum_spec` alone, so it lands where the ladder
        // puts it (measured 116..186 across the three drawn facets) and it
        // still reads as the top step, but as an EDGE rather than as a lamp.
        if (slot == 3) { hi = spec_hi; lo = spec_lo; mat = MG_MAT_VMRAIL; }
        mg_vm_shell(m, p_tab[o], p_tab[o + 1], p_tab[o + 2],
                    p_tab[o + 3], p_tab[o + 4], p_tab[o + 5],
                    mat, hi, lo, ao);
        i++;
    }
    g_mg_sun_ax = save_ax; g_mg_sun_az = save_az;
}

// ---------------------------------------------------------------------------
// THE SIX PART TABLES — 20 parts each, 240 triangles, ~120 DRAWN
// ---------------------------------------------------------------------------
// Every part is a box, and a box shows the camera exactly three of its six
// faces, so the drawn cost of a viewmodel is 6 x parts, NOT 12 x parts:
// 20 parts = 240 submitted, 120 drawn, which is the whole viewmodel allowance.
//
// Sizing rule learned from the gate PNGs: at 1.05 m and a 70 degree fov the
// scale is ~215 screen px per metre at 320x240, so a half-extent of 0.006 m is
// ONE PIXEL. The old tables spent 12 triangles each on 0.006 m guard rails and
// sight posts that could never resolve. Nothing here is thinner than 0.007 m,
// and the parts that carry the silhouette (magazine, stock, fore-end, muzzle)
// were all made chunkier — PS1-era weapons were bold, not fine.

// Sparrow AR — REBUILT IN ROUND 3 FOR SILHOUETTE.
//
// The round-2 table had six SPEC parts scattered over the model (rail, handguard
// rib, mag baseplate, cheek line, charging handle) and they rendered as five
// unrelated white chips instead of one edge. It also had the barrel (hy 0.020,
// z 0.26..0.54) sitting INSIDE the handguard's z range (0.20..0.38) at almost
// the same radius, so the two merged into a single tube and the gun had no
// thin element anywhere.
//
// Round 3, working from a measured 105 screen px per metre at 320x240 (the
// weapon's own mask spans 85 px for a 0.84 m model), so 2 native px = 0.019 m:
//
//   * ONE specular element carries the rim: a 0.32 m continuous rail along the
//     top of the receiver, exactly where the key lands hardest (keydot 0.86 on
//     +Y against 0.36 on the flank). Plus one 0.028 m charging-handle chip on
//     the flank, kept because it is the model's asymmetry cue.
//   * The barrel is 0.025 m across (2.6 px) against a 0.068 m handguard (7 px)
//     and a 0.052 m gas block, and a DARK gas block 0.044 m long (4.6 px) sits
//     between handguard and barrel, so the barrel is a separately readable thin
//     element with more than the two pixels of dark the critic asked for.
//   * The magazine chain is physically welded: receiver bottom y = 0.006,
//     magwell 0.042..-0.018, magazine 0.006..-0.118, baseplate -0.113..-0.139.
//     Every link overlaps the one above it. Round 2's "detached floating
//     parallelogram" was a value problem, not a geometry one, but the chain is
//     now explicit and the magwell is BODY so the mag reads as hanging off a
//     lighter block rather than out of nothing.
//   * The comb, the handguard cap and the muzzle brake are BODY (mid value)
//     rather than SPEC or DARK, so the model has a middle everywhere instead of
//     jumping straight from 20 to 240.
let g_wp_sparrow: array<f64> = [
