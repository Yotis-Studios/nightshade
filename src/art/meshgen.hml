    0.0,   0.113, 0.070, 0.011, 0.011, 0.118, 3, 1.00,   // TOP RAIL — the rim
    0.0,   0.136,-0.052, 0.012, 0.021, 0.014, 1, 1.00,   // rear sight (notch)
   -0.046, 0.090,-0.020, 0.014, 0.010, 0.030, 3, 1.00,   // charging handle SPEC (visible flank)
