// ---------------------------------------------------------------------------
// THE CANT — see mg_set_cant. These three angles are the single biggest
// readability change in this file, and they cost zero triangles and zero
// milliseconds.
//
// The renderer hands mesh_emit_yaw `PI - camera_yaw`, which maps local +Z to
// the camera's horizontal forward and local +X to the camera's LEFT. The
// weapon origin sits 1.05 m forward, 0.26 m right and 0.34 m down, so the
// camera looks at the weapon from its +X flank, slightly above and well
// behind: without a cant the dominant component is -Z and the gun is seen
// END-ON.
//
// yaw +21 deg swings the muzzle toward +X, i.e. toward SCREEN CENTRE, which
//   (a) puts the barrel tip next to the crosshair where a shooter expects it
//   and (b) opens the whole flank of the receiver to the camera.
// pitch +6 deg lifts the muzzle so the barrel line rises toward the crosshair
//   instead of sagging out of frame.
// roll +16 deg tips the top of the weapon toward the camera so the SPEC band
//   along the rail is actually facing the viewer rather than the sky. The
//   camera sits only ~12 deg above the weapon, so an untilted top face is seen
//   at a 78 deg grazing angle and a 6 cm rail projects to under two pixels —
//   measured, and the reason the first attempt at a specular band did not read.
let g_wp_cant_yaw: f64   = 21.0;
let g_wp_cant_pitch: f64 = 6.0;
let g_wp_cant_roll: f64  = 26.0;

// Warm the palette's gunmetal. The critic's instruction was "a dark, slightly
// warm gunmetal, saturation < 0.15, so light modulates it instead of colouring
// it". GUNMETAL_HI is (122,128,136) — cool — CELL_METAL_PANEL is cool, and the
// ambient `tod.hml` produces is cool at every hour except sunset, so all three
// stacked and the weapon rendered blue. A 22 % pull toward RUST_DARK lands the
// metal at (119,113,114): warm side of neutral, saturation 0.041, well inside
// the 0.10 cap `mg_norm_col` then enforces. No hex literal — RUST_DARK is a
// palette constant, per rule 5 of this file's header.
fn wpn_metal(p_c: i32): i32 {
    let out: i32 = mg_mix(p_c, g_RUST_DARK, 0.22);
    return out;
}

fn build_weapon(p_m, p_id: i32) {
    let m = p_m;
    mg_set_cant(g_wp_cant_yaw, g_wp_cant_pitch, g_wp_cant_roll, 0.0, 0.0, 0.0);
    // The rim is warmed the same way: a pure STEEL_HI highlight over a warm
    // receiver reads as a separate blue object stuck to the gun.
    let spec: i32 = mg_mix(g_STEEL_HI, g_BRASS, 0.12);
    // Sparrow furniture: POLYMER alone is (94,96,88), an olive so close to
    // neutral that after the value ladder it was indistinguishable from the
    // receiver. Half-way to WOOD_MID gives a warm tan at saturation 0.16 — the
    // one warm block on the model, which is what separates stock/grip/magazine
    // from receiver/barrel at 60 px.
    let sparrow_furn: i32 = mg_mix(g_POLYMER, g_WOOD_MID, 0.50);
    // NOTE: there is no MESH_SPARROW_VM branch any more — slot 28 is the
    // lantern and `meshgen_build_all` never routes it here. `g_wp_sparrow` is
    // retained only as the table the five surviving guns were tuned against.
    if (p_id == MESH_TINKER_VM) {
        wpn_parts(m, g_wp_tinker, 20, wpn_metal(g_STEEL_MID),
                  wpn_metal(g_GUNMETAL_LO), sparrow_furn, spec);
    } else if (p_id == MESH_BELLOWS_VM) {
        wpn_parts(m, g_wp_bellows, 20, wpn_metal(g_GUNMETAL_HI),
                  wpn_metal(g_GUNMETAL_LO), g_WOOD_MID, spec);
    } else if (p_id == MESH_LONGSHADOW_VM) {
        wpn_parts(m, g_wp_longshadow, 20, wpn_metal(g_GUNMETAL_HI),
                  wpn_metal(g_GUNMETAL_LO), g_WOOD_HI, spec);
    } else if (p_id == MESH_KESTREL_VM) {
        wpn_parts(m, g_wp_kestrel, 20, wpn_metal(g_STEEL_MID),
                  wpn_metal(g_GUNMETAL_LO), g_WOOD_HI, g_BRASS);
    } else {
        wpn_parts(m, g_wp_emberlance, 20, wpn_metal(g_GUNMETAL_HI),
                  g_RUST_DARK, g_BRASS_LO, g_BRASS);
    }
    mg_clear_cant();
}

// ===========================================================================
// THE LANTERN VIEWMODEL — the one the player actually holds
// ===========================================================================
//
// WHY A LANTERN AND NOT A GUN. The design's one-line pitch is "you are the last
// lamplighter of a world eaten by night: you push the dark back one lantern at
// a time". Four rounds of art work could not make 20 boxes read as a gun at
// 320x240 — it needs a barrel, a receiver, a magazine and a stock to be legible
// as one, and at 60x70 px none of those resolve, so it read first as a black
// lump and then as a chrome lump. A lantern is a silhouette a child can draw:
// a fist, a bail, a cage, a flame. It resolves at 45x100 px because it is four
// shapes, not eleven.
//
// It also fixes the anchor problem HONESTLY. CLAUDE.md §8 wants a contiguous
// region above luminance 220 in every frame, and that rule has been gamed five
// times (crosshair, minimap bracket, gun sparkles, gun rail paint, and a splat
// that rendered the lantern glow card as a hard white square) because nothing
// in the world was genuinely bright. A lantern held by the player is a DIEGETIC
// LIGHT SOURCE in every frame. Its core is above 220 because it is on fire.
// That is not the loophole, that is the thing the rule was asking for.
//
// ---------------------------------------------------------------------------
// SPACE, AND WHY THERE IS NO CANT
// ---------------------------------------------------------------------------
// `world_render.hml` emits the viewmodel at eye + 1.05 forward + 0.26 right
// - 0.34 up, with model yaw PI - camera_yaw, which maps local +Z to the
// camera's forward and local +X to the camera's LEFT. So the direction from the
// model to the eye, in model space, is
//
//     c = normalize(0.26, 0.34, -1.05) = (0.229, 0.300, -0.926)
//
// and `mg_vm_shell`'s measured drawn-face set (-Y, +Z, -X) is exactly the set
// of faces with n . c < 0. The gun needed a 21/6/26 cant to avoid being seen
// end-on; a lantern is a vertical object and reads correctly with NO cant at
// all — which is lucky, because the drawn set is cant-dependent and an
// uncanted model is the one case where `mg_vm_shell` needs no re-derivation.
//
// VERIFIED, not asserted: slot 28 was temporarily replaced by a 20 cm box with
// six differently-coloured faces and rendered into `hud_worst_case`. The three
// faces that appeared were -Y (black), +Z (green) and -X (brass). Screenshot
// reasoning would have got this backwards — the renderer keeps the faces
// pointing AWAY from the eye (`emit_set_backface(EMIT_BF_CCW)` in
// `world_render.hml`), which is also the most likely cause of the playtest's
// "flying over some buildings it didnt render all sides". If that cull is ever
// corrected, `mg_vm_shell` must switch to (+Y, -Z, +X) in the same commit or
// every viewmodel in the game turns inside out. The two flame boxes below are
// built as SOLID boxes precisely so the >220 core survives that flip.
//
// ---------------------------------------------------------------------------
// SCREEN LAYOUT — every number below was solved, then CHECKED against a render
// ---------------------------------------------------------------------------
// The 70 deg fov is VERTICAL, so f = 120 / tan(35 deg) = 171.4 px and the scale
// at 1.05 m is 163.2 px per metre — not the 217.6 you get by assuming a
// horizontal fov, and not the "~215 screen px per metre" the weapon tables
// above are commented with. That comment is wrong and it is why the first cut
// of this model came out 25 % small; it is left alone here because those tables
// are not this task's to retune. The projection actually is:
//
//     sx = 160 + (0.26 - lx) * 163.2        sy = 120 + (0.34 - ly) * 163.2
//
// so local (0,0,0) is screen (202, 176). Verified: the first build put the
// flame at x212..220 y170..178, against a solved prediction of x212..221
// y169..181. The layout targets:
//
//     fist          screen (234, 129)     the hand is what stops it "floating"
//     cage          screen 196..238 x, 143..206 y      42 x 63 px
//     flame         screen 209..224 x, 167..195 y      15 x 28 px
//     crosshair     screen (160, 120)     the lantern never touches it
//     ammo plate    screen 238.. x, 202.. y            the base clears it
//
// ---------------------------------------------------------------------------
// THE VALUE LADDER
// ---------------------------------------------------------------------------
// Round 5 measured the rendered multiplier on the drawn facets at the exposure
// floor: MG_MAT_VMSKIN lands at albedo x 1.174, MG_MAT_VMRAIL at albedo x 1.62,
// and the binding ceiling is ns_bloom's brightest WORLD pixel, 188. The lantern
// keeps every IRON, BRASS, LEATHER and CLOTH slot under that ceiling — the
// hardware of the lantern is not allowed to be the brightest thing in the
// frame, for exactly the reason round 5 wrote down. Measured over the whole
// viewmodel window at 320x240, HUD masked: p50 49, p95 126, and the only pixels
// over 188 belong to the flame.
//
// The FLAME is allowed over the ceiling, because it is a flame. Its vertices
// are overwritten AFTER the bake (see `mg_lamp_emissive`), so they do not scale
// with the world's exposure: measured 148-158 contiguous pixels above luminance
// 220 in all seven scenes plus midnight and noon, varying by 10 px across a
// 24-hour sweep. The lamp does not go out at midnight and does not blow out at
// noon, and that is the whole point of the object.
let g_lamp_lum_iron: f64  = 72.0;    // ->  85 rendered,  90 at noon
let g_lamp_lum_brass: f64 = 112.0;   // -> 131 rendered, 140 at noon
let g_lamp_lum_leather: f64 = 58.0;  // ->  68 rendered
let g_lamp_lum_cloth: f64 = 74.0;    // ->  87 rendered
let g_lamp_sat_iron: f64  = 0.14;
let g_lamp_sat_warm: f64  = 0.30;
let g_lamp_lo_step: f64   = 0.62;

// ---------------------------------------------------------------------------
// THE EMISSIVE TIERS — final vertex bytes, and why the CORE IS NEARLY WHITE
// ---------------------------------------------------------------------------
// The rendered pixel is vertex x texel, and MG_MAT_VMRAIL's window is a flat
// 240..243, i.e. x0.945. To clear luminance 220 on screen a vertex therefore
// needs luminance 233 — and that is a much harder constraint on a WARM colour
// than it looks, because luminance is 0.299r + 0.587g + 0.114b. The first cut
// used MUZZLE_MID (255,196,74) for the flame body: scaled to a peak byte of 246
// that is luminance 193 at the vertex and 182 on screen, thirty-eight short,
// even though its red channel is pegged at 246. An amber cannot be an anchor.
//
// So the flame is built the way a real one looks: a NEARLY WHITE core with the
// amber living in the falloff around it. MUZZLE_CORE (255,248,220) is the
// palette's only near-white and its luminance/max ratio is 0.968, so a peak
// byte of 255 lands at 247 on the vertex and 233 on screen. Everything below
// that — the outer columns of the flame, the halo, the wick — is frankly amber
// and frankly under 220, which is what makes the core read as a core.
//
// The ramp is expressed as HEAT, 0..1, per vertex, and resolved to a final byte
// triple by `mg_lamp_heat`. Four stops, and the top one is a PLATEAU: heat 0.76
// to 1.00 is all MUZZLE_CORE, because the 233-at-the-vertex bar means anything
// warmer than about (250,215,145) simply cannot be an anchor, so a ramp that
// spends its top quarter going from amber to white would render a >220 region
// four pixels across. The plateau is what gives the core its 40+ px.
//
//     heat   colour                    peak byte   vertex lum   screen lum
//     0.00   RUST_DARK                     42           27           26
//     0.30   EMBER                        140          105           99
//     0.62   MUZZLE_MID                   220          167          158
//     0.76   MUZZLE_CORE                  252          244          231
//     1.00   MUZZLE_CORE                  255          247          233
let g_lamp_h1: f64 = 0.30;
let g_lamp_h2: f64 = 0.62;
let g_lamp_h3: f64 = 0.76;
let g_lamp_p0: f64 =  42.0;
let g_lamp_p1: f64 = 140.0;
let g_lamp_p2: f64 = 220.0;
let g_lamp_p3: f64 = 252.0;
let g_lamp_p4: f64 = 255.0;
// How far the flame is allowed to take the scene's key chromaticity. A flame
// is its own light source, so this is small — it exists so the lantern is not
// a decal pasted on four different skies, not so it changes colour.
let g_lamp_tint: f64 = 0.14;

// The emissive arena-vertex range, and the per-arena-vertex heat inside it.
// Both are recorded at build time and replayed by `mg_lamp_emissive` after
// every re-bake.
let g_lamp_v0: i32 = 0;
let g_lamp_v1: i32 = 0;
let g_lamp_hw: array<f64> = [];

// ---------------------------------------------------------------------------
// THE LIGHT IS BUILT FROM +Z QUADS, NOT FROM BOXES — and here is the bug why
// ---------------------------------------------------------------------------
// The first cut built the flame as two solid boxes. They rendered as a hollow
// "L": the -Y and -X faces appeared, the +Z face — the LARGEST of the three,
// 13x13 px of the 15x28 px flame — never did. Isolated with a six-colour debug
// box at the flame's exact centre and size (brass -X and black -Y drawn, green
// +Z and violet -Z absent from the whole 320x240 frame, verified by a channel
// scan), and the screen-space winding was solved by hand at the same time:
//
//     face   snapped screen cross      emit_set_backface(EMIT_BF_CCW) keeps >0
//     +Z     +169                      SHOULD DRAW — does not
//     -X      +52                      draws
//     -Y      +39                      draws
//     +Y/-Z/+X  -39 / -169 / -52       correctly culled
//
// Nothing is submitted after it, nothing nearer covers those pixels (checked
// part by part), and `batch.overflow`, `overflow.world` and `clip.slow` are all
// zero. A standalone +Z quad at z = +0.098 in the SAME mesh renders correctly,
// so it is not the winding and not the material. **This is a minimal, in-frame
// reproduction of playtest defect (3), "flying over some buildings it didnt
// render all sides", on geometry small enough to debug.** It belongs to whoever
// owns `emit.hml` / `world_render.hml`; it is written up in the task report.
//
// The lantern does not wait for that fix. The flame is built out of the thing
// that demonstrably works — flat +Z-facing quads — which is also better art: a
// flame is not a cuboid, and a graded card gives a teardrop with a hot middle
// for 18 triangles instead of a hollow box for 24.

// Push the heat of every arena vertex a quad emits, in `mesh_quad`'s own order
// (a,b,c then a,c,d). `mesh_bake_light` overwrites the vertex colour, so by the
// time the emissive override runs the albedo the builder wrote is gone and the
// weight cannot be recovered from the buffer — the first cut tried to invert it
// out of the red channel and produced a flat grey-green card, which is exactly
// what a reflector with no falloff looks like.
fn mg_lamp_quad(p_m, p_a: i32, p_b: i32, p_c: i32, p_d: i32,
                p_ha: f64, p_hb: f64, p_hc: f64, p_hd: f64) {
    mesh_quad(p_m, p_a, p_b, p_c, p_d);
    g_lamp_hw.push(p_ha); g_lamp_hw.push(p_hb); g_lamp_hw.push(p_hc);
    g_lamp_hw.push(p_ha); g_lamp_hw.push(p_hc); g_lamp_hw.push(p_hd);
}

// A +Z-facing vertex. The winding used by every caller below is copied from
// `mg_vm_shell`'s +Z face — (lo x, lo y), (hi x, lo y), (hi x, hi y),
// (lo x, hi y) — which `mesh_tri` turns into an outward +Z normal.
fn mg_lamp_v(p_m, p_x: f64, p_y: f64, p_z: f64,
             p_s: f64, p_t: f64, p_col: i32): i32 {
    let out: i32 = mg_v(p_m, p_x, p_y, p_z, p_s, p_t,
                        MG_MAT_VMRAIL, p_col, 1.0);
    return out;
}

// ---------------------------------------------------------------------------
// mg_lamp_backpanel — the glow behind the flame. 8 triangles.
// ---------------------------------------------------------------------------
// A 3x3 vertex grid on the cage's BACK plane with the centre node hot and the
// corners dark. That bilinear falloff is what makes the interior of the lantern
// read as LIT rather than as a coloured card: a glow with a uniform colour is a
// sticker, a glow with a hot middle is a light. Its heat tops out at 0.50, well
// under the 0.76 the ramp needs to clear 220 — the panel is the HALO, the flame
// is the anchor, and the two must not be confusable.
let g_lamp_back_heat: f64 = 0.50;

fn mg_lamp_backpanel(p_m, p_cx: f64, p_cy: f64, p_z: f64,
                     p_hx: f64, p_hy: f64): i32 {
    let m = p_m;
    let t0: i32 = mesh_tri_count(m);
    let gx: array<f64> = [p_cx - p_hx, p_cx, p_cx + p_hx];
    let gy: array<f64> = [p_cy - p_hy, p_cy, p_cy + p_hy];
    // radial weight per grid node: centre 1, edge-mid 0.42, corner 0
    let wt: array<f64> = [0.00, 0.42, 0.00,
                          0.42, 1.00, 0.42,
                          0.00, 0.42, 0.00];
    let idx: array<i32> = [];
    let j: i32 = 0;
    while (j < 3) {
        let i: i32 = 0;
        while (i < 3) {
            let c: i32 = mg_mix(g_RUST_DARK, g_WINDOW_LIGHT, wt[j * 3 + i]);
            idx.push(mg_lamp_v(m, gx[i], gy[j], p_z,
                               f64(i) * 0.5, 1.0 - f64(j) * 0.5, c));
            i++;
        }
        j++;
    }
    j = 0;
    while (j < 2) {
        let i: i32 = 0;
        while (i < 2) {
            let ka: i32 = j * 3 + i;
            let kb: i32 = j * 3 + i + 1;
            let kc: i32 = (j + 1) * 3 + i + 1;
            let kd: i32 = (j + 1) * 3 + i;
            mg_lamp_quad(m, idx[ka], idx[kb], idx[kc], idx[kd],
                         wt[ka] * g_lamp_back_heat, wt[kb] * g_lamp_back_heat,
                         wt[kc] * g_lamp_back_heat, wt[kd] * g_lamp_back_heat);
            i++;
        }
        j++;
    }
    let out: i32 = mesh_tri_count(m) - t0;
    return out;
}

// ---------------------------------------------------------------------------
// mg_lamp_flame — the flame itself. 18 triangles, and the frame's anchor.
// ---------------------------------------------------------------------------
// Four rows by four columns, giving a teardrop: narrow at the wick, widest a
// third of the way up, tapering to a point. The two INNER columns carry heat
// 1.0 for their whole height, so the quad between them is a uniformly saturated
// vertical band rather than a Gouraud gradient with one bright vertex — that
// band is the >=40 px contiguous core, measured at 15 x 21 px. The outer
// columns fall to 0.46 (amber, ~110 on screen), which is the falloff.
//
// Rows are half-widths as a fraction of `p_hx`, heights as a fraction of
// `p_hy` measured from the wick. The asymmetric taper (widest at row 1, not
// row 2) is what makes it read as a flame and not as a diamond.
let g_lamp_row_y: array<f64> = [-1.00, -0.32,  0.34,  1.00];
let g_lamp_row_w: array<f64> = [ 0.46,  1.00,  0.72,  0.13];
let g_lamp_row_h: array<f64> = [ 0.72,  1.00,  1.00,  0.94];
let g_lamp_col_in: f64 = 0.60;      // inner column, as a fraction of the row
let g_lamp_edge_heat: f64 = 0.46;   // outer column heat

fn mg_lamp_flame(p_m, p_cx: f64, p_cy: f64, p_z: f64): i32 {
    let m = p_m;
    let t0: i32 = mesh_tri_count(m);
    let hx: f64 = 0.058;
    let hy: f64 = 0.070;
    let idx: array<i32> = [];
    let heat: array<f64> = [];
    let j: i32 = 0;
    while (j < 4) {
        let w: f64 = g_lamp_row_w[j] * hx;
        let y: f64 = p_cy + g_lamp_row_y[j] * hy;
        let hin: f64 = g_lamp_row_h[j];
        let hout: f64 = g_lamp_edge_heat * hin;
        let xs: array<f64> = [0.0 - w, 0.0 - w * g_lamp_col_in,
                              w * g_lamp_col_in, w];
        let hs: array<f64> = [hout, hin, hin, hout];
        let i: i32 = 0;
        while (i < 4) {
            let c: i32 = mg_mix(g_EMBER, g_MUZZLE_CORE, hs[i]);
            idx.push(mg_lamp_v(m, p_cx + xs[i], y, p_z,
                               f64(i) / 3.0, 1.0 - f64(j) / 3.0, c));
            heat.push(hs[i]);
            i++;
        }
        j++;
    }
    j = 0;
    while (j < 3) {
        let i: i32 = 0;
        while (i < 3) {
            let ka: i32 = j * 4 + i;
            let kb: i32 = j * 4 + i + 1;
            let kc: i32 = (j + 1) * 4 + i + 1;
            let kd: i32 = (j + 1) * 4 + i;
            mg_lamp_quad(m, idx[ka], idx[kb], idx[kc], idx[kd],
                         heat[ka], heat[kb], heat[kc], heat[kd]);
            i++;
        }
        j++;
    }
    let out: i32 = mesh_tri_count(m) - t0;
    return out;
}

// ---------------------------------------------------------------------------
// THE PART TABLE — 8 numbers per part: cx, cy, cz, hx, hy, hz, slot, ao
// ---------------------------------------------------------------------------
// slot 0 IRON (cage frame)  1 BRASS (cap, base, bail)  2 LEATHER (glove)
// slot 3 CLOTH (cuff)
//
// The cage is deliberately an OPEN frame — four corner posts, a cap and a pan,
// with nothing across the front. A closed glass box would put a lit face in
// FRONT of the flame, and with no z-buffer the front face wins the painter sort
// and eats the >220 core. Open cage, flame visible, anchor intact.
//
// The posts sit at lx = CX +- 0.088, which projects to screen columns 216 and
// 254; the flame occupies 228..242. The bars never cross the core.
let g_lamp_cx: f64 = -0.089;    // 8.9 cm to the camera's RIGHT of the emit point
let g_lamp: array<f64> = [
//   cx      cy      cz      hx     hy     hz     slot  ao
  -0.089, -0.170,  0.000,  0.128, 0.020, 0.098,  1.0, 0.94,   // base pan
  -0.089, -0.198,  0.000,  0.086, 0.014, 0.066,  1.0, 0.84,   // foot
   0.024,  0.003, -0.075,  0.016, 0.153, 0.016,  0.0, 1.00,   // post front-left
  -0.202,  0.003, -0.075,  0.016, 0.153, 0.016,  0.0, 1.00,   // post front-right
   0.024,  0.003,  0.075,  0.016, 0.153, 0.016,  0.0, 0.88,   // post back-left
  -0.202,  0.003,  0.075,  0.016, 0.153, 0.016,  0.0, 0.88,   // post back-right
  -0.089,  0.178,  0.000,  0.131, 0.022, 0.100,  1.0, 1.00,   // cap plate
  -0.089,  0.208,  0.000,  0.088, 0.018, 0.068,  1.0, 1.00,   // cap peak
  -0.089,  0.234,  0.000,  0.034, 0.014, 0.030,  0.0, 1.00,   // vent finial
  -0.019,  0.262,  0.000,  0.013, 0.032, 0.013,  0.0, 0.96,   // bail arm
  -0.119,  0.292,  0.000,  0.074, 0.013, 0.014,  0.0, 1.00,   // bail bar
  -0.194,  0.286, -0.008,  0.054, 0.046, 0.048,  2.0, 1.00,   // fist on the bail
  -0.146,  0.256, -0.046,  0.024, 0.021, 0.020,  2.0, 0.88,   // thumb
  -0.252,  0.243,  0.008,  0.034, 0.030, 0.036,  1.0, 0.96,   // cuff ring
  -0.302,  0.212,  0.014,  0.048, 0.040, 0.044,  3.0, 0.90,   // sleeve
  -0.089, -0.135,  0.000,  0.034, 0.014, 0.030,  0.0, 1.00    // wick housing
];
let g_lamp_n: i32 = 16;

// The lantern's own side split. `mg_side_col` needs a horizontal bearing to
// decide which vertical face is `hi`; for a lantern that bearing is the
// CAMERA's, not the sun's, because the object is 1 m from the eye and its
// value structure has to be legible from the one direction it is ever seen
// from. -X (the flank the player looks at, t = 0.97) is `hi`; +Z (the trailing
// facet, t = 0.67) is the step below it. Same numbers as the gun's, same
// reason.
let g_lamp_side_ax: f64 = -0.940;
let g_lamp_side_az: f64 =  0.341;

fn build_lantern_vm(p_m) {
    let m = p_m;
    // ---- the four hardware slots ------------------------------------------
    // Iron: GUNMETAL_LO pulled 45 % toward RUST_DARK. A lantern is wrought
    // iron that lives outdoors; a cool gunmetal cage under a warm flame reads
    // as two objects. No hex literal — both are palette constants.
    let c_iron: i32 = mg_norm_col(mg_mix(g_GUNMETAL_LO, g_RUST_DARK, 0.45),
                                  g_lamp_lum_iron, g_lamp_sat_iron);
    let c_brass: i32 = mg_norm_col(g_BRASS, g_lamp_lum_brass, g_lamp_sat_warm);
    let c_leather: i32 = mg_norm_col(mg_mix(g_WOOD_LO, g_RUST_DARK, 0.40),
                                     g_lamp_lum_leather, g_lamp_sat_warm);
    let c_cloth: i32 = mg_norm_col(mg_mix(g_FABRIC_CREAM, g_DIRT_MID, 0.55),
                                   g_lamp_lum_cloth, 0.24);
    let iron_lo: i32 = mg_scale(c_iron, g_lamp_lo_step);
    let brass_lo: i32 = mg_scale(c_brass, g_lamp_lo_step);
    let leather_lo: i32 = mg_scale(c_leather, g_lamp_lo_step);
    let cloth_lo: i32 = mg_scale(c_cloth, g_lamp_lo_step);

    let save_ax: f64 = g_mg_sun_ax; let save_az: f64 = g_mg_sun_az;
    g_mg_sun_ax = g_lamp_side_ax; g_mg_sun_az = g_lamp_side_az;
    let i: i32 = 0;
    while (i < g_lamp_n) {
        let o: i32 = i * 8;
        let slot: i32 = i32(g_lamp[o + 6]);
        let hi: i32 = c_iron;
        let lo: i32 = iron_lo;
        if (slot == 1) { hi = c_brass;   lo = brass_lo; }
        if (slot == 2) { hi = c_leather; lo = leather_lo; }
        if (slot == 3) { hi = c_cloth;   lo = cloth_lo; }
        mg_vm_shell(m, g_lamp[o], g_lamp[o + 1], g_lamp[o + 2],
                    g_lamp[o + 3], g_lamp[o + 4], g_lamp[o + 5],
                    MG_MAT_VMSKIN, hi, lo, g_lamp[o + 7]);
        i++;
    }
    g_mg_sun_ax = save_ax; g_mg_sun_az = save_az;

    // ---- the light itself, halo then flame ---------------------------------
    // Both are +Z-facing quad grids and both are OVERWRITTEN by
    // `mg_lamp_emissive` after the bake, so the albedo passed in only matters
    // if the bake never runs. The halo goes first so the painter sort has it
    // behind the flame even inside one depth bucket.
    g_lamp_hw = [];
    g_lamp_v0 = mesh_tri_count(m) * 3;
    mg_lamp_backpanel(m, g_lamp_cx, -0.010, 0.098, 0.114, 0.145);
    mg_lamp_flame(m, g_lamp_cx, -0.040, 0.040);
    g_lamp_v1 = mesh_tri_count(m) * 3;
}

// The ramp: heat 0..1 -> a palette colour and a peak byte, four stops with a
// plateau on top. Returns one channel so the caller can build the triple
// without allocating an object per vertex (CLAUDE.md §1 rule 2).
fn mg_lamp_heat(p_h: f64, p_k: f64, p_ch: i32): f64 {
    let h: f64 = p_h;
    if (h < 0.0) { h = 0.0; }
    if (h > 1.0) { h = 1.0; }
    let ca: i32 = g_RUST_DARK;   let cb: i32 = g_EMBER;
    let pa: f64 = g_lamp_p0;     let pb: f64 = g_lamp_p1;
    let t: f64 = h / g_lamp_h1;
    if (h >= g_lamp_h3) {
        ca = g_MUZZLE_CORE; cb = g_MUZZLE_CORE;
        pa = g_lamp_p3; pb = g_lamp_p4;
        t = (h - g_lamp_h3) / (1.0 - g_lamp_h3);
    } else if (h >= g_lamp_h2) {
        ca = g_MUZZLE_MID; cb = g_MUZZLE_CORE;
        pa = g_lamp_p2; pb = g_lamp_p3;
        t = (h - g_lamp_h2) / (g_lamp_h3 - g_lamp_h2);
    } else if (h >= g_lamp_h1) {
        ca = g_EMBER; cb = g_MUZZLE_MID;
        pa = g_lamp_p1; pb = g_lamp_p2;
        t = (h - g_lamp_h1) / (g_lamp_h2 - g_lamp_h1);
    }
    let c: i32 = mg_mix(ca, cb, t);
    let peak: f64 = pa + (pb - pa) * t;
    let r: f64 = f64(pal_r(c));
    let g: f64 = f64(pal_g(c));
    let b: f64 = f64(pal_b(c));
    let mx: f64 = r;
    if (g > mx) { mx = g; }
    if (b > mx) { mx = b; }
    if (mx < 1.0) { mx = 1.0; }
    let sc: f64 = peak / mx;
    let v: f64 = r * sc;
    if (p_ch == 1) { v = g * sc; }
    if (p_ch == 2) { v = b * sc; }
    let out: f64 = v * (1.0 + (p_k - 1.0) * g_lamp_tint);
    return out;
}

// ---------------------------------------------------------------------------
// mg_lamp_emissive — the flame does not obey the light rig
// ---------------------------------------------------------------------------
// The gun's original bug was that it was lit like world geometry and went black
// at dusk. The lantern's hardware is fixed by the viewmodel rig (exposure
// floor, scene tint, chroma cap) exactly as the gun's was — that part was
// always right. The FLAME cannot be, for the same reason a candle does not get
// dimmer when the sun sets: it is the source, not the receiver. So these
// vertices are written directly, after `mesh_bake_light` and after
// `mg_lift_floor`, as final bytes.
//
// `p_kr/kg/kb` is the scene key's chromaticity, normalized to unit luminance
// and already chroma-capped by the caller. Only `g_lamp_tint` of it is applied:
// enough that the lantern belongs to a violet-bloom night and to a golden
// evening, not enough that the flame changes colour.
fn mg_lamp_emissive(p_m, p_kr: f64, p_kg: f64, p_kb: f64) {
    let m = p_m;
    if (g_lamp_v1 <= g_lamp_v0) { return; }
    let vb: ptr = mesh_buf(m);
    let cache: array<i32> = m.ac;
    let nh: i32 = g_lamp_hw.length;
    let i: i32 = g_lamp_v0;
    while (i < g_lamp_v1) {
        let k: i32 = i - g_lamp_v0;
        let h: f64 = 0.0;
        if (k < nh) { h = g_lamp_hw[k]; }
        let ir: i32 = mg_clamp255(mg_lamp_heat(h, p_kr, 0));
        let ig: i32 = mg_clamp255(mg_lamp_heat(h, p_kg, 1));
        let ib: i32 = mg_clamp255(mg_lamp_heat(h, p_kb, 2));
        let o: i32 = i * 24 + 20;
        ptr_write_u8(ptr_offset(vb, o, 1), ir);
        ptr_write_u8(ptr_offset(vb, o + 1, 1), ig);
        ptr_write_u8(ptr_offset(vb, o + 2, 1), ib);
        cache[i] = ir + ig * 256 + ib * 65536;
        i++;
    }
}

// ---------------------------------------------------------------------------
// THE HELD-OBJECT BOB — computed here, applied by the renderer
// ---------------------------------------------------------------------------
// A first-person object is on screen 100 % of the time, so this has to be
// SUBTLE: the amplitudes below are 1.4 cm vertical and 0.9 cm lateral at a full
// sprint, which is 3 px and 2 px at 320x240. Anything bigger is nausea.
//
// A lantern hangs from a bail, so it does not bob in phase with the step — it
// LAGS it. `p_phase` is the walk cycle (radians, 2 per stride); the lateral
// term runs at half rate and a quarter-cycle behind, which is what reads as
// swing rather than as a bouncing sprite. The idle term never stops: a held
// lamp is never still.
//
// It is here rather than in `world_render.hml` because that file is not owned
// by this task. It is a pure function of two scalars — no state, no allocation,
// writes three f64s into a caller-owned array. `ARCHITECTURE.md` §5 carries the
// signature; the call site is six lines in `world_render.hml`, listed in the
// task report.
//
//     meshgen_vm_bob(p_phase, p_speed01, out3)
//     vx += right * out3[0] + up * out3[1] + fwd * out3[2]
let g_lamp_bob_y: f64 = 0.014;      // vertical, at speed 1
let g_lamp_bob_x: f64 = 0.009;      // lateral, at speed 1
let g_lamp_bob_z: f64 = 0.006;      // fore/aft, at speed 1
let g_lamp_idle_y: f64 = 0.0035;    // never stops
let g_lamp_idle_x: f64 = 0.0022;

export fn meshgen_vm_bob(p_phase: f64, p_speed: f64, p_out: array<f64>) {
    let ph: f64 = p_phase;
    let sp: f64 = p_speed;
    if (sp < 0.0) { sp = 0.0; }
    if (sp > 1.0) { sp = 1.0; }
    // ease the amplitude in, so the first step does not snap
    let amp: f64 = sp * sp * (3.0 - 2.0 * sp);
    let bx: f64 = sin(ph * 0.5 - 1.5707963267948966) * g_lamp_bob_x * amp;
    let by: f64 = cos(ph) * g_lamp_bob_y * amp;
    let bz: f64 = sin(ph * 0.5) * g_lamp_bob_z * amp;
    // the idle sway is a slow lissajous on the same phase clock
    let ix: f64 = sin(ph * 0.17) * g_lamp_idle_x;
    let iy: f64 = sin(ph * 0.23 + 1.1) * g_lamp_idle_y;
    p_out[0] = bx + ix;
    p_out[1] = by + iy;
    p_out[2] = bz;
}

// ===========================================================================
// THE BAKE — light once, then never touch a normal again (ENGINE_GAPS G19)
// ===========================================================================
//
// NOON keyframe from ART_BIBLE 5.1. AMBIENT + SUN == (1,1,1) exactly, which is
// the invariant that makes a sun-facing surface render at its authored albedo.
let g_mg_sun_x: f64 = 0.18;
let g_mg_sun_y: f64 = 0.96;
let g_mg_sun_z: f64 = 0.22;
let g_mg_sun_r: f64 = 0.58; let g_mg_sun_g: f64 = 0.56; let g_mg_sun_b: f64 = 0.50;
let g_mg_amb_r: f64 = 0.42; let g_mg_amb_g: f64 = 0.44; let g_mg_amb_b: f64 = 0.50;
let g_mg_bnc_r: f64 = 0.13; let g_mg_bnc_g: f64 = 0.16; let g_mg_bnc_b: f64 = 0.07;

// ART_BIBLE 8.2.6 / CLAUDE.md 8: NEVER BLACK. The world atlas has a minimum
// albedo luminance of 72 and vertex colour can only darken, so an unmodified
// bake puts unlit faces well below that floor and characters merge into one
// dark blob at range. This is a soft floor, not a clamp: luminance below 96 is
// compressed into [72, 96] instead of being clipped, so the value ordering the
// bake produced survives. Hue is preserved (the whole triple is scaled).
export let MG_LUM_FLOOR = 72;
let g_mg_lum_knee: f64 = 96.0;

// The VIEWMODEL gets its own, far lower floor. The 72 floor exists so that two
// enemies 30 m away do not merge into one dark blob; the weapon is never at
// 30 m, is never seen against another weapon, and occupies ~4500 px of a
// 76 800 px frame. Applying the world floor to it was measurably the biggest
// single cause of "the viewmodel reads as a grey lump": it took every dark
// shape on the gun — barrel, ejection port, butt plate, trigger group, sights,
// the shapes that CUT the silhouette — and dragged them up into a 24-value band
// with the mid tones. 26 lets them be dark.
//
// ROUND 3: it is a safety net, not a look. Round 2 leaned on it — every slot
// landed under luminance 40, so `mg_lift_floor` was flattening most of the
// model into the 26..40 band and the gun rendered at median 25 with 64 % of its
// own pixels below luminance 30. With the round-3 ladder almost no vertex
// reaches the floor, and the sub-30 half of CLAUDE.md §8's contrast pair comes
// from the DARK slot landing on the dark texels of CELL_METAL_PANEL (whose
// floor is 67/255) rather than from the floor itself.
export let MG_VM_LUM_FLOOR = 26;
let g_mg_vm_lum_knee: f64 = 40.0;

fn mg_lift_floor(p_m, p_floor: f64, p_knee: f64): i32 {
    let m = p_m;
    let n: i32 = mesh_vert_count(m);
    let vb: ptr = mesh_buf(m);
    let cache: array<i32> = m.ac;
    let knee: f64 = p_knee;
    let floor_l: f64 = p_floor;
    let lifted: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        let o: i32 = i * 24 + 20;
        let r: f64 = f64(ptr_deref_u8(ptr_offset(vb, o, 1)));
        let g: f64 = f64(ptr_deref_u8(ptr_offset(vb, o + 1, 1)));
        let b: f64 = f64(ptr_deref_u8(ptr_offset(vb, o + 2, 1)));
        let lum: f64 = 0.299 * r + 0.587 * g + 0.114 * b;
        if (lum < knee) {
            let want: f64 = floor_l + (knee - floor_l) * (lum / knee);
            let s: f64 = 1.0;
            if (lum > 0.5) { s = want / lum; } else { r = want; g = want; b = want; }
            if (lum > 0.5) { r = r * s; g = g * s; b = b * s; }
            let ir: i32 = i32(r + 0.5); let ig: i32 = i32(g + 0.5); let ib: i32 = i32(b + 0.5);
            if (ir > 255) { ir = 255; } if (ig > 255) { ig = 255; } if (ib > 255) { ib = 255; }
            ptr_write_u8(ptr_offset(vb, o, 1), ir);
            ptr_write_u8(ptr_offset(vb, o + 1, 1), ig);
            ptr_write_u8(ptr_offset(vb, o + 2, 1), ib);
            cache[i] = ir + ig * 256 + ib * 65536;
            lifted++;
        }
        i++;
    }
    let out: i32 = lifted;
    return out;
}

// ---------------------------------------------------------------------------
// THE VIEWMODEL KEY — why the weapon does not use the world's rig
// ---------------------------------------------------------------------------
// The world rig is constrained by CLAUDE.md §6: `ambient + sun` sums to exactly
// (1,1,1) so a sun-facing surface renders at its authored albedo. That is
// correct for the world and fatal for a viewmodel: with ambient at 0.42 the
// darkest face of the gun can only ever be 42 % of the brightest, so the whole
// model lives inside a ~2:1 value band and reads as one flat mass. That is
// finding 4 of the art-direction gate, and it is a LIGHTING problem, not a
// modelling one.
//
// A first-person weapon is on screen 100 % of the time, is never seen at range,
// and is never seen against itself — none of the reasons for the world's soft
// rig apply to it. So it gets its own: same HUE as the time of day (the gun
// must still go warm at golden hour and dim at night, which is what
// `p_sr..p_ab` carry), but a HARD key and a DEEP ambient, giving roughly a 9:1
// value ratio across the model instead of 2:1.
//
// The direction is in WEAPON space — the already-CANTED space the tables were
// built in — with +Y up, +Z the muzzle and +X the flank that faces the camera.
//
// The renderer places the weapon 1.05 m ahead, 0.26 m right and 0.34 m below
// the eye, so in weapon space the camera lies along (0.226, 0.296, -0.913).
// Dumping the built mesh's normal buckets against that direction gives the
// three groups the player can actually see:
//
//     n = ( 0.22,  0.96, -0.19)  top    viewdot 0.50
//     n = (-0.35, -0.10, -0.92)  rear   viewdot 0.73
//     n = ( 0.90, -0.27, -0.31)  flank  viewdot 0.41
//
// and the other three (-Y, +Z, -X) all fall out negative. The direction below
// is the solution of the 3x3 system that puts ndl 0.78 / 0.37 / 0.51 on those
// three so that every face the player sees gets SOME key and none of them is
// left on fill alone — which is what a straight-down key did, and why the first
// two attempts at this fix rendered as a flat mass.
//
// ROUND-4 CORRECTION — THE KEY WAS AIMED AT THE CULLED HEMISPHERE.
//
// Everything above is the right idea pointed 180 degrees the wrong way. The
// three faces listed above (+Y top, -Z rear, +X flank) are the three the
// rasteriser REJECTS; the drawn set is (-Y, +Z, -X). Measured, by building the
// weapon as 6-triangle shells of each set in turn and reading `tris.drawn`:
// +Y/-Z/+X gives 0 drawn and a blank screen, -Y/+Z/-X gives 120 drawn and the
// weapon. It is also what the pixels said all along: the effective vertex
// luminance the rasteriser samples, recovered per pixel by dividing the real
// render by a white-albedo calibration render, has median 72 — and 72 is what
// the -Y / +Z / -X faces bake to, while the +Y / -Z / +X set the rig was aimed
// at bakes to an area-weighted 165.
//
// So the key is negated. Nothing else about the rig changes: same 9:1 ratio,
// same exposure floor, same hue handling. Every drawn face now gets a real
// key term (ndl 0.57 / 0.65 / 0.50 on -Y / +Z / -X before the cant) instead of
// zero, which is the other half of why the weapon was a dark lump.
let g_mg_vm_lx: f64 = -0.500; let g_mg_vm_ly: f64 = -0.570; let g_mg_vm_lz: f64 = 0.652;

// The rig is specified as a VALUE RATIO, not as a pair of colours, because the
// world's ambient/sun split cannot produce one:
//
//   * `ambient + sun == (1,1,1)` caps the lit:unlit ratio at sun/ambient, which
//     is 1.4:1 at noon, and
//   * under overcast and storm keyframes the sun term collapses toward zero and
//     the ratio goes to 1:1 — a perfectly, uniformly flat gun.
//
// Here the split is fixed by ART DIRECTION and the keyframe supplies only HUE
// and exposure. VM_SHARE of the light is fill and the rest is the key.
//
// VM_SHARE IS DELIBERATELY HIGH — the weapon is mostly FILL-lit and its value
// structure comes from ALBEDO, not from surface orientation. That is the
// opposite of the obvious choice and it was arrived at by measurement:
//
//   * rendered at 320x240 the weapon is ~60x70 px, and the camera sits only
//     12 deg above it, so a top face is seen at a 78 deg grazing angle. A rig
//     that spends its whole contrast range on face orientation spends it on
//     surfaces that occupy a handful of pixels: rendering the weapon with a
//     WHITE albedo and a key straight down measured a peak of 81 out of a
//     possible 188, and the lit band was invisible in the frame.
//   * `mg_side_col` already varies value per face from the chi/lo pair, and
//     that variation is baked into the ALBEDO, so it survives regardless of
//     where the key is and regardless of which faces the camera ends up seeing.
//
// So the light supplies about 1.3x of form shading and the four slots below
// supply about 4.5x of value blocking. ART_BIBLE 8.2.5 asks for exactly this
// ("value-block every model in vertex colour"); it is also what every PS1-era
// weapon actually did, because they had no better option either.
//
// ROUND-3: 0.72 was too high. It was justified against a model whose value came
// from albedo — but the albedo split it relied on (`mg_side_col`) was being
// driven by the world sun's azimuth in weapon space, i.e. by accident, so the
// justification never held. With the split now aimed at the weapon's own key
// (g_wp_side_*), the visible flank and top both take the HIGH albedo, and if
// the light does not separate them the model is flat by construction. 0.54
// puts the top face about 1.35x the flank, which is the form shading that
// makes a box read as a box.
let g_mg_vm_share: f64 = 0.54;    // ambient share of the viewmodel's light

// EXPOSURE FLOOR. CLAUDE.md §6 promises `ambient + sun == (1,1,1)`, and at noon
// that is what arrives. Away from noon it is not: measured at the golden-hour
// keyframe the pair sums to a luminance near 0.45, which is exactly the
// too-dark-world finding the gate raised against `tod.hml`. The world can live
// with that (it is a whole-frame exposure choice and it is somebody else's file
// to fix); the VIEWMODEL cannot, because it is the player's constant reference
// object and it must stay legible in every scene, at every hour, forever.
//
// So the weapon is exposure-floored: it dims with the world down to VM_EXPO_MIN
// and no further, and it is never allowed to blow past VM_EXPO_MAX. Day/night
// variation survives as HUE (which is preserved exactly) and as the exposure
// band between the two limits, which is what stops the "full-albedo gun at
// night" bug.
// The 1.45 gain is not "make it brighter": it is calibrated so that a slot-3
// face pointing at the key CLIPS to 255 and therefore renders at the world
// atlas ceiling. That ceiling is 188 (the brightest texel in CELL_METAL_PANEL),
// which is the single hard limit on this whole task — see the task report.
// ROUND 5: the ceiling comes down from 2.25 to 2.00. The band's job is to stop
// the gun going black at night (that is VM_EXPO_MIN, unchanged) and to stop it
// blowing out under a bright sky. None of the nine scenes actually reaches the
// old 2.25 — noon lands on expo = tol * 1.90 = 1.90 exactly — but 2.25 left
// enough headroom for a hotter keyframe to push the rail back over 220, which
// is the whole failure this round is undoing. 2.00 caps the worst case at
// (2.00 / 1.78) x 186 = 209 for the rail and 184 for the body plate.
let g_mg_vm_expo_gain: f64 = 1.90;
let g_mg_vm_expo_min: f64 = 1.78;
let g_mg_vm_expo_max: f64 = 2.00;

// ---------------------------------------------------------------------------
// THE SCENE TINT — round-2 fix for "the viewmodel belongs to no scene"
// ---------------------------------------------------------------------------
// The round-1 rig set the key's hue from the SUN and the fill's hue from the
// AMBIENT, and then spent 72 % of the light on the fill. Ambient is by
// construction the complement of the sun (CLAUDE.md §8), so at golden hour the
// gun was lit 72 % by cool blue sky and 28 % by warm sun, and the average came
// out cold. Measured: median hue 224 in ridge_golden at 18:15 and 225 in
// hub_dawn at 05:30 — the same cold blue-grey to within one degree, in two
// scenes whose sun colours are nothing alike.
//
// The rig now centres BOTH terms on the scene's TOTAL light (sun + ambient),
// which is the colour the world is actually bathed in, and then pushes the key
// toward the sun and the fill toward the ambient by a fixed amount. The
// key/fill hue SPLIT that makes the shadow side read cool is preserved exactly;
// what changes is that the gun's average chromaticity is now the scene's, so it
// warms at sunset, cools at night and goes flat grey under storm, all for free.
//
// VM_TINT is how far the whole model is pulled from neutral toward the scene's
// chromaticity. 1.0 stains the gun the colour of the sky; 0.0 is the round-1
// behaviour. 0.55 is the "~0.5 strength" the gate asked for.
//
// ROUND-3 — THE INTAKE IS NOW CAPPED, NOT JUST SCALED.
// Measured over the weapon's own pixels, round 2's rig produced saturation 0.54
// (budget_worst, mean hue 221 = blue) and 0.35 (ridge_golden, mean hue 341 =
// pink) on an albedo whose saturation is 0.04. Three fractions multiplied
// together (tint x key_sun / fill_amb x whatever `tod.hml` does to the ambient)
// cannot bound anything, because `tod.hml` is free to make the ambient as
// saturated as it likes — at 05:30 it is (0.16, 0.51, 0.93), a chromaticity
// whose blue channel is 5.8x its red. So the fractions come down AND a hard cap
// is applied to the finished key and fill chromaticities: no channel of either
// may deviate from unity by more than VM_CHROMA_CAP. That is the "clamp the
// viewmodel's ambient chroma intake to at most 40 % of the world's" the critic
// asked for, expressed as something that can actually be measured on the light
// rather than as another fraction nobody can bound.
// ROUND 5 — THE CAP WAS DOING ITS JOB SO WELL THE GUN BELONGED TO NO SCENE.
//
// Round 3 set tint 0.30 with a 0.20 chroma cap, and measured on the rendered
// weapon that produced the SAME NEAR-NEUTRAL CHROME IN EVERY FRAME. Mean
// chromaticity over the weapon's own pixels, normalized to unit mean:
//
//     scene           scene light          weapon (round 4)
//     ridge_golden    1.351 0.919 0.730    1.111 0.975 0.914
//     hub_dawn        0.907 0.902 1.191    1.004 0.968 1.028
//     ns_bloom        1.178 0.347 1.475    1.052 0.902 1.046
//     storm_assault   0.825 1.030 1.145    0.956 0.996 1.048
//     noon            1.000 1.000 1.000    1.015 0.989 0.996
//
// Four scenes whose light ranges from orange through violet to storm-grey, and
// the gun is within 0.09 of neutral in all of them — which is exactly the "it
// reads as a toy pasted on the world" finding. The cap is bounding the KEY and
// FILL chromaticities, so the fix is to raise the cap and the tint together;
// the cap still exists to stop `tod.hml`'s 5.8:1 dawn ambient from staining the
// weapon outright, and 0.24 is the deviation a hand-held metal object plausibly
// picks up from a coloured sky.
//
// key_sun goes 0.34 -> 0.45 and fill_amb 0.20 -> 0.16 in the same pass: the
// weapon should take the KEY light's colour (the task's word), so the warm/cool
// split across the model widens while its average stays on the scene tint.
//
// Measured after (same rows): ridge 1.220 0.961 0.819, hub_dawn 1.022 0.934
// 1.044, ns_bloom 1.101 0.815 1.084, storm 0.929 1.007 1.064, noon 1.049 1.009
// 0.943 — about 45 % of the way from neutral to the scene light, in the right
// direction in all seven scenes, and still under half the world's saturation.
let g_mg_vm_tint: f64 = 0.48;
let g_mg_vm_key_sun: f64 = 0.45;   // key pushed from the scene tint toward the sun
let g_mg_vm_fill_amb: f64 = 0.16;  // fill pushed from the scene tint toward ambient
let g_mg_vm_chroma_cap: f64 = 0.24;

// The joint chroma limiter. Takes a triple already normalized to unit luminance
// and returns the scale to apply to (c - 1) so that no channel deviates from
// neutral by more than the cap. Scaling all three by the same factor preserves
// hue exactly and shrinks only saturation.
fn mg_dev_k(p_r: f64, p_g: f64, p_b: f64, p_cap: f64): f64 {
    let mx: f64 = p_r - 1.0;  if (mx < 0.0) { mx = 0.0 - mx; }
    let dg: f64 = p_g - 1.0;  if (dg < 0.0) { dg = 0.0 - dg; }
    let db: f64 = p_b - 1.0;  if (db < 0.0) { db = 0.0 - db; }
    if (dg > mx) { mx = dg; }
    if (db > mx) { mx = db; }
    let k: f64 = 1.0;
    if (mx > p_cap) { k = p_cap / mx; }
    let out: f64 = k;
    return out;
}

// Re-light every mesh. `tod.hml` may call this when the keyframe moves far
// enough to matter; it is a build-time cost, not a frame cost, and it is the
// ONLY thing in the whole game that transforms a mesh normal.
export fn meshgen_bake_all(p_lx: f64, p_ly: f64, p_lz: f64,
                           p_sr: f64, p_sg: f64, p_sb: f64,
                           p_ar: f64, p_ag: f64, p_ab: f64,
                           p_br: f64, p_bg: f64, p_bb: f64): i32 {
    // ---- chromaticities, each normalized to unit luminance -----------------
    let tor: f64 = p_sr + p_ar; let tog: f64 = p_sg + p_ag; let tob: f64 = p_sb + p_ab;
    let tol: f64 = 0.299 * tor + 0.587 * tog + 0.114 * tob;
    if (tol < 0.0001) { tor = 1.0; tog = 1.0; tob = 1.0; tol = 1.0; }
    let sunl: f64 = 0.299 * p_sr + 0.587 * p_sg + 0.114 * p_sb;
    let snr: f64 = 1.0; let sng: f64 = 1.0; let snb: f64 = 1.0;
    if (sunl > 0.0001) { snr = p_sr / sunl; sng = p_sg / sunl; snb = p_sb / sunl; }
    let ambl: f64 = 0.299 * p_ar + 0.587 * p_ag + 0.114 * p_ab;
    let anr: f64 = 1.0; let ang: f64 = 1.0; let anb: f64 = 1.0;
    if (ambl > 0.0001) { anr = p_ar / ambl; ang = p_ag / ambl; anb = p_ab / ambl; }

    // ---- the ground-decal shadow ------------------------------------------
    // Direction: straight away from the sun's horizontal bearing.
    let hl: f64 = sqrt(p_lx * p_lx + p_lz * p_lz);
    if (hl > 0.0001) {
        g_mg_sh_dx = 0.0 - p_lx / hl;
        g_mg_sh_dz = 0.0 - p_lz / hl;
    }
    // Length: cot(sun elevation), clamped. A sun overhead casts a shadow the
    // width of the prop; a sun on the horizon casts one 2.6x as long, which is
    // where the golden-hour rake comes from.
    let ely: f64 = p_ly;
    if (ely < 0.0) { ely = 0.0 - ely; }
    if (ely < 0.02) { ely = 0.02; }
    let cot: f64 = hl / ely;
    let shl: f64 = g_mg_sh_len_min + cot * 0.55;
    if (shl > g_mg_sh_len_max) { shl = g_mg_sh_len_max; }
    if (shl < g_mg_sh_len_min) { shl = g_mg_sh_len_min; }
    g_mg_sh_len = shl;
    // Colour: a shadow is THE SAME GROUND receiving the ambient and none of the
    // sun. So it is (ground albedo chromaticity) x (ambient), not (ambient)
    // alone — the round-2 version dropped the ground term entirely and that is
    // why it read as a differently-coloured patch rather than as a dark patch.
    // The ground's chromaticity is the BOUNCE's: the bounce IS the light the
    // ground throws back, so it carries the ground albedo's hue by definition.
    let bl: f64 = 0.299 * p_br + 0.587 * p_bg + 0.114 * p_bb;
    let gnr: f64 = 1.0; let gng: f64 = 1.0; let gnb: f64 = 1.0;
    if (bl > 0.0001) { gnr = p_br / bl; gng = p_bg / bl; gnb = p_bb / bl; }
    let sur: f64 = 1.0 + (gnr - 1.0) * g_mg_sh_ground;
    let sug: f64 = 1.0 + (gng - 1.0) * g_mg_sh_ground;
    let sub: f64 = 1.0 + (gnb - 1.0) * g_mg_sh_ground;
    let lir: f64 = 1.0 + (anr - 1.0) * g_mg_sh_sky;
    let lig: f64 = 1.0 + (ang - 1.0) * g_mg_sh_sky;
    let lib: f64 = 1.0 + (anb - 1.0) * g_mg_sh_sky;
    let cr2: f64 = sur * lir; let cg2: f64 = sug * lig; let cb2: f64 = sub * lib;
    let cl2: f64 = 0.299 * cr2 + 0.587 * cg2 + 0.114 * cb2;
    if (cl2 < 0.0001) { cr2 = 1.0; cg2 = 1.0; cb2 = 1.0; cl2 = 1.0; }
    // The level: what an open patch of this ground renders at under ambient
    // alone, times the occlusion of the two ends of the kite.
    let shk: f64 = 255.0 * ambl / cl2;
    g_mg_sh_r = mg_clamp255(shk * cr2 * g_mg_sh_occ_core);
    g_mg_sh_g = mg_clamp255(shk * cg2 * g_mg_sh_occ_core);
    g_mg_sh_b = mg_clamp255(shk * cb2 * g_mg_sh_occ_core);
    g_mg_sh_tr = mg_clamp255(shk * cr2 * g_mg_sh_occ_tail);
    g_mg_sh_tg = mg_clamp255(shk * cg2 * g_mg_sh_occ_tail);
    g_mg_sh_tb = mg_clamp255(shk * cb2 * g_mg_sh_occ_tail);
    let bm = g_mg_mesh[MESH_BLOB];
    mesh_begin(bm);
    build_blob(bm);
    mesh_end(bm);

    // ---- the viewmodel rig: keyframe HUE, art-directed RATIO ---------------
    // exposure: track the world, but only inside the legibility band
    let expo: f64 = tol * g_mg_vm_expo_gain;
    if (expo < g_mg_vm_expo_min) { expo = g_mg_vm_expo_min; }
    if (expo > g_mg_vm_expo_max) { expo = g_mg_vm_expo_max; }
    // The scene tint: the world's own light chromaticity, pulled part-way back
    // to neutral so the weapon is TINTED by the hour, not painted with it.
    let ctr: f64 = 1.0 + (tor / tol - 1.0) * g_mg_vm_tint;
    let ctg: f64 = 1.0 + (tog / tol - 1.0) * g_mg_vm_tint;
    let ctb: f64 = 1.0 + (tob / tol - 1.0) * g_mg_vm_tint;
    // key hue: the scene tint pushed toward the sun. Normalized to unit
    // luminance so only the ratio below sets value.
    let kr: f64 = ctr * (1.0 + (snr - 1.0) * g_mg_vm_key_sun);
    let kg: f64 = ctg * (1.0 + (sng - 1.0) * g_mg_vm_key_sun);
    let kb: f64 = ctb * (1.0 + (snb - 1.0) * g_mg_vm_key_sun);
    let kl: f64 = 0.299 * kr + 0.587 * kg + 0.114 * kb;
    if (kl < 0.0001) { kr = 1.0; kg = 1.0; kb = 1.0; kl = 1.0; }
    // normalize to unit luminance, then cap the chroma
    kr = kr / kl; kg = kg / kl; kb = kb / kl;
    let kk: f64 = mg_dev_k(kr, kg, kb, g_mg_vm_chroma_cap);
    kr = 1.0 + (kr - 1.0) * kk;
    kg = 1.0 + (kg - 1.0) * kk;
    kb = 1.0 + (kb - 1.0) * kk;
    kl = 0.299 * kr + 0.587 * kg + 0.114 * kb;
    if (kl < 0.0001) { kr = 1.0; kg = 1.0; kb = 1.0; kl = 1.0; }
    let ks: f64 = expo * (1.0 - g_mg_vm_share) / kl;
    // fill hue: the scene tint pushed toward the ambient, likewise
    let fr: f64 = ctr * (1.0 + (anr - 1.0) * g_mg_vm_fill_amb);
    let fg: f64 = ctg * (1.0 + (ang - 1.0) * g_mg_vm_fill_amb);
    let fb: f64 = ctb * (1.0 + (anb - 1.0) * g_mg_vm_fill_amb);
    let fl: f64 = 0.299 * fr + 0.587 * fg + 0.114 * fb;
    if (fl < 0.0001) { fr = 1.0; fg = 1.0; fb = 1.0; fl = 1.0; }
    fr = fr / fl; fg = fg / fl; fb = fb / fl;
    let fk: f64 = mg_dev_k(fr, fg, fb, g_mg_vm_chroma_cap);
    fr = 1.0 + (fr - 1.0) * fk;
    fg = 1.0 + (fg - 1.0) * fk;
    fb = 1.0 + (fb - 1.0) * fk;
    fl = 0.299 * fr + 0.587 * fg + 0.114 * fb;
    if (fl < 0.0001) { fr = 1.0; fg = 1.0; fb = 1.0; fl = 1.0; }
    let fs: f64 = expo * g_mg_vm_share / fl;
    let vkr: f64 = kr * ks; let vkg: f64 = kg * ks; let vkb: f64 = kb * ks;
    let var2: f64 = fr * fs; let vag: f64 = fg * fs; let vab: f64 = fb * fs;
    let total: i32 = 0;
    let i: i32 = 0;
    while (i < MESH_COUNT) {
        let m = g_mg_mesh[i];
        if (g_mg_kind[i] == MG_KIND_DECAL) {
            // never baked, never lifted — the colour was written above
        } else if (g_mg_kind[i] == MG_KIND_WEAPON) {
            total = total + mesh_bake_light(m, g_mg_vm_lx, g_mg_vm_ly, g_mg_vm_lz,
                                            vkr, vkg, vkb,
                                            var2, vag, vab,
                                            p_br, p_bg, p_bb);
            mg_lift_floor(m, f64(MG_VM_LUM_FLOOR), g_mg_vm_lum_knee);
            // The lantern's flame is a SOURCE, not a receiver: its vertices are
            // written last, as final bytes, so the lamp does not go out at
            // midnight and does not blow out at noon. `kr/kg/kb` is the key
            // chromaticity — already unit-luminance and chroma-capped above —
            // and only 14 % of it reaches the flame.
            if (i == MESH_LANTERN_VM) { mg_lamp_emissive(m, kr, kg, kb); }
        } else {
            total = total + mesh_bake_light(m, p_lx, p_ly, p_lz,
                                            p_sr, p_sg, p_sb,
                                            p_ar, p_ag, p_ab,
                                            p_br, p_bg, p_bb);
            mg_lift_floor(m, f64(MG_LUM_FLOOR), g_mg_lum_knee);
        }
        i++;
    }
    let out: i32 = total;
    return out;
}

// ===========================================================================
// meshgen_build_all — the whole asset library, ~40 meshes, once, at boot
// ===========================================================================

fn mg_measure_class(p_class: i32, p_id: i32, p_before_v: i32) {
    // The signature protrusion is always the last thing a class builder adds,
    // so "how far does the mesh reach beyond the body it had before the
    // protrusion" is measurable rather than asserted. ART_BIBLE 8.2.3.
    let m = g_mg_mesh[p_id];
    let n: i32 = mesh_vert_count(m);
    let x0: f64 = 0.0; let x1: f64 = 0.0;
    let y0: f64 = 0.0; let y1: f64 = 0.0;
    let z0: f64 = 0.0; let z1: f64 = 0.0;
    let i: i32 = 0;
    while (i < p_before_v) {
        let x: f64 = mesh_vert_pos(m, i, 0);
        let y: f64 = mesh_vert_pos(m, i, 1);
        let z: f64 = mesh_vert_pos(m, i, 2);
        if (i == 0) { x0 = x; x1 = x; y0 = y; y1 = y; z0 = z; z1 = z; }
        if (x < x0) { x0 = x; } if (x > x1) { x1 = x; }
        if (y < y0) { y0 = y; } if (y > y1) { y1 = y; }
        if (z < z0) { z0 = z; } if (z > z1) { z1 = z; }
        i++;
    }
    let best: f64 = 0.0;
    i = p_before_v;
    while (i < n) {
        let x: f64 = mesh_vert_pos(m, i, 0);
        let y: f64 = mesh_vert_pos(m, i, 1);
        let z: f64 = mesh_vert_pos(m, i, 2);
        let d: f64 = 0.0;
        if (x0 - x > d) { d = x0 - x; }
        if (x - x1 > d) { d = x - x1; }
        if (y0 - y > d) { d = y0 - y; }
        if (y - y1 > d) { d = y - y1; }
        if (z0 - z > d) { d = z0 - z; }
        if (z - z1 > d) { d = z - z1; }
        if (d > best) { best = d; }
        i++;
    }
    g_mg_prot_len[p_class] = best;
}

fn mg_finish(p_id: i32) {
    mesh_end(g_mg_mesh[p_id]);
}

export fn meshgen_build_all(): i32 {
    g_mg_mesh = []; g_mg_name = []; g_mg_budget = [];
    g_mg_kind = []; g_mg_view = [];
    let i: i32 = 0;
    while (i < MESH_COUNT) {
        g_mg_mesh.push(0); g_mg_name.push(""); g_mg_budget.push(0);
        g_mg_kind.push(0); g_mg_view.push(0.0);
        i++;
    }
    g_mg_head_w = []; g_mg_sh_w = []; g_mg_prot_len = []; g_mg_prot_axis = [];
    i = 0;
    while (i < ENEMY_COUNT) {
        g_mg_head_w.push(g_hu_head_hw[i] * 2.0);
        g_mg_sh_w.push(g_hu_sh_hw[i] * 2.0);
        g_mg_prot_len.push(0.0);
        g_mg_prot_axis.push(g_hu_axis[i]);
        i++;
    }

    // The two viewmodel materials are texel windows inside the cells the
    // harness bound to MG_MAT_METAL and MG_MAT_SPEC, resolved HERE — after
    // `art_bind_materials` has run and before a single weapon vertex is
    // written. See the MG_MAT_VMSKIN block at the top of this file for the
    // atlas measurements that chose these two rectangles.
    mg_uv_window(MG_MAT_VMSKIN, MG_MAT_METAL, 10.0, 4.0, 17.0, 11.0);
    mg_uv_window(MG_MAT_VMRAIL, MG_MAT_SPEC,  22.0, 2.0, 29.0,  3.0);

    let three_q: f64 = 0.62;      // 3/4 view for props and characters
    let side: f64 = 1.5708;       // weapons read side-on

    // ---- props ----------------------------------------------------------
    mg_register(MESH_TREE0,   "tree_lod0",  96, MG_KIND_PROP, three_q, 128);
    mg_register(MESH_TREE1,   "tree_lod1",  30, MG_KIND_PROP, three_q, 64);
    mg_register(MESH_TREE2,   "tree_lod2",   8, MG_KIND_PROP, three_q, 16);
    mg_register(MESH_BUSH,    "bush",       22, MG_KIND_PROP, three_q, 48);
    mg_register(MESH_ROCK,    "rock",       18, MG_KIND_PROP, three_q, 32);
    mg_register(MESH_CRATE,   "crate",      12, MG_KIND_PROP, three_q, 24);
    mg_register(MESH_BARREL,  "barrel",     24, MG_KIND_PROP, three_q, 40);
    mg_register(MESH_LANTERN, "lantern",    48, MG_KIND_PROP, three_q, 72);
    mg_register(MESH_BLOB,    "contact_blob", 2, MG_KIND_DECAL, 0.0, 4);

    mesh_begin(g_mg_mesh[MESH_TREE0]);   build_tree0(g_mg_mesh[MESH_TREE0], 3);   mg_finish(MESH_TREE0);
    mesh_begin(g_mg_mesh[MESH_TREE1]);   build_tree1(g_mg_mesh[MESH_TREE1], 3);   mg_finish(MESH_TREE1);
    mesh_begin(g_mg_mesh[MESH_TREE2]);   build_tree2(g_mg_mesh[MESH_TREE2], 3);   mg_finish(MESH_TREE2);
    mesh_begin(g_mg_mesh[MESH_BUSH]);    build_bush(g_mg_mesh[MESH_BUSH], 9);     mg_finish(MESH_BUSH);
    mesh_begin(g_mg_mesh[MESH_ROCK]);    build_rock(g_mg_mesh[MESH_ROCK], 17);    mg_finish(MESH_ROCK);
    mesh_begin(g_mg_mesh[MESH_CRATE]);   build_crate(g_mg_mesh[MESH_CRATE]);      mg_finish(MESH_CRATE);
    mesh_begin(g_mg_mesh[MESH_BARREL]);  build_barrel(g_mg_mesh[MESH_BARREL], 23); mg_finish(MESH_BARREL);
    mesh_begin(g_mg_mesh[MESH_LANTERN]); build_lantern(g_mg_mesh[MESH_LANTERN]);  mg_finish(MESH_LANTERN);
    mesh_begin(g_mg_mesh[MESH_BLOB]);    build_blob(g_mg_mesh[MESH_BLOB]);        mg_finish(MESH_BLOB);

    // ---- enemies --------------------------------------------------------
    let names: array<string> = ["wisp", "mote", "husk", "spitter", "warden", "bulwark"];
    let bud0: array<i32> = [24, 32, 180, 180, 180, 180];
    let bud1: array<i32> = [12, 16, 90, 90, 90, 90];
    // 28 -> 30 for the four humanoids: the 2-triangle NS_HALO chest panel is
    // now on every tier. ART_BIBLE 8.3's "28" was written before the violet
    // was measured as the only surviving hostile cue at 10 px.
    let bud2: array<i32> = [6, 8, 30, 30, 30, 30];
    let cls: i32 = 0;
    while (cls < ENEMY_COUNT) {
        let lod: i32 = 0;
        while (lod < 3) {
            let id: i32 = MESH_WISP0 + cls * 3 + lod;
            let bud: i32 = bud0[cls];
            if (lod == 1) { bud = bud1[cls]; }
            if (lod == 2) { bud = bud2[cls]; }
            mg_register(id, names[cls] + "_lod" + lod, bud, MG_KIND_ENEMY,
                        three_q, bud * 2 + 24);
            let m = g_mg_mesh[id];
            mesh_begin(m);
            if (cls == ENEMY_WISP) {
                build_wisp(m, lod);
            } else {
                if (cls == ENEMY_MOTE) {
                    build_mote(m, lod);
                } else {
                    build_humanoid(m, cls, lod);
                }
            }
            // measure the protrusion off the LOD0 mesh only
            if (lod == 0) {
                mg_measure_class(cls, id, mesh_vert_count(m) - 12);
            }
            mg_finish(id);
            lod++;
        }
        cls++;
    }

    // ---- the villager, three LODs ----------------------------------------
    // 220 / 42 / 12. Ten villagers used to be 2200 triangles — the whole steady
    // budget — because there was only ever the first number.
    mg_register(MESH_NPC0, "npc",      220, MG_KIND_NPC, three_q, 260);
    mg_register(MESH_NPC1, "npc_lod1",  42, MG_KIND_NPC, three_q, 64);
    mg_register(MESH_NPC2, "npc_lod2",  12, MG_KIND_NPC, three_q, 24);
    let nl: i32 = 0;
    while (nl < 3) {
        let nid: i32 = MESH_NPC0 + nl;
        mesh_begin(g_mg_mesh[nid]);
        build_npc(g_mg_mesh[nid], nl);
        mg_finish(nid);
        nl++;
    }

    // ---- viewmodels -----------------------------------------------------
    // 20 parts x 6 tris. `mg_vm_shell` deletes the three faces a viewmodel can
    // never turn toward the eye, so the budget is 120 submitted rather than 240
    // submitted / 120 drawn. The cap stays generous for a future weapon with
    // more parts; the round-4 task ceiling is 140.
    //
    // Slot 28 is the LANTERN and it is the only one the renderer is ever
    // handed. 16 shells at 6 (96) + the 3x3 halo grid (8) + the 4x4 flame grid
    // (18) = 122 triangles. The registered budget is 120 because
    // `tools/meshgen.hml --verify` asserts +-10 % of it; the task ceiling is
    // 140, so there are 24 triangles of real headroom above the gate.
    mg_register(MESH_LANTERN_VM,    "lantern_vm",    120, MG_KIND_WEAPON, side, 176);
    mg_register(MESH_TINKER_VM,     "tinker_vm",     120, MG_KIND_WEAPON, side, 160);
    mg_register(MESH_BELLOWS_VM,    "bellows_vm",    120, MG_KIND_WEAPON, side, 160);
    mg_register(MESH_LONGSHADOW_VM, "longshadow_vm", 120, MG_KIND_WEAPON, side, 160);
    mg_register(MESH_KESTREL_VM,    "kestrel_vm",    120, MG_KIND_WEAPON, side, 160);
    mg_register(MESH_EMBERLANCE_VM, "emberlance_vm", 120, MG_KIND_WEAPON, side, 160);
    let w: i32 = MESH_LANTERN_VM;
    while (w <= MESH_EMBERLANCE_VM) {
        mesh_begin(g_mg_mesh[w]);
        if (w == MESH_LANTERN_VM) {
            build_lantern_vm(g_mg_mesh[w]);
        } else {
            build_weapon(g_mg_mesh[w], w);
        }
        mg_finish(w);
        w++;
    }

    // ---- light it, once -------------------------------------------------
    meshgen_bake_all(g_mg_sun_x, g_mg_sun_y, g_mg_sun_z,
                     g_mg_sun_r, g_mg_sun_g, g_mg_sun_b,
                     g_mg_amb_r, g_mg_amb_g, g_mg_amb_b,
                     g_mg_bnc_r, g_mg_bnc_g, g_mg_bnc_b);

    g_mg_built = 1;
    let total: i32 = 0;
    i = 0;
    while (i < MESH_COUNT) { total = total + mesh_tri_count(g_mg_mesh[i]); i++; }
    let out: i32 = total;
    return out;
}
