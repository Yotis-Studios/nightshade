// ===========================================================================
// SELF-TEST
//
// W2-3 owns exactly one file, so the verification program lives here and
// `tools/probe_palette.hml` is a four-line driver around it. Everything in this
// section is COLD — array literals, template strings and string arrays are all
// fine here and are all banned from anything per-frame.
//
// `pal_selftest()` returns the number of FAILED assertions, and additionally
// fails if the number of assertions it *ran* is not exactly
// `g_PAL_SELFTEST_ASSERTS`: a self-test that silently skips a section must go
// red, not green.
// ===========================================================================

export let g_PAL_SELFTEST_ASSERTS : i32 = 122;

let g_pal_pass  : i32 = 0;
let g_pal_total : i32 = 0;

fn pal_ok(p_what: string, p_cond: bool) {
    g_pal_total = g_pal_total + 1;
    if (p_cond) {
        g_pal_pass = g_pal_pass + 1;
    } else {
        print(`  FAIL ${p_what}`);
    }
}

fn pal_eqi(p_what: string, p_got: i32, p_want: i32) {
    g_pal_total = g_pal_total + 1;
    if (p_got == p_want) {
        g_pal_pass = g_pal_pass + 1;
    } else {
        print(`  FAIL ${p_what}: got ${p_got}, want ${p_want}`);
    }
}

// A channel is "round" if it is a multiple of 10 or of 16 — the two ways a
// human types a number instead of choosing one (ART_BIBLE §13.4). 255 is
// deliberately NOT round: it is the ceiling of the format, not a typed value,
// and every emissive in ATLAS_FX legitimately pins a channel there.
fn pal_is_round(p_v: i32): i32 {
    let v: i32 = p_v;
    let out: i32 = 0;
    if (v % 10 == 0) { out = 1; }
    if (v % 16 == 0) { out = 1; }
    return out;
}

// The untinted-colour tell: two equal channels, or all three round.
fn pal_is_untinted(p_c: i32): i32 {
    let c: i32 = p_c;
    let r: i32 = (c >> 16) & 255;
    let g: i32 = (c >> 8) & 255;
    let b: i32 = c & 255;
    let out: i32 = 0;
    if (r == g) { out = 1; }
    if (g == b) { out = 1; }
    if (r == b) { out = 1; }
    if (pal_is_round(r) == 1 && pal_is_round(g) == 1 && pal_is_round(b) == 1) { out = 1; }
    return out;
}

// ---------------------------------------------------------------------------
// THE THREE TINT-LAW EXEMPTIONS. There are exactly three colours in the whole
// table with two equal channels, and all three earn it:
//
//   STAR_BRIGHT #FFFFF0 (255,255,240)  a star is a blackbody point source; the
//                                      only tint it may carry is the 15-unit
//                                      warm drop in blue that keeps it off
//                                      #FFFFFF.
//   UI_WHITE    #F4F4EC (244,244,236)  HUD text is not a surface. It must read
//                                      identically over noon sky, snow, a
//                                      muzzle flash and CONCRETE_HI; any hue
//                                      lean makes it disappear over one of them.
//   BLOOD_FRESH #B41E1E (180,30,30)    the game's one intentionally primal
//                                      colour, and the only entry that is also
//                                      all-round-channels.
//
// The ART_BIBLE's acceptance text calls these "the three explicitly exempt UI
// colours"; only one of the three is actually UI. The COUNT is right, the noun
// is not — recorded here rather than silently reinterpreted.
// ---------------------------------------------------------------------------
fn pal_is_tint_exempt(p_c: i32): i32 {
    let c: i32 = p_c;
    let out: i32 = 0;
    if (c == 0xFFFFF0) { out = 1; }   // STAR_BRIGHT
    if (c == 0xF4F4EC) { out = 1; }   // UI_WHITE
    if (c == 0xB41E1E) { out = 1; }   // BLOOD_FRESH
    return out;
}

// ---------------------------------------------------------------------------
// THE WORLD-LUMINANCE WAIVER — a real, reported gap, not a fudge.
//
// ART_BIBLE §2.1 says no ATLAS_WORLD albedo may fall below luminance 72.
// Three §3 values do, by 1.2 to 4.2 units under the document's own Rec.601
// metric:
//        BARK_LO   #5A422C  70
//        RUST_DARK #6E3A22  70
//        WOOD_LO   #584022  67
// These are transcribed EXACTLY as authored — "if the code disagrees with this
// document, the code is wrong" — and the discrepancy is reported upward rather
// than quietly rounded away. All three are the darkest step of a ramp whose
// other steps clear the bar comfortably, and all three clear a max-channel
// reading of 72 (90, 110, 88), so the practical risk is small: at the 0.14
// night ambient floor they land at luminance 9-10 instead of 10-11.
// The self-test asserts the hard floor they DO meet (>= 67) and asserts that
// the set of sub-72 world albedos is exactly these three, so a fourth one
// appearing later goes red immediately.
// ---------------------------------------------------------------------------
fn pal_is_lum_waived(p_c: i32): i32 {
    let c: i32 = p_c;
    let out: i32 = 0;
    if (c == 0x5A422C) { out = 1; }   // BARK_LO
    if (c == 0x6E3A22) { out = 1; }   // RUST_DARK
    if (c == 0x584022) { out = 1; }   // WOOD_LO
    return out;
}

fn pal_test_functions() {
    print("  [1] unpackers, constructors, blend, luminance");
    pal_eqi("pal_r(GRASS_MID)", pal_r(g_GRASS_MID), 122);
    pal_eqi("pal_g(GRASS_MID)", pal_g(g_GRASS_MID), 150);
    pal_eqi("pal_b(GRASS_MID)", pal_b(g_GRASS_MID), 54);
    pal_eqi("pal_r(NS_CORE)", pal_r(g_NS_CORE), 199);
    pal_eqi("pal_g(NS_CORE)", pal_g(g_NS_CORE), 79);
    pal_eqi("pal_b(NS_CORE)", pal_b(g_NS_CORE), 255);
    pal_eqi("pal_pack round-trips GRASS_MID", pal_pack(122, 150, 54), g_GRASS_MID);
    pal_eqi("pal_pack clamps high", pal_pack(999, 300, 256), 0xFFFFFF);
    pal_eqi("pal_pack clamps low", pal_pack(0 - 5, 0 - 1, 0 - 999), 0x000000);
    pal_eqi("pal_lerp t=0 is exactly a", pal_lerp(g_GRASS_HI, g_GRASS_LO, 0.0), g_GRASS_HI);
    pal_eqi("pal_lerp t=1 is exactly b", pal_lerp(g_GRASS_HI, g_GRASS_LO, 1.0), g_GRASS_LO);
    pal_eqi("pal_lerp clamps t<0", pal_lerp(g_GRASS_HI, g_GRASS_LO, 0.0 - 3.0), g_GRASS_HI);
    pal_eqi("pal_lerp clamps t>1", pal_lerp(g_GRASS_HI, g_GRASS_LO, 4.0), g_GRASS_LO);
    // (159,184,74) -> (81,99,39) at 0.5 rounds to (120,142,57) = 0x788E39
    pal_eqi("pal_lerp midpoint rounds half up", pal_lerp(g_GRASS_HI, g_GRASS_LO, 0.5), 0x788E39);
    pal_eqi("pal_lerp is symmetric at the ends", pal_lerp(g_NS_DEEP, g_NS_HALO, 1.0), g_NS_HALO);
    pal_eqi("pal_lerp_q q=0 is exactly a", pal_lerp_q(g_GRASS_HI, g_GRASS_LO, 0), g_GRASS_HI);
    pal_eqi("pal_lerp_q q=256 is exactly b", pal_lerp_q(g_GRASS_HI, g_GRASS_LO, 256), g_GRASS_LO);
    pal_eqi("pal_lerp_q q=128 agrees with pal_lerp t=0.5",
            pal_lerp_q(g_GRASS_HI, g_GRASS_LO, 128), pal_lerp(g_GRASS_HI, g_GRASS_LO, 0.5));
    pal_eqi("pal_lerp_q clamps q<0", pal_lerp_q(g_NS_DEEP, g_NS_HALO, 0 - 90), g_NS_DEEP);
    pal_eqi("pal_lerp_q clamps q>256", pal_lerp_q(g_NS_DEEP, g_NS_HALO, 9999), g_NS_HALO);
    pal_eqi("pal_lum(GRASS_MID)", pal_lum(g_GRASS_MID), 131);
    pal_eqi("pal_lum(UI_BLACK)", pal_lum(g_UI_BLACK), 11);
    pal_eqi("pal_lum of pure white saturates at 255", pal_lum(0xFFFFFF), 255);
    pal_eqi("pal_lum of black is 0", pal_lum(0x000000), 0);
    pal_eqi("pal_is_round(240)", pal_is_round(240), 1);
    pal_eqi("pal_is_round(255) is 0 by design", pal_is_round(255), 0);
    pal_eqi("pal_is_untinted flags equal channels", pal_is_untinted(0x808080), 1);
    pal_eqi("pal_is_untinted passes GRASS_MID", pal_is_untinted(g_GRASS_MID), 0);
}

fn pal_test_table() {
    print("  [2] table integrity");
    let vals: array<i32> = pal_table();
    let names: array<string> = pal_names();
    let fams: array<i32> = pal_families();
    let n: i32 = vals.length;
    pal_eqi("pal_table length == g_PAL_COUNT", n, g_PAL_COUNT);
    pal_eqi("pal_names length == g_PAL_COUNT", names.length, g_PAL_COUNT);
    pal_eqi("pal_families length == g_PAL_COUNT", fams.length, g_PAL_COUNT);

    let out_of_range: i32 = 0;
    let bad_family: i32 = 0;
    let empty_name: i32 = 0;
    for (let i = 0; i < n; i++) {
        let c: i32 = vals[i];
        if (c < 0 || c > 0xFFFFFF) { out_of_range++; }
        if (fams[i] < 0 || fams[i] >= g_PAL_FAM_COUNT) { bad_family++; }
        if (names[i].length < 2) { empty_name++; }
    }
    pal_eqi("every colour fits 0x000000..0xFFFFFF", out_of_range, 0);
    pal_eqi("every family id is in range", bad_family, 0);
    pal_eqi("every entry is named", empty_name, 0);

    // Family census — the ART_BIBLE section sizes, so a dropped row is caught.
    let census: array<i32> = [];
    for (let f = 0; f < g_PAL_FAM_COUNT; f++) { census.push(0); }
    for (let i = 0; i < n; i++) { census[fams[i]] = census[fams[i]] + 1; }
    pal_eqi("§3.2 SKY has 12", census[g_PAL_FAM_SKY], 12);
    pal_eqi("§3.3 TERRAIN has 12", census[g_PAL_FAM_TERRAIN], 12);
    pal_eqi("§3.4 FOLIAGE has 10", census[g_PAL_FAM_FOLIAGE], 10);
    pal_eqi("§3.5 STONE has 11", census[g_PAL_FAM_STONE], 11);
    pal_eqi("§3.6 WOOD has 8", census[g_PAL_FAM_WOOD], 8);
    pal_eqi("§3.7 METAL has 8", census[g_PAL_FAM_METAL], 8);
    pal_eqi("§3.8 NIGHTSHADE has 6", census[g_PAL_FAM_NIGHTSHADE], 6);
    pal_eqi("§3.9 FX has 10", census[g_PAL_FAM_FX], 10);
    pal_eqi("§3.10 BLOOD has 4", census[g_PAL_FAM_BLOOD], 4);
    pal_eqi("§3.11 UI has 7", census[g_PAL_FAM_UI], 7);
    pal_eqi("§5.1 TOD_SKY has 5 rows x 7 keyframes", census[g_PAL_FAM_TOD_SKY], 35);
    pal_eqi("§4.4 EMISSIVE has 1", census[g_PAL_FAM_EMISSIVE], 1);
    pal_eqi("§13.7 DEBUG has 1", census[g_PAL_FAM_DEBUG], 1);
}

fn pal_test_tint_law() {
    print("  [3] the untinted-colour law (ART_BIBLE §3.1, §13.4)");
    let vals: array<i32> = pal_table();
    let names: array<string> = pal_names();
    let n: i32 = vals.length;
    let violations: i32 = 0;
    let exempt_seen: i32 = 0;
    for (let i = 0; i < n; i++) {
        let c: i32 = vals[i];
        if (pal_is_untinted(c) == 1) {
            if (pal_is_tint_exempt(c) == 1) {
                exempt_seen++;
                print(`    exempt (documented): ${names[i]}`);
            } else {
                violations++;
                print(`    UNTINTED: ${names[i]} = ${c}`);
            }
        }
    }
    pal_eqi("no untinted colour outside the exemption list", violations, 0);
    pal_eqi("all three documented exemptions are present and used", exempt_seen, 3);
    pal_ok("CLOUD_LIT is a warm white, never #FFFFFF (ART_BIBLE §3.2)",
           g_CLOUD_LIT != 0xFFFFFF && pal_b(g_CLOUD_LIT) < pal_r(g_CLOUD_LIT));

    // The named pure-hue traps from ART_BIBLE §3.1 / §13.4.
    let traps: array<i32> = [0x000000, 0xFFFFFF, 0xFF0000, 0x00FF00, 0x0000FF,
                             0x808080, 0x008000, 0xFF00FF];
    let hits: i32 = 0;
    for (let t = 0; t < traps.length; t++) {
        for (let i = 0; i < n; i++) { if (vals[i] == traps[t]) { hits++; } }
    }
    pal_eqi("no pure hue, no pure grey, no pure white or black in the table", hits, 0);
}

fn pal_test_world_luminance() {
    print("  [4] ATLAS_WORLD albedo luminance >= 72 (ART_BIBLE §2.1 / Rule T1)");
    let vals: array<i32> = pal_table();
    let names: array<string> = pal_names();
    let fams: array<i32> = pal_families();
    let n: i32 = vals.length;
    let world: i32 = 0;
    let below72: i32 = 0;
    let waived: i32 = 0;
    let below67: i32 = 0;
    let minlum: i32 = 255;
    for (let i = 0; i < n; i++) {
        let f: i32 = fams[i];
        if (f >= g_PAL_FAM_TERRAIN && f <= g_PAL_FAM_METAL) {
            world++;
            let l: i32 = pal_lum(vals[i]);
            if (l < minlum) { minlum = l; }
            if (l < 72) {
                below72++;
                if (pal_is_lum_waived(vals[i]) == 1) {
                    waived++;
                    print(`    WAIVED (ART_BIBLE value, reported upward): ${names[i]} lum ${l}`);
                } else {
                    print(`    UNDER-LIT: ${names[i]} lum ${l}`);
                }
            }
            if (l < 67) { below67++; }
        }
    }
    pal_eqi("49 world-atlas albedos are classified", world, 49);
    pal_eqi("every sub-72 world albedo is one of the 3 documented ART_BIBLE values",
            below72 - waived, 0);
    pal_eqi("exactly 3 world albedos are waived, no more", waived, 3);
    pal_eqi("no world albedo falls below the hard floor of 67", below67, 0);
    print(`    min world-albedo luminance = ${minlum} (target 72, hard floor 67)`);

    // Foliage and terrain are the most-seen surfaces; they must clear the bar
    // outright, waiver or no waiver.
    pal_ok("GRASS_MID clears 72", pal_lum(g_GRASS_MID) >= 72);
    pal_ok("GRASS_LO clears 72", pal_lum(g_GRASS_LO) >= 72);
    pal_ok("LEAF_LO clears 72", pal_lum(g_LEAF_LO) >= 72);
    pal_ok("DIRT_LO clears 72", pal_lum(g_DIRT_LO) >= 72);
    pal_ok("STONE_LO clears 72", pal_lum(g_STONE_LO) >= 72);
}

fn pal_ramp3(p_what: string, p_hi: i32, p_mid: i32, p_lo: i32) {
    pal_ok(p_what, pal_lum(p_hi) > pal_lum(p_mid) && pal_lum(p_mid) > pal_lum(p_lo));
}

fn pal_ramp2(p_what: string, p_hi: i32, p_lo: i32) {
    pal_ok(p_what, pal_lum(p_hi) > pal_lum(p_lo));
}

fn pal_test_ramps() {
    print("  [5] every family is a monotonic value ramp of one tinted hue");
    pal_ramp3("GRASS ramp", g_GRASS_HI, g_GRASS_MID, g_GRASS_LO);
    pal_ramp3("DIRT ramp", g_DIRT_HI, g_DIRT_MID, g_DIRT_LO);
    pal_ramp2("SNOW ramp", g_SNOW_HI, g_SNOW_LO);
    pal_ramp2("SAND ramp", g_SAND, g_SAND_LO);
    pal_ramp3("LEAF ramp", g_LEAF_HI, g_LEAF_MID, g_LEAF_LO);
    pal_ramp2("PINE ramp", g_PINE_HI, g_PINE_LO);
    pal_ramp2("BARK ramp", g_BARK_HI, g_BARK_LO);
    pal_ramp3("STONE ramp", g_STONE_HI, g_STONE_MID, g_STONE_LO);
    pal_ramp2("GRANITE ramp", g_GRANITE_HI, g_GRANITE_LO);
    pal_ramp3("CONCRETE ramp", g_CONCRETE_HI, g_CONCRETE_MID, g_CONCRETE_LO);
    pal_ramp2("RUST ramp", g_RUST, g_RUST_DARK);
    pal_ramp3("WOOD ramp", g_WOOD_HI, g_WOOD_MID, g_WOOD_LO);
    pal_ramp3("STEEL ramp", g_STEEL_HI, g_STEEL_MID, g_STEEL_LO);
    pal_ramp2("GUNMETAL ramp", g_GUNMETAL_HI, g_GUNMETAL_LO);
    pal_ramp2("BRASS ramp", g_BRASS, g_BRASS_LO);
    pal_ramp3("NIGHTSHADE ramp (halo/core/mid)", g_NS_HALO, g_NS_CORE, g_NS_MID);
    pal_ramp2("NIGHTSHADE deep step", g_NS_MID, g_NS_DEEP);
    pal_ramp2("VENOM ramp", g_VENOM_HALO, g_VENOM);
    pal_ramp3("MUZZLE ramp", g_MUZZLE_CORE, g_MUZZLE_MID, g_MUZZLE_EDGE);
    pal_ramp3("EXPLOSION ramp", g_EXPLO_HOT, g_EXPLO_MID, g_EXPLO_COOL);
    pal_ramp3("BLOOD ramp", g_BLOOD_FRESH, g_BLOOD_MID, g_BLOOD_DRY);
    pal_ramp3("SKY ramp is bright at the horizon", g_SKY_HORIZON, g_SKY_MID, g_SKY_ZENITH);
    pal_ramp3("CLOUD lit/body/shadow ramp", g_CLOUD_LIT, g_CLOUD_MID, g_CLOUD_SHADOW);
    pal_ramp2("MOON ramp", g_MOON_DISC, g_MOON_MARE);
    pal_ramp2("STAR ramp", g_STAR_BRIGHT, g_STAR_DIM);
    pal_ramp3("UI value ramp", g_UI_WHITE, g_UI_DIM, g_UI_BLACK);
}

fn pal_test_tod() {
    print("  [6] the §5.1 time-of-day sky keyframes");
    // NOON must be identical to the unsuffixed §3.2 constants, or tod.hml's
    // uniform 7-keyframe indexing silently disagrees with the base palette.
    pal_eqi("SKY_ZENITH_NOON == SKY_ZENITH", g_SKY_ZENITH_NOON, g_SKY_ZENITH);
    pal_eqi("SKY_MID_NOON == SKY_MID", g_SKY_MID_NOON, g_SKY_MID);
    pal_eqi("SKY_HORIZON_NOON == SKY_HORIZON", g_SKY_HORIZON_NOON, g_SKY_HORIZON);
    pal_eqi("CLOUD_LIT_NOON == CLOUD_LIT", g_CLOUD_LIT_NOON, g_CLOUD_LIT);
    pal_eqi("CLOUD_SHADOW_NOON == CLOUD_SHADOW", g_CLOUD_SHADOW_NOON, g_CLOUD_SHADOW);

    // At every keyframe the sky must brighten toward the horizon and the cloud
    // top must be lighter than its underside — the two invariants skygen.hml
    // depends on (ART_BIBLE §11.1, §11.2).
    pal_ramp2("DAWN horizon > zenith", g_SKY_HORIZON_DAWN, g_SKY_ZENITH_DAWN);
    pal_ramp2("MORNING horizon > zenith", g_SKY_HORIZON_MORNING, g_SKY_ZENITH_MORNING);
    pal_ramp2("NOON horizon > zenith", g_SKY_HORIZON_NOON, g_SKY_ZENITH_NOON);
    pal_ramp2("GOLDEN horizon > zenith", g_SKY_HORIZON_GOLDEN, g_SKY_ZENITH_GOLDEN);
    pal_ramp2("DUSK horizon > zenith", g_SKY_HORIZON_DUSK, g_SKY_ZENITH_DUSK);
    pal_ramp2("NIGHT horizon > zenith", g_SKY_HORIZON_NIGHT, g_SKY_ZENITH_NIGHT);
    pal_ramp2("DEEP horizon > zenith", g_SKY_HORIZON_DEEP, g_SKY_ZENITH_DEEP);
    pal_ramp2("DAWN cloud lit > shadow", g_CLOUD_LIT_DAWN, g_CLOUD_SHADOW_DAWN);
    pal_ramp2("MORNING cloud lit > shadow", g_CLOUD_LIT_MORNING, g_CLOUD_SHADOW_MORNING);
    pal_ramp2("NOON cloud lit > shadow", g_CLOUD_LIT_NOON, g_CLOUD_SHADOW_NOON);
    pal_ramp2("GOLDEN cloud lit > shadow", g_CLOUD_LIT_GOLDEN, g_CLOUD_SHADOW_GOLDEN);
    pal_ramp2("DUSK cloud lit > shadow", g_CLOUD_LIT_DUSK, g_CLOUD_SHADOW_DUSK);
    pal_ramp2("NIGHT cloud lit > shadow", g_CLOUD_LIT_NIGHT, g_CLOUD_SHADOW_NIGHT);
    pal_ramp2("DEEP cloud lit > shadow", g_CLOUD_LIT_DEEP, g_CLOUD_SHADOW_DEEP);

    // The cycle must actually get dark and actually get bright, or the ToD
    // system is decoration.
    pal_ok("DEEP night zenith is below luminance 20", pal_lum(g_SKY_ZENITH_DEEP) < 20);
    pal_ok("GOLDEN horizon is above luminance 150", pal_lum(g_SKY_HORIZON_GOLDEN) > 150);
}

fn pal_test_identities() {
    print("  [7] cross-section identities and the violet reservation");
    pal_eqi("UI_XP is NS_CORE (ART_BIBLE §3.11)", g_UI_XP, g_NS_CORE);
    pal_eqi("UI_GOOD is VENOM (ART_BIBLE §3.11)", g_UI_GOOD, g_VENOM);
    pal_eqi("NS_CORE is the brand colour #C74FFF", g_NS_CORE, 0xC74FFF);
    pal_eqi("GRASS_MID is #7A9636", g_GRASS_MID, 0x7A9636);
    pal_eqi("UI_BLACK is #0A0C10", g_UI_BLACK, 0x0A0C10);

    // The signature: violet must be unmistakably violet, and it must not have
    // leaked into a terrain or architecture family.
    pal_ok("NS_CORE is blue-dominant and red-strong (violet, not magenta-grey)",
           pal_b(g_NS_CORE) > pal_r(g_NS_CORE) && pal_r(g_NS_CORE) > pal_g(g_NS_CORE));
    // THE VIOLET RESERVATION (CLAUDE.md §8, ART_BIBLE §3.8 usage law).
    // Violet may appear on exactly one world surface: NIGHTSHADE_FLORA, the
    // plant the game is named after. Anywhere else in terrain/stone/wood/metal
    // it destroys long-range enemy readability, which is the whole point of the
    // accent. "Violet" here = blue clearly over green AND red clearly over
    // green, which is the signature NS_* shape and nothing else in the table.
    let vals: array<i32> = pal_table();
    let names: array<string> = pal_names();
    let fams: array<i32> = pal_families();
    let leaks: i32 = 0;
    let flora_violets: i32 = 0;
    for (let i = 0; i < vals.length; i++) {
        let f: i32 = fams[i];
        let c: i32 = vals[i];
        let r: i32 = pal_r(c);
        let g: i32 = pal_g(c);
        let b: i32 = pal_b(c);
        let violet: bool = b - g > 24 && r - g > 24;
        if (violet) {
            if (f == g_PAL_FAM_FOLIAGE) {
                flora_violets++;
                if (c != g_NIGHTSHADE_FLORA) {
                    leaks++;
                    print(`    VIOLET LEAK: ${names[i]}`);
                }
            } else if (f >= g_PAL_FAM_TERRAIN && f <= g_PAL_FAM_METAL) {
                leaks++;
                print(`    VIOLET LEAK: ${names[i]}`);
            }
        }
    }
    pal_eqi("no violet has leaked into a world-surface family", leaks, 0);
    pal_eqi("NIGHTSHADE_FLORA is the one sanctioned violet world surface",
            flora_violets, 1);

    // WARM WORLD / COOL SKY (ART_BIBLE §3.1), with its four documented
    // exceptions. The ground the player actually walks on is warm without
    // exception; the cool entries in terrain/foliage are snow (explicitly
    // "blue, not grey"), conifer (explicitly "teal-shifted"), and the violet
    // plant. Asserting the exact COUNT means a fifth cool terrain colour —
    // the way a palette drifts grey — goes red immediately.
    let cool_ground: i32 = 0;
    let warm_sky: i32 = 0;
    for (let i = 0; i < vals.length; i++) {
        let f: i32 = fams[i];
        let c: i32 = vals[i];
        if (f == g_PAL_FAM_TERRAIN || f == g_PAL_FAM_FOLIAGE) {
            if (pal_r(c) < pal_b(c)) {
                cool_ground++;
                print(`    cool by design: ${names[i]}`);
            }
        }
        if (f == g_PAL_FAM_SKY) {
            if (pal_b(c) <= pal_r(c)) {
                warm_sky++;
                print(`    warm by design: ${names[i]}`);
            }
        }
    }
    pal_ok("GRASS/DIRT/SAND/MUD are warm without exception",
           pal_r(g_GRASS_MID) > pal_b(g_GRASS_MID)
           && pal_r(g_DIRT_MID) > pal_b(g_DIRT_MID)
           && pal_r(g_SAND) > pal_b(g_SAND)
           && pal_r(g_MUD) > pal_b(g_MUD));
    pal_eqi("exactly 5 cool terrain/foliage entries: SNOW x2, PINE x2, NIGHTSHADE_FLORA",
            cool_ground, 5);
    pal_eqi("exactly 4 warm sky entries: SUN_DISC, SUN_HALO, STAR_BRIGHT, CLOUD_LIT",
            warm_sky, 4);
    pal_ok("SNOW_LO is blue, not grey (ART_BIBLE §3.3)",
           pal_b(g_SNOW_LO) - pal_r(g_SNOW_LO) >= 20);
    pal_ok("PINE_HI is teal-shifted away from LEAF_HI (ART_BIBLE §3.4)",
           pal_b(g_PINE_HI) - pal_b(g_LEAF_HI) >= 20);
}

fn pal_test_anchors() {
    print("  [8] the table can pin both ends of the value range");
    let vals: array<i32> = pal_table();
    let lo: i32 = 255;
    let hi: i32 = 0;
    for (let i = 0; i < vals.length; i++) {
        let l: i32 = pal_lum(vals[i]);
        if (l < lo) { lo = l; }
        if (l > hi) { hi = l; }
    }
    print(`    luminance range of the whole table: ${lo}..${hi}`);
    pal_ok("something below luminance 30 exists (ART_BIBLE §13.5)", lo < 30);
    pal_ok("something above luminance 220 exists (ART_BIBLE §13.5)", hi > 220);
}

// Runs every palette invariant. Returns 0 on success, otherwise the number of
// failures (plus one if the assertion COUNT itself is wrong).
export fn pal_selftest(): i32 {
    g_pal_pass = 0;
    g_pal_total = 0;
    print("pal_selftest — W2-3, src/art/palette.hml (ART_BIBLE §3, §5.1, §4.4, §13.7)");
    pal_test_functions();
    pal_test_table();
    pal_test_tint_law();
    pal_test_world_luminance();
    pal_test_ramps();
    pal_test_tod();
    pal_test_identities();
    pal_test_anchors();

    let fails: i32 = g_pal_total - g_pal_pass;
    print(`PASS ${g_pal_pass}/${g_pal_total}`);
    if (g_pal_total != g_PAL_SELFTEST_ASSERTS) {
        print(`FAIL assertion count: ran ${g_pal_total}, expected ${g_PAL_SELFTEST_ASSERTS}`);
        fails = fails + 1;
    }
    let out: i32 = fails;
    return out;
}
