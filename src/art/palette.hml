// ===========================================================================
// ART_BIBLE §4.4 — EMISSIVE, and §13.7 — THE MISSING-TEXTURE TILE
// ===========================================================================

// Hub window lights: 2 additive tris per window, ART_BIBLE §4.4.
export let g_WINDOW_LIGHT : i32 = 0xFFD8A0;   // 255,216,160

// ART_BIBLE §13.7 mandates a MAGENTA `DEBUG_GRID` / missing-texture tile so a
// missing asset is impossible to miss in a screenshot, but gives no hex for it.
// This is THE ONLY VALUE IN THIS FILE NOT TRANSCRIBED FROM THE ART_BIBLE. It is
// chosen, not typed: it obeys the no-round-channels / no-equal-channels law
// (244, 42, 206), and it is a hue that appears nowhere else in the palette, so
// one magenta texel in a frame is a bug report.
export let g_DEBUG_MAGENTA : i32 = 0xF42ACE;   // 244, 42,206

// ===========================================================================
// UNPACKERS / CONSTRUCTORS
//
// `p_`-prefixed and copy-to-local throughout: `texgen` calls these once per
// texel (65 536 per `ATLAS_WORLD` bake) and `skygen` once per sky texel
// (81 920 per re-bake), which is well past the "hot" line. Returns go through a
// named copy (`out`) because `return expr_using_param;` re-boxes (CLAUDE.md A2).
// ===========================================================================

// Red channel of a packed colour, 0..255.
export fn pal_r(p_c: i32): i32 {
    let c: i32 = p_c;
    let out: i32 = (c >> 16) & 255;
    return out;
}

// Green channel of a packed colour, 0..255.
export fn pal_g(p_c: i32): i32 {
    let c: i32 = p_c;
    let out: i32 = (c >> 8) & 255;
    return out;
}

// Blue channel of a packed colour, 0..255.
export fn pal_b(p_c: i32): i32 {
    let c: i32 = p_c;
    let out: i32 = c & 255;
    return out;
}

// Pack three channels into 0xRRGGBB. Clamps rather than wrapping or trapping:
// generators compute channels arithmetically (`a - b` ridge trick, dither
// offsets, ramp steps) and an out-of-range intermediate must degrade to a
// legible colour, never take the frame down. Hand-inlined clamps (CLAUDE.md A9).
export fn pal_pack(p_r: i32, p_g: i32, p_b: i32): i32 {
    let r: i32 = p_r;
    let g: i32 = p_g;
    let b: i32 = p_b;
    if (r < 0)   { r = 0; }
    if (r > 255) { r = 255; }
    if (g < 0)   { g = 0; }
    if (g > 255) { g = 255; }
    if (b < 0)   { b = 0; }
    if (b > 255) { b = 255; }
    let out: i32 = (r << 16) | (g << 8) | b;
    return out;
}

// Linear blend a->b in straight (non-gamma) RGB, `t` clamped to 0..1.
//
// Straight-RGB and not gamma-correct on purpose: every reference value in the
// ART_BIBLE was picked by eye in sRGB, the ramps are 3-4 steps of ONE tinted
// hue (so the blend never crosses a hue boundary where naive lerp goes muddy),
// and the sky gradient's perceptual shaping is done by the caller's gamma-1.35
// curve on `t` (ART_BIBLE §11.1), not in here. Rounds with +0.5 so t=0 and t=1
// reproduce the endpoints exactly.
export fn pal_lerp(p_a: i32, p_b: i32, p_t: f64): i32 {
    let a: i32 = p_a;
    let b: i32 = p_b;
    let t: f64 = p_t;
    if (t < 0.0) { t = 0.0; }
    if (t > 1.0) { t = 1.0; }
    let ar: f64 = f64((a >> 16) & 255);
    let ag: f64 = f64((a >> 8) & 255);
    let ab: f64 = f64(a & 255);
    let br: f64 = f64((b >> 16) & 255);
    let bg: f64 = f64((b >> 8) & 255);
    let bb: f64 = f64(b & 255);
    let r: i32 = i32(ar + (br - ar) * t + 0.5);
    let g: i32 = i32(ag + (bg - ag) * t + 0.5);
    let bl: i32 = i32(ab + (bb - ab) * t + 0.5);
    let out: i32 = (r << 16) | (g << 8) | bl;
    return out;
}

// The same blend with a FIXED-POINT weight, `q` in 0..256 (256 = all of `b`).
//
// This exists because `pal_lerp` is expensive and the two callers that matter
// run it per texel: `texgen` bakes 65 536 texels inside a 200 ms budget and
// `skygen` re-bakes 20 rows (10 240 texels) inside 0.6 ms/frame.
//
// MEASURED, `hemlockc -O1`, 65 536 calls, `__clock()` CPU time, min of 7
// batches (CLAUDE.md §1.2), on this box under its permanent ~17-core
// llama-server load — so treat these as an upper bound, not an idle number:
//
//     pal_lerp   (f64 weight)   13.3-16.5 ms / 65 536  =  203-252 ns/call
//     pal_lerp_q (i32 weight)    6.8- 7.7 ms / 65 536  =  103-118 ns/call   2.1x
//     pal_pack                   3.2- 4.1 ms / 65 536  =   49- 63 ns/call
//     pal_lum                    1.8- 2.0 ms / 65 536  =   28- 30 ns/call
//     empty loop + one f64 div   2.5      ms / 65 536  =   37    ns/iter
//
// HONEST CAVEAT FOR W2-6: at 103 ns, ONE `pal_lerp_q` per texel is still
// 1.06 ms for a 20-row sky slice — over the 0.6 ms/frame budget on its own.
// Roughly 30 ns of every call is pure argument marshalling (CLAUDE.md A9b:
// ~10 ns PER ARGUMENT), which no amount of tuning inside the body removes.
// `skygen`'s innermost loop must HAND-INLINE this five-line body, not call it.
// `pal_lerp_q` is the right tool for `texgen` (2 blends/texel = 13.5 ms of a
// 200 ms budget) and for anything per-row rather than per-texel.
//
// All-integer, all-positive: `a*(256-q) + b*q` peaks at 65 280, so no i32
// overflow trap and no arithmetic-shift-of-negative question (CLAUDE.md A13).
// q = 0 and q = 256 reproduce the endpoints exactly, and q = 128 agrees with
// `pal_lerp(a, b, 0.5)` bit for bit — both asserted. The only difference from
// `pal_lerp` is that the weight is quantized to 1/256, i.e. at most 1/255 of a
// channel, which is below the resolution of an 8-bit texel.
export fn pal_lerp_q(p_a: i32, p_b: i32, p_q: i32): i32 {
    let a: i32 = p_a;
    let b: i32 = p_b;
    let q: i32 = p_q;
    if (q < 0) { q = 0; }
    if (q > 256) { q = 256; }
    let inv: i32 = 256 - q;
    let r: i32 = (((a >> 16) & 255) * inv + ((b >> 16) & 255) * q + 128) >> 8;
    let g: i32 = (((a >> 8) & 255) * inv + ((b >> 8) & 255) * q + 128) >> 8;
    let bl: i32 = ((a & 255) * inv + (b & 255) * q + 128) >> 8;
    let out: i32 = (r << 16) | (g << 8) | bl;
    return out;
}

// Rec.601 luminance, 0..255, integer. `(77r + 151g + 28b) >> 8`.
//
// Rec.601 and not Rec.709 or a plain average because the ART_BIBLE's own
// numbers are calibrated to it: §1.4 calls RGB(42,98,44) "roughly 30 %
// luminance", which is 75/255 = 29.4 % under Rec.601 and 24 % under a plain
// average. Max intermediate is 77*255 + 151*255 + 28*255 = 65280, so no i32
// overflow trap is possible (CLAUDE.md A13).
export fn pal_lum(p_c: i32): i32 {
    let c: i32 = p_c;
    let r: i32 = (c >> 16) & 255;
    let g: i32 = (c >> 8) & 255;
    let b: i32 = c & 255;
    let out: i32 = (77 * r + 151 * g + 28 * b) >> 8;
    return out;
}

// ===========================================================================
// THE TABLE, AS DATA
//
// `palette_preview.hml` (W2-11) labels its swatch sheet from these and
// `texgen.hml` (W2-5) uses `pal_families()` to prove its "<= 2 palette families
// per tile" rule without ever naming a colour twice. Cold: each call allocates
// a fresh array, so call once and keep it. Never call these per frame.
//
// Family ids, in file order:
//   0 SKY   1 TERRAIN   2 FOLIAGE   3 STONE   4 WOOD   5 METAL   6 NIGHTSHADE
//   7 FX    8 BLOOD     9 UI       10 TOD_SKY 11 EMISSIVE 12 DEBUG
// Families 1..5 are the `ATLAS_WORLD` albedos bound by the luminance-72 law.
// ===========================================================================

