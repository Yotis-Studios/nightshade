    // ---- NIGHT 22:00 (direction negated: this is the moon) -----------------
    0.6875,
    0.30, 0.55, 0.78,
    0.22, 0.24, 0.34,
    0.16, 0.18, 0.30,
    0.03, 0.04, 0.06,
    0.18, 0.22, 0.36,
