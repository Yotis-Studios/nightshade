export let TODSKY_CLOUD_SHADOW_B = 14;
export let TODSKY_STAR_ALPHA = 15;
export let TODSKY_HALO = 16;          // 0 none .. 1 the huge dawn/golden corona
export let TODSKY_MOON = 17;          // 0 draw the sun disc, 1 the moon, blends
export let TODSKY_BODY_X = 18;        // unit direction TO the drawn body ...
export let TODSKY_BODY_Y = 19;        // ... which is also the key light, so the
export let TODSKY_BODY_Z = 20;        //     disc and the shadows always agree
export let TODSKY_CLOUD_COVER = 21;   // 0.25 clear .. 1.0 storm
export let TODSKY_COUNT = 22;

// ===========================================================================
// THE KEYFRAME TABLE — ART_BIBLE §5.1, one row per keyframe, KF_STRIDE wide.
// ===========================================================================
let KF_ANCHOR = 0;        // day fraction (D6 remap)
let KF_DIR_X = 1;         // key light direction, night rows already negated
let KF_DIR_Y = 2;
let KF_DIR_Z = 3;
let KF_SUN_R = 4;
let KF_SUN_G = 5;
let KF_SUN_B = 6;
let KF_AMB_R = 7;
