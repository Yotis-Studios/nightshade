// tod.hml — the day/night cycle. W2-4.
//
// The ART_BIBLE §5.1 keyframe table, remapped onto the 16-minute day of
// ARCHITECTURE decision D6, linearly interpolated, with the four §5.2 weather
// variants, the corrupted-zone (NIGHTSHADE BLOOM) override, and the 2-frame
// lightning sequence. Its one output is a filled engine `RenderEnv`.
//
// RULE R1: every colour in this project's atmosphere lives HERE, never in
// wobbleweed. `shade.hml` owns the *model*; this file owns the *values*.
//
// ---------------------------------------------------------------------------
// D6 — THE REMAP. This is the mapping table D6 says lives in this file.
// ---------------------------------------------------------------------------
// GAME_DESIGN owns pacing: the day is 16 real minutes, split
//     Dawn 2 min | Day 7 min | Dusk 2 min | Night 5 min
// ART_BIBLE owns the colours: seven keyframes on a 24-hour clock,
//     DAWN 05:30  MORNING 08:00  NOON 12:00  GOLDEN 18:15
//     DUSK 19:30  NIGHT 22:00    DEEP 02:00
//
// Both survive by placing each keyframe at the day fraction that preserves its
// ART_BIBLE clock spacing *within* the gamedesign phase it belongs to:
//
//   phase   day_t range        keyframes in it     placement
//   Dawn    0.0000 .. 0.1250   DAWN                phase start
//   Day     0.1250 .. 0.5625   MORNING NOON GOLDEN MORNING at the start,
//                                                  GOLDEN at the end, NOON at
//                                                  (12:00-08:00)/(18:15-08:00)
//                                                  = 0.3902 of the phase
//   Dusk    0.5625 .. 0.6875   DUSK                (19:30-18:15)/(22:00-18:15)
//                                                  = 1/3 of the phase
//   Night   0.6875 .. 1.0000   NIGHT DEEP          NIGHT at the start, DEEP at
//                                                  (02:00-22:00)/(05:30-22:00)
//                                                  = 0.5333 of the phase
//
// giving the seven anchors below. GOLDEN sits exactly on the Day/Dusk boundary
// and NIGHT exactly on the Dusk/Night boundary, so the phase a player is in and
// the light they are standing in agree at every transition — which is what makes
// "the dusk horn" (GAME_DESIGN) land on a visible change.
//
// 16 min = 960 s = 57 600 ticks at 60 Hz. One tick is 1/57600 of a day, so the
// largest per-frame change of any channel in the table is ~0.0002 — three
// orders of magnitude under the 4 %/frame discontinuity budget.
//
// ---------------------------------------------------------------------------
// THE NIGHT KEY LIGHT — why the stored directions are not the ART_BIBLE ones
// ---------------------------------------------------------------------------
// ART_BIBLE §5.1 footnote 1: at night `SUN_RGB` is the moon term and the moon
// uses `-SUN_DIR`. The engine has ONE directional key, so this file stores the
// already-negated direction for NIGHT and DEEP. Two consequences, both wanted:
//   * every stored key direction has y >= 0.08, so after interpolation the key
//     NEVER comes from below the horizon (a light from below reads as a bug),
//   * the swing from DUSK to NIGHT is a continuous 4800-frame sweep of the key
//     across the sky (sun sets west, moon rises east) instead of the 180 degree
//     pop you get from negating a direction the moment its y crosses zero.
//
// ---------------------------------------------------------------------------
// INVARIANTS THIS FILE ENFORCES STRUCTURALLY (probe_tod.hml measures them)
// ---------------------------------------------------------------------------
//   1. ambient + sun <= 1 per channel, at every keyframe AND every interpolated
//      point, in every weather, during lightning. The table is authored to
//      satisfy it; `tod_eval` then clamps the SUN (never the ambient) so the
//      guarantee survives float rounding and any future weather value.
//   2. ambient >= 0.14 in every channel, always (ART_BIBLE §4.2: night is blue
//      and dark, never black).
//   3. fog_far <= 72 m, fog_near >= 3 m, fog_far > fog_near, always. Both
//      bounds are core/config.hml's g_FOG_FAR_CAP / g_FOG_NEAR_MIN.
//   4. ambient is the complement of the sun: never grey, and never warmer than
//      the key light.
//   5. mist density in [0, 0.85].
//
// ---------------------------------------------------------------------------
// COST
// ---------------------------------------------------------------------------
// `tod_eval` runs ONCE per frame (frame graph stage 6). It allocates nothing —
// the sample buffer and the two weather-parameter buffers are retained — and
// costs a few microseconds. It is a cold function by CLAUDE.md's definition, so
// it is written for clarity, not for the `p_`/copy-out idiom.

import {
    env_set_sun, env_set_ambient, env_set_bounce, env_set_rim,
    env_set_fog, env_set_mist
} from "../../../wobbleweed/src/shade.hml";
// CLAUDE.md §8: palette.hml is the only file that names a colour. The seven
// sky/cloud rows of the ART_BIBLE §5.1 table live there as packed colours; this
// file owns their PLACEMENT IN TIME, not their values.
import {
    pal_r, pal_g, pal_b,
    g_SKY_ZENITH_DAWN, g_SKY_ZENITH_MORNING, g_SKY_ZENITH_NOON,
    g_SKY_ZENITH_GOLDEN, g_SKY_ZENITH_DUSK, g_SKY_ZENITH_NIGHT,
    g_SKY_ZENITH_DEEP,
    g_SKY_MID_DAWN, g_SKY_MID_MORNING, g_SKY_MID_NOON, g_SKY_MID_GOLDEN,
    g_SKY_MID_DUSK, g_SKY_MID_NIGHT, g_SKY_MID_DEEP,
    g_SKY_HORIZON_DAWN, g_SKY_HORIZON_MORNING, g_SKY_HORIZON_NOON,
    g_SKY_HORIZON_GOLDEN, g_SKY_HORIZON_DUSK, g_SKY_HORIZON_NIGHT,
    g_SKY_HORIZON_DEEP,
    g_CLOUD_LIT_DAWN, g_CLOUD_LIT_MORNING, g_CLOUD_LIT_NOON,
    g_CLOUD_LIT_GOLDEN, g_CLOUD_LIT_DUSK, g_CLOUD_LIT_NIGHT, g_CLOUD_LIT_DEEP,
    g_CLOUD_SHADOW_DAWN, g_CLOUD_SHADOW_MORNING, g_CLOUD_SHADOW_NOON,
    g_CLOUD_SHADOW_GOLDEN, g_CLOUD_SHADOW_DUSK, g_CLOUD_SHADOW_NIGHT,
    g_CLOUD_SHADOW_DEEP
} from "./palette.hml";
// Every tunable this file uses is core/config.hml's, never a second copy.
import {
    g_FOG_FAR_CAP, g_FOG_NEAR_MIN, g_MIST_HEIGHT,
    g_DAY_SECONDS, g_DAY_TICKS,
    g_PHASE_DAWN_END, g_PHASE_DAY_END, g_PHASE_DUSK_END
} from "../core/config.hml";

// ===========================================================================
// PUBLIC CONSTANTS
// ===========================================================================

// Keyframe ids. These index the table; they are NOT the gameplay phases.
export let TOD_DAWN = 0;
export let TOD_MORNING = 1;
export let TOD_NOON = 2;
export let TOD_GOLDEN = 3;
export let TOD_DUSK = 4;
export let TOD_NIGHT = 5;
export let TOD_DEEP = 6;
export let TOD_KEY_COUNT = 7;

// The four gamedesign phases of D6.
export let TOD_PHASE_DAWN = 0;
export let TOD_PHASE_DAY = 1;
export let TOD_PHASE_DUSK = 2;
export let TOD_PHASE_NIGHT = 3;
export let TOD_PHASE_COUNT = 4;

// Weather. BLOOM is not weather — it is the corrupted-zone override — but it
// rides the same crossfade machinery, so it lives in the same enum.
export let WX_CLEAR = 0;
export let WX_OVERCAST = 1;
export let WX_RAIN = 2;
export let WX_STORM = 3;
export let WX_BLOOM = 4;
export let WX_COUNT = 5;

// D6: 16 real minutes per day, at the project's fixed 60 Hz tick.
// Every tunable below is core/config.hml's; this file re-exports them under ToD
// names so a caller of tod_* needs one import, and so that NOTHING here is a
// second copy of a config number (CLAUDE.md §5.2).
export let TOD_DAY_SECONDS: f64 = g_DAY_SECONDS;
export let TOD_DAY_TICKS: i32 = g_DAY_TICKS;

// Phase boundaries as day fractions (2 / 7 / 2 / 5 minutes of 16).
export let TOD_PHASE_T_DAWN: f64 = 0.0;
export let TOD_PHASE_T_DAY: f64 = g_PHASE_DAWN_END;
export let TOD_PHASE_T_DUSK: f64 = g_PHASE_DAY_END;
export let TOD_PHASE_T_NIGHT: f64 = g_PHASE_DUSK_END;

// CLAUDE.md §6 / ARCHITECTURE §8: fog distance IS the triangle budget.
export let TOD_FOG_FAR_CAP: f64 = g_FOG_FAR_CAP;
// ART_BIBLE §6.6: fog on your own gun barrel looks broken.
export let TOD_FOG_NEAR_MIN: f64 = g_FOG_NEAR_MIN;
// ART_BIBLE §4.2: the ambient floor. Below this the image reads as a crash.
export let TOD_AMBIENT_FLOOR = 0.14;
// ART_BIBLE §6.4: valleys/swamp cap.
export let TOD_MIST_MAX = 0.85;

// Crossfade lengths in seconds. §5.2 footnote 3 gives the bloom one.
export let TOD_FADE_WEATHER = 6.0;
export let TOD_FADE_BLOOM = 3.0;

// §5.2: the lightning flash is 2 frames, then 1 recovery frame.
export let TOD_LIGHTNING_FLASH_FRAMES = 2;
export let TOD_LIGHTNING_TAIL_FRAMES = 1;
export let TOD_LIGHTNING_QUAD_ALPHA = 0.55;

// ---------------------------------------------------------------------------
// `tod_sky_keys` output layout. skygen.hml (W2-6) walks this.
// All colours are 0..1 linear; multiply by 255 for a byte.
// ---------------------------------------------------------------------------
export let TODSKY_ZENITH_R = 0;
export let TODSKY_ZENITH_G = 1;
export let TODSKY_ZENITH_B = 2;
export let TODSKY_MID_R = 3;
