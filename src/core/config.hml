export let g_FX_CELL_PX: i32 = 16;
export let g_ATLAS_HUD_PX: i32 = 128;
export let g_SKY_W: i32 = 512;
export let g_SKY_H: i32 = 160;

// Texel density.  A mismatch is visible even at 320x240 and makes the world
// feel assembled from parts.
export let g_TEXEL_CM_PROP: f64 = 4.0;               // 32 px tile = 1.28 m
export let g_TEXEL_CM_GROUND: f64 = 12.0;            // 32 px tile = 3.84 m

// The three rules that separate "procedural" from "television static".
export let g_TILE_COLORS_MAX: i32 = 12;
export let g_TILE_LUM_MIN_RANGE: i32 = 60;
export let g_TILE_LUM_MAX_RANGE: i32 = 130;
export let g_ALBEDO_LUM_MIN: i32 = 72;               // vertex colour only darkens
export let g_GRAIN_AMT: i32 = 6;                     // +/- luminance, never structure
export let g_STRUCTURE_MIN_TEXELS: i32 = 3;          // finer than this must be grain

// Half-texel UV inset on every atlas cell (Rule T5).
export let g_UV_INSET: f64 = 0.5;                    // in texels

// Per-instance variation is free and mandatory.
export let g_INST_SCALE_MIN: f64 = 0.85;
export let g_INST_SCALE_MAX: f64 = 1.25;
export let g_INST_TINT_JITTER: f64 = 0.08;

// Fonts (ART_BIBLE §9.4).  FONT_BIG is drawn separately, never scaled up.
export let g_FONT_MICRO_W: i32 = 4;
export let g_FONT_MICRO_H: i32 = 6;
export let g_FONT_BIG_W: i32 = 8;
export let g_FONT_BIG_H: i32 = 12;
export let g_FONT_LINE_PITCH: i32 = 8;
export let g_FONT_SHADOW_PX: i32 = 1;                // UI_BLACK at (+1,+1), always

// ===========================================================================
// 16. AUDIO  (HOST_FACTS: the verified SDL2_mixer device)
// ===========================================================================
export let g_AUDIO_HZ: i32 = 22050;
export let g_AUDIO_CHANNELS: i32 = 1;                // mono; panning is per-voice
export let g_AUDIO_CHUNK: i32 = 512;                 // samples per mixer buffer
export let g_AUDIO_VOICES: i32 = 16;
export let g_SFX_COUNT_MAX: i32 = 96;

// The gun is the loudest thing in the game, always.
export let g_MIX_DUCK_DB: f64 = -8.0;
export let g_MIX_DUCK_RECOVER_S: f64 = 1.2;
export let g_STEP_INTERVAL_WALK_S: f64 = 0.42;
