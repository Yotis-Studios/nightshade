// as fractions of the day so nothing has to divide at runtime.
export let g_DAY_MINUTES: f64 = 16.0;
export let g_DAY_SECONDS: f64 = 960.0;
export let g_DAY_TICKS: i32 = 57600;                 // 960 s * 60 Hz
export let g_PHASE_DAWN_END: f64 = 0.125;            // 2/16
export let g_PHASE_DAY_END: f64 = 0.5625;            // 9/16
export let g_PHASE_DUSK_END: f64 = 0.6875;           // 11/16
export let g_DUSK_HORN_LEAD_S: f64 = 120.0;          // two long notes at T-2:00
export let g_DAWN_GATHER_MULT: f64 = 1.5;

// Sky panorama re-bake: 20 rows per frame on a rolling cursor, 8 frames for a
