export let g_SPEEDLINE_A: f64 = 0.18;
export let g_WAVE_CLEAR_SILENCE_S: f64 = 0.4;        // actual silence. Keep it.
export let g_LANTERN_LIT_S: f64 = 1.2;               // the expanding ring

// ===========================================================================
// 19. THE SPELL SCHOOL  (DIRECTION.md §2 §9 §10, MAGIC_KINETIC.md §1.5-§1.9)
// ===========================================================================
// DIRECTION.md §2 is the directive: "the owner wants the character to LEARN
// abilities: healing, fire blasts, cloaking".  MAGIC_KINETIC.md §1.9 is the
// spec: seven spells, three equipped slots, ONE resource (oil), no mana, no
// new input field, no new dynamic light.
//
// What is here: the scalars other modules need — the damage-type axis, the oil
// economy, the Attunement curve, the phase table, the main-hand id space.
// What is NOT here: the 7-row spell table itself.  Per this file's own contract
// ("PER-ROW DATA TABLES ... live in their owning modules") it is parallel
// arrays in `src/sim/spells.hml`, exactly as the six weapons live in
// `sim/weapons.hml` and the six enemies in `sim/ai.hml`.

// --- the damage-type axis, orthogonal to the DMG_* delivery kinds ----------
// MAGIC_KINETIC.md §1.1 names this axis KINETIC / RADIANT; DIRECTION.md and the
// spell brief name the second value MAGIC.  Same axis, same index, one name
// here so `combat.hml`'s future affinity table has exactly one thing to index.
// A spell is a DELIVERY MECHANISM, not a damage type — six of the seven spells
// are MAGIC and the fire blast is KINETIC (§1.1: fire burns matter).  That is
// load-bearing: it is why a solo player is never stuck behind a resistance.
export let g_DTYPE_KINETIC: i32 = 0;
export let g_DTYPE_MAGIC: i32 = 1;
export let g_DTYPE_COUNT: i32 = 2;

// --- spell ids.  API: append at the end, never renumber. -------------------
export let g_SPELL_COUNT: i32 = 7;
export let g_SPELL_FLARE: i32 = 0;         // 360 degree burst   (MAGIC)
export let g_SPELL_SHUTTER: i32 = 1;       // sustained cone     (MAGIC)
export let g_SPELL_EMBERLANCE: i32 = 2;    // THE FIRE BLAST     (KINETIC)
export let g_SPELL_MEND: i32 = 3;          // THE HEAL           (no damage)
export let g_SPELL_GUTTERING: i32 = 4;     // THE CLOAK          (no damage)
export let g_SPELL_LANCE: i32 = 5;         // 5 degree lance     (MAGIC)
export let g_SPELL_KINDLING: i32 = 6;      // placed light pool  (no damage)

// DIRECTION.md §10 settled the hands question: "the lantern lives permanently
// in the OFF-HAND.  Everything else — club, spear, sword, rifle, spell — is
// MAIN-HAND and swaps."  So a spell occupies the SAME `weapon` field on
// InputCommand that a gun does, and needs zero wire change (MAGIC_KINETIC
// §1.9.1).
//
// THE MAIN-HAND ID SPACE, AFTER W6-6:
//     0..7    the eight guns        (weapons.hml — six city, two new village)
//     8..10   club, spear, sword    (weapons.hml `MH_MELEE_BASE = 8`)
//     11..17  the seven spells      (here)
// 11 + 7 - 1 = 17 = CMD_MAX_WEAPON.
//
// >>> THE OLD NOTE HERE SAID RAISING THIS CAP WAS "a wire-format decision,
// >>> not a table edit".  IT IS NOT, AND THAT WAS WORTH MEASURING. <<<
// `weapon_sel` is a **u8** at byte +18 of the 20-byte command record
// (`packing.hml` §11.2, `protocol.hml`'s map).  The field has always held
// 0..255; `CMD_MAX_WEAPON` is a POLICY CLAMP inside `cmd_set` and
// `cmd_wire_ok`, not the width of anything.  Raising it 15 -> 17 changed no
// packed byte, no stride, no checksum and no protocol version — verified by
// `tools/packetdump.hml` round-tripping unchanged.  There are 238 main-hand
// ids still spare.
//
// (This base was 8 for one build, which collided with the sword.  Caught by
// reading `weapons.hml`'s own id-space comment, not by a compiler.  It moved
// to 11 in W6-6 for exactly the same reason: guns 6 and 7 became real, so
// melee moved to 8..10 and the spells had to move out of its way.  `sim.hml`
// swaps the held gun to `weapon_sel` EVERY TICK, so an overlap here is not a
// naming clash, it is a live weapon swap you did not ask for.)
export let g_SPELL_ITEM_BASE: i32 = 11;
export let g_SPELL_SWAP_IN_S: f64 = 0.30;            // raising a spell
export let g_SPELL_SWAP_OUT_S: f64 = 0.22;           // lowering it

// --- OIL, the only spell resource (MAGIC_KINETIC §1.6) --------------------
// Stored in the sim as CENTI-OIL (x100) so the whole state vector is i32 and
// serialises with no encoder.  Regen is applied through an integer carry, so
// +0.8/s is exact and identical on both backends.
export let g_OIL_TANK_T1: f64 = 100.0;
export let g_OIL_TANK_T2: f64 = 150.0;               // unlock at Lv 10
export let g_OIL_TANK_T3: f64 = 200.0;               // unlock at Lv 21
export let g_OIL_TANK_TIERS: i32 = 3;
export let g_OIL_REGEN_LIT: f64 = 3.0;               // /s inside a lit radius
export let g_OIL_REGEN_DAY: f64 = 0.8;               // /s outside, PHASE_DAY
export let g_OIL_REGEN_DARK: f64 = 0.0;              // /s outside, dawn/dusk/night
export let g_OIL_FLASK: f64 = 35.0;
export let g_OIL_FLASK_STACK: i32 = 6;

// --- ATTUNEMENT (DIRECTION.md §9: "spell slots, potency, cooldown") -------
// The stat itself is not built yet; `spells.hml` carries it as one slot of its
// state so whoever builds the stat trees writes exactly one number.  At the
// cap: cost x0.60, cooldown x0.70, potency x1.80, 3 equipped slots.
export let g_ATTUNE_MAX: i32 = 20;
export let g_ATTUNE_COST_PER: f64 = 0.02;            // -2 % oil per point
export let g_ATTUNE_COST_FLOOR: f64 = 0.55;
export let g_ATTUNE_CD_PER: f64 = 0.015;             // -1.5 % cooldown per point
export let g_ATTUNE_CD_FLOOR: f64 = 0.65;
export let g_ATTUNE_POT_PER: f64 = 0.04;             // +4 % potency per point
export let g_ATTUNE_PER_SLOT: i32 = 7;               // 0-6:1  7-13:2  14-20:3
export let g_SPELL_SLOTS_MIN: i32 = 1;
export let g_SPELL_SLOTS_MAX: i32 = 3;

// --- the day-phase multiplier on MAGIC damage (MAGIC_KINETIC §1.7) --------
// Indexed by daycycle's PHASE_DAWN..PHASE_NIGHT.  The lamp is strongest exactly
// when the game is hardest, and inside a lit radius it is forced to the DAY
// value because there is no dark there to contrast against.
export let g_MAGIC_PHASE_DAWN: f64 = 0.85;
export let g_MAGIC_PHASE_DAY: f64 = 0.70;
export let g_MAGIC_PHASE_DUSK: f64 = 1.00;
export let g_MAGIC_PHASE_NIGHT: f64 = 1.30;
export let g_MAGIC_WINDUP_MULT: f64 = 2.00;          // bodied enemy mid-tell
export let g_MAGIC_FLOOR_MULT: f64 = 0.15;           // §5.3 THE LAW. Never below.
export let g_MAGIC_BEAM_HZ: i32 = 10;                // the shutter ticks at 10 Hz
export let g_MAGIC_REACH_CAP: f64 = 24.0;            // nothing magic reaches past this

// --- the three the owner asked for by name --------------------------------
export let g_MEND_HP: f64 = 40.0;                    // healing, over the channel
export let g_MEND_CHANNEL_S: f64 = 1.2;              // cancelled by damage
export let g_CLOAK_S: f64 = 4.0;                     // cloaking
export let g_CLOAK_AGGRO_MULT: f64 = 0.15;           // AI aggro radius while hidden
// THE TELL.  The lantern is always in the off-hand and it never goes out, so a
// cloaked lamplighter still carries a light.  Inside this radius the glow gives
// you away completely; the lantern only dims to the floor below.
export let g_CLOAK_GLOW_M: f64 = 6.0;
export let g_CLOAK_LIGHT_MULT: f64 = 0.35;           // lantern intensity while cloaked
export let g_KINDLING_S: f64 = 8.0;                  // placed pool lifetime
export let g_KINDLING_R: f64 = 3.0;
export let g_KINDLING_OIL_S: f64 = 1.5;              // /s to anyone standing in it
