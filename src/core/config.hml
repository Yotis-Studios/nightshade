// --- Movement.  Every one of these belongs to PredictedState. -------------
export let g_SPEED_WALK: f64 = 4.4;
export let g_SPEED_SPRINT: f64 = 7.0;
export let g_SPEED_CROUCH: f64 = 2.3;
export let g_SPEED_ADS: f64 = 2.9;
export let g_SPEED_WATER: f64 = 2.8;
