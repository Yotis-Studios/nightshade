export let g_CHUNK_M: f64 = 32.0;                    // chunk edge, metres
export let g_CHUNK_QUADS: i32 = 8;                   // 8x8 quads at LOD0
export let g_CHUNK_GRID_M: f64 = 4.0;                // heightfield cell, metres
export let g_CHUNK_N: i32 = 9;                       // 9x9 height samples

// Ring walk: 5x5 chunks around the camera covers 80 m of half-extent, which
// contains the 72 m fog sphere with room for the frustum test to do its job.
export let g_RING_RADIUS: i32 = 2;
export let g_RING_CHUNKS: i32 = 25;
export let g_CHUNK_CACHE: i32 = 64;                  // LRU entries

// LOD rings.  GDD authored 48/96/140 m against a 140 m draw distance; rescaled
// by the same 72/140 as the fog ladder, so LOD2 begins right where fog has
// almost finished the job.
export let g_LOD0_M: f64 = 24.0;
export let g_LOD1_M: f64 = 48.0;
export let g_LOD0_TRIS: i32 = 128;
export let g_LOD1_TRIS: i32 = 32;
export let g_LOD2_TRIS: i32 = 8;

// Heights are stored as u16 centimetres (A6: 1.03 B/element vs 16.03).
export let g_HEIGHT_SCALE_CM: f64 = 100.0;
export let g_HEIGHT_MAX_M: f64 = 640.0;

// Worldgen (GDD §4.1): 3-octave value noise, deterministic from
