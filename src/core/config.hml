export let g_HIT_PITCH_RESET_S: f64 = 0.6;

// ===========================================================================
// 17. NETWORKING SHAPES  (v1 loopback; net recon §7)
// ===========================================================================
// The buffer element cap is 255 bytes, so an entity blob is 12 x 20 B = 240 B.
export let g_NET_ENT_STRIDE_B: i32 = 20;
export let g_NET_BLOB_MAX_B: i32 = 240;
export let g_NET_ENTS_PER_BLOB: i32 = 12;
export let g_BUFFER_ELEM_CAP: i32 = 255;
export let g_CMD_FIELDS: i32 = 9;                    // nine integers. No bools.
export let g_ANG_QUANT: i32 = 65536;                 // u16 angle quantum
export let g_POS_QUANT_CM: f64 = 100.0;              // position quantum

