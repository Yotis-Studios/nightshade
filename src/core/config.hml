// config.hml — EVERY TUNABLE CONSTANT IN NIGHTSHADE.  W2-2.
//
// src/core is a LEAF: this file imports nothing (the import wall allows
// `@stdlib/*` only, and it needs none of it).  Everything here is a top-level
// `export let` with a `g_` prefix (CLAUDE.md §1.2 / ARCHITECTURE §1.2 — a
// non-`g_` top-level name silently boxes every same-named local in the whole
// program).
//
// ---------------------------------------------------------------------------
// THE CONTRACT
// ---------------------------------------------------------------------------
// **Nothing else in the game hardcodes a number that appears here.** If you
// find yourself typing `72.0`, `2500`, `0.40` or `1.0/60.0` into another
// module, the number belongs in this file and the module belongs importing it.
//
// What is NOT here, deliberately:
//   * COLOURS.  Every colour lives in `src/art/palette.hml` and nowhere else
//     (CLAUDE.md §8; CI greps for hex literals outside that file).
//   * PER-ROW DATA TABLES.  The six weapons (GDD §2.4), the six enemies
//     (§2.2), the loot rarity/affix bands (§3.3), the ToD keyframes
//     (ART_BIBLE §5.1) and the HUD element rects (ART_BIBLE §9.2) are
//     *parallel arrays*, not scalars, and they live in their owning modules —
//     `sim/weapons.hml`, `sim/ai.hml`, `sim/loot.hml`, `art/tod.hml`,
//     `render/hud.hml`.  Putting a 6x14 table in here would create a second
//     source of truth for it.  The *shapes* of those tables (their row counts
//     and their caps) are here, so the owning module can size itself.
//
// ---------------------------------------------------------------------------
// TYPES ARE PART OF THE CONTRACT
// ---------------------------------------------------------------------------
// A constant used in f64 arithmetic is declared `f64` with a decimal point; a
// count or an index is `i32`.  Hemlock's `/` yields f64 except for `a / 1`,
// and `x * 1.0` is folded away (CLAUDE.md §1 rule 9), so a value that is
// morally a float MUST be authored as one here or every consumer pays a
// conversion — or worse, throws on `array<f64>.push`.
//
// ---------------------------------------------------------------------------
// WHERE THE NUMBERS COME FROM
// ---------------------------------------------------------------------------
//   ARCHITECTURE.md §8 + §2.4  budgets, batch caps, layer sizes
//   BUDGET_ACTUAL.md           the MEASURED budget (its 2-light cap SUPERSEDED,
//                              see g_MAX_DYNAMIC_LIGHTS below for the re-measure)
//   ARCHITECTURE.md D1 D2 D6   2500 tris; FOG_FAR <= 72 m; the 16-minute day
//   GAME_DESIGN.md §2 §3 §4    movement, vitals, director, XP, world
//   ART_BIBLE.md §2.6 §6 §7    fog, texel density, tile rules
//   HOST_FACTS.md              the verified SDL2_mixer device spec
//
// Two whole-project caps are load-bearing and are called out where they live:
//   g_MAX_DYNAMIC_LIGHTS = 4   RE-MEASURED 2026-07-29 — the 4.9 ms figure timed
//                              a code path the shipping renderer never runs
//   g_FOG_FAR_CAP     = 72.0   RULE T6 — fog distance IS the triangle budget

// ===========================================================================
// 1. FIXED TIMESTEP  (ARCHITECTURE §3, CLAUDE.md §7)
// ===========================================================================
// TICK_DT is a COMPILE-TIME CONSTANT.  No gameplay function ever sees a
// measured delta — variable-dt physics is not reproducible and prediction is a
// reproduction problem.

export let g_TICK_HZ: i32 = 60;
export let g_TICK_MS: f64 = 16.666666666666668;      // 1000/60
export let g_TICK_DT: f64 = 0.016666666666666666;    // 1/60

// Spiral-of-death clamp: a frame longer than this is truncated, so a stall can
// never queue an unbounded number of catch-up ticks.
export let g_FRAME_CLAMP_MS: f64 = 250.0;

// 60 fps floor.  A gorgeous 40 fps FPS is a bad FPS.
export let g_FRAME_BUDGET_MS: f64 = 16.67;

// Lag-compensation ring (sim/history.hml).  32 ticks = 533 ms of rewind.
export let g_HISTORY_TICKS: i32 = 32;

// v2 only: how far behind the latest network snapshot the renderer
// interpolates.  Unused in the v1 loopback, reserved so the shape exists.
export let g_INTERP_DELAY_MS: f64 = 100.0;

// ===========================================================================
// 2. RESOLUTION AND PRESENT  (ARCHITECTURE D9, GDD §9 out-of-scope 23)
// ===========================================================================
// 320x180 is not negotiable and there are no resolution options.  The frame is
// rendered into an offscreen target and integer-upscaled, so polygon edges stay
// chunky — SDL_RenderSetLogicalSize scales rasterization and loses the look.
//
// ---------------------------------------------------------------------------
// WHY 180 AND NOT 240.  (changed 2026-07-31; was 320x240 through W7)
// ---------------------------------------------------------------------------
// Every display this ships to is 16:9.  A 4:3 internal buffer integer-upscaled
// onto one is PILLARBOXED, and pillarboxing does not read as retro — it reads
// as a game that was not finished.  The answer is not more pixels (that would
// delete the aesthetic: the chunky pixel, the affine warp, the vertex jitter
// and the ordered dither all come from the LOW internal buffer, and 1280x720
// of software fill is ~9.6 ms we do not have).  The answer is BETTER-SHAPED
// pixels — same pixel size, 16:9 frame.
//
// 320x180 is the one that makes the integer ladder exact:
//
//     320x180  x2 =  640x360        x4 = 1280x720   <- exact 720p
//     320x180  x3 =  960x540        x6 = 1920x1080  <- exact 1080p
//
// and it is 57600 px against 76800, i.e. 25 % FEWER PIXELS, so the software
// fill path gets CHEAPER, not dearer.  Pixels stay square: 320/180 = 16/9
// exactly, so nothing in the renderer needs a non-uniform scale anywhere.

export let g_RES_W: i32 = 320;
export let g_RES_H: i32 = 180;
export let g_RES_CX: f64 = 160.0;                    // screen centre, x
export let g_RES_CY: f64 = 90.0;                     // screen centre, y
export let g_ASPECT: f64 = 1.7777777777777777;       // 16:9

// x4 is the default because 1280x720 is exact, fits every 1080p and 1440p
// desktop with room for a title bar, and is the smallest factor that does not
// look like a thumbnail on a modern panel.  x6 is exact 1080p; `--scale 6`
// reaches it and `g_UPSCALE_MAX` says it is legal.
export let g_UPSCALE_MIN: i32 = 2;                   //  640x360
export let g_UPSCALE_DEFAULT: i32 = 4;               // 1280x720, exact
export let g_UPSCALE_MAX: i32 = 6;                   // 1920x1080, exact

// ===========================================================================
// 3. THE TRIANGLE BUDGET  (ARCHITECTURE D1 + §2.4 + §8)
// ===========================================================================
// RE-DERIVED FROM MEASUREMENT 2026-07-29.  Full working, every dataset and the
// reproduce command: BUDGET_ACTUAL.md §T.  Swept 513 -> 7971 DRAWN triangles
// through the real frame path with `benchframe.hml --sweep`, screenshot readback
// excluded (the game never runs it; it was a third of the frame it was hiding in).
//
// >>> THE OLD "2.88 us MARGINAL PER TRIANGLE" IS WITHDRAWN.  There is no such
// >>> number, because the frame is NOT linear in one triangle count.  Measured
// >>> over 27 rows spanning a 15x range and three independent content levers:
// >>>
// >>>     frame_ms = 0.636 us x SOURCE  +  1.492 us x DRAWN  +  1.670 ms
// >>>     R^2 = 0.9996, worst residual 0.334 ms
// >>>
// >>> TRANSFORM is paid per SOURCE triangle (everything the kernel touches,
// >>> including what it later backface-culls); FILL is paid per DRAWN triangle.
// >>> So a drawn triangle costs 2.20 us in open terrain and 4.03 us in a deep
// >>> crowd, and a budget quoted without its drawn/source ratio means nothing.
// >>> At the SHIPPING mix (r = 0.52, measured) it is 2.714 us.
//
// Where the numbers below come from (BUDGET_ACTUAL §T.5 shows every term):
//   16.670 ms deadline - 1.30 slack - 0.30 net - 0.852 audio/input = 14.218 ms
//   for the part benchframe actually times, then / 1.28 for this box's
//   MEASURED contention inflation (re-measured, not inherited: idle 7.541 ->
//   loaded 9.549 ms with 17 busy cores).
//     CLAMP  = 100 % of that deadline at r = 0.52  ->  3477  ->  3500 (unchanged)
//     STEADY =  90 % of it                         ->  3068  ->  3000 (was 2500)
//   Checked against the deadline rather than trusting the algebra:
//     peak 3000 drawn ->  9.812 ms idle net -> x1.28 + 2.452 = 15.01 ms,  90 %
//     peak 3500 drawn -> 11.169 ms          -> x1.28 + 2.452 = 16.75 ms, 100 % (the wall)
// Both are bounds on PEAK drawn triangles, which is what benchframe asserts.
// Sizing content by its TYPICAL frame instead?  Divide by the measured full-lap
// burst factor of 1.70 (worst over the ladder, and it is the SHIPPING frame that
// sets it: lap mean 1409.6 drawn against a lap peak of 2401).  A mean of 2000
// drawn peaks at ~3400; conversely a 3500 peak clamp lets the MEAN sit at ~2060.
export let g_TRIS_STEADY: i32 = 3000;
export let g_TRIS_CLAMP: i32 = 3500;

// >>> CORRECTED 5000 -> 3500, AND THIS ONE IS A SAFETY FIX, NOT A TUNING CHANGE.
// 5000 was never executed.  Reaching it requires g_CAP_WORLD (world_render.hml)
// above its shipping 3500, and raising that constant makes frame_render() throw
// `Type mismatch in typed array` on the ACCELERATED renderer at the peak-geometry
// frame (~3750-3900 drawn).  Reproduced at cap 5000 and 9000; absent at 3500;
// absent on the software renderer at every cap.  It is not a batch overflow —
// STAT_BATCH_OVERFLOW is 0 at the throw.  BUDGET_ACTUAL §T.7 has the repro.
//
// So the ceiling is currently set by a BUG, not by frame time: the timing says
// ~4800 drawn is reachable on a quiet box and ~3600 on a loaded one.  Until
// world_render.hml's owner fixes the throw, nothing may plan against >3500, and
// no code should carry a ceiling constant that has never survived a frame.
export let g_TRIS_CEILING: i32 = 3500;

// Per-layer pool capacities (ARCHITECTURE §2.4).  These are the `cap` handed to
// batch_new; batch_reserve returns -1 past them and increments a drop counter.
export let g_MAX_TRIS_SKY: i32 = 16;
export let g_MAX_TRIS_WORLD: i32 = 3500;
export let g_MAX_TRIS_FX: i32 = 768;
// ⚠ THIS ONE IS READ BY NOTHING.  `src/render/world_render.hml` builds the HUD
// batch at its own `g_CAP_HUD = 512` literal, not from here, so 768 has never
// been the HUD layer's capacity and a plan made against it would be 256
// triangles wrong.  Reported rather than changed: world_render.hml is not this
// task's file, and moving THIS number would only make the disagreement quieter.
export let g_MAX_TRIS_HUD: i32 = 768;

// Typical occupancy, for the budget report and the `budget_worst` scene.
export let g_TYP_TRIS_SKY: i32 = 4;
export let g_TYP_TRIS_WORLD: i32 = 1900;
export let g_TYP_TRIS_FX: i32 = 120;
export let g_TYP_TRIS_HUD: i32 = 250;

// ---------------------------------------------------------------------------
// THE HUD CONTENT CAP.  250 -> 334, 2026-07-31 (about-to-break).
// ---------------------------------------------------------------------------
// The old comment said "ART_BIBLE §9 totals ~240 tris worst case".  That was an
// estimate, it had been overrun, and the overrun was invisible because of what
// the cap actually does when it is hit.
//
// >>> 248 OF 250 WAS NOT A WARNING THAT THE HUD WAS NEARLY FULL.  IT WAS THE
// >>> HUD ALREADY TRUNCATING TEXT, EVERY RUN, WITH NOTHING COUNTING IT.
// `hud_build` hands every optional line `clampi(cap - used, 0, N)` as its TEXT
// budget and `font_text_shadowed` TRUNCATES at its budget rather than
// overspending.  So a saturated HUD does not drop a triangle -- IT SHORTENS
// WORDS -- and 248 is `g_HUD_TRI_CAP - 6` (the 6-triangle reserve at the top of
// `hud_build`) plus the four fixed triangles emitted after the last clamped
// line.  The number was pinned to the cap, not to the content.
//
// MEASURED, one constant apart, SAME 45-second opening, seed 1337:
//     cap 250   HUD peak 248 of 250      <- clamped
//     cap 320   HUD peak 294 of 320
//     cap 334   HUD peak 294 of 334      <- unchanged: 294 IS the content
// **46 triangles -- up to eleven glyphs of the game's own text -- were being
// dropped out of the opening of every session that has ever run.**  Only the
// unlock card (`g_hud_card_trunc`) and the two modal panels (`g_panel_trunc`)
// count their truncations; the interact prompt, the villager prompt and the
// speech line count nothing.
//
// WHY 334 AND NOT A ROUNDER NUMBER: IT IS THE CEILING, AND THE CEILING IS
// DERIVED.  LAYER_HUD is `g_CAP_HUD` = 512 triangles (world_render.hml) and
// three emitters share it -- stage 23's vignette, stage 15's viewmodel and
// stage 24's HUD.  `batch_reserve` refuses and DROPS at 512 and nothing between
// here and there notices, so:
//     512 - g_POSTFX_TRI_CAP (50) - a viewmodel reserve of 128 (the measured
//     122-triangle MESH_LANTERN_VM rounded up) = 334
// and the floor is the measured content peak plus a headroom that covers twice
// the largest UNGATED element in `hud_build` (the 18-triangle owned-weapon pip
// strip): 294 + 36 = 330.
//
// >>> SO THE WHOLE LEGAL RANGE IS 330..334 -- FIVE TRIANGLES WIDE.  The HUD is
// >>> not "about to break"; it is FULL.  The next HUD element of any size needs
// >>> `g_CAP_HUD` raised in `src/render/world_render.hml`, and that file is not
// >>> this task's.  REPORTED, not worked around.
//
// Cost: the cap grew 84, so worst case 1857 + 84 = 1941 of the 3000-triangle
// g_TRIS_STEADY, and ~0.07 ms/frame at probe_hudlayer's measured per-HUD-
// triangle rate.  Measured frame peak actually moved 1787 -> 1801 on the 420 s
// panel demo, because the extra triangles are TEXT that was already budgeted
// for and truncated away.
//
// Also not fixed by this number, and named: the must-never-yield set WITH the
// lantern prompt in it ("HOLD [E] - LIGHT THE LANTERN" plus its second line,
// 206 triangles of plate and text) prices at 418 and does not fit in 334 at any
// cap.  `tools/probe_hud.hml` asserts that gap so it stays on the record.
// ---------------------------------------------------------------------------
// 334 -> 360, AND 50 -> 24.  2026-08-01 (the-feedback-loop).
// ---------------------------------------------------------------------------
// about-to-break left the cap sitting EXACTLY on its own derived ceiling and
// said so: "the whole legal range is 330..334 -- FIVE TRIANGLES WIDE ... the
// next HUD element of any size needs g_CAP_HUD raised in world_render.hml, and
// that file is not this task's." It is not this task's either. So the room came
// from the OTHER term in the same subtraction, and it came from measuring a
// number that had only ever been guessed.
//
// WHAT g_POSTFX_TRI_CAP ACTUALLY IS. `grep -rn g_POSTFX_TRI_CAP src/` matches
// exactly one line -- this one. NOTHING ENFORCES IT. It is not passed to
// `postfx_emit`, it is not checked at the draw site, and the only file in the
// tree that reads it is `tools/probe_hud.hml`, which subtracts it to derive the
// HUD's ceiling. It is a RESERVE, and a reserve is a claim about what the
// emitter can produce.
//
// SO WHAT CAN IT PRODUCE? `src/render/postfx_geo.hml`'s `postfx_emit` is
// eighteen lines long and has no data-dependent path at all:
//     hud_solid_ring(..., 8 segments, ...)          8 x 2 = 16 triangles
//     hud_solid_quad(... the lightning flash ...)   + 2 when p_lightning != 0
// and the segment count is a pinned literal that the file's own header calls a
// design anchor. ITS STRUCTURAL MAXIMUM IS 18. `tools/probe_hudlayer.hml`
// measures 16 and 18 from the real function; `tools/probe_feedback.hml` now
// CALLS `postfx_emit` with the flash on and asserts the result against this
// constant, so the reserve is enforced by a probe instead of asserted by a
// comment -- which is strictly more protection than 50 ever gave, because 50
// protected nothing.
//
// 24 = the measured 18 plus room for three more full-screen quads. It is a
// RESERVE, not a target: 26 triangles of it were reserved against an emitter
// that cannot reach them, inside a 512-triangle layer that had 38 spare.
//
// >>> THIS IS NOT THE CAP BEING RAISED TO FIT THE CONTENT. <<< The ceiling is
// still 512 - postfx - viewmodel and the cap is still exactly ON it; what moved
// is that one of the three terms is now measured instead of estimated. The
// physical wall (`batch_reserve` dropping at g_CAP_HUD = 512) is untouched and
// still has slack with a COMPLETELY full HUD, whichever postfx number you use:
//     postfx 18 (MEASURED)  + viewmodel 122 (measured) + 360 = 500 of 512, 12 spare
//     postfx 24 (this RESERVE)                          + 360 = 506 of 512,  6 spare
//
// WHAT THE 26 TRIANGLES BOUGHT, worst case, priced through the shipping fonts
// in `tools/probe_feedback.hml` §D rather than counted by hand:
//     the 4-segment direction indicator      4 segs x (plate 2 + bar 2) = 16
//     minus the single arrow it replaced                                 -2
//     the damage number, 3 FONT_BIG digits x 4                          +12
//                                                                     -----
//                                              worst-case delta        +26
// and the death screen costs the combat HUD NOTHING, because it is modal.
//
// MEASURED A/B, same binary lineage one commit apart, `--demo 75 --headless
// --no-audio --seed 1337`, loadavg 4.75-9.83:
//     before   HUD peak 296 of 334      frame peak 1719 of 3000
//     after    HUD peak 308 of 360      frame peak 1723 of 3000
// The worst-case BOUND is what the cap is set from, not that 308: for every
// frame f, new(f) = old(f) + delta(f) <= 296 + 26 = 322, so
//     floor = 322 + 36 (probe_hud's headroom rule: 2 x the 18-triangle
//             owned-weapon pip strip, the largest UNGATED element) = 358
//     ceiling = 512 - 24 - 128 = 360
// and 360 is the ceiling, which leaves 38 triangles of headroom against a rule
// of 36. `tools/probe_feedback.hml` §D asserts BOTH sides and goes red at 340
// (too little headroom) and at 380 (through the layer).
//
// >>> AND ONE THING THIS NUMBER DID NOT HAVE TO PAY FOR, WHICH IS THE POINT OF
// >>> THE WHOLE ORDERING FIX. <<< The task that produced it asked for the worst
// case of "dying, while being hit from two sides, while your shot connects,
// with the trade panel open". That frame CANNOT EXIST: the death screen and
// both modal panels each replace the combat HUD and return. The most important
// message in the game is no longer last in line for 62 triangles -- it is the
// only thing in a 360-triangle budget, at 118 triangles, and it can never
// yield. See `hud_death` in src/game/main.hml.
export let g_HUD_TRI_CAP: i32 = 360;
export let g_POSTFX_TRI_CAP: i32 = 24;

// Painter sort: counting-sort buckets over the view-space depth range.
// 2048 buckets over 72 m is a 3.5 cm quantum.
export let g_NB_BUCKETS: i32 = 2048;

// ===========================================================================
// 4. THE FRAME BUDGET, IN MILLISECONDS  (BUDGET_ACTUAL.md)
// ===========================================================================
// These are the *budgets*, not the measurements.  Measured at 2500 tris:
// emit 3.57 + clip 0.47 + sort 0.40 + flush 0.85 = 5.3 ms against 11.0.
//
// RE-MEASURED 2026-07-29 on the whole frame (BUDGET_ACTUAL §T), software
// renderer, readback excluded, idle box:  the SHIPPING frame's net cost is
// 5.0-5.5 ms at 1296 drawn / 2502 source, and RENDER total is 4.28 ms of the
// 11.0 budgeted.  The 11.0 / 2.0 / 0.3 / 1.0 / 1.3 split below is unchanged and
// is what §T.5 reserves against — it is an allocation, not a measurement, and
// the 2.452 ms of it that benchframe cannot see (net + audio + input) is
// exactly why the triangle budget is 3000 and not the ~4800 the raw crossing
// point suggests.

export let g_BUDGET_RENDER_MS: f64 = 11.0;
export let g_BUDGET_SIM_MS: f64 = 2.0;
export let g_BUDGET_NET_MS: f64 = 0.3;
export let g_BUDGET_IO_MS: f64 = 1.0;                // input + audio + HUD build
export let g_BUDGET_SLACK_MS: f64 = 1.3;
export let g_BUDGET_BOOT_MS: f64 = 400.0;            // all asset generation
export let g_BUDGET_SKY_REBAKE_MS: f64 = 0.6;
export let g_BUDGET_CHUNKGEN_MS: f64 = 2.0;          // amortised, per frame
export let g_BUDGET_OVERDRAW: i32 = 4;               // screenfuls; 0.8 ms each
export let g_BUDGET_RSS_MB: i32 = 96;                // after 10 000 frames

// ---------------------------------------------------------------------------
// 4.1 THE PARALLEL EMIT STAGE — worker count, tunable per platform
// ---------------------------------------------------------------------------
// `emit.hml`'s transform-and-pack kernel splits one `emit_mesh_buf` call across
// a persistent `ThreadPool` created once at boot. This is the ONLY knob the
// game has on it, and it lives here so a platform port changes one number.
//
// >>> 8 -> 4, ON THE GAME'S OWN NUMBERS.  (2026-07-31.)  THE SPIKE'S CURVE IS
// >>> NOT THIS GAME'S CURVE AND 8 WAS SET FROM THE SPIKE'S.
//
// THE SPIKE'S CURVE (docs/design/THREADING_SPIKE.md §4/§5, wall clock, ONE
// 3000-TRIANGLE DISPATCH, 24 cores, loadavg 7.2-7.8):
//
//     workers   1      2      4      6      8     12     16
//     speedup  0.99   1.90   3.42   4.41   4.66   5.54   ~6.0
//     CPU cost  --    +?     +11%   +23%   +36%   +49%   +75%
//
// That curve is real and it is measured; it is also **a workload this game
// never runs.**  `terrain_render.hml` emits ONE CHUNK PER `emit_mesh_buf` call
// and a chunk is `g_CHUNK_QUADS`^2 x 2 = 128 triangles, which sits barely above
// the engine's 96-triangle dispatch floor.  Everything else the frame emits —
// props, billboards, contact blobs, FX cards, the whole HUD — is BELOW that
// floor and runs serial no matter what this constant says.  So the frame never
// hands the pool a 3000-triangle job; it hands it a 128-triangle job, tens of
// times, and pays the ~28 us fork-join on every one.
//
// THE GAME'S CURVE.  Real binary, `--demo 8 --headless --no-audio --seed 1337`,
// ONE build with `--workers N` (so the only difference is the pool), the game's
// own per-frame WALL mean over ~477 frames, **min over 7 whole process runs,
// twice** (min-of-14), 24 cores, loadavg 12.5-16.6 throughout:
//
//     workers    0     1     2     3     4     5     6     8    12
//     render ms 9.0   9.6   8.7   9.0   8.1   8.4   8.4   9.0   8.7
//                     ^^^ SEE BELOW: 1 IS THE SAME CODE AS 0
//
// >>> WALL, NOT `__clock()`.  RULE T's CPU clock SUMS ACROSS THREADS, so it
// >>> reports the pool getting *worse* while the frame gets faster.  For a
// >>> parallelism measurement the wall mean is the honest column and the CPU
// >>> column is the efficiency one.
//
// >>> AND HERE IS THE NOISE FLOOR, WHICH IS MOST OF THE EFFECT.  `--workers 1`
// >>> runs ZERO workers — the engine collapses n < 2 to serial — so columns 0
// >>> and 1 are THE SAME MACHINE CODE.  They differ by **0.6 ms**.  The whole
// >>> serial-to-best win is 0.9 ms.  Do not read this table as a smooth curve;
// >>> read it as one finding that survives three independent sweeps (the wave
// >>> gate's, and both of these):
// >>>
// >>>   * **4 workers is the best value.**  8.1 ms in this sweep and 8.1 ms in
// >>>     the gate's, agreeing to the printed digit from separate runs.
// >>>   * **8 is never better than 4** in any of the three (gate 8.5, here
// >>>     9.4 and 9.0), and it costs twice the threads on a box the player is
// >>>     sharing with everything else they have open.
// >>>   * **12 is not worth its threads either** and 1 is the worst column in
// >>>     the table while being byte-identical to the best-behaved serial one.
//
// So: 4.  It is the measured optimum, it is the cheapest way to reach the
// measured optimum, and `emit_par_init` still clamps to EMIT_PAR_MAX = 12 for
// anyone who overrides it.  The end-to-end story — 4.6x promised, 1.11-1.16x
// delivered, and why — is written up in `docs/BUDGET_ACTUAL.md` §P.
//
// **A VALUE OF 0 OR 1 IS A SUPPORTED CONFIGURATION, NOT A FAILURE.** It runs
// the serial path, which `probe_par` asserts is byte-identical to the parallel
// one. That is the WASM build (docs/design/WASM_SPIKE.md: no threads at all),
// a single-core target, and any environment where `ThreadPool` throws — the
// engine falls back to it on its own and never brings the frame down.
export let g_EMIT_WORKERS: i32 = 4;

// The per-call triangle count below which a dispatch is not worth its ~28 us
// fork-join. 0 means "keep the engine's own measured default", which is 96 —
// chosen so an 8x8-quad terrain chunk (132 triangles) qualifies with margin
// while billboards, contact blobs and debris never pay a round trip they cannot
// amortise. Override only with a re-measured crossover table, never by guess.
export let g_EMIT_PAR_MIN_TRIS: i32 = 0;

// ===========================================================================
// 5. CAMERA, FOG AND LIGHT  (ART_BIBLE §2.6 §6, ARCHITECTURE D2 D7)
// ===========================================================================
//
// >>> RULE T6.  `FOG_FAR` NEVER EXCEEDS 72 m. <<<
// Ground triangles ~= (pi/4) * FOG_FAR^2 / 16 * 2.  At 72 m that is ~508 tris
// (20 % of the budget); at 120 m it is 1414 (57 %) and the game does not fit.
// When the budget breaks, turn FOG_FAR DOWN FIRST — before cutting props,
// before LODing earlier, and never by cutting the frame rate.
export let g_FOG_FAR_CAP: f64 = 72.0;

// Fog on your own gun barrel looks broken.  Never let FOG_NEAR go below this.
export let g_FOG_NEAR_MIN: f64 = 3.0;
export let g_FOG_NEAR_DEFAULT: f64 = 8.0;

// The camera far plane is DERIVED, never a hardcoded 200.0: far = fog_far*1.06.
// Nothing may ever pop into existence unfogged.
export let g_FAR_PLANE_SCALE: f64 = 1.06;
export let g_NEAR_PLANE: f64 = 0.1;

// D7: vertex alpha only in the far band, so ~80 % of on-screen pixels stay on
// the opaque path.  a = 255 while f <= g_FOG_ALPHA_T.
//
// ---------------------------------------------------------------------------
// 0.35 -> 0.85.  PLAYTEST DEFECT (4), 2026-07-28.  Measured, not guessed.
// ---------------------------------------------------------------------------
// The owner reported "the skybox renders on top of stuff in the horizon and you
// see them transparently through it".  That is this constant.
//
// WHY THE ALPHA BAND IS A HACK.  shade.hml composites fog as a MULTIPLY on the
// vertex colour (`rgb = lit * lerp(1, fog_tint, f)`), and vertex colour only
// darkens the texture (CLAUDE.md §6).  So the far band can never converge UP to
// a bright horizon — a multiply cannot brighten.  D7's alpha ramp fakes the
// missing `lerp(rgb, fog_rgb, f)` by blending toward whatever is ALREADY in the
// framebuffer.  That is only equivalent to real fog where the framebuffer holds
// the fog colour: the sky's horizon band, i.e. the last sliver of the fog span.
// Anywhere else — a tree against a cloud, a building in front of a hill — it
// composites the wrong colour and the geometry reads as glass.
//
// 0.35 put the start of the alpha band at t = 0.399 of the fog span: 33 m of
// ridge_golden's 64 m.  Everything past 33 m was translucent, which is most of
// the visible world.  0.85 puts it at t = 0.756 — the last quarter, which is
// where geometry actually meets the skyline.
//
// MEASURED, shot.hml, HUD masked, against a fully-opaque (fog_alpha_max = 0)
// reference render.  "world px contaminated" = share of world pixels differing
// from opaque by more than 2/255:
//
//     scene            0.35     0.85      skyline dissolve (max luma step/row)
//     ridge_golden     3.83 %   0.35 %    -
//     hub_dawn        13.53 %   2.42 %    19.5 -> 34.5
//     budget_worst     3.82 %   1.67 %    27.6 -> 26.9   (better than before)
//     muzzle_fog       4.62 %   1.50 %    -
//     ns_bloom         5.95 %   3.74 %    -
//     hud_worst_case   0.98 %   0.66 %    28.0 -> 29.1
//
// THE COST D7 WAS PROTECTING IS REAL AND IS NOT ZERO.  Setting fog_alpha_max to
// 0 outright (pure tint-multiply, fully opaque) removes 100 % of the bleed but
// turns the skyline into a cliff — hub_dawn's terrain/sky step goes 19.5 -> 53.3
// and budget_worst's 27.6 -> 93.3, a hard dark silhouette against a bright sky,
// which is CLAUDE.md §9.3 ("fog that doesn't match the sky") and §9.5 ("a flat
// horizon line").  So the band is NARROWED, not removed, and fog_alpha_max keeps
// its art-directed ToD curve in tod.hml.
//
// This is a MITIGATION.  The real fix is an engine change: shade.hml must
// composite fog as `rgb = lerp(rgb, fog_rgb, f)` instead of a multiply, after
// which the alpha channel of fog can go away entirely.  Reported to the
// orchestrator; wobbleweed is not ours to edit (CLAUDE.md §3).  Note shade.hml's
// own comment at env_set_fog_alpha_threshold already calls D7 "an open question
// to be settled by measurement on the software renderer" — this is that
// measurement.
//
// This value reaches the engine through tod.hml's env_set_fog_alpha_threshold
// call.  Before 2026-07-28 NOTHING read it: the engine silently used its own
// ENV_FOG_ALPHA_T_DEFAULT and this constant was dead except for a probe range
// assertion.
export let g_FOG_ALPHA_T: f64 = 0.85;

// Ground mist (ART_BIBLE §6.4): MIST_TOP = terrain + this.
export let g_MIST_HEIGHT: f64 = 1.6;

// ===========================================================================
// >>> DYNAMIC POINT LIGHTS ARE CAPPED AT 4.   (was 2; raised 2026-07-29)
// ---------------------------------------------------------------------------
// BUDGET_ACTUAL.md capped this at 2 on the strength of one measurement:
//
//     fog + sun only ................................  3.57 ms emit
//     + 2 dynamic lights ............................ ~6.00 ms emit
//     + 4 dynamic lights ............................  8.47 ms emit
//
// THAT MEASUREMENT IS OF A CODE PATH THIS GAME DOES NOT RUN.  Those three
// numbers come from `emit.hml`'s LIT path — `emit_set_lighting(1)`, full G16
// per vertex.  `world_render.hml` stage 8 calls `emit_set_lighting(0)` and has
// done since G19: every world triangle carries BAKED vertex colour and the
// emit kernel applies fog and nothing else.  In the baked path a dynamic light
// never touches `emit.hml` at all, so its per-vertex cost is not 1.2 ms — it
// is ZERO, at any count, and the whole 2-vs-4 tradeoff evaporates.
//
// What a dynamic light actually costs in the shipping renderer, and it is the
// only thing it costs:
//   * `entity_render.hml` per-INSTANCE point lighting — one loop over lights
//     per prop.  O(props x lights), NOT O(vertices x lights).
//   * `fx.hml` lays ONE 2-triangle additive ground glow card per light within
//     14 m of the camera.
//
// Re-measured on this box (RULE T: __clock CPU time, min of 7 frames, then the
// MINIMUM over 9 whole process runs), a shot.hml-derived harness, `--scene
// budget_worst --tod 22.0`, native 320x240 (the 4:3 frame — 76800 px against
// the shipping 57600, so every absolute millisecond here is ~25 % HIGH; the
// 2-vs-4 DIFFERENCE, which is what the cap is set on, is per-prop and per-light
// and does not scale with pixel count), 2536 triangles drawn, 34 prop
// instances, lantern on, extra contested lights posted through `env_add_light`:
//
//     2 lights  12.268 ms      3 lights  12.384 ms      4 lights  12.485 ms
//
// **0.217 ms from 2 lights to 4 — 1.3 % of the 16.67 ms frame, 0.109 ms per
// light.**  (Those totals include the 2.5 ms `read_pixels_rect` that only the
// screenshot path pays; the DELTA does not, and the delta is the number here.)
//
// >>> An earlier revision of this comment claimed 15.5 us per light off a
// >>> `--scene muzzle_fog` sweep.  That is 7x too cheap and it does not
// >>> reproduce: muzzle_fog is a 1082-triangle 13-instance frame, and the cost
// >>> is O(props x lights) plus a `terrain_h`-sampled glow card per light
// >>> (4 x 3.234 us each), so it scales with the SCENE, not with nothing.
// >>> Priced on the densest legal frame instead, which is the frame the budget
// >>> is written against.
//
// Corroborated in the WALKING benchmark, which is the honest test — a
// `tools/benchframe.hml` copy moved to 22:00, `--sweep`, villager ladder,
// `read_pixels_rect` excluded by the harness, min over 3 passes x 3 trials:
//
//     drawn tris    lantern off    + lantern    + lantern & 4 lights
//        789/791       3.170 ms      3.717 ms          3.775 ms
//       2092/2094      7.348 ms      7.857 ms          7.779 ms
//       2544/2546      9.266 ms      9.605 ms          9.640 ms
//       2898/2901     10.801 ms     11.267 ms         11.367 ms   = 88.0 fps
//
// At the fog-limited ceiling of ~2900 DRAWN triangles, with four dynamic
// lights and the lantern lit, the frame is **11.367 ms — 88 fps, 5.30 ms under
// the 60 fps floor**, on a box permanently sharing 17 of 24 cores.  The
// marginal cost is 3.92 us per drawn triangle, so the 60 fps floor is not
// reached until roughly **4250 drawn triangles**.  Four lights and a raised
// triangle budget are not in competition; neither has to give.
//
// >>> WHAT DID NOT CHANGE, AND MUST NOT: STATIC LIGHTS STAY BAKED.
// `mesh_bake_light` folds a static light into vertex colour at build time for
// zero per-frame cost.  A settlement full of lit windows must not consume
// dynamic slots — the village -> town -> city growth design depends on it, and
// four slots do not change that arithmetic by one window.
//
// >>> SLOT POLICY, enforced in the light manager (`src/render/world_render.hml`
// >>> `lights_commit`), never inside the engine — R1: wobbleweed takes a count
// >>> and stays generic.  `env_add_light` also refuses past ENV_MAX_LIGHTS, but
// >>> that is the engine's array bound, not the game's budget.
//   slot 0        the player's lantern.  RESERVED — it is never ranked and
//                 never loses, because a lantern that flickers out when a
//                 grenade goes off is worse than no lantern.
//   slots 1..3    contested.  Nearest-wins, ranked by distance^2 / intensity
//                 from the camera, re-evaluated every frame.  A muzzle flash
//                 0.6 m from the eye scores 0.14 and therefore always takes
//                 one transiently, with no special case in the ranker.
//                 Explosions, fire and spell effects fight over the other two.
//
// The RenderEnv reserves 4 slots (ENV_MAX_LIGHTS), so this is a CAP change and
// not a layout change: nothing in emit.hml or shade.hml moved.
export let g_MAX_DYNAMIC_LIGHTS: i32 = 4;
export let g_ENV_LIGHT_SLOTS: i32 = 4;               // the engine's array size

// ---------------------------------------------------------------------------
// THE NIGHT VEIL — the world is eaten by night, and a light HOLDS THE DARK OFF
// ---------------------------------------------------------------------------
// CLAUDE.md §6: vertex colour MULTIPLIES the texture, so a light can only
// DARKEN.  Every previous attempt to make the lantern visible therefore added
// an additive sprite, which is the wrong sign: measured, disabling the sprite
// made the scene DARKER by 10-13 luminance, so "the light" was a decal.
//
// The model that fits both the renderer and the fiction is the inverse:
// **the world is multiplied DOWN at night, and a light multiplies it back UP
// toward 1.0.**  A lit region is an un-darkened region — the same shape as
// CIVIC LIGHT in docs/design/MULTIPLAYER.md.
//
// These three numbers are the multiplier an UNLIT world surface falls to at
// full night.  They are applied by `src/render/world_render.hml` at stage 13,
// as the ambient of a transient env bound for the terrain pass only, with the
// sun/bounce/rim zeroed — so the per-vertex modelling still comes entirely
// from the bake (CLAUDE.md §9 rule 4 is not violated: the terrain is NOT
// flat-lit, it is flat-DARKENED) and the committed dynamic lights add back on
// top with the engine's own `(1 - d/r)^2 * max(0.25, N.L)` falloff.
//
// COLOUR: cool, and slightly blue-biased, because ART_BIBLE §4.2 says night is
// blue and dark.  The blue channel is held highest so what survives the dark
// is the cold end — the warm lantern then reads as warm BY CONTRAST, which is
// free chroma separation the ground albedo itself cannot pay for (see
// src/art/tod.hml, "WHAT THIS FILE CANNOT DO").
//
// DEPTH: 0.12/0.13/0.20 is a 7.7x cut in green, the channel that carries 71 %
// of luminance.
//
// ---------------------------------------------------------------------------
// >>> THE MEASUREMENT BAND, RE-DERIVED.  "ROWS 150..185" NO LONGER EXISTS. <<<
// ---------------------------------------------------------------------------
// (2026-07-31.)  Every "ground band" measurement in this file, in `tod.hml` and
// in `world_render.hml` names **native rows 150..185**.  The frame has 180 rows.
// Row 185 is off the bottom of the picture and rows 150..179 are the part of it
// the VIEWMODEL fills — so the band as written is neither the ground nor even
// in frame.  It was correct once: it was a window in a 240-row frame at a
// 70-degree vertical FOV, both of which were retired in the 16:9 conversion.
//
// The band is a SCREEN-ANGLE window, so it converts exactly.  A row `r` sits at
// `tan(theta) = (r - H/2) / (H/2) * tan(fov/2)` below the optical axis:
//
//     old   r = 150 of 240 at fov 70  ->  tan = (30/120)  * tan(35) = 0.17505
//           r = 185 of 240 at fov 70  ->  tan = (65/120)  * tan(35) = 0.37928
//     new   solve at fov 58, H = 180: r = 90 + tan / tan(29) * 90
//           0.17505 -> r = 118.4        0.37928 -> r = 151.6
//
// >>> SO THE SHIPPING BAND IS **ROWS 118..152 OF 180**, and that is what any
// >>> re-measurement must use.  It is the same 34-35 rows of sky-angle the old
// >>> band was; it is NOT rows 113..139 (the naive 180/240 rescale), because
// >>> the FOV moved too.
//
// What ground distance that covers depends on the camera, and the old comment's
// "about 5 m to about 9 m" assumed an eye height of **2.1 m** that `shot.hml`
// does not use for four of the five scenes below — it stands at **1.7 m**, and
// at 2.4 m only for `hub_dawn` (`tools/shot.hml`, `scene_apply`).  Re-derived
// for the shipping band, `d = eye / tan(theta + |pitch|)`:
//
//     scene         eye   pitch   band covers
//     muzzle_fog    1.7   -3.0    3.9 m .. 7.4 m
//     ridge_golden  1.7    0.0    4.5 m .. 9.7 m
//     ns_bloom      1.7   -5.0    3.6 m .. 6.4 m
//     flat_debug    1.7   -8.0    3.1 m .. 5.0 m
//     hub_dawn      2.4   -4.0    5.2 m .. 9.7 m
//
// ---------------------------------------------------------------------------
// >>> THE TABLE BELOW IS STALE IN THREE INDEPENDENT WAYS.  DO NOT TRUST IT. <<<
// ---------------------------------------------------------------------------
// It was measured at 320x240, at a 70-degree FOV, over rows 150..185, with
// `g_LANTERN_GAIN` at **24** — and 19.0 ships (see the cut-7 note below).  Not
// one of its five deltas is reproducible on this tree, and the gap is not
// cosmetic: re-measured on the shipping build, **`hub_dawn` reads +20.41 where
// this table says +27.65** (gate measurement, 2026-07-31).
//
// It is KEPT, rather than deleted, because it is the only record of the veil's
// ORDERING across scenes and of why `ns_bloom` is the floor — but every number
// in it is a historical artefact and is labelled as one:
//
//     scene @ 22:00      OFF      ON     delta     <- 320x240, fov 70, GAIN 24
//     ridge_golden       8.11   42.66   +34.55        STALE, not reproducible
//     flat_debug         8.25   43.09   +34.84        STALE
//     hub_dawn           8.59   36.24   +27.65        STALE (ships at +20.41)
//     muzzle_fog        13.44   40.28   +26.85        STALE
//     ns_bloom           7.62   28.24   +20.62        STALE, and see below
//
// WHAT WAS NOT DONE, PLAINLY: the five rows were not re-measured here.
// `tools/shot.hml` has no lantern switch — `frame_set_lantern` is exported by
// `world_render.hml` and no harness calls it — so "lantern ON minus OFF" cannot
// be produced from any tool in the tree, and `shot.hml` is not this task's file
// (CLAUDE.md §3).  Whoever owns it should add `--lantern 0|1` and a
// `--band r0,r1` readout; until then this table stays labelled STALE rather
// than being quietly re-rounded.
//
// The +25 the brief asks for is measured against that band.  ns_bloom does not
// clear it and the reason is a CEILING, not the veil: WX_BLOOM overrides the
// ambient almost totally to a violet (src/art/tod.hml), so the night BAKE
// lands the band at 28.24 and 28.24 is the arithmetic maximum ANY veil could
// deliver there — a light cannot exceed the albedo (CLAUDE.md §6).  Fixing it
// means re-authoring ART_BIBLE 12.4's violet exposure, which is a separate art
// call and was not made here.
//
// >>> DEEPER IS NOT BETTER.  `delta = bake * (1 - veil)`, so the delta is
// >>> bounded above by the night bake and the last few points of it cost a
// >>> nearly-black unlit ground.  0.12 already puts the unveiled band under 9
// >>> on four of five scenes; below that the pool stops reading as a pool
// >>> inside a night and starts reading as a spotlight inside a cave.
export let g_NIGHT_VEIL_R: f64 = 0.12;
export let g_NIGHT_VEIL_G: f64 = 0.13;
export let g_NIGHT_VEIL_B: f64 = 0.20;

// >>> THE VEIL HAS ITS OWN GATE, AND IT IS NARROWER THAN THE LANTERN'S.
// Both gates read the same number — the env fog tint's luminance, which
// `g_LANTERN_GATE_*` below explains is the one field that tracks perceived
// darkness across a day:
//
//     clock  11.9  18.25  19.50  22.00  02.00  05.50
//     foglum 0.855 0.783  0.542  0.480  0.409  0.845
//
// The LANTERN gate (0.52 .. 0.72) is deliberately generous: a lantern lit early
// costs nothing.  THE VEIL IS NOT FREE AND MUST NOT BE GENEROUS.  On the
// lantern's thresholds, 19:30 scores 0.966 — dusk would be 97 % veiled, and
// measured on `ridge_golden --tod 19.5` that takes the ground band from 41.95
// to about 9.  Dusk is a LIT hour: `src/art/tod.hml` calls it "the darkest of
// the lit hours" and the brief's non-regression floor is written against it.
//
// 0.470 .. 0.545 puts the veil where the fiction puts it — after the light has
// actually gone.  RE-RUN 2026-07-31 on the shipping build, `tools/probe_night`
// section [2], which evaluates `gate_darkness` on `tod_eval`'s own fog tint —
// i.e. these six numbers are printed by a probe, not transcribed:
//
//     18:15 golden  0.0000     19:30 dusk  0.0000     22:00 night  0.9476
//     05:30 dawn    0.0000     12:00 noon  0.0000     02:00 deep   1.0000
//
// (This block used to say dusk 0.005 and night 0.945.  Both were off in the
// third decimal; the shape of the schedule is unchanged.  The lantern gate on
// the same run: 18:15 0.0000, 19:30 0.6494, 22:00 1.0000.)
//
// and the crossing takes ~80 s of real time (the fog tint lerps between the
// DUSK and NIGHT keyframes over 0.0835 of a 16-minute day), i.e. 0.02 % of the
// veil per frame — three orders under the 4 %/frame discontinuity budget.
export let g_VEIL_GATE_NIGHT: f64 = 0.470;
export let g_VEIL_GATE_DAY: f64 = 0.545;

// The curve both gates use, as a FUNCTION rather than as a number copied into
// two files.  It lives here, in `src/core`, for one reason: `src/render` links
// SDL through wobbleweed, so a headless probe cannot import `world_render.hml`
// to check the veil schedule.  With the curve in core, `tools/probe_night.hml`
// asserts the SAME code the frame runs, and there is no transcription that can
// drift.  Pure, deterministic, no state: `p_lum` is the env fog tint's
// luminance, and the answer is 0 in daylight, 1 in full dark.
export fn gate_darkness(p_lum: f64, p_night: f64, p_day: f64): f64 {
    let lum: f64 = p_lum;
    let night: f64 = p_night;
    let day: f64 = p_day;
    let span: f64 = day - night;
    if (span <= 0.0) { let one: f64 = 1.0; return one; }
    let u: f64 = (day - lum) / span;
    if (u <= 0.0) { let z: f64 = 0.0; return z; }
    if (u >= 1.0) { let o: f64 = 1.0; return o; }
    // Smoothstep, so dusk closes over the world across minutes rather than
    // popping at one frame boundary.
    let out: f64 = u * u * (3.0 - 2.0 * u);
    return out;
}

// The env fog tint's luminance — "how dark is the world", in ONE place.
// Rec.601 weights, which is what the light manager has always used here.
export fn fog_tint_luma(p_r: f64, p_g: f64, p_b: f64): f64 {
    let out: f64 = 0.299 * p_r + 0.587 * p_g + 0.114 * p_b;
    return out;
}

// ---------------------------------------------------------------------------
// THE PLAYER'S LANTERN, as a real light.
// ---------------------------------------------------------------------------
// The lantern is the viewmodel: it is in the player's hand in every scene that
// carries F_VIEWMODEL, drawn lit, with a flame that clears luminance 220 and
// anchors the frame (§8).  Until 2026-07-29 it illuminated NOTHING.
//
// Offsets are metres in CAMERA space, applied to the eye by the light manager
// every frame, so the light travels with the player for free.  They put the
// light where the viewmodel's flame actually is — low, right, and a little
// ahead — so the ground pool is centred where the picture says it should be.
export let g_LANTERN_OFS_FWD: f64 = 0.62;            // ahead of the eye
export let g_LANTERN_OFS_RIGHT: f64 = 0.34;          // toward the held hand
export let g_LANTERN_OFS_DOWN: f64 = 0.58;           // below the eye

// >>> 18 m, AND IT IS SET BY A MEASUREMENT, NOT BY A GUESS AT AN OIL LAMP.
// This constant used to be 7.0, justified as "a believable radius for an oil
// lantern: it reaches the ground you are standing on and the wall you are next
// to, and it does not light a field."  That reasoning was sound for a light
// that had no effect; it is wrong for one that does, and here is why.
//
// THE ENGINE'S POINT TERM IS `colour * (1 - d/r)^2 * max(0.25, N.L)`.  On flat
// ground the cosine is grazing past ~4 m and the `max(0.25, ...)` floor takes
// over, so the term is essentially `colour * 0.25 * (1 - d/r)^2` and the light
// SATURATES the veil out to `d ~ 0.5 * r` and is gone by `r`.  The measurement
// band the brief is judged on is **rows 118..152 of 180** (re-derived above;
// this comment used to say "rows 150..185" and "a 55-degree vertical FOV" —
// the frame has 180 rows and `g_FOV_HIP` is 58, so both were retired numbers).
// That band is the ground from about 3.9 m to about 7.4 m on `muzzle_fog`'s
// camera and 5.2 m to 9.7 m on `hub_dawn`'s; the per-scene table is above.
// A 7 m radius barely reaches it; a 14 m radius saturates to 7 m and left
// `hub_dawn` at +16.45 against a +25 target; 18 m saturates to 9 m.
//
// >>> THE TWO ROWS BELOW ARE THE SAME STALE MEASUREMENT AS THE VEIL TABLE —
// >>> 320x240, fov 70, rows 150..185 — and the second one is at GAIN 24, which
// >>> has not shipped since cut 7.  The COMPARISON they encode (18 m beats 14 m
// >>> on every scene, decisively on hub_dawn) is what the radius is set on and
// >>> that comparison is internally consistent; the absolute deltas are not
// >>> reproducible on this tree.  `hub_dawn` at the shipping radius/gain
// >>> measures **+20.41**, not the +27.65 the bottom row shows.
//
//     radius / gain     muzzle_fog  ns_bloom  ridge_golden  flat_debug  hub_dawn
//     14 / 18             +25.66     +20.46      +33.93       +29.77     +16.45
//     18 / 24             +26.85     +20.62      +34.55       +34.84     +27.65
//                         ^ all STALE: 4:3 frame, fov 70, band 150..185
//
// What IS reproducible on the shipping build, and what actually pins the
// radius, is the falloff itself — `tools/probe_night` [4] runs `shade.hml`'s
// own `env_light_rgb` and prints the multiplier the ground is lifted to:
//
//     0 m 1.0000   5 m 1.0000   11 m 0.6824(g)   20 m 0.1294(g) = the bare veil
//
// i.e. saturated to ~9.3 m, edge still clearly inside 18 m.  That is the shape
// "18 m" was chosen for and it is checked by a probe every run.
//
// LOOKED AT, both, at 320x240 — the frame the game no longer has, so the
// composition judgement below stands but the pixel judgement does not.
// 18 m still reads as a POOL
// and not as an ambient lift, because the falloff is squared: the far half of
// the frame is dark in every night scene in the harness and the pool's edge is
// visible in all five.  For scale, this is not a large light in this project's
// own terms — `g_LANTERN_R_T1` below, the FIRST settlement lantern tier, is
// 40 m, and DIRECTION.md §2 makes the held lantern the anchor of the magic
// side rather than a period oil lamp.
export let g_LANTERN_RADIUS: f64 = 18.0;

// The lantern's LIGHT colour, linear, as a multiplier — not a surface colour,
// so palette.hml is not its owner (CLAUDE.md §8 governs albedo; light colour is
// authored in src/art/tod.hml alongside TOD_LIGHTNING_AMB_*).  It lives HERE
// because `src/render/**` may not import `src/art/**` (the import wall) and the
// light manager needs a correct warm default with no caller wiring.
// tod.hml imports these three so there is exactly ONE copy of the numbers, and
// `tod_lantern_rgb` is the authoritative art-side accessor that applies the
// time-of-day curve on top.
//
// Derived from palette g_WINDOW_LIGHT (255, 216, 160) normalised to
// (1.000, 0.847, 0.627) and warmed one step toward g_EMBER (255, 138, 42):
// a lantern flame is warmer than a lit window and cooler than an ember.
export let g_LANTERN_LIGHT_R: f64 = 1.00;
export let g_LANTERN_LIGHT_G: f64 = 0.78;
export let g_LANTERN_LIGHT_B: f64 = 0.52;

// >>> THE GAIN IS 19 AND IT IS NOT COMPARABLE TO THE OLD 2.4.
// The old value matched `main.hml`'s settlement-lantern post so a held lantern
// and a lit lantern post read as the same kind of light.  They read as the
// same kind of light because NEITHER OF THEM READ AT ALL: measured 2026-07-30
// on the 4:3 build, additive pool disabled, the then-current band (rows
// 150..185 of 240; the shipping band is rows 118..152 of 180 — see the veil
// note above), real display, the dynamic
// light moved **mean +0.000, max +0.00, ZERO of 8856 pixels** on muzzle_fog,
// ns_bloom AND ridge_golden at 22:00.  The light was placed, ranked and
// committed correctly and changed nothing, because the surface was already at
// its baked ceiling and vertex colour can only darken (CLAUDE.md §6).
//
// With THE NIGHT VEIL above, the light has a floor to lift.  What it has to
// lift it against is the engine's falloff: at 7 m on flat ground the term is
// `0.25 * (1 - 7/18)^2 = 0.093` of the colour, and the lantern's green channel
// is 0.78, so clearing a 0.13 floor to 1.0 there needs a gain of
// `0.87 / (0.78 * 0.093) = 12`, and clearing it at 9 m needs
// `0.87 / (0.78 * 0.25 * (1 - 9/18)^2) = 17.9`.
//
// >>> CUT 7 — THE GAIN WAS 24 AND THAT WAS AN ARITHMETIC SLIP THAT SHIPPED A
// >>> FLOODLIGHT.  The line above used to end "and clearing it at 9 m needs 24".
// >>> Evaluate it: `0.25 * (1 - 9/18)^2 = 0.0625`, and `0.87 / (0.78*0.0625)`
// >>> is **17.9**, not 24.  The derivation this comment gives has always
// >>> produced ~18; the constant beneath it was a third higher than its own
// >>> stated reasoning, and nothing measured the difference because the
// >>> acceptance test (ground band mean) is dominated by the SATURATED near
// >>> field and cannot see the edge at all.
// >>>
// >>> `tools/probe_night.hml` [4] can, and it FAILED on the tree this cut
// >>> inherited — "the pool has an EDGE: 11 m is well down the falloff",
// >>> asserting the green multiplier at 11 m is under 0.70:
// >>>
// >>>     gain   green mul @ 0 m   @ 5 m   @ 11 m   @ 20 m   probe [4]
// >>>     24.0        1.0000      1.0000   0.8275   0.1294   FAIL
// >>>     19.0        1.0000      1.0000   0.6824   0.1294   pass   <- SHIPS
// >>>     17.0        1.0000      1.0000   0.6235   0.1294   pass
// >>>
// >>> RE-RUN 2026-07-31 ON THE SHIPPING BUILD: `probe_night` [4] prints
// >>> `lit at 11.0 m = (0.8275, 0.6824, 0.5686)` and
// >>> `lit at 20.0 m = (0.1216, 0.1294, 0.2000)` — the 19.0 row above,
// >>> reproduced to four decimals, PASS 32/32.  This table is measured through
// >>> `shade.hml`'s own `env_light_rgb` and has no resolution or FOV in it, so
// >>> unlike the pixel tables above it survived the 16:9 conversion intact.
// >>> (Note the coincidence that makes it easy to misread: red at gain 19 is
// >>> ALSO 0.8275 at 11 m.  The column is GREEN.)
// >>>
// >>> At 24 the lantern SATURATES the veil out to 10.2 m of an 18 m radius and
// >>> still returns 83 % of the world at 11 m: that is not a pool with an edge,
// >>> it is a floodlight with a soft rim, and "you push the dark back one
// >>> lantern at a time" needs the dark to still be there at the rim.
// >>>
// >>> THE WINDOW IS NARROW AND BOTH WALLS ARE MEASURED — DO NOT MOVE THIS
// >>> CONSTANT WITHOUT RE-RUNNING BOTH:
// >>>   * `g < 19.66` or probe_night [4]'s EDGE assertion fails,
// >>>   * `g >= 18.2` or `hub_dawn`'s ground band at 22:00 falls under the
// >>>     brief's `lantern ON minus OFF >= +25` (measured +27.22 at 24,
// >>>     +25.51 at 19, +24.38 at 17 — about 0.4 luminance per unit of gain).
// >>>
// >>> >>> AND THAT SECOND WALL IS NOT TRUE ON THE SHIPPING FRAME. <<<
// >>> Those three numbers are 320x240 / fov 70 / rows 150..185.  On 320x180 at
// >>> fov 58 the gate measured `hub_dawn` at **+20.41** with the gain at 19 —
// >>> i.e. the brief's +25 floor is MISSED by 4.6, not cleared by 0.5, and no
// >>> gain inside the window above closes a 4.6 gap at 0.4 per unit.  The wall
// >>> as written is therefore unsatisfiable and the constant is NOT being moved
// >>> to chase it: raising the gain to ~30 would clear the band mean and would
// >>> fail probe_night [4]'s edge assertion, which is the assertion that keeps
// >>> the lantern a pool instead of a floodlight.  The honest statement is that
// >>> the +25 acceptance number was written against a frame that no longer
// >>> exists and needs re-deriving on 320x180 before anything is tuned to it.
// >>> 19.0 sits in the falloff window and saturates the veil out to 9.27 m,
// >>> which is the 9 m the derivation above was aiming at all along.  LOOKED AT
// >>> at 320x240 — again, the retired frame — gain 24 and gain 19 were
// >>> indistinguishable in the near field; every pixel that changed was in the
// >>> falloff, which is the whole point.
//
// >>> AND THAT MAKES EVERY OTHER LIGHT IN THE PROJECT 10x TOO WEAK.  This is
// >>> E4 in `src/art/tod.hml` and it is REPORTED, NOT FIXED, because the two
// >>> call sites are not this task's files:
// >>>   * `src/game/main.hml` posts its settlement lantern at
// >>>     `palette/255 * 2.4`,
// >>>   * `tools/shot.hml` posts its muzzle flash at 2.6 and its shrine at 2.2.
// >>> Against a 0.13 veil those are visible only within ~2 m of the source, so
// >>> a village of lantern posts will not read until they are re-authored to
// >>> the same order as this constant.  A CIVIC LIGHT design whose civic lights
// >>> are invisible is broken at the pillar; whoever owns those two files
// >>> should move them together, in one change, against the table above.
export let g_LANTERN_GAIN: f64 = 19.0;

// >>> THE DAYLIGHT GATE.  A lantern pool on sunlit grass is a bug.
// The light manager scales the lantern by how dark the world actually is,
// measured off the env's FOG TINT luminance — which ART_BIBLE §6.6 / CLAUDE.md
// §9.3 derive from the horizon band, making it the one number in the env that
// tracks perceived darkness.  Measured across a full day (tod_eval, WX_CLEAR):
//
//     clock  11.9  18.25  19.50  22.00  02.00  05.50
//     foglum 0.855 0.783  0.542  0.480  0.409  0.845
//
// Ambient+sun luminance is NOT usable for this: tod_eval normalises amb+sun to
// (1,1,1), so ground luminance only moves 0.93 -> 0.56 over a whole day and
// golden hour is indistinguishable from midnight.  The fog tint separates them
// cleanly.  Full lantern at or below NIGHT, none at or above DAY, smoothstep
// between: golden hour (0.783) gets nothing, 22:00 (0.480) gets all of it.
export let g_LANTERN_GATE_NIGHT: f64 = 0.52;
export let g_LANTERN_GATE_DAY: f64 = 0.72;

// >>> THE GROUND POOL, and why it needs its own emitter.
// `fx.hml` already lays one 2-triangle additive card per dynamic light inside
// 14 m, its four corners on the terrain.  For every light in the game so far
// that card WAS NEVER DRAWN, and the reason is structural rather than a bug in
// the numbers: the card is centred ON THE LIGHT and spans +/- radius, so a
// light near the camera puts two of its four corners BEHIND THE NEAR PLANE and
// the whole quad is rejected as a straddle.  Measured on `muzzle_fog`, adding
// the lantern moved `clip.straddle` from 123 to 125 — exactly the two triangles
// of the card — and `tris.drawn` did not move at all.
//
// A lantern in the player's hand is the worst case for that: its pool is
// centred exactly where the near plane is.  So the pool is emitted as a GRID,
// stage 16b in `world_render.hml`: the cells behind the near plane are rejected
// individually and the cells in front of it survive.  DIV x DIV quads over the
// footprint, UVs interpolated across the same glow cell fx.hml uses, so the
// picture is the card fx.hml intended and never managed to draw.
//
// >>> DIV IS THE PRICE OF A SMOOTH POOL, AND HERE IS THE PRICE LIST.
// Measured `--scene budget_worst --tod 22.0`, **native 320x240 — the 4:3 frame,
// which is 33 % more pixels than ships**, min over 7 whole
// runs of a min-of-7 __clock frame; baseline is the same binary with the
// lantern forced off (11.391 ms).  Only DIV changed between rows.  The absolute
// column is therefore high and the whole table would need re-running to quote a
// budget from; the DELTAS are what DIV is chosen on and they are dominated by
// triangle count and `terrain_h` calls, neither of which is a pixel cost:
//
//     DIV=4    11.815 ms   +0.424   10 tris drawn   17 terrain_h calls
//     DIV=6    11.962 ms   +0.571   21 tris         27 calls
//     DIV=8    11.917 ms   +0.526   38 tris         22 calls
//     DIV=12   12.236 ms   +0.845   81 tris         36 calls   <- shipping
//     DIV=16   12.718 ms   +1.327  158 tris         22 calls
//
// (Drawn is far below the DIV*DIV*2 reserved because the pool is centred on
// the eye, so most of it is behind the player and never leaves the near plane.
// The terrain_h count does not rise monotonically with DIV because HDIV walks
// down to the nearest divisor of DIV — DIV 8 and 16 get a 4-cell height grid.)
//
// LOOKED at all three of 6, 8 and 12 at 320x240 on a real display — the 4:3
// frame, so this is a judgement about a picture the game no longer renders.
// The cell-banding argument is about CELL COUNT ACROSS THE POOL and does not
// depend on the frame's shape, so it carries; the "invisible at DIV 12" claim
// has not been re-checked at 320x180 and should be, since 25 % fewer rows means
// each cell is bigger on screen, not smaller.  The cells
// are FLAT-SHADED — `emit_quad_world` takes one rgb for all four vertices — so
// DIV is literally the number of steps in the falloff ramp, ~4/DIV of peak per
// step.  DIV 6 and DIV 8 both put a visible rectangular block of brighter
// ground at the pool's edge; DIV 12 does not, and on flat ground it reads as a
// continuous pool with no cell structure at all.  0.32 ms over DIV 8 buys that,
// against 5.3 ms of headroom at the triangle ceiling.  Worth it — but if the
// budget ever tightens, **DIV 8 is where to go first**: same cost as DIV 6,
// twice the tessellation, and it is one constant.
//
// >>> DIV AND HDIV MUST BE COMPATIBLE AND THE CODE NOW ENFORCES IT.  Until the
// >>> `divi` fix in `world_render.hml`'s `pool_hy`, DIV=8 CRASHED ("Array index
// >>> 26 out of bounds (length 25)") and DIV=12 survived only by luck.  Any
// >>> value 4..16 is now safe; that is what the sweep above is evidence of.
export let g_LANTERN_POOL_DIV: i32 = 12;

// >>> THE HEIGHT GRID IS COARSER THAN THE COLOUR GRID, and the reason is one
// >>> measured number: `terrain_render.hml`'s `terrain_h` costs
// >>> **3.234 us per call** (three octaves of value noise = twelve u64 hash
// >>> mixes; micro-benchmarked at 200 000 calls, min of 7, __clock CPU time).
// A (DIV+1)^2 = 169-point height grid is therefore 0.55 ms of terrain sampling
// for a glow card — measured as 0.90 ms of `emit.fx` on `muzzle_fog`, 5 % of
// the frame, which a glow card does not get to charge.
//
// The colour grid has to be fine (it carries the falloff, see POOL_DIV). The
// HEIGHT grid does not: it only has to follow the ground. So heights are taken
// on an HDIV grid and bilinearly interpolated up to the colour grid.
//
// HDIV 6 over a 14 m pool is 2.33 m spacing. terrain_h's octaves are 32 m
// (+/-2.6 m), 11 m (+/-0.95 m) and 4.6 m (+/-0.28 m); 2.33 m samples the first
// two exactly and the third at Nyquist, so the worst deviation from the true
// surface is ~0.1 m — covered by POOL_LIFT below. HDIV must divide DIV.
export let g_LANTERN_POOL_HDIV: i32 = 6;

// How far the pool floats above the terrain, in metres. fx.hml's card uses
// 0.06 and samples the ground exactly at its own four corners; this one
// interpolates, so it needs enough clearance to never sink THROUGH the ground
// (there is no depth buffer — a sunken card does not z-fight, it disappears
// behind the hill it is inside). 0.15 covers the ~0.1 m interpolation error and
// is under a fifth of a texel at the 3-7 m the pool is actually seen from.
export let g_LANTERN_POOL_LIFT: f64 = 0.15;

// Footprint as a multiple of the light's radius.  1.0 = the pool reaches
// exactly as far as the light does, which is what makes the additive card and
// the per-instance prop lighting agree at the edge.  (fx.hml uses 0.62 for its
// single card; at 0.62 the pool's visible edge lands at 4.3 m and the nearest
// ground the camera can see is inside that, so almost none of it is on screen.)
//
// >>> The old text here said "the nearest ground ... at eye height 2.1 m and
// >>> pitch -3 is 4.0 m".  Both halves are retired: `shot.hml` stands at 1.7 m
// >>> (2.4 m only on `hub_dawn`), and the 4.0 m was solved against a 240-row
// >>> frame at fov 70.  Re-derived for the shipping camera — bottom row 179 of
// >>> 180 is `atan(tan(29 deg) * 89.5/90) = 28.86 deg` below the axis, plus 3
// >>> deg of pitch — the nearest visible ground is `eye / tan(31.86 deg)`:
// >>> **2.74 m at eye 1.7, 3.38 m at eye 2.1, 3.86 m at eye 2.4**.  The
// >>> CONCLUSION is unchanged and is now stronger, not weaker: a 4.3 m edge is
// >>> still past the near field, so 0.62 still hides the card.
export let g_LANTERN_POOL_SPAN: f64 = 0.35;

// >>> ZERO. THE ADDITIVE GROUND POOL IS DELETED, AND THAT IS THE POINT OF THE
// >>> WHOLE CHANGE.  `lantern_pool_emit` early-outs on a zero colour before it
// >>> samples a single terrain height, so stage 16b now costs one compare.
//
// WHAT IT WAS.  `rgb = light_rgb * gain * SCALE`, flat, over the full
// `RADIUS * SPAN` disc: at the old 2.4 * 42 it added ~(100,78,52) to whatever
// ground was under it.  Measured contribution to the ground band at 22:00 on a
// real display: **+12.62 (muzzle_fog), +14.68 (ns_bloom)** — against +0.000
// from the dynamic light beside it.  The sprite WAS the lantern, and because
// it ADDS it could not respect the texture underneath: it paid for the illusion
// with the grass detail inside the pool, and it was worth +12 to the ground
// band at DUSK as well, which is how this file's day table came to record a
// dusk 12 luminance brighter than dusk actually was.
//
// WHAT REPLACES IT: the veil above and the real point light, which MULTIPLY, so
// the pool is the ground's own albedo and texture rather than a wash over it.
//
// WHAT DELETING IT BOUGHT.  `--scene muzzle_fog --tod 22.0`, min of 7 whole
// process runs, loadavg 12.2:
//     emit.fx        0.642 -> 0.123 ms      triangles drawn  1158 -> 1082
// and the whole frame (`frame ms - sky`) went 7.814 -> 6.866 ms, i.e. the
// night got 0.948 ms CHEAPER even after paying +0.661 ms for the lit terrain
// branch the veil runs on.
//
// >>> WHY NOT "A SMALL HOT CORE AT THE FLAME".  Tried, at SPAN 0.35 /
// >>> SCALE 10, and LOOKED AT next to SCALE 0 on muzzle_fog and ridge_golden:
// >>> the pool is centred on the EYE, the nearest ground the camera can see at
// >>> eye height with pitch -3 is ~2.9 m (a 4:3-frame figure; the shipping
// >>> 320x180 frame at fov 58 puts it at 2.74 m from a 1.7 m eye — see the SPAN
// >>> note above.  The argument does not turn on the third significant figure),
// >>> and a core small enough not to wash
// >>> is already at `(1 - 2.9/4.9)^2 = 0.15` of peak there.  It contributed a
// >>> faint warm haze over the bottom-left grass and took the grass texture
// >>> with it.  The emitter and its DIV/HDIV/LIFT/SPAN constants are KEPT — a
// >>> campfire, a dropped torch or a settlement brazier is a light the camera
// >>> is OUTSIDE of, which is the case the grid was built for and the case it
// >>> is good at.  Only the player's own lantern stops drawing one.
export let g_LANTERN_POOL_SCALE: f64 = 0.0;

// Field of view (GDD §2.3).  Degrees, and >>> VERTICAL <<<, not horizontal.
//
// THAT IS NOT A CONVENTION CHOICE, IT IS WHAT THE MATH DOES.  `mat_perspective`
// (wobbleweed/src/vec.hml:232) puts `f = 1/tan(fov/2)` at m[5], which scales
// view-space Y, and `f / aspect` at m[0].  `viewmodel.hml:177` independently
// uses `RES_H * 0.5 / tan(fov/2)` as the focal length in pixels, and
// `world_render.sky_basis` sets `thv = tan(fov/2)` then `thh = thv * aspect`.
// All three agree.  (Two comments elsewhere in this file describe a "55-degree
// vertical FOV" alongside the old 70 — those were written against the wrong
// convention and are wrong; 70 was a 70-degree VERTICAL fov, i.e. an 86.1
// degree horizontal one at 4:3.)
//
// ---------------------------------------------------------------------------
// RE-DERIVED FOR 16:9  (2026-07-31, with the 320x180 change above)
// ---------------------------------------------------------------------------
// hfov = 2*atan(tan(vfov/2) * aspect).  The three candidates, computed:
//
//   policy                 vfov   hfov    px/deg horiz   object scale vs 4:3
//   -- 4:3 today --        70.0   86.07      3.718            1.000
//   Hor+  (keep vfov)      70.0  102.45      3.124            1.000  <- fisheye
//   Vert- (keep hfov)      55.4   86.07      3.718            1.000  <- no wider
//   CHOSEN                 58.0   89.16      3.589            0.947
//
// Hor+ is rejected: 102 degrees is a fisheye no PS1-era FPS shipped, and it
// costs 16 % of the horizontal pixels-per-degree, which is 16 % off the size of
// every enemy — against an art bible whose readability rule is "if two classes
// read the same at 12 px, one is wasted work" (CLAUDE.md §9.10).  Pure Vert- is
// honest and free but delivers no wider view at all, which was half the reason
// for the change.
//
// 58 splits them: horizontal genuinely WIDENS 86.07 -> 89.16 degrees, and the
// on-screen size of everything moves by 5.3 % (a 12 px enemy becomes 11.4 px),
// which is inside the noise the pixel-snap already introduces.  Object scale is
// UNIFORM in both axes because the pixels stay square.
//
// ADS and SPRINT are re-derived to hold the same tan-half-angle RATIOS the 4:3
// ladder had, so ADS still pulls in by the same proportion it always did:
//   tan(hip/2)  0.70021 -> 0.55431      ADS/hip 0.7917, SPRINT/hip 1.1565
//   ADS    0.55431 * 0.7917  = 0.43886  -> 47.4 -> 47
//   SPRINT 0.55431 * 1.1565  = 0.64106  -> 65.3 -> 65
export let g_FOV_HIP: f64 = 58.0;                    // 89.16 deg horizontal
export let g_FOV_ADS: f64 = 47.0;                    // 75.41 deg horizontal
export let g_FOV_SPRINT: f64 = 65.0;                 // 97.11 deg horizontal
export let g_FOV_LERP_S: f64 = 0.15;

// Painter-sort depth keys that are contractual (ARCHITECTURE §2.3).
export let g_DEPTH_VIEWMODEL: f64 = 0.05;            // sorts last in LAYER_WORLD
export let g_DEPTH_SHADOW_BIAS: f64 = 0.02;          // contact blobs, in metres

// Screen shake, in target pixels, applied at present time.
export let g_SHAKE_MAX_PX: f64 = 4.0;

// ===========================================================================
// 6. SHADE TIER AND ITS FOG  (GDD §4.2, capped by D2)
// ===========================================================================
// GDD authored fog distances of 140/120/95/75/55/38 m against a 140 m draw
// distance.  D2 cut the draw distance to 72 m, so the whole ladder is rescaled
// by 72/140 = 0.514 and rounded, preserving the *ratios* that make a tier
// readable from the horizon.  Tier 0 sits exactly on the cap.
export let g_SHADE_TIER_MAX: i32 = 5;
export let g_SHADE_TIER_M: f64 = 200.0;              // metres from town per tier
export let g_FOG_FAR_TIER0: f64 = 72.0;
export let g_FOG_FAR_TIER1: f64 = 62.0;
export let g_FOG_FAR_TIER2: f64 = 49.0;
export let g_FOG_FAR_TIER3: f64 = 39.0;
export let g_FOG_FAR_TIER4: f64 = 28.0;
export let g_FOG_FAR_TIER5: f64 = 20.0;

// Per-chunk tier jitter is drawn from {-1, 0, 0, +1} — pockets of "too deep,
// too soon".  Phase bonus: day 0, dusk +1, night +2.
export let g_TIER_PHASE_DUSK: i32 = 1;
export let g_TIER_PHASE_NIGHT: i32 = 2;

// Biome sightlines (GDD §4.3), each min'd against the 72 m cap.
export let g_FOG_FAR_HOLLOWFIELD: f64 = 72.0;        // GDD 100 -> cap
export let g_FOG_FAR_ASHWOOD: f64 = 45.0;
export let g_FOG_FAR_CHALKDOWNS: f64 = 72.0;         // GDD 140 -> cap
export let g_FOG_FAR_FEN: f64 = 70.0;
export let g_FOG_FAR_IRONPINE: f64 = 72.0;           // GDD 80 -> cap
export let g_FOG_FAR_DEEPSHADE: f64 = 38.0;
export let g_BIOME_COUNT: i32 = 6;

// ===========================================================================
// 7. THE WORLD  (GDD §4.1, ARCHITECTURE §5.4)
