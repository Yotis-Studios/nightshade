// mathx.hml — scalar helpers and the noise stack.  W2-2.
//
// src/core is a LEAF: this file imports NOTHING.  It calls the compiler
// builtins `__floor` and `__sqrt` directly rather than importing
// `@stdlib/math`, because every stdlib math export is an ALIAS BINDING
// (`export let sqrt = __sqrt;`) and an aliased call goes through
// `hml_call_function` at roughly twice the cost of the builtin's fast path.
// Measured in probe_mathx §6.
//
// Nothing here allocates.  There is no object literal, no array literal
// outside the one top-level Bayer table, no closure, no `defer`, no `try`, no
// `throw` and no template string in any function.  Every function is safe on a
// per-vertex or per-texel path.
//
// ---------------------------------------------------------------------------
// RULE A13 — WHY EVERY HASH IS IN `u64`
// ---------------------------------------------------------------------------
// `i32` and `i64` `* + -` TRAP on overflow in Hemlock.  A textbook LCG written
// in i64 throws.  Verified on v2.9.1, both backends:
//
//     let big: i64 = 9223372036854775807;  let z: i64 = big * 2;
//     -> Uncaught exception: Integer overflow: i64 multiplication
//
// `u64` WRAPS instead, on both backends, which is exactly the arithmetic a
// hash wants.  So all mixing happens in `u64` with an explicit 32-bit mask
// (`& 4294967295`), which is what CLAUDE.md A13 asks for.
//
// Note the mask alone is NOT sufficient in i64: two masked 32-bit values
// multiplied reach 2^64, which overflows i64 and traps.  `u64` is the only
// container in which the documented "mask after every multiply" recipe is
// actually total.  This is the single most important line in the file.
//
// Negative coordinates are handled by reducing the i32 to its two's-complement
// low 32 bits *in i64* (`i64(x) & 4294967295`, verified: -7 -> 4294967289)
// before the value ever reaches u64.  `u64(negative)` is not relied on.
//
// ---------------------------------------------------------------------------
// THE HASH, EXACTLY
// ---------------------------------------------------------------------------
//   M  = 4294967295                    (the 32-bit mask)
//   lo(v) = i64(v) & M                 (two's-complement low 32 bits)
//
//   xhash2(x, y, s):
//       h  = lo(x)*2654435761 + lo(y)*2246822519 + lo(s)*3266489917
//       h  = (h ^ (h >> 15)) * 2246822507             Murmur3-style avalanche
//       h  = (h ^ (h >> 13)) * 3266489909
//       h  = (h ^ (h >> 16)) & M
//
//   xhash3(x, y, z, s): same, with `+ lo(z)*668265263 + 374761393`.  The
//       constant offset is what makes xhash3(x, y, 0, s) never equal
//       xhash2(x, y, s) — a coincidence at z = 0 would correlate 2-D and 3-D
//       features that are meant to be independent.
//
// Only the FINAL value is masked.  Multiplication modulo 2^64 already agrees
// with multiplication modulo 2^32 on the low 32 bits, so masking each
// intermediate would cost ~6 boxed operations and change nothing; the
// intermediate 64-bit state simply gives the avalanche more room.  Measured:
// 349 ns/call with per-step masks, 280 ns/call without.  probe_mathx §3 checks
// the distribution (chi-square over 64 buckets) and the adjacent-cell
// independence that this shortcut could plausibly have damaged.
//
// The result is a full 32-bit value returned in a `u64`.  A `u64` return keeps
// the top bit meaningful: an `i32` return would have to either discard a bit or
// go negative, and every caller would then have to remember which.
//
// ---------------------------------------------------------------------------
// vnoise / fbm2 — THE TILING CONTRACT
// ---------------------------------------------------------------------------
//     vnoise(x, y, cell, wrap, seed)
//
//   `cell`  lattice cell size, in the SAME UNITS as x and y (texels for
//           texgen, metres for worldgen).  Bigger cell = coarser features.
//           ART_BIBLE §7.1 rule 4: structure lives at a 4-10 texel wavelength,
//           so a 32x32 tile wants cell 4..16 and nothing smaller.
//   `wrap`  the repeat length, in the same units; <= 0 disables wrapping.
//           The lattice index is reduced modulo `wrap / cell`, so
//
//               vnoise(x + wrap, y, cell, wrap, s) == vnoise(x, y, cell, wrap, s)
//
//           EXACTLY (same bits, not approximately) whenever `cell` divides
//           `wrap`.  That is the acceptance criterion "vnoise tiles seamlessly
//           when period divides the tile size", and it is what makes a 32x32
//           atlas cell able to abut itself with no seam.
//           If `cell` does NOT divide `wrap` the lattice cannot close, and the
//           function silently does not tile — that is arithmetic, not a bug,
//           and probe_mathx asserts both halves of it.
//
//   Returns [0, 1).  Bilinear between four hashed corners with the smoothstep
//   weight `t*t*(3-2*t)` on each axis (ART_BIBLE §7.2).
//
//     fbm2(x, y, cell, wrap, seed)  = 0.60 * vnoise(cell,   seed)
//                                   + 0.28 * vnoise(cell/2, seed+31)
//                                   + 0.12 * vnoise(cell/4, seed+97)
//
//   Three octaves, verbatim from ART_BIBLE §7.2 — more is wasted on a 32 px
//   tile.  Weights sum to 1.0, so the result is [0, 1).  Every octave halves
//   `cell`, so if `cell` divides `wrap` then so do `cell/2` and `cell/4` when
//   `wrap` is a multiple of 4*cell — i.e. an fbm2 tile is seamless whenever
//   `cell*4` divides `wrap`.  For the shipping case (32 px tile, cell 8) it is.
//
// ---------------------------------------------------------------------------
// PERFORMANCE — THE CLAMP LADDER, MEASURED (probe_mathx §7)
// ---------------------------------------------------------------------------
// Best of 7 batches, __clock CPU time, 2 M iterations, hemlockc -O1, net of a
// 17.4 ns/iteration loop baseline:
//
//     __clamp(v, lo, hi)   builtin, called directly    12.2 ns   <-- FASTEST
//     two hand-written `if`s at the use site           13.8 ns
//     clamp(v, lo, hi)     from @stdlib/math           19.3 ns
//     clampf(v, lo, hi)    this file                   22.7 ns
//     an if-based clampf   (what this file used to be) 32.2 ns
//
// Two conclusions, and they are not the ones A9 states:
//
//   1. **In an innermost loop, call the `__clamp` / `__min` / `__max` /
//      `__abs` BUILTINS directly.**  They are as fast as hand-inlining the
//      comparisons — the compiler has a fast path for them, exactly as it does
//      for `__sqrt` — and 1.6x faster than `@stdlib/math`'s `clamp`, which is
//      an alias binding (`export let clamp = __clamp;`) and therefore goes
//      through `hml_call_function`.  A9's "hand-inline it" advice is still
//      correct in outcome but the builtin is simpler and marginally faster.
//   2. **No Hemlock-level function can beat the builtin**, because it is a
//      call on top of it.  So `clampf` and friends here are thin wrappers over
//      the builtins rather than if-chains — that alone is 1.4x — and they
//      exist for readability on cold and mid paths, not for the hot loop.
//
// `vnoise` hand-inlines its four corner hashes instead of calling `h01` four
// times: a Hemlock call costs ~26 ns plus its arguments, so four 3-arg calls
// would add ~150 ns.  `fbm2` DOES call `vnoise` three times — one call against
// a 1.2 us body is noise, and the alternative is triplicating 60 lines.
// probe_mathx §4 pins the inlined corners against `h01` and pins `fbm2`
// against a hand-composed sum of `vnoise` calls, so the duplication is a
// tested invariant rather than a latent divergence.
//
// ---------------------------------------------------------------------------
// ⚠ DO NOT CALL fbm2 PER TEXEL.  Measured, hemlockc -O1, __clock min-of-7:
// ---------------------------------------------------------------------------
//     xhash2   280 ns/call      vnoise   1.25 us/call      fbm2   3.7 us/call
//
// Hemlock's u64 arithmetic is BOXED (~11 ns per operation) and vnoise runs 44
// of them.  The ART_BIBLE §7.3 grass recipe — two fbm2 + one h01 + one bayer4
// per texel — costs **8.02 ms for one 32x32 tile, i.e. 514 ms for a 64-tile
// atlas**, against a 200 ms budget.
//
// The fix is on the CALLER's side and it is a big one: that same tile's noise
// lattice is only 84 corner evaluations (2x2 + 4x4 + 8x8), **0.08 ms**.
// Evaluate each octave's lattice once per tile and bilinear-interpolate per
// texel — 100x cheaper, and it produces the identical field, because that is
// exactly what value noise is.  Call vnoise/fbm2 directly for per-vertex
// worldgen (81 samples per chunk), for tools and for anything lattice-sparse.
//
// `vnoise` hand-inlines its four corner hashes instead of calling `h01` four
// times: a Hemlock call costs ~17 ns plus ~10 ns per argument, so four 3-arg
// calls would add ~190 ns to a ~200 ns function.  `fbm2` DOES call `vnoise`
// three times — one call against a ~200 ns body is 18 % and the alternative is
// triplicating 40 lines.  probe_mathx §4 pins the inlined corners against
// `h01` and pins `fbm2` against a hand-composed sum of `vnoise` calls, so the
// duplication is a tested invariant rather than a latent divergence.

// ===========================================================================
// 4x4 ORDERED BAYER MATRIX  (ART_BIBLE §7.2)
// ===========================================================================
// The single most PS1-authentic technique available, and it costs one array
// lookup.  Dither EVERY ramp boundary and EVERY sky gradient row.
let g_BAYER4: array<i32> = [
     0,  8,  2, 10,
    12,  4, 14,  6,
     3, 11,  1,  9,
    15,  7, 13,  5
];

// ===========================================================================
// SCALAR HELPERS
// ===========================================================================

// Thin wrappers over the compiler builtins — measured 1.4x faster than the
// if-based bodies they replace (see the clamp ladder above).  In an innermost
// loop, skip these and call `__abs` / `__min` / `__max` / `__clamp` yourself.

export fn absf(p_a: f64): f64 {
    let a0: f64 = __abs(p_a);
    let out: f64 = a0;
    return out;
}

export fn minf(p_a: f64, p_b: f64): f64 {
    let m0: f64 = __min(p_a, p_b);
    let out: f64 = m0;
    return out;
}

export fn maxf(p_a: f64, p_b: f64): f64 {
    let m0: f64 = __max(p_a, p_b);
    let out: f64 = m0;
    return out;
}

export fn clampf(p_v: f64, p_lo: f64, p_hi: f64): f64 {
    let c0: f64 = __clamp(p_v, p_lo, p_hi);
    let out: f64 = c0;
    return out;
}

// clamp to [0,1] — the case that actually dominates (colour, fog, alpha, t).
export fn clamp01(p_v: f64): f64 {
    let c0: f64 = __clamp(p_v, 0.0, 1.0);
    let out: f64 = c0;
    return out;
}

export fn lerpf(p_a: f64, p_b: f64, p_t: f64): f64 {
    let a: f64 = p_a;
    let b: f64 = p_b;
    let t: f64 = p_t;
    let out: f64 = a + (b - a) * t;
    return out;
}

// The raw smoothstep polynomial on an already-normalized t.  This is the one
// vnoise uses and the one ART_BIBLE §6.1 writes as `t*t*(3-2*t)`.
export fn smooth01(p_t: f64): f64 {
    let t: f64 = p_t;
    if (t < 0.0) { t = 0.0; }
    if (t > 1.0) { t = 1.0; }
    let out: f64 = t * t * (3.0 - 2.0 * t);
    return out;
}

// GLSL semantics: 0 below e0, 1 above e1, smooth between.  Degenerate edges
// (e1 <= e0) return a hard step rather than a NaN.
export fn smoothstep(p_e0: f64, p_e1: f64, p_x: f64): f64 {
    let e0: f64 = p_e0;
    let e1: f64 = p_e1;
    let x: f64 = p_x;
    let span: f64 = e1 - e0;
    if (span <= 0.0) {
        let hard: f64 = 0.0;
        if (x >= e1) { hard = 1.0; }
        return hard;
    }
    let t: f64 = (x - e0) / span;
    if (t < 0.0) { t = 0.0; }
    if (t > 1.0) { t = 1.0; }
    let out: f64 = t * t * (3.0 - 2.0 * t);
    return out;
}

export fn deg2rad(p_d: f64): f64 {
    let d: f64 = p_d;
    let out: f64 = d * 0.017453292519943295;
    return out;
}

export fn rad2deg(p_r: f64): f64 {
    let r: f64 = p_r;
    let out: f64 = r * 57.29577951308232;
    return out;
}

// Integer forms.  Separate names because Hemlock has no overloading and a
// mixed-type min would box both arguments.
export fn absi(p_a: i32): i32 {
    let a: i32 = p_a;
    if (a < 0) { a = 0 - a; }
    let out: i32 = a;
    return out;
}

export fn mini(p_a: i32, p_b: i32): i32 {
    let a: i32 = p_a;
    let b: i32 = p_b;
    if (b < a) { a = b; }
    let out: i32 = a;
    return out;
}

export fn maxi(p_a: i32, p_b: i32): i32 {
    let a: i32 = p_a;
    let b: i32 = p_b;
    if (b > a) { a = b; }
    let out: i32 = a;
    return out;
}

export fn clampi(p_v: i32, p_lo: i32, p_hi: i32): i32 {
    let v: i32 = p_v;
    let lo: i32 = p_lo;
    let hi: i32 = p_hi;
    if (v < lo) { v = lo; }
    if (v > hi) { v = hi; }
    let out: i32 = v;
    return out;
}

// floor() straight to i32, correct for negatives (i32(-2.5) truncates to -2,
// which is the wrong lattice cell and produces a visible seam at x = 0).
export fn floori(p_x: f64): i32 {
    let x: f64 = p_x;
    let f0: f64 = __floor(x);
    let out: i32 = i32(f0);
    return out;
}

// ===========================================================================
// HASHING  (all mixing in u64 with an explicit 32-bit mask — A13)
// ===========================================================================

// `u64(negative)` THROWS ("Value -7 out of range for u64"), so an i32 that may
// be negative is reduced to its two's-complement low 32 bits in i64 first:
// `i64(-7) & 4294967295` == 4294967289, verified on both backends.
export fn xhash2(p_x: i32, p_y: i32, p_seed: i32): u64 {
    let lx: i64 = i64(p_x) & 4294967295;
    let ly: i64 = i64(p_y) & 4294967295;
    let ls: i64 = i64(p_seed) & 4294967295;
    let h: u64 = u64(lx) * 2654435761 + u64(ly) * 2246822519 + u64(ls) * 3266489917;
    h = (h ^ (h >> 15)) * 2246822507;
    h = (h ^ (h >> 13)) * 3266489909;
    h = (h ^ (h >> 16)) & 4294967295;
    let out: u64 = h;
    return out;
}

export fn xhash3(p_x: i32, p_y: i32, p_z: i32, p_seed: i32): u64 {
    let lx: i64 = i64(p_x) & 4294967295;
    let ly: i64 = i64(p_y) & 4294967295;
    let lz: i64 = i64(p_z) & 4294967295;
    let ls: i64 = i64(p_seed) & 4294967295;
    let h: u64 = u64(lx) * 2654435761 + u64(ly) * 2246822519
               + u64(lz) * 668265263 + u64(ls) * 3266489917 + 374761393;
    h = (h ^ (h >> 15)) * 2246822507;
    h = (h ^ (h >> 13)) * 3266489909;
    h = (h ^ (h >> 16)) & 4294967295;
    let out: u64 = h;
    return out;
}

// A hash value in [0, 1).  2.3283064365386963e-10 is exactly 1/2^32, so the
// mapping is a single multiply and can never reach 1.0.
export fn h01(p_x: i32, p_y: i32, p_seed: i32): f64 {
    let h: u64 = xhash2(p_x, p_y, p_seed);
    let hf: f64 = f64(h);
    let out: f64 = hf * 2.3283064365386963e-10;
    return out;
}

export fn h01_3(p_x: i32, p_y: i32, p_z: i32, p_seed: i32): f64 {
    let h: u64 = xhash3(p_x, p_y, p_z, p_seed);
    let hf: f64 = f64(h);
    let out: f64 = hf * 2.3283064365386963e-10;
    return out;
}

// ===========================================================================
// ORDERED DITHER
// ===========================================================================

// 0..15.  Use with an integer ramp step.
export fn bayer4i(p_x: i32, p_y: i32): i32 {
    let x: i32 = p_x;
    let y: i32 = p_y;
    let out: i32 = g_BAYER4[(y & 3) * 4 + (x & 3)];
    return out;
}

// [0, 0.9375] — the threshold form.  `if (frac > bayer4(x,y)) { step++; }` is
// THE dither, and it is the whole trick (ART_BIBLE §7.2 ramp_pick).
export fn bayer4(p_x: i32, p_y: i32): f64 {
    let x: i32 = p_x;
    let y: i32 = p_y;
    let v: i32 = g_BAYER4[(y & 3) * 4 + (x & 3)];
    let vf: f64 = f64(v);
    let out: f64 = vf * 0.0625;
    return out;
}

// ===========================================================================
// VALUE NOISE
// ===========================================================================
// The four corner hashes are hand-inlined copies of xhash2 sharing one
// precomputed seed term.  probe_mathx §4 pins every corner against h01().

export fn vnoise(p_x: f64, p_y: f64, p_cell: f64, p_wrap: i32, p_seed: i32): f64 {
    let x: f64 = p_x;
    let y: f64 = p_y;
    let cell: f64 = p_cell;
    let wrap: i32 = p_wrap;

    // A non-positive cell has no lattice.  Cold branch; keeps 1/cell finite.
    if (cell <= 0.0) {
        let mid: f64 = 0.5;
        return mid;
    }

    let inv: f64 = 1.0 / cell;
    let fx: f64 = x * inv;
    let fy: f64 = y * inv;
    let bx: f64 = __floor(fx);
    let by: f64 = __floor(fy);
    let ix: i32 = i32(bx);
    let iy: i32 = i32(by);
    let tx: f64 = fx - bx;
    let ty: f64 = fy - by;
    let sx: f64 = tx * tx * (3.0 - 2.0 * tx);
    let sy: f64 = ty * ty * (3.0 - 2.0 * ty);

    // Lattice wrap.  l = wrap / cell, rounded, is the number of cells in one
    // repeat.  l <= 1 means "no meaningful wrap"; leave the lattice open.
    let x0: i32 = ix;
    let y0: i32 = iy;
    let x1: i32 = ix + 1;
    let y1: i32 = iy + 1;
    if (wrap > 0) {
        let wf: f64 = f64(wrap) * inv;
        let wr: f64 = __floor(wf + 0.5);
        let l: i32 = i32(wr);
        if (l > 1) {
            x0 = ((ix % l) + l) % l;
            y0 = ((iy % l) + l) % l;
            x1 = x0 + 1;
            y1 = y0 + 1;
            if (x1 >= l) { x1 = 0; }
            if (y1 >= l) { y1 = 0; }
        }
    }

    // Shared seed term: lo(seed) * 3266489917, folded into every corner.
    let ls: i64 = i64(p_seed) & 4294967295;
    let hs: u64 = u64(ls) * 3266489917;

    let lx0: i64 = i64(x0) & 4294967295;
    let lx1: i64 = i64(x1) & 4294967295;
    let ly0: i64 = i64(y0) & 4294967295;
    let ly1: i64 = i64(y1) & 4294967295;
    let cx0: u64 = u64(lx0) * 2654435761;
    let cx1: u64 = u64(lx1) * 2654435761;
    let cy0: u64 = u64(ly0) * 2246822519;
    let cy1: u64 = u64(ly1) * 2246822519;

    // corner (x0, y0)
    let h: u64 = cx0 + cy0 + hs;
    h = (h ^ (h >> 15)) * 2246822507;
    h = (h ^ (h >> 13)) * 3266489909;
    h = (h ^ (h >> 16)) & 4294967295;
    let f00: f64 = f64(h);
    let n00: f64 = f00 * 2.3283064365386963e-10;

    // corner (x1, y0)
    h = cx1 + cy0 + hs;
    h = (h ^ (h >> 15)) * 2246822507;
    h = (h ^ (h >> 13)) * 3266489909;
    h = (h ^ (h >> 16)) & 4294967295;
    let f10: f64 = f64(h);
    let n10: f64 = f10 * 2.3283064365386963e-10;

    // corner (x0, y1)
    h = cx0 + cy1 + hs;
    h = (h ^ (h >> 15)) * 2246822507;
    h = (h ^ (h >> 13)) * 3266489909;
    h = (h ^ (h >> 16)) & 4294967295;
    let f01: f64 = f64(h);
    let n01: f64 = f01 * 2.3283064365386963e-10;

    // corner (x1, y1)
    h = cx1 + cy1 + hs;
    h = (h ^ (h >> 15)) * 2246822507;
    h = (h ^ (h >> 13)) * 3266489909;
    h = (h ^ (h >> 16)) & 4294967295;
    let f11: f64 = f64(h);
    let n11: f64 = f11 * 2.3283064365386963e-10;

    let a: f64 = n00 + (n10 - n00) * sx;
    let b: f64 = n01 + (n11 - n01) * sx;
    let out: f64 = a + (b - a) * sy;
    return out;
}

// Three octaves, ART_BIBLE §7.2 weights.  Returns [0, 1).
export fn fbm2(p_x: f64, p_y: f64, p_cell: f64, p_wrap: i32, p_seed: i32): f64 {
    let x: f64 = p_x;
    let y: f64 = p_y;
    let cell: f64 = p_cell;
    let wrap: i32 = p_wrap;
    let seed: i32 = p_seed;
    let o0: f64 = vnoise(x, y, cell, wrap, seed);
    let o1: f64 = vnoise(x, y, cell * 0.5, wrap, seed + 31);
    let o2: f64 = vnoise(x, y, cell * 0.25, wrap, seed + 97);
    let out: f64 = o0 * 0.60 + o1 * 0.28 + o2 * 0.12;
    return out;
}
