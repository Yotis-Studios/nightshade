// The magazine the HUD shows: the client's optimistic count while a predicted
// shot is outstanding, the authority's the instant it lands.
export fn client_ammo(p_cl: object): i32 {
    let cl: object = p_cl;
    let a: i32 = cl.ammo;
    if (cl.pred_ammo != CL_MISS && cl.pred_ammo < a) { a = cl.pred_ammo; }
    let out: i32 = a;
    return out;
}

export fn client_reserve(p_cl: object): i32 { let cl: object = p_cl; let o: i32 = cl.reserve; return o; }
export fn client_reloading(p_cl: object): f64 {
    let cl: object = p_cl;
    let t: f64 = cl.reload_t;
    if (cl.pred_reload_t > t) { t = cl.pred_reload_t; }
    let out: f64 = t;
    return out;
}
