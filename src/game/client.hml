// GDD §8 at 0:24: the prompt. The SERVER decides you are in reach; the client
// decides that "in reach or nearly" is when the words appear, because a prompt
// that only exists inside the interaction radius is a prompt you find by
// accident.
export fn client_prompt(p_cl: object): i32 {
    let cl: object = p_cl;
    if (cl.lantern_lit == 1) { let lit: i32 = 0; return lit; }
    if (cl.control == 0) { let nc: i32 = 0; return nc; }
    if (cl.lantern_dist > CL_PROMPT_M) { let far: i32 = 0; return far; }
    let out: i32 = 1;
    return out;
}

// Where the objective marker goes: the bearing to the lantern, relative to the
// render yaw, in radians, wrapped to +-pi.
export fn client_lantern_bearing(p_cl: object): f64 {
    let cl: object = p_cl;
    // Forward is (sin yaw, -cos yaw) -- view.hml's basis, which movement.hml
    // explicitly refuses to duplicate. The bearing must use the same one.
    let a: f64 = atan2(cl.lantern_x - cl.px, cl.pz - cl.lantern_z);
    let out: f64 = view_wrap_pi(a - view_render_yaw(cl.view));
    return out;
}

// The health fraction, for the vignette and the bar.
export fn client_hp01(p_cl: object): f64 {
    let cl: object = p_cl;
    let m: i32 = cl.hp_max;
    if (m <= 0) { let z: f64 = 0.0; return z; }
    let out: f64 = clamp01(f64(cl.hp) / f64(m));
    return out;
}

// The interpolated entity stream, for the caller that draws bodies. It is a
// pass-through so that `main.hml` never has to know the RenderSnapshot's field
// names, and so this file stays the only place a snapshot is read.
export fn client_ent_count(p_cl: object): i32 {
    let cl: object = p_cl;
    let out: i32 = rsnap_count(cl.rs);
    return out;
}
export fn client_ent_id(p_cl: object, p_i: i32): i32 { let cl: object = p_cl; let a = rsnap_field_id(cl.rs); let o: i32 = a[p_i]; return o; }
export fn client_ent_x(p_cl: object, p_i: i32): f64 { let cl: object = p_cl; let a = rsnap_field_x(cl.rs); let o: f64 = a[p_i]; return o; }
export fn client_ent_y(p_cl: object, p_i: i32): f64 { let cl: object = p_cl; let a = rsnap_field_y(cl.rs); let o: f64 = a[p_i]; return o; }
export fn client_ent_z(p_cl: object, p_i: i32): f64 { let cl: object = p_cl; let a = rsnap_field_z(cl.rs); let o: f64 = a[p_i]; return o; }
export fn client_ent_yaw(p_cl: object, p_i: i32): f64 { let cl: object = p_cl; let a = rsnap_field_yaw(cl.rs); let o: f64 = a[p_i]; return o; }
export fn client_ent_model(p_cl: object, p_i: i32): i32 { let cl: object = p_cl; let a = rsnap_field_model(cl.rs); let o: i32 = a[p_i]; return o; }
export fn client_ent_flags(p_cl: object, p_i: i32): i32 { let cl: object = p_cl; let a = rsnap_field_flags(cl.rs); let o: i32 = a[p_i]; return o; }

// ===========================================================================
//  12.  W6 — READERS, AND THE PRESENTATION LAYER
// ---------------------------------------------------------------------------
//  Every name, every line of dialogue and every label in this section is
//  PRESENTATION and belongs here for the same reason `cl_on_beat` does: the
//  server decides that Mabel arrived, the client decides what "Mabel arrived"
//  says. Nothing below reaches back into a sim module for a string, because no
//  sim module has one -- `npc.hml` deliberately carries ids and topic codes and
//  no text at all, which is exactly the right side of the line to be on.
// ===========================================================================

