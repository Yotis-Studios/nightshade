// The TALK prompt, on the same rule as the lantern's: the words appear a
// little before the interaction does.
export fn client_talk_prompt(p_cl: object): i32 {
    let cl: object = p_cl;
    if (cl.talk_who < 0) { let none: i32 = 0; return none; }
    if (cl.ui_panel != 0) { let modal: i32 = 0; return modal; }
    if (cl.talk_dist > CL_TALK_M) { let far: i32 = 0; return far; }
    if (client_prompt(cl) == 1) { let lantern: i32 = 0; return lantern; }
    let out: i32 = 1;
    return out;
}

// The bearing to the settlement, for the compass marker. Same basis as
// `client_lantern_bearing` and derived the same way, because two bearings that
// disagree by a sign is the bug that puts the marker behind you.
export fn client_settle_bearing(p_cl: object): f64 {
    let cl: object = p_cl;
    let a: f64 = atan2(cl.set_x - cl.px, cl.pz - cl.set_z);
    let out: f64 = view_wrap_pi(a - view_render_yaw(cl.view));
    return out;
}

// ---------------------------------------------------------------------------
// THE NAMES. Short on purpose: FONT_MICRO costs FOUR triangles a glyph once
// the mandatory shadow is counted (ART_BIBLE §9), so a HUD label is a budget
// line, not a sentence. Every one of these was counted against the 250 cap.
// ---------------------------------------------------------------------------
let g_cl_npc_name: array = ["MABEL", "ODO", "WICK", "CONNIE", "PIP"];
// ONE WORD EACH. These are HUD labels inside a 250-triangle panel, not prose:
// "PIP'S STALL" is 10 drawable glyphs and therefore 40 triangles, and the 20
// it cost over "STALL" is what pushed the trade panel's hint line past its
// budget and printed "[X] NEXT [C] TAK".
let g_cl_npc_trade: array = ["BENCH", "INN", "LANTERN", "BOARD", "STALL"];

export fn client_npc_name(p_who: i32): string {
    let w: i32 = clampi(p_who, 0, 4);
    let out: string = g_cl_npc_name[w];
    return out;
}
export fn client_npc_place(p_who: i32): string {
    let w: i32 = clampi(p_who, 0, 4);
    let out: string = g_cl_npc_trade[w];
    return out;
}

let g_cl_spell_name: array = ["FLARE", "SHUTTER", "EMBERLANCE", "MEND",
                              "GUTTERING", "LANCE", "KINDLING"];
export fn client_spell_name(p_id: i32): string {
    let i: i32 = p_id;
    if (i < 0 || i >= CL_SPELLS) { let none: string = "-"; return none; }
    let out: string = g_cl_spell_name[i];
    return out;
}

let g_cl_mel_name: array = ["CLUB", "SPEAR", "SWORD"];
export fn client_melee_name(p_m: i32): string {
    let i: i32 = p_m;
    if (i < 0 || i > 2) { let none: string = "-"; return none; }
    let out: string = g_cl_mel_name[i];
    return out;
}

// Three glyphs each, because five of them stack in one panel column.
let g_cl_stat_short: array = ["HND", "CAP", "LAN", "VIT", "ATT"];
let g_cl_stat_long: array = ["HANDLING", "CAPACITY", "LANTERN",
                             "VITALITY", "ATTUNEMENT"];
export fn client_stat_short(p_i: i32): string {
    let i: i32 = clampi(p_i, 0, 4);
    let out: string = g_cl_stat_short[i];
    return out;
}
export fn client_stat_name(p_i: i32): string {
    let i: i32 = clampi(p_i, 0, 4);
    let out: string = g_cl_stat_long[i];
    return out;
}

let g_cl_tier_name: array = ["CAMP", "VILLAGE", "TOWN", "CITY"];
export fn client_settle_tier_name(p_t: i32): string {
    let t: i32 = clampi(p_t, 0, 3);
    let out: string = g_cl_tier_name[t];
    return out;
}

// SETTLEMENT.md's site names, indexed by `settle_name`. Sixteen, so that two
// settlements in one world do not share one.
let g_cl_site_name: array = [
    "LANTERNMOOR", "ASHFORD", "WICKHOLLOW", "GREYFEN",
    "EMBERCROSS", "THE FOLD", "COLDSTILE", "MARROWGATE",
    "SUNDER", "TALLOWDOWN", "BRIARLIGHT", "OLD KEEL",
    "HEARTHWAY", "NINE ELMS", "SALTMIRE", "THE LAST LAMP"
];
export fn client_site_name(p_n: i32): string {
    let n: i32 = p_n & 15;
    let out: string = g_cl_site_name[n];
    return out;
}

// ---------------------------------------------------------------------------
// WHAT AN OFFER IS CALLED. `npc.hml`'s sixteen `NPC_OFF_*` kinds. The four
// village guns are listed by name because the panel must SHOW them -- the
// player should be able to see what Mabel could make, and find out it is not
// forged yet, rather than never learn the ladder exists.
// ---------------------------------------------------------------------------
let g_cl_off_name: array = [
    "A GUN", "MANUFACTURED", "AMMUNITION", "REPAIR",
    "ATTACHMENT", "REROLL", "A BED", "STORAGE",
    "SOUP", "GREAT LANTERN", "LANTERN KIT", "TRAVEL",
    "A CONTRACT", "A MAP", "THE ALMANAC", "A CHARM"
];
let g_cl_vw_name: array = ["BOLT-ACTION", "REVOLVER", "PUMP SHOTGUN", "PIPE-SMG"];

export fn client_offer_label(p_kind: i32, p_arg: i32): string {
    let k: i32 = p_kind;
    if (k == 0) {
        let v: i32 = clampi(p_arg, 0, 3);
        let g: string = g_cl_vw_name[v];
        return g;
    }
    let i: i32 = clampi(k, 0, 15);
    let out: string = g_cl_off_name[i];
    return out;
}

// ---------------------------------------------------------------------------
// WHAT THE UI SAID. One line, from an integer, for every way a confirm can
// end. `UI_MSG_UNBUILT` is the one that matters: it is how the game admits, in
// the player's own words, that a row in the design has no system behind it
// yet. That is a better failure than a button that does nothing.
// ---------------------------------------------------------------------------
let g_cl_ui_msg: array = [
    "", "SPENT", "NO POINTS", "AT MAXIMUM",
    "TAKEN", "NOT OFFERED", "NOT FORGED YET", "NOBODY HERE"
];
export fn client_ui_msg_text(p_msg: i32): string {
    let m: i32 = clampi(p_msg, 0, 7);
    let out: string = g_cl_ui_msg[m];
    return out;
}

// ---------------------------------------------------------------------------
// WHAT A VILLAGER SAYS. `npc.hml` returns a TOPIC and an ARGUMENT; the words
// are here. DIRECTION.md §6.3: "A villager who mentions the east road has gone
// dark again is doing tutorial, quest-giving and world-state readout in a
// single line of dialogue." That is `NPC_T_DARK_ROAD`, and it is why the
// argument is a compass octant rather than a quest id.
// ---------------------------------------------------------------------------
let g_cl_dir_name: array = ["NORTH", "NORTHEAST", "EAST", "SOUTHEAST",
                            "SOUTH", "SOUTHWEST", "WEST", "NORTHWEST"];

export fn client_talk_line(p_who: i32, p_topic: i32, p_arg: i32): string {
    let t: i32 = p_topic;
    let a: i32 = p_arg;
    if (t < 0) { let none: string = ""; return none; }
    if (t == 0) {                        // NPC_T_GREET
        let s: string = "YOU CAME BACK.";
        return s;
    }
    if (t == 1) {                        // NPC_T_BROWNOUT
        let s: string = "THE LIGHTS ARE GUTTERING.";
        return s;
    }
    if (t == 2) {                        // NPC_T_DARK_ROAD
        let d: i32 = clampi(a, 0, 7);
        let s: string = `THE ${g_cl_dir_name[d]} ROAD IS DARK.`;
        return s;
    }
    if (t == 3) {                        // NPC_T_FOUNDRY
        let s: string = "THE FOUNDRY WANTS POWER.";
        return s;
    }
    if (t == 4) {                        // NPC_T_ARRIVAL
        let s: string = `${client_npc_name(a)} MOVED IN.`;
        return s;
    }
    if (t == 5) {                        // NPC_T_PROMOTED
        let s: string = `WE'RE A ${client_settle_tier_name(a)} NOW.`;
        return s;
    }
    if (t == 6) {                        // NPC_T_BUILDING
        let s: string = "SOMETHING'S GOING UP.";
        return s;
    }
    if (t == 7) {                        // NPC_T_OFFER
        let s: string = "I'VE GOT SOMETHING FOR YOU.";
        return s;
    }
    if (t == 8) {                        // NPC_T_NIGHT
        let s: string = "STAY IN THE LIGHT TONIGHT.";
        return s;
    }
    // NPC_T_DAILY — the one line per in-game day, per person.
    let w: i32 = clampi(p_who, 0, 4);
    if (w == 0) { let s: string = "TWO FINGERS SHORT, STILL STRAIGHT."; return s; }
    if (w == 1) { let s: string = "SOUP'S WARM PAST MIDNIGHT."; return s; }
    if (w == 2) { let s: string = "MIND THE WICK, NOT THE FLAME."; return s; }
    if (w == 3) { let s: string = "I'VE MAPPED WHAT I CAN SEE."; return s; }
    let s2: string = "I FOUND A THING. HONEST.";
    return s2;
}
