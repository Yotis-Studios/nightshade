// =============================================================================
//  demobot.hml — THE DEMO DRIVER, IN ONE PLACE, BECAUSE TWO OF THEM COST A WAVE
// =============================================================================
//
//  This module exists because of a specific, expensive failure, and the whole
//  design of it is a response to that failure.
//
//  -------------------------------------------------------------------------
//  WHAT HAPPENED
//  -------------------------------------------------------------------------
//  Commit 112b038 recorded "the first minute is winnable on 10 of 12 seeds".
//  That was TRUE, and it is still true — it was measured with
//  `tools/probe_waveone.hml`'s bot.
//
//  A later gate played the first minute with `main.hml --demo` and reported it
//  UNWINNABLE ON 0 OF 8 SEEDS, every seed stopping at beat WAVE with path 0.
//  That was ALSO true.  `6197017`'s 4:3-to-16:9 fov change was the prime
//  suspect, and it is INNOCENT.  MEASURED, by building 112b038 in a clean
//  worktree and running its OWN binary:
//
//      main.hml --demo 75, seeds 1337..48851 @ 112b038  ->  7 of 7 end at WAVE,
//                                                           lantern 1, path 0
//
//  So `--demo` never cleared the wave, not at 112b038 and not after it.  The
//  regression was never in the game.  `director.hml`, `ai.hml`, `combat.hml`,
//  `projectiles.hml`, `movement.hml` and `probe_waveone.hml` are all BYTE
//  IDENTICAL across that range, and no `g_DIR_*` / `g_ENEMY_*` balance constant
//  moved; `SV_START_RESERVE` is 12 at both commits.  Two instruments, one game,
//  opposite verdicts — and only one of the two bots could shoot.
//
//  -------------------------------------------------------------------------
//  WHY THE SHIPPED DRIVER LOST, AND IT WAS NOT AIM
//  -------------------------------------------------------------------------
//  The obvious guess is that the old `demo_drive` aimed badly: it never
//  pitched (`client_look_axis(cl, dyaw, 0.0)` — the second axis is a hard zero
//  on every call), never used the sights, and reloaded only on an empty HUD.
//  All three are real defects.  NONE OF THEM IS THE ONE THAT MATTERS.
//  `tools/probe_firstminute.hml` adds them back one clause at a time and the
//  ladder does not move:
//
//      ARM 0  SHIPPED     0 / 12    335 rounds fired    lantern paid 132
//      ARM 1  +PITCH      0 / 12    327                 111
//      ARM 2  +ADS        0 / 12    383                 171
//      ARM 3  +RELOAD     0 / 12    377                 166
//      ARM 4  +LEASH      0 / 12    409                 392
//      ARM 5  REFERENCE  12 / 12   1028                 900
//
//  The column that tells the story is not `shots`, it is `out-of-light`.  The
//  old driver backpedals whenever anything is inside 5 m — `client_set_move(cl,
//  -1.0, 0.4)` — and it NEVER WALKS BACK.  During a wave something is almost
//  always inside 5 m, so it reverses out of the lantern's radius and stays out,
//  ending the run 100 to 223 METRES from the post having spent 55 to 66 of its
//  90 seconds outside the light.  `sv_lantern_supply` pays nothing out there.
//  The lantern handed the reference player ~75 rounds a minute and handed the
//  shipped driver 7 to 12.  It did not miss the wave; it walked away from its
//  own ammunition supply and then had nothing to miss with.
//
//  That is the fantasy failing in miniature, which is why it is worth this
//  much comment: the light is the ammunition, and a driver that does not
//  understand that is not playing this game.
//
//  -------------------------------------------------------------------------
//  WHY THIS IS A MODULE AND NOT A PATCH TO `demo_drive`
//  -------------------------------------------------------------------------
//  The root cause is NOT that the demo bot was bad.  It is that THERE WERE TWO
//  BOTS: a good one inside `probe_waveone.hml` that every acceptance number was
//  measured with, and a bad one inside `main.hml` that every human and every
//  gate actually watched.  Fixing the bad one in place leaves both, and leaves
//  the next wave free to re-open exactly this gap.
//
//  So the policy lives here, once.  `main.hml`'s `demo_drive` calls it and
//  `tools/probe_firstminute.hml`'s ARM 6 calls it, and the probe's assertion is
//  therefore a statement about THE SHIPPING DRIVER rather than about a port of
//  it.  A port is what produced the 10-of-12-versus-0-of-8 split in the first
//  place.
//
//  -------------------------------------------------------------------------
//  THE POLICY IS LIFTED VERBATIM FROM `probe_waveone.hml`'s `bot_frame`
//  -------------------------------------------------------------------------
//  Deliberately verbatim, and not "improved".  That bot is the instrument the
//  10-of-12 bar was set with; a rewrite would be a THIRD bot and would put us
//  straight back into comparing two numbers that were never measurements of the
//  same thing.  Its rationale — targeting on seconds-of-damage-inbound, target
//  persistence, the leash to the post, iron sights at every range, break-contact
//  on an empty magazine inside swing range, and the reconstructed magazine that
//  routes around `client.hml`'s latching HUD — is written up in that file's
//  header and in the block comments below.
//
//  -------------------------------------------------------------------------
//  WHAT THIS BOT IS NOT ALLOWED TO KNOW
//  -------------------------------------------------------------------------
//  Only what the screen and the HUD show: entity positions, models and ids from
//  the render snapshot, its own hp / ammo / reserve / ads, and where the
//  lantern is.  No enemy hit points, no director state, no world query.  It
//  does not melee (`BTN_MELEE` is a no-op in `src/sim/**`) and it does not
//  route to pickups (nothing spawns `KIND_PICKUP`).  Every button it presses is
//  a button a player has.
//
//  It reads `client_ammo` as a FLOOR and nowhere else, and that is not a cheat
//  — it is a work-around for a defect this module does not own.  `client_ammo`
//  is `min(authority, prediction)` and LATCHES LOW (probe_waveone §E.1: the HUD
//  magazine lies by up to 1 of 6 rounds), so a driver that gates its trigger on
//  it stops shooting while holding a loaded gun.  `demobot_ammo_sync` rebuilds
//  the magazine from the AUTHORITY'S OWN shot counter — `client_shots`, which
//  is a number the HUD already shows the player — plus the reload transitions
//  the player can see and hear.  REPORTED, not smuggled: the underlying
//  client.hml bug is still open.  §AMMO-LATCH below is why the HUD is now also
//  read as a lower bound.
//
//  =========================================================================
//  §AMMO-LATCH — THE BUG THAT ATE THIRTY-FIVE MINUTES OF EVERY HOUR
//  =========================================================================
//  THE_HOUR_2 §0.4 reported two town-visit drivers dying 223 and 350 times in
//  an hour and attributed it to "a movement override that keeps steering a
//  player it has disarmed".  It was not the override.  IT WAS THIS FILE, and
//  the same latch is what `probe_session` ARM POST — the shipping driver with
//  no override at all — was doing when it recorded 112 player deaths.
//
//  MEASURED, `probe_session` ARM WALK, seed 1337, one row per five seconds
//  (the trace is reproduced in this task's report).  From t = 1509 s to the end
//  of the hour, EVERY sample reads:
//
//      mag = 0    client_ammo = 4    reserve = 12    brk = 1    shots FROZEN
//
//  The player is standing at the post on 100 HP holding a gun with FOUR ROUNDS
//  IN IT and twelve in reserve, and the driver believes it is empty.  It is a
//  DEADLOCK and every arrow points inward:
//
//    * the model says empty  ->  `fire` is gated on `ammo > 0`  ->  it never
//      fires  ->  `client_shots` never advances  ->  repair path 1 is dead.
//    * the model says empty  ->  it holds BTN_RELOAD  ->  `wpn_reload_begin`
//      (weapons.hml:1200) refuses on exactly two conditions, a FULL magazine
//      or an EMPTY reserve.  The reserve is 12, so the refusal means the
//      magazine is full.  `client_reloading` never rises  ->  the reload
//      transition that rebuilds `b.mag` never happens  ->  repair path 2 is
//      dead.
//    * `ammo <= 0` with a body inside `g_DBOT_BREAK_M` latches BREAK CONTACT,
//      which returns before the trigger is ever reached, so the driver sprints
//      in a circle at the leash radius for the remaining thirty-five minutes.
//    * and the reserve is pinned at `SV_START_RESERVE`, so `sv_lantern_supply`
//      stops paying too — `supplied` freezes, which is how the freeze looks
//      from the outside like the lantern broke.
//
//  What DESYNCHRONISES the model in the first place is the watchdog below:
//  `dry_watch > 30` FRAMES zeroes `b.mag` when the trigger was held and nothing
//  came out.  At 60 fps that is 0.50 s against the Kestrel's 0.30 s shot
//  interval, which is safe; at the 85 fps this game actually runs at it is
//  0.353 s, which is one frame of jitter away from firing on a loaded gun.
//  (That frame-rate coupling is REPORTED, not fixed: fixing it needs a `dt` the
//  entry point does not take, and the two repairs below make the watchdog
//  non-fatal, which is the part that matters.)
//
//  TWO REPAIRS, each derived from a rule the game's own code states:
//
//    1. THE FLOOR.  `client_ammo` is `min(authority, prediction)`.  Both terms
//       are <= the real magazine, so the HUD is a LOWER BOUND on it and the
//       model may never sit beneath it.  This module's header has always said
//       "it can only ever read LOW" and then never used the fact.
//    2. THE REFUSED-RELOAD RECOVERY.  If the model says empty and the reserve
//       is not, and no reload has started for `g_DBOT_STUCK_F` frames, then
//       `wpn_reload_begin` is refusing, and it refuses for exactly one other
//       reason: THE MAGAZINE IS FULL.  So set the model full.  This catches the
//       case the floor cannot — a `client_ammo` that latched at 0.
//
//  Neither repair can ever lower the model, so neither can make the bot fire a
//  round it does not have; the authority refuses that anyway.
//
//  =========================================================================
//  §ERRAND — THE BOT NOW PLAYS THE WHOLE LOOP, NOT ONLY ITS FIRST ACT
//  =========================================================================
//  Gate 8 measured the old driver directly: `kits placed 0, lanterns fed 7,
//  CAMP lux 256/512 at 300 s`, with four unused lantern kits in the pack.  It
//  lit the tutorial lantern and then fought forever.  Every `--demo` frame
//  rate, triangle peak and screenshot anyone has quoted was therefore of a game
//  playing only its first minute.
//
//  So there is a SECOND LAYER in this file now.  `demobot_frame` runs the
//  combat driver first, unchanged and verbatim, and then `demobot_errand`,
//  which overrides movement and the interaction keys WHEN AND ONLY WHEN the
//  combat driver has nothing to shoot.  Out, fight, carry it home, plant, talk,
//  trade, walk back out.  `demobot_set_errand(b, 0)` turns the layer off and
//  gives you the driver that shipped before this wave, byte for byte — that is
//  the control arm, and `probe_session` runs it as one.
//
//  MEASURED, `probe_session`, one hour of game time, seed 1337, NO FIXTURE
//  ANYWHERE, one boolean apart:
//
//                             ERRAND OFF   ERRAND ON      (the control / this)
//      town trips                      0           3
//      posts planted                   0          10
//      conversations                   0           3
//      trades completed                0           3
//      guns owned at 60:00             1           2
//      settlement tier              CAMP     VILLAGE
//      core lux                      256        1635
//      buildings                       2           9
//      villagers                       0           7 (3 named)
//      lanterns the player lit         1          11
//      regard (Wick)                   0          21
//      PLAYER DEATHS                 354         103
//
//  and over 8 seeds x 30 game minutes: 8 OF 8 REACH VILLAGE, between 24:47 and
//  25:10 elapsed, fewest posts 4.  The last new thing in the hour moved from
//  THE_HOUR_2's 24:53 to 57:00.
//
//  Read the death row last and read it twice.  Walking home is not only richer
//  than standing at the post, it is SAFER: 103 against 354.  The standing
//  driver's post stops being holdable at 52:00 — its last kill — after which it
//  respawns, fires about one round per life and dies eleven times a minute.
//
//  THE THREE RULES THE BROKEN DRIVERS BROKE, each now a named clause:
//
//    A. AN ERRAND NEVER OUTRANKS A FIGHT.  The layer returns without touching a
//       button whenever the nearest body is inside `g_DBOT_ENGAGE_M` — the
//       exact range at which the combat driver has a target it would shoot.  It
//       therefore CANNOT suppress BTN_FIRE while there is anything to fire at,
//       which is the failure THE_HOUR_2 §8.1 asked for.
//    B. DEATH ENDS THE ERRAND.  Respawn is at the FIRST post (server.hml:1493),
//       ~280 m from the town, so an errand that survives a death sends a fresh
//       corpse straight back down the same road.  Death returns the bot to
//       HOLD and forfeits the day's trip.
//    C. DUSK ENDS THE ERRAND.  Dawn and day are for walking; dusk and night
//       belong to the post, because the light is the ammunition.  A trip that
//       has not finished by dusk is abandoned and the bot walks home.
//
//  WHAT THE ERRAND LAYER READS, AND THE ONE ORACLE IN IT, DECLARED
//  ---------------------------------------------------------------
//  Navigation is CLIENT-SIDE and every value is on the player's screen:
//    * `client_settle_x` / `client_settle_z` — the settlement the compass
//      diamond has pointed at since the first lantern was lit (main.hml:2054).
//    * `client_settle_inside` — "a post planted here counts", which the
//      teach-the-verb work draws on the ground as the Great Lantern's reach
//      whenever you are carrying a wick.  The bot plants ONLY where the HUD
//      says the grid will take it; it does not compute the ring itself.
//    * `client_chan01` — the channel ring, so the 2.5 s hold is timed off the
//      thing the player watches instead of off a frame count that is wrong at
//      any frame rate but 60.
//    * `client_phase`, `client_pack_kits`, `client_npc_count`,
//      `client_ui_panel`, `client_ui_rows` — sky, pack, town, panel.
//
//  >>> THE ORACLE, AND IT IS EXACTLY ONE THING. <<<  Walking to a NAMED
//  VILLAGER reads `npc_x` / `npc_z` off the server store, because `client.hml`
//  publishes no villager position.  That is a MISSING CLIENT ACCESSOR and not a
//  hidden fact: `main.hml:1240` reads those same two functions to DRAW the
//  villagers, so the position this bot walks to is a body standing in the
//  player's frame.  It is still a read the wire does not carry, it is declared
//  here for the same reason `probe_session` declares ARM WALK's, and it should
//  be deleted the day `client.hml` publishes villager positions.
// =============================================================================

import { sqrt, sin, cos, atan2 } from "@stdlib/math";

import { g_ENEMY_KIND_COUNT } from "../core/config.hml";

import { ai_height_of, ai_speed_of, ai_damage_of } from "../sim/ai.hml";
import { wpn_mag, wpn_max_range, WPN_KESTREL } from "../sim/weapons.hml";
import { BTN_FIRE, BTN_USE, BTN_ADS, BTN_SPRINT, BTN_RELOAD,
         BTN_BUILD, BTN_SWITCH, BTN_GRENADE, BTN_INV } from "../sim/command.hml";
import { PHASE_DAWN, PHASE_DAY } from "../sim/daycycle.hml";
import { npc_present, npc_slot_of, npc_x, npc_z,
         NPC_NONE, NPC_NAMED } from "../sim/npc.hml";

import { server_lantern_x, server_lantern_z, SV_PSLOT,
         SV_MODEL_LANTERN, SV_MODEL_PICKUP,
         server_settle, server_npcs, server_tick_now,
         UI_PANEL_TRADE } from "./server.hml";

import { client_set_angles, client_set_move, client_set_button,
         client_press_fire, client_reserve, client_dead, client_lantern_lit,
         client_ent_count, client_ent_id, client_ent_x, client_ent_y,
         client_ent_z, client_ent_model, client_ads, client_cam_y,
         client_shots, client_reloading, client_ammo, client_phase,
         client_pack_kits, client_settle_x, client_settle_z,
         client_settle_inside, client_npc_count, client_ui_panel,
         client_ui_rows, client_chan01 } from "./client.hml";

// ---------------------------------------------------------------------------
//  THE EIGHT CONSTANTS.  Every one of them is a measured number, not a taste.
// ---------------------------------------------------------------------------
export let g_DBOT_KEEP_M: f64    = 9.0;    // back off anything closer than this
export let g_DBOT_LEASH_M: f64   = 16.0;   // ...but never further than this from the post
export let g_DBOT_CALM_M: f64    = 12.0;   // "nothing is close" — the free reload window
export let g_DBOT_TOPUP: i32     = 3;      // reload at or below this many rounds
export let g_DBOT_HIP_M: f64     = 0.0;    // MEASURED: iron sights at every range wins
export let g_DBOT_ENGAGE_M: f64  = 20.0;   // let it walk in; do not chip across the ring
export let g_DBOT_BREAK_M: f64   = 4.5;    // inside this, stop shooting and BREAK CONTACT
export let g_DBOT_CLEAR_M: f64   = 14.0;   // ...and re-engage once the nearest is past this

// §AMMO-LATCH repair 2. Frames of "the model says empty, the reserve does not,
// and no reload has started". `wpn_reload_begin` refuses only on a FULL
// magazine or an EMPTY reserve; the reserve is not empty, so 120 frames — two
// seconds at 60 fps, twenty times the round-trip a held BTN_RELOAD needs to
// show up as `client_reloading > 0` — is the authority saying the gun is full.
export let g_DBOT_STUCK_F: i32   = 120;

// ---------------------------------------------------------------------------
//  §ERRAND — THE SIX STATES OF A LAMPLIGHTER, AND THEIR NUMBERS
// ---------------------------------------------------------------------------
export let DBOT_ST_HOLD: i32  = 0;   // the post. The combat driver owns it.
export let DBOT_ST_IN: i32    = 1;   // walking home
export let DBOT_ST_PLANT: i32 = 2;   // putting posts in the ground
export let DBOT_ST_TALK: i32  = 3;   // walking to a villager
export let DBOT_ST_SHOP: i32  = 4;   // talking, then pressing every row
export let DBOT_ST_OUT: i32   = 5;   // walking back to the post

// "Standing on the green." Wide, because the green is where the decision about
// WHERE to plant starts, not where any single post goes.
export let g_DBOT_GREEN_M: f64  = 18.0;
// The plant ring. Four posts a band, 12 m out per band, starting at 24 m: every
// pair is >= 25 m apart against `SV_KIT_MIN_GAP_M`'s 12 m, and band 3 lands at
// 60 m, inside the Camp's 64 m ring. Sixteen spots is one more than the fifteen
// posts a TOWN's 32 grid points would cost.
export let g_DBOT_RING0_M: f64  = 24.0;
export let g_DBOT_RING_D_M: f64 = 12.0;
export let g_DBOT_SPOTS: i32    = 16;
export let g_DBOT_SPOT_M: f64   = 1.4;    // "arrived at the spot"
// The channel is 2.5 s of SIM time and this is its TIMEOUT, not its length:
// completion is detected off `client_chan01`, the ring the player watches, so
// the hold is correct at any frame rate. 600 frames is 10 s at 60 fps and still
// 7 s at 85 — comfortably past 2.5 s either way.
export let g_DBOT_CHAN_MAX_F: i32 = 600;
export let g_DBOT_TALK_M: f64   = 2.2;    // NPC_TALK_M is 2.6; stop just inside
export let g_DBOT_POST_M: f64   = 8.0;    // "back at the post"
// Frames the cursor sits on one shop row. FOUR SECONDS, and the number is set
// by a file this module does not own: `main.hml`'s `demo_drive` OVERWRITES
// BTN_GRENADE every frame after this function returns, to throw the Flare — and
// BTN_GRENADE is also the trade panel's CONFIRM. In `--demo` the bot's own
// confirm press is therefore clobbered, and the only edges that land are the
// Flare's, which arrive every 2.0 s while the panel is open (the panel eats the
// cast, so the spell cooldown never starts). 240 frames guarantees at least one
// per row on that path and costs nothing on the probe path, where the bot's own
// press works. REPORTED, not smuggled — see this task's report.
export let g_DBOT_ROW_F: i32    = 240;
export let g_DBOT_ROWS_MAX: i32 = 6;      // rows swept per villager per visit
// Frames after the plant press by which `client_pack_kits` must have dropped.
// If it has not, `sv_place_kit` refused this spot (something is already inside
// SV_KIT_MIN_GAP_M) and the channel that follows would be 10 s spent holding E
// on nothing.
export let g_DBOT_PLANT_ACK_F: i32 = 20;

// ---------------------------------------------------------------------------
//  STATE.  One object per driven client.
// ---------------------------------------------------------------------------
export fn demobot_new(p_cl: object, p_sv: object): object {
    let b: object = {
        cl: p_cl,
        sv: p_sv,
        target: 0,                       // the id it is holding on
        mag: wpn_mag(WPN_KESTREL),       // the RECONSTRUCTED magazine
        sh_prev: 0,
        rel_prev: 0.0,
        mag0: 0,
        res0: 0,
        dry_watch: 0,
        stuck: 0,                        // §AMMO-LATCH repair 2's counter
        brk: 0,                          // in BREAK CONTACT
        fired: 0,                        // edge flags, for the viewmodel
        reloaded: 0,
        // --- §ERRAND ------------------------------------------------------
        errand: 1,       // the layer is ON by default; this is the shipping bot
        est: 0,          // DBOT_ST_*
        due: 0,          // a dawn has broken and today's trip is not yet made
        ph_prev: 0 - 1,  // last frame's `client_phase`, for the dawn edge
        near_d: 1.0e30,  // nearest hostile, published by the combat pass
        spot: 0,         // the ring position the NEXT post goes on. MONOTONE.
        chan: 0 - 1,     // frames of USE held on the post underfoot; -1 = idle
        saw_chan: 0,     // `client_chan01` has been seen above zero this hold
        kits0: 0,        // pack count at the plant press, to detect a refusal
        who: NPC_NONE,   // the villager it is walking to
        widx: 0,         // sweep cursor over the named villagers
        pump: 0,         // frames since this villager's conversation opened
        rowi: 0,         // rows swept for this villager
        trips: 0,        // completed round trips
        presses: 0       // TALK presses issued
    };
    let out: object = b;
    return out;
}

// The two edges `main.hml` needs so the hands keep moving. They are strictly
// presentation: nothing in the policy above reads them.
export fn demobot_fired(p_b: object): i32 { let b: object = p_b; let o: i32 = b.fired; return o; }
export fn demobot_reloaded(p_b: object): i32 { let b: object = p_b; let o: i32 = b.reloaded; return o; }
export fn demobot_mag(p_b: object): i32 { let b: object = p_b; let o: i32 = b.mag; return o; }
export fn demobot_breaking(p_b: object): i32 { let b: object = p_b; let o: i32 = b.brk; return o; }

// §ERRAND's switch and its report. `demobot_set_errand(b, 0)` is the CONTROL
// ARM: the layer stops running and what is left is the driver that shipped
// before this wave, byte for byte, because the combat pass below is unchanged.
export fn demobot_set_errand(p_b: object, p_on: i32) { let b: object = p_b; b.errand = p_on; }
export fn demobot_errand_on(p_b: object): i32 { let b: object = p_b; let o: i32 = b.errand; return o; }
export fn demobot_state(p_b: object): i32 { let b: object = p_b; let o: i32 = b.est; return o; }
export fn demobot_trips(p_b: object): i32 { let b: object = p_b; let o: i32 = b.trips; return o; }
export fn demobot_presses(p_b: object): i32 { let b: object = p_b; let o: i32 = b.presses; return o; }
export fn demobot_spots_used(p_b: object): i32 { let b: object = p_b; let o: i32 = b.spot; return o; }
export fn demobot_near_d(p_b: object): f64 { let b: object = p_b; let o: f64 = b.near_d; return o; }

// ---------------------------------------------------------------------------
//  THE RECONSTRUCTED MAGAZINE
// ---------------------------------------------------------------------------
//  See the header: `client_ammo` latches low, so the bot keeps its own count
//  from the authority's shot counter and the reload transitions.
// ---------------------------------------------------------------------------
fn demobot_ammo_sync(p_b: object) {
    let b: object = p_b;
    let cl: object = b.cl;
    let cap: i32 = wpn_mag(WPN_KESTREL);

    // 1. a reload ENDING first — `sim.hml` stage (c) runs reload before fire
    //    inside one tick, so a tick that both seats the magazine and fires must
    //    be applied in that order or the shot is lost and the model runs high.
    //    A reload STARTING remembers what it will have to work with; the end
    //    applies `wpn_reload_begin`'s own rule — min(space, reserve).
    let rt: f64 = client_reloading(cl);
    b.reloaded = 0;
    if (rt > 0.0 && b.rel_prev <= 0.0) {
        b.mag0 = b.mag;
        b.res0 = client_reserve(cl);
        b.reloaded = 1;
    }
    if (rt <= 0.0 && b.rel_prev > 0.0) {
        let need: i32 = cap - b.mag0;
        let moved: i32 = b.res0;
        if (moved > need) { moved = need; }
        if (moved < 0) { moved = 0; }
        b.mag = b.mag0 + moved;
    }
    b.rel_prev = rt;

    // 2. every shot the AUTHORITY counted comes out of the magazine.
    let sh: i32 = client_shots(cl);
    let d: i32 = sh - b.sh_prev;
    b.fired = 0;
    if (d > 0) {
        b.mag = b.mag - d;
        if (b.mag < 0) { b.mag = 0; }
        b.dry_watch = 0;
        b.fired = 1;
    }
    b.sh_prev = sh;

    // 3. the watchdog. `dry_watch` counts frames the trigger was held with a
    //    target in range and nothing came out. `wpn_shot_interval` for the
    //    Kestrel is 0.30 s; 30 frames is twice that, so a lull, a reload or an
    //    ADS transition cannot trip it — only an empty chamber can.
    if (b.dry_watch > 30) {
        b.mag = 0;
        b.dry_watch = 0;
    }
    if (b.mag > cap) { b.mag = cap; }

    // 4. >>> §AMMO-LATCH REPAIR 1 — THE FLOOR. <<<
    //    `client_ammo` is `min(authority, prediction)`. BOTH terms are at most
    //    the real magazine, so the HUD is a LOWER BOUND on it and this model
    //    may never sit beneath it. Cheap, always correct, and it can only ever
    //    raise the model toward the truth — it cannot make the bot fire a round
    //    it does not have, because the authority refuses that on its own.
    let hud: i32 = client_ammo(cl);
    if (b.mag < hud) { b.mag = hud; }

    // 5. >>> §AMMO-LATCH REPAIR 2 — THE REFUSED-RELOAD RECOVERY. <<<
    //    The case the floor cannot catch is a `client_ammo` that ALSO latched
    //    at zero. `wpn_reload_begin` (weapons.hml:1200) refuses on exactly two
    //    conditions: a FULL magazine, or an EMPTY reserve. So if the model says
    //    empty, the reserve says otherwise, and no reload has begun for two
    //    seconds of held BTN_RELOAD, the authority is telling us the magazine
    //    is full. Believe it. Without this the driver deadlocks: it will not
    //    fire because the model says empty, and the model is only ever repaired
    //    by firing or by a reload that will not start.
    let res: i32 = client_reserve(cl);
    if (b.mag <= 0 && res > 0 && rt <= 0.0 && client_dead(cl) == 0) {
        b.stuck = b.stuck + 1;
        if (b.stuck > g_DBOT_STUCK_F) {
            b.mag = cap;
            b.stuck = 0;
        }
    } else {
        b.stuck = 0;
    }
}

// Move in a WORLD direction. forward = (sin yaw, -cos yaw), right = (cos yaw,
// sin yaw)  [view.hml], so the two axes are the projections onto that basis.
fn demobot_move_world(p_cl: object, p_yaw: f64, p_wx: f64, p_wz: f64) {
    let yaw: f64 = p_yaw;
    let wx: f64 = p_wx;
    let wz: f64 = p_wz;
    let m: f64 = sqrt(wx * wx + wz * wz);
    if (m < 0.0001) { client_set_move(p_cl, 0.0, 0.0); return; }
    let ux: f64 = wx / m;
    let uz: f64 = wz / m;
    let sy: f64 = sin(yaw);
    let cy: f64 = cos(yaw);
    let fwd: f64 = ux * sy + uz * (0.0 - cy);
    let str: f64 = ux * cy + uz * sy;
    client_set_move(p_cl, fwd, str);
}

fn demobot_dl(p_px: f64, p_pz: f64, p_lx: f64, p_lz: f64): f64 {
    let dx: f64 = p_px - p_lx;
    let dz: f64 = p_pz - p_lz;
    let out: f64 = sqrt(dx * dx + dz * dz);
    return out;
}

// ---------------------------------------------------------------------------
//  ONE FRAME OF THE DEMO PLAYER — THE COMBAT HALF
// ---------------------------------------------------------------------------
//  `p_px` / `p_pz` are the client's own position, passed in rather than read,
//  so this module needs no accessor `main.hml` does not already import.
//
//  UNCHANGED from the driver that shipped, deliberately, apart from the two
//  lines that publish `b.near_d` — the ARM 5 == ARM 6 equality in
//  `probe_firstminute` is this port's only drift guard and it is a statement
//  about THIS function. §ERRAND is a separate pass, below.
// ---------------------------------------------------------------------------
fn demobot_combat(p_b: object, p_px: f64, p_pz: f64) {
    let b: object = p_b;
    let cl: object = b.cl;
    let sv2: object = b.sv;
    let px: f64 = p_px;
    let pz: f64 = p_pz;

    demobot_ammo_sync(b);
    // Published for §ERRAND, which yields the frame entirely whenever this is
    // inside `g_DBOT_ENGAGE_M`. Set here so the death and pre-lantern returns
    // below leave it in a state that means "nothing to shoot".
    b.near_d = 1.0e30;

    if (client_dead(cl) == 1) {
        client_set_move(cl, 0.0, 0.0);
        client_set_button(cl, BTN_FIRE, 0);
        client_set_button(cl, BTN_RELOAD, 0);
        client_set_button(cl, BTN_USE, 0);
        // NOTE: SPRINT and ADS are deliberately NOT cleared here. That looks
        // like an oversight and it is a fidelity choice: this branch is
        // verbatim from `probe_waveone.hml`'s bot, and the probe asserts ARM 5
        // (that bot) and ARM 6 (this module) clear the SAME number of seeds.
        // Clearing two extra bits here would silently break that equality and
        // cost the only guard there is against this port drifting again.
        return;
    }

    let lx: f64 = server_lantern_x(sv2);
    let lz: f64 = server_lantern_z(sv2);

    // ---- before the light: walk to the post and hold E --------------------
    if (client_lantern_lit(cl) == 0) {
        let bx: f64 = lx - px;
        let bz: f64 = lz - pz;
        let d: f64 = sqrt(bx * bx + bz * bz);
        client_set_angles(cl, atan2(bx, 0.0 - bz), 0.0);
        client_set_button(cl, BTN_FIRE, 0);
        client_set_button(cl, BTN_RELOAD, 0);
        if (d > 1.8) {
            client_set_move(cl, 1.0, 0.0);
            client_set_button(cl, BTN_USE, 0);
        }
        if (d <= 1.8) {
            client_set_move(cl, 0.0, 0.0);
            client_set_button(cl, BTN_USE, 1);
        }
        return;
    }
    client_set_button(cl, BTN_USE, 0);

    // ---- pick a target: SECONDS OF DAMAGE INBOUND, not distance -----------
    // Distance alone shoots the slow thing and lets the fast thing land on your
    // face, but pure time-to-contact is not right either: it sends rounds at a
    // 6-damage Wisp sprinting in from 25 m while an 18-damage Husk is four
    // metres away. The score is `(distance / speed) / damage` — how soon it
    // lands, weighted by how much it costs when it does — and the tables it
    // reads are the same ones the enemies run on.
    //
    // Bodies OUTSIDE the engagement range are ranked separately and used only
    // for facing. Letting them win the priority makes the bot hold fire at a
    // 25 m Wisp while a Husk closes to swipe range.
    let best_s: f64 = 1.0e30;
    let tx: f64 = 0.0;
    let tz: f64 = 0.0;
    let ty: f64 = 0.0;
    let tdist: f64 = 0.0;
    let have: i32 = 0;
    let best_id: i32 = 0;

    // TARGET PERSISTENCE. Re-scoring every frame makes the bot spray one round
    // each at six different bodies and finish none of them: a Husk is two
    // rounds and a Spitter is two, so switching between shots kills nothing.
    // MEASURED without this: 45 rounds fired, 8 kills — 5.6 rounds per kill
    // against a pool whose mean is 1.55.
    let held: i32 = b.target;
    let held_seen: i32 = 0;

    let far_s: f64 = 1.0e30;
    let fx2: f64 = 0.0;
    let fz2: f64 = 0.0;
    let fy2: f64 = 0.0;
    let fdist: f64 = 0.0;
    let have_far: i32 = 0;

    let near_d: f64 = 1.0e30;
    let near_x: f64 = 0.0;
    let near_z: f64 = 0.0;
    let repx: f64 = 0.0;
    let repz: f64 = 0.0;

    let eye: f64 = client_cam_y(cl);
    let n: i32 = client_ent_count(cl);
    let i: i32 = 0;
    while (i < n) {
        let md: i32 = client_ent_model(cl, i);
        let id: i32 = client_ent_id(cl, i);
        if (md != SV_MODEL_LANTERN && md != SV_MODEL_PICKUP && id != SV_PSLOT) {
            if (md >= 0 && md < g_ENEMY_KIND_COUNT) {
                let ex: f64 = client_ent_x(cl, i) - px;
                let ez: f64 = client_ent_z(cl, i) - pz;
                let dd: f64 = sqrt(ex * ex + ez * ez);
                let spd: f64 = ai_speed_of(md);
                if (spd < 0.5) { spd = 0.5; }
                let dmg: f64 = ai_damage_of(md);
                if (dmg < 1.0) { dmg = 1.0; }
                let sc: f64 = dd / (spd * dmg);
                // Centre mass, not the feet: the snapshot y is the body's base
                // and `combat.hml` traces a 3-D ray at eye height, so a bot
                // that aims at y+0 shoots the dirt in front of a 1.8 m Husk.
                let cy2: f64 = client_ent_y(cl, i) + ai_height_of(md) * 0.5 - eye;
                if (dd <= g_DBOT_ENGAGE_M) {
                    if (id == held && held != 0) {
                        held_seen = 1;
                        sc = 0.0 - 1.0;          // the held target always wins
                    }
                    if (sc < best_s) {
                        best_s = sc; tx = ex; tz = ez; ty = cy2; tdist = dd;
                        have = 1; best_id = id;
                    }
                }
                if (dd > g_DBOT_ENGAGE_M) {
                    if (sc < far_s) {
                        far_s = sc; fx2 = ex; fz2 = ez; fy2 = cy2; fdist = dd; have_far = 1;
                    }
                }
                if (dd < near_d) { near_d = dd; near_x = ex; near_z = ez; }
                // Repulsion from EVERY body inside the keep-out radius, not
                // just the nearest. Backing away from the nearest alone walks
                // straight into the second one.
                if (dd < g_DBOT_KEEP_M && dd > 0.001) {
                    let wgt: f64 = (g_DBOT_KEEP_M - dd) / g_DBOT_KEEP_M * dmg / 18.0;
                    repx = repx - ex / dd * wgt;
                    repz = repz - ez / dd * wgt;
                }
            }
        }
        i++;
    }
    if (have == 0 && have_far == 1) {
        tx = fx2; tz = fz2; ty = fy2; tdist = fdist;
    }
    b.target = best_id;
    if (held_seen == 0 && held != 0) { b.target = best_id; }
    b.near_d = near_d;                   // published for §ERRAND
    let any: i32 = have + have_far;
    let ammo: i32 = b.mag;
    let res: i32 = client_reserve(cl);

    // ---- BREAK CONTACT -----------------------------------------------------
    // A Husk stops at 1.8 m and swings 18 damage every wind-up. Backpedalling
    // at 4.4 m/s does not escape a 5.2 m/s charge and iron sights make it
    // 2.9 m/s, so a bot that keeps shooting while something is on its face
    // trades 100 HP for four rounds. SPRINT is 7.0 m/s and outruns every
    // tier-1/2 class (Wisp 6.4 is the fastest in the pool) — but only inside a
    // +/-40 deg forward cone, so breaking contact means TURNING AND RUNNING,
    // which is exactly what it costs a real player.
    //
    // `g_REGEN_DELAY_S` (4 s) and `g_REGEN_RATE` (25 HP/s) are in
    // `core/config.hml` and NOTHING IN `src/` READS EITHER — health regen is
    // designed and unimplemented. So the 100 HP the player wakes up with is the
    // entire health budget of the first minute and every point of it must be
    // bought with footwork. Disengaging is not a fallback; it is the only
    // defensive mechanic that exists.
    //
    // THE TRIGGER IS AN INABILITY, NOT A FEELING. Three wider triggers were
    // measured over the same 12 first minutes and all three are worse, because
    // during a wave something is ALWAYS close and a wide trigger latches into a
    // 90-second retreat.
    let brk: i32 = b.brk;
    if (ammo <= 0 && near_d < g_DBOT_BREAK_M) { brk = 1; }
    if (brk == 1) {
        if (ammo > 0) { brk = 0; }
        if (near_d > g_DBOT_CLEAR_M) { brk = 0; }
    }
    b.brk = brk;
    if (brk == 1) {
        let ax2: f64 = repx;
        let az2: f64 = repz;
        if (ax2 * ax2 + az2 * az2 < 0.000001) { ax2 = 0.0 - near_x; az2 = 0.0 - near_z; }
        if (demobot_dl(px, pz, lx, lz) > g_DBOT_LEASH_M) { ax2 = lx - px; az2 = lz - pz; }
        let byaw: f64 = atan2(ax2, 0.0 - az2);
        client_set_angles(cl, byaw, 0.0);
        client_set_move(cl, 1.0, 0.0);
        client_set_button(cl, BTN_SPRINT, 1);
        client_set_button(cl, BTN_ADS, 0);
        client_set_button(cl, BTN_FIRE, 0);
        // Reload WHILE running. `wpn_step` never cancels a reload for sprinting
        // (weapons.hml has no cancel at all), so the 2.4 s empty reload and the
        // 2.4 s of footwork are the same 2.4 s. That is the whole trick to
        // surviving a dry magazine without the melee the design intends.
        let want_r: i32 = 0;
        if (ammo < wpn_mag(WPN_KESTREL) && res > 0) { want_r = 1; }
        client_set_button(cl, BTN_RELOAD, want_r);
        return;
    }
    client_set_button(cl, BTN_SPRINT, 0);

    // ---- aim: yaw AND pitch. `combat.hml` builds the axis from both. -------
    let yaw: f64 = 0.0;
    let pitch: f64 = 0.0;
    if (any > 0) {
        yaw = atan2(tx, 0.0 - tz);
        pitch = atan2(ty, tdist);
    }
    if (any == 0) { yaw = atan2(lx - px, 0.0 - (lz - pz)); }
    client_set_angles(cl, yaw, pitch);

    // IRON SIGHTS, ALWAYS. The Kestrel's cone is 3.6 deg hip (6.5 bloomed) and
    // 0.20 deg aimed, so at 20 m that is a 0.63 m scatter radius against a
    // 0.35 m Wisp — hip fire at range is a coin flip. MEASURED, rounds per kill
    // over the same 12 first minutes:
    //      hip only            8.5
    //      hip <5 m, ADS out   4.8
    //      ADS always          3.1      <- shipped
    let want_ads: i32 = 0;
    if (any > 0 && tdist > g_DBOT_HIP_M) { want_ads = 1; }
    client_set_button(cl, BTN_ADS, want_ads);

    // ---- footwork: kite, on a leash to the light ---------------------------
    // Back off what is on top of you; never leave the supply radius. THE LEASH
    // WINS when they disagree, because leaving the light is how the ammo
    // economy of the first minute ends — and walking out of it and never back
    // is the entire bug this module was written to kill.
    let dl: f64 = demobot_dl(px, pz, lx, lz);
    let mvx: f64 = repx;
    let mvz: f64 = repz;
    let rm: f64 = sqrt(mvx * mvx + mvz * mvz);
    if (rm > 0.0001) {
        // Circle-strafe rather than pure backpedal: a perpendicular component
        // keeps the post in reach instead of walking a straight line into the
        // dark, and a body that is orbited has to keep re-steering.
        let sx: f64 = 0.0 - mvz / rm;
        let sz: f64 = mvx / rm;
        mvx = mvx / rm + sx * 0.8;
        mvz = mvz / rm + sz * 0.8;
    }
    if (dl > g_DBOT_LEASH_M) {
        mvx = mvx + (lx - px) * 2.0 / dl;    // the leash overrides
        mvz = mvz + (lz - pz) * 2.0 / dl;
    }
    demobot_move_world(cl, yaw, mvx, mvz);

    // ---- trigger discipline ------------------------------------------------
    // Top up on the gap, not on empty. No rounds past the weapon's own max
    // range, and none at nothing.
    let rng: f64 = wpn_max_range(WPN_KESTREL);

    // BTN_RELOAD is HELD, not pressed. `wpn_reload_begin` refuses a full
    // magazine and an empty reserve on its own, so holding it is what a
    // player's finger on R does and nothing here is a shortcut.
    let want_reload: i32 = 0;
    if (ammo <= 0 && res > 0) { want_reload = 1; }
    if (ammo <= g_DBOT_TOPUP && res > 0 && near_d > g_DBOT_CALM_M) { want_reload = 1; }
    client_set_button(cl, BTN_RELOAD, want_reload);

    // `weapons.hml` gives the Kestrel 45 damage inside 14 m and 30 beyond 30 m,
    // so a 90 HP Husk is TWO rounds up close and THREE at distance. With a
    // 1.25 rounds/s resupply that third round is the whole margin, so the bot
    // lets a body walk into `g_DBOT_ENGAGE_M` instead of chipping at it across
    // the ring, and waits for the sights to settle rather than spraying through
    // the ADS transition.
    //
    // NOTE THE `want_reload == 0` TERM. The old driver held FIRE and RELOAD in
    // the same frame; the trigger wins that argument and the magazine never
    // gets seated.
    // `have == 1`, NOT `any > 0`. `any` includes the far target that is only
    // used for FACING; firing on it means chipping at bodies across the ring at
    // 30-damage falloff instead of letting them walk into the 45-damage band.
    // Measured: `any > 0` here fires 1090 rounds to ARM 5's 1028 for the same
    // 12 clears, and it broke the ARM 5 == ARM 6 equality that is this port's
    // only drift guard. Verbatim matters more than it looks.
    let fire: i32 = 0;
    if (have == 1 && ammo > 0 && tdist <= rng && want_reload == 0) {
        fire = 1;
        if (want_ads == 1 && client_ads(cl) < 0.9) { fire = 0; }
    }
    if (fire == 1) {
        client_set_button(cl, BTN_FIRE, 1);
        // `client_press_fire` is the LOCAL PREDICTION of the held bit, kept on
        // the path the game ships so the muzzle flash, the kick, the shake and
        // the tracer all still happen. The server fires at `wpn_shot_interval`
        // from the held bit whether or not the client predicted the shot.
        client_press_fire(cl);
        b.dry_watch = b.dry_watch + 1;
    }
    if (fire == 0) {
        client_set_button(cl, BTN_FIRE, 0);
        b.dry_watch = 0;
    }
}

// ===========================================================================
//  §ERRAND — THE LAMPLIGHTER WHO GOES HOME
// ===========================================================================
//  Everything above this line is the driver that shipped.  Everything below is
//  the second verb, and the whole of the design contract for it is in the
//  header: it may only run when there is nothing to shoot, it forfeits its trip
//  on death, and it abandons its trip at dusk.
//
//  The plant ring.  `p_i` is MONOTONE across the whole session: trip two starts
//  where trip one stopped, so a returning lamplighter never stands on a post it
//  planted last week holding E at a spot `sv_place_kit` will refuse.
// ---------------------------------------------------------------------------
fn demobot_spot_x(p_cl: object, p_i: i32): f64 {
    let i: i32 = p_i;
    let band: i32 = i / 4;
    let k: i32 = i - band * 4;
    let r: f64 = g_DBOT_RING0_M + g_DBOT_RING_D_M * f64(band);
    let a: f64 = (f64(k) * 90.0 + f64(band) * 45.0) * 0.017453292519943295;
    let out: f64 = client_settle_x(p_cl) + sin(a) * r;
    return out;
}

fn demobot_spot_z(p_cl: object, p_i: i32): f64 {
    let i: i32 = p_i;
    let band: i32 = i / 4;
    let k: i32 = i - band * 4;
    let r: f64 = g_DBOT_RING0_M + g_DBOT_RING_D_M * f64(band);
    let a: f64 = (f64(k) * 90.0 + f64(band) * 45.0) * 0.017453292519943295;
    let out: f64 = client_settle_z(p_cl) - cos(a) * r;
    return out;
}

// Every button `sv_ui_tick` reads is a RISING EDGE, so a press that is not
// released is a press that happens once. This releases all four modal keys at
// the top of every errand frame; the state below sets at most one of them back.
fn demobot_release_ui(p_cl: object) {
    client_set_button(p_cl, BTN_BUILD, 0);
    client_set_button(p_cl, BTN_SWITCH, 0);
    client_set_button(p_cl, BTN_GRENADE, 0);
    client_set_button(p_cl, BTN_INV, 0);
}

// Head for a world point at a run. Aim goes with the feet: there is nothing to
// shoot when this runs (clause A), so the view may serve the walk.
fn demobot_go(p_cl: object, p_dx: f64, p_dz: f64) {
    let yaw: f64 = atan2(p_dx, 0.0 - p_dz);
    client_set_angles(p_cl, yaw, 0.0);
    demobot_move_world(p_cl, yaw, p_dx, p_dz);
    client_set_button(p_cl, BTN_SPRINT, 1);
    client_set_button(p_cl, BTN_ADS, 0);
}

// Forget everything that only makes sense while standing somewhere specific.
fn demobot_drop_errand(p_b: object) {
    let b: object = p_b;
    b.chan = 0 - 1;
    b.saw_chan = 0;
    b.pump = 0;
    b.rowi = 0;
    b.who = NPC_NONE;
}

fn demobot_errand(p_b: object, p_px: f64, p_pz: f64) {
    let b: object = p_b;
    let cl: object = b.cl;
    let sv2: object = b.sv;
    let px: f64 = p_px;
    let pz: f64 = p_pz;

    // ---- 0. THE OPENING OWNS THE PLAYER -----------------------------------
    // Until the tutorial lantern is lit there is no town on the wire, no kit in
    // the pack and no verb to perform.
    if (client_lantern_lit(cl) == 0) {
        b.est = DBOT_ST_HOLD;
        return;
    }

    // ---- 1. THE SKY IS THE ONLY CLOCK IT READS ----------------------------
    // A dawn EDGE arms one trip. `b.ph_prev` starts negative so a session that
    // begins at dawn does not manufacture an edge out of its first frame.
    let ph: i32 = client_phase(cl);
    if (b.ph_prev >= 0 && ph == PHASE_DAWN && b.ph_prev != PHASE_DAWN) { b.due = 1; }
    b.ph_prev = ph;

    // ---- 2. CLAUSE B: DEATH ENDS THE TRIP, NOT THE ERRAND ------------------
    // `server.hml:1493` respawns the player at the FIRST post, ~280 m from the
    // town, so an errand that SURVIVES a death resumes a walk from a place the
    // player is no longer standing. The trip is therefore abandoned and the bot
    // goes back to holding.
    //
    // >>> BUT `b.due` IS DELIBERATELY LEFT ARMED, AND THAT IS A MEASURED
    // CORRECTION. <<< This block cleared it on the first attempt — "today's
    // trip is forfeit" — and the run said otherwise: the dawn edge at 24:00
    // armed the trip, the bot died twice inside that dawn, `due` went to zero,
    // and the Village that appeared at 25:00 was never visited again. TRIPS
    // FROZEN AT 1, `talks 0`, `trades 0`, thirty-five dead minutes. Clause A
    // and clause C already forbid setting out while anything is in range or
    // after dusk; a third rule forbidding it because you died an hour ago is
    // not caution, it is the bot giving up.
    if (client_dead(cl) == 1) {
        if (b.est != DBOT_ST_HOLD) { b.est = DBOT_ST_HOLD; }
        demobot_drop_errand(b);
        return;
    }

    // ---- 3. CLAUSE C: DUSK ENDS THE ERRAND --------------------------------
    // Dawn and day are for walking. Dusk and night belong to the post, because
    // the light is the ammunition and a lamplighter caught in the open at dusk
    // is a lamplighter with nothing to shoot back with.
    if (b.est != DBOT_ST_HOLD && ph != PHASE_DAWN && ph != PHASE_DAY) {
        if (b.est != DBOT_ST_OUT) {
            demobot_drop_errand(b);
            b.est = DBOT_ST_OUT;
        }
    }

    // ---- 4. CLAUSE A: AN ERRAND NEVER OUTRANKS A FIGHT --------------------
    // `g_DBOT_ENGAGE_M` is the exact range at which the combat pass above has a
    // target it would shoot, so this yields the frame WITHOUT TOUCHING A BUTTON
    // precisely when there is something to shoot. It cannot suppress BTN_FIRE
    // while anything is in range, and it cannot walk a disarmed player anywhere.
    if (b.near_d < g_DBOT_ENGAGE_M) {
        b.chan = 0 - 1;                  // a channel does not survive a fight
        b.saw_chan = 0;
        return;
    }

    // ---- 5. HOLD. Leave in the MORNING, and only for a reason --------------
    //  ARMED on the dawn edge, but the trip may start at any point in dawn OR
    //  day, and that width is a MEASURED number rather than a taste. Departure
    //  also needs clause A to be satisfied — nothing inside `g_DBOT_ENGAGE_M` —
    //  and with a dawn-only gate the run below never found such a frame after
    //  the director reached tier 2: dawn is 120 s of a 960 s day, night 3's
    //  bodies were still standing in it, and the measured result was TRIPS
    //  FROZEN AT 1, `talks 0`, `trades 0` and thirty-five minutes of a Village
    //  the player never visited. Dawn plus day is 540 s and the errand still
    //  cannot start in the dark, which is the rule that mattered.
    if (b.est == DBOT_ST_HOLD) {
        if (b.due == 1 && (ph == PHASE_DAWN || ph == PHASE_DAY)) {
            // A 280 m walk needs a purpose: a post to plant, or somebody to
            // talk to. Both are HUD facts.
            let worth: i32 = 0;
            if (client_pack_kits(cl) > 0) { worth = 1; }
            if (client_npc_count(cl) > 0) { worth = 1; }
            if (worth == 1) {
                b.due = 0;
                demobot_drop_errand(b);
                b.widx = 0;
                b.est = DBOT_ST_IN;
            }
        }
        return;                          // the combat driver's footwork stands
    }

    demobot_release_ui(cl);

    // ---- 6. WALK HOME ------------------------------------------------------
    // The compass diamond has pointed here since the first lantern was lit.
    if (b.est == DBOT_ST_IN) {
        let dx: f64 = client_settle_x(cl) - px;
        let dz: f64 = client_settle_z(cl) - pz;
        if (dx * dx + dz * dz > g_DBOT_GREEN_M * g_DBOT_GREEN_M) {
            demobot_go(cl, dx, dz);
            client_set_button(cl, BTN_USE, 0);
            return;
        }
        client_set_button(cl, BTN_SPRINT, 0);
        // Plant first, then trade: a post lit this morning is worth regard, and
        // regard is what opens the row that sells the next post.
        b.est = DBOT_ST_OUT;
        if (client_npc_count(cl) > 0) { b.est = DBOT_ST_TALK; }
        if (client_pack_kits(cl) > 0) { b.est = DBOT_ST_PLANT; }
        return;
    }

    // ---- 7. PLANT ----------------------------------------------------------
    if (b.est == DBOT_ST_PLANT) {
        if (client_pack_kits(cl) <= 0 && b.chan < 0) {
            b.est = DBOT_ST_OUT;
            if (client_npc_count(cl) > 0) { b.est = DBOT_ST_TALK; }
            return;
        }
        if (b.spot >= g_DBOT_SPOTS) { b.spot = 0; }
        let tx: f64 = demobot_spot_x(cl, b.spot);
        let tz: f64 = demobot_spot_z(cl, b.spot);
        let dx: f64 = tx - px;
        let dz: f64 = tz - pz;

        if (b.chan < 0) {
            if (dx * dx + dz * dz > g_DBOT_SPOT_M * g_DBOT_SPOT_M) {
                demobot_go(cl, dx, dz);
                client_set_button(cl, BTN_USE, 0);   // released: the NEXT press
                return;                              // is a rising edge
            }
            // >>> AND ONLY WHERE THE HUD SAYS THE GRID WILL TAKE IT. <<<
            // `client_settle_inside` is the wire's own answer to the question
            // the ring on the ground draws. A post outside it lights the road
            // and buys the town nothing, so the bot steps to the next spot
            // rather than spend a wick on one.
            if (client_settle_inside(cl) == 0) {
                b.spot = b.spot + 1;
                if (b.spot >= g_DBOT_SPOTS) {
                    b.spot = 0;
                    b.est = DBOT_ST_OUT;         // the ring is walked out
                    if (client_npc_count(cl) > 0) { b.est = DBOT_ST_TALK; }
                }
                return;
            }
            client_set_move(cl, 0.0, 0.0);
            client_set_button(cl, BTN_SPRINT, 0);
            client_set_button(cl, BTN_ADS, 0);
            client_set_button(cl, BTN_USE, 1);    // the edge -> `sv_place_kit`
            b.chan = 0;
            b.saw_chan = 0;
            b.kits0 = client_pack_kits(cl);
            return;
        }

        // Holding E on the post now under our feet. `sim.hml` stage (g) runs
        // the 2.5 s channel off the HELD bit, and `client_chan01` is the ring
        // that draws it — so completion is read off the player's own HUD and
        // this hold is correct at any frame rate.
        client_set_move(cl, 0.0, 0.0);
        client_set_button(cl, BTN_SPRINT, 0);
        client_set_button(cl, BTN_USE, 1);
        b.chan = b.chan + 1;
        let c: f64 = client_chan01(cl);
        if (c > 0.0) { b.saw_chan = 1; }
        let done: i32 = 0;
        // The plant was REFUSED (something is already inside SV_KIT_MIN_GAP_M):
        // the pack never dropped, so there is nothing under our feet to light.
        if (b.chan >= g_DBOT_PLANT_ACK_F && client_pack_kits(cl) >= b.kits0) { done = 1; }
        if (b.saw_chan == 1 && c <= 0.0) { done = 1; }   // the ring completed
        if (b.chan >= g_DBOT_CHAN_MAX_F) { done = 1; }   // ...or it never will
        if (done == 1) {
            client_set_button(cl, BTN_USE, 0);
            b.chan = 0 - 1;
            b.saw_chan = 0;
            b.spot = b.spot + 1;
        }
        return;
    }

    // ---- 8. WALK TO A VILLAGER ---------------------------------------------
    // >>> THE ONE ORACLE, DECLARED IN THE HEADER. <<< `npc_x`/`npc_z` off the
    // server store, because `client.hml` publishes no villager position —
    // `main.hml:1240` reads the same two functions to DRAW them.
    if (b.est == DBOT_ST_TALK || b.est == DBOT_ST_SHOP) {
        let sto: object = server_npcs(sv2);
        if (sto == null) { b.est = DBOT_ST_OUT; return; }
        if (b.who == NPC_NONE) {
            let w: i32 = b.widx;
            while (w < NPC_NAMED) {
                if (npc_present(sto, w) == 1) { b.who = w; w = NPC_NAMED; }
                else { w++; }
            }
            if (b.who == NPC_NONE) {
                // NOBODY ELSE IS HOME. Not a failure: the measurement.
                b.est = DBOT_ST_OUT;
                return;
            }
            b.widx = b.who + 1;
            b.pump = 0;
            b.rowi = 0;
            b.est = DBOT_ST_TALK;
        }
        let slot: i32 = npc_slot_of(sto, b.who);
        if (slot < 0) { b.who = NPC_NONE; return; }
        let st: object = server_settle(sv2);
        let tick: i32 = server_tick_now(sv2);
        let dx: f64 = npc_x(sto, st, slot, tick) - px;
        let dz: f64 = npc_z(sto, st, slot, tick) - pz;
        if (dx * dx + dz * dz > g_DBOT_TALK_M * g_DBOT_TALK_M) {
            // They wander. If one walks off mid-conversation, chase and resume
            // where the cursor was rather than start the row sweep again.
            demobot_go(cl, dx, dz);
            client_set_button(cl, BTN_USE, 0);
            b.est = DBOT_ST_TALK;
            return;
        }
        client_set_move(cl, 0.0, 0.0);
        client_set_button(cl, BTN_SPRINT, 0);
        client_set_button(cl, BTN_ADS, 0);
        client_set_angles(cl, atan2(dx, 0.0 - dz), 0.0);
        if (b.est == DBOT_ST_TALK) {
            b.est = DBOT_ST_SHOP;
            b.pump = 0;
            client_set_button(cl, BTN_USE, 0);    // one released frame first
            return;
        }

        // ---- 9. TALK, THEN PRESS EVERY ROW ---------------------------------
        let p: i32 = b.pump;
        b.pump = p + 1;
        client_set_button(cl, BTN_USE, 0);
        if (p == 0) {
            client_set_button(cl, BTN_USE, 1);    // TALK — `sv_ui_tick`'s USE
            b.presses = b.presses + 1;
            return;
        }
        if (p == 1) { return; }                   // released
        if (p == 2) { client_set_button(cl, BTN_BUILD, 1); return; }   // TRADE
        if (p == 3) { return; }
        if (client_ui_panel(cl) != UI_PANEL_TRADE) {
            // It never opened, or it closed under us. Do not sit here pressing
            // CONFIRM at nothing for six rows.
            b.who = NPC_NONE;
            b.pump = 0;
            b.rowi = 0;
            b.est = DBOT_ST_TALK;
            return;
        }
        // `sv_ui_tick` opens the cursor on `npc_trade_first_open` — the first
        // row it will actually say yes to — so the sweep starts on something
        // takeable and steps from there.
        let q: i32 = p - 4;
        let k: i32 = q - (q / g_DBOT_ROW_F) * g_DBOT_ROW_F;
        if (k == 0) { client_set_button(cl, BTN_GRENADE, 1); }              // CONFIRM
        if (k == g_DBOT_ROW_F - 2) { client_set_button(cl, BTN_SWITCH, 1); } // NEXT ROW
        if (k == g_DBOT_ROW_F - 1) {
            b.rowi = b.rowi + 1;
            let rows: i32 = client_ui_rows(cl);
            if (rows > g_DBOT_ROWS_MAX) { rows = g_DBOT_ROWS_MAX; }
            if (rows < 1) { rows = 1; }
            if (b.rowi >= rows) {
                client_set_button(cl, BTN_BUILD, 1);    // close the panel
                b.who = NPC_NONE;
                b.pump = 0;
                b.rowi = 0;
                b.est = DBOT_ST_TALK;                   // next villager
            }
        }
        return;
    }

    // ---- 10. WALK BACK OUT -------------------------------------------------
    // Note what is NOT here: BTN_USE is released for the whole walk. The
    // previous town driver held it down "to plant on the way", which spends
    // exactly one kit (a held key is one rising edge) into open country where
    // `settle_lux_at` has fallen to nothing.
    if (b.est == DBOT_ST_OUT) {
        client_set_button(cl, BTN_USE, 0);
        let dx: f64 = server_lantern_x(sv2) - px;
        let dz: f64 = server_lantern_z(sv2) - pz;
        if (dx * dx + dz * dz > g_DBOT_POST_M * g_DBOT_POST_M) {
            demobot_go(cl, dx, dz);
            return;
        }
        client_set_button(cl, BTN_SPRINT, 0);
        b.est = DBOT_ST_HOLD;
        b.trips = b.trips + 1;
    }
}

// ---------------------------------------------------------------------------
//  THE ENTRY POINT.  Signature unchanged: `main.hml`, `probe_firstminute`,
//  `probe_session` and `probe_lanfeed` all call this and three of the four are
//  files this task does not own.
// ---------------------------------------------------------------------------
export fn demobot_frame(p_b: object, p_px: f64, p_pz: f64) {
    let b: object = p_b;
    demobot_combat(b, p_px, p_pz);
    if (b.errand == 1) { demobot_errand(b, p_px, p_pz); }
}
