// ===========================================================================
//  0.  FIXED SHAPE
// ===========================================================================

let g_VERSION: string = "NIGHTSHADE W6 - the first minute, and the town you carry it home to";

let g_CHUNK_Q: i32 = 8;                 // quads per terrain chunk edge
let g_QUAD_M: f64 = 4.0;                // metres per terrain quad
let g_CHUNK_M: f64 = 32.0;
let g_CHUNK_SLOTS: i32 = 72;            // mesh pool; a 7x7 ring is 49
let g_CHUNK_BUILD_PER_FRAME: i32 = 2;   // amortised, g_BUDGET_CHUNKGEN_MS
let g_APRON_SEGS: i32 = 24;
let g_APRON_SNAP: f64 = 0.25;

let g_PROP_TRIES: i32 = 10;             // candidates per 32 m chunk
let g_LOD_NEVER: f64 = 1000000.0;

let g_K_TREE: i32 = 0;
let g_K_ROCK: i32 = 1;
let g_K_CRATE: i32 = 2;
let g_K_BARREL: i32 = 3;
let g_K_LANTERN: i32 = 4;
let g_K_BUSH: i32 = 5;
let g_K_ENEMY: i32 = 6;
let g_K_POST: i32 = 7;                  // the sim's lantern post
let g_K_VILLAGER: i32 = 8;              // W6 — a person, not a prop

// A deterministic hash in [lo,hi). Same one `walk.hml` uses; the props must be
// a pure function of position so a chunk re-meshes identically forever.
fn hrange(p_a: i32, p_b: i32, p_s: i32, p_lo: f64, p_hi: f64): f64 {
    let v: f64 = h2(p_a, p_b, p_s);
    let out: f64 = p_lo + (p_hi - p_lo) * v;
    return out;
}

fn absf(p_a: f64): f64 {
    let a: f64 = p_a;
    if (a < 0.0) { a = 0.0 - a; }
    let out: f64 = a;
    return out;
}

// ---------------------------------------------------------------------------
// THE GROUND YOU SEE IS THE GROUND YOU STAND ON.
// ---------------------------------------------------------------------------
// `world_render.hml` exports `terrain_h`, and `tools/walk.hml` builds its
// terrain from it. That is correct for a walkaround, which has no simulation,
// and WRONG for the game: the sim's collision, the AI's steering, the
// projectile raycast and the spawn heights all come from `src/sim/chunk.hml`
// over `src/sim/worldgen.hml`, and those are a different heightfield. Building
// the picture from `terrain_h` puts the player's feet at one height and the
// visible ground at another -- which is not a subtle artefact, it is walking
// through the floor.
//
// So every height in this file comes from the SIM's store, and `terrain_h` is
// used for exactly one thing: the fallback when a chunk is neither resident nor
// generatable, which cannot happen with the ring pinned but must not return a
// hole if it ever does.
//
// `chunk_height_at` generates on demand through `memo_slot` -> `chunk_get`, and
// memoises the last chunk, so the mesh builder's 4-taps-per-vertex pattern hits
// the memo almost every time.
let g_cs = null;

fn ground_h(p_x: f64, p_z: f64): f64 {
    let h: f64 = chunk_height_at(g_cs, p_x, p_z);
    if (h <= CHUNK_H_MISS) {
        let fb: f64 = terrain_h(p_x, p_z);
        return fb;
    }
    let out: f64 = h;
    return out;
}

// ===========================================================================
//  1.  BOOT STATE
// ===========================================================================

let g_win = null;
let g_target = null;
let g_in = null;
let g_bhud = null;
// The ARGB8888 readback buffer, sized FROM THE CONFIGURED FRAME, not from a
// literal. It read `alloc(320 * 240 * 4)` until 2026-07-31, which survived the
// 16:9 change only because 320x180 needs LESS memory than 320x240 — it would
// have been a silent heap overflow in the other direction. Six other files in
// the repo still carry the literal; see the task report.
let g_fb: ptr = alloc(g_RES_W * g_RES_H * 4);

let g_atlas_world = null;
let g_atlas_fx = null;
let g_tex_world = null;
let g_tex_fx = null;
let g_tex_hud = null;
let g_tex_sky = null;

let g_uvq: array<f64> = [0.0, 0.0, 0.0, 0.0];
let g_uvw: array<f64> = [0.0, 0.0, 0.0, 0.0];
let g_rect: array<i32> = [0, 0, 0, 0];
// The four crosshair arm positions hudgen_xh_place fills in. Retained, not
// allocated per frame (CLAUDE.md N6).
let g_xh: array<i32> = [0, 0, 0, 0, 0, 0, 0, 0];
let g_skyk: array<f64> = [];
let g_todsky: array<f64> = [];

let g_seed: i32 = g_WORLD_SEED_DEFAULT;
let g_upscale: i32 = g_UPSCALE_DEFAULT;
let g_audio_on: i32 = 0;
let g_snd_map: array<i32> = [];

let g_net = null;
let g_sv = null;
let g_cl = null;
let g_acc = null;
let g_vm = null;

let g_tick: i32 = 0;
let g_frames: i32 = 0;
let g_camx: f64 = 0.0;
let g_camy: f64 = 2.0;
let g_camz: f64 = 0.0;
let g_yaw_deg: f64 = 0.0;
let g_pitch_deg: f64 = 0.0;
let g_fov: f64 = 70.0;
let g_fog_far: f64 = 64.0;
let g_day_t: f64 = 0.5;
let g_wx: i32 = 0;
let g_ground_y: f64 = 0.0;
let g_relative_ok: i32 = 0;
let g_hud_on: i32 = 1;
let g_vm_mode: i32 = 2;                 // 0 off, 1 the frame graph's, 2 driven
let g_headless: i32 = 0;
let g_shot_dir: string = "";
let g_shot_seq: i32 = 0;
let g_mouse_sens: f64 = 1.0;
let g_sky_want: i32 = 1;
let g_sky_burst: i32 = 1;
let g_vsync: i32 = 0;

// ===========================================================================
//  2.  STAGE 6 + 7 — THE CALLER'S HALF OF THE FRAME
// ---------------------------------------------------------------------------
//  `src/render/**` may not import `src/art/**` (ARCHITECTURE §5.6b), so
//  `tod_eval` and the skygen bridge are the caller's, in every caller, forever.
//  This is the third caller (`shot.hml`, `walk.hml`, here) and it hits the same
//  unit mismatch the other two documented: `tod_sky_keys` hands out 0..1 and
//  skygen's key block is 0..255. Pass them through unscaled and the panorama
//  bakes BLACK. Reported again, not patched: neither art module is this task's.
// ===========================================================================

fn sky_keys_from_tod(p_env: array<f64>) {
    tod_sky_keys(g_todsky);
    for (let c = 0; c < 3; c++) {
        g_skyk[SKYK_ZEN + c] = g_todsky[TODSKY_ZENITH_R + c] * 255.0;
        g_skyk[SKYK_MID + c] = g_todsky[TODSKY_MID_R + c] * 255.0;
        g_skyk[SKYK_HOR + c] = g_todsky[TODSKY_HORIZON_R + c] * 255.0;
        g_skyk[SKYK_CLOUD_LIT + c] = g_todsky[TODSKY_CLOUD_LIT_R + c] * 255.0;
        g_skyk[SKYK_CLOUD_SHADOW + c] = g_todsky[TODSKY_CLOUD_SHADOW_R + c] * 255.0;
        g_skyk[SKYK_SUN + c] = g_todsky[TODSKY_BODY_X + c];
    }
    g_skyk[SKYK_SUN] = 0.0 - g_todsky[TODSKY_BODY_X];
    g_skyk[SKYK_FOG] = env_field(p_env, ENV_FOG_R);
    g_skyk[SKYK_FOG + 1] = env_field(p_env, ENV_FOG_G);
    g_skyk[SKYK_FOG + 2] = env_field(p_env, ENV_FOG_B);
    g_skyk[SKYK_STAR_ALPHA] = g_todsky[TODSKY_STAR_ALPHA];
    let halo: f64 = g_todsky[TODSKY_HALO];
    g_skyk[SKYK_HALO_R] = 34.0 + 22.0 * halo;
    g_skyk[SKYK_HALO_EXP] = 1.8 - 0.6 * halo;
    g_skyk[SKYK_MOON_PHASE] = 0.5;
    let occ: f64 = clamp01((g_todsky[TODSKY_CLOUD_COVER] - 0.25) / 0.75);
    g_skyk[SKYK_CLOUD_COVER] = occ * 0.45;
    skygen_set_keys(g_skyk);
}

// Stage 6. The day fraction comes from the SIM (the client's copy of it), never
// from a wall clock: `daycycle.hml` says a full day is exactly 57 600 ticks and
// the picture has to agree with the simulation about what time it is.
fn tod_step() {
    let env: array<f64> = frame_env();
    tod_set_mist_band(g_ground_y - 1.1, g_MIST_HEIGHT + 2.0);
    tod_eval(env, g_day_t, g_wx);
    env_set_camera(env, g_camx, g_camy, g_camz);

    let fnear: f64 = env_field(env, ENV_FOG_NEAR);
    let ffar: f64 = env_field(env, ENV_FOG_FAR);

    // The shade tier IS the fog wall (GDD §2.2 / config §9). A lit lantern
    // forces tier 0 inside its radius, which is the "fog warms one step" of
    // GDD §8 at 0:30 and it has to be visible from the first frame after.
    let tier: f64 = f64(client_tier(g_cl));
    if (client_lantern_lit(g_cl) == 1) {
        let d: f64 = client_lantern_dist(g_cl);
        if (d < g_LANTERN_R_T1) { tier = 0.0; }
    }
    ffar = ffar - tier * 6.0;
    if (ffar > g_FOG_FAR_CAP) { ffar = g_FOG_FAR_CAP; }
    if (ffar < 18.0) { ffar = 18.0; }
    if (fnear > ffar - 4.0) { fnear = ffar - 4.0; }
    env_set_fog(env, fnear, ffar,
                env_field(env, ENV_FOG_R), env_field(env, ENV_FOG_G),
                env_field(env, ENV_FOG_B), env_field(env, ENV_FOG_ALPHA_MAX));
    g_fog_far = ffar;
    sky_keys_from_tod(env);
}

fn sky_now() {
    skygen_mark_dirty();
    g_sky_want = 0;
    while (skygen_dirty_rows() > 0) { skygen_rebake_slice(); }
}

// ===========================================================================
//  3.  THE GROUND MATERIAL   (ported from tools/walk.hml — see the header)
// ---------------------------------------------------------------------------
//  Two rules, both load-bearing and both easy to break with a moving camera:
//  the TILE flips per quad but the VALUE is a continuous field, and the path is
//  a WORLD line, not a camera-relative one.
// ===========================================================================

let g_path_dx: f64 = 0.2588190451025208;    // sin(15 deg)
let g_path_dz: f64 = -0.9659258262890683;   // -cos(15 deg)
let g_path_half: f64 = 2.1;

fn path_w(p_x: f64, p_z: f64): f64 {
    let t: f64 = p_x * g_path_dx + p_z * g_path_dz;
    let s: f64 = p_x * g_path_dz - p_z * g_path_dx;
    let wig: f64 = sin(t * 0.030) * 6.5 + sin(t * 0.011) * 4.0;
    let off: f64 = absf(s - wig);
    let out: f64 = clamp01((g_path_half + 1.6 - off) / 1.6);
    return out;
}

fn ground_cell(p_x: f64, p_z: f64, p_slope: f64): i32 {
    let pw: f64 = path_w(p_x, p_z);
    if (pw > 0.74) { let o: i32 = CELL_COBBLE; return o; }
    if (pw > 0.32) { let o: i32 = CELL_PATH; return o; }
    if (pw > 0.10) { let o: i32 = CELL_GRAVEL; return o; }
    if (p_slope > 1.15) { let o: i32 = CELL_CLIFF; return o; }
    if (p_slope > 0.72) { let o: i32 = CELL_DIRT; return o; }
    let v: f64 = vnoise2(p_x * 0.083, p_z * 0.083, terrain_seed() + 33);
    if (v > 0.50) { let o: i32 = CELL_GRASS_B; return o; }
    let o2: i32 = CELL_GRASS_A;
    return o2;
}

fn ground_vcol(p_x: f64, p_z: f64, p_slope01: f64): i32 {
    let x: f64 = p_x;
    let z: f64 = p_z;
    let dry: f64 = clamp01((vnoise2(x * 0.083, z * 0.083, terrain_seed() + 33) - 0.40) * 2.2);
    let r: f64 = lerpf(f64(pal_r(g_GRASS_MID)), f64(pal_r(g_GRASS_DRY)), dry);
    let g: f64 = lerpf(f64(pal_g(g_GRASS_MID)), f64(pal_g(g_GRASS_DRY)), dry);
    let b: f64 = lerpf(f64(pal_b(g_GRASS_MID)), f64(pal_b(g_GRASS_DRY)), dry);
    r = lerpf(r, f64(pal_r(g_DIRT_MID)), p_slope01);
    g = lerpf(g, f64(pal_g(g_DIRT_MID)), p_slope01);
    b = lerpf(b, f64(pal_b(g_DIRT_MID)), p_slope01);
    let pw: f64 = path_w(x, z);
    if (pw > 0.0) {
        r = lerpf(r, f64(pal_r(g_STONE_HI)) * 1.42, pw);
        g = lerpf(g, f64(pal_g(g_STONE_HI)) * 1.42, pw);
        b = lerpf(b, f64(pal_b(g_STONE_HI)) * 1.42, pw);
    }
    let p: f64 = 0.86 + 0.28 * vnoise2(x * 0.06, z * 0.06, terrain_seed() + 21);
    let out: i32 = pal_pack(clampi(i32(r * p), 0, 255),
                            clampi(i32(g * p), 0, 255),
                            clampi(i32(b * p), 0, 255));
    return out;
}

// ===========================================================================
//  4.  THE STREAMING CHUNK RING
// ---------------------------------------------------------------------------
//  A fixed pool of meshes rebuilt in place (`mesh_begin` resets the arena and
//  keeps the allocation), at most `g_CHUNK_BUILD_PER_FRAME` per frame, nearest
//  first. The props in a chunk are derived ONCE at mesh time and cached beside
//  it — walk.hml measured 6.4 ms of a 13.6 ms frame when they were re-derived
//  every frame, and that measurement is why the cache exists.
// ===========================================================================

let g_cc_mesh: array = [];
let g_cc_cx: array<i32> = [];
let g_cc_cz: array<i32> = [];
let g_cc_live: array<i32> = [];
let g_cc_stamp: array<i32> = [];
let g_cc_baked: array<i32> = [];
let g_cc_cy: array<f64> = [];

let g_cp_n: array<i32> = [];
let g_cp_kind: array<i32> = [];
let g_cp_x: array<f64> = [];
let g_cp_y: array<f64> = [];
let g_cp_z: array<f64> = [];
let g_cp_yaw: array<f64> = [];
let g_cp_s: array<f64> = [];
let g_cp_sh: array<f64> = [];
let g_cp_t: array<i32> = [];

fn chunks_init() {
    for (let i = 0; i < g_CHUNK_SLOTS; i++) {
        g_cc_mesh.push(mesh_new(g_CHUNK_Q * g_CHUNK_Q * 2 + 4));
        g_cc_cx.push(0); g_cc_cz.push(0); g_cc_live.push(0);
        g_cc_stamp.push(0); g_cc_baked.push(0); g_cc_cy.push(0.0);
        g_cp_n.push(0);
        for (let k = 0; k < g_PROP_TRIES; k++) {
            g_cp_kind.push(0); g_cp_x.push(0.0); g_cp_y.push(0.0);
            g_cp_z.push(0.0); g_cp_yaw.push(0.0); g_cp_s.push(1.0);
            g_cp_sh.push(1.0); g_cp_t.push(255);
        }
    }
}

fn chunk_find(p_cx: i32, p_cz: i32): i32 {
    for (let i = 0; i < g_CHUNK_SLOTS; i++) {
        if (g_cc_live[i] != 0 && g_cc_cx[i] == p_cx && g_cc_cz[i] == p_cz) {
            let out: i32 = i;
            return out;
        }
    }
    let miss: i32 = -1;
    return miss;
}

fn chunk_evict(): i32 {
    let best: i32 = 0;
    let bstamp: i32 = 2147483647;
    for (let i = 0; i < g_CHUNK_SLOTS; i++) {
        if (g_cc_live[i] == 0) { let out: i32 = i; return out; }
        if (g_cc_stamp[i] < bstamp) { bstamp = g_cc_stamp[i]; best = i; }
    }
    let out2: i32 = best;
    return out2;
}

fn chunk_props_gen(p_slot: i32, p_cx: i32, p_cz: i32) {
    let n: i32 = 0;
    let base: i32 = p_slot * g_PROP_TRIES;
    let ox: f64 = f64(p_cx) * g_CHUNK_M;
    let oz: f64 = f64(p_cz) * g_CHUNK_M;
    let seed: i32 = terrain_seed();
    for (let k = 0; k < g_PROP_TRIES; k++) {
        let px: f64 = ox + hrange(p_cx * 97 + k, p_cz * 89 + k, seed + 7, 0.0, 32.0);
        let pz: f64 = oz + hrange(p_cx * 89 + k, p_cz * 97 + k, seed + 11, 0.0, 32.0);
        if (path_w(px, pz) > 0.30) { continue; }
        let dens: f64 = vnoise2(px * 0.017, pz * 0.017, seed + 41);
        if (h2(p_cx * 13 + k, p_cz * 17 + k, seed + 13) > dens * 1.35) { continue; }
        let pick: f64 = h2(p_cx * 31 + k, p_cz * 37 + k, seed + 19);
        let kind: i32 = g_K_TREE;
        let sc: f64 = hrange(p_cx * 41 + k, p_cz * 43 + k, seed + 23, 0.85, 1.25);
        let sh: f64 = 1.9;
        // NOTE: no decorative lanterns. GAME_DESIGN §8 at 0:06 says the unlit
        // lantern is "the ONLY vertical thing on the horizon" and "the
        // brightest object on screen" -- scattering nine more of them through
        // the props would be the single most effective way to break the beat
        // this whole task exists to deliver. The only lanterns in the world are
        // the sim's.
        if (pick > 0.88) { kind = g_K_BARREL; sh = 1.1; }
        else if (pick > 0.82) { kind = g_K_CRATE; sh = 1.0; }
        else if (pick > 0.64) { kind = g_K_BUSH; sc = 0.8 + sc * 0.5; sh = 0.9; }
        else if (pick > 0.44) { kind = g_K_ROCK; sc = 0.7 + sc * 0.9; sh = 1.2; }
        let j: f64 = hrange(p_cx * 53 + k, p_cz * 59 + k, seed + 29, 0.92, 1.08);
        let i: i32 = base + n;
        g_cp_kind[i] = kind;
        g_cp_x[i] = px;
        g_cp_y[i] = ground_h(px, pz);
        g_cp_z[i] = pz;
        g_cp_yaw[i] = hrange(p_cx * 61 + k, p_cz * 67 + k, seed + 31, 0.0, 6.283185307179586);
        g_cp_s[i] = sc;
        g_cp_sh[i] = sh;
        g_cp_t[i] = clampi(i32(255.0 * j), 0, 255);
        n++;
    }
    g_cp_n[p_slot] = n;
}

fn chunk_mesh_build(p_slot: i32, p_cx: i32, p_cz: i32) {
    let q: i32 = g_CHUNK_Q;
    let m = g_cc_mesh[p_slot];
    mesh_begin(m);
    let ox: f64 = f64(p_cx) * g_CHUNK_M;
    let oz: f64 = f64(p_cz) * g_CHUNK_M;
    for (let j = 0; j < q; j++) {
        for (let i = 0; i < q; i++) {
            let x0: f64 = ox + f64(i) * g_QUAD_M;
            let z0: f64 = oz + f64(j) * g_QUAD_M;
            let x1: f64 = x0 + g_QUAD_M;
            let z1: f64 = z0 + g_QUAD_M;
            let y00: f64 = ground_h(x0, z0);
            let y10: f64 = ground_h(x1, z0);
            let y11: f64 = ground_h(x1, z1);
            let y01: f64 = ground_h(x0, z1);
            let slope: f64 = (absf(y10 - y00) + absf(y01 - y00)) / g_QUAD_M;
            let cell: i32 = ground_cell(x0, z0, slope);
            atlas_cell_uv(g_atlas_world, cell, g_uvq, 0);
            let u0: f64 = g_uvq[0]; let v0: f64 = g_uvq[1];
            let u1: f64 = g_uvq[2]; let v1: f64 = g_uvq[3];
            let nx0: f64 = ground_h(x0 - 1.0, z0) - ground_h(x0 + 1.0, z0);
            let nz0: f64 = ground_h(x0, z0 - 1.0) - ground_h(x0, z0 + 1.0);
            let nx1: f64 = ground_h(x1 - 1.0, z1) - ground_h(x1 + 1.0, z1);
            let nz1: f64 = ground_h(x1, z1 - 1.0) - ground_h(x1, z1 + 1.0);
            let s0: f64 = clamp01(sqrt(nx0 * nx0 + nz0 * nz0) * 0.55);
            let s1: f64 = clamp01(sqrt(nx1 * nx1 + nz1 * nz1) * 0.55);
            let k00: i32 = ground_vcol(x0, z0, s0);
            let k10: i32 = ground_vcol(x1, z0, s0);
            let k11: i32 = ground_vcol(x1, z1, s1);
            let k01: i32 = ground_vcol(x0, z1, s1);
            let a = mesh_vert_n(m, x0 - ox, y00, z0 - oz, u0, v0,
                                pal_r(k00), pal_g(k00), pal_b(k00), nx0, 2.0, nz0);
            let b = mesh_vert_n(m, x1 - ox, y10, z0 - oz, u1, v0,
                                pal_r(k10), pal_g(k10), pal_b(k10), nx1, 2.0, nz0);
            let c = mesh_vert_n(m, x1 - ox, y11, z1 - oz, u1, v1,
                                pal_r(k11), pal_g(k11), pal_b(k11), nx1, 2.0, nz1);
            let d = mesh_vert_n(m, x0 - ox, y01, z1 - oz, u0, v1,
                                pal_r(k01), pal_g(k01), pal_b(k01), nx0, 2.0, nz1);
            mesh_quad(m, a, b, c, d);
        }
    }
    mesh_end(m);
    g_cc_cx[p_slot] = p_cx;
    g_cc_cz[p_slot] = p_cz;
    g_cc_cy[p_slot] = ground_h(ox + g_CHUNK_M * 0.5, oz + g_CHUNK_M * 0.5);
    g_cc_live[p_slot] = 1;
    g_cc_baked[p_slot] = 0;
    chunk_props_gen(p_slot, p_cx, p_cz);
}

// ===========================================================================
//  5.  THE NEAR APRON
// ---------------------------------------------------------------------------
//  A terrain quad that CONTAINS the camera straddles the near plane and is
//  dropped, leaving a hole exactly where a first-person camera looks. The apron
//  is a radial fan centred on the camera; every triangle lies wholly inside one
//  15-degree sector so nothing in the view cone can span w = 0. The uv comes
//  off a WORLD lattice, never off the ring/sector indices — a texture that
//  rotates with the viewer is the most immersion-breaking thing there is.
// ===========================================================================

let g_apron_mesh = null;
let g_apron_x: f64 = 1e30;
let g_apron_z: f64 = 1e30;
let g_apron_baked: i32 = 0;
let g_AP_R: array<f64> = [0.01, 1.0, 2.2, 4.2, 8.0];
let g_AP_NR: i32 = 5;

let g_ap_x: array<f64> = [];
let g_ap_y: array<f64> = [];
let g_ap_z: array<f64> = [];
let g_ap_nx: array<f64> = [];
let g_ap_nz: array<f64> = [];
let g_ap_c: array<i32> = [];
let g_ap_cs: array<f64> = [];
let g_ap_sn: array<f64> = [];

let g_GUV_P: f64 = 1.0;
let g_guv_ox: f64 = 0.0;
let g_guv_oz: f64 = 0.0;

fn ground_uv_org(p_x0: f64, p_x1: f64, p_x2: f64, p_x3: f64,
                 p_z0: f64, p_z1: f64, p_z2: f64, p_z3: f64) {
    let xlo: f64 = p_x0;
    if (p_x1 < xlo) { xlo = p_x1; }
    if (p_x2 < xlo) { xlo = p_x2; }
    if (p_x3 < xlo) { xlo = p_x3; }
    let zlo: f64 = p_z0;
    if (p_z1 < zlo) { zlo = p_z1; }
    if (p_z2 < zlo) { zlo = p_z2; }
    if (p_z3 < zlo) { zlo = p_z3; }
    g_guv_ox = floor(xlo / g_GUV_P) * g_GUV_P;
    g_guv_oz = floor(zlo / g_GUV_P) * g_GUV_P;
}

fn ground_uv_u(p_x: f64, p_u0: f64, p_u1: f64): f64 {
    let f: f64 = clamp01((p_x - g_guv_ox) / g_GUV_P);
    let out: f64 = p_u0 + (p_u1 - p_u0) * f;
    return out;
}

fn ground_uv_v(p_z: f64, p_v0: f64, p_v1: f64): f64 {
    let f: f64 = clamp01((p_z - g_guv_oz) / g_GUV_P);
    let out: f64 = p_v0 + (p_v1 - p_v0) * f;
    return out;
}

fn apron_init() {
    g_apron_mesh = mesh_new(g_APRON_SEGS * (g_AP_NR - 1) * 2 + 8);
    let n: i32 = g_AP_NR * g_APRON_SEGS;
    for (let i = 0; i < n; i++) {
        g_ap_x.push(0.0); g_ap_y.push(0.0); g_ap_z.push(0.0);
        g_ap_nx.push(0.0); g_ap_nz.push(0.0); g_ap_c.push(0);
    }
    let step: f64 = 6.283185307179586 / f64(g_APRON_SEGS);
    for (let i = 0; i < g_APRON_SEGS; i++) {
        g_ap_cs.push(cos(f64(i) * step));
        g_ap_sn.push(sin(f64(i) * step));
    }
}

fn apron_build(p_cx: f64, p_cz: f64) {
    let segs: i32 = g_APRON_SEGS;
    let nr: i32 = g_AP_NR;
    for (let r = 0; r < nr; r++) {
        let rad: f64 = g_AP_R[r];
        for (let i = 0; i < segs; i++) {
            let idx: i32 = r * segs + i;
            let x: f64 = p_cx + g_ap_cs[i] * rad;
            let z: f64 = p_cz + g_ap_sn[i] * rad;
            let nx: f64 = ground_h(x - 1.0, z) - ground_h(x + 1.0, z);
            let nz: f64 = ground_h(x, z - 1.0) - ground_h(x, z + 1.0);
            let slope: f64 = clamp01(sqrt(nx * nx + nz * nz) * 0.55);
            g_ap_x[idx] = x;
            g_ap_z[idx] = z;
            g_ap_y[idx] = ground_h(x, z) + 0.012;
            g_ap_nx[idx] = nx;
            g_ap_nz[idx] = nz;
            g_ap_c[idx] = ground_vcol(x, z, slope);
        }
    }
    let m = g_apron_mesh;
    mesh_begin(m);
    for (let r = 0; r < nr - 1; r++) {
        for (let i = 0; i < segs; i++) {
            let i1: i32 = i + 1;
            if (i1 >= segs) { i1 = 0; }
            let a0: i32 = r * segs + i;
            let a1: i32 = r * segs + i1;
            let b0: i32 = (r + 1) * segs + i;
            let b1: i32 = (r + 1) * segs + i1;
            let cell: i32 = ground_cell(g_ap_x[a0], g_ap_z[a0], 0.0);
            atlas_cell_uv(g_atlas_world, cell, g_uvq, 0);
            let u0: f64 = g_uvq[0]; let v0: f64 = g_uvq[1];
            let u1: f64 = g_uvq[2]; let v1: f64 = g_uvq[3];
            let c0: i32 = g_ap_c[a0]; let c1: i32 = g_ap_c[a1];
            let c2: i32 = g_ap_c[b1]; let c3: i32 = g_ap_c[b0];
            ground_uv_org(g_ap_x[a0], g_ap_x[a1], g_ap_x[b1], g_ap_x[b0],
                          g_ap_z[a0], g_ap_z[a1], g_ap_z[b1], g_ap_z[b0]);
            let a = mesh_vert_n(m, g_ap_x[a0], g_ap_y[a0], g_ap_z[a0],
                                ground_uv_u(g_ap_x[a0], u0, u1),
                                ground_uv_v(g_ap_z[a0], v0, v1),
                                pal_r(c0), pal_g(c0), pal_b(c0),
                                g_ap_nx[a0], 2.0, g_ap_nz[a0]);
            let b = mesh_vert_n(m, g_ap_x[a1], g_ap_y[a1], g_ap_z[a1],
                                ground_uv_u(g_ap_x[a1], u0, u1),
                                ground_uv_v(g_ap_z[a1], v0, v1),
                                pal_r(c1), pal_g(c1), pal_b(c1),
                                g_ap_nx[a1], 2.0, g_ap_nz[a1]);
            let c = mesh_vert_n(m, g_ap_x[b1], g_ap_y[b1], g_ap_z[b1],
                                ground_uv_u(g_ap_x[b1], u0, u1),
                                ground_uv_v(g_ap_z[b1], v0, v1),
                                pal_r(c2), pal_g(c2), pal_b(c2),
                                g_ap_nx[b1], 2.0, g_ap_nz[b1]);
            let d = mesh_vert_n(m, g_ap_x[b0], g_ap_y[b0], g_ap_z[b0],
                                ground_uv_u(g_ap_x[b0], u0, u1),
                                ground_uv_v(g_ap_z[b0], v0, v1),
                                pal_r(c3), pal_g(c3), pal_b(c3),
                                g_ap_nx[b0], 2.0, g_ap_nz[b0]);
            mesh_quad(m, a, d, c, b);
        }
    }
    mesh_end(m);
    g_apron_x = p_cx;
    g_apron_z = p_cz;
}

// ===========================================================================
//  6.  THE PER-FRAME WORLD REBUILD
// ---------------------------------------------------------------------------
//  The registry is rebuilt from scratch every frame: ~50 chunk rows, ~150 prop
//  rows and the entity stream. Cheap bookkeeping only — the expensive things
//  (chunk meshes, prop caches, the light bake) are cached and amortised.
// ===========================================================================

let g_prime: i32 = 1;
let g_ring_built: i32 = 0;
let g_prop_n: i32 = 0;
let g_ent_n: i32 = 0;

fn prop_push(p_kind: i32, p_x: f64, p_z: f64, p_y: f64,
             p_yaw: f64, p_scale: f64, p_shadow: f64, p_tint: i32) {
    let k: i32 = p_kind;
    let id0: i32 = MESH_ROCK;
    if (k == g_K_TREE) { id0 = MESH_TREE0; }
    else if (k == g_K_CRATE) { id0 = MESH_CRATE; }
    else if (k == g_K_BARREL) { id0 = MESH_BARREL; }
    else if (k == g_K_LANTERN) { id0 = MESH_LANTERN; }
    else if (k == g_K_POST) { id0 = MESH_LANTERN; }
    else if (k == g_K_BUSH) { id0 = MESH_BUSH; }
    let id1: i32 = id0;
    let id2: i32 = id0;
    let d1: f64 = g_LOD_NEVER;
    let d2: f64 = g_LOD_NEVER;
    if (k == g_K_TREE) {
        id1 = MESH_TREE1; id2 = MESH_TREE2;
        d1 = 18.0; d2 = g_LOD_FOG_CARD;
    }
    world_prop_add(meshgen_mesh(id0), meshgen_mesh(id1), meshgen_mesh(id2),
                   d1, d2, meshgen_radius(id0),
                   p_x, p_y, p_z, p_yaw, p_scale,
                   p_tint, p_tint, p_tint, p_shadow, k);
}

fn chunk_props_push(p_slot: i32): i32 {
    let n: i32 = g_cp_n[p_slot];
    let base: i32 = p_slot * g_PROP_TRIES;
    for (let k = 0; k < n; k++) {
        let i: i32 = base + k;
        prop_push(g_cp_kind[i], g_cp_x[i], g_cp_z[i], g_cp_y[i],
                  g_cp_yaw[i], g_cp_s[i], g_cp_sh[i], g_cp_t[i]);
    }
    let out: i32 = n;
    return out;
}

fn fx_push(p_x: f64, p_y: f64, p_z: f64, p_s: f64, p_cell: i32,
           p_kind: i32, p_r: i32, p_g: i32, p_b: i32, p_a: i32) {
    world_fx_add(p_x, p_y, p_z, p_s, p_cell, p_kind, p_r, p_g, p_b, p_a);
}

// ---------------------------------------------------------------------------
// THE ENTITY PASS — the only place a body reaches the picture.
// ---------------------------------------------------------------------------
// Everything here comes out of `client_ent_*`, which is the DECODED SNAPSHOT.
// There is no `world` in scope in this function and there never will be.
// `model` carries the enemy class for KIND_AI (ai.hml sets `model = class`),
// so the mesh is `MESH_WISP0 + class * 3` and the three LODs are contiguous —
// which is exactly how meshgen lays them out.
fn entities_push(): i32 {
    let n: i32 = client_ent_count(g_cl);
    let drawn: i32 = 0;
    let far: f64 = g_fog_far;
    for (let i = 0; i < n; i++) {
        let fl: i32 = client_ent_flags(g_cl, i);
        if ((fl & 1) == 0) { continue; }            // RSF_VISIBLE
        let id: i32 = client_ent_id(g_cl, i);
        let x: f64 = client_ent_x(g_cl, i);
        let y: f64 = client_ent_y(g_cl, i);
        let z: f64 = client_ent_z(g_cl, i);
        let dx: f64 = x - g_camx;
        let dz: f64 = z - g_camz;
        if (dx * dx + dz * dz > far * far) { continue; }
        let md: i32 = client_ent_model(g_cl, i);
        let yaw: f64 = client_ent_yaw(g_cl, i);

        if (md == SV_MODEL_LANTERN) {
            // The post. Unlit it is a silhouette; lit it is the brightest thing
            // in the world and it gets a glow card and a light.
            world_prop_add(meshgen_mesh(MESH_LANTERN), meshgen_mesh(MESH_LANTERN),
                           meshgen_mesh(MESH_LANTERN),
                           g_LOD_NEVER, g_LOD_NEVER, meshgen_radius(MESH_LANTERN),
                           x, y, z, 0.0, 1.25, 255, 255, 255, 1.4, g_K_POST);
            drawn++;
            continue;
        }
        if (md == SV_MODEL_PICKUP) {
            fx_push(x, y + 0.4, z, 0.5, FX_XP_MOTE, g_FXK_SPRITE,
                    pal_r(g_EMBER), pal_g(g_EMBER), pal_b(g_EMBER), 220);
            drawn++;
            continue;
        }
        // The player's own body is never drawn: this is first person.
        if (id == SV_PSLOT) { continue; }

        // An enemy. Three LODs, contiguous from MESH_WISP0.
        let cls: i32 = md;
        if (cls < 0) { cls = 0; }
        if (cls > 5) { cls = 5; }
        let m0: i32 = meshgen_enemy_mesh(cls, 0);
        let m1: i32 = meshgen_enemy_mesh(cls, 1);
        let m2: i32 = meshgen_enemy_mesh(cls, 2);
        let tint: i32 = 255;
        if ((fl & 2) != 0) { tint = 255; }          // RSF_HIT_FLASH
        world_prop_add(meshgen_mesh(m0), meshgen_mesh(m1),
                       meshgen_mesh(m2),
                       16.0, g_LOD_FOG_CARD, meshgen_radius(m0),
                       x, y, z, yaw, 1.0,
                       tint, tint, tint, 1.1, g_K_ENEMY);
        // GDD §7: a violet rim on hostiles is `entity_render.hml`'s job; until
        // it exists the readability at 12 px comes from a small NS_HALO glow,
        // which is the same signal one layer cheaper.
        if (dx * dx + dz * dz < 2500.0) {
            fx_push(x, y + 0.9, z, 0.55, FX_GLOW_S, g_FXK_SPRITE,
                    pal_r(g_NS_HALO), pal_g(g_NS_HALO), pal_b(g_NS_HALO), 90);
        }
        drawn++;
    }
    let out: i32 = drawn;
    return out;
}

fn client_fx_push(): i32 {
    let n: i32 = client_fx_count(g_cl);
    let far: f64 = g_fog_far;
    let used: i32 = 0;
    for (let i = 0; i < n; i++) {
        let x: f64 = client_fx_x(g_cl, i);
        let y: f64 = client_fx_y(g_cl, i);
        let z: f64 = client_fx_z(g_cl, i);
        let dx: f64 = x - g_camx;
        let dz: f64 = z - g_camz;
        if (dx * dx + dz * dz > far * far) { continue; }
        let kind: i32 = g_FXK_SPRITE;
        if (client_fx_kind(g_cl, i) == CFX_TRACER) { kind = g_FXK_TRACER; }
        if (client_fx_kind(g_cl, i) == CFX_RAIN) { kind = g_FXK_RAIN; }
        fx_push(x, y, z, client_fx_size(g_cl, i), client_fx_cell(g_cl, i), kind,
                client_fx_r(g_cl, i), client_fx_g(g_cl, i), client_fx_b(g_cl, i),
                client_fx_alpha(g_cl, i));
        used++;
    }
    let out: i32 = used;
    return out;
}

let g_pin_cx: i32 = 2147483647;
let g_pin_cz: i32 = 2147483647;

// ===========================================================================
//  W6.  THE TOWN, AND THE PEOPLE IN IT, REACH THE PICTURE
// ---------------------------------------------------------------------------
//  `settle_render.hml` and `hubgen.hml` were built, probed and photographed by
//  their own harness (`tools/settle_shot.hml`) and never called by the game.
//  These two functions are the whole of the difference. The call sequence is
//  the harness's, verbatim, because the harness drives the REAL frame graph
//  and a second sequence would be a second thing to get wrong.
// ===========================================================================

let g_SETTLE_DRAW_M: f64 = 220.0;   // beyond this the town is over the horizon

fn settlement_push() {
    g_settle_tris = 0;
    let st: object = server_settle(g_sv);
    if (st == null) { return; }
    let sx: f64 = w6_settle_cx(st);
    let sz: f64 = w6_settle_cz(st);
    let dx: f64 = sx - g_camx;
    let dz: f64 = sz - g_camz;
    let d: f64 = sqrt(dx * dx + dz * dz);
    // The cheap reject FIRST: on a 1200 m cell the player is outside this
    // radius for most of a session and the whole town costs one square root.
    if (d > g_SETTLE_DRAW_M) { hubgen_dome_clear(); return; }

    settle_render_ground_build(st);
    settle_render_ground_push(st);

    // How lit the world is, for the window glow cards. `tod` owns the night
    // and this is its answer, not a second one.
    let night: f64 = 0.0;
    let dt2: f64 = g_day_t;
    if (dt2 < 0.22 || dt2 > 0.78) { night = 1.0; }
    else if (dt2 < 0.30 || dt2 > 0.70) { night = 0.6; }

    settle_render_emit(st, g_camx, g_camz, g_fog_far, night);
    g_settle_tris = settle_render_stats(SR_STAT_SUBMITTED)
                  + settle_render_stats(SR_STAT_GROUND);

    // THE WARM DOME. SETTLEMENT.md's "a town you can see from the dark": the
    // sky lifts over the settlement in proportion to its GRID LUX. It is
    // painted into the sky texture and costs ZERO triangles, which is the only
    // reason a 320x240 renderer with no z-buffer can have it at all.
    if (settle_render_dome_lux(st) > 0) {
        hubgen_dome_set(settle_render_dome_dx(st, g_camx),
                        settle_render_dome_dz(st, g_camz),
                        settle_render_dome_lux(st));
    } else { hubgen_dome_clear(); }
}

// The villagers. DIRECTION.md §6's budget problem, and its answer: a full mesh
// only at conversational distance, a simplified silhouette mid-range, a
// billboard beyond. `meshgen.hml` lays the three LODs out contiguously and
// publishes the two switch distances, so this function picks nothing -- it
// hands `world_prop_add` the three meshes and the two ranges and lets the
// frame graph choose, exactly as the enemy pass does.
fn villagers_push(): i32 {
    let sto: object = server_npcs(g_sv);
    let st: object = server_settle(g_sv);
    if (sto == null || st == null) { let z: i32 = 0; return z; }
    let n: i32 = npc_count(sto);
    if (n < 1) { let z2: i32 = 0; return z2; }
    let far: f64 = g_fog_far;
    let tick: i32 = g_tick;
    let drawn: i32 = 0;
    for (let i = 0; i < n; i++) {
        let x: f64 = npc_x(sto, st, i, tick);
        let z: f64 = npc_z(sto, st, i, tick);
        let dx: f64 = x - g_camx;
        let dz: f64 = z - g_camz;
        if (dx * dx + dz * dz > far * far) { continue; }
        let y: f64 = npc_y(sto, st, i, tick);
        let yaw: f64 = npc_yaw(sto, st, i, tick);
        let cls: i32 = npc_slot_class(sto, i);
        let m0: i32 = meshgen_villager_mesh(cls, 0);
        let m1: i32 = meshgen_villager_mesh(cls, 1);
        let m2: i32 = meshgen_villager_mesh(cls, 2);
        world_prop_add(meshgen_mesh(m0), meshgen_mesh(m1), meshgen_mesh(m2),
                       meshgen_villager_lod1_m(cls), meshgen_villager_lod2_m(cls),
                       meshgen_radius(m0),
                       x, y, z, yaw, 1.0, 255, 255, 255, 1.1, g_K_VILLAGER);
        drawn++;
    }
    let out: i32 = drawn;
    return out;
}

fn world_rebuild(p_dt: f64, p_t: f64) {
    world_clear();
    // The sim pins a 5x5 ring (`g_RING_RADIUS`); the PICTURE reaches the fog
    // wall plus a chunk, so it pins 7x7. Pinning is what stops the LRU from
    // evicting a chunk the mesh builder is about to sample four times.
    let pcx: i32 = i32(floor(g_camx / g_CHUNK_M));
    let pcz: i32 = i32(floor(g_camz / g_CHUNK_M));
    if (pcx != g_pin_cx || pcz != g_pin_cz) {
        chunk_pin_ring(g_cs, pcx, pcz, 3);
        g_pin_cx = pcx;
        g_pin_cz = pcz;
    }
    g_ring_built = 0;
    g_prop_n = 0;
    g_ent_n = 0;

    let far: f64 = g_fog_far;
    let rad: i32 = i32(far / g_CHUNK_M) + 1;
    if (rad > 3) { rad = 3; }
    let ccx: i32 = i32(floor(g_camx / g_CHUNK_M));
    let ccz: i32 = i32(floor(g_camz / g_CHUNK_M));

    for (let d = 0; d <= rad; d++) {
        for (let j = 0 - d; j <= d; j++) {
            for (let i = 0 - d; i <= d; i++) {
                let ai: i32 = i; if (ai < 0) { ai = 0 - ai; }
                let aj: i32 = j; if (aj < 0) { aj = 0 - aj; }
                if (ai != d && aj != d) { continue; }
                let cx: i32 = ccx + i;
                let cz: i32 = ccz + j;
                let ox: f64 = f64(cx) * g_CHUNK_M;
                let oz: f64 = f64(cz) * g_CHUNK_M;
                let mx: f64 = ox + g_CHUNK_M * 0.5;
                let mz: f64 = oz + g_CHUNK_M * 0.5;
                let ddx: f64 = mx - g_camx; let ddz: f64 = mz - g_camz;
                let dist: f64 = sqrt(ddx * ddx + ddz * ddz) - g_CHUNK_M * 0.78;
                if (dist > far) { continue; }
                let slot: i32 = chunk_find(cx, cz);
                if (slot < 0) {
                    if (g_prime == 0 && g_ring_built >= g_CHUNK_BUILD_PER_FRAME) { continue; }
                    slot = chunk_evict();
                    chunk_mesh_build(slot, cx, cz);
                    g_ring_built++;
                }
                g_cc_stamp[slot] = g_frames;
                world_chunk_add(g_cc_mesh[slot], ox, oz,
                                mx, g_cc_cy[slot], mz,
                                g_CHUNK_M * 0.78 + 9.0);
                if (dist < far - 8.0) { g_prop_n = g_prop_n + chunk_props_push(slot); }
            }
        }
    }

    let ax: f64 = floor(g_camx / g_APRON_SNAP + 0.5) * g_APRON_SNAP;
    let az: f64 = floor(g_camz / g_APRON_SNAP + 0.5) * g_APRON_SNAP;
    if (ax != g_apron_x || az != g_apron_z) { apron_build(ax, az); g_apron_baked = 0; }
    world_chunk_add(g_apron_mesh, 0.0, 0.0,
                    g_apron_x, ground_h(g_apron_x, g_apron_z), g_apron_z, 9.5);

    // ---- W6: THE TOWN. ----------------------------------------------------
    // Emitted BEFORE the entity pass and the FX pass so that the buildings and
    // their ground are in the world batch alongside the terrain they stand on
    // -- the painter sort is on view-space w and does not care about order,
    // but the triangle cap does, and a town that yields to enemies is the
    // wrong priority the first time a wave reaches the green.
    // W6: the spell school's retained effects. Stepped and emitted between
    // `world_clear` (which is `fx_clear`) and `frame_render` (which is
    // `fx_emit`), which is the only window in the frame where the registry
    // exists and is empty.
    // THE CAST EDGE. `sp_casts` is the authority's lifetime counter, so a
    // change in it is a cast that really happened -- which is a stronger
    // signal than "the button was down", and it cannot double-fire when one
    // frame runs two ticks.
    let nc: i32 = client_spell_casts(g_cl);
    if (nc != g_spellfx_casts) {
        g_spellfx_casts = nc;
        spellfx_cast(client_spell_id(g_cl));
    }
    fx_spell_update(p_dt);
    if (client_cloaked(g_cl) == 1) {
        fx_spell_cloak_now(g_camx, g_camy - 0.9, g_camz, 1.0);
    }
    g_spellfx_sprites = fx_spell_emit();
    if (g_spellfx_sprites > g_spellfx_peak) { g_spellfx_peak = g_spellfx_sprites; }

    settlement_push();
    g_ent_n = entities_push();
    g_villagers_drawn = villagers_push();
    if (g_settle_tris > g_settle_tris_peak) { g_settle_tris_peak = g_settle_tris; }
    if (g_villagers_drawn > g_villagers_peak) { g_villagers_peak = g_villagers_drawn; }
    client_fx_push();

    // The lantern's own glow. Unlit it is a dim ember on the post -- enough to
    // be "the brightest object on screen" against a dusk hillside without
    // lying about it being lit; lit it is the big one.
    let lit: i32 = client_lantern_lit(g_cl);
    let lx: f64 = server_lantern_x(g_sv);
    let lz: f64 = server_lantern_z(g_sv);
    let ly: f64 = ground_h(lx, lz);
    let ddx: f64 = lx - g_camx; let ddz: f64 = lz - g_camz;
    if (ddx * ddx + ddz * ddz < far * far) {
        if (lit == 1) {
            fx_push(lx, ly + 1.2, lz, 3.4, FX_GLOW_L, g_FXK_SPRITE,
                    pal_r(g_WINDOW_LIGHT), pal_g(g_WINDOW_LIGHT),
                    pal_b(g_WINDOW_LIGHT), 210);
        } else {
            fx_push(lx, ly + 1.2, lz, 1.1, FX_GLOW_S, g_FXK_SPRITE,
                    pal_r(g_EMBER), pal_g(g_EMBER), pal_b(g_EMBER), 150);
        }
    }

    // Ambient embers, animated on FRAME time (they are cosmetic and they are
    // allowed to be), in an 18 m box that follows the camera.
    let t: f64 = p_t;
    let nemb: i32 = 22;
    for (let q = 0; q < nemb; q++) {
        let fx: f64 = g_camx - 9.0 + hrange(q, 4, 83, 0.0, 18.0);
        let fz: f64 = g_camz - 9.0 + hrange(q, 5, 89, 0.0, 18.0);
        let ph: f64 = hrange(q, 6, 97, 0.0, 6.28);
        let fy: f64 = ground_h(fx, fz) + 0.6 + 1.5 * (0.5 + 0.5 * sin(t * 0.6 + ph));
        fx_push(fx + sin(t * 0.4 + ph) * 0.6, fy, fz, 0.17, FX_EMBER,
                g_FXK_SPRITE, pal_r(g_EMBER), pal_g(g_EMBER), pal_b(g_EMBER), 150);
    }

    // One dynamic light, spent on the lit lantern. BUDGET_ACTUAL's cap is 2.
    let env: array<f64> = frame_env();
    env_clear_lights(env);
    if (lit == 1 && ddx * ddx + ddz * ddz < 3600.0) {
        env_add_light(env, lx, ly + 1.2, lz,
                      f64(pal_r(g_WINDOW_LIGHT)) / 255.0 * 2.4,
                      f64(pal_g(g_WINDOW_LIGHT)) / 255.0 * 2.4,
                      f64(pal_b(g_WINDOW_LIGHT)) / 255.0 * 2.4, 11.0);
    }
    stat_set(STAT_LIGHTS, env_light_count(env));
    stat_set(STAT_CHUNKS_MESHED, g_ring_built);
    stat_set(STAT_ENTS_DRAWN, g_ent_n);
    g_prime = 0;
}

// ===========================================================================
//  7.  THE ROLLING LIGHT BAKE
// ---------------------------------------------------------------------------
//  Every chunk vertex carries a baked sun term and the sun moves every frame.
//  Anything freshly meshed is baked NOW (an unbaked mesh is a black mesh);
//  everything else rolls two chunks a frame, which is a full pass every ~36
//  frames and 0.2 game-minutes of sun lag.
// ===========================================================================

let g_bake_cursor: i32 = 0;
let g_hub_tris: i32 = 0;
let g_settle_tris: i32 = 0;
let g_settle_tris_peak: i32 = 0;
let g_villagers_drawn: i32 = 0;
let g_villagers_peak: i32 = 0;
let g_spellfx_sprites: i32 = 0;
let g_spellfx_casts: i32 = 0;
let g_spellfx_peak: i32 = 0;
let g_demo_cast_t: f64 = -100.0;
// The demo player. See `src/game/demobot.hml` for why the policy is not in
// this file any more: it used to be, it was WORSE than the bot every
// acceptance number was measured with, and having two of them is what let
// "winnable on 10 of 12 seeds" and "unwinnable on 0 of 8" both be true at once.
let g_demobot = null;
let g_bake_sun_x: f64 = 1e30;
let g_last_sun_x: f64 = 1e30;

fn bake_chunk(p_mesh, p_lx: f64, p_ly: f64, p_lz: f64) {
    let env: array<f64> = frame_env();
    mesh_bake_light(p_mesh, p_lx, p_ly, p_lz,
                    env_field(env, ENV_SUN_R), env_field(env, ENV_SUN_G),
                    env_field(env, ENV_SUN_B),
                    env_field(env, ENV_AMB_R), env_field(env, ENV_AMB_G),
                    env_field(env, ENV_AMB_B),
                    env_field(env, ENV_BOUNCE_R), env_field(env, ENV_BOUNCE_G),
                    env_field(env, ENV_BOUNCE_B));
}

fn bake_step() {
    let env: array<f64> = frame_env();
    let lx: f64 = env_field(env, ENV_SUN_X);
    let ly: f64 = env_field(env, ENV_SUN_Y);
    let lz: f64 = env_field(env, ENV_SUN_Z);

    for (let i = 0; i < g_CHUNK_SLOTS; i++) {
        if (g_cc_live[i] != 0 && g_cc_baked[i] == 0) {
            bake_chunk(g_cc_mesh[i], lx, ly, lz);
            g_cc_baked[i] = 1;
        }
    }
    if (g_apron_baked == 0) {
        bake_chunk(g_apron_mesh, lx, ly, lz);
        g_apron_baked = 1;
    }

    let moved: f64 = absf(lx - g_last_sun_x);
    g_last_sun_x = lx;
    if (moved > 0.0) {
        for (let k = 0; k < 2; k++) {
            let i: i32 = g_bake_cursor;
            g_bake_cursor = g_bake_cursor + 1;
            if (g_bake_cursor >= g_CHUNK_SLOTS) { g_bake_cursor = 0; }
            if (g_cc_live[i] != 0) { bake_chunk(g_cc_mesh[i], lx, ly, lz); }
        }
        g_apron_baked = 0;
    }

    let dsun: f64 = absf(lx - g_bake_sun_x);
    if (dsun > 0.004 || g_bake_sun_x > 1e29) {
        meshgen_set_sun_azimuth(lx, lz);
        meshgen_bake_all(lx, ly, lz,
                         env_field(env, ENV_SUN_R), env_field(env, ENV_SUN_G),
                         env_field(env, ENV_SUN_B),
                         env_field(env, ENV_AMB_R), env_field(env, ENV_AMB_G),
                         env_field(env, ENV_AMB_B),
                         env_field(env, ENV_BOUNCE_R), env_field(env, ENV_BOUNCE_G),
                         env_field(env, ENV_BOUNCE_B));
        // W6: the town bakes on exactly the same trigger as everything else,
        // so the buildings and the props can never be lit by different suns.
        hubgen_bake_all(lx, ly, lz,
                        env_field(env, ENV_SUN_R), env_field(env, ENV_SUN_G),
                        env_field(env, ENV_SUN_B),
                        env_field(env, ENV_AMB_R), env_field(env, ENV_AMB_G),
                        env_field(env, ENV_AMB_B),
                        env_field(env, ENV_BOUNCE_R), env_field(env, ENV_BOUNCE_G),
                        env_field(env, ENV_BOUNCE_B));
        settle_render_ground_bake(lx, ly, lz,
                        env_field(env, ENV_SUN_R), env_field(env, ENV_SUN_G),
                        env_field(env, ENV_SUN_B),
                        env_field(env, ENV_AMB_R), env_field(env, ENV_AMB_G),
                        env_field(env, ENV_AMB_B),
                        env_field(env, ENV_BOUNCE_R), env_field(env, ENV_BOUNCE_G),
                        env_field(env, ENV_BOUNCE_B));
        g_bake_sun_x = lx;
    }
}

// ===========================================================================
//  8.  AUDIO — semantic client ids -> audiobank sfx -> the mixer
// ---------------------------------------------------------------------------
//  `client.hml` emits CSND_*, which name MEANINGS. This is the only table that
//  knows a meaning is a waveform, and it is the reason `client.hml` links no
//  SDL. A missing device is not a failure: `g_audio_on` stays 0 and the queue
//  is drained into nothing.
// ===========================================================================

fn snd_map_init() {
    for (let i = 0; i < CSND_COUNT; i++) { g_snd_map.push(SFX_KESTREL); }
    g_snd_map[CSND_SHOT] = SFX_KESTREL;
    g_snd_map[CSND_DRYFIRE] = SFX_DRYFIRE;
    g_snd_map[CSND_RELOAD_DROP] = SFX_RELOAD_DROP;
    g_snd_map[CSND_RELOAD_INS] = SFX_RELOAD_INS;
    g_snd_map[CSND_RELOAD_SEAT] = SFX_RELOAD_SEAT;
    g_snd_map[CSND_MAG_CLACK] = SFX_MAG_CLACK;
    // The GDD §7.2 pitch chain: five consecutive steps, +2 semitones each.
    for (let k = 0; k < CSND_HIT_STEPS; k++) {
        g_snd_map[CSND_HIT0 + k] = SFX_HIT + k;
    }
    g_snd_map[CSND_KILL] = SFX_KILL;
    g_snd_map[CSND_IMPACT] = SFX_IMP_SOIL;
    g_snd_map[CSND_IMPACT_ARMOR] = SFX_IMP_METAL;
    g_snd_map[CSND_BELL] = SFX_BELL;
    g_snd_map[CSND_HORN] = SFX_HORN;
    g_snd_map[CSND_LEVELUP] = SFX_LEVELUP;
    g_snd_map[CSND_WAVECLEAR] = SFX_WAVECLEAR;
    g_snd_map[CSND_XP] = SFX_XP_BLIP;
    g_snd_map[CSND_HURT] = SFX_HURT;
    g_snd_map[CSND_STEP] = SFX_STEP_GRASS;
    g_snd_map[CSND_EMBER] = SFX_EMBER;
    g_snd_map[CSND_WISP] = SFX_WISP_CHIME;
    g_snd_map[CSND_HUSK] = SFX_HUSK_GROWL;
}

fn audio_boot() {
    if (audio_init(22050, AUDIO_FMT_S16, 2, AUDIO_DEFAULT_CHUNK,
                   AUDIO_DEFAULT_VOICES) != 1) {
        eprint(`nightshade: no audio device (${audio_error()}); running silent`);
        g_audio_on = 0;
        return;
    }
    bank_build_at(audio_out_freq());
    audio_set_volume(0.85);
    g_audio_on = 1;
}

// The mix rule of GDD §7: the gun is the loudest thing in the game, always.
fn audio_drain() {
    let n: i32 = client_sound_count(g_cl);
    if (g_audio_on == 1) {
        for (let i = 0; i < n; i++) {
            let cid: i32 = client_sound_id(g_cl, i);
            if (cid < 0 || cid >= CSND_COUNT) { continue; }
            let sid: i32 = bank_sound(g_snd_map[cid]);
            if (sid < 0) { continue; }
            audio_play_panned(sid, client_sound_gain(g_cl, i),
                              client_sound_pan(g_cl, i));
        }
    }
    client_sounds_reset(g_cl);
}

// ===========================================================================
//  9.  THE HUD  (ARCHITECTURE §4 stage 24 — the CALLER's)
// ---------------------------------------------------------------------------
//  ART_BIBLE §9's layout at native pixel rects, hard-capped at
//  `g_HUD_TRI_CAP` = 250. FONT_MICRO is 2 triangles a glyph and the mandatory
//  1-px shadow doubles it to FOUR, so text budgets are explicit per line and
//  `font_text_shadowed` TRUNCATES at its budget rather than overspending —
//  which is what makes the cap structural instead of aspirational.
// ===========================================================================

let g_TB_AMMO: i32 = 40;
let g_TB_HP: i32 = 28;
let g_TB_BANNER: i32 = 88;
// 72 -> 80.  MEASURED, not estimated, through the real FONT_MICRO and the real
// `font_text_shadowed` path:
//
//   "TINKER SMG - AT THE BENCH"  25 chars, 20 DRAWABLE glyphs (spaces cost 0),
//                               4 triangles each once the mandatory 1-px shadow
//                               is counted  ->  80 triangles, 103 px wide.
//   budget 72  ->  emitted 72, DROPPED 2 GLYPHS, truncated flag set
//                  the player read "TINKER SMG - AT THE BEN"
//   budget 80  ->  emitted 80, dropped 0, truncated flag clear
//
// This is the §8 beat at 0:30 — the unlock the whole first minute pays out to,
// and the one line of text in the game that names the reward. It read as a typo.
// `font_text_shadowed` splits its budget in half for the shadow pass first
// (`half = divi(budget,4)*2`), so a budget must be a multiple of 4 to be spent
// exactly; 80 is, and 80 is the string's whole cost, so the truncation path is
// no longer reachable for this string. It is a BUDGET, not a length limit — the
// cap below still truncates rather than overspends if a frame is genuinely full.
let g_TB_CARD: i32 = 80;
let g_TB_PROMPT: i32 = 108;
let g_TB_DBG: i32 = 120;

// ===========================================================================
//  THE TWO TRANSIENT BANDS, RE-LAID FOR 320x180
// ---------------------------------------------------------------------------
// Everything on this HUD is anchored to one of four things: the frame's TOP
// edge (compass, objective diamond, wave readout, debug plate — all unchanged,
// a shorter frame does not move its own top), the frame's BOTTOM edge (the
// health/oil/ammo/XP cluster — `hudgen_bot`, at the draw site), the RETICLE
// (crosshair, hitmarker, reload and channel bars — `cx`/`cy`, free), or one of
// the two TRANSIENT BANDS below, which is everything celebratory or narrative.
//
// The bands are what actually got squeezed. At 4:3 there were 120 px above the
// reticle and 120 below it; at 16:9 there are 90 and 90, and the bottom cluster
// eats 40 of the lower 90. So the bands are re-laid rather than scaled, and the
// constraint each one is solved against is written down here:
//
//   UPPER BAND — between the objective-marker row (ends y 21) and the topmost
//   pixel the crosshair can reach. The widest legal crosshair is spread 9,
//   whose top arm ink begins at cy - 12 = 78. Usable: 22..78, 56 px.
//     24  banner      FONT_BIG, 12 px      -> 24..36
//     40  toast       FONT_MICRO, 7 px     -> 40..47
//     50  unlock card plate, 20 px         -> 50..70, and x >= 192 always
//     62  LEVEL n     FONT_BIG, 12 px      -> 62..74, x 132..188, clears the card
//   The card and the level line share rows 62..70 exactly as they did at 4:3,
//   and exactly as at 4:3 they cannot collide because the card slides in from
//   the right edge (`x0 = RES_W - 128*slide`, so x0 >= 192) and the level line
//   is centred and at most 56 px wide.
//
//   LOWER BAND — between the reticle and the bottom cluster's topmost element
//   (the spell name at y 140). The reload and channel bars own cy+12..cy+23,
//   i.e. 102..113. Usable: 114..140, 26 px, and it has to hold a 22 px prompt
//   plate, its 3 px charge bar and an 11 px speech plate — 36 px of content in
//   26 px of room. It does not fit, so the speech line MOVED OUT of the band:
//   it now sits at 144, alongside the bottom cluster rather than above it, and
//   is NARROWED from 184 px to 160 px (cx-80, so x 80..240) so it clears the
//   oil/health bars on the left (x 9..71) and the ammo plate on the right
//   (x 238..314). MEASURED against those three rects, not estimated.
let g_Y_BANNER: f64 = 24.0;
let g_Y_TOAST: f64 = 40.0;
let g_Y_CARD: f64 = 50.0;
let g_Y_LEVEL: f64 = 62.0;
let g_Y_PROMPT: f64 = 114.0;
let g_Y_TALKLINE: f64 = 144.0;
let g_hud_tris: i32 = 0;
let g_hud_over: i32 = 0;
// Frames in which the unlock card had to drop glyphs. MUST STAY 0 — see the
// draw site and the g_TB_CARD comment above.
let g_hud_card_trunc: i32 = 0;
// W6: the two modal panels, measured separately. Both MUST stay under
// g_HUD_TRI_CAP; see the budget table above `hud_panel`.
let g_panel_char_peak: i32 = 0;
let g_panel_trade_peak: i32 = 0;
let g_panel_frames: i32 = 0;
let g_panel_trunc: i32 = 0;      // MUST STAY 0 — see `hud_panel_text`

fn hud_rect(p_x: f64, p_y: f64, p_w: f64, p_h: f64, p_c: i32, p_a: i32): i32 {
    let u: f64 = (g_uvw[0] + g_uvw[2]) * 0.5;
    let v: f64 = (g_uvw[1] + g_uvw[3]) * 0.5;
    let out: i32 = quad_screen_uv(g_bhud, g_tex_hud, p_x, p_y, p_w, p_h,
                                  u, v, u, v,
                                  pal_r(p_c), pal_g(p_c), pal_b(p_c), p_a, 0.5);
    return out;
}

fn hud_sprite(p_id: i32, p_x: f64, p_y: f64, p_c: i32, p_a: i32): i32 {
    hudgen_uv(p_id, g_uvq, 0);
    hudgen_rect(p_id, g_rect, 0);
    let out: i32 = quad_screen_uv(g_bhud, g_tex_hud, p_x, p_y,
                                  f64(g_rect[2]), f64(g_rect[3]),
                                  g_uvq[0], g_uvq[1], g_uvq[2], g_uvq[3],
                                  pal_r(p_c), pal_g(p_c), pal_b(p_c), p_a, 0.5);
    return out;
}

fn hud_text(p_x: f64, p_y: f64, p_s: string, p_c: i32, p_budget: i32): i32 {
    let out: i32 = font_text_shadowed(hud_font_micro(), g_bhud, g_tex_hud,
                                      p_x, p_y, p_s,
                                      pal_r(p_c), pal_g(p_c), pal_b(p_c), 255,
                                      pal_r(g_UI_BLACK), pal_g(g_UI_BLACK),
                                      pal_b(g_UI_BLACK), 255, 1.0, 1.0, p_budget);
    return out;
}

fn hud_text_big(p_x: f64, p_y: f64, p_s: string, p_c: i32, p_budget: i32): i32 {
    let out: i32 = font_text_shadowed(hud_font_big(), g_bhud, g_tex_hud,
                                      p_x, p_y, p_s,
                                      pal_r(p_c), pal_g(p_c), pal_b(p_c), 255,
                                      pal_r(g_UI_BLACK), pal_g(g_UI_BLACK),
                                      pal_b(g_UI_BLACK), 255, 1.0, 1.0, p_budget);
    return out;
}

fn hud_centre(p_y: f64, p_s: string, p_c: i32, p_budget: i32): i32 {
    let w: f64 = f64(p_s.length) * 4.0;
    let out: i32 = hud_text(f64(g_RES_W) * 0.5 - w * 0.5, p_y, p_s, p_c, p_budget);
    return out;
}

fn hud_centre_big(p_y: f64, p_s: string, p_c: i32, p_budget: i32): i32 {
    let w: f64 = f64(p_s.length) * 8.0;
    let out: i32 = hud_text_big(f64(g_RES_W) * 0.5 - w * 0.5, p_y, p_s, p_c, p_budget);
    return out;
}

// ===========================================================================
//  9b.  THE TWO MODAL PANELS  (W6)
// ---------------------------------------------------------------------------
//  The character sheet and the trade panel. Both are MODAL and both replace
//  the combat HUD rather than sit on it -- see the gate in `hud_build`.
//
//  BUDGET, MEASURED, not estimated. FONT_MICRO is 2 triangles a glyph and the
//  mandatory 1-px shadow doubles it to FOUR (ART_BIBLE §9), so:
//
//    character sheet  plate 2 + title "CHARACTER" 36 + "POINTS n" 32
//                     + 5 rows of "HND 12" (6 glyphs, 24) = 120
//                     + cursor 2 + message plate 2 + message 40   = 234
//    trade panel      plate 2 + name "CONNIE" 24 + place 44
//                     + 3 windowed rows at 52 = 156 + cursor 2    = 228
//
//  Both fit under the 250 cap WITHOUT a raised ceiling, which is the whole
//  reason the labels are three letters and the trade list is windowed to
//  three rows. A four-row window measured 280 and the fix was the window, not
//  the cap.
// ===========================================================================

// THE PANEL PLATE, RE-SIZED FOR 320x180.
// At 4:3 it was 280x150 at (20, 40): 62 % of the frame's height, with a 40 px
// margin above and 50 below, and "the world dims but never disappears" was
// legible in those margins. Keeping 150 in a 180-tall frame would leave 15 px
// top and bottom and make the claim a lie -- SETTLEMENT.md's whole point is
// that the trade is happening in a town you are STANDING IN.
//
// 128 at y 26 keeps the same 71 %-of-what's-left feel with a symmetric 26 px
// margin, and every internal offset below is expressed FROM THE PLATE so the
// row pitch (14 px, which the 9 px selection bar needs) never has to be
// re-derived. What fits, measured against the plate rather than asserted:
//     title      +8                       ->  34 .. 41
//     5 rows     +26 + i*14, 7 px each    ->  52 .. 115  (bar +25 .. +116)
//     footer     +100                     -> 126 .. 133
//     message    +114                     -> 140 .. 147
//     plate ends +128                     -> 154, so 7 px of plate under the
//                                            message, as at 4:3
let g_PANEL_Y: f64 = 26.0;
let g_PANEL_H: f64 = 128.0;

let g_PANEL_ROWS_VISIBLE: i32 = 3;

// EVERY STRING IN A PANEL GOES THROUGH HERE, and here counts the frames in
// which `font_text_shadowed` had to drop glyphs. The unlock card taught this
// lesson once already (`g_hud_card_trunc`, and the frame that read "TINKER SMG
// - AT THE BEN"); a panel is six strings and would have taught it six times.
// `--demo-ui` drives both panels and `--selftest` asserts this counter is 0.
fn hud_panel_text(p_x: f64, p_y: f64, p_s: string, p_c: i32, p_budget: i32): i32 {
    let n: i32 = hud_text(p_x, p_y, p_s, p_c, p_budget);
    if (font_last_truncated() != FONT_OK) { g_panel_trunc = g_panel_trunc + 1; }
    let out: i32 = n;
    return out;
}

fn hud_panel_row(p_y: f64, p_sel: i32, p_left: string, p_right: string,
                 p_c: i32, p_budget: i32): i32 {
    let n: i32 = 0;
    let col: i32 = p_c;
    if (p_sel == 1) {
        // The cursor is a filled bar, not a caret: at 320x240 a one-glyph
        // marker next to three-letter labels is invisible, and this costs the
        // same two triangles.
        n = n + hud_rect(28.0, p_y - 1.0, 264.0, 9.0, g_UI_AMBER, 70);
        col = g_UI_WHITE;
    }
    n = n + hud_panel_text(34.0, p_y, p_left, col, clampi(p_budget - n, 0, 72));
    if (p_right.length > 0) {
        let w: f64 = f64(p_right.length) * 4.0;
        n = n + hud_panel_text(286.0 - w, p_y, p_right, col,
                               clampi(p_budget - n, 0, 40));
    }
    let out: i32 = n;
    return out;
}

fn hud_panel(p_budget: i32): i32 {
    let cx: f64 = f64(g_RES_W) * 0.5;
    let n: i32 = 0;
    let panel: i32 = client_ui_panel(g_cl);

    // The world dims but never disappears: SETTLEMENT.md's whole point is that
    // the town is a place you are STANDING IN, and a menu that blacks it out
    // makes the trade happen in an inventory rather than at a bench.
    n = n + hud_rect(20.0, g_PANEL_Y, 280.0, g_PANEL_H, g_UI_BLACK, 205);

    let row: i32 = client_ui_row(g_cl);
    let rows: i32 = client_ui_rows(g_cl);

    if (panel == UI_PANEL_CHAR) {
        n = n + hud_panel_text(34.0, g_PANEL_Y + 8.0, "CHARACTER", g_UI_AMBER,
                               clampi(p_budget - n, 0, 40));
        let pts: i32 = client_points(g_cl);
        let pc: i32 = g_UI_DIM;
        if (pts > 0) { pc = g_UI_XP; }
        n = n + hud_panel_text(216.0, g_PANEL_Y + 8.0, `${pts} PTS`, pc,
                               clampi(p_budget - n, 0, 32));
        for (let i = 0; i < 5; i++) {
            let sel: i32 = 0;
            if (i == row) { sel = 1; }
            n = n + hud_panel_row(g_PANEL_Y + 26.0 + f64(i) * 14.0, sel,
                                  client_stat_short(i),
                                  `${client_stat(g_cl, i)}`,
                                  g_UI_DIM, p_budget - n);
        }
        // 13 drawable glyphs x 4 triangles = 52, and the budget is 56. The
        // close key is deliberately NOT on this line: TAB opens and TAB
        // closes, `controls_print` says so, and the two glyphs it would cost
        // are the two that made the line truncate.
        n = n + hud_panel_text(34.0, g_PANEL_Y + 100.0, "X NEXT   C SPEND", g_UI_DIM,
                               clampi(p_budget - n, 0, 56));
    } else {
        let who: i32 = client_talk_who(g_cl);
        if (who < 0) {
            n = n + hud_centre(g_PANEL_Y + g_PANEL_H * 0.5 - 3.0, "NOBODY HERE", g_UI_DIM,
                               clampi(p_budget - n, 0, 48));
        } else {
            n = n + hud_panel_text(34.0, g_PANEL_Y + 8.0, client_npc_name(who), g_UI_AMBER,
                                   clampi(p_budget - n, 0, 32));
            n = n + hud_panel_text(150.0, g_PANEL_Y + 8.0, client_npc_place(who), g_UI_DIM,
                                   clampi(p_budget - n, 0, 48));
            // THE WINDOW. Three rows, scrolled to keep the cursor inside. A
            // villager can have nine offers and nine rows is 460 triangles.
            let first: i32 = 0;
            if (rows > g_PANEL_ROWS_VISIBLE) {
                first = row - 1;
                if (first < 0) { first = 0; }
                if (first > rows - g_PANEL_ROWS_VISIBLE) {
                    first = rows - g_PANEL_ROWS_VISIBLE;
                }
            }
            let open: i32 = client_talk_offers(g_cl);
            let shown: i32 = 0;
            for (let k = first; k < rows; k++) {
                if (shown >= g_PANEL_ROWS_VISIBLE) { continue; }
                let sel: i32 = 0;
                if (k == row) { sel = 1; }
                // A CLOSED ROW IS STILL DRAWN, DIMMED. DIRECTION.md §6: the
                // arsenal is a relationship, and a relationship you cannot see
                // the shape of is a locked door with no handle. Showing what
                // Mabel COULD make is what makes lighting the next lantern
                // mean something.
                let c: i32 = g_UI_DIM;
                if ((open & (1 << k)) != 0) { c = g_UI_WHITE; }
                // `npc_offer_*` is a STATIC TABLE with no state in it, so
                // reading it here is a table lookup and not a reach into the
                // authority: what is OPEN arrives through the owner block's
                // `talk_offers` bitmask above, and only that.
                let g: i32 = npc_offer_first(who) + k;
                let lab: string = client_offer_label(npc_offer_kind(g),
                                                     npc_offer_arg(g));
                n = n + hud_panel_row(g_PANEL_Y + 28.0 + f64(shown) * 14.0, sel, lab, "",
                                      c, p_budget - n);
                shown++;
            }
            if (rows > g_PANEL_ROWS_VISIBLE) {
                n = n + hud_text(286.0, g_PANEL_Y + 8.0, `${row + 1}`, g_UI_DIM,
                                 clampi(p_budget - n, 0, 12));
            }
            n = n + hud_panel_text(34.0, g_PANEL_Y + 100.0, "X NEXT   C TAKE", g_UI_DIM,
                                   clampi(p_budget - n, 0, 56));
        }
    }

    // What the last confirm did, in words. A menu that swallows a press is a
    // menu the player stops trusting.
    let msg: i32 = client_ui_msg(g_cl);
    if (msg != 0) {
        n = n + hud_centre(g_PANEL_Y + 114.0, client_ui_msg_text(msg), g_UI_AMBER,
                           clampi(p_budget - n, 0, 60));
    }

    let out: i32 = n;
    return out;
}

fn hud_build() {
    let used: i32 = 0;
    let cx: f64 = f64(g_RES_W) * 0.5;
    let cy: f64 = f64(g_RES_H) * 0.5;

    // SIX TRIANGLES OF RESERVE. The text budgets below are exact --
    // `font_text_shadowed` truncates at its budget -- but the plates and bars
    // around them are fixed 2-triangle quads that are emitted after their
    // gate. Reserving six for them is what turns "254 of 250" into a cap that
    // holds. MEASURED: without it, the lantern-lit frame landed on 254.
    let cap: i32 = g_HUD_TRI_CAP - 6;
    if (g_hud_on == 2) { cap = 512; }
    // The remaining budget, clamped to what this element would like. Passing it
    // as the TEXT budget is what makes the cap structural: `font_text_shadowed`
    // TRUNCATES at its budget instead of overspending, so a line can only ever
    // draw the glyphs there is room for. Gating on an ESTIMATE (the first
    // version of this) measured 266 at the lantern-lit moment, because a
    // 26-glyph unlock card costs 104 and the estimate said 80.

    // ---- the fade from black. GDD §8 at 0:00. ---------------------------
    let fade: f64 = client_intro_alpha(g_cl);
    if (fade > 0.002) {
        used = used + hud_rect(0.0, 0.0, f64(g_RES_W), f64(g_RES_H),
                               g_UI_BLACK, clampi(i32(fade * 255.0), 0, 255));
        if (fade > 0.35) {
            used = used + hud_centre(cy - 20.0, "THE LAMPS WENT OUT ON A TUESDAY",
                                     g_UI_DIM, clampi(cap - used, 0, 128));
        }
    }

    if (g_hud_on == 0) {
        g_hud_tris = used;
        return;
    }

    // ---- W6: A MODAL PANEL REPLACES THE COMBAT HUD ----------------------
    // Not "is drawn on top of". ART_BIBLE §9's 250-triangle cap is a HARD cap
    // and a character sheet is 180 triangles by itself; stacking it over a
    // crosshair, a compass, two bars and an ammo counter lands at 400 and the
    // honest way to pay for that is not a bigger cap. It is that a menu has no
    // business having a crosshair. So the panel takes the whole budget, the
    // world dims behind it, and the cap holds at its documented value.
    if (client_ui_panel(g_cl) != UI_PANEL_NONE) {
        used = used + hud_panel(cap - used);
        g_hud_tris = used;
        g_panel_frames = g_panel_frames + 1;
        if (client_ui_panel(g_cl) == UI_PANEL_CHAR) {
            if (used > g_panel_char_peak) { g_panel_char_peak = used; }
        } else {
            if (used > g_panel_trade_peak) { g_panel_trade_peak = used; }
        }
        if (used > g_HUD_TRI_CAP) {
            if (g_hud_over == 0) {
                eprint(`nightshade: HUD panel emitted ${used} triangles, over the ${g_HUD_TRI_CAP} cap`);
                g_hud_over = 1;
            }
        }
        return;
    }

    // ---- the crosshair, with real spread bloom --------------------------
    // The gap grows with hipfire bloom, exactly as ART_BIBLE §9.3 asks. ADS
    // pulls it in; a dry magazine turns it red (GDD §7.12).
    //
    // >>> THIS WAS THE COPY THAT WAS WRONG. <<<  Until the 16:9 change the four
    // arms were hand-placed here as `cx - 6 - spread` / `cx + 2 + spread`,
    // which is NOT symmetric: hudgen bakes each tick's ink one texel inside its
    // own rect, so the left arm's ink ended at cx - 2 - spread while the right
    // arm's began at cx + 3 + spread — two pixels further out.
    //
    // MEASURED, not reasoned: `--demo 8 --shots`, hipfire, native readback of
    // the old 320x240 build.
    //     horizontal ink  cols 148..151 and 170..173  -> midpoint 160.5
    //     vertical   ink  rows 108..111 and 130..133  -> midpoint 120.5
    // The aim axis is at 160.0/120.0, so the correct midpoints are 159.5/119.5:
    // the whole cross sat ONE PIXEL right and one down, with a 8 px gap on the
    // left and a 10 px gap on the right. shot.hml and walk.hml, measuring
    // 151..154 / 165..168 (midpoint 159.5), were correct all along. Three hand
    // copies, one wrong, and no test that could see it because each file agreed
    // with itself.
    //
    // The same readback on THIS code at 320x180 gives 148..151 and 168..171,
    // midpoint 159.5, and rows 78..81 / 98..101, midpoint 89.5 — the left and
    // top arms land on exactly the pixels they always did and the right and
    // bottom ones move IN by two to meet them.
    //
    // `hudgen_xh_place` is now the only implementation. Its `spread` is
    // ART_BIBLE §9.3's own 0..9 and the gap from the aim axis is 3 + spread, so
    // the mapping below reproduces this HUD's LEFT-arm gaps exactly — 4 px at
    // full ADS, 8 px at the hip, 11 px sprinting — and the right and bottom
    // arms move IN by two pixels to meet them.
    let sp: i32 = clampi(i32(1.0 + 4.0 * (1.0 - client_ads(g_cl))), 0, 9);
    if (client_speed(g_cl) > 5.6) { sp = clampi(sp + 3, 0, 9); }
    let xc: i32 = g_UI_WHITE;
    if (client_ammo(g_cl) <= 0) { xc = g_UI_DANGER; }
    hudgen_xh_place(hudgen_cx(), hudgen_cy(), sp, g_xh, 0);
    used = used + hud_sprite(HUD_XH_TICK_H, f64(g_xh[0]), f64(g_xh[1]), xc, 255);
    used = used + hud_sprite(HUD_XH_TICK_H, f64(g_xh[2]), f64(g_xh[3]), xc, 255);
    used = used + hud_sprite(HUD_XH_TICK_V, f64(g_xh[4]), f64(g_xh[5]), xc, 255);
    used = used + hud_sprite(HUD_XH_TICK_V, f64(g_xh[6]), f64(g_xh[7]), xc, 255);
    used = used + hud_sprite(HUD_XH_DOT, cx - 1.0, cy - 1.0, xc, 255);

    // ---- the hitmarker (GDD §7.4) ----------------------------------------
    let hm: f64 = client_hitmarker(g_cl);
    if (hm > 0.0) {
        let hc: i32 = g_UI_WHITE;
        if (client_hitmarker_kill(g_cl) == 1) { hc = g_UI_AMBER; }
        used = used + hud_sprite(HUD_HITMARK, cx - 8.0, cy - 8.0, hc,
                                 clampi(i32(hm / 0.09 * 255.0), 0, 255));
    }

    // ---- the compass -----------------------------------------------------
    used = used + hud_rect(cx - 46.0, 3.0, 92.0, 9.0, g_UI_BLACK, 160);
    let yawn: f64 = g_yaw_deg;
    while (yawn < 0.0) { yawn = yawn + 360.0; }
    while (yawn >= 360.0) { yawn = yawn - 360.0; }
    for (let t = 0; t < 8; t++) {
        let ang: f64 = f64(t) * 45.0 - yawn;
        while (ang < -180.0) { ang = ang + 360.0; }
        while (ang > 180.0) { ang = ang - 360.0; }
        if (ang > -44.0 && ang < 44.0) {
            let id: i32 = HUD_TICK_MINOR;
            let c: i32 = g_UI_DIM;
            if (t % 2 == 0) { id = HUD_TICK_MAJOR; c = g_UI_WHITE; }
            used = used + hud_sprite(id, cx + ang, 4.0, c, 255);
        }
    }
    used = used + hud_sprite(HUD_CHEVRON, cx - 2.0, 1.0, g_UI_AMBER, 255);

    // ---- the objective marker: the lantern -------------------------------
    // GDD §8 at 0:06: "You will walk toward it. Everyone does." The marker is
    // what makes that true when the fog has closed and you cannot see it.
    if (client_lantern_lit(g_cl) == 0 && client_has_control(g_cl) == 1) {
        let br: f64 = client_lantern_bearing(g_cl);
        let px: f64 = cx + clampf(br * 92.0, -44.0, 44.0);
        used = used + hud_sprite(HUD_ICON_DIAMOND, px - 3.0, 14.0, g_UI_AMBER, 230);
    }

    // ---- W6: HOME, ON THE COMPASS ----------------------------------------
    // "you carry what you find home to a small warm town." A town you cannot
    // find your way back to is not home, and the whole ladder in SETTLEMENT.md
    // is worth nothing if the player never walks back into it. Two triangles.
    // The lantern marker owns the band while it is unlit -- the first minute
    // has exactly one objective and it stays that way.
    if (client_lantern_lit(g_cl) == 1 && client_settle_inside(g_cl) == 0) {
        let sb: f64 = client_settle_bearing(g_cl);
        let spx: f64 = cx + clampf(sb * 92.0, -44.0, 44.0);
        let smc: i32 = g_UI_GOOD;
        if (client_settle_brownout(g_cl) == 1) { smc = g_UI_DANGER; }
        used = used + hud_sprite(HUD_ICON_DIAMOND, spx - 3.0, 14.0, smc, 200);
    }

    // ---- THE BOTTOM CLUSTER, RE-ANCHORED FOR 16:9 -----------------------
    // 320x180 moved the bottom edge up 60 px. Every y below is now measured
    // FROM THAT EDGE through `hudgen_bot(height, clearance)` instead of being a
    // literal that silently meant "240 minus something". The CLEARANCES are
    // carried over from 4:3 unchanged, so the stack keeps its own internal
    // spacing exactly — it is 34 px tall in both frames, it just starts higher
    // up a shorter one (78 % down the frame instead of 83 %).
    //
    //   element                   4:3 y   16:9 y   clearance under it
    //     spell name              200      140      —
    //     oil track (6 px)        209      149      25 px
    //     oil cooldown hairline   216      156      —
    //     health track (6 px)     219      159      15 px
    //     health numeral          228      168      —
    //     XP track (3 px)         237      177       0 px  (it IS the edge)
    let y_xp: f64 = hudgen_bot(3.0, 0.0);          // 177
    let y_hp: f64 = hudgen_bot(6.0, 15.0);         // 159
    let y_oil: f64 = hudgen_bot(6.0, 25.0);        // 149
    let y_am: f64 = hudgen_bot(16.0, 6.0);         // 158

    // ---- health ----------------------------------------------------------
    let hp01: f64 = client_hp01(g_cl);
    used = used + hud_rect(9.0, y_hp, 62.0, 6.0, g_UI_BLACK, 190);
    let hc2: i32 = g_UI_GOOD;
    if (f64(client_hp(g_cl)) <= g_LOW_HP) { hc2 = g_UI_DANGER; }
    used = used + hud_rect(10.0, y_hp + 1.0, 60.0 * hp01, 4.0, hc2, 255);
    used = used + hud_text(10.0, y_hp + 9.0, `${client_hp(g_cl)}`, hc2, g_TB_HP);

    // ---- ammo: GDD §8 says the counter reads 6 / 12 ----------------------
    let ammo: i32 = client_ammo(g_cl);
    let ac: i32 = g_UI_WHITE;
    if (ammo <= 1) { ac = g_UI_DANGER; }
    let astr: string = `${ammo} / ${client_reserve(g_cl)}`;
    used = used + hud_rect(238.0, y_am, 76.0, 16.0, g_UI_BLACK, 170);
    used = used + hud_text_big(242.0, y_am + 2.0, astr, ac, g_TB_AMMO);

    // ---- W7-3: WHAT IS IN YOUR HANDS, AND WHAT YOU OWN --------------------
    // The ammo counter cannot say this. "6 / 12" is the same two numbers
    // whichever gun you are holding, so after a trade the player's only
    // evidence that the rifle is real was that the recoil felt different --
    // and 1.5 s later it was not even that. The word is the evidence.
    let w_cur: i32 = client_weapon(g_cl);       // what the AUTHORITY says
    let w_ask: i32 = client_in_weapon(g_cl);    // what we are asking for
    let n_own: i32 = client_own_count(g_cl);
    // 7 glyphs, 28 triangles, and it YIELDS -- same `used + N <= cap` gate the
    // spell name and the unlock card use. ART_BIBLE §9's cap is hard and a
    // reminder is always the first thing to go.
    if (ammo > 0) {
        if (used + 28 <= cap) {
            let wnc: i32 = g_UI_WHITE;
            // Mid-swap the two disagree, and DIM is that disagreement: the
            // gun named is the one still in your hands, on its way out.
            if (w_cur != w_ask) { wnc = g_UI_DIM; }
            used = used + hud_text(242.0, y_am - 8.0, client_weapon_name(w_cur),
                                   wnc, clampi(cap - used, 0, 28));
        }
    }
    // THE OWNED SET, one pip per slot, in id order -- so a pip's POSITION is
    // the number key that selects it. Two triangles each and only for guns you
    // actually have, so a one-gun player pays nothing; the row APPEARING when
    // you buy your second is the feedback that the purchase was permanent.
    if (n_own > 1) {
        // ONE CONTRAST PLATE FOR THE WHOLE STRIP, and it is not optional.
        // ART_BIBLE §9 / CLAUDE.md §9.9: a 3x2 px mark with no plate under it
        // is invisible over grass and over a muzzle flash, which are the two
        // things most often behind this corner. Measured on `--demo 50
        // --at-town`: the AMBER held-pip read at 320x180 and the DIM one did
        // not, until this rect went in. Two triangles for eight marks.
        used = used + hud_rect(240.0, y_am - 14.0, 34.0, 4.0, g_UI_BLACK, 170);
        for (let wi = 0; wi < 8; wi++) {
            if (client_owns(g_cl, wi) == 0) { continue; }
            // Three states, and the middle one only exists mid-swap: DIM is a
            // gun you own, WHITE is the gun you have just asked for and have
            // not been handed yet, AMBER is the gun in your hands.
            let pc: i32 = g_UI_DIM;
            let pa: i32 = 210;
            if (wi == w_cur) { pc = g_UI_AMBER; pa = 255; }
            else if (wi == w_ask) { pc = g_UI_WHITE; pa = 235; }
            used = used + hud_rect(242.0 + f64(wi) * 4.0, y_am - 13.0,
                                   3.0, 2.0, pc, pa);
        }
    }

    // ---- W6: THE OFF HAND ------------------------------------------------
    // The lantern hand. MAGIC_KINETIC's oil is the second resource in the game
    // and it does not exist to the player until it is on screen. Drawn only
    // once a spell has been granted, which is `sim.lanterns_lit >= 1` -- so
    // the first minute is not cluttered by a bar that reads 100 % and does
    // nothing, and the bar APPEARING is part of the 0:30 payoff.
    let sid: i32 = client_spell_id(g_cl);
    if (client_spell_have(g_cl) != 0) {
        used = used + hud_rect(9.0, y_oil, 62.0, 6.0, g_UI_BLACK, 190);
        let o01: f64 = client_oil01(g_cl);
        used = used + hud_rect(10.0, y_oil + 1.0, 60.0 * o01, 4.0, g_NS_HALO, 255);
        if (sid >= 0) {
            let cd: f64 = client_spell_cd01(g_cl);
            // The cooldown is a BAR, not a number, and it is 2 triangles, so
            // it is never the thing that yields: "can I cast" has to survive
            // the busiest frame in the game.
            if (cd > 0.0) {
                used = used + hud_rect(9.0, y_oil + 7.0, 62.0 * cd, 1.0, g_UI_DIM, 220);
            }
            // THE NAME YIELDS. "EMBERLANCE" is 10 glyphs and therefore 40
            // triangles EVERY FRAME, and adding it unconditionally took the
            // 0:30 peak -- lantern flash + unlock card + oil bar together --
            // from 192 to 248 of a 250 cap. Two triangles of headroom is not
            // headroom. The meter is the resource and stays; the word is a
            // reminder and goes first, on the same `used + N <= cap` gate the
            // banner and the unlock card already use.
            if (used + 48 <= cap) {
                let cdc: i32 = g_UI_AMBER;
                if (cd > 0.0) { cdc = g_UI_DIM; }
                used = used + hud_text(10.0, y_oil - 9.0, client_spell_name(sid), cdc,
                                       clampi(cap - used, 0, 48));
            }
        }
        // Standing in light is what halves the phase multiplier. Say so with
        // one pixel of colour rather than a word.
        if (client_in_light(g_cl) == 1) {
            used = used + hud_rect(72.0, y_oil + 1.0, 2.0, 4.0, g_UI_AMBER, 255);
        }
    }
    // The channel bar for Mend and the Lance. Centre screen, because you
    // cannot move while it runs.
    let chan: f64 = client_spell_chan01(g_cl);
    if (chan > 0.0) {
        used = used + hud_rect(cx - 24.0, cy + 20.0, 48.0, 3.0, g_UI_BLACK, 200);
        used = used + hud_rect(cx - 23.0, cy + 21.0, 46.0 * chan, 1.0, g_NS_HALO, 255);
    }

    // ---- W6: the melee hand ----------------------------------------------
    // GAME_DESIGN §8: "You WILL run out." The club's name appears when the
    // magazine is the thing that ran out, which is the moment it matters and
    // the only moment it is worth 20 triangles.
    let mw: i32 = client_mel_wpn(g_cl);
    if (mw >= 0 && ammo <= 0) {
        used = used + hud_text(242.0, y_am - 8.0, client_melee_name(mw),
                               g_UI_AMBER, clampi(cap - used, 0, 24));
    }

    // ---- the reload bar --------------------------------------------------
    let rt: f64 = client_reloading(g_cl);
    if (rt > 0.0) {
        used = used + hud_rect(cx - 24.0, cy + 12.0, 48.0, 3.0, g_UI_BLACK, 200);
        let f: f64 = clamp01(1.0 - rt / 1.6);
        used = used + hud_rect(cx - 23.0, cy + 13.0, 46.0 * f, 1.0, g_UI_AMBER, 255);
        used = used + hud_centre(cy + 16.0, "RELOADING", g_UI_DIM, 40);
    }

    // ---- the XP bar ------------------------------------------------------
    let need: i32 = client_xp_need(g_cl);
    let into: i32 = client_xp_into(g_cl);
    let xf: f64 = 0.0;
    if (need > 0) { xf = clamp01(f64(into) / f64(need)); }
    used = used + hud_rect(0.0, y_xp, f64(g_RES_W), 3.0, g_UI_BLACK, 170);
    used = used + hud_rect(0.0, y_xp + 1.0, f64(g_RES_W) * xf, 1.0, g_NS_HALO, 255);

    // ---- the damage vignette + direction arc (GDD §7.13) -----------------
    let dt2: f64 = client_damage_t(g_cl);
    if (dt2 > 0.0) {
        let a: i32 = clampi(i32(dt2 / 1.2 * 90.0 * (1.0 - hp01 + 0.35)), 0, 130);
        used = used + hud_rect(0.0, 0.0, f64(g_RES_W), 5.0, g_UI_DANGER, a);
        used = used + hud_rect(0.0, hudgen_bot(5.0, 0.0), f64(g_RES_W), 5.0, g_UI_DANGER, a);
        let br2: f64 = client_damage_dir(g_cl) - g_yaw_deg * g_D2R;
        used = used + hud_sprite(HUD_ICON_ARROW,
                                 cx + clampf(sin(br2) * 40.0, -44.0, 44.0),
                                 cy - 26.0, g_UI_DANGER,
                                 clampi(i32(dt2 / 1.2 * 255.0), 0, 255));
    }

    // ---- the interact prompt.  GAME_DESIGN §8 at 0:24. -------------------
    if (client_prompt(g_cl) == 1) {
        let ch: f64 = client_chan01(g_cl);
        used = used + hud_rect(cx - 62.0, g_Y_PROMPT, 124.0, 22.0, g_UI_BLACK, 190);
        used = used + hud_centre(g_Y_PROMPT + 4.0, "HOLD [E] - LIGHT THE LANTERN",
                                 g_UI_WHITE, clampi(cap - used, 0, g_TB_PROMPT));
        used = used + hud_centre(g_Y_PROMPT + 12.0, "IT'S GOING TO GET THEIR ATTENTION",
                                 g_UI_DIM, clampi(cap - used, 0, g_TB_PROMPT));
        if (ch > 0.0) {
            used = used + hud_rect(cx - 40.0, g_Y_PROMPT + 22.0, 80.0, 3.0, g_UI_BLACK, 210);
            used = used + hud_rect(cx - 39.0, g_Y_PROMPT + 23.0, 78.0 * ch, 1.0, g_UI_AMBER, 255);
        }
    }

    // ---- W6: THE VILLAGER IN FRONT OF YOU --------------------------------
    // DIRECTION.md §6.1: "NPCs are the crafting and trading interface, not
    // menus. You get the bolt-action FROM SOMEONE." So the prompt names the
    // person, not the verb, and the second line is what they are for.
    if (client_talk_prompt(g_cl) == 1) {
        let who: i32 = client_talk_who(g_cl);
        used = used + hud_rect(cx - 62.0, g_Y_PROMPT, 124.0, 22.0, g_UI_BLACK, 190);
        used = used + hud_centre(g_Y_PROMPT + 4.0, `[E] ${client_npc_name(who)}`,
                                 g_UI_WHITE, clampi(cap - used, 0, 48));
        if (client_talk_offers(g_cl) != 0) {
            used = used + hud_centre(g_Y_PROMPT + 12.0, "[T] TRADE", g_UI_AMBER,
                                     clampi(cap - used, 0, 36));
        }
        // GAME_DESIGN §5.7's "one new line per in-game day", as a mark. This
        // is the whole of the "worth visiting" UI and it is two triangles.
        if (client_talk_new(g_cl) == 1) {
            used = used + hud_sprite(HUD_ICON_DIAMOND, cx + 54.0, g_Y_PROMPT + 2.0,
                                     g_UI_AMBER, 230);
        }
    }

    // ---- W6: what they said ----------------------------------------------
    if (client_talk_topic(g_cl) >= 0 && used + 100 <= cap) {
        let line: string = client_talk_line(client_talk_who(g_cl),
                                            client_talk_topic(g_cl),
                                            client_talk_arg(g_cl));
        used = used + hud_rect(cx - 80.0, g_Y_TALKLINE, 160.0, 11.0, g_UI_BLACK, 200);
        used = used + hud_centre(g_Y_TALKLINE + 3.0, line, g_UI_WHITE,
                                 clampi(cap - used, 0, 96));
    }

    // ---- FROM HERE DOWN EVERY BLOCK IS OPTIONAL AND BUDGETED. -----------
    // ART_BIBLE §9's 250-triangle cap is a HARD cap, and FONT_MICRO costs FOUR
    // triangles a glyph once the mandatory 1-px shadow is counted: a 26-glyph
    // unlock card is 104 triangles all by itself. Stacking the lantern flash,
    // the LEVEL card, the unlock card and a wave banner in the same frame
    // measured 264. The fix is not a bigger cap and it is not shorter strings
    // -- it is a gate, so that the elements that must never disappear
    // (crosshair, health, ammo, prompt) are emitted FIRST and the celebratory
    // ones yield when there is no room. `left` is re-read before each block.

    // ---- the lantern-lit flash and the level card ------------------------
    let ring: f64 = client_lit_ring_t(g_cl);
    if (ring > 0.0 && used + 2 <= cap) {
        used = used + hud_rect(0.0, 0.0, f64(g_RES_W), f64(g_RES_H), g_EMBER,
                               clampi(i32(ring / 1.2 * 70.0), 0, 90));
    }
    let lvt: f64 = client_level_t(g_cl);
    if (lvt > 0.0 && used + 60 <= cap) {
        used = used + hud_centre_big(g_Y_LEVEL, `LEVEL ${client_level(g_cl)}`,
                                     g_UI_AMBER, clampi(cap - used, 0, 60));
    }
    let ct: f64 = client_card_t(g_cl);
    // RESERVE THE WHOLE BLOCK, NOT JUST THE TEXT LINE.  This gate said `+ 80`
    // while the block it guards costs 114: a 2-triangle plate, "UNLOCKED" at 32,
    // and the 80-triangle name (all three MEASURED). At any `used` in
    // [cap-113, cap-80] the block therefore started drawing and the name was
    // truncated by the `cap - used` clamp below — the same defect as the 72
    // budget, arriving by a different door and only on busy frames. Gating on
    // the block's real cost means the card either appears whole or yields to the
    // elements that must never disappear. MEASURED HUD peak with it whole: see
    // the report; the cap is 250 and the reserve above keeps 6 back.
    if (ct > 0.0 && used + 114 <= cap) {
        let slide: f64 = clampf((1.0 - ct / 2.5) * 6.0, 0.0, 1.0);
        let x0: f64 = f64(g_RES_W) - 128.0 * slide;
        used = used + hud_rect(x0, g_Y_CARD, 126.0, 20.0, g_UI_BLACK, 200);
        used = used + hud_text(x0 + 4.0, g_Y_CARD + 3.0, "UNLOCKED", g_UI_AMBER,
                               clampi(cap - used, 0, 36));
        used = used + hud_text(x0 + 4.0, g_Y_CARD + 11.0, client_card(g_cl), g_UI_WHITE,
                               clampi(cap - used, 0, g_TB_CARD));
        // THE REGRESSION SIGNAL FOR THE BUDGET ABOVE. `font_text_shadowed`
        // reports whether it had to drop glyphs, and this is the one line of
        // text in the game whose meaning does not survive being cut short — the
        // defect it caught read "TINKER SMG - AT THE BEN". No probe can assert
        // g_TB_CARD directly (it lives in the one module that needs a display,
        // so nothing headless can import it), so the check lives at the draw
        // site, costs one compare, and is reported by `--demo` and asserted by
        // `--selftest`.
        if (font_last_truncated() != FONT_OK) { g_hud_card_trunc = g_hud_card_trunc + 1; }
    }

    // ---- banners: waves, the horn, the clear -----------------------------
    let bt: f64 = client_banner_t(g_cl);
    if (bt > 0.0 && used + 96 <= cap) {
        used = used + hud_centre_big(g_Y_BANNER, client_banner(g_cl), g_UI_AMBER,
                                     clampi(cap - used, 0, g_TB_BANNER));
    }
    let tt: f64 = client_toast_t(g_cl);
    if (tt > 0.0 && used + 60 <= cap) {
        used = used + hud_centre(g_Y_TOAST, client_toast(g_cl), g_UI_DIM,
                                 clampi(cap - used, 0, 60));
    }

    // ---- death -----------------------------------------------------------
    if (client_dead(g_cl) == 1 && used + 62 <= cap) {
        used = used + hud_rect(0.0, 0.0, f64(g_RES_W), f64(g_RES_H), g_UI_DANGER, 60);
        used = used + hud_centre_big(cy - 10.0, "THE DARK TOOK YOU", g_UI_WHITE,
                                     clampi(cap - used, 0, 60));
    }

    // ---- the wave readout ------------------------------------------------
    let ws: i32 = client_wave_state(g_cl);
    if (ws != DIR_IDLE && used + 44 <= cap) {
        used = used + hud_text(4.0, 16.0,
                               `WAVE ${client_wave(g_cl) + 1}  x${client_alive(g_cl)}`,
                               g_UI_DIM, clampi(cap - used, 0, 44));
    }

    // ---- the debug readout (H). Over the cap, and it says so. ------------
    if (g_hud_on == 2) {
        used = used + hud_rect(2.0, 24.0, 180.0, 50.0, g_UI_BLACK, 185);
        used = used + hud_text(4.0, 26.0, g_l_tri, g_UI_GOOD, g_TB_DBG);
        used = used + hud_text(4.0, 34.0, g_l_ms, g_UI_WHITE, g_TB_DBG);
        used = used + hud_text(4.0, 42.0, g_l_net, g_UI_DIM, g_TB_DBG);
        used = used + hud_text(4.0, 50.0, g_l_beat, g_UI_AMBER, g_TB_DBG);
        used = used + hud_text(4.0, 58.0, g_l_town, g_UI_GOOD, g_TB_DBG);
        used = used + hud_text(4.0, 66.0, g_l_hand, g_NS_HALO, g_TB_DBG);
    }

    g_hud_tris = used;
    if (g_hud_on != 2 && used > g_HUD_TRI_CAP) {
        if (g_hud_over == 0) {
            eprint(`nightshade: HUD emitted ${used} triangles, over the ${g_HUD_TRI_CAP} cap`);
            g_hud_over = 1;
        }
    }
}

let g_l_tri: string = "";
let g_l_ms: string = "";
let g_l_net: string = "";
let g_l_beat: string = "";
let g_l_town: string = "";
let g_l_hand: string = "";
let g_frame_ms: f64 = 0.0;
let g_wall_ms: f64 = 0.0;
let g_fps: f64 = 60.0;

fn f1(p_x: f64): string {
    let x: f64 = p_x;
    let neg: i32 = 0;
    if (x < 0.0) { neg = 1; x = 0.0 - x; }
    let s: i32 = i32(x * 10.0 + 0.5);
    let w: i32 = divi(s, 10);
    let f: i32 = s - w * 10;
    let out: string = `${w}.${f}`;
    if (neg == 1) { out = "-" + out; }
    return out;
}

fn hud_strings() {
    g_l_tri = `TRI ${stat_get(STAT_TRIS_DRAWN)}/${stat_get(STAT_TRIS_SUBMITTED)} DC${stat_get(STAT_DRAW_CALLS)} HUD${g_hud_tris}`;
    g_l_ms = `${f1(g_frame_ms)}MS ${i32(g_fps)}FPS SIM${f1(g_sim_ms)}`;
    g_l_net = `T${g_tick} CMD${client_cmds_sent(g_cl)} PKT${client_packets(g_cl)} ${server_snap_bytes(g_sv)}B L${i32(transport_latency_ms(g_net))}`;
    g_l_beat = `${server_beat_name(server_beat(g_sv))} S${server_session(g_sv)} TIER${client_tier(g_cl)} ${f1(tod_clock_hours(g_day_t))}H`;
    // W6. THE LADDER, IN NUMBERS. `settle_promote_check` wants all three of
    // grid points, CORE_LUX and Great Lantern tier at once and then holds them
    // for a whole in-game day -- a player who cannot see which of the three is
    // short is playing a slot machine, so H twice shows them.
    g_l_town = `${client_settle_tier_name(client_settle_tier(g_cl))} LUX${client_settle_core(g_cl)}/${client_settle_core_need(g_cl)} P${client_settle_pts(g_cl)}/${client_settle_pts_need(g_cl)} B${client_settle_buildings(g_cl)} N${client_npc_named(g_cl)} ${i32(client_settle_dist(g_cl))}M`;
    g_l_hand = `OIL${i32(client_oil(g_cl))}/${i32(client_oil_tank(g_cl))} ${client_spell_name(client_spell_id(g_cl))} MEL${client_mel_wpn(g_cl)} PTS${client_points(g_cl)} STR${g_settle_tris}+${g_villagers_drawn}V`;
}

// ===========================================================================
//  10.  THE FRAME
// ===========================================================================

let g_sim_ms: f64 = 0.0;
let g_ms_world: f64 = 0.0;
let g_ms_bake: f64 = 0.0;

fn frame_once(p_dt: f64, p_t: f64) {
    frame_begin();

    // -- 6  tod_eval -> the frame graph's RenderEnv ------------------------
    stat_begin(STAT_T_TOD);
    tod_step();
    emit_set_env(frame_env());
    stat_end(STAT_T_TOD);

    // -- the caller's world registry ---------------------------------------
    let w0: u64 = clock_now();
    world_rebuild(p_dt, p_t);
    let w1: u64 = clock_now();
    bake_step();
    let w2: u64 = clock_now();
    g_ms_world = clock_ms_between(w0, w1);
    g_ms_bake = clock_ms_between(w1, w2);

    // -- 7  skygen's rolling re-bake, one slice per frame -------------------
    stat_begin(STAT_T_SKYBAKE);
    let rows: i32 = 0;
    if (skygen_dirty_rows() == 0 && g_sky_want == 1) {
        skygen_mark_dirty();
        g_sky_want = 0;
    }
    for (let k = 0; k < g_sky_burst; k++) {
        if (skygen_dirty_rows() <= 0) { break; }
        rows = rows + skygen_rebake_slice();
    }
    g_sky_burst = 1;
    stat_end(STAT_T_SKYBAKE);
    stat_set(STAT_SKY_ROWS, rows);
    g_sky_want = 1;

    // -- 8..23  the frame graph. THE ONLY ONE. -----------------------------
    frame_set_camera(g_camx, g_camy, g_camz, g_yaw_deg, g_pitch_deg, g_fov);
    frame_set_clear(g_skyk[SKYK_ZEN], g_skyk[SKYK_ZEN + 1], g_skyk[SKYK_ZEN + 2]);
    let bolt: i32 = 0;
    if (tod_lightning_active() != 0) { bolt = 1; }
    let vmb: i32 = 0;
    if (g_vm_mode == 1) { vmb = 1; }
    frame_set_options(0, vmb, bolt);

    // Screen shake is a PRESENT-time translation, never in the MVP: frustum
    // culling has to stay stable while the screen shakes (view.hml's rule).
    target_set_shake(g_target, client_shake_x(g_cl), client_shake_y(g_cl));

    frame_render();

    // -- 24  the caller's half: the viewmodel, then the HUD ----------------
    stat_begin(STAT_T_HUD);
    viewmodel_emit();
    hud_build();
    stat_end(STAT_T_HUD);

    // -- 25..28 ------------------------------------------------------------
    frame_present();
    g_frames++;
}

// ---------------------------------------------------------------------------
// THE VIEWMODEL, AND THE ONE PLACE THIS FILE DEVIATES FROM §4's STAGE ORDER.
// ---------------------------------------------------------------------------
// §4 puts the viewmodel at stage 15, inside LAYER_WORLD, and `world_render.hml`
// does exactly that for its own static lantern. `src/render/viewmodel.hml`
// (W4-10) is the DRIVEN one — idle sway, footstep bob, fire kick, reload
// stages — and it cannot be emitted at stage 15 from out here: LAYER_WORLD is
// reset at stage 11 and flushed at stage 21, both inside `frame_render()`, and
// there is no hook between them. `frame_render` would have to take a callback.
//
// So the driven viewmodel is emitted into LAYER_HUD at stage 24, under its own
// projection, before the HUD. The consequences, measured rather than assumed:
//   * ORDER. LAYER_HUD is flushed in insertion order and the viewmodel goes in
//     first, so it sits under every HUD element and over the world. A held
//     object is nearer than everything in the world, so painting it after the
//     world flush is not a compromise — it is the same result the depth sort
//     produces, arrived at for free.
//   * THE VIGNETTE. Stage 23 puts the vignette ring into LAYER_HUD before the
//     caller, so the ring now sits UNDER the viewmodel instead of over it. The
//     ring is a 42-px edge inset and the viewmodel occupies the lower middle;
//     the overlap is the bottom corners.
//   * SELF-OCCLUSION. LAYER_HUD is not depth-sorted, so the mesh relies on
//     backface culling alone. `--vm 1` selects the frame graph's stage-15
//     static viewmodel instead, which IS depth-sorted, and `--vm 0` turns it
//     off; the switch exists so the choice can be re-checked, not so it can be
//     forgotten.
// `frame_render()` for the world path is untouched either way.
let g_vm_proj: array<f64> = [];
let g_vm_tris: i32 = 0;

fn viewmodel_emit() {
    g_vm_tris = 0;
    if (g_vm_mode != 2) { return; }
    let aspect: f64 = f64(g_RES_W) / f64(g_RES_H);
    let far: f64 = g_fog_far * 1.06;
    g_vm_proj = mat_perspective(g_fov * g_D2R, aspect, g_NEAR, far);
    g_vm_tris = vm_emit(g_vm, g_bhud, g_tex_world, g_vm_proj, frame_mvp());
}

// ===========================================================================
//  11.  BOOT AND SHUTDOWN
// ===========================================================================

fn boot_window(): i32 {
    g_win = window_open_ex("NIGHTSHADE", g_RES_W, g_RES_H, g_upscale, 0);
    if (g_win == null) {
        eprint(`nightshade: window_open failed: ${sdl_error()}`);
        let bad: i32 = -1;
        return bad;
    }
    // 0 == the renderer accepted vsync; -1 == unavailable (software renderer,
    // or the dummy driver). The RETURN MATTERS: see the pace comment in
    // `run_loop`. Presenting under vsync already blocks for the flip, and
    // spinning to a 16.67 ms deadline ON TOP of that pushes the frame past the
    // next vblank and costs a whole interval.
    g_vsync = 0;
    if (set_vsync(g_win, 1) == 0) { g_vsync = 1; }
    g_target = target_new(g_win, g_RES_W, g_RES_H, g_upscale);
    if (g_target == null) {
        eprint("nightshade: target_new failed");
        let bad2: i32 = -1;
        return bad2;
    }
    target_set_border(g_target, 0, 0, 0);
    target_set_shake(g_target, 0.0, 0.0);

    // ---- THE PARALLEL EMIT POOL --------------------------------------------
    // Before `frame_init`, because `frame_par_init` is first-call-wins: this is
    // where `--workers N` beats the `g_EMIT_WORKERS` default that `frame_init`
    // would otherwise supply. `g_workers < 0` means "no flag given" and lets
    // the config default through untouched.
    //
    // The return is the count ACTUALLY RUNNING and 0 is a legitimate answer —
    // `--workers 0/1`, a build without threads, a `ThreadPool` that threw. The
    // serial path is byte-identical to the parallel one (docs/design/
    // THREADING_SPIKE.md, and this repo's nine goldens), so there is nothing to
    // report as an error and nothing to abort for. It is printed, not checked.
    if (g_workers >= 0) { frame_par_init(g_workers); }

    if (frame_init(g_win, g_target, g_fb) != 0) {
        eprint("nightshade: frame_init failed");
        let bad3: i32 = -1;
        return bad3;
    }
    g_emit_workers = frame_par_workers();
    g_bhud = frame_batch_hud();
    let ok: i32 = 0;
    return ok;
}

// The title card of ARCHITECTURE §6: seven stages, a frame between each, so the
// boot is seven visible steps instead of one frozen window.
fn boot_assets() {
    assets_set_seed(g_seed);
    let s: i32 = 0;
    while (s < AS_STAGE_COUNT) {
        assets_build_stage(g_win, s);
        s++;
    }
    if (assets_error() != 0) {
        eprint(`nightshade: asset boot failed with ${assets_error()}`);
    }
    g_atlas_world = assets_atlas(ASSET_WORLD);
    g_atlas_fx = assets_atlas(ASSET_FX);
    g_tex_world = assets_tex(ASSET_WORLD);
    g_tex_fx = assets_tex(ASSET_FX);
    g_tex_hud = assets_tex(ASSET_HUD);
    g_tex_sky = assets_tex(ASSET_SKY);

    hudgen_uv(HUD_SOLID, g_uvw, 0);
    skygen_set_clock(0.0);
    g_skyk = skygen_keys_new();
    g_todsky = [];
    for (let i = 0; i < TODSKY_COUNT; i++) { g_todsky.push(0.0); }

    frame_bind_textures(g_tex_world, g_tex_fx, g_tex_hud, g_tex_sky);
    frame_bind_fx_atlas(g_atlas_fx);
    frame_bind_assets(meshgen_mesh(MESH_BLOB), meshgen_mesh(MESH_LANTERN_VM),
                      FX_GLOW_L);
    frame_set_hud_solid_uv(g_uvw[0], g_uvw[1], g_uvw[2], g_uvw[3]);
    frame_set_vignette_colour(pal_r(g_UI_BLACK), pal_g(g_UI_BLACK), pal_b(g_UI_BLACK));
    frame_set_flash_colour(pal_r(g_LIGHTNING), pal_g(g_LIGHTNING), pal_b(g_LIGHTNING));

    // ---- W6: THE SETTLEMENT'S MESH LIBRARY -------------------------------
    // Built ONCE at boot, like every other mesh in the game. 8 archetypes x 4
    // construction states x 9 sector/rung variants, and the whole library is
    // procedural: SETTLEMENT.md's town is not an asset file either.
    hubgen_bind_atlas(g_atlas_world);
    g_hub_tris = hubgen_build_all();
    settle_render_bind(hubgen_mesh_table(), hubgen_tris_table(),
                       hubgen_radius_table(), hubgen_aabb_table());
    settle_render_bind_atlas(g_atlas_world);
    // NEVER the violet glow card. CLAUDE.md §8: violet on a friendly building
    // is the one unforgivable art bug, and `settle_render.hml`'s own header
    // records that the first build of its shot harness made exactly that
    // mistake and every window came back magenta.
    settle_render_bind_glow(FX_GLOW_L, g_UI_AMBER);
    settle_render_bind_cells(CELL_COBBLE, CELL_PATH, CELL_DIRT, CELL_RUBBLE);
    settle_render_bind_ground_rgb(g_STONE_MID, g_SAND_LO, g_STONE_HI);
    spellfx_bind();
}

// The twelve spell cells and the seven semantic tints. This is the ONLY place
// in the game that knows an fxgen cell NUMBER for a spell -- `fx.hml` may not
// import `src/art/**` (ARCHITECTURE §5.6b), so the indirection is the wall,
// and binding it here is what turns twelve authored atlas cells into twelve
// effects the player sees.
fn spellfx_bind() {
    let cells: array<i32> = [];
    while (cells.length < g_FXSC_COUNT) { cells.push(0 - 1); }
    cells[g_FXSC_MEND_RING] = FX_MEND_RING;
    cells[g_FXSC_MEND_MOTE] = FX_MEND_MOTE;
    cells[g_FXSC_CLOAK_0] = FX_CLOAK_0;
    cells[g_FXSC_CLOAK_1] = FX_CLOAK_1;
    cells[g_FXSC_FLARE_0] = FX_FLARE_0;
    cells[g_FXSC_BOLT_HEAD] = FX_BOLT_HEAD;
    cells[g_FXSC_BEAM_SEG] = FX_BEAM_SEG;
    cells[g_FXSC_LANCE] = FX_LANCE_CORE;
    cells[g_FXSC_KINDLE_POOL] = FX_KINDLE_POOL;
    cells[g_FXSC_SIGIL] = FX_SIGIL;
    cells[g_FXSC_EXPLO_0] = FX_EXPLO_0;
    cells[g_FXSC_EMBER] = FX_EMBER;
    fx_spell_bind_cells(cells);

    let tints: array<i32> = [];
    while (tints.length < g_FXST_COUNT) { tints.push(16777215); }
    tints[g_FXST_MEND] = g_VENOM_HALO;
    tints[g_FXST_MEND_DEEP] = g_VENOM;
    tints[g_FXST_MAGIC] = g_NS_HALO;
    tints[g_FXST_MAGIC_DEEP] = g_NS_CORE;
    tints[g_FXST_CLOAK] = g_NS_CORE;
    tints[g_FXST_FIRE] = g_MUZZLE_CORE;
    tints[g_FXST_FIRE_DEEP] = g_EMBER;
    fx_spell_bind_tints(tints);
    fx_spell_reset();
}

// A cast, turned into the school's OWN effect. `client.hml` reports the edge
// and the spell id; the shape each one takes is `fx.hml`'s, and the six
// emitters below are its whole public vocabulary. The eye position is the
// caster's because every one of these is centred on the player in v1 -- the
// bolt is delivered by `projectiles.hml` and gets its trail from there.
fn spellfx_cast(p_id: i32) {
    let id: i32 = p_id;
    let x: f64 = client_px(g_cl);
    let z: f64 = client_pz(g_cl);
    let y: f64 = client_py(g_cl);
    // THE SIGIL IS UNCONDITIONAL. MAGIC_KINETIC §2.1 RULE C: a cast must LOOK
    // magic in the frame it happens, whatever it then does.
    fx_spell_sigil(x, y + 1.2, z, 1.1);
    if (id == 0) { fx_spell_flare(x, y + 1.1, z, 6.0); }          // Flare
    else if (id == 3) { fx_spell_heal(x, y + 0.2, z); }           // Mend
    else if (id == 5) {                                            // Lance
        let yaw: f64 = client_cam_yaw(g_cl);
        fx_spell_lance(x, y + 1.3, z,
                       x + sin(yaw) * 22.0, y + 1.3, z - cos(yaw) * 22.0);
    } else if (id == 2) {                                          // Emberlance
        fx_spell_blast(x + sin(client_cam_yaw(g_cl)) * 3.0, y + 1.1,
                       z - cos(client_cam_yaw(g_cl)) * 3.0, 3.5);
    }
}

fn boot_game() {
    terrain_set(g_seed, 1.0);

    g_net = transport_loopback();
    g_sv = server_new(g_seed, g_net);
    g_cs = server_chunks(g_sv);
    g_cl = client_new(g_net, g_seed);
    g_acc = sim_accum_new();
    client_set_sens(g_cl, g_mouse_sens);
    client_bind_fx_cells(g_cl, FX_EMBER, FX_XP_MOTE, FX_GLOW_S, FX_GLOW_L,
                         FX_SPARK_0, FX_RAIN, FX_TRACER);

    // ---- THE HELD OBJECT IS THE LANTERN, NOT THE KESTREL. --------------
    // GAME_DESIGN §8 says "a Kestrel is in your hands", and the shipped art
    // says otherwise, on purpose and in writing: `meshgen.hml`'s
    // "THE LANTERN VIEWMODEL - the one the player actually holds" records that
    // four rounds of art work could not make a gun legible at 320x240 ("it read
    // first as a black lump and then as a chrome lump"), that slot 28's
    // `MESH_SPARROW_VM` is now an ALIAS of `MESH_LANTERN_VM`, and that a held
    // lantern is the diegetic light source CLAUDE.md §8's "something above
    // luminance 220 in every frame" was actually asking for. W4-10's cap box
    // and its 1215-pose probe were derived against that mesh's three drawn
    // normals; binding a gun instead pastes a differently-canted model into a
    // pose validated for another and puts a hole in it at the first kick.
    //
    // Verified by screenshot at 320x240: `--vm 2` with MESH_KESTREL_VM is an
    // unreadable grey lump in the lower right; with MESH_LANTERN_VM it is a
    // lantern. The GDD line is the older document and this is reported, not
    // silently reversed -- the weapon is still a Kestrel in every place that
    // matters (the ammo counter reads 6 / 12, the report is `SFX_KESTREL`, the
    // damage table is `WPN_KESTREL`); only the held prop differs.
    g_vm = vm_new();
    vm_bind_mesh(g_vm, meshgen_mesh(MESH_LANTERN_VM));
    vm_set_eye_height(g_vm, g_EYE_STAND);

    // W6: the dev tier flag, applied before the first tick so that the town
    // the player sees on frame 0 is the town they will be standing in.
    if (g_town_tier > 0) { server_settle_boot_tier(g_sv, g_town_tier); }
    if (g_at_town == 1) {
        let st0: object = server_settle(g_sv);
        let tcx: f64 = w6_settle_cx(st0);
        let tcz: f64 = w6_settle_cz(st0);
        server_teleport(g_sv, tcx + 46.0, tcz + 46.0);
        // ...and LOOK AT IT. A dev flag that puts the camera in the right
        // place facing the wrong way photographs a hillside.
        g_at_town_yaw = atan2(0.0 - 46.0, 46.0);
    }

    g_tick = server_t0(g_sv);
    g_camx = server_spawn_x(g_sv);
    g_camz = server_spawn_z(g_sv);
    g_camy = ground_h(g_camx, g_camz) + g_EYE_STAND;
    g_ground_y = ground_h(g_camx, g_camz);
    g_yaw_deg = server_spawn_yaw(g_sv) / g_D2R;
    // GAME_DESIGN §8 at 0:06: the lantern is the thing you are looking at when
    // you stand up. It is not found; it is handed to you.
    let byaw: f64 = server_spawn_yaw(g_sv);
    if (g_at_town_yaw < 1.0e29) { byaw = g_at_town_yaw; g_yaw_deg = byaw / g_D2R; }
    client_set_angles(g_cl, byaw, -0.04);

    // The world starts one tick in so the client has a snapshot to interpolate
    // from before the first frame is drawn: interpolating from nothing is a
    // frame of the player at the origin, and that frame is the first thing
    // anybody sees.
    server_tick(g_sv, g_tick);
    client_apply(g_cl, server_snapshot(g_sv), server_local(g_sv), g_tick);
    client_build_render(g_cl, 0.0);
    g_tick = g_tick + 1;
    g_day_t = client_day_t(g_cl);
}

fn shutdown() {
    if (g_in != null) { input_set_relative(g_in, 0); }
    if (g_audio_on == 1) { audio_shutdown(); }
    // The emit pool goes down FIRST, and before the render target it writes
    // into. It is a no-op when the stage ran serial. `emit_run` joins every
    // range before it returns, so by the time the loop has exited no task can
    // be in flight and this only has to retire idle workers.
    frame_par_shutdown();
    if (g_target != null) { target_free(g_target); g_target = null; }
    if (g_win != null) { window_close(g_win); g_win = null; }
}

fn controls_print() {
    print("");
    print("  ===================== NIGHTSHADE =====================");
    print(`  ${g_VERSION}`);
    print("");
    print("   MOVE      W A S D           SPRINT    hold SHIFT");
    print("   LOOK      mouse             JUMP      SPACE");
    print("   FIRE      left mouse / F    ADS       right mouse / Q");
    print("   RELOAD    R                 CROUCH    CTRL");
    print("   MELEE     V                 CAST      C");
    print("   WEAPON    1-8 / wheel        or B / N to cycle");
    print("             -- only the guns you OWN; buy them from a gunsmith");
    print("");
    print("   USE       hold E   -- light a lantern, or talk to whoever");
    print("                         is standing in front of you");
    print("   NEXT      X        -- next spell, or next row in a panel");
    print("   SHEET     TAB      -- the five stats; X moves, C spends,");
    print("                         TAB again closes it");
    print("   TRADE     T        -- what they will make for you; C takes,");
    print("                         T again closes it");
    print("");
    print("   HUD       H                 GUN       G");
    print("   SHOT      P                 QUIT      ESC");
    print("");
    print("   THE FIRST SIXTY SECONDS");
    print("     You wake on your back at dusk. Forty metres downhill there is");
    print("     an unlit lantern on a post -- the brightest thing you can see.");
    print("     Walk to it. Three Wisps will drift up on the way; they die to");
    print("     one shot each. Hold E at the post for two and a half seconds.");
    print("     Then the horn sounds, and they come up the hill.");
    print("");
    print("   AFTER THAT");
    print("     Lighting that lantern hands you the FLARE. Press C.");
    print("     The oil bar appears under your health and it is the second");
    print("     resource in the game -- it refills faster in the dark.");
    print("     When the revolver runs dry, V swings the club.");
    print("     Levels give you points; TAB spends them.");
    print("");
    print("     There is a settlement in the cell you woke up in. Walk to");
    print("     the diamond on the compass. Every lantern you light inside");
    print("     its ring raises CORE_LUX; enough of it, held for a whole");
    print("     in-game day, and the camp becomes a village and somebody");
    print("     moves in. Then E talks to them and T asks what they can make.");
    print("  ======================================================");
    print("");
}

// ===========================================================================
//  12.  THE LOOP  (ARCHITECTURE §3, verbatim in shape)
// ===========================================================================

fn read_input(p_dt: f64) {
    let inp = g_in;
    if (input_quit(inp)) { g_running = 0; }
    if (input_pressed(inp, SC_ESCAPE)) { g_running = 0; }

    if (g_relative_ok == 1) {
        client_look(g_cl, f64(input_mouse_dx(inp)), f64(input_mouse_dy(inp)));
    } else {
        // No relative mouse (headless, or a compositor that refused): the
        // arrow-free keyboard fallback, so the game is still playable and the
        // demo driver has a path in.
        let ky: f64 = 0.0;
        let kp: f64 = 0.0;
        if (input_down(inp, SC_L)) { ky = ky + 1.4; }
        if (input_down(inp, SC_M)) { ky = ky - 1.4; }
        if (ky != 0.0 || kp != 0.0) { client_look_axis(g_cl, ky * p_dt, kp * p_dt); }
    }

    let fwd: f64 = 0.0;
    let str: f64 = 0.0;
    if (input_down(inp, SC_W)) { fwd = fwd + 1.0; }
    if (input_down(inp, SC_S)) { fwd = fwd - 1.0; }
    if (input_down(inp, SC_D)) { str = str + 1.0; }
    if (input_down(inp, SC_A)) { str = str - 1.0; }
    client_set_move(g_cl, fwd, str);

    client_set_button(g_cl, BTN_SPRINT, b01(input_down(inp, SC_LSHIFT)));
    client_set_button(g_cl, BTN_CROUCH, b01(input_down(inp, SC_LCTRL)));
    client_set_button(g_cl, BTN_JUMP, b01(input_down(inp, SC_SPACE)));
    client_set_button(g_cl, BTN_USE, bkey(inp, SC_E));
    client_set_button(g_cl, BTN_MELEE, b01(input_down(inp, SC_V)));

    // ---- W6: the four spare bits ------------------------------------------
    // `bkey` is `down OR pressed`, and the OR is load-bearing: a key tapped
    // and released inside ONE frame is never `down` on a tick boundary, so a
    // 144 Hz display would drop menu presses that a 30 Hz one caught. The
    // server edge-detects on the bitfield, so a one-frame-wide held bit is
    // exactly equivalent to a press and costs nothing.
    //
    //   C   cast the spell in hand  /  confirm the highlighted row
    //   X   next spell              /  next row
    //   TAB the character sheet
    //   T   trade with whoever is standing in front of you
    client_set_button(g_cl, BTN_GRENADE, bkey(inp, SC_C));
    client_set_button(g_cl, BTN_SWITCH, bkey(inp, SC_X));
    client_set_button(g_cl, BTN_INV, bkey(inp, SC_TAB));
    client_set_button(g_cl, BTN_BUILD, bkey(inp, SC_T));

    let ads: i32 = 0;
    if (input_down(inp, SC_Q)) { ads = 1; }
    if (input_button(inp, INPUT_MB_RIGHT)) { ads = 1; }
    client_set_button(g_cl, BTN_ADS, ads);

    let fire: i32 = 0;
    if (input_down(inp, SC_F)) { fire = 1; }
    if (input_button(inp, INPUT_MB_LEFT)) { fire = 1; }
    client_set_button(g_cl, BTN_FIRE, fire);
    // THE FRAME-0 SHOT. `client_press_fire` gates itself on the client's own
    // rate-of-fire timer, so holding the trigger produces exactly one call per
    // shot regardless of frame rate.
    if (fire == 1) {
        if (client_press_fire(g_cl) == 1) { vm_fire(g_vm, 1.0); }
    }

    let rel: i32 = b01(input_pressed(inp, SC_R));
    client_set_button(g_cl, BTN_RELOAD, rel);
    if (rel == 1) {
        if (client_press_reload(g_cl) == 1) { vm_drop_mag(g_vm); }
    }

    // ---- W7-3: CHOOSING THE GUN -------------------------------------------
    // 1..8 are the eight `WPN_*` slots in id order, so the number key is the
    // weapon id and never a position in a list that moves as you buy things —
    // a slot that renumbers itself is the reason "I always press 2 for the
    // shotgun" stops being true. `client_select_weapon` refuses anything you
    // do not own, silently: a key that does nothing is correct feedback for a
    // gun you have never been given.
    //
    // The wheel cycles, because a wheel is what an FPS player's hand reaches
    // for, and B / N do the same for anyone without one (they are adjacent on
    // the keyboard in that order, which is the whole mnemonic). Both go
    // through the same `client_cycle_weapon`, so the two paths cannot drift.
    let pick: i32 = -1;
    if (input_pressed(inp, SC_1)) { pick = 0; }
    if (input_pressed(inp, SC_2)) { pick = 1; }
    if (input_pressed(inp, SC_3)) { pick = 2; }
    if (input_pressed(inp, SC_4)) { pick = 3; }
    if (input_pressed(inp, SC_5)) { pick = 4; }
    if (input_pressed(inp, SC_6)) { pick = 5; }
    if (input_pressed(inp, SC_7)) { pick = 6; }
    if (input_pressed(inp, SC_8)) { pick = 7; }
    if (pick >= 0) {
        if (client_select_weapon(g_cl, pick) == 1) { vm_drop_mag(g_vm); }
    }
    let cyc: i32 = 0;
    let wh: i32 = input_wheel(inp);
    if (wh > 0) { cyc = 1; }
    if (wh < 0) { cyc = -1; }
    if (input_pressed(inp, SC_N)) { cyc = 1; }
    if (input_pressed(inp, SC_B)) { cyc = -1; }
    if (cyc != 0) {
        // The stow-and-raise dip is the only feedback a swap has in the
        // viewmodel, and `vm_drop_mag` is the dip. It is cosmetic and local,
        // exactly like the muzzle flash: the server decides whether the swap
        // actually happens and the hands are allowed to be optimistic.
        if (client_cycle_weapon(g_cl, cyc) == 1) { vm_drop_mag(g_vm); }
    }

    if (input_pressed(inp, SC_H)) {
        g_hud_on = g_hud_on + 1;
        if (g_hud_on > 2) { g_hud_on = 0; }
    }
    if (input_pressed(inp, SC_G)) {
        g_vm_mode = g_vm_mode + 1;
        if (g_vm_mode > 2) { g_vm_mode = 0; }
    }
    if (input_pressed(inp, SC_P)) { shot_request("key"); }
}

fn b01(p_b: bool): i32 {
    let out: i32 = 0;
    if (p_b) { out = 1; }
    return out;
}

// A key that is HELD or was PRESSED this frame. See the W6 block in
// `read_input` for why the OR is not belt-and-braces.
fn bkey(p_inp, p_sc: i32): i32 {
    let out: i32 = 0;
    if (input_down(p_inp, p_sc)) { out = 1; }
    if (input_pressed(p_inp, p_sc)) { out = 1; }
    return out;
}

let g_running: i32 = 1;
let g_demo_s: f64 = 0.0;
let g_next_shot: f64 = 1.0e30;
let g_shot_every: f64 = 5.0;

// The headless/demo driver: walks to the lantern, lights it, and shoots at
// whatever is in front. It exists so the first 60 seconds can be RUN in CI, on
// the dummy driver, with no hands — which is the only way a 60-second scripted
// sequence ever gets tested more than once.
// W6. `--demo-ui`: during the demo, walk to the settlement and then OPEN BOTH
// MODAL PANELS on a timer. It exists to MEASURE them: the HUD triangle peak is
// the only number that proves the two panels fit under ART_BIBLE §9's 250 cap,
// and a panel nothing ever opens is a panel whose cost nobody has measured.
fn demo_ui_drive(p_t: f64, p_dt: f64): i32 {
    let st: object = server_settle(g_sv);
    // Steer at a NAMED VILLAGER, not at the green: the trade panel has to be
    // about somebody, and "walk to the middle and hope" put the measurement
    // 14 m short of anyone on the first attempt.
    //
    // >>> AND IT STEERS AT THE GUNSMITH SPECIFICALLY, WHICH IS NEW. <<<
    // "Nearest named villager" is not a person, it is an accident of the
    // settlement layout, and the accident was PIP: his stall is on the green
    // 6.4 m from the centre (`npc.hml` `g_npc_green_r`) while Mabel's Bench is
    // a Hall out on a road, so every `--demo-ui` run since this code was
    // written measured the trade loop against a child who sells an Almanac
    // that does not exist. That is why the run reported `trades 0 (1 refused)`
    // and why it would have gone on reporting it with a fully stocked
    // gunsmith. The panel exists to measure the TRADE LOOP, the trade loop is
    // DIRECTION.md §6.1's "you get the bolt-action FROM SOMEONE", and that
    // someone is Mabel. Nearest-named is kept as the fallback for the tier
    // where she has not arrived yet.
    let tgx: f64 = w6_settle_cx(st);
    let tgz: f64 = w6_settle_cz(st);
    let sto: object = server_npcs(g_sv);
    if (sto != null) {
        let nn: i32 = npc_count(sto);
        let bd: f64 = 1.0e30;
        let got: i32 = 0;
        for (let i = 0; i < nn; i++) {
            if (npc_slot_class(sto, i) != NPC_CLASS_NAMED) { continue; }
            let vx: f64 = npc_x(sto, st, i, g_tick);
            let vz: f64 = npc_z(sto, st, i, g_tick);
            if (npc_slot_who(sto, i) == NPC_MABEL) {
                tgx = vx; tgz = vz; got = 1;
                break;
            }
            let ex: f64 = vx - client_px(g_cl);
            let ez: f64 = vz - client_pz(g_cl);
            let dd: f64 = ex * ex + ez * ez;
            if (dd < bd) { bd = dd; tgx = vx; tgz = vz; }
        }
    }
    let bx: f64 = tgx - client_px(g_cl);
    let bz: f64 = tgz - client_pz(g_cl);
    let d: f64 = sqrt(bx * bx + bz * bz);
    let want: f64 = atan2(bx, 0.0 - bz);
    let dy: f64 = want - client_cam_yaw(g_cl);
    while (dy > 3.141592653589793) { dy = dy - 6.283185307179586; }
    while (dy < -3.141592653589793) { dy = dy + 6.283185307179586; }

    // Steer at whoever is nearest once we are on the green, so that the trade
    // panel has somebody to be about.
    if (d < 1.6) { client_set_move(g_cl, 0.0, 0.0); }
    else { client_set_move(g_cl, 1.0, 0.0); }
    client_look_axis(g_cl, clampf(dy * 4.0, -3.0, 3.0) * p_dt, 0.0);

    // THE TIMELINE, AND IT STARTS WHEN THE ROBOT ARRIVES, NOT WHEN THE CLOCK
    // SAYS. The first version ran off absolute time and the walk from the
    // `--at-town` drop point takes ~16 s, so every press landed while the
    // robot was still in the field and the run reported `talks 0` as though
    // talking were broken. Relative-to-arrival is the only honest clock here.
    if (g_demo_ui_t0 > 1.0e29) {
        if (client_talk_prompt(g_cl) == 1) { g_demo_ui_t0 = p_t; }
    }
    if (g_demo_ui_t0 > 1.0e29) {
        client_set_button(g_cl, BTN_INV, 0);
        client_set_button(g_cl, BTN_BUILD, 0);
        client_set_button(g_cl, BTN_USE, 0);
        client_set_button(g_cl, BTN_SWITCH, 0);
        client_set_button(g_cl, BTN_GRENADE, 0);
        client_set_button(g_cl, BTN_MELEE, 0);
        let waiting: i32 = 0;
        return waiting;
    }
    let ut: f64 = p_t - g_demo_ui_t0 + 6.0;
    let inv: i32 = 0;
    let bld: i32 = 0;
    let use: i32 = 0;
    let sw: i32 = 0;
    let cf: i32 = 0;
    let mel: i32 = 0;
    // THE SCHEDULE IS 6 s TIGHTER THAN IT WAS AND IT CONFIRMS TWICE.  Steering
    // at Mabel rather than at whoever happens to be nearest adds about four
    // seconds of walking, and the old schedule spent its last press at
    // ut 21.2 -- which ran off the end of a 30 s `--demo` and reported
    // `TRADE peak 0` as though the panel were broken.  Gaps went 0.6 -> 0.5 s
    // and 0.2 s windows are 12 frames at 60 Hz, so every press is still many
    // frames wide.
    //
    // TWO CONFIRMS, ON PURPOSE.  The first is pressed the moment the panel
    // opens, on the row the cursor opens on -- which `sv_ui_tick` guarantees
    // is the first row you can actually take, and for the gunsmith at a
    // Village that is row 0, THE BOLT-ACTION.  The second is pressed after
    // five cursor moves, which is the brass.  A gun and its ammunition, from
    // the person DIRECTION.md §6.1 says you get them from, inside 30 seconds.
    if (ut > 6.0 && ut < 6.2)   { cf = 1; }        // cast (refused: no spell yet)
    // TALK ON ARRIVAL, NOT ON THE CLOCK. The first version pressed USE at a
    // fixed 12.0 s and the walk was still four metres short, so `talks` read 0
    // and looked like a broken feature rather than a mistimed robot.
    if (ut > 6.5 && ut < 7.3)   { use = 1; }       // talk
    if (ut > 7.6 && ut < 7.8)   { mel = 1; }       // swing the club
    if (ut > 8.1 && ut < 8.3)   { inv = 1; }       // open the sheet
    if (ut > 8.6 && ut < 8.8)   { sw = 1; }        // next stat
    if (ut > 9.1 && ut < 9.3)   { cf = 1; }        // spend
    if (ut > 9.6 && ut < 9.8)   { inv = 1; }       // close it
    if (ut > 10.1 && ut < 10.3) { bld = 1; }       // open the trade panel
    if (ut > 10.6 && ut < 10.8) { cf = 1; }        // TAKE THE BOLT-ACTION
    if (ut > 11.1 && ut < 11.3) { sw = 1; }        // next row
    if (ut > 11.6 && ut < 11.8) { sw = 1; }
    if (ut > 12.1 && ut < 12.3) { sw = 1; }
    if (ut > 12.6 && ut < 12.8) { sw = 1; }
    if (ut > 13.1 && ut < 13.3) { sw = 1; }
    if (ut > 13.6 && ut < 13.8) { cf = 1; }        // TAKE THE BRASS
    if (ut > 14.1 && ut < 14.3) { bld = 1; }       // close
    client_set_button(g_cl, BTN_INV, inv);
    client_set_button(g_cl, BTN_BUILD, bld);
    client_set_button(g_cl, BTN_USE, use);
    client_set_button(g_cl, BTN_SWITCH, sw);
    client_set_button(g_cl, BTN_GRENADE, cf);
    client_set_button(g_cl, BTN_MELEE, mel);
    let ok: i32 = 1;
    return ok;
}

// ---------------------------------------------------------------------------
//  THE DEMO PLAYER.  The policy is in `src/game/demobot.hml`; this is the wire.
// ---------------------------------------------------------------------------
//  WHAT THIS FUNCTION USED TO BE, AND WHY IT IS NOW SIX LINES.
//
//  It used to hold its own ~60-line driver: yaw only (`client_look_axis(g_cl,
//  dy, 0.0)` — the pitch argument was a hard zero on every call), hip fire
//  inside 26 m, no iron sights, a reload pressed only once the LYING HUD read
//  empty, and `client_set_move(g_cl, -1.0, 0.4)` whenever anything came inside
//  5 m — with nothing anywhere that ever walked back.
//
//  That last clause is the one that mattered. During a wave something is
//  almost always inside 5 m, so this function reversed out of the lantern's
//  supply radius and stayed out, finishing 100-223 m from the post having
//  spent 55-66 of its 90 seconds in the dark where `sv_lantern_supply` pays
//  nothing. MEASURED over 12 seeds (`tools/probe_firstminute.hml`): the
//  lantern handed this driver 132 rounds and handed the reference player 900.
//  It ended `ammo 0/1` with `10 alive` and stopped at beat WAVE on every seed
//  — at f4644f7 AND at 112b038, whose own commit message says the first minute
//  is winnable on 10 of 12. Both statements were true. They were made with two
//  different bots, and this was the one that could not play.
//
//  So there is one bot now, in one file, and the probe imports THAT FILE
//  rather than a copy of it. ARM 5 (probe_waveone's bot) and ARM 6 (the module
//  below) are asserted to clear the same seeds AND fire the same number of
//  rounds, so the two can no longer drift apart in silence.
//
//  What stays here is only what is genuinely presentation or genuinely this
//  file's: the viewmodel hands, and the Flare.
// ---------------------------------------------------------------------------
fn demo_drive(p_t: f64, p_dt: f64) {
    if (g_demo_ui == 1) { demo_ui_drive(p_t, p_dt); return; }
    if (g_demobot == null) { g_demobot = demobot_new(g_cl, g_sv); }

    demobot_frame(g_demobot, client_px(g_cl), client_pz(g_cl));

    // The hands. `demobot_frame` reports the two edges it just crossed --
    // a shot the AUTHORITY counted, and a reload that just started -- so the
    // muzzle rise and the magazine drop stay on exactly the frames they used
    // to, without the driver needing to know a viewmodel exists.
    if (demobot_fired(g_demobot) == 1) { vm_fire(g_vm, 1.0); }
    if (demobot_reloaded(g_demobot) == 1) { vm_drop_mag(g_vm); }

    // W6. The robot uses what the lantern gave it. Once the Flare is in hand it
    // throws one every two seconds -- which is what puts the spell school, its
    // oil cost and its twelve FX cells inside the ONE headless run that every
    // gate uses. Unchanged, and deliberately left OUT of demobot.hml: it is not
    // part of the policy the acceptance bar was measured with, and moving it
    // there would have changed ARM 6's numbers for a cosmetic reason.
    let cast: i32 = 0;
    if (client_lantern_lit(g_cl) != 0) {
        if (client_spell_have(g_cl) != 0 && client_spell_id(g_cl) >= 0) {
            if (client_spell_cd01(g_cl) <= 0.0 && client_oil01(g_cl) > 0.25) {
                if (p_t - g_demo_cast_t > 2.0) { cast = 1; g_demo_cast_t = p_t; }
            }
        }
    }
    client_set_button(g_cl, BTN_GRENADE, cast);
    client_set_button(g_cl, BTN_MELEE, 0);
}

fn framebuffer_to_rgb(): buffer {
    let w: i32 = g_RES_W;
    let h: i32 = g_RES_H;
    let out: buffer = buffer(w * h * 3);
    let op: ptr = buffer_ptr(out);
    for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
            let si: i32 = (y * w + x) * 4;
            let di: i32 = (y * w + x) * 3;
            ptr_write_u8(ptr_offset(op, di, 1), ptr_deref_u8(ptr_offset(g_fb, si + 2, 1)));
            ptr_write_u8(ptr_offset(op, di + 1, 1), ptr_deref_u8(ptr_offset(g_fb, si + 1, 1)));
            ptr_write_u8(ptr_offset(op, di + 2, 1), ptr_deref_u8(ptr_offset(g_fb, si, 1)));
        }
    }
    let r: buffer = out;
    return r;
}

// ---------------------------------------------------------------------------
// A SCREENSHOT IS TWO HALVES, BECAUSE THE READBACK IS OPT-IN AND OFF BY DEFAULT.
// ---------------------------------------------------------------------------
// `read_pixels_rect` used to run inside every `frame_present()`, which meant THE
// GAME paid it 60 times a second for pixels nothing in this file read unless P
// was pressed. Measured (BUDGET_ACTUAL.md §T.10): 0.205 ms/frame of real saving
// on the accelerated renderer — 0.4 ms end-to-end on `--demo 15`, and the worst
// frame of that demo fell 17.0 -> 15.3 ms — and ZERO on the software one, where
// the 2.47 ms simply moves into `target_present`. It is now `frame_set_capture`
// (world_render.hml stage 25b) and the game arms it for exactly one frame:
//
//     shot_request(tag)   before frame_once()  -> arm
//     shot_flush()        after  frame_once()  -> write the PNG, disarm
//
// Both halves run in the same loop iteration, so the PNG is the frame the key
// was pressed on. The old code called the writer straight out of `read_input`,
// which runs BEFORE the frame, so it actually wrote the previous frame's pixels.
let g_shot_pending: i32 = 0;
let g_shot_tag: string = "";

fn shot_request(p_tag: string) {
    if (g_shot_dir.length == 0) { return; }
    g_shot_pending = 1;
    g_shot_tag = p_tag;
    frame_set_capture(1);
}

fn shot_flush() {
    if (g_shot_pending == 0) { return; }
    g_shot_pending = 0;
    frame_set_capture(0);
    let img: buffer = framebuffer_to_rgb();
    let path: string = `${g_shot_dir}/ns_${g_shot_seq}_${g_shot_tag}.png`;
    write_png(path, img, g_RES_W, g_RES_H);
    print(`nightshade: wrote ${path}  tri ${stat_get(STAT_TRIS_DRAWN)}/${stat_get(STAT_TRIS_SUBMITTED)}  hud ${g_hud_tris}  vm ${g_vm_tris}  dc ${stat_get(STAT_DRAW_CALLS)}  beat ${server_beat_name(server_beat(g_sv))}  pos ${i32(client_px(g_cl))},${i32(client_pz(g_cl))}  d ${i32(client_lantern_dist(g_cl))}  hp ${client_hp(g_cl)} ammo ${client_ammo(g_cl)}/${client_reserve(g_cl)} rl ${f1(client_reloading(g_cl))} alive ${client_alive(g_cl)} ctl ${client_has_control(g_cl)} fog ${i32(g_fog_far)} h ${f1(tod_clock_hours(g_day_t))} camy ${f1(g_camy)} gy ${f1(g_ground_y)} p ${i32(g_pitch_deg)}`);
    g_shot_seq++;
}

fn run_loop() {
    controls_print();

    // Prime the sky and the ring OUTSIDE the loop. The first rebuild meshes the
    // whole ring in one pass — walk.hml measured 129 ms — and a 129 ms frame
    // one frame in poisons every average that follows it.
    tod_step();
    sky_now();
    world_rebuild(0.016, 0.0);
    bake_step();

    let t: f64 = 0.0;
    let loop_t0: u64 = clock_now();
    let prev: u64 = clock_now();
    let ms_n: i32 = 0;
    let ms_acc: f64 = 0.0;
    let ms_worst: f64 = 0.0;
    let wall_acc: f64 = 0.0;
    let over: i32 = 0;
    let tri_peak: i32 = 0;
    let hud_peak: i32 = 0;
    let vm_peak: i32 = 0;
    let sim_worst: f64 = 0.0;
    let body_acc: f64 = 0.0;
    let sim_acc2: f64 = 0.0;
    let pre_acc: f64 = 0.0;

    // RULE T (CLAUDE.md §1.2): __clock() CPU time, batched in sevens, minimum
    // batch reported. Wall time is reported too, because 60 fps is a wall-clock
    // promise and the reader needs both to tell a slow renderer from a busy box.
    let cpu_batch: f64 = 0.0;
    let cpu_bn: i32 = 0;
    let cpu_min: f64 = 1.0e30;
    let cpu_acc: f64 = 0.0;

    let hud_at: f64 = -1.0;

    while (g_running == 1) {
        let top: u64 = clock_now();
        let frame_ms: f64 = clock_ms_between(prev, top);
        prev = top;
        let dt: f64 = frame_ms * 0.001;
        if (dt > 0.25) { dt = 0.25; }
        if (dt <= 0.0) { dt = 0.0001; }
        t = t + dt;

        // -- 1  input_sample: EVERY frame, before the tick loop -------------
        input_sample(g_in, g_win);
        if (g_demo_s > 0.0) {
            demo_drive(t, dt);
            if (input_quit(g_in)) { g_running = 0; }
            if (t >= g_demo_s) { g_running = 0; }
        } else {
            read_input(dt);
        }

        // -- 2..3  the fixed-timestep tick loop: 0, 1 or N times ------------
        let sim0: f64 = __clock();
        let n: i32 = sim_accum_advance(g_acc, frame_ms);
        let i: i32 = 0;
        while (i < n) {
            client_send_command(g_cl, g_tick);
            server_tick(g_sv, g_tick);
            client_apply(g_cl, server_snapshot(g_sv), server_local(g_sv), g_tick);
            g_tick++;
            i++;
        }
        let sim_ms: f64 = (__clock() - sim0) * 1000.0;
        sim_acc2 = sim_acc2 + sim_ms;
        g_sim_ms = sim_ms;
        if (sim_ms > sim_worst) { sim_worst = sim_ms; }

        pre_acc = pre_acc + clock_ms_between(top, clock_now());
        // -- 4  the interpolated render snapshot ---------------------------
        let alpha: f64 = sim_accum_alpha(g_acc);
        client_frame(g_cl, dt, g_tick);
        client_build_render(g_cl, alpha);

        // The camera the picture uses: position from the AUTHORITATIVE
        // interpolated snapshot, angles from the LOCAL view.
        g_camx = client_cam_x(g_cl);
        g_camy = client_cam_y(g_cl);
        g_camz = client_cam_z(g_cl);
        g_yaw_deg = client_cam_yaw(g_cl) / g_D2R;
        g_pitch_deg = client_cam_pitch(g_cl) / g_D2R;
        g_fov = client_cam_fov(g_cl);
        g_day_t = client_day_t(g_cl);
        g_ground_y = client_py(g_cl);

        // The viewmodel is driven by REAL weapon state, read only.
        vm_set_motion(g_vm, client_speed(g_cl), client_grounded(g_cl),
                      b01(client_speed(g_cl) > 5.6), client_step_dist(g_cl));
        vm_step(g_vm, dt);
        if (vm_take_clack(g_vm) == 1) { }
        audio_drain();

        // The `--shots` timer arms the readback BEFORE the frame and the PNG is
        // written after it, so the image and its stats line describe the same
        // frame they always did.
        if (g_shot_dir.length > 0 && t >= g_next_shot) {
            shot_request(`t${i32(t)}`);
            g_next_shot = g_next_shot + g_shot_every;
        }

        // -- 5..28  the frame ----------------------------------------------
        let cpu0: f64 = __clock();
        frame_once(dt, t);
        let cpu_ms: f64 = (__clock() - cpu0) * 1000.0;
        // Outside the bracket: the PNG encode is not frame cost. The readback
        // itself is inside, because on a capture frame it really is part of that
        // frame — and RULE T's min-of-7 discards the one slow batch.
        shot_flush();
        cpu_acc = cpu_acc + cpu_ms;
        cpu_batch = cpu_batch + cpu_ms;
        cpu_bn++;
        if (cpu_bn == 7) {
            let b: f64 = cpu_batch / 7.0;
            if (b < cpu_min) { cpu_min = b; }
            cpu_batch = 0.0;
            cpu_bn = 0;
        }

        g_frame_ms = stat_ms(STAT_T_FRAME);
        ms_acc = ms_acc + g_frame_ms;
        ms_n++;
        if (g_frame_ms > ms_worst) { ms_worst = g_frame_ms; }
        if (g_frame_ms > g_FRAME_BUDGET_MS) { over++; }
        let tri: i32 = stat_get(STAT_TRIS_DRAWN);
        if (tri > tri_peak) { tri_peak = tri; }
        if (g_hud_tris > hud_peak) { hud_peak = g_hud_tris; }
        g_st_tri_peak = tri_peak;
        g_st_hud_peak = hud_peak;
        if (g_frame_ms > g_st_worst_ms) { g_st_worst_ms = g_frame_ms; }
        if (g_vm_tris > vm_peak) { vm_peak = g_vm_tris; }

        if (t > hud_at + 0.25) { hud_strings(); hud_at = t; }

        // The 60 fps pace. vsync does it on a real display; this keeps the
        // dummy driver from spinning a core and keeps the pace honest when
        // vsync is unavailable. SDL_Delay overshoots under load, so sleep to
        // 2 ms short and spin the rest.
        // ---- THE PACE, AND WHY THE SLEEP MARGIN IS FOUR MILLISECONDS ----
        // vsync does this on a real display; the spin is what stops the dummy
        // driver spinning a core at 900 fps and what keeps the pace honest when
        // vsync is unavailable. `clock_sleep_ms` is SDL_Delay, whose
        // granularity is 1-2 ms and which OVERSHOOTS under load in proportion
        // to how long you ask for.
        //
        // MEASURED on this box (17 of 24 cores busy), 20 s demo on DISPLAY=:0:
        //   sleep to 2 ms short : 1187 frames / 24 s -> 49.5 fps, mean 20.9 ms
        //   sleep to 4 ms short : see the report
        // `tools/walk.hml` uses a 2 ms margin and holds 59.9 fps because its
        // frame is 9 ms and it therefore only ever asks for ~5 ms of sleep;
        // this loop's frame is 7 ms, asks for ~8, and eats a proportionally
        // bigger overshoot. The margin is the fix, not the frame.
        // ---- THE PACE, AND WHY THE SLEEP IS IN ONE-MILLISECOND SLICES ----
        // vsync paces this on a real display; the sleep-and-spin is what stops
        // the dummy driver spinning a core at 900 fps and what keeps the pace
        // honest when vsync is unavailable.
        //
        // `clock_sleep_ms` is SDL_Delay, and on a box sharing 17 of 24 cores it
        // OVERSHOOTS IN PROPORTION TO THE REQUEST. MEASURED, 12 s demo on
        // DISPLAY=:0: the frame body is bimodal (2 ms when SDL's event pump
        // returns immediately, ~13 ms when it waits on the compositor), so one
        // `SDL_Delay(10)` on every fast frame overshot to a 23.7 ms mean frame
        // -- 42 fps out of a 6 ms renderer. `tools/walk.hml` never hit it
        // because its 9 ms frame never asks for more than ~5 ms of sleep.
        //
        // One-millisecond slices bound the overshoot to one granule instead of
        // the whole request, and the deadline is re-read every slice so a slice
        // that overshoots simply ends the loop.
        // ---- THE PACE ----------------------------------------------------
        // WITH VSYNC THERE IS NOTHING TO DO. `SDL_RenderPresent` blocks for the
        // flip and the next frame's event pump finishes the wait, so the loop
        // is already on the refresh. Pacing it AGAIN is not belt-and-braces, it
        // is a bug: the extra spin pushes the frame past the next vblank and
        // the display hands back a whole interval. MEASURED on DISPLAY=:0, a
        // 12 s demo with a 6.2 ms renderer:
        //     spin to 16.67 on top of vsync : 707 frames / 15.7 s -> 45 fps
        //     vsync alone                   : see the report
        // The sleep-and-spin therefore runs ONLY when vsync was refused --
        // the dummy driver in CI, or a software renderer -- where it is what
        // stops the loop burning a core at 900 fps. `clock_sleep_ms` is
        // SDL_Delay and overshoots in proportion to the request on a loaded
        // box, so it is asked for one millisecond at a time.
        let spent: f64 = clock_ms_between(top, clock_now());
        body_acc = body_acc + spent;
        if (g_vsync == 0) {
            while (clock_ms_between(top, clock_now()) < g_FRAME_BUDGET_MS - 2.0) {
                clock_sleep_ms(1);
            }
            while (clock_ms_between(top, clock_now()) < g_FRAME_BUDGET_MS) { }
        }
        g_wall_ms = clock_ms_between(top, clock_now());
        wall_acc = wall_acc + g_wall_ms;
        if (g_wall_ms > 0.01) { g_fps = 1000.0 / g_wall_ms; }
    }

    let loop_ms: f64 = clock_ms_between(loop_t0, clock_now());
    if (ms_n > 0) {
        let n2: f64 = f64(ms_n);
        print("");
        print(`nightshade: ${ms_n} frames in ${f1(t)} s`);
        print(`   render, wall (STAT_T_FRAME)  mean ${f1(ms_acc / n2)} ms  worst ${f1(ms_worst)} ms`);
        print(`   render, CPU  (RULE T, min of 7-frame batches)  ${f1(cpu_min)} ms`);
        print(`   headroom at 60 fps: ${f1(16.667 - cpu_min)} ms/frame on the CPU-time number`);
        // The honest frame rate: frames divided by the loop's OWN elapsed
        // wall time. `t` above is a sum of per-frame deltas CLAMPED at 250 ms,
        // which is the right input for the accumulator and the wrong input for
        // a frame-rate claim -- one clamped stall silently shortens it.
        print(`   whole frame  mean ${f1(loop_ms / n2)} ms -> ${f1(1000.0 * n2 / loop_ms)} fps  (${ms_n} frames in ${f1(loop_ms / 1000.0)} s of loop)`);
        print(`   frames over 16.67 ms: ${over} of ${ms_n}`);
        print(`   where the frame goes, mean: input+tick ${f1(pre_acc / n2)} ms (sim CPU ${f1(sim_acc2 / n2)})  render ${f1(ms_acc / n2)}  body ${f1(body_acc / n2)}`);
        // The emit stage is 82-88 % of the render frame, so this line is the
        // one to read next to the two above. 0 == serial.
        //
        // AND READ THE WALL NUMBER, NOT THE CPU ONE. `__clock()` is CPU time
        // and SUMS ACROSS THREADS (CLAUDE.md rule T), so with the pool on it
        // counts every worker's share and will look WORSE than serial while the
        // frame gets faster. "render, wall" and "whole frame" above are the
        // honest comparison; "render, CPU" is the efficiency column.
        print(`   parallel emit: ${g_emit_workers} workers (0 = serial; --workers N to change, config g_EMIT_WORKERS = ${g_EMIT_WORKERS})`);
        print(`   triangles: PEAK ${tri_peak} of ${g_TRIS_STEADY}   HUD peak ${hud_peak} of ${g_HUD_TRI_CAP}   viewmodel peak ${vm_peak}`);
        print(`   sim+net: worst ${f1(sim_worst)} ms of the ${f1(g_BUDGET_SIM_MS)} ms budget   ticks ${g_tick - server_t0(g_sv)}`);
        print(`   stalls ${sim_accum_stalls(g_acc)}  forgiven ${sim_accum_forgiven(g_acc)}  cmds ${client_cmds_sent(g_cl)}  packets ${client_packets(g_cl)}  decode-fail ${client_decode_fail(g_cl)}`);
        print(`   beat reached: ${server_beat_name(server_beat(g_sv))}   lantern ${server_lantern_lit(g_sv)}   path ${server_path_lit(g_sv)}   sounds ${client_sounds_total(g_cl)}`);
        print(`   unlock card: ${g_hud_card_trunc} truncated frames (MUST be 0)   HUD peak ${hud_peak} of ${g_HUD_TRI_CAP}`);
        // W6. The four numbers that say whether the ten systems reached the
        // player, rather than merely compiling.
        print(`   W6 town: ${client_settle_tier_name(client_settle_tier(g_cl))} lux ${client_settle_core(g_cl)}/${client_settle_core_need(g_cl)}  pts ${client_settle_pts(g_cl)}/${client_settle_pts_need(g_cl)}  buildings ${client_settle_buildings(g_cl)}  villagers ${client_npc_count(g_cl)} (${client_npc_named(g_cl)} named)`);
        print(`   W6 draw: settlement PEAK ${g_settle_tris_peak} tris, villagers PEAK ${g_villagers_peak} drawn, town mesh library ${g_hub_tris} tris in ${hubgen_mesh_count()} meshes`);
        print(`   W6 spellfx: bound ${fx_spell_bound()}, live ${fx_spell_live()}, sprites this frame ${g_spellfx_sprites}, peak ${g_spellfx_peak}`);
        print(`   W6 hand: melee ${client_mel_wpn(g_cl)}  spells granted ${client_spell_have(g_cl)}  casts ${client_spell_casts(g_cl)}  oil ${i32(client_oil(g_cl))}/${i32(client_oil_tank(g_cl))}  points ${client_points(g_cl)} unspent`);
        print(`   W6 panels: CHARACTER peak ${g_panel_char_peak} tris, TRADE peak ${g_panel_trade_peak} tris, cap ${g_HUD_TRI_CAP}, open on ${g_panel_frames} frames, ${g_panel_trunc} truncated strings (MUST be 0)`);
        print(`   W6 talk: target ${client_talk_who(g_cl)} at ${i32(client_talk_dist(g_cl))} m, topic ${client_talk_topic(g_cl)}, open offers mask ${client_talk_offers(g_cl)}, last panel message '${client_ui_msg_text(client_ui_msg(g_cl))}'`);
        print(`   W6 acts: swings ${client_mel_swings(g_cl)}  talks ${server_talks(g_sv)}  trades ${server_trades(g_sv)} (${server_trades_refused(g_sv)} refused)  points spent ${server_points_spent(g_sv)}  lanterns fed ${server_lan_count(g_sv)}`);
        // >>> W7-3. THE LINE THE GATE COULD NOT READ BEFORE. <<< A run that
        // prints `trades 2` and nothing else cannot tell you whether you are
        // still holding what you bought. This one names the gun in your hands
        // at the END of the run, how many you own, and how many times the
        // authority had to force a selection on the client. `held` is the
        // server's, `asking` is the client's: when they agree at the end of a
        // 30 s run, the loop closed.
        print(`   W7 hands: held ${client_weapon_name(server_weapon(g_sv))} (${server_weapon(g_sv)})  asking ${client_weapon_name(client_in_weapon(g_cl))} (${client_in_weapon(g_cl)})  own ${server_own_count(g_sv)} mask ${server_own_mask(g_sv)}  grants ${server_force_n(g_sv)}  adopted ${client_forced(g_cl)}  denied ${sim_stat_swaps_denied(server_world(g_sv))}`);
    }
}

// ===========================================================================
//  13.  CLI
// ===========================================================================

fn is_number(p_s: string): bool {
    let s: string = p_s;
    if (s.length == 0) { return false; }
    let seen: i32 = 0;
    for (let i = 0; i < s.length; i++) {
        let c: string = s.slice(i, i + 1);
        if (c == "-" || c == "+") {
            if (i != 0) { return false; }
        } else if (c == ".") {
        } else if (c >= "0" && c <= "9") {
            seen = seen + 1;
        } else {
            return false;
        }
    }
    let out: bool = seen > 0;
    return out;
}

fn num_or(p_s: string, p_def: f64): f64 {
    if (!is_number(p_s)) { let d: f64 = p_def; return d; }
    let out: f64 = f64(p_s);
    return out;
}

fn usage() {
    print("nightshade [options]");
    print("  --seed <n>        world seed (default 1337)");
    print("  --scale <2|3|4>   integer upscale (default 3)");
    print("  --sens <f>        mouse sensitivity multiplier");
    print("  --demo <s>        run the scripted first-60-seconds, hands off");
    print("  --shots <dir>     write a PNG every 5 s (with --demo)");
    print("  --vm <0|1|2>      viewmodel: off / frame-graph static / driven");
    print("  --no-audio        do not open an audio device");
    print("  --headless        SDL_VIDEODRIVER=dummy is expected; no mouse grab");
    print("  --workers <0..12> parallel emit workers (default from config: 8).");
    print("                    0 or 1 = serial, which is byte-identical output");
    print("                    and the no-threads path. Clamped to 12.");
    print("  --selftest        headless smoke test; exits 0 on pass");
    print("  --at-town         DEV: start standing in the settlement");
    print("  --demo-ui         DEV: with --demo, open both modal panels on a");
    print("                    timer so their triangle cost is MEASURED");
    print("  --town <0..3>     DEV: boot the settlement at CAMP/VILLAGE/TOWN/CITY.");
    print("                    The honest path is CORE_LUX 512 + 10 grid points");
    print("                    held for one whole in-game day; this skips it so");
    print("                    the trade panel can be reached inside a session.");
}

let g_no_audio: i32 = 0;
let g_selftest: i32 = 0;
// `--workers N`. -1 means "no flag", i.e. take `g_EMIT_WORKERS` from
// src/core/config.hml. 0 and 1 both mean SERIAL, which is a supported
// configuration and the WASM/single-core path, not a failure. Anything above
// EMIT_PAR_MAX (12) is clamped by the engine.
//
// This flag exists so the pool can be measured against itself in the real game
// on the real box -- `--workers 0` vs `--workers 8` on the same binary, same
// seed, same demo -- which is the only before/after that is worth anything.
let g_workers: i32 = -1;
let g_emit_workers: i32 = 0;    // what `emit.hml` actually brought up
// `--town N`. A DEV FLAG, and `server_settle_boot_tier`'s header says exactly
// why it has to exist and exactly what it does not do.
let g_town_tier: i32 = 0;
let g_at_town: i32 = 0;      // DEV: wake up on the green instead of the ridge
let g_at_town_yaw: f64 = 1.0e30;
let g_demo_ui: i32 = 0;
let g_demo_ui_t0: f64 = 1.0e30;

// ---------------------------------------------------------------------------
// THE SHELL'S SMOKE TEST.  `tools/probe_game.hml` is the acceptance harness —
// 81 assertions over the loop, the wire, the latency modes and the sixty
// seconds, headless and with no SDL linked. It cannot test THIS file, because
// this file needs a window. So `--selftest` asserts the things only a booted
// shell can know: that the assets came up, that the frame graph produced a
// frame inside its budget, that the HUD stayed under its cap, and that the
// picture and the simulation agree about where the ground is.
//
// Exit status is the contract: 0 iff every assertion passed AND the expected
// NUMBER of assertions ran.
let g_ST_EXPECT: i32 = 25;   // 12 from W4-11, +7 W6, +2 emit pool, +4 W7-3
let g_st_n: i32 = 0;
let g_st_ok: i32 = 0;
let g_st_tri_peak: i32 = 0;
let g_st_hud_peak: i32 = 0;
let g_st_worst_ms: f64 = 0.0;

fn stck(p_ok: bool, p_msg: string) {
    g_st_n = g_st_n + 1;
    if (p_ok) { g_st_ok = g_st_ok + 1; }
    if (!p_ok) { print(`  FAIL [${g_st_n}] ${p_msg}`); }
}

fn selftest_report(): i32 {
    print("");
    print("nightshade --selftest");

    stck(assets_texture_count() == 4,
         `exactly FOUR SDL textures exist after boot (a fifth is a bug); got ${assets_texture_count()}`);
    stck(assets_error() == 0, `the asset boot reported no error; got ${assets_error()}`);
    stck(g_frames > 100, `the loop ran real frames; got ${g_frames}`);
    stck(g_st_tri_peak > 200,
         `the world actually drew: peak ${g_st_tri_peak} triangles`);
    stck(g_st_tri_peak <= g_TRIS_STEADY,
         `peak triangles ${g_st_tri_peak} <= the ${g_TRIS_STEADY} budget`);
    stck(g_st_hud_peak <= g_HUD_TRI_CAP,
         `peak HUD triangles ${g_st_hud_peak} <= the ${g_HUD_TRI_CAP} cap`);
    stck(g_st_worst_ms < 33.4,
         `no frame took two vsync intervals: worst ${f1(g_st_worst_ms)} ms`);

    // The picture and the simulation must agree about the ground. This is the
    // assertion the first build of this file would have failed: `world_render`
    // exports a `terrain_h` of its own, and building the visible terrain from
    // it puts the player's feet at one height and the floor at another.
    let px: f64 = client_px(g_cl);
    let pz: f64 = client_pz(g_cl);
    let dh: f64 = absf(ground_h(px, pz) - client_py(g_cl));
    stck(dh < 0.35,
         `the visible ground is the ground the sim stands on at the player: ${f1(dh)} m apart`);

    stck(client_decode_fail(g_cl) == 0,
         `every snapshot decoded: ${client_packets(g_cl)} packets, ${client_decode_fail(g_cl)} failures`);
    stck(client_cmds_sent(g_cl) > 100,
         `commands reached the wire: ${client_cmds_sent(g_cl)}`);
    stck(server_beat(g_sv) >= SV_BEAT_STAND,
         `the opening sequence advanced past WAKE: ${server_beat_name(server_beat(g_sv))}`);
    // GAME_DESIGN §8 at 0:30. This is 0 in the 3 s selftest window because the
    // card has not been earned yet, and that is stated rather than dressed up:
    // the assertion has teeth on `--demo 40` and up, where the card is drawn,
    // and it is what a future budget regression trips over. The measurement that
    // closed the defect is in the g_TB_CARD comment.
    stck(g_hud_card_trunc == 0,
         `the unlock card was never truncated: ${g_hud_card_trunc} frames dropped glyphs`);

    // ---- W6. THE TEN SYSTEMS ARE REACHABLE, AND THEY COST WHAT THEY SAY ----
    // These have teeth in the 3 s window: the stores are constructed at boot
    // and the town emits from frame 0. The two that need a longer run
    // (`--demo-ui`) say so in their own message, exactly like the card above.
    stck(server_settle(g_sv) != null && server_npcs(g_sv) != null,
         "the settlement and its roster exist");
    stck(server_lan_count(g_sv) >= 1,
         `the lantern feed reaches the settlement: ${server_lan_count(g_sv)} lanterns`);
    stck(client_mel_wpn(g_cl) >= 0,
         `a melee weapon is in the off hand at spawn: id ${client_mel_wpn(g_cl)}`);
    stck(client_oil_tank(g_cl) > 0.0,
         `the spell tank exists: ${i32(client_oil(g_cl))} / ${i32(client_oil_tank(g_cl))} oil`);
    stck(g_hub_tris > 0 && hubgen_mesh_count() > 0,
         `the settlement mesh library was built: ${g_hub_tris} tris in ${hubgen_mesh_count()} meshes`);
    // THE PANEL BUDGET. ART_BIBLE §9's cap is a HARD cap and a modal panel is
    // the biggest single thing the HUD ever draws. 0 on a run that never opens
    // one; measured at 212 / 204 under `--demo-ui`, and the truncation counter
    // is the regression signal the unlock card taught us to add.
    stck(g_panel_char_peak <= g_HUD_TRI_CAP && g_panel_trade_peak <= g_HUD_TRI_CAP,
         `both modal panels fit the ${g_HUD_TRI_CAP} cap: CHARACTER ${g_panel_char_peak}, TRADE ${g_panel_trade_peak}`);
    stck(g_panel_trunc == 0,
         `no panel string was truncated: ${g_panel_trunc} dropped glyphs`);

    // ---- W7-3. YOU ARE HOLDING SOMETHING YOU OWN, AND YOU ASKED FOR IT -----
    // Both of these have teeth in the 3 s window, and between them they are
    // the whole of the bug this wave fixed, stated as two facts a boot can
    // check. The FIRST is the authority check: the gun in your hands is one
    // the owned mask says you may hold. It would have been true before this
    // wave as well -- there was no mask to contradict -- and it is what would
    // fail if a future edit granted a weapon by writing WS_CUR directly.
    // The SECOND is the loop closing: what the client is ASKING for is what
    // the server says is in its hands. On a 3 s boot with no trade that is the
    // Kestrel agreeing with itself; on `--demo-ui` it is the Blackthorn, and
    // the number that made it true is `client_forced`.
    stck(server_owns(g_sv, server_weapon(g_sv)) == 1,
         `the gun in your hands is one you own: ${client_weapon_name(server_weapon(g_sv))}, mask ${server_own_mask(g_sv)}`);
    stck(client_in_weapon(g_cl) == server_weapon(g_sv) &&
         sim_stat_swaps_denied(server_world(g_sv)) == 0,
         `the client is asking for the gun it is holding: asking ${client_in_weapon(g_cl)}, held ${server_weapon(g_sv)}, ${sim_stat_swaps_denied(server_world(g_sv))} requests denied`);
    // And the CLIENT half of the gate, which nothing else can reach: this is
    // the only place in the tree where a real `client_new` exists next to a
    // real `server_new`. `probe_trade` drives the authority with raw commands
    // and deliberately links no client at all (its header's `nm | grep -c
    // SDL_ == 0`), so these two lines are the whole automated coverage of
    // `client_select_weapon` / `client_cycle_weapon`.
    //
    // They assert the REFUSAL, not the acceptance, and that is the useful half
    // at boot: you own one gun, so every key from 1 to 8 except your own must
    // do nothing, and "next weapon" must not hand you one you have never been
    // given. Both are called for their side effect on `cl.in_weapon` as much
    // as their return value — the line after checks it did not move.
    let want_before: i32 = client_in_weapon(g_cl);
    let refused_sel: i32 = client_select_weapon(g_cl, 0);   // WPN_SPARROW
    let refused_cyc: i32 = client_cycle_weapon(g_cl, 1);
    stck(refused_sel == 0 && refused_cyc == 0 &&
         client_in_weapon(g_cl) == want_before,
         `the client refuses to ask for a gun you do not own: select ${refused_sel}, cycle ${refused_cyc}, still asking ${client_in_weapon(g_cl)}`);
    stck(client_own_count(g_cl) == 1 && client_owns(g_cl, server_weapon(g_sv)) == 1,
         `the client's mirror of the owned set matches the authority: ${client_own_count(g_cl)} gun, mask ${client_own_mask(g_cl)} vs the server's ${server_own_mask(g_sv)}`);

    // ---- THE PARALLEL EMIT POOL IS WIRED -----------------------------------
    // Two assertions, and note what the FIRST one deliberately does NOT say.
    // It does not require workers > 0, because 0 is correct on a machine
    // without threads and on the WASM build, and a selftest that fails there
    // would be asserting the platform rather than the code. What it asserts is
    // that the count `emit.hml` is running is the count this shell ASKED for,
    // clamped: no silent divergence between the config and the engine.
    let want_w: i32 = g_EMIT_WORKERS;
    if (g_workers >= 0) { want_w = g_workers; }
    if (want_w > 12) { want_w = 12; }
    if (want_w < 2) { want_w = 0; }
    stck(g_emit_workers == want_w || g_emit_workers == 0,
         `the emit pool runs the count that was asked for: asked ${want_w}, running ${g_emit_workers}`);
    // And the pool never changes the picture. If it did, `g_st_tri_peak` and
    // the HUD/budget assertions above would still pass while the frame was
    // wrong -- so this asserts the thing that actually varies: the frame graph
    // still produced triangles, with the pool in whatever state it is in.
    stck(g_st_tri_peak > 200,
         `the world still draws with ${g_emit_workers} emit workers: peak ${g_st_tri_peak} triangles`);

    if (g_st_n != g_ST_EXPECT) {
        print(`FAIL: ran ${g_st_n} assertions, expected ${g_ST_EXPECT}`);
        let bad: i32 = 1;
        return bad;
    }
    if (g_st_ok != g_st_n) {
        print(`FAIL ${g_st_ok} / ${g_st_n}`);
        let bad2: i32 = 1;
        return bad2;
    }
    print(`PASS ${g_st_ok} / ${g_st_n}`);
    let ok: i32 = 0;
    return ok;
}

fn parse_args(): i32 {
    let n: i32 = args.length;
    let i: i32 = 1;
    while (i < n) {
        let a: string = args[i];
        if (a == "--help" || a == "-h") { usage(); let q: i32 = 1; return q; }
        else if (a == "--seed" && i + 1 < n) { i++; g_seed = i32(num_or(args[i], 1337.0)); }
        else if (a == "--scale" && i + 1 < n) { i++; g_upscale = clampi(i32(num_or(args[i], 3.0)), 1, 6); }
        else if (a == "--sens" && i + 1 < n) { i++; g_mouse_sens = num_or(args[i], 1.0); }
        else if (a == "--demo" && i + 1 < n) { i++; g_demo_s = num_or(args[i], 20.0); }
        else if (a == "--shots" && i + 1 < n) { i++; g_shot_dir = args[i]; make_dirs(g_shot_dir); g_next_shot = 1.0; }
        else if (a == "--vm" && i + 1 < n) { i++; g_vm_mode = clampi(i32(num_or(args[i], 2.0)), 0, 2); }
        else if (a == "--town" && i + 1 < n) { i++; g_town_tier = clampi(i32(num_or(args[i], 0.0)), 0, 3); }
        else if (a == "--at-town") { g_at_town = 1; }
        else if (a == "--demo-ui") { g_demo_ui = 1; }
        else if (a == "--no-audio") { g_no_audio = 1; }
        else if (a == "--headless") { g_headless = 1; }
        else if (a == "--workers" && i + 1 < n) { i++; g_workers = clampi(i32(num_or(args[i], f64(g_EMIT_WORKERS))), 0, 12); }
        else if (a == "--selftest") { g_headless = 1; g_no_audio = 1; g_demo_s = 3.0; g_selftest = 1; }
        else { eprint(`nightshade: unknown argument '${a}'`); usage(); let bad: i32 = 2; return bad; }
        i++;
    }
    let ok: i32 = 0;
    return ok;
}

fn main() {
    let rc: i32 = parse_args();
    if (rc != 0) {
        if (rc == 1) { exit(0); }
        exit(rc);
    }

    if (boot_window() != 0) { exit(1); }
    if (g_no_audio == 0) { audio_boot(); }
    snd_map_init();

    let b0: u64 = clock_now();
    boot_assets();
    let boot_ms: f64 = clock_ms_between(b0, clock_now());

    chunks_init();
    apron_init();
    boot_game();

    g_in = input_new();
    if (g_headless == 0) {
        // The engine contract is INPUT_REL_OK = 0 / INPUT_REL_FAIL = -1, so
        // SUCCESS IS ZERO. This compared against 1, so g_relative_ok was 0 on
        // success, read_input never called client_look, and the game printed
        // "relative mouse unavailable" on every launch -- you could walk and
        // shoot but only ever face the direction you spawned in. walk.hml has
        // always done this correctly (`if (rc == 0)`), which is why the
        // walkaround could look around and the game could not.
        let rc: i32 = input_set_relative(g_in, 1);
        if (rc == INPUT_REL_OK) {
            g_relative_ok = 1;
        } else {
            g_relative_ok = 0;
            eprint("nightshade: relative mouse unavailable; mouse-look is off");
        }
    }

    print(`nightshade: boot ${f1(boot_ms)} ms, ${assets_texture_count()} textures, audio ${g_audio_on}, seed ${g_seed}, emit workers ${g_emit_workers}`);
    print(`nightshade: spawn (${i32(server_spawn_x(g_sv))}, ${i32(server_spawn_z(g_sv))})  tier ${server_tier_at(g_sv, server_spawn_x(g_sv), server_spawn_z(g_sv), 0)}  lantern ${i32(server_lantern_x(g_sv))}, ${i32(server_lantern_z(g_sv))}  vm ${vm_mesh_tris(g_vm)} tris`);

    run_loop();
    let rc2: i32 = 0;
    if (g_selftest == 1) { rc2 = selftest_report(); }
    shutdown();
    exit(rc2);
}

main();
