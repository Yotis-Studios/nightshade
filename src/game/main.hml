// =============================================================================
//  main.hml — NIGHTSHADE.  THE GAME LOOP.                             W4-11.
// =============================================================================
//
//      hemlockc -O3 src/game/main.hml -o build/nightshade
//      DISPLAY=:0 build/nightshade
//
//  This is ARCHITECTURE §3's loop, verbatim in shape, wired to the real world:
//
//      while (running) {
//          now = clock_now();  frame_ms = clock_ms_between(prev, now);
//          input_sample(...)                      // EVERY frame
//          n = sim_accum_advance(acc, frame_ms);  // 0, 1 or N.  Never "one".
//          while (i < n) {
//              client_send_command(cl, tick);     // input -> command -> wire
//              server_tick(sv, tick);             // the authoritative sim step
//              client_apply(cl, packet, local);   // wire -> client state
//              tick++;
//          }
//          alpha = sim_accum_alpha(acc);
//          client_build_render(cl, alpha);        // interpolate; zero alloc
//          frame_render(); hud_build(); frame_present();
//      }
//
//  -----------------------------------------------------------------------------
//  WHAT THIS FILE IS, AND WHAT IT DELIBERATELY IS NOT
//  -----------------------------------------------------------------------------
//  It is the SHELL: the window, the boot, the clock, the loop, the HUD, and the
//  presentation-side world (the terrain ring, the apron, the props, the sky
//  bridge, the light bake) that `src/render/**` does not own yet — W3-3's
//  `chunkmesh.hml`, W3-4's `terrain_render.hml`, W3-8's `hud.hml`, W3-10's
//  `fx.hml` and W3-11's `entity_render.hml` are all still unwritten, and the
//  only place their work can legally live today is here, in the one zone that
//  may import everything. The code is a direct port of `tools/walk.hml`'s
//  proven scaffolding — the same chunk ring, the same apron, the same uv rules,
//  the same rolling bake — because that scaffolding was playtested twice and
//  holds 60 fps, and reinventing it would have been a way to lose both.
//
//  It is NOT the game logic. Every rule lives in `src/sim/**` behind the import
//  wall; every authoritative decision lives in `server.hml`; every piece of
//  input-to-picture plumbing lives in `client.hml`. This file holds no health,
//  no ammo, no wave state and no enemy — it asks the client, which asks the
//  packet.
//
//  -----------------------------------------------------------------------------
//  THE THREE WALLS, AS THEY APPEAR HERE
//  -----------------------------------------------------------------------------
//   * `frame_render()` reads `g_rsnap` and `g_env` and nothing else. The world
//     registry it walks is filled from `client_ent_*`, which is the decoded
//     snapshot. There is no path from the renderer to `world.*`.
//   * The sim's clock is a TICK. This file owns the only `clock_now()`, and it
//     hands `sim_accum_advance` a millisecond count and gets back an integer.
//   * `tod_eval` and the skygen bridge are the CALLER's (ARCHITECTURE §5.6b) —
//     `src/render/**` may not import `src/art/**`, so stages 6 and 7 are here,
//     exactly where §4 draws them.
// =============================================================================

