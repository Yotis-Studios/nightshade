let g_CHUNK_Q: i32 = 8;                 // quads per terrain chunk edge
let g_QUAD_M: f64 = 4.0;                // metres per terrain quad
let g_CHUNK_M: f64 = 32.0;
let g_CHUNK_SLOTS: i32 = 72;            // mesh pool; a 7x7 ring is 49
let g_CHUNK_BUILD_PER_FRAME: i32 = 2;   // amortised, g_BUDGET_CHUNKGEN_MS
let g_APRON_SEGS: i32 = 24;
let g_APRON_SNAP: f64 = 0.25;

let g_PROP_TRIES: i32 = 10;             // candidates per 32 m chunk
let g_LOD_NEVER: f64 = 1000000.0;

let g_K_TREE: i32 = 0;
let g_K_ROCK: i32 = 1;
let g_K_CRATE: i32 = 2;
let g_K_BARREL: i32 = 3;
let g_K_LANTERN: i32 = 4;
let g_K_BUSH: i32 = 5;
let g_K_ENEMY: i32 = 6;
let g_K_POST: i32 = 7;                  // the sim's lantern post

// A deterministic hash in [lo,hi). Same one `walk.hml` uses; the props must be
// a pure function of position so a chunk re-meshes identically forever.
fn hrange(p_a: i32, p_b: i32, p_s: i32, p_lo: f64, p_hi: f64): f64 {
    let v: f64 = h2(p_a, p_b, p_s);
    let out: f64 = p_lo + (p_hi - p_lo) * v;
    return out;
}

fn absf(p_a: f64): f64 {
    let a: f64 = p_a;
    if (a < 0.0) { a = 0.0 - a; }
    let out: f64 = a;
    return out;
}

// ---------------------------------------------------------------------------
// THE GROUND YOU SEE IS THE GROUND YOU STAND ON.
// ---------------------------------------------------------------------------
// `world_render.hml` exports `terrain_h`, and `tools/walk.hml` builds its
// terrain from it. That is correct for a walkaround, which has no simulation,
// and WRONG for the game: the sim's collision, the AI's steering, the
// projectile raycast and the spawn heights all come from `src/sim/chunk.hml`
// over `src/sim/worldgen.hml`, and those are a different heightfield. Building
// the picture from `terrain_h` puts the player's feet at one height and the
// visible ground at another -- which is not a subtle artefact, it is walking
// through the floor.
//
// So every height in this file comes from the SIM's store, and `terrain_h` is
// used for exactly one thing: the fallback when a chunk is neither resident nor
// generatable, which cannot happen with the ring pinned but must not return a
// hole if it ever does.
//
// `chunk_height_at` generates on demand through `memo_slot` -> `chunk_get`, and
// memoises the last chunk, so the mesh builder's 4-taps-per-vertex pattern hits
// the memo almost every time.
let g_cs = null;

fn ground_h(p_x: f64, p_z: f64): f64 {
    let h: f64 = chunk_height_at(g_cs, p_x, p_z);
    if (h <= CHUNK_H_MISS) {
        let fb: f64 = terrain_h(p_x, p_z);
        return fb;
    }
    let out: f64 = h;
    return out;
}

