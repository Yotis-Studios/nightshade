// ===========================================================================
//  1.  CONSTANTS — the script, and the shape of the owner block
// ===========================================================================

// The player slot this file drives. v1 has one; the sim has four, and the
// command pipeline is written in slot order for exactly that reason.
export let SV_PSLOT: i32 = 1;

// The beats of GAME_DESIGN §8, as integers. The CLIENT decides what a beat
// LOOKS like; the server decides when it happens. Neither can drift, because
// the id is the only thing that crosses.
export let SV_BEAT_WAKE: i32    = 0;   // 0:00 black, a bell, the line
export let SV_BEAT_STAND: i32   = 1;   // 0:03 the camera stands up; control
export let SV_BEAT_SEEK: i32    = 2;   // 0:06 the lantern is the brightest thing
export let SV_BEAT_WISPS: i32   = 3;   // 0:10 three Wisps, one shot each
export let SV_BEAT_MOTE: i32    = 4;   // 0:18 a Mote, two shots, learn reload
export let SV_BEAT_REACH: i32   = 5;   // 0:24 HOLD [E]
export let SV_BEAT_CHANNEL: i32 = 6;   // 0:27 the music stops
export let SV_BEAT_LIT: i32     = 7;   // 0:30 LIGHT
export let SV_BEAT_HORN: i32    = 8;   // 0:33 the horn, four Husks
export let SV_BEAT_WAVE: i32    = 9;   // 0:36 wave 1
export let SV_BEAT_CLEAR: i32   = 10;  // 0:56 silence, ember rain
export let SV_BEAT_PATH: i32    = 11;  // 0:58 the path of lit lanterns
export let SV_BEAT_COUNT: i32   = 12;

// Tick offsets from the session start. GAME_DESIGN §8's own numbers x 60 Hz.
// These are the only schedule constants in the project and they belong here:
// they are the SCRIPT, not the systems, and no other file may invent one.
export let SV_T_STAND: i32   = 180;    // 0:03
export let SV_T_WISPS: i32   = 600;    // 0:10
export let SV_T_MOTE: i32    = 1080;   // 0:18
export let SV_T_HORN_LAG: i32 = 180;   // 0:30 lit -> 0:33 horn.  Three seconds.
export let SV_T_PATH_LAG: i32 = 120;   // 0:56 clear -> 0:58 path.  Two seconds.

// GAME_DESIGN §8: "Three Wisps drift up", "A Mote rises", "Four Husks come up
// the hill". Literals, from the document, asserted by the probe against these
// names — not against a config knob that could be retuned without noticing.
export let SV_N_WISPS: i32 = 3;
export let SV_N_MOTES: i32 = 1;
export let SV_N_HUSKS: i32 = 4;

// GAME_DESIGN §8 at 0:06: "40 m ahead, downhill".
export let SV_LANTERN_M: f64 = 40.0;

// GAME_DESIGN §8 at 0:03: "the ammo counter reads 6 / 12".
export let SV_START_RESERVE: i32 = 12;

// GAME_DESIGN §8 at 0:58: "a path of small lit lanterns ... leading downhill
// and to the left, into fog". Five posts on the Wick Line spacing.
//
// >>> THE PATH POINTS AT THE TOWN, AND IT STOPS SHORT OF IT ON PURPOSE. <<<
//
// It used to curve to `spawn_yaw - 40 degrees` and away from the settlement,
// which put its six posts 181-275 m from the green -- outside the 64 m Camp
// ring, outside a tier-1 lantern's 40 m radius, and outside the 90 m Wick Line
// that would have linked the Great Lantern. Measured, `--demo 75 --seed 1337`:
// core lux 256/512, grid 1/10 point. Five lamps curving into empty fog.
//
// Now the bearing is recomputed at the green, so the line reads as an
// invitation: FOLLOW THESE HOME. And it deliberately stops at
// `SV_PATH_END_M`, because the arithmetic of `settle.hml` makes the alternative
// a cutscene. GRID_LUX counts SET_WICK_FULL (256) per lit post inside the Camp
// ring, DOUBLED to 512 when the post is on a wick line, and a Village wants
// SET_PTS_VILLAGE (10) x SET_LUX_PER_POINT (256) = 2560. The Great Lantern is
// one of those rows. So FOUR lit posts inside 64 m of the green is a Village,
// full stop -- and if the opening dropped four ALREADY-LIT posts in there, the
// town would promote at 0:58, free, before the player had done anything, and
// the game's best reward would have been spent on a cutscene.
//
// `SV_PATH_KEEP_M` is therefore a HARD floor and it is 100 m for three reasons
// at once, all of them arithmetic: > SET_RING_CAMP_M (64) so an authored post
// can never be a grid point, > g_LANTERN_R_T1 (40) so it can never add CORE_LUX
// at the green, and > g_WICKLINE_M (90) so it can never link the Great Lantern
// and double it to 512. An authored post contributes EXACTLY ZERO to the tier.
// The only thing the opening gives the settlement is the Great Lantern's own
// wick, which `sv_lan_gather` raises for any lit post inside the 320 m City
// ring -- a camp that can see a lamp burning. That is a picture, not a point.
// probe_lanfeed section B asserts all of it.
export let SV_PATH_N: i32 = 5;
export let SV_PATH_STEP_M: f64 = 22.0;   // the fallback spacing; see SV_PATH_END_M
export let SV_PATH_TURN_DEG: f64 = 40.0; // the fallback bearing, kept for the same
export let SV_PATH_END_M: f64 = 135.0;   // where the LAST post lands, from the green
export let SV_PATH_KEEP_M: f64 = 100.0;  // and nothing authored is ever nearer
export let SV_PATH_BOW_M: f64 = 12.0;    // the lateral bow; "into fog", not a ruler
export let SV_PATH_STEP_MIN: f64 = 4.0;  // clamps, both load-bearing: MIN stops a
export let SV_PATH_STEP_MAX: f64 = 60.0; // pile-up, MAX keeps the line inside the
                                         // 90 m Wick Line so it is one unbroken run.
// 60 and not 40, and the 20 m is measured: at 40, seed 31337's town is 356.8 m
// from the first post, the spacing clamps, and the last lamp lands at 156.8 m
// instead of SV_PATH_END_M -- one seed in eight where the invitation stops 22 m
// short. 60 m of spacing is still 30 m inside the Wick Line, so the chain is
// unbroken with a third of the link distance to spare, and every seed measured
// now lands its nearest post at exactly 135.0 m. Above ~435 m the clamp binds
// again and the path simply falls short; probe_lanfeed asserts the ARITHMETIC
// (max(END, d0 - N*STEP_MAX)) rather than the happy number, so a far seed
// reports honestly instead of false-failing.

// The session starts here in the 16-minute day so that the dusk horn's own
// edge (T-2:00, which is the start of DUSK) lands at 0:33 -- the GDD's beat.
// A player who ignores the lantern still gets the horn on schedule.
export let SV_T0_DAY: i32 = i32(g_PHASE_DAY_END * f64(g_DAY_TICKS)) - 1980;

// The world entity model ids the client maps to meshes. KIND_AI carries the
// enemy class in `model` (ai.hml sets `model[slot] = class`), so lanterns and
// pickups need ids that cannot collide with a class. 90/120 are what
// `probe_sim.hml` already uses for the same two kinds.
export let SV_MODEL_LANTERN: i32 = 90;
export let SV_MODEL_PICKUP: i32  = 120;

// The cosmetic queue the owner block carries. One frame can be several ticks,
// and the client drains once per tick, so this only has to hold ONE tick's
// worth -- which sim.hml already caps at SIM_FX_CAP.
export let SV_FX_CAP: i32 = SIM_FX_CAP;

export let SV_MISS: i32 = -1;

// ===========================================================================
//  1b. W6 — THE MODAL UI, AS INTEGERS
// ---------------------------------------------------------------------------
//  CLAUDE.md §7: all input reaches the sim through `InputCommand` and nowhere
//  else. Nine integers, twelve button bits, no strings. A menu therefore
//  cannot send "raise Vitality" — it can only send EDGES, and the CURSOR the
//  edges move has to live on the authority so that it rewinds, saves and
//  replays with everything else. That is why `ui_row` is a server field and
//  not a client one, and it is the same argument `melee.hml` makes for keeping
//  its press edge in the state array.
//
//      BTN_INV      toggle the character sheet
//      BTN_BUILD    toggle the trade panel (needs somebody to trade with)
//      BTN_SWITCH   panel open -> next row;  closed -> next spell
//      BTN_GRENADE  panel open -> confirm;   closed -> cast
//      BTN_USE      lantern in reach -> channel;  else villager in reach -> talk
//
//  Four bits and one reused pair. No wire change, no tenth integer.
// ===========================================================================

export let UI_PANEL_NONE: i32 = 0;
export let UI_PANEL_CHAR: i32 = 1;    // the five stats and the point budget
export let UI_PANEL_TRADE: i32 = 2;   // one villager's open offers
export let UI_PANEL_COUNT: i32 = 3;

// What the last confirm DID. The client turns these into a line of text; the
// server never owns a string. A refusal has its own code for every reason it
// could refuse, because "nothing happened" is the worst thing a menu can say.
export let UI_MSG_NONE: i32       = 0;
export let UI_MSG_POINT: i32      = 1;   // a stat point was spent, arg = stat
export let UI_MSG_NO_POINTS: i32  = 2;
export let UI_MSG_STAT_MAX: i32   = 3;
export let UI_MSG_TRADED: i32     = 4;   // arg = offer kind
export let UI_MSG_NO_TRADE: i32   = 5;   // the row closed under you
export let UI_MSG_UNBUILT: i32    = 6;   // THE HONEST ONE — see §7b.5
export let UI_MSG_NOBODY: i32     = 7;
export let UI_MSG_NO_SALVAGE: i32 = 8;   // the price is real and you are short
export let UI_MSG_HAVE: i32       = 9;   // equipment you are already wearing
export let UI_MSG_HEAVY: i32      = 10;  // taken, and now you are over your limit
export let UI_MSG_COUNT: i32      = 11;

// How long a UI message stays up, in ticks.
export let UI_MSG_TICKS: i32 = 150;

// The talk reach. `npc.hml` has its own NPC_TALK_M for picking the target;
// this is the prompt radius and it is deliberately the same number the lantern
// uses, so "something is in reach" means one thing in this game.
export let SV_TALK_R_M: f64 = SIM_INTERACT_R_M;

// The five stats, in panel order. The panel shows them in the order
// `stats.hml` declares them and nothing here may reorder that.
export let SV_UI_STAT_ROWS: i32 = SK_COUNT;

// The settlement steps on the sim clock; these two are its cadence in the
// authority, and both are ALREADY the module's own (`SET_STEP_EVERY` and
// npc.hml's 60). Named here so the tick reads as prose.
export let SV_SETTLE_EVERY: i32 = 60;

// `sim_new_cap(g_MAX_ENTS, 2, seed)` above gives the world two player slots and
// `SV_PSLOT` is 1, so the melee store needs slots 0 and 1. Named rather than
// `2` so that raising the sim's player count is one grep, not a hunt.
export let SV_MELEE_SLOTS: i32 = 2;

// How many lanterns the settlement integrates. `settle.hml` takes the array by
// reference and never grows it, so the cap is the caller's. Sixteen lit posts
// saturate CORE_LUX (SET_CL_MAX / a lantern's contribution), and 64 leaves room
// for the ring to be full of them without a reallocation in a tick (N6).
export let SV_LAN_CAP: i32 = 96;

// What a trade actually moves. Both are the authority's numbers, not a
// module's, for the same reason `SV_START_RESERVE` is: what a player is GIVEN
// is game policy and belongs in the script file.
export let SV_TRADE_AMMO: i32 = 24;          // two Kestrel reserves
export let SV_TRADE_MFG_RESERVE: i32 = 120;  // the Sparrow is ammo-hungry

// ===========================================================================
//  1c. W7 — SALVAGE, THE PACK, AND WHAT A KILOGRAMME COSTS
// ---------------------------------------------------------------------------
//  DIRECTION.md §7, as three numbers.
//
//  SALVAGE is earned from the only two things the player does: killing what is
//  in the dark and lighting the dark. Both already land in ONE counter —
//  `prog_xp_total` — so income is a DELTA on a number the world already keeps,
//  not a second economy running alongside it. That matters more than it looks:
//  a separate kill hook would need its own save field, its own replay coverage
//  and its own answer to "what happens on a level-up", and every one of those
//  is a chance for the purse to disagree with the score.
//
//  `SV_XP_PER_SALVAGE` is the whole exchange rate. Lighting one lantern is
//  `g_XP_LANTERN` = 350 XP = 14 salvage = exactly one trade of brass. That is
//  not a coincidence and it is not tuned: it is the sentence "a lit lamp pays
//  for a magazine", written as division.
export let SV_XP_PER_SALVAGE: i32 = 25;

//  WHAT THE PLAYER IS ALREADY CARRYING BEFORE THEY BUY ANYTHING. A lamplighter
//  walks out of town with a gun, a lantern and whatever brass they can hold,
//  and `stats.hml`'s base is 18.0 kg at Capacity 0 — "a rifle, a lantern and a
//  day of brass", in its own words. These three numbers are that sentence.
export let SV_KG_GUN: f64      = 3.8;    // the weapon in your hands
export let SV_KG_LANTERN: f64  = 1.2;    // the one you never put down
export let SV_KG_PER_ROUND: f64 = 0.045; // brass. 120 rounds is 5.4 kg.

//  THE MOVEMENT PENALTY, AND WHY IT IS APPLIED HERE.
//
//  `stats.hml` §8 is explicit: "Overloading SLOWS you; it never stops you." It
//  exposes `stats_move_mult` and NOTHING CALLS IT. `PredictedState` has no
//  speed-multiplier field and adding one moves `PS_FIELDS`, which moves
//  `SAVE_C_PLAYER_F` — and neither `movement.hml` nor `save.hml` is this
//  task's to move.
//
//  So the authority applies it where an authority is allowed to: to the
//  MOVEMENT AXES of the command, on receipt, before the command is queued.
//  `move_apply_ex` computes `wish = wish * mag` where `mag` is the axis
//  magnitude, and `dq_axis` is linear, so scaling the quantised axis scales
//  the wish speed by exactly the same factor. The sprint cone tests the RATIO
//  of the two axes and both scale together, so a loaded player still sprints —
//  slowly, which is the point.
//
//  This is server-authoritative and it is published (`local.move_mult`) so a
//  v2 predicting client can apply the identical number. It is NOT a second
//  input channel: nine integers still arrive, and one of them is smaller.
export let SV_LOAD_MIN_MULT: f64 = 0.55;   // == stats.hml's 1.0 - g_OVERLOAD_SLOW

//  A LANTERN KIT IS A THING YOU CARRY OUT AND PUT DOWN. Wick's `NPC_OFF_KIT`
//  row is the one STOCK item in the table and this is what makes it stock: you
//  buy it in the light, you carry six kilogrammes of it into the dark, and
//  `BTN_USE` with nothing else in reach plants an UNLIT post you then have to
//  hold E on. That closes the loop the whole game is: trade -> carry -> place
//  -> light -> CORE_LUX -> tier -> a new face at the bench.
export let SV_KIT_MIN_GAP_M: f64 = 12.0;   // no stacking posts on one spot

//  HOW MANY OF THEM YOU HAVE, AND WHEN. The whole of the second verb's
//  economy, in two integers, because the loop is one sentence: SURVIVE A
//  NIGHT, EARN A LANTERN, PLANT IT, THE TOWN GROWS.
//
//  FOUR lit posts inside the 64 m Camp ring is a Village -- `settle.hml`'s own
//  arithmetic, five wick-linked rows at 512 each against SET_PTS_VILLAGE (10)
//  x SET_LUX_PER_POINT (256), one of the five being the Great Lantern. So the
//  supply is built to reach exactly four, and to reach it ONE HOLD LATE.
//
//  `SV_OPEN_KITS` is what the opening's last beat hands you at 0:58, and TWO is
//  `stats.hml`'s number rather than a taste: a kit is 6.00 kg (`g_off_kg100`),
//  a Capacity-0 lamplighter's limit is g_CARRY_BASE_KG = 18.0, and the load
//  they are already carrying is SV_KG_GUN + SV_KG_LANTERN + 18 rounds x
//  SV_KG_PER_ROUND = 5.81 kg at a full eighteen rounds. Two kits is 17.81 of
//  18.00 -- the most a lamplighter can carry and still walk at full speed,
//  with 0.19 kg to spare. MEASURED on the beat itself, where the magazine is
//  part-spent: worst of 8 seeds 17.7 kg of 18.0, move x1.0 (probe_lanfeed §C).
//  A THIRD kit is not refused; it is just slow (x0.85), which is what DIRECTION §7
//  asked packing to feel like -- and it is why the fourth post costs a second
//  trip rather than a heavier one.
//
//  `SV_HOLD_KITS` is what ONE completed hold pays, and 2 + 2 is chosen so the
//  first night a player survives is the night that lets them promote their
//  town. Measured rather than reasoned: at 2 + 1 the fourth kit needs a SECOND
//  completed hold, and `sim.hml` pins only the FIRST hold's tier -- THE_HOUR
//  §5.5 measured night 2 rolling tier 3 and killing the player twenty times
//  without the hold ever clearing. probe_lanfeed's own §C column agrees and is
//  the reason this is 2 and not 1: over EIGHT seeds x 32 game minutes, the
//  first hold completes at 5:34-6:42 and THE SECOND HOLD NEVER COMPLETES ON
//  ANY SEED. A supply that needs two holds is a supply that does not arrive.
export let SV_OPEN_KITS: i32 = 2;
export let SV_HOLD_KITS: i32 = 2;

// ===========================================================================
//  TEACH — THE THREE PREDICATES THE HUD IS ALLOWED TO DRAW
// ---------------------------------------------------------------------------
//  `probe_lanfeed` printed the finding this block exists to answer, in its own
//  output: "Four kits, and four posts inside 64 m is a Village. The game
//  teaches NEITHER. There is no map, no marker and no line of dialogue that
//  says the ring exists."
//
//  The fix is HUD content and it lives in `main.hml`. What lives HERE is the
//  three booleans that content is allowed to be true about — and they live
//  here for one reason:
//
//      >>> A PROMPT THAT DISAGREES WITH THE VERB IS A LIE, AND THE ONLY WAY
//          TO MAKE THAT IMPOSSIBLE IS ONE IMPLEMENTATION. <<<
//
//  `sv_ui_tick` CALLS `teach_plant_ready` to decide whether `BTN_USE` plants.
//  The HUD calls the same function to decide whether to say so. They cannot
//  drift, because there is nothing to drift from. `tools/probe_teach.hml` §A
//  sabotages the branch in a scratch copy and confirms the probe goes red.
//
//  These are pure functions of scalars, deliberately: `main.hml` passes them
//  `client_*` values (what is on the wire and therefore what a player can
//  possibly know) and a headless probe passes them the owner block's. Neither
//  needs `src/game/server.hml` to be linked against a display, and neither can
//  reach around the wire to get a better answer than the player has.
// ===========================================================================

// The verdict on a post the instant it goes into the ground. THE ONE FACT the
// player has no way to learn today: a post inside the tier's ring feeds
// CORE_LUX and the grid; a post outside it lights the road and nothing else.
export let TEACH_V_NONE: i32    = 0;
export let TEACH_V_INSIDE: i32  = 1;
export let TEACH_V_OUTSIDE: i32 = 2;

// WOULD `BTN_USE` PLANT A POST RIGHT NOW?  This is `sv_ui_tick`'s own priority
// order and not a second opinion about it: a lantern in reach wins, then a
// villager in reach, then the post you are carrying. A modal panel eats the
// key entirely and a corpse presses nothing.
export fn teach_plant_ready(p_kits: i32, p_in_reach: i32, p_who: i32,
                            p_panel: i32, p_dead: i32): i32 {
    if (p_dead != 0) { let d: i32 = 0; return d; }
    if (p_panel != UI_PANEL_NONE) { let m: i32 = 0; return m; }
    if (p_in_reach != 0) { let r: i32 = 0; return r; }
    if (p_who != NPC_NONE) { let w: i32 = 0; return w; }
    if (p_kits < 1) { let k: i32 = 0; return k; }
    let out: i32 = 1;
    return out;
}

// SHOULD THE GREAT LANTERN SHOW ITS REACH?  Only while you are carrying an
// unlit wick. This is the diegetic gate and it is the whole design: the ring
// is not a UI overlay that is always on, it is the old wick answering a new
// one, so it appears exactly when it is the answer to a question you are
// holding in your hands.
export fn teach_ring_show(p_kits: i32, p_dead: i32): i32 {
    if (p_dead != 0) { let d: i32 = 0; return d; }
    if (p_kits < 1) { let k: i32 = 0; return k; }
    let out: i32 = 1;
    return out;
}

// Which of the two things just happened. `p_inside` is `l.set_inside`, which
// `sv_publish` computes as `set_dist <= settle_ring_m(tier_ever)` — the SAME
// ring `settle_grid_sum` integrates over, so this cannot say "it counted"
// about a post the settlement will not count.
export fn teach_verdict(p_inside: i32): i32 {
    if (p_inside != 0) { let i: i32 = TEACH_V_INSIDE; return i; }
    let o: i32 = TEACH_V_OUTSIDE;
    return o;
}

//  WHAT THE `--town` DEV FLAG HANDS YOU, PER TIER. Fixture money and nothing
//  else — see `server_settle_boot_tier`'s tail for why a fabricated Town needs
//  a fabricated purse to be a coherent fixture at all.
export let SV_BOOT_SALVAGE: i32 = 40;

// The one spell that is held rather than tapped. Named so `sv_w6_tick` reads
// as prose instead of as a magic number.
export let g_SPELL_SHUTTER_ID: i32 = 1;

// ===========================================================================
//  2.  THE HEIGHTFIELD ADAPTER
// ---------------------------------------------------------------------------
//  `chunk.hml` takes an INJECTED source (ARCHITECTURE §5.4b) so the store can
//  be tested without a generator. The boot path owns the adapter; this is the
//  boot path.
// ===========================================================================

fn sv_chunk_source(p_hbuf: buffer, p_hoff: i32, p_abuf: buffer, p_aoff: i32,
                   p_cx: i32, p_cz: i32, p_seed: i32): i32 {
    let out: i32 = worldgen_chunk_at(p_seed, p_cx, p_cz,
                                     p_hbuf, p_hoff, p_abuf, p_aoff);
    return out;
}

// 256 resident chunks, not 64. The store is sampled by TWO consumers: the sim
// (a 5x5 pinned ring) and the RENDERER (main.hml's `ground_h`, out to the fog
// wall, plus the apron's normal taps). One heightfield, two readers -- see
// main.hml's `ground_h` for why that is not negotiable. 64 slots thrashed.
export fn server_chunks_new(p_seed: i32): object {
    let cs: object = chunk_store_new_cap(256, 256, p_seed);
    chunk_set_source(cs, sv_chunk_source);
    let out: object = cs;
    return out;
}

fn sv_ground(p_cs: object, p_x: f64, p_z: f64): f64 {
    let h: f64 = chunk_height_at(p_cs, p_x, p_z);
    if (h <= CHUNK_H_MISS) { h = 0.0; }
    let out: f64 = h;
    return out;
}

// ===========================================================================
//  3.  THE OWNER BLOCK
// ---------------------------------------------------------------------------
//  Everything one client is allowed to know that is not in the entity stream.
//  Preallocated once; `server_tick` only ever assigns into it.
// ===========================================================================

fn zeros_i(p_n: i32): array<i32> {
    let a: array<i32> = [];
    let i: i32 = 0;
    while (i < p_n) { a.push(0); i++; }
    let out: array<i32> = a;
    return out;
}

fn zeros_f(p_n: i32): array<f64> {
    let a: array<f64> = [];
    let i: i32 = 0;
    while (i < p_n) { a.push(0.0); i++; }
    let out: array<f64> = a;
    return out;
}

fn sv_local_new(): object {
    let l: object = {
        tick: -1,
        // ---- the body ----------------------------------------------------
        id: ID_NONE,
        hp: 0,
        hp_max: 0,
        dead: 0,
        respawn_t: 0.0,
        px: 0.0, py: 0.0, pz: 0.0,
        eye: 0.0,
        eye_abs: 0.0,
        speed: 0.0,
        grounded: 0,
        step_dist: 0.0,
        // ---- the weapon (GAME_DESIGN §8: the ammo counter reads 6 / 12) ---
        weapon: 0,
        ammo: 0,
        reserve: 0,
        reload_t: 0.0,
        reload_stage: 0,
        ads: 0.0,
        rc_v: 0.0,
        shots: 0,
        // ---- W7-3: what you own, and what was put in your hands ----------
        // `weapon` above is what you ARE holding. These three are what you
        // MAY hold, what the authority last handed you, and how many times it
        // has done so. The client adopts on `weapon_force_n` MOVING; see
        // `weapons.hml`'s WS_FORCE_N block for why that is a counter and not
        // a comparison against `weapon`.
        weapon_owned: 0,
        weapon_force: WPN_NONE,
        weapon_force_n: 0,
        // ---- progression --------------------------------------------------
        level: 1,
        xp_total: 0,
        xp_into: 0,
        xp_need: 1,
        levelups: 0,
        // ---- the world ----------------------------------------------------
        phase: 0,
        day_t: 0.0,
        tier: 0,
        alive: 0,
        wave_state: 0,
        wave: 0,
        wave_budget: 0,
        wave_spawned: 0,
        dir_events: 0,
        // ---- the lantern --------------------------------------------------
        lantern_id: ID_NONE,
        lantern_x: 0.0, lantern_y: 0.0, lantern_z: 0.0,
        lantern_lit: 0,
        lantern_dist: 0.0,
        chan01: 0.0,
        in_reach: 0,
        // ---- the script ---------------------------------------------------
        beat: SV_BEAT_WAKE,
        beat_tick: 0,
        session_tick: 0,
        // ---- W6: melee ----------------------------------------------------
        mel_wpn: MEL_NONE,
        mel_phase: 0,
        mel_swings: 0,
        mel_hits: 0,
        // ---- W6: the spell school -----------------------------------------
        sp_id: -1,
        sp_slots: 0,
        sp_have: 0,          // bitmask of granted spells
        sp_oil01: 0.0,
        sp_oil: 0.0,
        sp_tank: 0.0,
        sp_cd01: 0.0,
        sp_chan01: 0.0,
        sp_cloak: 0,
        sp_casts: 0,
        sp_cast_edge: 0,
        sp_result: 0,
        sp_lit: 0,
        // ---- W6: stats and skills -----------------------------------------
        sk0: 0, sk1: 0, sk2: 0, sk3: 0, sk4: 0,
        sk_unspent: 0,
        sk_spent: 0,
        // ---- W6: the settlement --------------------------------------------
        set_x: 0.0, set_z: 0.0, set_y: 0.0,
        set_name: 0,
        set_tier: 0,
        set_tier_ever: 0,
        set_dist: 0.0,
        set_bearing: 0.0,
        set_core: 0,
        set_core_need: 0,
        set_pts: 0,
        set_pts_need: 0,
        set_gl: 0,
        set_bld: 0,
        set_brownout: 0,
        set_inside: 0,
        set_lux: 0,
        set_lan_n: 0,
        set_events: 0,
        // ---- W6: the villagers ---------------------------------------------
        npc_n: 0,
        npc_named: 0,
        npc_arrived: NPC_NONE,
        talk_who: NPC_NONE,
        talk_dist: 0.0,
        talk_topic: NPC_T_NONE,
        talk_arg: 0,
        talk_regard: 0,
        talk_band: 0,
        talk_offers: 0,
        talk_new: 0,
        // ---- W6: the modal UI ----------------------------------------------
        ui_panel: UI_PANEL_NONE,
        ui_row: 0,
        ui_rows: 0,
        ui_msg: UI_MSG_NONE,
        ui_arg: 0,
        // ---- W7: the purse, the pack and what it costs you to walk ---------
        purse: 0,           // salvage in hand
        salvage_earned: 0,  // lifetime
        salvage_spent: 0,   // lifetime
        fit: 0,             // SK_EQ_* mask bought from villagers
        load_kg: 0.0,       // gun + lantern + brass + pack
        carry_kg: 0.0,      // stats_carry_kg at this Capacity and this kit
        overload: 0.0,      // 0 .. 1, where 1 is twice what you can hold
        move_mult: 1.0,     // what the authority is scaling your axes by
        pack_items: 0,
        pack_kits: 0,       // lantern kits, the one STOCK row
        kits_placed: 0,
        trade_ok: 0,        // rows on this villager you could take right now
        trade_why: 0,       // NPC_TR_* for the row under the cursor
        trade_price: 0,     // its price in salvage
        // ---- this tick's cosmetics ----------------------------------------
        fx_n: 0,
        fx_kind: zeros_i(SV_FX_CAP),
        fx_a: zeros_i(SV_FX_CAP),
        fx_b: zeros_i(SV_FX_CAP),
        fx_x: zeros_f(SV_FX_CAP),
        fx_y: zeros_f(SV_FX_CAP),
        fx_z: zeros_f(SV_FX_CAP)
    };
    let out: object = l;
    return out;
}

// ===========================================================================
//  4.  CONSTRUCTION
// ===========================================================================

// `p_transport` may be null: a probe that wants the direct
// `server_apply_command` path does not need a wire. Everything else is
// identical either way, which is the property that makes the loopback
// transport a real test instead of a decoration.
export fn server_new(p_seed: i32, p_transport): object {
    let seed: i32 = p_seed;

    let w: object = sim_new_cap(g_MAX_ENTS, 2, seed);
    let cs: object = server_chunks_new(seed);
    sim_set_chunks(w, cs);

    let snap: object = snapshot_new_cap(SNAP_CAP);
    let base: object = snapshot_new_cap(SNAP_CAP);

    let sv: object = {
        ver: 1,
        seed: seed,
        world: w,
        cs: cs,
        net: p_transport,
        rxq: cmdq_new(16),
        rxcmd: cmd_new(),
        snap: snap,
        base: base,
        local: sv_local_new(),
        pslot: SV_PSLOT,

        // the session clock: TICK numbers, never milliseconds
        t0: SV_T0_DAY,
        tick: SV_T0_DAY - 1,
        session: 0,

        // the script
        beat: SV_BEAT_WAKE,
        beat_tick: 0,
        wisps_at: SV_T_WISPS,
        mote_at: SV_T_MOTE,
        wisps_done: 0,
        mote_done: 0,
        horn_at: SV_MISS,
        husks_done: 0,
        path_at: SV_MISS,
        path_done: 0,
        hold_begun: 0,

        // the lantern of GAME_DESIGN §8
        lantern_id: ID_NONE,
        lantern_x: 0.0,
        lantern_y: 0.0,
        lantern_z: 0.0,
        lantern_lit: 0,
        lantern_lit_tick: SV_MISS,

        // where the player woke up, and which way they were looking
        spawn_x: 0.0,
        spawn_z: 0.0,
        spawn_yaw: 0.0,
        respawn_t: 0.0,

        // counters
        supply_t: 0.0,
        supplied: 0,
        ticks: 0,
        cmds_in: 0,
        bytes_out: 0,
        snap_bytes: 0,
        path_lit: 0,
        deaths: 0,

        // ---- W6: THE TEN SYSTEMS, §7b ------------------------------------
        // Every store is allocated ONCE, here, and reused for the process
        // lifetime (A8/N6). Nothing below is allocated in a tick.
        mel: melee_new_cap(SV_MELEE_SLOTS, g_MAX_ENTS),
        sp: spell_new(),
        spctx: spell_ctx_new(),
        sk: stats_new(),
        set: null,
        npcs: null,

        // the settlement's lantern feed: (x, z, tier, wick) x N, written in
        // place every settle sweep, never reallocated
        lan: zeros_f(SV_LAN_CAP * 4),
        lan_n: 0,
        // Rows [0, lan_civic) belong to the SETTLEMENT (the Great Lantern, and
        // its own street lamps); rows [lan_civic, lan_n) are the world's lit
        // posts and are rebuilt from the world every sweep. Without the split,
        // `sv_lan_gather` wiped the streets a tier had been booted with on the
        // very next sweep and the town fell back into brownout one second
        // after it was created.
        lan_civic: 1,

        // the modal UI, AUTHORITATIVE. The client draws it; it does not own it.
        ui_panel: UI_PANEL_NONE,
        ui_row: 0,
        ui_rows: 0,
        ui_msg: UI_MSG_NONE,
        ui_msg_tick: SV_MISS,
        btn_prev: 0,

        // conversation
        talk_who: NPC_NONE,
        talk_topic: NPC_T_NONE,
        talk_arg: 0,
        talk_tick: SV_MISS,

        // spells: what has been granted, and by what
        sp_granted: 0,          // bitmask of spell ids the player has been given
        sp_last_casts: 0,
        sp_cast_edge: 0,

        // ---- W7: the economy ----------------------------------------------
        // `xp_seen` is the high-water mark income has already been paid on. It
        // is a SERVER field and not an npc-store one because it is a cursor
        // into `prog_xp_total`, which is the world's; the purse it feeds is in
        // the store, where it saves and hashes with the rest of the ledger.
        xp_seen: 0,
        move_mult: 1.0,
        kits_placed: 0,
        // The teaching latch. See `sv_place_kit`'s tail.
        kit_verdict: TEACH_V_NONE,
        kit_verdict_d: 0.0,
        kit_verdict_n: 0,

        // counters, so every refusal is visible (combat.hml's rule)
        trades: 0,
        trades_refused: 0,
        points_spent: 0,
        talks: 0,
        settle_events: 0,
        set_promotions: 0
    };

    // The settlement lives in the 1200 m cell the player wakes up in, so it is
    // WALKABLE — DIRECTION.md §8. `settle_new_at` needs the spawn, and the
    // spawn is found by `server_boot`, so the site is built there and not here.
    server_boot(sv);
    let out: object = sv;
    return out;
}

// ---------------------------------------------------------------------------
// THE OPENING SCENE.
// ---------------------------------------------------------------------------
// GAME_DESIGN §8 at 0:06: "40 m ahead, DOWNHILL, an unlit lantern on a post is
// the only vertical thing on the horizon". Downhill is not decoration — it is
// what makes "you crest the slope" at 0:10 true. So the spawn bearing is chosen
// by SAMPLING the terrain: of sixteen bearings, take the one whose 40 m point
// drops the most. If the ground is flat the fallback is the first bearing, and
// the beat degrades to "40 m ahead" rather than failing.
//
// The spawn itself sits ~270 m from the origin, which is one full SHADE TIER
// out of town (`g_SHADE_TIER_M` = 200 m). That is not scenery either: the
// director refuses to run a hold at tier 0 — "a lit lantern's radius is tier 0
// and tier 0 has no dark in it" — and the lantern is lit at 0:30, three
// seconds BEFORE the dusk phase bonus arrives. Spawning in town would make
// `director_begin` a no-op and the 0:36 wave would never come.
export fn server_boot(p_sv: object): i32 {
    let sv: object = p_sv;
    let w: object = sv.world;
    let cs: object = sv.cs;

    // WHERE YOU WAKE UP, AND WHY IT IS SEARCHED FOR RATHER THAN TYPED.
    //
    // `director_begin` REFUSES at tier 0 -- "a lit lantern's radius is tier 0
    // and tier 0 has no dark in it" -- and GAME_DESIGN §8 lights the lantern at
    // 0:30, three seconds BEFORE dusk adds its phase bonus. So the spawn must
    // be somewhere `worldgen_shade_tier(seed, cx, cz, 0) >= 1` on its own.
    // `worldgen_shade_tier` is `floor(d/200) + jitter`, and the jitter can be
    // negative, so a hardcoded 270 m coordinate is tier 1 for some seeds and
    // tier 0 for others -- which would silently turn the 0:36 wave into
    // nothing on a seed nobody tested. Search instead: sixteen bearings on
    // three rings, first tier >= 1 wins, deterministic in the seed.
    let sx: f64 = -191.0;
    let sz: f64 = -191.0;
    let found: i32 = 0;
    let ring: i32 = 0;
    while (ring < 3 && found == 0) {
        let rr: f64 = 280.0 + f64(ring) * 120.0;
        let b: i32 = 0;
        while (b < 16 && found == 0) {
            let ang: f64 = f64(b) * 0.39269908169872414;
            let tx: f64 = sin(ang) * rr;
            let tz: f64 = 0.0 - cos(ang) * rr;
            let tcx: i32 = i32(floor(tx / g_CHUNK_M));
            let tcz: i32 = i32(floor(tz / g_CHUNK_M));
            if (worldgen_shade_tier(p_sv.seed, tcx, tcz, 0) >= 1) {
                sx = tx;
                sz = tz;
                found = 1;
            }
            b++;
        }
        ring++;
    }
    chunk_pin_ring(cs, i32(floor(sx / g_CHUNK_M)), i32(floor(sz / g_CHUNK_M)),
                   g_RING_RADIUS + 1);

    // Which way is downhill at 40 m?
    let best_yaw: f64 = 0.0;
    let best_drop: f64 = -1.0e30;
    let h0: f64 = sv_ground(cs, sx, sz);
    let k: i32 = 0;
    while (k < 16) {
        let a: f64 = f64(k) * 0.39269908169872414;      // 2pi / 16
        let tx: f64 = sx + sin(a) * SV_LANTERN_M;
        let tz: f64 = sz - cos(a) * SV_LANTERN_M;
        let drop: f64 = h0 - sv_ground(cs, tx, tz);
        if (drop > best_drop) { best_drop = drop; best_yaw = a; }
        k++;
    }

    sv.spawn_x = sx;
    sv.spawn_z = sz;
    sv.spawn_yaw = best_yaw;

    sim_add_player(w, sv.pslot, sx, sz);

    // GAME_DESIGN §8 at 0:03: "the ammo counter reads 6 / 12", and at 0:36:
    // "You have a revolver and 12 rounds. You WILL run out." The running out is
    // the beat -- it is what makes you melee something and win with 30 HP.
    // `weapons.hml`'s table gives the Kestrel a 48-round reserve, which is the
    // right STEADY-STATE number and the wrong OPENING one, so the opening
    // loadout is set here: the authority owns what a player spawns with, and
    // `wpn_state_reset` has already run. The literal is the GDD's.
    let wst: array = sim_weapon_state(w);
    wst[(sv.pslot - 1) * WS_FIELDS + WS_RES0 + WPN_KESTREL] = f64(SV_START_RESERVE);

    let lx: f64 = sx + sin(best_yaw) * SV_LANTERN_M;
    let lz: f64 = sz - cos(best_yaw) * SV_LANTERN_M;
    sv.lantern_id = sv_spawn_lantern(sv, lx, lz, SIM_LANTERN_UNLIT);
    sv.lantern_x = lx;
    sv.lantern_z = lz;
    sv.lantern_y = sv_ground(cs, lx, lz);

    snapshot_set_radius(sv.snap, 0.0);      // v1 has one viewer; cull nothing
    snapshot_reset(sv.base);

    sv_w6_boot(sv);

    let out: i32 = 1;
    return out;
}

// ---------------------------------------------------------------------------
// W6 BOOT. The ten systems, brought up in dependency order: the settlement
// first (it is the only one with a position), then the people who live in it.
// ---------------------------------------------------------------------------
fn sv_w6_boot(p_sv: object) {
    let sv: object = p_sv;
    let w: object = sv.world;

    // THE SETTLEMENT IS IN THE CELL YOU WAKE UP IN. `settle_new` hardcodes
    // grid (0,0), which is right only when the spawn happens to be there.
    // DIRECTION.md §8 wants settlements walkable on foot, so the site is the
    // one belonging to the player's own 1200 m cell -- measured at 282 m from
    // the spawn on the default seed, which is a forty-second walk.
    let gx: i32 = settle_cell_x_of(sv.spawn_x);
    let gz: i32 = settle_cell_z_of(sv.spawn_z);
    sv.set = settle_new_at(sv.seed, gx, gz);

    // THE GREAT LANTERN. Row 0 of the lantern feed is the settlement's own,
    // by `settle_great_tier`'s definition, and it starts UNLIT (wick 0) --
    // this is a camp, not a town, and the first thing the player can do for it
    // is light the middle of it.
    sv_lan_reset(sv);

    sv.npcs = npc_new(sv.set);

    // ---- the melee hand ---------------------------------------------------
    // GAME_DESIGN §8 at 0:36: "You have a revolver and 12 rounds. You WILL run
    // out." The running out is only a beat if there is something in the other
    // hand when it happens, so the club is spawn kit, not a reward.
    melee_equip(sv.mel, sv.pslot, MEL_CLUB);

    // NOTE ON WHAT IS DELIBERATELY *NOT* HERE: the lantern kits. They were
    // seeded in this function first, mirroring the club and the Kestrel's
    // twelve rounds, and two probes said no. `probe_trade` §G asserts a fresh
    // lamplighter's load is "gun + lantern + the brass in hand" and §H asserts
    // that USE with an EMPTY PACK plants nothing -- both true statements about
    // a boot, both broken by twelve kilogrammes of lamp appearing in the pack
    // before the player has done anything. They are also the better design:
    // the kits belong on the beat that shows you where to carry them. They are
    // granted in `sv_script` at SV_BEAT_PATH.

    // ---- the spell tank ---------------------------------------------------
    // Full at spawn, no spell equipped. MAGIC_KINETIC §7.1: the Flare is
    // granted by LIGHTING THE FIRST LANTERN, not by a level-up card, and that
    // edge is in `sv_script`. Equipping one here would spend the best beat in
    // the first minute on a menu.
    spell_fill(sv.sp);
    spell_set_attunement(sv.sp, stats_get(sv.sk, SK_ATTUNEMENT));
    spell_bind(sv.spctx, w, sim_combat(w));
    spell_bind_projectiles(sv.spctx, sim_projectiles(w));
}

// The lantern feed handed to `settle.hml`. Row 0 is the Great Lantern at the
// settlement centre; the rest are the world's lit posts inside the ring. This
// is the ONE place the lighting loop meets the settlement, and it is why
// lighting a post 60 m from the green makes a town grow.
fn sv_lan_reset(p_sv: object) {
    let sv: object = p_sv;
    let st: object = sv.set;
    let a: array<f64> = sv.lan;
    a[0] = settle_cx(st);
    a[1] = settle_cz(st);
    a[2] = 1.0;                 // Great Lantern tier 1
    a[3] = 0.0;                 // wick 0 = UNLIT.  A camp is a dark place.
                                // WICK IS A MAGNITUDE, NOT A FLAG: full is
                                // SET_WICK_FULL = 256, CORE_VILLAGE is 512 and
                                // SET_LUX_PER_POINT is 256. Writing 1.0 here
                                // (the first version of this file) made every
                                // lit lantern worth 1/256 of one, the town
                                // never left brownout, and every trade row
                                // stayed shut with no error anywhere.
    sv.lan_n = 1;
    sv.lan_civic = 1;
    settle_lanterns_set(st, a, 1);
    settle_refresh(st);
}

fn sv_spawn_lantern(p_sv: object, p_x: f64, p_z: f64, p_lit: i32): i32 {
    let sv: object = p_sv;
    let w: object = sv.world;
    let slot: i32 = world_spawn(w, KIND_LANTERN, 0);
    if (slot == SLOT_NONE) { let full: i32 = ID_NONE; return full; }
    let px = w.px; let py = w.py; let pz = w.pz;
    let anim = w.anim; let flags = w.flags; let model = w.model;
    px[slot] = p_x;
    py[slot] = sv_ground(sv.cs, p_x, p_z);
    pz[slot] = p_z;
    anim[slot] = p_lit;
    model[slot] = SV_MODEL_LANTERN;
    flags[slot] = flags[slot] | EF_VISIBLE;
    let out: i32 = world_id_of(w, slot);
    return out;
}

// ===========================================================================
//  5.  THE SCRIPT
// ---------------------------------------------------------------------------
//  Pure function of (session tick, world state). No wall clock, no frame count.
// ===========================================================================

// Spawn `n` bodies of one class on an arc around a point, at a fixed radius.
// The arc is deterministic: no rng draw, because these are AUTHORED spawns and
// an authored spawn that moves with the seed is an authored spawn nobody can
// test. The director's spawns are the random ones and they have their own
// seeded stream.
fn sv_spawn_arc(p_sv: object, p_class: i32, p_n: i32,
                p_cx: f64, p_cz: f64, p_yaw: f64, p_r: f64, p_spread: f64): i32 {
    let sv: object = p_sv;
    let w: object = sv.world;
    let ai: object = sim_ai(w);
    let n: i32 = p_n;
    let made: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        let f: f64 = 0.0;
        if (n > 1) { f = f64(i) / f64(n - 1) - 0.5; }
        let a: f64 = p_yaw + f * p_spread;
        let x: f64 = p_cx + sin(a) * p_r;
        let z: f64 = p_cz - cos(a) * p_r;
        let y: f64 = sv_ground(sv.cs, x, z);
        // Face the spawn back down its own bearing, at the player.
        let yw: f64 = a + 3.141592653589793;
        if (ai_spawn(ai, w, p_class, x, y, z, yw) != ID_NONE) { made++; }
        i++;
    }
    let out: i32 = made;
    return out;
}

fn sv_set_beat(p_sv: object, p_beat: i32) {
    let sv: object = p_sv;
    let b: i32 = p_beat;
    if (b <= sv.beat) { return; }
    sv.beat = b;
    sv.beat_tick = sv.session;
}

// The one place the script runs. Called once per tick, AFTER `sim_step`, so
// every trigger sees the state the tick actually produced.
fn sv_script(p_sv: object): i32 {
    let sv: object = p_sv;
    let w: object = sv.world;
    let s: i32 = sv.session;

    // ---- the timed openers ------------------------------------------------
    if (s >= SV_T_STAND) { sv_set_beat(sv, SV_BEAT_STAND); }
    if (s >= SV_T_STAND + 120) { sv_set_beat(sv, SV_BEAT_SEEK); }

    if (sv.wisps_done == 0 && s >= sv.wisps_at) {
        // GAME_DESIGN §8 at 0:10: "You crest the slope. Three Wisps drift up."
        // They come from BEYOND the lantern, so cresting the slope is what
        // reveals them.
        sv_spawn_arc(sv, g_ENEMY_WISP, SV_N_WISPS,
                     sv.lantern_x, sv.lantern_z, sv.spawn_yaw, 11.0, 1.1);
        sv.wisps_done = 1;
        sv_set_beat(sv, SV_BEAT_WISPS);
    }
    if (sv.mote_done == 0 && s >= sv.mote_at) {
        // 0:18: "A Mote rises from behind a rock." Off to one side, close.
        sv_spawn_arc(sv, g_ENEMY_MOTE, SV_N_MOTES,
                     sv.lantern_x, sv.lantern_z,
                     sv.spawn_yaw - 1.35, 9.0, 0.0);
        sv.mote_done = 1;
        sv_set_beat(sv, SV_BEAT_MOTE);
    }

    // ---- the lantern -------------------------------------------------------
    let lid: i32 = sv.lantern_id;
    if (lid != ID_NONE && sv.lantern_lit == 0) {
        let lslot: i32 = world_slot_of(w, lid);
        if (lslot != SLOT_NONE) {
            let anim = w.anim;
            if (anim[lslot] == SIM_LANTERN_LIT) {
                sv.lantern_lit = 1;
                sv.lantern_lit_tick = s;
                sv.horn_at = s + SV_T_HORN_LAG;
                sv_set_beat(sv, SV_BEAT_LIT);
                // MAGIC_KINETIC §7.1: the Flare is granted by LIGHTING THE
                // FIRST LANTERN, not by a level-up card. This is that line,
                // and it is the reason the spell school opens on the single
                // best beat in the game instead of on a menu.
                sv_spell_grant(sv, g_SPELL_FLARE);
                // Everyone in the settlement hears about a lit lamp.
                if (sv.npcs != null) {
                    npc_credit(sv.npcs, NPC_CRK_LANTERN, -1);
                }
            }
        }
    }

    // ---- 0:33 the horn, and four Husks come up the hill --------------------
    // GAME_DESIGN §8: "It's going to get their attention." The hold is started
    // by the LANTERN, which is what `director.hml`'s header says
    // `director_begin` is for; W5-6 will own this call.
    if (sv.horn_at != SV_MISS && sv.husks_done == 0 && s >= sv.horn_at) {
        let px: f64 = sv.local.px;
        let pz: f64 = sv.local.pz;
        sv_spawn_arc(sv, g_ENEMY_HUSK, SV_N_HUSKS,
                     px, pz, sv.spawn_yaw + 3.141592653589793, 34.0, 1.0);
        sv.husks_done = 1;
        sv_set_beat(sv, SV_BEAT_HORN);
    }
    if (sv.hold_begun == 0 && sv.lantern_lit == 1 &&
        s >= sv.lantern_lit_tick + SV_T_HORN_LAG + 180) {
        // 0:36. Tier 0 refuses (director.hml), and that refusal is REPORTED
        // rather than swallowed: `sv.hold_begun` stays 0 and the owner block's
        // wave state stays IDLE, which the HUD shows.
        if (director_begin(sim_director(w), sv.tick) == 1) {
            sv.hold_begun = 1;
            sv_set_beat(sv, SV_BEAT_WAVE);
        }
    }

    // ---- EVERY NIGHT AFTER THE FIRST STARTS AT THE HORN --------------------
    // >>> THE HOLD IS LONGER THAN THE NIGHT. director.hml DESIGN 8. <<<
    //
    // The two long notes at T-2:00 have been in `daycycle.hml` since W5 and
    // have never done anything except arm the director. Meanwhile the hold
    // this bot actually plays is 294-331 s and the night it has to finish in
    // is 300 s, so `holds done` has been a coin flip since the day both were
    // written: THE_HOUR's second hold cleared with 5.2 s to spare and
    // THE_HOUR_2's tree lost that margin. Bisected across three trees in
    // director.hml DESIGN 8.
    //
    // Starting on the horn gives the hold DUSK (2:00) + NIGHT (5:00) = 420 s.
    // It is the first time the window has been longer than the thing that has
    // to fit in it, and it is the game's own beat: the horn means THEY ARE
    // COMING, which is a sentence about the next two minutes or it is set
    // dressing. The opening does exactly this already -- 0:33 horn, 0:36 four
    // Husks up the hill, in the last of the daylight.
    //
    // >>> `sv.hold_begun == 1` IS LOAD-BEARING AND IS THE REASON THIS LINE IS
    // HERE AND NOT IN `director_step`. <<< HORN_TICK is exactly PHASE_TICK_DUSK
    // and the session's first horn lands at 0:33, three seconds before the
    // block above. A director that armed and began itself at the horn would
    // take the opening's hold away from the script: `director_begin` would
    // return 0 at 0:36, `sv.hold_begun` would stay 0, and SV_BEAT_WAVE -- the
    // beat `probe_waveone` and the whole opening sheet are written against --
    // would never fire. So the script keeps the first hold and the horn takes
    // every one after it.
    //
    // Tier 0 still refuses and that is deliberate, not a hole: a player who is
    // standing inside their own lit town at dusk gets no hold from this line,
    // and `director_step`'s PHASE_NIGHT fallback -- UNCHANGED -- still starts
    // one the moment they walk back out into the dark.
    if (sv.hold_begun == 1) {
        let deh: i32 = director_events(sim_director(w));
        if ((deh & DIR_EV_HORN) != 0) {
            director_begin(sim_director(w), sv.tick);
        }
    }

    // ---- 0:56 the wave clears; 0:58 the path lights ------------------------
    let de: i32 = director_events(sim_director(w));
    if ((de & DIR_EV_WAVE_CLEAR) != 0) {
        sv_set_beat(sv, SV_BEAT_CLEAR);
        if (sv.path_at == SV_MISS) { sv.path_at = s + SV_T_PATH_LAG; }
    }
    if (sv.path_at != SV_MISS && sv.path_done == 0 && s >= sv.path_at) {
        sv.path_lit = sv_light_the_path(sv);
        sv.path_done = 1;
        sv_set_beat(sv, SV_BEAT_PATH);
        // ---- AND THE MEANS TO WALK IT ------------------------------------
        // >>> THE SECOND VERB GETS A SUPPLY, ON THE BEAT THAT ASKS FOR IT. <<<
        //
        // `sv_place_kit` has worked since W7: BTN_USE with nobody and nothing
        // in reach plants an unlit post from the pack, and `sim.hml` stage (g)
        // channels it lit. The only thing ever missing was HAVING one. Wick
        // sells them -- and his row is gated on SET_TIER_VILLAGE AND
        // NPC_BAND_T_TRUSTED, and a Village is what planting them is FOR, so
        // the shop can never be the FIRST supply without the game being a
        // closed loop with no door.
        //
        // It goes here, on SV_BEAT_PATH, and not in the boot path, because
        // this is the beat that means it: five lamps light up pointing at a
        // town 275 m away, and the same instant you find two lanterns in your
        // pack. THE_HOUR's finding was that 0:58 is the last authored beat in
        // the game AND that it hands the player nothing. Now it hands them the
        // only thing the next thirty minutes needs.
        if (sv.npcs != null) {
            npc_pack_grant(sv.npcs, NPC_OFF_KIT, SV_OPEN_KITS);
        }
    }

    // ---- A NIGHT SURVIVED PAYS IN LANTERNS ---------------------------------
    // >>> THE OTHER HALF OF THE SECOND VERB. <<<
    //
    // `DIR_EV_HOLD_DONE` is `director.hml`'s "you held the post until the last
    // wave of the night was cleared" -- the one thing in this game that is
    // unambiguously an ACHIEVEMENT, and until now it paid nothing at all. It
    // incremented `holds_done` and no line of code anywhere read the edge.
    //
    // Two things happen on it, and both already existed and were called from
    // nowhere:
    //
    //   1. SV_HOLD_KITS lantern kits. With SV_OPEN_KITS that is the four posts
    //      a Village needs, so the FIRST hold a player survives is the one
    //      that lets them promote their town -- and no earlier beat can,
    //      because the opening's own posts are held outside SV_PATH_KEEP_M.
    //
    //   2. `NPC_CRK_NIGHT`, +NPC_CR_NIGHT regard with every villager who is
    //      present. `npc.hml:201` has defined it as "a night survived in the
    //      settlement" since W6 and THE_HOUR §5.2 found it called from
    //      NOWHERE IN src/. `NPC_CRK_LANTERN` fires exactly once per session,
    //      on the first lantern, so before this line the game's core verb
    //      awarded relationship progress one time ever. Now a night is worth
    //      a step toward the bands Wick's kit row and Odo's soup sit behind.
    //
    // Both are inside the `de` mask this function already reads for
    // DIR_EV_WAVE_CLEAR, so this costs one branch on one tick per night.
    if ((de & DIR_EV_HOLD_DONE) != 0) {
        if (sv.npcs != null) {
            // >>> AND THE DEEPER THE NIGHT, THE MORE LIGHT YOU CARRY HOME. <<<
            //
            // THE_HOUR_2 §2.4 priced the second rung at "~11 posts,
            // approximately 396 salvage, approximately 80 min" and said 80
            // minutes is too long. This is the half of that answer that is not
            // a price cut. At a flat 2 kits a night, 11 posts is 5.5 nights =
            // 88 minutes no matter how well the player plays, because the
            // payout does not know what they survived: DESIGN 7 built a five-
            // rung tier ladder for the night and every rung of it paid the
            // same two kits.
            //
            // `SV_HOLD_KITS` stays the FLOOR, so the Village arithmetic
            // probe_lanfeed §A pins is untouched to the token: night 1 is
            // pinned at tier 1 by `sim.hml` and by `g_DIR_RAMP_BASE`, so it
            // pays max(2, 1) = 2, `SV_OPEN_KITS + SV_HOLD_KITS` is still
            // exactly 4, and the first Village still costs the same one night.
            // Above that the ladder pays what it costs: tier 3 pays 3, tier 4
            // pays 4, tier 5 pays 5. Nights 1..5 cumulate 4 + 2 + 3 + 4 + 5 =
            // 18 posts against the 11 the second rung wants.
            //
            // And it CANNOT be farmed by standing still, which is the reason
            // it is safe: `director_ramp_cap` only rises on a hold you
            // completed, and the ramp is a min() against the ground under the
            // anchor. `worldgen_shade_tier` is a patchwork, not a radius —
            // DESIGN 7 measured tier 3 thirty metres from the spawn post and
            // tier 4 thirty-two. So a bigger payout is bought by MOVING THE
            // POST OUT INTO DEEPER DARK, which is the sentence the whole game
            // is built on, and the second circuit is that sentence twice.
            let kits: i32 = SV_HOLD_KITS;
            let ht: i32 = director_hold_tier(sim_director(w));
            if (ht > kits) { kits = ht; }
            npc_pack_grant(sv.npcs, NPC_OFF_KIT, kits);
            npc_credit(sv.npcs, NPC_CRK_NIGHT, -1);
        }
    }

    let out: i32 = sv.beat;
    return out;
}

// GAME_DESIGN §8 at 0:58: "A path of small lit lanterns fades in, leading
// downhill and to the left, into fog." Five posts, already lit, on the Wick
// Line spacing (`g_WICKLINE_M` is the link distance; the posts sit well inside
// it so the line is unbroken).
//
// >>> AND NOW IT LEADS SOMEWHERE. <<< The bearing is the one from the post you
// just lit to the settlement green, so the five lamps are an arrow home. The
// SPACING is solved rather than typed: the last post is placed at
// `SV_PATH_END_M` from the green, so `step = (d0 - END) / N`. See the constant
// block above for why that number is not smaller -- four lit posts inside 64 m
// IS a Village, and handing the player four of them at 0:58 would promote the
// town before they had done anything.
//
// The BOW is `SV_PATH_BOW_M * sin(pi * t)` perpendicular to the chord, so the
// line still curves the way the GDD describes instead of reading as a ruler.
// It is zero at both ends, which keeps the last post exactly on its mark, and
// a perpendicular offset can only ever INCREASE a post's distance from the
// green (Pythagoras on the chord) -- so it can never smuggle a post inside the
// keep-out. That is why the bow is safe and why the guard below still exists
// anyway.
//
// THE FALLBACK. If the green is so close to the first post that five posts
// toward it could not clear `SV_PATH_KEEP_M`, the path turns away exactly as
// it always did. `probe_lanfeed` reports how many seeds take this branch; on
// the 128 it measured, none did.
fn sv_light_the_path(p_sv: object): i32 {
    let sv: object = p_sv;
    let st: object = sv.set;
    let x0: f64 = sv.lantern_x;
    let z0: f64 = sv.lantern_z;
    let gx: f64 = settle_cx(st);
    let gz: f64 = settle_cz(st);
    let d0: f64 = sqrt((gx - x0) * (gx - x0) + (gz - z0) * (gz - z0));

    // ---- the fallback: too close to aim at, so aim away, as before --------
    if (d0 < SV_PATH_KEEP_M + f64(SV_PATH_N) * SV_PATH_STEP_MIN) {
        let turn: f64 = SV_PATH_TURN_DEG * 0.017453292519943295;
        let a: f64 = sv.spawn_yaw - turn;          // left of the bearing you walked
        let fx: f64 = x0;
        let fz: f64 = z0;
        let fmade: i32 = 0;
        let fi: i32 = 0;
        while (fi < SV_PATH_N) {
            fx = fx + sin(a) * SV_PATH_STEP_M;
            fz = fz - cos(a) * SV_PATH_STEP_M;
            a = a - turn * 0.25;                   // it curves away, into fog
            if (sv_spawn_lantern(sv, fx, fz, SIM_LANTERN_LIT) != ID_NONE) { fmade++; }
            fi++;
        }
        let fout: i32 = fmade;
        return fout;
    }

    // ---- the chord home, and the unit vectors along and across it ---------
    let ux: f64 = (gx - x0) / d0;
    let uz: f64 = (gz - z0) / d0;
    let rx: f64 = 0.0 - uz;                        // 90 degrees off the chord
    let rz: f64 = ux;
    let step: f64 = (d0 - SV_PATH_END_M) / f64(SV_PATH_N);
    if (step < SV_PATH_STEP_MIN) { step = SV_PATH_STEP_MIN; }
    if (step > SV_PATH_STEP_MAX) { step = SV_PATH_STEP_MAX; }

    let made: i32 = 0;
    let i: i32 = 0;
    while (i < SV_PATH_N) {
        let t: f64 = f64(i + 1) / f64(SV_PATH_N);
        let s: f64 = f64(i + 1) * step;
        let bow: f64 = SV_PATH_BOW_M * sin(3.141592653589793 * t);
        let x: f64 = x0 + ux * s + rx * bow;
        let z: f64 = z0 + uz * s + rz * bow;
        // THE KEEP-OUT, CHECKED ON THE PLACED POINT AND NOT ON THE PLAN. The
        // arithmetic above already guarantees it; this is the line that makes
        // it true rather than intended, and a post that would break it is
        // pulled back onto the keep-out circle instead of being dropped --
        // `probe_game` asserts the path is SV_PATH_N posts long and a path
        // that silently shortened itself would be a second bug.
        let dg: f64 = sqrt((gx - x) * (gx - x) + (gz - z) * (gz - z));
        if (dg < SV_PATH_KEEP_M) {
            if (dg < 1.0) {
                // Dead on the green. Push it back down the chord the player
                // came in on; a zero-length vector has no direction to scale.
                x = gx - ux * SV_PATH_KEEP_M;
                z = gz - uz * SV_PATH_KEEP_M;
            } else {
                let k: f64 = SV_PATH_KEEP_M / dg;
                x = gx + (x - gx) * k;
                z = gz + (z - gz) * k;
            }
        }
        if (sv_spawn_lantern(sv, x, z, SIM_LANTERN_LIT) != ID_NONE) { made++; }
        i++;
    }
    let out: i32 = made;
    return out;
}

// ---------------------------------------------------------------------------
// THE LIT LANTERN TOPS YOU UP.  This is what makes the hold survivable.
// ---------------------------------------------------------------------------
// GAME_DESIGN's lantern is not a checkpoint, it is a supply: BUILD_PLAN W5-6
// lists "respawn and ammo top-up" among `lantern.hml`'s duties, and §2.6's
// whole thesis is "you are at a lantern or you are prey".
//
// It is implemented HERE, now, because without it the first sixty seconds do
// not close. MEASURED, `tools/probe_game.hml` §E with a perfect-aim bot: 18
// rounds (6 + 12), 18 shots fired, 4 reloads, 20 hostiles still standing when
// the wave-1 budget (tier 1 wave 0 = 105 points) had spent itself. The GDD's
// answer at 0:36 is "You will run out. You will MELEE something" — and melee
// is not implemented anywhere in `src/sim/**`: `BTN_MELEE` exists in
// `command.hml`, `DMG_MELEE` exists in `combat.hml`, and nothing reads either.
// REPORTED, not patched: a melee swing is a weapon rule and belongs in
// `weapons.hml` + `sim.hml` stage (c), not in the integrator, because a rule
// applied outside `sim_step` would not survive a replay.
//
// So the survivable version of the beat is the one the design already had: the
// light gives you rounds. One round every `SV_SUPPLY_S` while you stand inside
// a lit lantern's tier-1 radius, up to the opening reserve and no further.
// When `lantern.hml` lands, this moves there and this function is deleted.
export let SV_SUPPLY_S: f64 = 0.8;

fn sv_lantern_supply(p_sv: object) {
    let sv: object = p_sv;
    if (sv.lantern_lit == 0) { return; }
    let l: object = sv.local;
    if (l.dead == 1) { sv.supply_t = 0.0; return; }

    let dx: f64 = sv.lantern_x - l.px;
    let dz: f64 = sv.lantern_z - l.pz;
    if (dx * dx + dz * dz > g_LANTERN_R_T1 * g_LANTERN_R_T1) {
        sv.supply_t = 0.0;
        return;
    }

    let w: object = sv.world;
    let wst: array = sim_weapon_state(w);
    let off: i32 = (sv.pslot - 1) * WS_FIELDS;
    let cur: i32 = wpn_cur(wst, off);
    if (cur < 0) { return; }
    let have: i32 = i32(wst[off + WS_RES0 + cur]);
    if (have >= SV_START_RESERVE) { sv.supply_t = 0.0; return; }

    sv.supply_t = sv.supply_t + g_TICK_DT;
    if (sv.supply_t >= SV_SUPPLY_S) {
        sv.supply_t = sv.supply_t - SV_SUPPLY_S;
        wst[off + WS_RES0 + cur] = f64(have + 1);
        sv.supplied = sv.supplied + 1;
    }
}

// ===========================================================================
//  6.  COMMANDS
// ===========================================================================

// The direct path. `sim_queue_command` COPIES, so the caller's command is
// never aliased.
export fn server_apply_command(p_sv: object, p_pslot: i32, p_cmd: object): i32 {
    let sv: object = p_sv;
    // W7: the overload penalty is applied to a COPY. Mutating the caller's
    // command would tax it twice if a tool re-sent it, and would quietly
    // change an object the caller still owns.
    let c: object = sv.rxcmd;
    cmd_copy(c, p_cmd);
    if (p_pslot == sv.pslot) { sv_load_scale_cmd(sv, c); }
    let out: i32 = sim_queue_command(sv.world, p_pslot, c);
    if (out == 1) { sv.cmds_in = sv.cmds_in + 1; }
    return out;
}

// The wire path. The transport hands back the nine integers exactly as the
// client quantised them; rebuilding the command by assignment (rather than
// through `cmd_set`) is deliberate — `cmd_set` QUANTISES, and quantising an
// already-quantised axis is how a wire value silently changes in transit.
fn sv_drain_transport(p_sv: object): i32 {
    let sv: object = p_sv;
    let t = sv.net;
    if (t == null) { let none: i32 = 0; return none; }

    let q: object = sv.rxq;
    cmdq_reset(q);
    transport_poll_commands(t, q);
    let n: i32 = cmdq_count(q);
    if (n < 1) { let zero: i32 = 0; return zero; }

    let c: object = sv.rxcmd;
    let qt = q.tick;   let qs = q.seq;
    let qx = q.move_x; let qy = q.move_y;
    let qa = q.yaw_q;  let qp = q.pitch_q;
    let qb = q.buttons; let qw = q.weapon_sel; let qd = q.dt_ms;

    let got: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        c.tick = qt[i];
        c.seq = qs[i];
        c.move_x = qx[i];
        c.move_y = qy[i];
        c.yaw_q = qa[i];
        c.pitch_q = qp[i];
        c.buttons = qb[i];
        c.weapon_sel = qw[i];
        c.dt_ms = qd[i];
        // W7: the carry-capacity penalty, §1c. Applied AFTER the wire is
        // decoded and BEFORE the sim sees it, which is the only place an
        // authority may put it and still call the wire value authoritative.
        sv_load_scale_cmd(sv, c);
        if (sim_queue_command(sv.world, sv.pslot, c) == 1) { got++; }
        i++;
    }
    sv.cmds_in = sv.cmds_in + got;
    let out: i32 = got;
    return out;
}

// ===========================================================================
//  7.  THE TICK
// ---------------------------------------------------------------------------
//  ARCHITECTURE §3's inner loop, server half:
//
//      transport_send_command(net, cmd)     <- the client, before this
//      server_tick(sv, tick)                <- HERE
//      client_apply(cl, tick)               <- the client, after this
//
//  Order inside: advance the wire clock, drain, step, script, publish. The
//  wire clock advances FIRST so that a command posted for delivery on this
//  tick is delivered on this tick and not one late; `transport.hml` gates
//  delivery on `now_ms`, and `now_ms` is a tick boundary by construction.
// ===========================================================================

export fn server_tick(p_sv: object, p_tick: i32): i32 {
    let sv: object = p_sv;
    let w: object = sv.world;
    let tick: i32 = p_tick;

    sv.tick = tick;
    sv.session = tick - sv.t0;

    let t = sv.net;
    if (t != null) { transport_set_tick(t, tick, g_TICK_MS); }
    sv_drain_transport(sv);

    sim_step(w, tick);

    // Death and the 4-second respawn. `sim_respawn_player` is the PRIMITIVE
    // and sim.hml's header says the TIMER is game policy and belongs to W4-11.
    // This is W4-11.
    if (sim_player_dead(w, sv.pslot) == 1) {
        if (sv.respawn_t <= 0.0) {
            sv.respawn_t = g_RESPAWN_S;
            sv.deaths = sv.deaths + 1;
        } else {
            sv.respawn_t = sv.respawn_t - g_TICK_DT;
            if (sv.respawn_t <= 0.0) {
                // A lit lantern is where you come back. BUILD_PLAN W5-6 lists
                // "respawn and ammo top-up" as the lantern's, and it is the
                // reason lighting one is worth 2.5 s of standing still. Until
                // the lantern lives in its own module, the authority owns it.
                let rx: f64 = sv.spawn_x;
                let rz: f64 = sv.spawn_z;
                if (sv.lantern_lit == 1) {
                    rx = sv.lantern_x;
                    rz = sv.lantern_z;
                }
                sim_respawn_player(w, sv.pslot, rx, rz);
                sv.respawn_t = 0.0;
            }
        }
    } else {
        sv.respawn_t = 0.0;
    }

    // W6 §7b. AFTER `sim_step`, because every one of these reads a world the
    // sim has already advanced this tick, and BEFORE `sv_script`, because the
    // script's beats (the lantern edge that grants the Flare) must see what
    // they did.
    sv_w6_tick(sv);

    sv_script(sv);
    sv_lantern_supply(sv);
    sv_publish(sv);

    sv.ticks = sv.ticks + 1;
    let out: i32 = 1;
    return out;
}

// ===========================================================================
//  7b. W6 — THE TEN SYSTEMS, TICKED
// ---------------------------------------------------------------------------
//  Ten agents built the night, wave 1, melee, spells, stats, the settlement,
//  its rendering, its people, spell FX and affinities. `sim.hml` predates all
//  ten and calls none of them, and `sim.hml` is not this task's file. So the
//  authority calls them, in this order, and the order is API for exactly the
//  reason ARCHITECTURE §4's is:
//
//      1. melee      — writes damage into the world
//      2. spells     — writes damage into the world
//      3. the UI     — reads the world, writes the player's sheet
//      4. settlement — reads the lit lanterns, writes LUX and buildings
//      5. villagers  — read the settlement, write nothing but themselves
//
//  Damage first, because a settlement that promoted this tick should promote
//  on a world that has already taken this tick's hits.
// ===========================================================================

fn sv_w6_tick(p_sv: object) {
    let sv: object = p_sv;
    let w: object = sv.world;
    let tick: i32 = sv.tick;

    let cmd: object = sim_command(w, sv.pslot);
    let btn: i32 = 0;
    if (cmd != null) { btn = cmd.buttons; }
    let prev: i32 = sv.btn_prev;
    let edge: i32 = btn & (0 - 1 - prev) & 4095;    // rising edges only
    sv.btn_prev = btn;

    let id: i32 = sim_player_id(w, sv.pslot);
    let eslot: i32 = SLOT_NONE;
    if (id != ID_NONE) { eslot = world_slot_of(w, id); }
    let ps: array<f64> = sim_predicted(w, sv.pslot);
    let px: f64 = move_px(ps);
    let pz: f64 = move_pz(ps);
    let eye: f64 = move_eye_y(ps);

    let dead: i32 = sim_player_dead(w, sv.pslot);

    // ---- 1. MELEE --------------------------------------------------------
    // `melee_tick` owns its own press edge (MS_HELD), so the raw command goes
    // in and nothing here debounces it. The stagger clock is per-tick and
    // belongs to every victim, not to the player, so it steps unconditionally.
    melee_stagger_step(sv.mel);
    if (dead == 0 && eslot != SLOT_NONE && cmd != null) {
        melee_tick(sv.mel, sim_combat(w), w, sv.cs, sv.pslot, eslot, eye, cmd);
    }

    // ---- 2. SPELLS -------------------------------------------------------
    // The two inputs the school reads about the world, refreshed every tick:
    // are you standing in light, and what phase is it. Both change the cost
    // and the damage, and both are why you leave town at dusk.
    let lit: i32 = 0;
    if (sv.lantern_lit == 1) {
        let dxl: f64 = sv.lantern_x - px;
        let dzl: f64 = sv.lantern_z - pz;
        if (dxl * dxl + dzl * dzl < g_LANTERN_R_T1 * g_LANTERN_R_T1) { lit = 1; }
    }
    if (lit == 0) {
        if (settle_lux_at(sv.set, px, pz) > 0) { lit = 1; }
    }
    spell_set_lit(sv.sp, lit);
    spell_set_phase(sv.sp, sim_phase(w));

    let casts0: i32 = sv.sp[SP_CASTS];
    if (dead == 0 && id != ID_NONE) {
        if (sv.ui_panel == UI_PANEL_NONE) {
            if ((edge & BTN_SWITCH) != 0) { sv_spell_next(sv); }
            // The Shutter is the one spell with no cooldown and it is HELD,
            // not tapped -- `spell_cast` turns a re-cast on a live beam into a
            // free refresh, so the held bit is correct for it and the rising
            // edge is correct for everything else. Sending both is what makes
            // one key do both jobs without the school knowing which it is.
            let want: i32 = 0;
            if ((edge & BTN_GRENADE) != 0) { want = 1; }
            if ((btn & BTN_GRENADE) != 0) {
                if (spell_active(sv.sp) == g_SPELL_SHUTTER_ID) { want = 1; }
            }
            if (want == 1) { spell_cast(sv.sp, sv.spctx, id); }
        }
        spell_step(sv.sp, sv.spctx, id);
    }
    let casts1: i32 = sv.sp[SP_CASTS];
    sv.sp_cast_edge = 0;
    if (casts1 != casts0) { sv.sp_cast_edge = 1; }
    sv.sp_last_casts = casts1;

    // ---- 2b. THE UNLOCK LADDER -------------------------------------------
    // MAGIC_KINETIC §7.2's unlock levels live in `spells.hml`'s own table and
    // `spell_equip` refuses a spell the player has not reached. So the ladder
    // is a sweep, once a second, of "anything I can hold that I am not
    // holding" -- no second copy of the level table, and no way for the two to
    // disagree.
    if (tick % 60 == 0) {
        let i: i32 = 0;
        while (i < g_SPELL_COUNT) {
            if (i != g_SPELL_FLARE) { sv_spell_grant(sv, i); }
            i++;
        }
    }

    // ---- 2c. W7: THE PURSE AND THE PACK ----------------------------------
    // Before the UI, so a kill on the same tick as a confirm is money the
    // confirm can spend. Once a second, on the same cadence as everything
    // else in this block: `prog_xp_total` cannot move without a kill and a
    // pack cannot get heavier without a trade.
    if (tick % 60 == 0) {
        sv_salvage_tick(sv);
        sv_load_tick(sv);
    }

    // ---- 3. THE MODAL UI -------------------------------------------------
    sv_ui_tick(sv, edge, px, pz, tick);

    // ---- 4. THE SETTLEMENT -----------------------------------------------
    // `settle_step` gates itself on SET_STEP_EVERY (60), so calling it every
    // tick costs one modulo on 59 of every 60 ticks. The lantern feed is
    // rebuilt on the same cadence and not more often: LUX integrates over a
    // rotating slice and handing it a feed that changed mid-sweep is how an
    // accumulator lies.
    if (tick % SV_SETTLE_EVERY == 0) { sv_lan_gather(sv); }
    let sev: i32 = settle_step(sv.set, tick);
    if (sev != 0) {
        sv.settle_events = sv.settle_events | sev;
        if ((sev & SET_EV_PROMOTED) != 0) {
            sv.set_promotions = sv.set_promotions + 1;
        }
    }

    // ---- 5. THE VILLAGERS -------------------------------------------------
    // `npc_step` gates itself on 60 ticks too. Arrivals, the light scan and
    // the promotion notice all live inside it; nothing here duplicates them.
    npc_step(sv.npcs, sv.set, tick);
}

// The spell in the main hand, advanced one equipped slot. Wraps, skips empty
// slots, and is a no-op when nothing has been granted yet -- which is the
// state the whole of the first minute is in.
fn sv_spell_next(p_sv: object) {
    let sv: object = p_sv;
    let n: i32 = spell_slots(sv.sp);
    let cur: i32 = -1;
    let i: i32 = 0;
    while (i < n) {
        if (spell_equipped(sv.sp, i) == spell_active(sv.sp)) {
            if (spell_equipped(sv.sp, i) >= 0) { cur = i; i = n; }
        }
        i++;
    }
    let k: i32 = 1;
    while (k <= n) {
        let s: i32 = (cur + k) % n;
        if (spell_equipped(sv.sp, s) >= 0) {
            spell_select(sv.sp, s);
            k = n + 1;
        } else { k++; }
    }
}

// Grant a spell into the first free slot. Idempotent: a spell already granted
// is never granted twice, which is what keeps the "UNLOCKED" card honest.
fn sv_spell_grant(p_sv: object, p_id: i32): i32 {
    let sv: object = p_sv;
    let id: i32 = p_id;
    if (id < 0) { let z: i32 = 0; return z; }
    if (id >= g_SPELL_COUNT) { let z2: i32 = 0; return z2; }
    let bit: i32 = 1 << id;
    if ((sv.sp_granted & bit) != 0) { let z3: i32 = 0; return z3; }
    let n: i32 = spell_slots(sv.sp);
    let lvl: i32 = prog_level(sim_progression(sv.world, sv.pslot));
    let s: i32 = 0;
    while (s < n) {
        if (spell_equipped(sv.sp, s) < 0) {
            // `SPELL_OK` IS ZERO. `spell_equip` returns an ERROR CODE, not a
            // boolean, and `== 1` here silently granted nothing for a whole
            // round of testing -- the lantern lit, the card never came up and
            // the school stayed empty. Compare against the name.
            if (spell_equip(sv.sp, s, id, lvl) == SPELL_OK) {
                sv.sp_granted = sv.sp_granted | bit;
                if (spell_active(sv.sp) < 0) { spell_select(sv.sp, s); }
                let ok: i32 = 1;
                return ok;
            }
            s = n;
        } else { s++; }
    }
    let no: i32 = 0;
    return no;
}

// ---------------------------------------------------------------------------
// THE LANTERN FEED. Every lit lantern in the world, plus the Great Lantern,
// handed to `settle.hml` as (x, z, tier, wick). THIS IS THE LOOP: the player
// lights a post, the post enters this array, `settle_step` integrates it into
// CORE_LUX, CORE_LUX promotes the tier, the tier brings a villager. One
// function connects the 30 seconds to the 30 hours.
// ---------------------------------------------------------------------------
fn sv_lan_gather(p_sv: object) {
    let sv: object = p_sv;
    let w: object = sv.world;
    let st: object = sv.set;
    let a: array<f64> = sv.lan;

    // row 0: the Great Lantern. Its wick is 1 once the settlement has any lit
    // post inside its ring -- a camp with a lit lamp on the green IS the
    // beginning of a village, and `settle_great_tier` reads exactly this row.
    a[0] = settle_cx(st);
    a[1] = settle_cz(st);
    // >>> a[2] IS THE GREAT LANTERN'S TIER AND THIS LINE USED TO WRITE 1.0
    // OVER IT, ONCE A SECOND, FOREVER. <<<
    //
    // It is the same shape as the `w.model`/`w.anim` disaster forty lines
    // down, and it had the same cause: the only paths that ever reached a
    // TOWN went through `server_settle_boot_tier`, A FIXTURE, which writes
    // the lantern array itself and therefore writes tier 2 directly.
    //
    // `settle_promote_check` gates every rung on THREE numbers, not two:
    // grid points, CORE_LUX, and `settle_great_tier` >= `settle_tier_gl(t)`.
    // `SET_GL_TOWN` is 2. `settle_great_tier` reads exactly `a[2]`. The one
    // thing in the entire game that raises it is Wick's offer row 12,
    // `NPC_OFF_LANTERN`, arg 2, price 90, tier VILLAGE, regard 0 -- open to
    // any player the minute they have a Village, and affordable: THE_HOUR_2
    // measured the earned Village ending its hour holding 292 salvage with
    // nothing to buy. `npc_trade` raises `a[2]` to 2.0 and calls
    // `settle_lanterns_set` -- and this sweep put it back within
    // SV_SETTLE_EVERY ticks, every time, so `settle_great_tier` could only
    // ever return 1 in a real session and `settle_promote_check` could never
    // return TOWN.
    //
    // THE_HOUR_2 §2.4 priced the second rung at "~11 posts, approximately 396
    // salvage, approximately 80 min". THAT GRIND WOULD HAVE ENDED IN NOTHING.
    // The rung was not mispriced; it was unreachable at any price, and the
    // price was never the part that was wrong.
    //
    // The floor stays 1 because a settlement always has its Great Lantern and
    // `settle_great_tier` clamps to [0, g_LANTERN_TIERS] anyway; what this
    // stops is the sweep DEMOTING one the player paid for.
    if (a[2] < 1.0) { a[2] = 1.0; }
    let n: i32 = sv.lan_civic;

    let ring: f64 = settle_ring_m(SET_TIER_CITY);
    let cx: f64 = settle_cx(st);
    let cz: f64 = settle_cz(st);
    let cap: i32 = SV_LAN_CAP;
    let great: f64 = 0.0;

    let cnt: i32 = world_count(w);
    let slot: i32 = 0;
    while (slot < cnt) {
        if (n >= cap) { slot = cnt; }
        else {
            let kd = w.kind;
            let fl = w.flags;
            if (kd[slot] == KIND_LANTERN && (fl[slot] & EF_DEAD) == 0) {
                // `anim`, NOT `model`. This read was `w.model` for four waves
                // and it switched off the entire second half of the game.
                // `sv_spawn_lantern` writes the LIT FLAG to `anim[slot]` and
                // the MESH ID to `model[slot]` (SV_MODEL_LANTERN = 90), so the
                // test was `90 == 1` -- false for every lantern that has ever
                // existed. `sv_lan_gather` therefore always gathered zero, lux
                // never accumulated, the settlement never promoted past CAMP,
                // and 17 buildings and 14 villagers sat in memory unrendered
                // for every frame of every session. Line 1041 of this same
                // file reads `anim` correctly; these two disagreed in silence
                // because nothing in the suite ever ran this function -- the
                // town probes reach their town through `server_settle_boot_
                // tier`, a FIXTURE that bypasses it entirely.
                let md = w.anim;
                if (md[slot] == SIM_LANTERN_LIT) {
                    let xs = w.px; let zs = w.pz;
                    let lx: f64 = xs[slot];
                    let lz: f64 = zs[slot];
                    let dx: f64 = lx - cx;
                    let dz: f64 = lz - cz;
                    if (dx * dx + dz * dz <= ring * ring) {
                        a[n * 4] = lx;
                        a[n * 4 + 1] = lz;
                        a[n * 4 + 2] = 1.0;              // post tier 1
                        a[n * 4 + 3] = f64(SET_WICK_FULL);
                        n++;
                        great = f64(SET_WICK_FULL);
                    }
                }
            }
            slot++;
        }
    }
    // THE GREAT LANTERN'S WICK. It burns if any post inside the ring is lit,
    // and it also burns once the settlement has ever BEEN a village -- because
    // that is what `SET_CORE_FLOOR` already says in `settle.hml` ("a village
    // never falls below core 512") and a town whose own lamp reads unlit would
    // demote itself on the next sweep. Without this the ladder is a ratchet
    // that slips.
    if (settle_tier_ever(st) >= SET_TIER_VILLAGE) { great = f64(SET_WICK_FULL); }
    a[3] = great;
    sv.lan_n = n;
    settle_lanterns_set(st, a, n);

    // >>> AND THE SECOND HALF OF THE SAME BUG, FOUND BY probe_lanfeed. <<<
    //
    // `settle_refresh` is what makes an injected lantern set MEAN something,
    // and its own header says so: "Used at construction, on load, AFTER A
    // LANTERN SET INJECTION, and by the probe." `sv_lan_reset` (forty lines
    // up) obeys that. This function did not, and the asymmetry was invisible
    // until a session actually got past eight lanterns.
    //
    // WHY EIGHT. `settle_lanterns_set` ends with `acc_valid = 0` -- correct,
    // and probe_settle H17 put it there: a sweep in flight was built against
    // the PREVIOUS set. `settle_step` re-integrates SET_SLICE = 8 rows per
    // second on a rotating slice and only commits `core_lux` / `grid_lux` on
    // the LAST slice, `if (sl == nsl - 1 && st.acc_valid == 1)`. With n <= 8
    // there is one slice, so reset, integrate and commit all happen in the one
    // call and everything works. With n > 8 there are two, and this function
    // runs on the SAME tick and BEFORE `settle_step` (server_tick: gather at
    // `tick % SV_SETTLE_EVERY`, then `settle_step(sv.set, tick)`), so it zeroes
    // `acc_valid` before every commit tick. THE COMMIT THEN NEVER HAPPENS
    // AGAIN, for the rest of the session.
    //
    // MEASURED, seed 1337, ARM PLANT, four posts lit inside the 64 m ring:
    //
    //     without this line   grid 1024 -> 4 pts of 10   core 624   frozen
    //     with it             grid 2560 -> 10 pts of 10  core 736   VILLAGE
    //
    // 1024 is exactly the value the field had at the moment the ninth lantern
    // entered the feed: the Great Lantern plus ONE post. Every post the player
    // planted after that was gathered, linked, hashed and rendered -- and
    // counted for nothing. The town was switched off a second time, one slice
    // further down, and no probe could see it because none of them ever got a
    // ninth lantern into a real session.
    //
    // COST: `settle_refresh` is O(n) over at most SV_LAN_CAP = 96 rows, once
    // per second. It is strictly CHEAPER than the `settle_links_rebuild` that
    // `settle_lanterns_set` already runs on the line above, which is O(n^2)
    // on the same cadence. Measured whole-frame cost of the change: below the
    // noise floor of min-of-7 (see the task report).
    //
    // >>> DECLARED SCOPE. <<< This is a fourth function in this file, and the
    // task named three. It is one line, it is the difference between the loop
    // closing and not closing, and it restores a contract `settle.hml` states
    // in its own header rather than inventing a new one.
    settle_refresh(st);
}

// ---------------------------------------------------------------------------
// W7 — THE ECONOMY. Three functions: what you earned, what you are carrying,
// and what carrying it costs you.
// ---------------------------------------------------------------------------

// INCOME. One delta on `prog_xp_total`, converted at a fixed rate, with the
// remainder LEFT ON THE COUNTER — `xp_seen` only advances by whole salvage, so
// eleven kills worth 24 XP each pay eleven times over rather than rounding
// away to nothing. Called once a second, not once a tick: the purse is not a
// per-frame quantity and `prog_xp_total` cannot change without a kill.
fn sv_salvage_tick(p_sv: object) {
    let sv: object = p_sv;
    if (sv.npcs == null) { return; }
    let pr: array = sim_progression(sv.world, sv.pslot);
    let total: i32 = prog_xp_total(pr);
    let seen: i32 = sv.xp_seen;
    if (total <= seen) { return; }
    let gained: i32 = total - seen;
    let coins: i32 = idivi(gained, SV_XP_PER_SALVAGE);
    if (coins <= 0) { return; }
    npc_purse_add(sv.npcs, coins);
    sv.xp_seen = seen + coins * SV_XP_PER_SALVAGE;
}

// Integer divide. `/` in Hemlock always yields f64 (CLAUDE.md §4's API
// corrections), and an f64 round-trip on a counter is how a purse loses a coin
// once every few hours.
fn idivi(p_a: i32, p_b: i32): i32 {
    let out: i32 = i32(f64(p_a) / f64(p_b));
    return out;
}

// WHAT YOU ARE CARRYING, IN KILOGRAMMES. The gun in your hands, the lantern
// you never put down, the brass FOR THAT GUN, and the pack.
//
// >>> ONLY THE WEAPON IN HAND. <<<  `wpn_state_new` hands every slot all six
// guns with full reserves — 709 rounds — and the boot path only trims the
// Kestrel to the GDD's twelve. Weighing all six would put the player 26 kg
// over a Capacity-0 limit of 18 before they had made a single decision, which
// is not a packing decision, it is a permanent tax on existing. DIRECTION §7
// asks what you BRING; the answer is the gun you brought and its brass.
fn sv_load_kg(p_sv: object): f64 {
    let sv: object = p_sv;
    let wst: array = sim_weapon_state(sv.world);
    let off: i32 = (sv.pslot - 1) * WS_FIELDS;
    let cur: i32 = wpn_cur(wst, off);
    let rounds: f64 = 0.0;
    // `wpn_valid`, not a literal 6.  W6-6 widened the gun table to eight and
    // this bound was baked in: a player carrying the Blackthorn or the Nettle
    // would have weighed exactly SV_KG_GUN + SV_KG_LANTERN and their 240
    // rounds of pipe-gun brass would have been free.  CLAUDE.md's own lesson —
    // "if your task changes a global, grep for every place it was baked into a
    // literal" — and this is the place it was.
    if (wpn_valid(cur) == 1) {
        rounds = wst[off + WS_RES0 + cur] + wst[off + WS_MAG0 + cur];
    }
    let kg: f64 = SV_KG_GUN + SV_KG_LANTERN + rounds * SV_KG_PER_ROUND;
    if (sv.npcs != null) { kg = kg + npc_pack_kg(sv.npcs); }
    let out: f64 = kg;
    return out;
}

// The equipment mask the character is WEARING: whatever they have bought.
// `stats.hml` prices the bandolier, the pouches and the pack in kilogrammes of
// extra capacity, and this is the only thing in the game that sets that mask.
fn sv_fit_mask(p_sv: object): i32 {
    let sv: object = p_sv;
    if (sv.npcs == null) { let none: i32 = SK_EQ_NONE; return none; }
    let out: i32 = npc_fit_mask(sv.npcs) & SK_EQ_ALL;
    return out;
}

// Recompute load, capacity, overload and the movement multiplier. Once a
// second alongside income: the multiplier is applied to every command, but
// what it IS only changes when the pack or the reserve does.
fn sv_load_tick(p_sv: object) {
    let sv: object = p_sv;
    let fit: i32 = sv_fit_mask(sv);
    let load: f64 = sv_load_kg(sv);
    let l: object = sv.local;
    l.load_kg = load;
    l.carry_kg = stats_carry_kg(sv.sk, fit);
    l.overload = stats_overload01(sv.sk, fit, load);
    let m: f64 = stats_move_mult(sv.sk, fit, load);
    if (m < SV_LOAD_MIN_MULT) { m = SV_LOAD_MIN_MULT; }
    if (m > 1.0) { m = 1.0; }
    sv.move_mult = m;
    l.move_mult = m;
    l.fit = fit;
}

// THE PENALTY, APPLIED. Scales the quantised movement axes of a command in
// place. See §1c: `dq_axis` is linear and `move_apply_ex` multiplies the wish
// speed by the axis magnitude, so this is exactly `stats_move_mult` and not an
// approximation of it. A multiplier of 1.0 returns immediately, which is every
// command the player sends before their first trade.
fn sv_load_scale_cmd(p_sv: object, p_c: object) {
    let sv: object = p_sv;
    let m: f64 = sv.move_mult;
    if (m >= 0.9999) { return; }
    let c: object = p_c;
    c.move_x = i32(f64(c.move_x) * m);
    c.move_y = i32(f64(c.move_y) * m);
}

// PLACE A LANTERN KIT. `BTN_USE` with no panel open, no lantern in reach and
// no villager in reach — three conditions that are already computed, and a
// fourth key the input map does not have. Returns 1 if a post went down.
//
// The gap check is not politeness: `sv_lan_gather` integrates every lit post
// inside the ring and `settle.hml` saturates CORE_LUX, so a pile of twelve
// posts on one square metre would read as one lantern's worth of light and
// look like a bug in the settlement rather than in the player.
// HOW MANY LANTERN KITS ARE IN THE PACK, RIGHT NOW. One scan, off the store
// itself rather than off the published owner block, so the plant gate and the
// plant agree within a tick.
fn sv_kits_now(p_sv: object): i32 {
    let sv: object = p_sv;
    if (sv.npcs == null) { let z: i32 = 0; return z; }
    let r: i32 = npc_pack_find_kind(sv.npcs, NPC_OFF_KIT);
    if (r < 0) { let none: i32 = 0; return none; }
    let out: i32 = npc_pack_count(sv.npcs, r);
    return out;
}

fn sv_place_kit(p_sv: object, p_x: f64, p_z: f64): i32 {
    let sv: object = p_sv;
    if (sv.npcs == null) { let no: i32 = 0; return no; }
    let row: i32 = npc_pack_find_kind(sv.npcs, NPC_OFF_KIT);
    if (row < 0) { let none: i32 = 0; return none; }

    let w: object = sv.world;
    let gap: f64 = SV_KIT_MIN_GAP_M * SV_KIT_MIN_GAP_M;
    let cnt: i32 = world_count(w);
    let kd = w.kind;
    let fl = w.flags;
    let xs = w.px;
    let zs = w.pz;
    let slot: i32 = 0;
    while (slot < cnt) {
        if (kd[slot] == KIND_LANTERN && (fl[slot] & EF_DEAD) == 0) {
            let dx: f64 = xs[slot] - p_x;
            let dz: f64 = zs[slot] - p_z;
            if (dx * dx + dz * dz < gap) { let close: i32 = 0; return close; }
        }
        slot++;
    }

    if (sv_spawn_lantern(sv, p_x, p_z, SIM_LANTERN_UNLIT) == ID_NONE) {
        let full: i32 = 0;
        return full;
    }
    npc_pack_spend(sv.npcs, row);
    sv.kits_placed = sv.kits_placed + 1;

    // ---- THE VERDICT, LATCHED AT THE MOMENT OF PLANTING -------------------
    // "This one counted" has to be decided HERE, where the post's coordinates
    // are, and not sixteen minutes later when the tier flips. The ring is
    // `settle_ring_m(tier_ever)` -- the same ring `settle_grid_sum` integrates
    // over and the same one `sv_publish` puts on the wire as `set_inside`, so
    // the verdict and the settlement's own arithmetic cannot disagree.
    //
    // `kit_verdict_n` is MONOTONE and equals `kits_placed`, which is what lets
    // a client adopt the edge exactly once over a lossy wire (the same shape
    // as `weapon_force_n`). `probe_teach` §C asserts, on every plant of a real
    // session, that the verdict latched here equals the one the HUD derives
    // from `set_inside` alone -- so the picture and the authority are checked
    // against each other rather than both against a comment.
    let st: object = sv.set;
    let vdx: f64 = settle_cx(st) - p_x;
    let vdz: f64 = settle_cz(st) - p_z;
    let vd: f64 = sqrt(vdx * vdx + vdz * vdz);
    sv.kit_verdict_d = vd;
    sv.kit_verdict = TEACH_V_OUTSIDE;
    if (vd <= settle_ring_m(settle_tier_ever(st))) { sv.kit_verdict = TEACH_V_INSIDE; }
    sv.kit_verdict_n = sv.kits_placed;

    let ok: i32 = 1;
    return ok;
}

// ---------------------------------------------------------------------------
// THE MODAL UI. Four edges and a cursor. Everything it does is a call into a
// module that already existed; nothing here re-implements a rule.
// ---------------------------------------------------------------------------
fn sv_ui_tick(p_sv: object, p_edge: i32, p_px: f64, p_pz: f64, p_tick: i32) {
    let sv: object = p_sv;
    let edge: i32 = p_edge;
    let tick: i32 = p_tick;

    if (sv.ui_msg != UI_MSG_NONE) {
        if (tick - sv.ui_msg_tick > UI_MSG_TICKS) { sv.ui_msg = UI_MSG_NONE; }
    }

    // Who is close enough to speak to, this tick.
    let who: i32 = NPC_NONE;
    if (sv.npcs != null) {
        who = npc_talk_target(sv.npcs, sv.set, p_px, p_pz, tick);
    }
    sv.talk_who = who;

    // A panel closes itself when the person it is about walks away, or when
    // you die. A modal that survives a death is a modal you fight through.
    if (sv.ui_panel == UI_PANEL_TRADE) {
        if (who == NPC_NONE) { sv.ui_panel = UI_PANEL_NONE; }
    }
    if (sim_player_dead(sv.world, sv.pslot) == 1) { sv.ui_panel = UI_PANEL_NONE; }

    // ---- the toggles -----------------------------------------------------
    if ((edge & BTN_INV) != 0) {
        if (sv.ui_panel == UI_PANEL_CHAR) { sv.ui_panel = UI_PANEL_NONE; }
        else { sv.ui_panel = UI_PANEL_CHAR; sv.ui_row = 0; }
    }
    if ((edge & BTN_BUILD) != 0) {
        if (sv.ui_panel == UI_PANEL_TRADE) { sv.ui_panel = UI_PANEL_NONE; }
        else {
            if (who == NPC_NONE) { sv_ui_say(sv, UI_MSG_NOBODY, tick); }
            else {
                sv.ui_panel = UI_PANEL_TRADE;
                // >>> THE CURSOR OPENS ON SOMETHING YOU CAN ACTUALLY TAKE. <<<
                // This one line is the bug the gate found. Mabel's row 0 is
                // the bolt-action — the thesis row, correctly first, and NOT
                // BUILT — so a cursor that opened on 0 meant "press T, press
                // C, nothing happens" on the most important villager in the
                // game. Opening on the first row `npc_trade_check` says yes to
                // makes T-then-C a completed trade, and the ladder above the
                // cursor is still drawn, still gated, still visible.
                let f: i32 = npc_trade_first_open(sv.npcs, sv.set, who);
                if (f < 0) { f = 0; }
                sv.ui_row = f;
            }
        }
    }

    // ---- how many rows the open panel has --------------------------------
    let rows: i32 = 0;
    if (sv.ui_panel == UI_PANEL_CHAR) { rows = SV_UI_STAT_ROWS; }
    if (sv.ui_panel == UI_PANEL_TRADE) {
        if (who != NPC_NONE) { rows = npc_offer_count(who); }
    }
    sv.ui_rows = rows;
    if (rows < 1) { sv.ui_row = 0; }
    else { if (sv.ui_row >= rows) { sv.ui_row = 0; } }

    // ---- TALK. The same key that lights a lantern. ------------------------
    // The lantern wins when both are in reach, because the lantern is the
    // verb the whole game is about and because `in_reach` is only ever 1 for
    // an UNLIT one -- so the ambiguity lasts exactly as long as the job does.
    if ((edge & BTN_USE) != 0) {
        if (sv.ui_panel == UI_PANEL_NONE && sv.local.in_reach == 0) {
            if (who != NPC_NONE) {
                let t: i32 = npc_talk(sv.npcs, sv.set, who, tick);
                sv.talk_topic = t;
                sv.talk_arg = npc_topic_arg(sv.npcs, sv.set, who, tick);
                sv.talk_tick = tick;
                sv.talks = sv.talks + 1;
            } else {
                // NOBODY AND NOTHING IN REACH: plant a lantern kit if you are
                // carrying one. Third in the priority order and last for a
                // reason — the lantern wins, then the person, then the post
                // you brought with you. No new key, no new wire field.
                //
                // >>> THE GATE IS `teach_plant_ready` AND NOT A COPY OF IT. <<<
                // The HUD draws the prompt off this same call, so the sentence
                // on screen and the thing the key does are one boolean. See
                // the TEACH block above the constants.
                // The pack is read LIVE and not off `sv.local`, which
                // `sv_publish` writes at the END of the tick and is therefore
                // one tick stale on the tick you spend your last kit.
                if (teach_plant_ready(sv_kits_now(sv), sv.local.in_reach,
                                      who, sv.ui_panel,
                                      sim_player_dead(sv.world, sv.pslot)) == 1) {
                    sv_place_kit(sv, p_px, p_pz);
                }
            }
        }
    }

    if (sv.ui_panel == UI_PANEL_NONE) { return; }

    // ---- the cursor and the confirm --------------------------------------
    if ((edge & BTN_SWITCH) != 0) {
        if (rows > 0) { sv.ui_row = (sv.ui_row + 1) % rows; }
    }
    if ((edge & BTN_GRENADE) != 0) {
        if (sv.ui_panel == UI_PANEL_CHAR) { sv_ui_spend(sv, sv.ui_row, tick); }
        else { sv_ui_trade(sv, who, sv.ui_row, tick); }
    }
}

fn sv_ui_say(p_sv: object, p_msg: i32, p_tick: i32) {
    let sv: object = p_sv;
    sv.ui_msg = p_msg;
    sv.ui_msg_tick = p_tick;
}

// SPEND A STAT POINT. `stats.hml` owns the budget, the cap and the level
// curve; this is a rising edge and a call.
fn sv_ui_spend(p_sv: object, p_stat: i32, p_tick: i32) {
    let sv: object = p_sv;
    let stat: i32 = p_stat;
    if (stat < 0 || stat >= SK_COUNT) { return; }
    let pr: array = sim_progression(sv.world, sv.pslot);
    if (stats_unspent(sv.sk, pr) <= 0) {
        sv_ui_say(sv, UI_MSG_NO_POINTS, p_tick);
        return;
    }
    if (stats_can_raise(sv.sk, pr, stat) == 0) {
        sv_ui_say(sv, UI_MSG_STAT_MAX, p_tick);
        return;
    }
    if (stats_raise(sv.sk, pr, stat) == 1) {
        sv.points_spent = sv.points_spent + 1;
        sv_ui_say(sv, UI_MSG_POINT, p_tick);
        // Attunement is the one stat another module reads directly, and it
        // changes oil cost, cooldown, potency and SLOT COUNT. Push it the
        // instant it moves rather than once a second, or the panel says 5 and
        // the tank says 4.
        if (stat == SK_ATTUNEMENT) {
            spell_set_attunement(sv.sp, stats_get(sv.sk, SK_ATTUNEMENT));
        }
    }
}

// TAKE AN OFFER. `p_row` is the villager's LOCAL row; `npc_offer_first` turns
// it into the global one, because the trade panel iterates one person's rows
// and has no business knowing where in the table they start.
//
// >>> W7 — THE DECISION IS `npc.hml`'s; THE EFFECT IS THIS FILE'S. <<<
// `npc_trade_take` checks the gate, the price, the class and the "you already
// own that", debits the purse and moves the goods. It returns `NPC_TR_OK` or
// the reason it did not, and by then the player has ALREADY BEEN CHARGED — so
// every path below `NPC_TR_OK` must apply an effect, and none of them may
// refuse. Splitting it the other way (effect first, charge after) is how a
// shop gives away a rifle when a `wpn_swap_begin` fails.
//
// >>> §7b.5 — THE HONEST GAP, CLOSED IN W6-6 <<<
// `NPC_OFF_WEAPON`'s four arguments are `NPC_VW_BOLT`, `NPC_VW_PIPESMG`,
// `NPC_VW_REVOLVER`, `NPC_VW_PUMP` -- DIRECTION.md §3's village-tier guns.
// This block used to say none of the four existed, and it was right: the
// weapon table had six rows and all six were City-tier. It has eight now.
// `weapons.hml`'s `g_wpn_tier` classifies { BLACKTHORN, KESTREL, BELLOWS,
// NETTLE } as VILLAGE -- the Kestrel and the Bellows were RECLASSIFIED rather
// than duplicated, which is why only two rows are new -- and `npc_vw_weapon`
// is the alias `npc.hml` always said it would become. The old note warned that
// "mapping a bolt-action onto the Longshadow because both are rifles would
// make the trade panel look finished and the game a liar"; that warning still
// stands, and the Blackthorn is a genuinely different gun (45 RPM, 5 rounds,
// stripper clips, a 0.55 s bolt cycle) rather than a rename of one.
fn sv_ui_trade(p_sv: object, p_who: i32, p_row: i32, p_tick: i32) {
    let sv: object = p_sv;
    let who: i32 = p_who;
    if (who == NPC_NONE) { sv_ui_say(sv, UI_MSG_NOBODY, p_tick); return; }
    let first: i32 = npc_offer_first(who);
    if (first < 0) { sv_ui_say(sv, UI_MSG_NO_TRADE, p_tick); return; }
    let g: i32 = first + p_row;

    // ---- the money and the goods ------------------------------------------
    let why: i32 = npc_trade_take(sv.npcs, sv.set, g);
    if (why != NPC_TR_OK) {
        sv.trades_refused = sv.trades_refused + 1;
        if (why == NPC_TR_UNBUILT) { sv_ui_say(sv, UI_MSG_UNBUILT, p_tick); }
        else if (why == NPC_TR_POOR) { sv_ui_say(sv, UI_MSG_NO_SALVAGE, p_tick); }
        else if (why == NPC_TR_HAVE) { sv_ui_say(sv, UI_MSG_HAVE, p_tick); }
        else { sv_ui_say(sv, UI_MSG_NO_TRADE, p_tick); }
        return;
    }

    // ---- the effect. Charged already; every branch delivers. ---------------
    let kind: i32 = npc_offer_kind(g);
    let arg: i32 = npc_offer_arg(g);
    let cls: i32 = npc_offer_class(g);
    let w: object = sv.world;

    if (kind == NPC_OFF_AMMO) {
        // DIRECTION.md §7: "the city as CHEAP RESUPPLY rather than the sole
        // source of ammunition." The reserve is what a trade moves — and now
        // the brass WEIGHS something, so a full resupply is a real decision
        // and not a free button.
        let wst: array = sim_weapon_state(w);
        let off: i32 = (sv.pslot - 1) * WS_FIELDS;
        let cur: i32 = wpn_cur(wst, off);
        wst[off + WS_RES0 + cur] = wst[off + WS_RES0 + cur] + f64(SV_TRADE_AMMO);
    } else if (kind == NPC_OFF_WEAPON) {
        // >>> §7b.5's HONEST GAP, CLOSED. <<<  The four `NPC_OFF_WEAPON` rows
        // used to be `NPC_OC_UNBUILT` because DIRECTION.md §3's village tier
        // did not exist in `weapons.hml`.  W6-6 forged it, `npc_vw_weapon`
        // turns an NPC_VW_* ordinal into a real WPN_* id, and this branch does
        // for a bench-crafted gun exactly what the branch below does for a
        // manufactured one: full reserve, then put it in the player's hands.
        //
        // The two branches stay SEPARATE rather than merging on "it is a gun",
        // because the gates are not the same: a village gun needs a Village and
        // a person who knows you, a manufactured one needs a lit Foundry
        // (DIRECTION §8a).  Both gates are `npc_offer_open`'s and both were
        // already checked inside `npc_trade_take`; what differs is the ARG,
        // and one id space per branch is why nothing here has to guess.
        //
        // >>> W7-3: `wpn_grant`, NOT `wpn_swap_begin`. <<<  This one word is
        // the whole of the bug the gate found.  `wpn_swap_begin` started a
        // swap and changed nothing else, so 1.48 s later `sim.hml` swapped
        // straight back to whatever the client's unchanged `weapon_sel` still
        // said — the panel said TAKEN, the purse was debited, the counter read
        // `trades 2`, and the rifle was gone.  `wpn_grant` does the three
        // things a shop actually has to do: SET THE OWNERSHIP BIT (so the swap
        // is legal at all, now and on every later tick), start the swap, and
        // PUBLISH THE EDGE that tells the client to stop asking for the old
        // gun.  Buying a gun is a permanent change to what you own; it was
        // being implemented as a temporary change to what you hold.
        let wv: i32 = npc_vw_weapon(arg);
        if (wpn_valid(wv) == 1) {
            let wstv: array = sim_weapon_state(w);
            let offv: i32 = (sv.pslot - 1) * WS_FIELDS;
            wstv[offv + WS_RES0 + wv] = f64(wpn_reserve(wv));
            wpn_grant(wstv, offv, wv);
        }
    } else if (kind == NPC_OFF_MFG) {
        // `arg` is a genuine WPN_* id and the Foundry gate is
        // `npc_offer_open`'s, already checked inside `npc_trade_take`.
        let wst2: array = sim_weapon_state(w);
        let off2: i32 = (sv.pslot - 1) * WS_FIELDS;
        if (wpn_valid(arg) == 1) {
            wst2[off2 + WS_RES0 + arg] = f64(SV_TRADE_MFG_RESERVE);
            wpn_grant(wst2, off2, arg);
        }
    } else if (kind == NPC_OFF_SOUP) {
        // Odo's whole character. GAME_DESIGN §5: "keeps soup warm past
        // midnight."
        sv_heal_full(sv);
    } else if (kind == NPC_OFF_SLEEP) {
        // A BED. Heals like the soup does and refills the oil tank, because
        // sleeping is the one thing in the game that should restore BOTH
        // resources — and `spell_fill` is `spells.hml`'s own word for it.
        sv_heal_full(sv);
        spell_fill(sv.sp);
    } else if (kind == NPC_OFF_LANTERN) {
        // Wick raises the Great Lantern's tier, which widens the ring every
        // lit post is integrated over -- the single most load-bearing number
        // in SETTLEMENT.md's ladder.
        let a: array<f64> = sv.lan;
        let t: f64 = a[2] + 1.0;
        if (t > f64(g_LANTERN_TIERS)) { t = f64(g_LANTERN_TIERS); }
        a[2] = t;
        settle_lanterns_set(sv.set, a, sv.lan_n);
    }
    // `NPC_OC_FIT` and `NPC_OC_STOCK` need NOTHING here. The equipment bit and
    // the pack count are already set by `npc_trade_take`, and `sv_load_tick`
    // reads both next second. That is the point of putting the ledger in one
    // place: a bandolier is a number in a mask, not a special case in a switch.

    sv.trades = sv.trades + 1;
    // TAKEN, or TAKEN AND NOW YOU ARE OVER YOUR LIMIT. `stats.hml` §8 is
    // explicit that overloading is a COST and never a refusal, so this is a
    // different WORD for the same successful trade, not a different outcome.
    sv_load_tick(sv);
    let msg: i32 = UI_MSG_TRADED;
    if (sv.local.overload > 0.0) { msg = UI_MSG_HEAVY; }
    sv.ui_msg = msg;
    sv.ui_msg_tick = p_tick;
    sv.ui_arg = cls;
}

// Top the player back up to their (stat-scaled) maximum. Two callers, one
// implementation, because "soup heals to full" and "a bed heals to full"
// disagreeing by a hit point is a bug nobody would ever find.
fn sv_heal_full(p_sv: object) {
    let sv: object = p_sv;
    let w: object = sv.world;
    let idp: i32 = sim_player_id(w, sv.pslot);
    if (idp == ID_NONE) { return; }
    let slot: i32 = world_slot_of(w, idp);
    if (slot == SLOT_NONE) { return; }
    let hp = w.hp;
    let hpm = w.hp_max;
    hp[slot] = hpm[slot];
}

// ---------------------------------------------------------------------------
// PUBLISH — the two things that leave this file, filled in one place.
// ---------------------------------------------------------------------------
fn sv_publish(p_sv: object) {
    let sv: object = p_sv;
    let w: object = sv.world;
    let l: object = sv.local;
    let k: i32 = sv.pslot - 1;

    l.tick = sv.tick;
    l.session_tick = sv.session;
    l.beat = sv.beat;
    l.beat_tick = sv.beat_tick;

    // ---- the body ---------------------------------------------------------
    let id: i32 = sim_player_id(w, sv.pslot);
    l.id = id;
    let ps: array<f64> = sim_predicted(w, sv.pslot);
    l.px = move_px(ps);
    l.py = move_py(ps);
    l.pz = move_pz(ps);
    // `rsnap_set_eye_height` wants the OFFSET above the feet, and
    // `move_eye_y` returns the ABSOLUTE eye height (`PS_PY + PS_EYE`). Publish
    // both, named for what they are: adding the absolute one to the feet is a
    // camera thirty metres in the air and it looks exactly like a fog bug.
    l.eye = ps[PS_EYE];
    l.eye_abs = move_eye_y(ps);
    l.grounded = move_grounded(ps);
    l.step_dist = ps[PS_STEP_DIST];
    let vx: f64 = ps[PS_VX];
    let vz: f64 = ps[PS_VZ];
    l.speed = sqrt(vx * vx + vz * vz);

    let slot: i32 = SLOT_NONE;
    if (id != ID_NONE) { slot = world_slot_of(w, id); }
    if (slot != SLOT_NONE) {
        let hp = w.hp;
        let hpm = w.hp_max;
        l.hp = hp[slot];
        l.hp_max = hpm[slot];
    }
    l.dead = sim_player_dead(w, sv.pslot);
    l.respawn_t = sv.respawn_t;

    // ---- the weapon -------------------------------------------------------
    let wst: array = sim_weapon_state(w);
    let off: i32 = k * WS_FIELDS;
    let cur: i32 = wpn_cur(wst, off);
    l.weapon = cur;
    l.ammo = wpn_ammo(wst, off, cur);
    l.reserve = wpn_reserve_ammo(wst, off, cur);
    l.reload_t = wst[off + WS_RELOAD_T];
    l.reload_stage = i32(wst[off + WS_RELOAD_ON]);
    l.ads = wst[off + WS_ADS];
    l.rc_v = wst[off + WS_RC_V];
    l.shots = i32(wst[off + WS_SHOTS]);
    l.weapon_owned = wpn_own_mask(wst, off);
    l.weapon_force = wpn_force_w(wst, off);
    l.weapon_force_n = wpn_force_n(wst, off);

    // ---- progression ------------------------------------------------------
    let pr: array = sim_progression(w, sv.pslot);
    l.level = prog_level(pr);
    l.xp_total = prog_xp_total(pr);
    l.xp_into = prog_xp_into(pr);
    l.xp_need = prog_xp_needed(pr);
    l.levelups = prog_last_levels(pr);

    // ---- the world --------------------------------------------------------
    l.phase = sim_phase(w);
    l.day_t = sim_day_t(w);
    l.tier = sim_tier(w);
    let d: object = sim_director(w);
    l.wave_state = director_wave_state(d);
    l.wave = director_wave(d);
    l.wave_budget = director_wave_budget(d);
    l.wave_spawned = director_wave_spawned(d);
    l.dir_events = director_events(d);
    l.alive = director_alive(d);

    // ---- the lantern ------------------------------------------------------
    l.lantern_id = sv.lantern_id;
    l.lantern_x = sv.lantern_x;
    l.lantern_y = sv.lantern_y;
    l.lantern_z = sv.lantern_z;
    l.lantern_lit = sv.lantern_lit;
    let dx: f64 = sv.lantern_x - l.px;
    let dz: f64 = sv.lantern_z - l.pz;
    let dy: f64 = sv.lantern_y - l.py;
    let dist: f64 = sqrt(dx * dx + dy * dy + dz * dz);
    l.lantern_dist = dist;
    let reach: i32 = 0;
    if (dist <= SIM_INTERACT_R_M && sv.lantern_lit == 0) { reach = 1; }
    l.in_reach = reach;
    if (reach == 1) { sv_set_beat(sv, SV_BEAT_REACH); }

    // The channel is sim state; the client only ever sees the FRACTION, which
    // is what the ring on the HUD is.
    let s: object = w.sim;
    let chan = s.chan_t;
    let c01: f64 = clamp01(chan[k] / g_LANTERN_CHANNEL_S);
    l.chan01 = c01;
    if (c01 > 0.0) { sv_set_beat(sv, SV_BEAT_CHANNEL); }
    l.beat = sv.beat;
    l.beat_tick = sv.beat_tick;

    // ---- this tick's cosmetics -------------------------------------------
    let n: i32 = sim_fx_count(w);
    if (n > SV_FX_CAP) { n = SV_FX_CAP; }
    let fk = l.fx_kind; let fa = l.fx_a; let fb = l.fx_b;
    let fx = l.fx_x; let fy = l.fx_y; let fz = l.fx_z;
    let i: i32 = 0;
    while (i < n) {
        fk[i] = sim_fx_kind(w, i);
        fa[i] = sim_fx_a(w, i);
        fb[i] = sim_fx_b(w, i);
        fx[i] = sim_fx_x(w, i);
        fy[i] = sim_fx_y(w, i);
        fz[i] = sim_fx_z(w, i);
        i++;
    }
    l.fx_n = n;

    // ---- W6: the ten systems, published -----------------------------------
    sv_publish_w6(sv, l);

    // ---- THE PACKET -------------------------------------------------------
    // A full write every tick. v1 has one viewer on a loopback and a delta
    // needs the client's acknowledged baseline to be tracked, which is v2's
    // job (`snapshot_copy` promotes it, and the field is already here). The
    // bytes are real either way, and `client.hml` decodes them with the real
    // decoder.
    let bytes: i32 = snapshot_write(sv.snap, w, sv.pslot, sv.base);
    sv.snap_bytes = bytes;
    sv.bytes_out = sv.bytes_out + bytes;
}

// ---------------------------------------------------------------------------
// W6 PUBLISH. One function, called once, so that "what the client can know"
// is a list you can read top to bottom. Every field is a number: the owner
// block carries no strings and never will, because in v2 it is a packet.
// ---------------------------------------------------------------------------
fn sv_publish_w6(p_sv: object, p_l: object) {
    let sv: object = p_sv;
    let l: object = p_l;
    let st: object = sv.set;

    // ---- melee ------------------------------------------------------------
    l.mel_wpn = melee_equipped(sv.mel, sv.pslot);
    l.mel_phase = melee_phase(sv.mel, sv.pslot);
    l.mel_swings = melee_swings(sv.mel, sv.pslot);
    l.mel_hits = melee_hits(sv.mel, sv.pslot);

    // ---- the spell school --------------------------------------------------
    let sid: i32 = spell_active(sv.sp);
    l.sp_id = sid;
    l.sp_slots = spell_slots(sv.sp);
    l.sp_have = sv.sp_granted;
    let tank: i32 = spell_tank_x100(sv.sp);
    let oil: i32 = spell_oil_x100(sv.sp);
    l.sp_oil = f64(oil) / 100.0;
    l.sp_tank = f64(tank) / 100.0;
    let o01: f64 = 0.0;
    if (tank > 0) { o01 = clamp01(f64(oil) / f64(tank)); }
    l.sp_oil01 = o01;
    let cd: f64 = 0.0;
    if (sid >= 0) {
        let left: i32 = spell_cd_left(sv.sp, sid);
        let full: i32 = spell_cooldown_ticks(sv.sp, sid);
        if (full > 0 && left > 0) { cd = clamp01(f64(left) / f64(full)); }
    }
    l.sp_cd01 = cd;
    l.sp_chan01 = spell_channel_frac(sv.sp);
    l.sp_cloak = spell_cloaked(sv.sp);
    l.sp_casts = sv.sp[SP_CASTS];
    l.sp_cast_edge = sv.sp_cast_edge;
    l.sp_result = sv.sp[SP_LAST_RESULT];
    l.sp_lit = sv.sp[28];               // SP_LIT — "you are standing in light"

    // ---- stats and skills ---------------------------------------------------
    l.sk0 = stats_get(sv.sk, SK_HANDLING);
    l.sk1 = stats_get(sv.sk, SK_CAPACITY);
    l.sk2 = stats_get(sv.sk, SK_LANTERN);
    l.sk3 = stats_get(sv.sk, SK_VITALITY);
    l.sk4 = stats_get(sv.sk, SK_ATTUNEMENT);
    let pr: array = sim_progression(sv.world, sv.pslot);
    l.sk_unspent = stats_unspent(sv.sk, pr);
    l.sk_spent = stats_spent(sv.sk);

    // ---- the settlement ------------------------------------------------------
    let sx: f64 = settle_cx(st);
    let sz: f64 = settle_cz(st);
    l.set_x = sx;
    l.set_z = sz;
    l.set_y = settle_deck_y(st);
    l.set_name = settle_name(st);
    let tier: i32 = settle_tier(st);
    let ever: i32 = settle_tier_ever(st);
    l.set_tier = tier;
    l.set_tier_ever = ever;
    let dsx: f64 = sx - l.px;
    let dsz: f64 = sz - l.pz;
    let sd: f64 = sqrt(dsx * dsx + dsz * dsz);
    l.set_dist = sd;
    l.set_bearing = settle_bearing(st);
    l.set_core = settle_core_lux(st);
    l.set_pts = settle_grid_points(st);
    l.set_gl = settle_great_tier(st);
    // What the NEXT rung asks for. The ladder is only motivating if you can
    // see the rung: SETTLEMENT.md §3 is a set of thresholds and a HUD that
    // hides them turns thirty hours of play into a slot machine.
    let next: i32 = ever + 1;
    if (next > SET_TIER_CITY) { next = SET_TIER_CITY; }
    l.set_core_need = settle_tier_core(next);
    l.set_pts_need = settle_tier_points(next);
    l.set_bld = settle_building_count(st);
    l.set_brownout = settle_brownout(st);
    l.set_lan_n = sv.lan_n;
    let ring: f64 = settle_ring_m(ever);
    let inside: i32 = 0;
    if (sd <= ring) { inside = 1; }
    l.set_inside = inside;
    l.set_lux = settle_lux_at(st, l.px, l.pz);
    l.set_events = sv.settle_events;
    sv.settle_events = 0;               // one-shot, drained by the publish

    // ---- the villagers ---------------------------------------------------------
    let sto: object = sv.npcs;
    l.npc_n = npc_count(sto);
    l.npc_named = npc_named_count(sto);
    l.npc_arrived = npc_last_arrival(sto);
    let who: i32 = sv.talk_who;
    l.talk_who = who;
    if (who != NPC_NONE) {
        let slot: i32 = npc_slot_of(sto, who);
        let nx: f64 = npc_x(sto, st, slot, sv.tick);
        let nz: f64 = npc_z(sto, st, slot, sv.tick);
        let ndx: f64 = nx - l.px;
        let ndz: f64 = nz - l.pz;
        l.talk_dist = sqrt(ndx * ndx + ndz * ndz);
        l.talk_regard = npc_regard(sto, who);
        l.talk_band = npc_band(sto, who);
        l.talk_offers = npc_offers_open(sto, st, who);
        l.talk_new = npc_has_new_line(sto, who, sv.tick);
    } else {
        l.talk_dist = 0.0;
        l.talk_regard = 0;
        l.talk_band = 0;
        l.talk_offers = 0;
        l.talk_new = 0;
    }
    // The last thing said stays on screen for its own window, not for as long
    // as you stand there: a line that vanishes the moment you step back is a
    // line you never finish reading.
    let tt: i32 = sv.talk_tick;
    if (tt != SV_MISS && sv.tick - tt <= UI_MSG_TICKS * 2) {
        l.talk_topic = sv.talk_topic;
        l.talk_arg = sv.talk_arg;
    } else {
        l.talk_topic = NPC_T_NONE;
        l.talk_arg = 0;
    }

    // ---- the modal UI ------------------------------------------------------
    l.ui_panel = sv.ui_panel;
    l.ui_row = sv.ui_row;
    l.ui_rows = sv.ui_rows;
    l.ui_msg = sv.ui_msg;
    l.ui_arg = sv.ui_row;

    // ---- W7: the purse and the pack ---------------------------------------
    // `load_kg`, `carry_kg`, `overload`, `move_mult` and `fit` are written by
    // `sv_load_tick` on the 60-tick cadence and by `sv_ui_trade` the instant a
    // trade lands, so they are NOT recomputed here — the panel must read the
    // number the trade produced, not one a second old. Everything below is a
    // straight copy of a counter.
    l.purse = npc_purse(sto);
    l.salvage_earned = npc_earned(sto);
    l.salvage_spent = npc_spent(sto);
    l.pack_items = npc_pack_items(sto);
    l.kits_placed = sv.kits_placed;
    let kitrow: i32 = npc_offer_find(NPC_OFF_KIT, 0);
    l.pack_kits = 0;
    if (kitrow >= 0) { l.pack_kits = npc_pack_count(sto, kitrow); }
    // What the cursor is sitting on, as a REASON. The panel colours a row from
    // `talk_offers`; this is the one row the confirm key would act on, and it
    // is how a player finds out the price before they press it.
    l.trade_why = NPC_TR_BADROW;
    l.trade_price = 0;
    l.trade_ok = 0;
    if (who != NPC_NONE) {
        l.trade_ok = npc_trade_takeable(sto, st, who);
        let gfirst: i32 = npc_offer_first(who);
        if (gfirst >= 0) {
            let grow: i32 = gfirst + sv.ui_row;
            l.trade_why = npc_trade_check(sto, st, grow);
            l.trade_price = npc_offer_price(grow);
        }
    }
}

// ===========================================================================
//  8.  READERS
// ===========================================================================

// THE PACKET. In v2 this is what `transport_send_snapshot` puts on the wire.
export fn server_snapshot(p_sv: object): object {
    let sv: object = p_sv;
    let out: object = sv.snap;
    return out;
}

// THE OWNER BLOCK.
export fn server_local(p_sv: object): object {
    let sv: object = p_sv;
    let out: object = sv.local;
    return out;
}

// THE WORLD. Loopback only, and named so that its one legitimate caller
// (`main.hml`, for the sim-side hash and the headless probe) is visible in a
// grep. `client.hml` does not call it and must never call it: the client's
// whole claim is that it reads the packet and the owner block and nothing
// else, and that claim is what makes v2 a decode call.
export fn server_world(p_sv: object): object {
    let sv: object = p_sv;
    let out: object = sv.world;
    return out;
}

export fn server_chunks(p_sv: object): object {
    let sv: object = p_sv;
    let out: object = sv.cs;
    return out;
}

export fn server_seed(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.seed; return o; }
export fn server_t0(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.t0; return o; }
export fn server_tick_now(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.tick; return o; }
export fn server_session(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.session; return o; }
export fn server_beat(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.beat; return o; }
export fn server_beat_tick(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.beat_tick; return o; }
export fn server_ticks(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.ticks; return o; }
export fn server_cmds_in(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.cmds_in; return o; }
export fn server_snap_bytes(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.snap_bytes; return o; }
export fn server_bytes_out(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.bytes_out; return o; }
export fn server_lantern_id(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.lantern_id; return o; }
export fn server_lantern_lit(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.lantern_lit; return o; }
export fn server_lantern_x(p_sv: object): f64 { let sv: object = p_sv; let o: f64 = sv.lantern_x; return o; }
export fn server_lantern_z(p_sv: object): f64 { let sv: object = p_sv; let o: f64 = sv.lantern_z; return o; }
export fn server_spawn_x(p_sv: object): f64 { let sv: object = p_sv; let o: f64 = sv.spawn_x; return o; }
export fn server_spawn_z(p_sv: object): f64 { let sv: object = p_sv; let o: f64 = sv.spawn_z; return o; }
export fn server_spawn_yaw(p_sv: object): f64 { let sv: object = p_sv; let o: f64 = sv.spawn_yaw; return o; }
export fn server_path_lit(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.path_lit; return o; }
export fn server_hold_begun(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.hold_begun; return o; }
export fn server_deaths(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.deaths; return o; }
export fn server_supplied(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.supplied; return o; }

// ---------------------------------------------------------------------------
// W6 READERS. Loopback only, named for the one caller each has, exactly like
// `server_world`: `main.hml` needs the settlement and the roster to DRAW them,
// and drawing is not something a packet can do for it yet. `client.hml` calls
// none of these and must never call one -- its whole claim is the packet and
// the owner block, and that claim is what makes v2 a decode call.
// ---------------------------------------------------------------------------
export fn server_settle(p_sv: object): object { let sv: object = p_sv; let o: object = sv.set; return o; }
export fn server_npcs(p_sv: object): object { let sv: object = p_sv; let o: object = sv.npcs; return o; }
export fn server_melee(p_sv: object): object { let sv: object = p_sv; let o: object = sv.mel; return o; }
export fn server_spells(p_sv: object): array { let sv: object = p_sv; let o: array = sv.sp; return o; }
export fn server_stats(p_sv: object): array { let sv: object = p_sv; let o: array = sv.sk; return o; }
// ---- W7-3: the arsenal, straight off the authority ------------------------
// These read the weapon state and not `sv.local`, deliberately: `sv.local` is
// a snapshot published once a tick and a test that samples it is testing the
// publish, not the ownership. A probe asking "do I own the Blackthorn" must
// get the answer from the same array `wpn_swap_begin` consults.
export fn server_own_mask(p_sv: object): i32 {
    let sv: object = p_sv;
    let wst: array = sim_weapon_state(sv.world);
    let out: i32 = wpn_own_mask(wst, (sv.pslot - 1) * WS_FIELDS);
    return out;
}
export fn server_owns(p_sv: object, p_w: i32): i32 {
    let sv: object = p_sv;
    let wst: array = sim_weapon_state(sv.world);
    let out: i32 = wpn_owned(wst, (sv.pslot - 1) * WS_FIELDS, p_w);
    return out;
}
export fn server_own_count(p_sv: object): i32 {
    let sv: object = p_sv;
    let wst: array = sim_weapon_state(sv.world);
    let out: i32 = wpn_own_count(wst, (sv.pslot - 1) * WS_FIELDS);
    return out;
}
export fn server_weapon(p_sv: object): i32 {
    let sv: object = p_sv;
    let wst: array = sim_weapon_state(sv.world);
    let out: i32 = wpn_cur(wst, (sv.pslot - 1) * WS_FIELDS);
    return out;
}
export fn server_force_w(p_sv: object): i32 {
    let sv: object = p_sv;
    let wst: array = sim_weapon_state(sv.world);
    let out: i32 = wpn_force_w(wst, (sv.pslot - 1) * WS_FIELDS);
    return out;
}
export fn server_force_n(p_sv: object): i32 {
    let sv: object = p_sv;
    let wst: array = sim_weapon_state(sv.world);
    let out: i32 = wpn_force_n(wst, (sv.pslot - 1) * WS_FIELDS);
    return out;
}

export fn server_trades(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.trades; return o; }
export fn server_trades_refused(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.trades_refused; return o; }
export fn server_points_spent(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.points_spent; return o; }
export fn server_talks(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.talks; return o; }
export fn server_ui_panel(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.ui_panel; return o; }
export fn server_ui_row(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.ui_row; return o; }

// ---- W7: the economy, for probes and the report line ----------------------
export fn server_purse(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = npc_purse(sv.npcs); return o; }
export fn server_salvage_earned(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = npc_earned(sv.npcs); return o; }
export fn server_salvage_spent(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = npc_spent(sv.npcs); return o; }
export fn server_load_kg(p_sv: object): f64 { let sv: object = p_sv; let o: f64 = sv.local.load_kg; return o; }
export fn server_carry_kg(p_sv: object): f64 { let sv: object = p_sv; let o: f64 = sv.local.carry_kg; return o; }
export fn server_overload(p_sv: object): f64 { let sv: object = p_sv; let o: f64 = sv.local.overload; return o; }
export fn server_move_mult(p_sv: object): f64 { let sv: object = p_sv; let o: f64 = sv.move_mult; return o; }
export fn server_fit(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = npc_fit_mask(sv.npcs); return o; }
export fn server_pack_items(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = npc_pack_items(sv.npcs); return o; }
export fn server_kits_placed(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.kits_placed; return o; }
// THE TEACHING LATCH — read by `probe_teach`, and by nothing on the frame path.
// `main.hml` deliberately derives its own verdict from `client_settle_inside`
// instead of calling these: the HUD must be buildable from what the WIRE says,
// or the picture stops being evidence about what a player can know. The probe
// asserts the two agree.
export fn server_kit_verdict(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.kit_verdict; return o; }
export fn server_kit_verdict_d(p_sv: object): f64 { let sv: object = p_sv; let o: f64 = sv.kit_verdict_d; return o; }
export fn server_kit_verdict_n(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.kit_verdict_n; return o; }
// The direct grant, for probes and for `--town`: a fixture that has to reach a
// 180-salvage rifle cannot be made to farm 4500 XP first.
export fn server_grant_salvage(p_sv: object, p_n: i32): i32 {
    let sv: object = p_sv;
    let out: i32 = npc_purse_add(sv.npcs, p_n);
    return out;
}
export fn server_settle_tier(p_sv: object): i32 {
    let sv: object = p_sv;
    let out: i32 = settle_tier(sv.set);
    return out;
}
export fn server_lan_count(p_sv: object): i32 { let sv: object = p_sv; let o: i32 = sv.lan_n; return o; }

// A 31-bit fingerprint of everything W6 added that is NOT regenerable from the
// seed. Folded into no other hash: `sim_hash` is the sim's and this file must
// not change what it covers. `--selftest` and the save round-trip compare this.
export fn server_w6_hash(p_sv: object): i32 {
    let sv: object = p_sv;
    let h: u64 = 2166136261;
    h = ((h ^ u64(settle_hash(sv.set) & 2147483647)) * 16777619) & 4294967295;
    h = ((h ^ u64(npc_hash(sv.npcs) & 2147483647)) * 16777619) & 4294967295;
    let i: i32 = 0;
    while (i < SK_COUNT) {
        h = ((h ^ u64(stats_get(sv.sk, i))) * 16777619) & 4294967295;
        i++;
    }
    h = ((h ^ u64(sv.sp_granted)) * 16777619) & 4294967295;
    h = ((h ^ u64(sv.trades)) * 16777619) & 4294967295;
    h = ((h ^ u64(sv.points_spent)) * 16777619) & 4294967295;
    // W7. `npc_hash` already carries the purse, the pack and the equipment
    // mask -- they are the store's. These two are the SERVER's half of the
    // economy and would otherwise be the only trade state a hash could not
    // see: `xp_seen` decides what the next second of play is worth, and a
    // placed post is a permanent change to the world.
    h = ((h ^ u64(sv.xp_seen)) * 16777619) & 4294967295;
    h = ((h ^ u64(sv.kits_placed)) * 16777619) & 4294967295;
    let out: i32 = i32(h & 2147483647);
    return out;
}

// ---------------------------------------------------------------------------
// THE DEV TIER FLAG (`--town N`). NOT a gameplay path and it is not pretending
// to be one: it drives `settle_load`, which is the SAVE path, with a meta
// block that says "this settlement reached tier N". That is exactly what
// loading a save of a played-in town does, so nothing here is a back door the
// game itself does not have.
//
// WHY IT EXISTS. Measured on the default seed: a Village needs CORE_LUX 512,
// 10 grid points and a lit Great Lantern, HELD FOR ONE FULL IN-GAME DAY
// (`DAY_TICKS`, 57 600 ticks = 16 real minutes). The five named villagers all
// arrive at Village or Town. So on a fresh world nobody can walk up to Mabel
// inside a session, and the trade panel is unreachable to a reviewer. Rather
// than shorten the design's ladder to make a demo look good -- which is the
// thing CLAUDE.md rule 6 is about -- the ladder stays and the tool boots past
// it. The honest in-game path is unchanged and the HUD shows its thresholds.
// >>> A FIXTURE, AND IT SITS NEXT TO THE OTHER ONE ON PURPOSE. <<<
// `--kits N` for the look-review rig in `main.hml`. It is `npc_pack_grant`,
// which the honest path (`sv_script`, on SV_BEAT_PATH and on DIR_EV_HOLD_DONE)
// already uses -- so this skips the EARNING and nothing else. No probe calls
// it; `tools/probe_teach.hml` reaches its kits through the beats like a player.
export fn server_grant_kits(p_sv: object, p_n: i32): i32 {
    let sv: object = p_sv;
    if (sv.npcs == null) { let z: i32 = 0; return z; }
    let out: i32 = npc_pack_grant(sv.npcs, NPC_OFF_KIT, p_n);
    return out;
}

export fn server_settle_boot_tier(p_sv: object, p_tier: i32): i32 {
    let sv: object = p_sv;
    let t: i32 = clampi(p_tier, SET_TIER_CAMP, SET_TIER_CITY);
    if (t == SET_TIER_CAMP) { let z: i32 = 0; return z; }
    // The buildings come up FINISHED. `settle_grow_to` stakes every new plot
    // instantly -- which is right for the moment a real settlement promotes
    // ("the player immediately sees the shape of the future town",
    // SETTLEMENT.md §11) -- but this flag claims a town that has been standing
    // for a while, and a green full of scaffolding is not that. So the rows go
    // in at SET_CON_DONE, which is exactly what a save of a lived-in town
    // would contain. Two passes: grow first so `settle_assign_pid` knows the
    // pids, then re-load with the finished rows.
    let meta: array<i32> = [t, t, SET_IND_RUNNING, 0, 0, -1, 0, 0];
    let rows0: array<i32> = [];
    settle_load(sv.set, rows0, 0, meta);
    let nb: i32 = settle_building_count(sv.set);
    let rows: array<i32> = [];
    let bi: i32 = 0;
    while (bi < nb) {
        rows.push(settle_assign_pid(sv.set, bi));
        rows.push(settle_assign_kind(sv.set, bi));
        rows.push(SET_CON_DONE);
        rows.push(0);
        bi++;
    }
    settle_load(sv.set, rows, nb, meta);
    // A town that exists has its own lamps burning; otherwise the Great
    // Lantern reads unlit and `settle_promote_check` would demote it on the
    // first sweep, which would make the flag look broken rather than absent.
    // A TOWN'S STREETS ARE LIT. That is not decoration -- `settle_tier_points`
    // wants 10 grid points for a Village and 32 for a Town, one point per
    // SET_LUX_PER_POINT (256) of GRID LUX, and a lit post is worth
    // SET_WICK_FULL (256), doubled to 512 when it is on a wick line with
    // another. Booting the tier WITHOUT the lamps that justify it leaves the
    // settlement permanently in brownout, which shuts every trade row via
    // `npc_offer_open` with no error message anywhere -- exactly the failure
    // this probe caught. So the flag lights the streets it is claiming.
    let a: array<f64> = sv.lan;
    let st: object = sv.set;
    a[0] = settle_cx(st);
    a[1] = settle_cz(st);
    a[2] = f64(t);
    a[3] = f64(SET_WICK_FULL);
    let n: i32 = 1;

    // MEASURE, DO NOT ESTIMATE. `settle_refresh` recomputes CORE_LUX and
    // GRID_LUX from the lantern set on the spot, so the flag adds lamps until
    // the settlement's OWN arithmetic says the tier is justified rather than
    // until a formula in this file says so. The 5/4 margin is
    // `settle_brownout_check`'s (`points*10 >= tier_points*8`): a town that
    // boots exactly ON the threshold browns out the first time a wick decays,
    // and a browned-out town shuts every trade row silently.
    let need_core: i32 = settle_tier_core(t) * 5 / 4;
    let need_pts: i32 = settle_tier_points(t) * 5 / 4;
    let np: i32 = settle_plot_count();
    let k: i32 = 0;
    let green: i32 = 0;
    let guard: i32 = 0;
    settle_lanterns_set(st, a, n);
    settle_refresh(st);
    while (guard < SV_LAN_CAP) {
        let have_core: i32 = settle_core_lux(st);
        let have_pts: i32 = settle_grid_points(st);
        if (have_core >= need_core && have_pts >= need_pts) { guard = SV_LAN_CAP; }
        else {
            if (n >= SV_LAN_CAP) { guard = SV_LAN_CAP; }
            else {
                let lx2: f64 = 0.0;
                let lz2: f64 = 0.0;
                let placed: i32 = 0;
                if (have_core < need_core) {
                    // ON THE GREEN. CORE_LUX falls off with distance from the
                    // centre, so the lamps that make a core have to be on it.
                    let ang: f64 = f64(green) * 0.7853981633974483;
                    lx2 = settle_cx(st) + sin(ang) * 7.0;
                    lz2 = settle_cz(st) - cos(ang) * 7.0;
                    green++;
                    placed = 1;
                } else {
                    while (k < np && placed == 0) {
                        let pid: i32 = settle_plot_order(st, k);
                        k++;
                        if (pid >= 0) {
                            if (settle_plot_valid(st, pid) == 1) {
                                lx2 = settle_plot_x(st, pid);
                                lz2 = settle_plot_z(st, pid);
                                placed = 1;
                            }
                        }
                    }
                    if (placed == 0) {
                        // THE PLOTS RAN OUT. A City wants 72 grid points and
                        // the lattice only has ~22 buildable plots, so the
                        // last lamps go on the ring roads between them --
                        // which is where a city's lamps are anyway. Without
                        // this a `--town 3` boots at 56 of 72 points and
                        // `settle_brownout_check` (points*10 >= need*8) puts
                        // it straight into brownout, which shuts every trade
                        // row including the manufactured guns the CITY tier
                        // exists to unlock.
                        let ri: i32 = green;
                        let ang2: f64 = f64(ri) * 0.9424777960769379;
                        let rr2: f64 = 14.0 + f64(ri / 7) * 11.0;
                        lx2 = settle_cx(st) + sin(ang2) * rr2;
                        lz2 = settle_cz(st) - cos(ang2) * rr2;
                        green++;
                        placed = 1;
                    }
                }
                if (placed == 0) { guard = SV_LAN_CAP; }
                else {
                    a[n * 4] = lx2;
                    a[n * 4 + 1] = lz2;
                    a[n * 4 + 2] = 1.0;
                    a[n * 4 + 3] = f64(SET_WICK_FULL);
                    n++;
                    settle_lanterns_set(st, a, n);
                    settle_refresh(st);
                    guard++;
                }
            }
        }
    }
    sv.lan_n = n;
    sv.lan_civic = n;
    settle_lanterns_set(sv.set, a, n);
    settle_refresh(sv.set);
    npc_refresh(sv.npcs, sv.set);

    // ---- W7: AND THE PURSE THAT CAME WITH IT ------------------------------
    // >>> FIXTURE MONEY, AND IT IS ONLY EVER FIXTURE MONEY. <<<
    // This flag fabricates a settlement that would have taken a player hours
    // of lantern work to earn. Salvage is paid for exactly that work
    // (`sv_salvage_tick`, one coin per `SV_XP_PER_SALVAGE` of XP), so a Town
    // that boots with an EMPTY purse is not a mid-game state — it is a
    // teleport into poverty, and every trade row in it answers NO SALVAGE.
    // The `--town` flag would then look like a broken shop rather than an
    // absent wallet, which is precisely the failure mode the block above this
    // one was written to stop (a browned-out fixture shutting every row).
    //
    // The grant is per tier and it is deliberately modest: `SV_BOOT_SALVAGE`
    // at a Village buys brass and soup, and it takes THREE tiers to afford the
    // Great Lantern's next wick. Nothing in the shipping game calls this — it
    // is reached only through `--town`, `probe_w6` and `probe_trade`.
    npc_purse_add(sv.npcs, SV_BOOT_SALVAGE * t);

    let out: i32 = t;
    return out;
}

// DEV. Put the player somewhere. Used by `--at-town`, which exists so the
// settlement can be PHOTOGRAPHED -- CLAUDE.md rule 8: look at every frame you
// change, and a town 282 m away is a town nobody has looked at.
export fn server_teleport(p_sv: object, p_x: f64, p_z: f64): i32 {
    let sv: object = p_sv;
    let out: i32 = sim_respawn_player(sv.world, sv.pslot, p_x, p_z);
    sv.spawn_x = p_x;
    sv.spawn_z = p_z;
    return out;
}

export fn server_hash(p_sv: object): u64 {
    let sv: object = p_sv;
    let out: u64 = sim_hash(sv.world);
    return out;
}

export fn server_enemies_alive(p_sv: object): i32 {
    let sv: object = p_sv;
    let out: i32 = ai_agent_count(sim_ai(sv.world));
    return out;
}

// The shade tier the player is standing in, without stepping the sim. The HUD
// shows it and the probe asserts it is >= 1 at spawn — see `server_boot`.
export fn server_tier_at(p_sv: object, p_x: f64, p_z: f64, p_bonus: i32): i32 {
    let sv: object = p_sv;
    let cx: i32 = i32(floor(p_x / g_CHUNK_M));
    let cz: i32 = i32(floor(p_z / g_CHUNK_M));
    let out: i32 = worldgen_shade_tier(sv.seed, cx, cz, p_bonus);
    return out;
}

export fn server_beat_name(p_b: i32): string {
    let b: i32 = p_b;
    if (b == SV_BEAT_WAKE) { let s: string = "WAKE"; return s; }
    if (b == SV_BEAT_STAND) { let s: string = "STAND"; return s; }
    if (b == SV_BEAT_SEEK) { let s: string = "SEEK"; return s; }
    if (b == SV_BEAT_WISPS) { let s: string = "WISPS"; return s; }
    if (b == SV_BEAT_MOTE) { let s: string = "MOTE"; return s; }
    if (b == SV_BEAT_REACH) { let s: string = "REACH"; return s; }
    if (b == SV_BEAT_CHANNEL) { let s: string = "CHANNEL"; return s; }
    if (b == SV_BEAT_LIT) { let s: string = "LIT"; return s; }
    if (b == SV_BEAT_HORN) { let s: string = "HORN"; return s; }
    if (b == SV_BEAT_WAVE) { let s: string = "WAVE"; return s; }
    if (b == SV_BEAT_CLEAR) { let s: string = "CLEAR"; return s; }
    if (b == SV_BEAT_PATH) { let s: string = "PATH"; return s; }
    let s2: string = "?";
    return s2;
}
