// ===========================================================================
// nightshade/src/render/fx.hml — STAGE 16                     (renderer-split)
// ===========================================================================
//
// ARCHITECTURE.md §5.6: "Client-only particle SoA (cap 512, negative ids),
// tracers, muzzle flashes, impact bursts, ember motes, damage numbers, decals,
// glow cards."  §5's export list is `fx_new, fx_update, fx_emit, fx_spawn_*`.
//
// WHAT ACTUALLY EXISTS TODAY IS THE EMIT HALF, and this file is exactly that
// half, EXTRACTED UNCHANGED IN BEHAVIOUR out of `world_render.hml`. The
// SPAWN/UPDATE half (`fx_new`, `fx_update`, `fx_spawn_muzzle`, ...) is Wave-4
// work that has not been written by anybody yet — the four consumers of the
// frame graph each fill the registry themselves through `fx_add`, which is what
// the monolith's `world_fx_add` was. It is NOT stubbed here: an empty
// `fx_update` that nobody calls is the stand-in-art defect one layer up.
//
// ---------------------------------------------------------------------------
// WHAT THIS FILE OWNS
// ---------------------------------------------------------------------------
//   * the PARTICLE REGISTRY — position, size, atlas cell, shape, rgba
//   * the three billboard SHAPES (sprite / rain streak / tracer streak)
//   * the per-light ground GLOW CARD, and the 14 m cutoff that keeps it honest
//   * per-particle fog attenuation
//
// It owns no layer order and no raster order. `world_render.hml` calls `fx_emit`
// from inside its own `stat_begin(STAT_T_EMIT_FX)` pair.
//
// ---------------------------------------------------------------------------
// WHY THIS FILE IMPORTS terrain_render.hml
// ---------------------------------------------------------------------------
// A glow card follows the ground: its four corners are `terrain_h` sampled at
// the light's four corners. The light MOVES (every muzzle flash), so no amount
// of caller-side precomputation covers it. `src/render/**` may import
// `src/render/**` (CLAUDE.md §3, ci_imports.sh R1), and both files stand on the
// same height field by construction rather than by convention. When
// `src/sim/chunk.hml` takes the ground over, this import becomes the sim one.
// ===========================================================================

import { sqrt } from "@stdlib/math";

import { batch_reserve, batch_commit, batch_vbuf }
       from "../../../wobbleweed/src/batch.hml";
import { emit_quad_world } from "../../../wobbleweed/src/emit.hml";
import { billboard_set_uv, billboard_world, billboard_stretched }
       from "../../../wobbleweed/src/billboard.hml";
import { atlas_cell_uv } from "../../../wobbleweed/src/atlas.hml";
import { env_field, env_fog_factor, env_light_count,
         ENV_LIGHT0_X, ENV_LIGHT_STRIDE }
       from "../../../wobbleweed/src/shade.hml";

import { clampi } from "../core/mathx.hml";
import { terrain_h } from "./terrain_render.hml";

// ---------------------------------------------------------------------------
// fx_add draw kinds. The frame graph must not know what a "rain" sprite is — it
// knows three billboard SHAPES, and the caller says which one its fxgen cell
// wants. (Wave 2 branched on `cell == FX_RAIN`, which would have dragged
// src/art through the import wall.)
// ---------------------------------------------------------------------------
export let g_FXK_SPRITE: i32 = 0;       // camera-facing card, size p_s
export let g_FXK_RAIN: i32 = 1;         // vertical streak, 1.5 m, 5 cm wide
export let g_FXK_TRACER: i32 = 2;       // 2.6 m streak away from the camera
// A FLAT GROUND QUAD of edge p_s, its four corners sampled off `terrain_h` the
// same way the per-light glow card's are.  Added for the Kindling pool, which
// is a 6 m disc lying on the ground and reads as a rectangle-on-a-pole if it is
// billboarded.  Costs the same 2 triangles as a sprite.
//
// NOTE FOR world_render.hml (not this task's file, reported not edited): that
// module re-exports g_FXK_SPRITE/RAIN/TRACER for the frame-graph facade and
// will want a `g_FXK_GROUND` line beside them.  Callers that import fx.hml
// directly need nothing.
export let g_FXK_GROUND: i32 = 3;

// ===========================================================================
// 1. THE PARTICLE REGISTRY
// ---------------------------------------------------------------------------
// Struct-of-arrays (CLAUDE.md A7), filled by the caller, never by this file.
// ===========================================================================

let g_fx_x: array<f64> = [];
let g_fx_y: array<f64> = [];
let g_fx_z: array<f64> = [];
let g_fx_s: array<f64> = [];
let g_fx_cell: array<i32> = [];
let g_fx_kind: array<i32> = [];
let g_fx_r: array<i32> = [];
let g_fx_g: array<i32> = [];
let g_fx_b: array<i32> = [];
let g_fx_a: array<i32> = [];

// ---------------------------------------------------------------------------
// THE STREAK REGISTRY — a SECOND, tiny registry, and here is why it is separate
// ---------------------------------------------------------------------------
// `g_FXK_TRACER` draws a 2.6 m streak pointing away from the camera, which is
// right for a bullet and useless for a spell beam: the Shutter runs from the
// caster's eye to a point 14 m away and the Lance to a point 24 m away, so both
// need TWO world endpoints and the particle registry only has room for one.
//
// The obvious fix — six more parallel arrays on the particle SoA — is the wrong
// one.  `fx_add` is the call a worst-case frame makes ~300 times, and six extra
// `array.push` per call is real cost paid by rain, embers and muzzle flashes to
// buy nothing they use.  A separate registry of eight entries costs the sprite
// path exactly zero and costs `fx_emit` one loop that runs zero times when
// nothing is casting.
// ---------------------------------------------------------------------------

let g_st_x0: array<f64> = [];
let g_st_y0: array<f64> = [];
let g_st_z0: array<f64> = [];
let g_st_x1: array<f64> = [];
let g_st_y1: array<f64> = [];
let g_st_z1: array<f64> = [];
let g_st_hw: array<f64> = [];
let g_st_cell: array<i32> = [];
let g_st_r: array<i32> = [];
let g_st_g: array<i32> = [];
let g_st_b: array<i32> = [];
let g_st_a: array<i32> = [];

// Spell sprites emitted THIS FRAME, against `g_SFX_FRAME_CAP` below.  Reset in
// `fx_clear`, which `world_clear` calls exactly once per frame — that is the
// frame boundary this counter needs and there is no second one.
let g_sfx_frame_sprites: i32 = 0;
let g_sfx_frame_dropped: i32 = 0;

export fn fx_clear() {
    g_sfx_frame_sprites = 0;
    g_sfx_frame_dropped = 0;
    g_fx_x = []; g_fx_y = []; g_fx_z = []; g_fx_s = [];
    g_fx_cell = []; g_fx_kind = []; g_fx_r = []; g_fx_g = []; g_fx_b = [];
    g_fx_a = [];
    g_st_x0 = []; g_st_y0 = []; g_st_z0 = [];
    g_st_x1 = []; g_st_y1 = []; g_st_z1 = [];
    g_st_hw = []; g_st_cell = [];
    g_st_r = []; g_st_g = []; g_st_b = []; g_st_a = [];
}

// A world-space streak between two arbitrary points, `p_hw` metres half-width.
export fn fx_streak_add(p_x0: f64, p_y0: f64, p_z0: f64,
                        p_x1: f64, p_y1: f64, p_z1: f64,
                        p_hw: f64, p_cell: i32,
                        p_r: i32, p_g: i32, p_b: i32, p_a: i32): i32 {
    let idx: i32 = g_st_x0.length;
    g_st_x0.push(p_x0); g_st_y0.push(p_y0); g_st_z0.push(p_z0);
    g_st_x1.push(p_x1); g_st_y1.push(p_y1); g_st_z1.push(p_z1);
    g_st_hw.push(p_hw); g_st_cell.push(p_cell);
    g_st_r.push(p_r); g_st_g.push(p_g); g_st_b.push(p_b); g_st_a.push(p_a);
    let out: i32 = idx;
    return out;
}

export fn fx_streak_count(): i32 { let out: i32 = g_st_x0.length; return out; }

export fn fx_add(p_x: f64, p_y: f64, p_z: f64, p_s: f64,
                 p_cell: i32, p_kind: i32,
                 p_r: i32, p_g: i32, p_b: i32, p_a: i32): i32 {
    let idx: i32 = g_fx_x.length;
    g_fx_x.push(p_x); g_fx_y.push(p_y); g_fx_z.push(p_z); g_fx_s.push(p_s);
    g_fx_cell.push(p_cell); g_fx_kind.push(p_kind);
    g_fx_r.push(p_r); g_fx_g.push(p_g); g_fx_b.push(p_b); g_fx_a.push(p_a);
    let out: i32 = idx;
    return out;
}

export fn fx_count(): i32 { let out: i32 = g_fx_x.length; return out; }

// ---------------------------------------------------------------------------
// READ-ONLY REGISTRY ACCESS — for probes, and for nothing else.
// ---------------------------------------------------------------------------
// `fx_emit` reads the SoA directly and always will; these exist so a headless
// probe can assert what was submitted without opening a window, and so
// determinism can be checked on the DATA rather than on pixels.  Out of range
// is a defined answer (0 / -1), never a trap.
export fn fx_p_x(p_i: i32): f64 { if (p_i < 0 || p_i >= g_fx_x.length) { let z: f64 = 0.0; return z; } let o: f64 = g_fx_x[p_i]; return o; }
export fn fx_p_y(p_i: i32): f64 { if (p_i < 0 || p_i >= g_fx_x.length) { let z: f64 = 0.0; return z; } let o: f64 = g_fx_y[p_i]; return o; }
export fn fx_p_z(p_i: i32): f64 { if (p_i < 0 || p_i >= g_fx_x.length) { let z: f64 = 0.0; return z; } let o: f64 = g_fx_z[p_i]; return o; }
export fn fx_p_s(p_i: i32): f64 { if (p_i < 0 || p_i >= g_fx_x.length) { let z: f64 = 0.0; return z; } let o: f64 = g_fx_s[p_i]; return o; }
export fn fx_p_cell(p_i: i32): i32 { if (p_i < 0 || p_i >= g_fx_x.length) { let z: i32 = 0 - 1; return z; } let o: i32 = g_fx_cell[p_i]; return o; }
export fn fx_p_kind(p_i: i32): i32 { if (p_i < 0 || p_i >= g_fx_x.length) { let z: i32 = 0 - 1; return z; } let o: i32 = g_fx_kind[p_i]; return o; }
export fn fx_p_r(p_i: i32): i32 { if (p_i < 0 || p_i >= g_fx_x.length) { let z: i32 = 0; return z; } let o: i32 = g_fx_r[p_i]; return o; }
export fn fx_p_g(p_i: i32): i32 { if (p_i < 0 || p_i >= g_fx_x.length) { let z: i32 = 0; return z; } let o: i32 = g_fx_g[p_i]; return o; }
export fn fx_p_b(p_i: i32): i32 { if (p_i < 0 || p_i >= g_fx_x.length) { let z: i32 = 0; return z; } let o: i32 = g_fx_b[p_i]; return o; }
export fn fx_p_a(p_i: i32): i32 { if (p_i < 0 || p_i >= g_fx_x.length) { let z: i32 = 0; return z; } let o: i32 = g_fx_a[p_i]; return o; }
export fn fx_s_hw(p_i: i32): f64 { if (p_i < 0 || p_i >= g_st_x0.length) { let z: f64 = 0.0; return z; } let o: f64 = g_st_hw[p_i]; return o; }
export fn fx_s_cell(p_i: i32): i32 { if (p_i < 0 || p_i >= g_st_x0.length) { let z: i32 = 0 - 1; return z; } let o: i32 = g_st_cell[p_i]; return o; }
export fn fx_s_a(p_i: i32): i32 { if (p_i < 0 || p_i >= g_st_x0.length) { let z: i32 = 0; return z; } let o: i32 = g_st_a[p_i]; return o; }

// FNV-1a over BOTH registries, positions quantized to millimetres.  This is the
// determinism instrument: two runs that submit the same drawing submit the same
// number, on either backend, without a window or a pixel.  Quantizing is
// deliberate — a bit-exact f64 compare would make the hash a floating-point
// conformance test instead of a rendering one.
export fn fx_registry_hash(): u64 {
    let m: u64 = 18446744073709551615;
    let h: u64 = 14695981039346656037;
    let P: u64 = 1099511628211;
    let n: i32 = g_fx_x.length;
    for (let i = 0; i < n; i++) {
        let q: array<i32> = [
            i32(g_fx_x[i] * 1000.0), i32(g_fx_y[i] * 1000.0),
            i32(g_fx_z[i] * 1000.0), i32(g_fx_s[i] * 1000.0),
            g_fx_cell[i], g_fx_kind[i],
            g_fx_r[i], g_fx_g[i], g_fx_b[i], g_fx_a[i]
        ];
        for (let k = 0; k < 10; k++) {
            h = (h ^ (u64(q[k] & 268435455) + 1)) & m;
            h = (h * P) & m;
        }
    }
    let ns: i32 = g_st_x0.length;
    for (let i = 0; i < ns; i++) {
        let q2: array<i32> = [
            i32(g_st_x0[i] * 1000.0), i32(g_st_y0[i] * 1000.0), i32(g_st_z0[i] * 1000.0),
            i32(g_st_x1[i] * 1000.0), i32(g_st_y1[i] * 1000.0), i32(g_st_z1[i] * 1000.0),
            i32(g_st_hw[i] * 1000.0), g_st_cell[i],
            g_st_r[i], g_st_g[i], g_st_b[i], g_st_a[i]
        ];
        for (let k = 0; k < 12; k++) {
            h = (h ^ (u64(q2[k] & 268435455) + 1)) & m;
            h = (h * P) & m;
        }
    }
    let out: u64 = h;
    return out;
}

// ===========================================================================
// 2. THE GROUND-QUAD HELPER
// ---------------------------------------------------------------------------
// Scratch allocated once (A8 / N6). `g_dep`'s contents are written by
// `emit_quad_world` and read on the very next line; `g_uvs` is refilled before
// every use. Nothing carries between calls, so this module holding its own copy
// is behaviourally identical to sharing the monolith's.
//
// NOTE (reported, not fixed — batch.hml is not this task's file): `batch.hml`
// has no `batch_release(b, n)`, so the unwritten tail of a reservation has to be
// handed back by writing `b.n` directly. See terrain_render.hml.
// ===========================================================================

let g_dep: array<f64> = [];
let g_uvs: array<f64> = [0.0, 0.0, 0.0, 0.0];

fn emit_world_quad(p_b, p_tex,
                   p_ax: f64, p_ay: f64, p_az: f64,
                   p_bx: f64, p_by: f64, p_bz: f64,
                   p_cx: f64, p_cy: f64, p_cz: f64,
                   p_dx: f64, p_dy: f64, p_dz: f64,
                   p_u0: f64, p_v0: f64, p_u1: f64, p_v1: f64,
                   p_rgb: i32): i32 {
    while (g_dep.length < 2) { g_dep.push(0.0); }
    let cur: i32 = batch_reserve(p_b, 2);
    if (cur < 0) { let z: i32 = 0; return z; }
    let n: i32 = emit_quad_world(batch_vbuf(p_b), cur, g_dep, 0,
                                 p_ax, p_ay, p_az, p_bx, p_by, p_bz,
                                 p_cx, p_cy, p_cz, p_dx, p_dy, p_dz,
                                 p_u0, p_v0, p_u1, p_v0, p_u1, p_v1, p_u0, p_v1,
                                 0.0, 1.0, 0.0, p_rgb);
    p_b.n = p_b.n - (2 - n);
    for (let k = 0; k < n; k++) { batch_commit(p_b, cur + k * 60, p_tex, g_dep[k]); }
    let out: i32 = n;
    return out;
}

// ===========================================================================
// 3. STAGE 16 — particles, glow cards, tracers, rain
// ---------------------------------------------------------------------------
// Returns the PARTICLE count, which is what `STAT_PARTICLES` has always
// reported: the registry length, not the number of billboards that survived.
// The caller publishes the stat, because in sheet mode it must publish 0 without
// this function running at all.
// ===========================================================================

export fn fx_emit(p_b, p_tex, p_atlas, p_env: array<f64>,
                  p_glow_cell: i32, p_camx: f64, p_camz: f64): i32 {
    let camx: f64 = p_camx;
    let camz: f64 = p_camz;
    let env: array<f64> = p_env;
    let nfx: i32 = g_fx_x.length;
    for (let q = 0; q < nfx; q++) {
        atlas_cell_uv(p_atlas, g_fx_cell[q], g_uvs, 0);
        billboard_set_uv(g_uvs[0], g_uvs[1], g_uvs[2], g_uvs[3]);
        let fa: f64 = env_fog_factor(g_fx_x[q], g_fx_y[q], g_fx_z[q]);
        let al: i32 = clampi(i32(f64(g_fx_a[q]) * (1.0 - fa * 0.85)), 0, 255);
        if (g_fx_kind[q] == g_FXK_RAIN) {
            billboard_stretched(p_b, p_tex,
                                g_fx_x[q], g_fx_y[q], g_fx_z[q],
                                g_fx_x[q] + 0.12, g_fx_y[q] - 1.5, g_fx_z[q],
                                0.05, g_fx_r[q], g_fx_g[q], g_fx_b[q], al);
        } else if (g_fx_kind[q] == g_FXK_TRACER) {
            let tdx: f64 = g_fx_x[q] - camx;
            let tdz: f64 = g_fx_z[q] - camz;
            let tl: f64 = sqrt(tdx * tdx + tdz * tdz);
            if (tl < 0.001) { tl = 1.0; }
            billboard_stretched(p_b, p_tex,
                                g_fx_x[q], g_fx_y[q], g_fx_z[q],
                                g_fx_x[q] + tdx / tl * 2.6, g_fx_y[q],
                                g_fx_z[q] + tdz / tl * 2.6,
                                0.06, g_fx_r[q], g_fx_g[q], g_fx_b[q], al);
        } else if (g_fx_kind[q] == g_FXK_GROUND) {
            // A flat card on the terrain, corners sampled exactly the way the
            // per-light glow card below samples its own.  0.06 m of lift is the
            // same z-fight margin that card uses; do not reduce it, the ground
            // warps (CLAUDE.md §6) and a card flush with the surface strobes.
            //
            // IT IS SUBDIVIDED, AND THAT IS NOT OPTIONAL.  CLAUDE.md §6: "keep
            // quads <= 4 m so the ground warp stays charming".  The Kindling
            // pool is 6 m across and the first version drew it as ONE quad; at
            // a grazing angle the affine UVs sheared it into a lopsided KITE
            // with a visible diagonal seam down the middle — the ring was not a
            // ring at all.  `2 * ceil(size / 4)` sub-cards keeps every one of
            // them inside the rule.  A 6 m pool costs 8 triangles.
            let gs: f64 = g_fx_s[q];
            let nsub: i32 = 1 + i32(gs * 0.25);
            if (nsub > 3) { nsub = 3; }
            let step: f64 = gs / f64(nsub);
            let gx0: f64 = g_fx_x[q] - gs * 0.5;
            let gz0: f64 = g_fx_z[q] - gs * 0.5;
            let gr: i32 = clampi(i32(f64(g_fx_r[q]) * f64(al) / 255.0), 0, 255);
            let gg: i32 = clampi(i32(f64(g_fx_g[q]) * f64(al) / 255.0), 0, 255);
            let gb: i32 = clampi(i32(f64(g_fx_b[q]) * f64(al) / 255.0), 0, 255);
            let grgb: i32 = (gr << 16) | (gg << 8) | gb;
            let du: f64 = (g_uvs[2] - g_uvs[0]) / f64(nsub);
            let dv: f64 = (g_uvs[3] - g_uvs[1]) / f64(nsub);
            for (let sj = 0; sj < nsub; sj++) {
                for (let si = 0; si < nsub; si++) {
                    let ax: f64 = gx0 + f64(si) * step;
                    let az: f64 = gz0 + f64(sj) * step;
                    let bx: f64 = ax + step;
                    let bz: f64 = az + step;
                    emit_world_quad(p_b, p_tex,
                                    ax, terrain_h(ax, az) + 0.06, az,
                                    bx, terrain_h(bx, az) + 0.06, az,
                                    bx, terrain_h(bx, bz) + 0.06, bz,
                                    ax, terrain_h(ax, bz) + 0.06, bz,
                                    g_uvs[0] + du * f64(si),
                                    g_uvs[1] + dv * f64(sj),
                                    g_uvs[0] + du * f64(si + 1),
                                    g_uvs[1] + dv * f64(sj + 1),
                                    grgb);
                }
            }
        } else {
            billboard_world(p_b, p_tex, g_fx_x[q], g_fx_y[q], g_fx_z[q],
                            g_fx_s[q], g_fx_r[q], g_fx_g[q], g_fx_b[q], al);
        }
    }
    // ---- the streak registry ---------------------------------------------
    // Fog is taken at the MIDPOINT, not at either end. A 24 m Lance fired into
    // the fog has ends 24 m apart in fog depth and one alpha to spend on both;
    // the midpoint is the only choice that does not make a beam either vanish
    // at the near end or punch through the far wall.
    let nst: i32 = g_st_x0.length;
    for (let s = 0; s < nst; s++) {
        atlas_cell_uv(p_atlas, g_st_cell[s], g_uvs, 0);
        billboard_set_uv(g_uvs[0], g_uvs[1], g_uvs[2], g_uvs[3]);
        let mx: f64 = (g_st_x0[s] + g_st_x1[s]) * 0.5;
        let my: f64 = (g_st_y0[s] + g_st_y1[s]) * 0.5;
        let mz: f64 = (g_st_z0[s] + g_st_z1[s]) * 0.5;
        let sf: f64 = env_fog_factor(mx, my, mz);
        let sa: i32 = clampi(i32(f64(g_st_a[s]) * (1.0 - sf * 0.85)), 0, 255);
        billboard_stretched(p_b, p_tex,
                            g_st_x0[s], g_st_y0[s], g_st_z0[s],
                            g_st_x1[s], g_st_y1[s], g_st_z1[s],
                            g_st_hw[s], g_st_r[s], g_st_g[s], g_st_b[s], sa);
    }
    // One flat ground glow card per dynamic light. mesh_bake_light folds
    // only ambient + sun + bounce, so this 2-triangle additive card is how
    // a point light reaches the GROUND — which is what ART_BIBLE 12.2 asks
    // for and what a PS1-era renderer would have done.
    let nl2: i32 = env_light_count(env);
    atlas_cell_uv(p_atlas, p_glow_cell, g_uvs, 0);
    for (let li = 0; li < nl2; li++) {
        let lb3: i32 = ENV_LIGHT0_X + li * ENV_LIGHT_STRIDE;
        let lx2: f64 = env_field(env, lb3);
        let lz2: f64 = env_field(env, lb3 + 2);
        // The card is a 2-triangle quad with only four corners following
        // the ground, so beyond ~14 m it is seen edge-on and reads as a
        // bright LINE across the terrain instead of a pool of light. Near
        // lights (the muzzle flash, a lantern you are standing by) are
        // exactly where a ground pool earns its two triangles.
        let ldc: f64 = sqrt((lx2 - camx) * (lx2 - camx)
                            + (lz2 - camz) * (lz2 - camz));
        if (ldc > 14.0) { continue; }
        let lrad2: f64 = env_field(env, lb3 + 6) * 0.62;
        let lr2: i32 = clampi(i32(env_field(env, lb3 + 3) * 96.0), 0, 255);
        let lg2: i32 = clampi(i32(env_field(env, lb3 + 4) * 96.0), 0, 255);
        let lb4: i32 = clampi(i32(env_field(env, lb3 + 5) * 96.0), 0, 255);
        emit_world_quad(p_b, p_tex,
                        lx2 - lrad2, terrain_h(lx2 - lrad2, lz2 - lrad2) + 0.06, lz2 - lrad2,
                        lx2 + lrad2, terrain_h(lx2 + lrad2, lz2 - lrad2) + 0.06, lz2 - lrad2,
                        lx2 + lrad2, terrain_h(lx2 + lrad2, lz2 + lrad2) + 0.06, lz2 + lrad2,
                        lx2 - lrad2, terrain_h(lx2 - lrad2, lz2 + lrad2) + 0.06, lz2 + lrad2,
                        g_uvs[0], g_uvs[1], g_uvs[2], g_uvs[3],
                        (lr2 << 16) | (lg2 << 8) | lb4);
    }
    let out: i32 = nfx;
    return out;
}

// ===========================================================================
// 4. THE SPELL SCHOOL — the emit half
// ---------------------------------------------------------------------------
// `src/sim/spells.hml` ships seven spells and draws NONE of them.  It says so
// itself: "It renders nothing.  Every visible consequence leaves as an event on
// the combat bus and the renderer derives the picture from that."  This is that
// renderer, and the art it draws with is `src/art/fxgen.hml` cells 28..39.
//
// ---------------------------------------------------------------------------
// WHY THERE ARE NO EV_SPELL_* CONSTANTS IN THIS FILE
// ---------------------------------------------------------------------------
// `ci_imports.sh` would ALLOW it — `src/render/**` may import `src/sim/**`.  It
// is still wrong.  `spells.hml` pulls in world.hml, combat.hml, ai.hml,
// projectiles.hml and daycycle.hml behind it, and this module is linked into
// every screenshot tool and every benchmark in the tree; none of them want a
// simulation.  More importantly ARCHITECTURE.md §5.6b already settled the
// pattern: the render layer speaks in SEMANTIC ids and `main.hml` binds them to
// concrete sim events and concrete art.  `fx_emit`'s existing `p_glow_cell`
// parameter is that rule already applied — this file has never known what an
// FX cell number means and it does not learn now.
//
// So the game layer's binding is three lines at boot and one switch per event:
//
//     fx_spell_bind_cells([... FX_MEND_RING, FX_MEND_MOTE, ... ])
//     fx_spell_bind_tints([... g_VENOM_HALO, g_NS_HALO, ... ])
//     EV_SPELL_HEAL   -> fx_spell_heal(x, y, z)
//     EV_SPELL_CAST   -> fx_spell_flare / _blast / _sigil by spell id
//     EV_SPELL_CLOAK  -> the caller holds the flag and calls fx_spell_cloak_now
//     EV_SPELL_POOL   -> the caller holds the volume and calls fx_spell_pool_now
//
// ---------------------------------------------------------------------------
// RETAINED vs IMMEDIATE — the split is the data, not a preference
// ---------------------------------------------------------------------------
// Two kinds of thing arrive from the sim and they want opposite handling:
//
//   an EVENT has a moment and no position later    -> RETAINED.  Spawn it once,
//     `fx_spell_update(dt)` ages it, `fx_spell_emit()` draws whatever is alive.
//     Heal, Flare, the fire blast, the Lance discharge, the cast sigil, and the
//     bolt's trail nodes.
//
//   a STATE has a position every frame and the sim already owns it -> IMMEDIATE.
//     Storing a copy here would be a second source of truth that can desync.
//     The cloak, the Shutter beam, the Kindling pool, the bolt head, the
//     channel wind-up.  Call these once per frame between `fx_clear` and
//     `fx_emit`, exactly like `world_fx_add`.
//
// ---------------------------------------------------------------------------
// THE THING THIS FILE MUST NOT DO — and it is the whole reason for one design
// decision below
// ---------------------------------------------------------------------------
// ATLAS_FX is BLEND_ADD.  `dstRGB = srcRGB * srcA + dstRGB` adds light to the
// PIXELS A SPRITE COVERS and does nothing whatsoever to the world: it cannot
// light a surface, it cannot cast, it cannot fall off with distance from a
// point.  This project has already shipped one additive card standing in for a
// light source and it made the night brighter than dusk.
//
// So `fx_spell_pool_now` draws the Kindling pool as a RIM — a ring you can see
// the edge of, with an almost-empty middle — and the pool's actual illumination
// is a dynamic light that belongs to the night model (`frame_light_add`), NOT
// to this file.  `cell_kindle` in fxgen.hml is authored rim-weighted for the
// same reason.  If the pool ever looks unlit, the fix is a light, not a gain.
//
// ---------------------------------------------------------------------------
// DETERMINISM
// ---------------------------------------------------------------------------
// No `@stdlib/random`, no `__clock()`.  Every scatter below comes from
// `sfx_h(spawn_serial, particle_index)`, an FNV-shaped u64 mix with explicit
// masks (i32 `*` traps on overflow — CLAUDE.md A13).  The spawn serial is a
// counter this module owns, so the same sequence of calls and the same `dt`
// sequence produce bit-identical output on both backends, forever.
//
// ---------------------------------------------------------------------------
// BUDGET
// ---------------------------------------------------------------------------
// The brief's number is "FX is ~92 tris in a worst city frame".  A spell is
// transient and is allowed to spend on the moment, but not without a ceiling:
// `g_SFX_FRAME_CAP` sprites per frame, hard, counted, and refusals are visible
// through `fx_spell_dropped()` rather than silent.  At the cap that is 72
// triangles, which is what ONE simultaneous heal + flare + cloak costs.
// ===========================================================================

// ---- effect kinds (retained) ----------------------------------------------
export let g_FXSP_HEAL: i32  = 0;   // Mend — a closing ring and rising motes
export let g_FXSP_FLARE: i32 = 1;   // Flare — the 360 degree violet burst
export let g_FXSP_BLAST: i32 = 2;   // Emberlance detonation — the fire blast
export let g_FXSP_LANCE: i32 = 3;   // Lance — the instant blade
export let g_FXSP_SIGIL: i32 = 4;   // the cast tell / HM_MAGIC hitmarker
export let g_FXSP_TRAIL: i32 = 5;   // one node of the bolt's comet trail
export let g_FXSP_KIND_COUNT: i32 = 6;

// ---- cell binding slots ---------------------------------------------------
// The caller fills an array of `g_FXSC_COUNT` fxgen cell ids.  The six
// explosion frames are CONSECUTIVE in the atlas (fxgen.hml FX_EXPLO_0..5), so
// only the first is bound and the strip is indexed off it; that is the one
// packing assumption this file makes and it is asserted in the probe.
export let g_FXSC_MEND_RING: i32   = 0;
export let g_FXSC_MEND_MOTE: i32   = 1;
export let g_FXSC_CLOAK_0: i32     = 2;
export let g_FXSC_CLOAK_1: i32     = 3;
export let g_FXSC_FLARE_0: i32     = 4;   // +1, +2 are the other two frames
export let g_FXSC_BOLT_HEAD: i32   = 5;
export let g_FXSC_BEAM_SEG: i32    = 6;
export let g_FXSC_LANCE: i32       = 7;
export let g_FXSC_KINDLE_POOL: i32 = 8;
export let g_FXSC_SIGIL: i32       = 9;
export let g_FXSC_EXPLO_0: i32     = 10;  // +1..+5 are the rest of the strip
export let g_FXSC_EMBER: i32       = 11;
export let g_FXSC_COUNT: i32       = 12;

// ---- tint slots -----------------------------------------------------------
// SEMANTIC, not palette names: this file may not import `src/art/palette.hml`
// (the import wall — render may reach core, sim and wobbleweed, never art), and
// it should not want to.  `main.hml` maps these onto NS_*/VENOM_*/MUZZLE_*.
export let g_FXST_MEND: i32       = 0;   // -> VENOM_HALO
export let g_FXST_MEND_DEEP: i32  = 1;   // -> VENOM
export let g_FXST_MAGIC: i32      = 2;   // -> NS_HALO
export let g_FXST_MAGIC_DEEP: i32 = 3;   // -> NS_CORE
export let g_FXST_CLOAK: i32      = 4;   // -> NS_CORE (see fx_spell_cloak_now)
export let g_FXST_FIRE: i32       = 5;   // -> MUZZLE_CORE
export let g_FXST_FIRE_DEEP: i32  = 6;   // -> EMBER
export let g_FXST_COUNT: i32      = 7;

// ---- caps -----------------------------------------------------------------
export let g_FXSP_CAP: i32 = 24;         // live retained effects
export let g_SFX_FRAME_CAP: i32 = 36;    // spell sprites per frame (72 tris)

// ---- effect lifetimes, in SECONDS -----------------------------------------
// Every one of these is a READ-TIME, not a sim duration, and they are short on
// purpose: the brief is "a read at 320x240 that says what happened in under a
// second".  Anything that outlives its own message is litter.  They are pinned
// as literals so a tuning pass has one place to argue with.
let g_SFX_LIFE_HEAL: f64  = 0.90;
let g_SFX_LIFE_FLARE: f64 = 0.40;
let g_SFX_LIFE_BLAST: f64 = 0.55;
let g_SFX_LIFE_LANCE: f64 = 0.22;
let g_SFX_LIFE_SIGIL: f64 = 0.35;
let g_SFX_LIFE_TRAIL: f64 = 0.40;

// ---------------------------------------------------------------------------
// state
// ---------------------------------------------------------------------------

let g_sfx_cell: array<i32> = [];
let g_sfx_tint: array<i32> = [];
let g_sfx_bound: i32 = 0;

let g_sfx_kind: array<i32> = [];
let g_sfx_t: array<f64> = [];
let g_sfx_life: array<f64> = [];
let g_sfx_x: array<f64> = [];
let g_sfx_y: array<f64> = [];
let g_sfx_z: array<f64> = [];
let g_sfx_ax: array<f64> = [];
let g_sfx_ay: array<f64> = [];
let g_sfx_az: array<f64> = [];
let g_sfx_rad: array<f64> = [];
let g_sfx_seed: array<i32> = [];
let g_sfx_n: i32 = 0;

let g_sfx_serial: i32 = 0;       // spawn counter — the determinism key
let g_sfx_clock: f64 = 0.0;      // advanced by fx_spell_update; drives flicker
let g_sfx_spawned: i32 = 0;      // lifetime, for the probe
let g_sfx_refused: i32 = 0;      // spawns dropped because the pool was full
let g_sfx_unbound: i32 = 0;      // draws skipped because no cell was bound

// ---------------------------------------------------------------------------
// deterministic scatter.  All mixing is u64 with explicit masks: i32 `* + -`
// TRAP on overflow in Hemlock (CLAUDE.md A13).
// ---------------------------------------------------------------------------
// MEASURED AND REPLACED — READ THIS BEFORE REACHING FOR FNV AGAIN.
//
// The first version of this function was two rounds of FNV-1a followed by one
// xor-shift, and taking bits 17..31 of the result.  It PASSED nothing, because
// nothing was testing it, and it was WRONG in the specific way that is hardest
// to notice: for a fixed `p_a` and five nearby `p_b` (3, 34, 65, 96, 127 — the
// five motes of one heal) it returned five values within 0.011 of each other.
// Measured, `sfx_f01(0, k*31+3)` for k = 0..4:
//
//     0.6169  0.6206  0.6248  0.6271  0.6249
//
// So all five motes shared a phase, a radius and a direction, and the heal
// rendered as ONE mote — which is exactly what the screenshot showed, with the
// other four sitting invisibly underneath it.  The cause is arithmetic: FNV's
// only mixing step is a multiply by 2^40-ish, so a difference in the low bits
// of the input lands in the HIGH bits of the product, and one xor-shift is not
// enough to bring it back down into the window being sampled.
//
// This is a splitmix64 finalizer, which is the standard answer: two multiplies
// by odd 64-bit constants with an xor-shift on both sides of each, so every
// input bit reaches every output bit.  Same five inputs, measured after:
//
//     0.4946  0.3300  0.7811  0.2693  0.3921
//
// and over the 64x64 grid `sfx_f01(a, k*31+3)`, the 16 equal buckets hold
// 221..297 of 4096 samples against an expected 256 — flat.
//
// All arithmetic is u64 with an explicit mask — i32 `* + -` TRAP on overflow
// (CLAUDE.md A13) — and the constants are decimal, not hex, because
// `ci_imports.sh` R4 bans a 6-hex-digit literal outside palette.hml.
fn sfx_h(p_a: i32, p_b: i32): i32 {
    let m: u64 = 18446744073709551615;
    let z: u64 = (u64(p_a & 1048575) * 2654435769
                  + u64(p_b & 1048575) * 40503
                  + 2654435761) & m;
    z = (z ^ (z >> 33)) & m;
    z = (z * 18397679294719823053) & m;
    z = (z ^ (z >> 29)) & m;
    z = (z * 14181476777654086739) & m;
    z = (z ^ (z >> 32)) & m;
    let out: i32 = i32(z & 32767);
    return out;
}

// [0, 1)
fn sfx_f01(p_a: i32, p_b: i32): f64 {
    let out: f64 = f64(sfx_h(p_a, p_b)) * 0.000030517578125;   // / 32768
    return out;
}

// [-1, 1)
fn sfx_sym(p_a: i32, p_b: i32): f64 {
    let out: f64 = sfx_f01(p_a, p_b) * 2.0 - 1.0;
    return out;
}

fn sfx_clamp01(p_v: f64): f64 {
    let v: f64 = p_v;
    if (v < 0.0) { let a: f64 = 0.0; return a; }
    if (v > 1.0) { let b: f64 = 1.0; return b; }
    let out: f64 = v;
    return out;
}

// ---------------------------------------------------------------------------
// binding
// ---------------------------------------------------------------------------

fn sfx_reserve() {
    if (g_sfx_cell.length == g_FXSC_COUNT) { return; }
    g_sfx_cell = [];
    g_sfx_tint = [];
    while (g_sfx_cell.length < g_FXSC_COUNT) { g_sfx_cell.push(0 - 1); }
    while (g_sfx_tint.length < g_FXST_COUNT) { g_sfx_tint.push(16777215); }
    // The retained pool is allocated ONCE, at the cap, and never grows: nothing
    // in the frame path allocates (CLAUDE.md A8/N6).  `g_sfx_n` is the live
    // count; the tail is stale and never read.
    while (g_sfx_kind.length < g_FXSP_CAP) {
        g_sfx_kind.push(0); g_sfx_t.push(0.0); g_sfx_life.push(1.0);
        g_sfx_x.push(0.0); g_sfx_y.push(0.0); g_sfx_z.push(0.0);
        g_sfx_ax.push(0.0); g_sfx_ay.push(0.0); g_sfx_az.push(0.0);
        g_sfx_rad.push(1.0); g_sfx_seed.push(0);
    }
}

// Bind the twelve fxgen cell ids.  A slot left at -1 makes every draw that
// wants it a counted no-op (`fx_spell_unbound()`), never a garbage cell.
export fn fx_spell_bind_cells(p_cells: array<i32>): i32 {
    sfx_reserve();
    let n: i32 = p_cells.length;
    if (n > g_FXSC_COUNT) { n = g_FXSC_COUNT; }
    for (let i = 0; i < n; i++) { g_sfx_cell[i] = p_cells[i]; }
    g_sfx_bound = 1;
    let out: i32 = n;
    return out;
}

// Bind the seven semantic tints as packed 0xRRGGBB.
export fn fx_spell_bind_tints(p_rgb: array<i32>): i32 {
    sfx_reserve();
    let n: i32 = p_rgb.length;
    if (n > g_FXST_COUNT) { n = g_FXST_COUNT; }
    for (let i = 0; i < n; i++) { g_sfx_tint[i] = p_rgb[i]; }
    let out: i32 = n;
    return out;
}

export fn fx_spell_bound(): i32 { let out: i32 = g_sfx_bound; return out; }
export fn fx_spell_live(): i32 { let out: i32 = g_sfx_n; return out; }
export fn fx_spell_spawned(): i32 { let out: i32 = g_sfx_spawned; return out; }
export fn fx_spell_refused(): i32 { let out: i32 = g_sfx_refused; return out; }
export fn fx_spell_unbound(): i32 { let out: i32 = g_sfx_unbound; return out; }
export fn fx_spell_dropped(): i32 { let out: i32 = g_sfx_frame_dropped; return out; }
export fn fx_spell_sprites(): i32 { let out: i32 = g_sfx_frame_sprites; return out; }
export fn fx_spell_clock(): f64 { let out: f64 = g_sfx_clock; return out; }

// Wipe every live effect and every counter.  This is the save-load / world-swap
// entry point: a retained effect that survives a teleport draws a heal ring in
// the wrong hemisphere.
export fn fx_spell_reset() {
    sfx_reserve();
    g_sfx_n = 0;
    g_sfx_serial = 0;
    g_sfx_clock = 0.0;
    g_sfx_spawned = 0;
    g_sfx_refused = 0;
    g_sfx_unbound = 0;
    g_sfx_trail_any = 0;
}

// ---------------------------------------------------------------------------
// spawning (retained)
// ---------------------------------------------------------------------------

fn sfx_spawn(p_kind: i32, p_life: f64,
             p_x: f64, p_y: f64, p_z: f64,
             p_ax: f64, p_ay: f64, p_az: f64, p_rad: f64): i32 {
    sfx_reserve();
    if (g_sfx_n >= g_FXSP_CAP) {
        g_sfx_refused++;
        let bad: i32 = 0 - 1;
        return bad;
    }
    let i: i32 = g_sfx_n;
    g_sfx_kind[i] = p_kind;
    g_sfx_t[i] = 0.0;
    g_sfx_life[i] = p_life;
    g_sfx_x[i] = p_x; g_sfx_y[i] = p_y; g_sfx_z[i] = p_z;
    g_sfx_ax[i] = p_ax; g_sfx_ay[i] = p_ay; g_sfx_az[i] = p_az;
    g_sfx_rad[i] = p_rad;
    g_sfx_seed[i] = g_sfx_serial;
    g_sfx_serial++;
    g_sfx_n = i + 1;
    g_sfx_spawned++;
    let out: i32 = i;
    return out;
}

// MEND.  `p_x/y/z` is the point the heal CONVERGES ON, and the caller chooses
// it: a body for a third party, and for the local player a point about 1.6 m in
// front of the eye — a ring centred on a first-person camera is a green pane
// over the whole screen and says nothing.
export fn fx_spell_heal(p_x: f64, p_y: f64, p_z: f64): i32 {
    let out: i32 = sfx_spawn(g_FXSP_HEAL, g_SFX_LIFE_HEAL,
                             p_x, p_y, p_z, 0.0, 0.0, 0.0, 1.0);
    return out;
}

// FLARE.  `p_radius` is the spell's own outer reach in metres (spells.hml's
// `spell_reach_m`, 6 m for Flare), so the shell that expands on screen is the
// volume that actually took damage.  A burst that is bigger than its hitbox is
// a lie the player learns to distrust.
export fn fx_spell_flare(p_x: f64, p_y: f64, p_z: f64, p_radius: f64): i32 {
    let out: i32 = sfx_spawn(g_FXSP_FLARE, g_SFX_LIFE_FLARE,
                             p_x, p_y, p_z, 0.0, 0.0, 0.0, p_radius);
    return out;
}

// THE FIRE BLAST — the Emberlance detonation.  Orange, and it must never be
// mistaken for anything violet: spells.hml DESIGN 2 makes this the school's one
// KINETIC spell precisely so a player behind a magic resistance still has an
// answer, and that only works if the answer LOOKS different.
export fn fx_spell_blast(p_x: f64, p_y: f64, p_z: f64, p_radius: f64): i32 {
    let out: i32 = sfx_spawn(g_FXSP_BLAST, g_SFX_LIFE_BLAST,
                             p_x, p_y, p_z, 0.0, 0.0, 0.0, p_radius);
    return out;
}

// LANCE — the discharge at the END of the 1.2 s wind-up.  The wind-up itself is
// `fx_spell_windup_now`.
export fn fx_spell_lance(p_x0: f64, p_y0: f64, p_z0: f64,
                         p_x1: f64, p_y1: f64, p_z1: f64): i32 {
    let out: i32 = sfx_spawn(g_FXSP_LANCE, g_SFX_LIFE_LANCE,
                             p_x0, p_y0, p_z0, p_x1, p_y1, p_z1, 1.0);
    return out;
}

// SIGIL — the four-petal bloom.  Two call sites: the cast tell at the caster's
// hand, and MAGIC_KINETIC §2.1's `HM_MAGIC` hitmarker on a magic hit.  Same
// glyph both times on purpose: one shape has to mean "magic" or none does.
export fn fx_spell_sigil(p_x: f64, p_y: f64, p_z: f64, p_size: f64): i32 {
    let out: i32 = sfx_spawn(g_FXSP_SIGIL, g_SFX_LIFE_SIGIL,
                             p_x, p_y, p_z, 0.0, 0.0, 0.0, p_size);
    return out;
}

// One node of the bolt's comet trail.  Call it EVERY FRAME at the projectile's
// position; the nodes fade in place and the head is `fx_spell_bolt_now`.
//
// IT IS SPACED BY DISTANCE, NOT BY FRAME, AND THAT IS A BUDGET DECISION.
// Called once per frame at 60 Hz with a 0.40 s life, the naive version kept 24
// nodes alive — 48 triangles for ONE projectile, measured, against a worst-case
// FX frame of about 92.  It was also frame-rate dependent: the same bolt at 120
// fps would have cost twice as much and looked identical.  A node is now
// refused unless it is `g_SFX_TRAIL_STEP` from the last one, so the trail's
// cost is set by how far the bolt has flown and by nothing else.  A 12 m/s
// Emberlance keeps ~11 nodes = 22 triangles at any frame rate.
//
// The refusal is NOT counted as a drop: it is the emitter working, not the
// budget failing.
export let g_SFX_TRAIL_STEP: f64 = 0.45;

let g_sfx_trail_x: f64 = 0.0;
let g_sfx_trail_y: f64 = 0.0;
let g_sfx_trail_z: f64 = 0.0;
let g_sfx_trail_any: i32 = 0;

export fn fx_spell_trail(p_x: f64, p_y: f64, p_z: f64): i32 {
    if (g_sfx_trail_any == 1) {
        let dx: f64 = p_x - g_sfx_trail_x;
        let dy: f64 = p_y - g_sfx_trail_y;
        let dz: f64 = p_z - g_sfx_trail_z;
        if (dx * dx + dy * dy + dz * dz
            < g_SFX_TRAIL_STEP * g_SFX_TRAIL_STEP) {
            let skip: i32 = 0 - 1;
            return skip;
        }
    }
    g_sfx_trail_x = p_x; g_sfx_trail_y = p_y; g_sfx_trail_z = p_z;
    g_sfx_trail_any = 1;
    let out: i32 = sfx_spawn(g_FXSP_TRAIL, g_SFX_LIFE_TRAIL,
                             p_x, p_y, p_z, 0.0, 0.0, 0.0, 1.0);
    return out;
}

// ---------------------------------------------------------------------------
// update — ages every retained effect and retires the dead ones.
//
// `p_dt` is the CALLER'S delta.  There is no `__clock()` in this file and there
// must not be: the same call sequence with the same dt sequence has to produce
// the same pixels on both backends and in a replay.
// ---------------------------------------------------------------------------
export fn fx_spell_update(p_dt: f64): i32 {
    sfx_reserve();
    let dt: f64 = p_dt;
    if (dt < 0.0) { dt = 0.0; }
    g_sfx_clock = g_sfx_clock + dt;
    let i: i32 = 0;
    while (i < g_sfx_n) {
        g_sfx_t[i] = g_sfx_t[i] + dt;
        if (g_sfx_t[i] >= g_sfx_life[i]) {
            // swap-with-last retirement.  Deterministic, O(1), and the FX layer
            // is depth-sorted downstream so the order change is invisible.
            let last: i32 = g_sfx_n - 1;
            g_sfx_kind[i] = g_sfx_kind[last];
            g_sfx_t[i] = g_sfx_t[last];
            g_sfx_life[i] = g_sfx_life[last];
            g_sfx_x[i] = g_sfx_x[last];
            g_sfx_y[i] = g_sfx_y[last];
            g_sfx_z[i] = g_sfx_z[last];
            g_sfx_ax[i] = g_sfx_ax[last];
            g_sfx_ay[i] = g_sfx_ay[last];
            g_sfx_az[i] = g_sfx_az[last];
            g_sfx_rad[i] = g_sfx_rad[last];
            g_sfx_seed[i] = g_sfx_seed[last];
            g_sfx_n = last;
        } else {
            i++;
        }
    }
    let out: i32 = g_sfx_n;
    return out;
}

// ---------------------------------------------------------------------------
// the budgeted push.  EVERY spell sprite goes through here.
// ---------------------------------------------------------------------------
// `p_frame` offsets the CELL, not the slot.  That distinction was a real bug:
// the flare and explosion strips live at consecutive ATLAS cells but occupy one
// BINDING slot each, so `g_FXSC_EXPLO_0 + frame` walked off the end of a
// 12-entry array and took the whole harness down.  Strips index the atlas;
// slots are never arithmetic.
fn sfx_push(p_x: f64, p_y: f64, p_z: f64, p_s: f64,
            p_slot: i32, p_frame: i32, p_kind: i32, p_tint: i32, p_a: i32): i32 {
    let cell: i32 = g_sfx_cell[p_slot];
    if (cell < 0) { g_sfx_unbound++; let bad: i32 = 0; return bad; }
    cell = cell + p_frame;
    let a: i32 = p_a;
    if (a <= 0) { let none: i32 = 0; return none; }
    if (a > 255) { a = 255; }
    if (g_sfx_frame_sprites >= g_SFX_FRAME_CAP) {
        g_sfx_frame_dropped++;
        let full: i32 = 0;
        return full;
    }
    g_sfx_frame_sprites++;
    let t: i32 = g_sfx_tint[p_tint];
    fx_add(p_x, p_y, p_z, p_s, cell, p_kind,
           (t >> 16) & 255, (t >> 8) & 255, t & 255, a);
    let out: i32 = 1;
    return out;
}

fn sfx_push_streak(p_x0: f64, p_y0: f64, p_z0: f64,
                   p_x1: f64, p_y1: f64, p_z1: f64,
                   p_hw: f64, p_slot: i32, p_tint: i32, p_a: i32): i32 {
    let cell: i32 = g_sfx_cell[p_slot];
    if (cell < 0) { g_sfx_unbound++; let bad: i32 = 0; return bad; }
    let a: i32 = p_a;
    if (a <= 0) { let none: i32 = 0; return none; }
    if (a > 255) { a = 255; }
    if (g_sfx_frame_sprites >= g_SFX_FRAME_CAP) {
        g_sfx_frame_dropped++;
        let full: i32 = 0;
        return full;
    }
    g_sfx_frame_sprites++;
    let t: i32 = g_sfx_tint[p_tint];
    fx_streak_add(p_x0, p_y0, p_z0, p_x1, p_y1, p_z1, p_hw, cell,
                  (t >> 16) & 255, (t >> 8) & 255, t & 255, a);
    let out: i32 = 1;
    return out;
}

// A deterministic unit direction in the XZ plane from two hashes.  No trig: the
// cost is one sqrt and it is bit-identical on both backends, which `sin` of a
// hashed angle would also be but for more work and no more character.
fn sfx_dir_x(p_a: i32, p_b: i32): f64 {
    let dx: f64 = sfx_sym(p_a, p_b);
    let dz: f64 = sfx_sym(p_a, p_b + 7717);
    let l: f64 = sqrt(dx * dx + dz * dz);
    if (l < 0.0001) { let one: f64 = 1.0; return one; }
    let out: f64 = dx / l;
    return out;
}
fn sfx_dir_z(p_a: i32, p_b: i32): f64 {
    let dx: f64 = sfx_sym(p_a, p_b);
    let dz: f64 = sfx_sym(p_a, p_b + 7717);
    let l: f64 = sqrt(dx * dx + dz * dz);
    if (l < 0.0001) { let zero: f64 = 0.0; return zero; }
    let out: f64 = dz / l;
    return out;
}

// ---------------------------------------------------------------------------
// the six retained effects
// ---------------------------------------------------------------------------

// MEND.  The ring SHRINKS.  That single choice is the whole read: a growing
// hoop is a shockwave and a shrinking hoop is a gather, they cost the same two
// triangles, and they mean opposite things.  Five motes rise through it,
// staggered by a hashed phase so they do not march in step, and they are what
// carries the heal in FIRST PERSON where the ring is behind your own eyes.
fn sfx_emit_heal(p_i: i32) {
    let u: f64 = sfx_clamp01(g_sfx_t[p_i] / g_sfx_life[p_i]);
    let sd: i32 = g_sfx_seed[p_i];
    let x: f64 = g_sfx_x[p_i];
    let y: f64 = g_sfx_y[p_i];
    let z: f64 = g_sfx_z[p_i];
    // 2.55 m -> 0.70 m over the life
    let ring: f64 = 2.55 - 1.85 * u;
    // 1 - u^2: full for the first third, gone by the end.  A linear fade reads
    // as a dimmer switch; this reads as an event that finished.
    let af: f64 = 1.0 - u * u;
    sfx_push(x, y + 0.85, z, ring, g_FXSC_MEND_RING, 0, g_FXK_SPRITE,
             g_FXST_MEND, i32(238.0 * af));
    for (let k = 0; k < 5; k++) {
        // each mote runs its own 0..1 with a hashed head start, and wraps
        let ph: f64 = sfx_f01(sd, k * 31 + 3);
        let mu: f64 = u * 1.35 + ph;
        while (mu > 1.0) { mu = mu - 1.0; }
        let rad: f64 = 0.30 + 0.55 * sfx_f01(sd, k * 31 + 11);
        let dx: f64 = sfx_dir_x(sd, k * 31 + 17);
        let dz: f64 = sfx_dir_z(sd, k * 31 + 17);
        // motes converge as they rise: a column that also narrows says INTO you
        let sh: f64 = 1.0 - 0.55 * mu;
        // LOOKED AT AND FIXED.  A linear `(1 - mu)` fade meant that at any
        // instant most of the five motes were in the dim half of their own run,
        // and at 320x240 a 10-pixel sprite at alpha 60 on night grass is not
        // there.  Photographed mid-heal the effect was a ring with an empty
        // middle — and the motes are the half of this effect that works in
        // FIRST PERSON.  `1 - 0.85 mu^2` holds them near full for the first
        // half of the rise and drops them at the top, where the fade belongs.
        let ma: f64 = (1.0 - mu * mu * 0.85) * af;
        sfx_push(x + dx * rad * sh, y - 0.15 + 2.05 * mu, z + dz * rad * sh,
                 0.26 + 0.10 * sfx_f01(sd, k * 31 + 23),
                 g_FXSC_MEND_MOTE, 0, g_FXK_SPRITE, g_FXST_MEND,
                 i32(252.0 * ma));
    }
}

// FLARE.  Three atlas frames carry the time and the card carries the size, so
// the effect reads as a shell LEAVING rather than as a light going out.  It
// expands on sqrt(u), i.e. fast then slowing, which is what a pressure front
// does and what the eye expects.
fn sfx_emit_flare(p_i: i32) {
    let u: f64 = sfx_clamp01(g_sfx_t[p_i] / g_sfx_life[p_i]);
    let sd: i32 = g_sfx_seed[p_i];
    let R: f64 = g_sfx_rad[p_i];
    let x: f64 = g_sfx_x[p_i];
    let y: f64 = g_sfx_y[p_i];
    let z: f64 = g_sfx_z[p_i];
    let f: i32 = 0;
    if (u >= 0.30) { f = 1; }
    if (u >= 0.62) { f = 2; }
    // LOOKED AT AND FIXED.  R*1.90 made the shell 2x the spell's own radius —
    // arithmetically defensible, visually a 12 m soft donut that filled the
    // whole 320x240 frame at half brightness for a third of a second.  What the
    // eye read was a lavender fog bank, not an explosion.  R*1.30 puts the
    // shell's outer edge close to the volume that actually took damage, and the
    // alpha now falls on af*(0.35 + 0.65*af) so the card is BRIGHT while it is
    // SMALL and nearly gone by the time it is big.  Punch, then absence.
    let sz: f64 = 0.90 + R * 1.30 * sqrt(u);
    let af: f64 = 1.0 - u;
    sfx_push(x, y, z, sz, g_FXSC_FLARE_0, f, g_FXK_SPRITE,
             g_FXST_MAGIC, i32(255.0 * af * (0.35 + 0.65 * af)));
    // five sparks thrown clear of the shell, slightly ahead of it so the
    // silhouette is never a clean disc
    for (let k = 0; k < 5; k++) {
        let dx: f64 = sfx_dir_x(sd, k * 53 + 5);
        let dz: f64 = sfx_dir_z(sd, k * 53 + 5);
        let sp: f64 = R * (0.75 + 0.45 * sfx_f01(sd, k * 53 + 9)) * sqrt(u);
        let rise: f64 = 1.30 * u - 1.60 * u * u;
        sfx_push(x + dx * sp, y + rise, z + dz * sp,
                 0.34 + 0.16 * sfx_f01(sd, k * 53 + 13),
                 g_FXSC_MEND_MOTE, 0, g_FXK_SPRITE, g_FXST_MAGIC_DEEP,
                 i32(240.0 * af * af));
    }
}

// THE FIRE BLAST.  `FX_EXPLO_0..5` already existed and is not duplicated in the
// atlas — six frames of orange, which is the one thing in the school that is
// not violet.  Embers are thrown with a real ballistic arc because fire falls
// and magic does not, and at 320x240 that difference in MOTION is more legible
// than any difference in colour.
fn sfx_emit_blast(p_i: i32) {
    let u: f64 = sfx_clamp01(g_sfx_t[p_i] / g_sfx_life[p_i]);
    let sd: i32 = g_sfx_seed[p_i];
    let R: f64 = g_sfx_rad[p_i];
    let x: f64 = g_sfx_x[p_i];
    let y: f64 = g_sfx_y[p_i];
    let z: f64 = g_sfx_z[p_i];
    let f: i32 = i32(u * 6.0);
    if (f > 5) { f = 5; }
    if (f < 0) { f = 0; }
    // LOOKED AT AND FIXED.  R*1.70 drew `FX_EXPLO_2` five metres across at five
    // metres range, and that cell is a CHUNKY 16x16 blob authored for a grenade
    // seen at distance: magnified 20x per texel it reads as an orange RECTANGLE.
    // The strip is not this task's art and is not being rewritten for a spell —
    // the fix is to draw it at the size it was authored for and to put the
    // brightness somewhere that can carry it.  R*1.05 caps the shell at ~4.5 m
    // for the Emberlance's 3.5 m AoE, and a BOLT_HEAD core burns in the middle
    // for the first 40 % of the life, which is where an explosion's light
    // actually is.
    let sz: f64 = 0.85 + R * 1.05 * sqrt(u);
    sfx_push(x, y, z, sz, g_FXSC_EXPLO_0, f, g_FXK_SPRITE,
             g_FXST_FIRE, i32(255.0 * (1.0 - u * u * 0.85)));
    if (u < 0.40) {
        let cu: f64 = u * 2.5;                   // 0..1 over the first 40 %
        sfx_push(x, y, z, 0.70 + 1.30 * cu, g_FXSC_BOLT_HEAD, 0,
                 g_FXK_SPRITE, g_FXST_FIRE, i32(255.0 * (1.0 - cu)));
    }
    for (let k = 0; k < 4; k++) {
        let dx: f64 = sfx_dir_x(sd, k * 71 + 2);
        let dz: f64 = sfx_dir_z(sd, k * 71 + 2);
        let sp: f64 = R * (0.55 + 0.70 * sfx_f01(sd, k * 71 + 6));
        let up: f64 = 1.10 + 1.30 * sfx_f01(sd, k * 71 + 10);
        // x = v*t, y = v*t - g*t^2 : embers ARC, they do not radiate
        sfx_push(x + dx * sp * u, y + up * u - 2.60 * u * u, z + dz * sp * u,
                 0.20 + 0.10 * sfx_f01(sd, k * 71 + 14),
                 g_FXSC_EMBER, 0, g_FXK_SPRITE, g_FXST_FIRE_DEEP,
                 i32(235.0 * (1.0 - u)));
    }
}

// LANCE.  Two triangles of streak that thin as they die, plus the sigil at the
// muzzle end.  0.22 s: it is meant to be over before you have finished seeing
// it, and the sigil is what is left in the eye.
fn sfx_emit_lance(p_i: i32) {
    let u: f64 = sfx_clamp01(g_sfx_t[p_i] / g_sfx_life[p_i]);
    let hw: f64 = 0.05 + 0.17 * (1.0 - u);
    sfx_push_streak(g_sfx_x[p_i], g_sfx_y[p_i], g_sfx_z[p_i],
                    g_sfx_ax[p_i], g_sfx_ay[p_i], g_sfx_az[p_i],
                    hw, g_FXSC_LANCE, g_FXST_MAGIC, i32(255.0 * (1.0 - u)));
    sfx_push(g_sfx_x[p_i], g_sfx_y[p_i], g_sfx_z[p_i],
             0.45 + 0.35 * u, g_FXSC_SIGIL, 0, g_FXK_SPRITE,
             g_FXST_MAGIC, i32(230.0 * (1.0 - u)));
}

// SIGIL.  Grows a little and fades on 1 - u^2, so it is bright while it is
// small and gone while it is big — a marker that blooms rather than a decal
// that dissolves.
fn sfx_emit_sigil(p_i: i32) {
    let u: f64 = sfx_clamp01(g_sfx_t[p_i] / g_sfx_life[p_i]);
    sfx_push(g_sfx_x[p_i], g_sfx_y[p_i], g_sfx_z[p_i],
             g_sfx_rad[p_i] * (0.62 + 0.55 * u),
             g_FXSC_SIGIL, 0, g_FXK_SPRITE, g_FXST_MAGIC,
             i32(245.0 * (1.0 - u * u)));
}

// LOOKED AT AND FIXED.  A 0.28 s life with a LINEAR alpha fade put every node
// within a metre of the head at 4/10 brightness, and a comet whose tail is
// dimmer than its own head at one metre back is a dot.  The life is 0.40 s and
// the fade is `1 - 0.85 u^2`, which holds the tail near full for the first
// third and then drops it — so the trail has LENGTH, which is the only thing on
// screen that says the bolt is MOVING.
fn sfx_emit_trail(p_i: i32) {
    let u: f64 = sfx_clamp01(g_sfx_t[p_i] / g_sfx_life[p_i]);
    sfx_push(g_sfx_x[p_i], g_sfx_y[p_i], g_sfx_z[p_i],
             0.42 * (1.0 - u * 0.70) + 0.08,
             g_FXSC_EMBER, 0, g_FXK_SPRITE, g_FXST_FIRE_DEEP,
             i32(225.0 * (1.0 - u * u * 0.85)));
}

// Draw every live retained effect into the particle and streak registries.
// Call once per frame, after `fx_clear` and before `fx_emit`.  Returns the
// number of spell sprites this call added.
export fn fx_spell_emit(): i32 {
    sfx_reserve();
    let before: i32 = g_sfx_frame_sprites;
    for (let i = 0; i < g_sfx_n; i++) {
        let k: i32 = g_sfx_kind[i];
        if (k == g_FXSP_HEAL) { sfx_emit_heal(i); }
        else if (k == g_FXSP_FLARE) { sfx_emit_flare(i); }
        else if (k == g_FXSP_BLAST) { sfx_emit_blast(i); }
        else if (k == g_FXSP_LANCE) { sfx_emit_lance(i); }
        else if (k == g_FXSP_SIGIL) { sfx_emit_sigil(i); }
        else if (k == g_FXSP_TRAIL) { sfx_emit_trail(i); }
    }
    let out: i32 = g_sfx_frame_sprites - before;
    return out;
}

// ---------------------------------------------------------------------------
// the five immediate emitters — STATE the sim already owns
// ---------------------------------------------------------------------------

// GUTTERING.  `p_frac` is how much cloak is left (spells.hml SP_CLOAK_T over
// its total), used only to fade the last of it.
//
// THE CLOAK CANNOT BE DRAWN AS DARKNESS.  Additive has no term that removes
// light, so this is a SHIMMER instead: three deep-violet cards at low alpha,
// alternating between the two atlas frames on a fixed 11 Hz beat off this
// module's own clock.  The alpha ceiling here is 118 and that is the design,
// not a placeholder — spells.hml DESIGN 3 says the cloak's tell is supposed to
// be the lantern you are still carrying, and a cloak that flashes is a cloak
// that gives you away.  If this ever reads as "bright", it is wrong.
export fn fx_spell_cloak_now(p_x: f64, p_y: f64, p_z: f64, p_frac: f64): i32 {
    sfx_reserve();
    let fr: f64 = sfx_clamp01(p_frac);
    // fade only over the last 20 % — a cloak that dims all the way through
    // tells the player it is failing from the moment it starts
    let af: f64 = 1.0;
    if (fr < 0.20) { af = fr * 5.0; }
    let phase: i32 = i32(g_sfx_clock * 11.0) & 1;
    let slot: i32 = g_FXSC_CLOAK_0;
    let anti: i32 = g_FXSC_CLOAK_1;
    if (phase == 1) { slot = g_FXSC_CLOAK_1; anti = g_FXSC_CLOAK_0; }
    let n: i32 = 0;
    // LOOKED AT AND RAISED, ONCE, AND HERE IS THE HONEST ACCOUNT.  The first
    // pass capped these at 118/92/78 with an NS_MID tint and rendered as
    // NOTHING: a faint smear at night and literally invisible against a noon
    // sky.  A cloak the player cannot tell is running is not a subtle cloak, it
    // is a broken one.  The ceiling is now 152 and the tint slot is documented
    // as NS_CORE rather than NS_MID.  It is STILL the dimmest effect in the
    // school by a factor of two against the flare's 255, which is the design
    // (spells.hml DESIGN 3: the tell is the lantern, not a firework) — the
    // number moved, the intent did not.
    n = n + sfx_push(p_x, p_y + 0.95, p_z, 1.55, slot, 0, g_FXK_SPRITE,
                     g_FXST_CLOAK, i32(152.0 * af));
    n = n + sfx_push(p_x, p_y + 1.55, p_z, 1.05, anti, 0, g_FXK_SPRITE,
                     g_FXST_CLOAK, i32(124.0 * af));
    n = n + sfx_push(p_x, p_y + 0.35, p_z, 1.20, slot, 0, g_FXK_SPRITE,
                     g_FXST_CLOAK, i32(104.0 * af));
    let out: i32 = n;
    return out;
}

// THE SHUTTER.  A sustained cone, drawn as one streak from the eye to the far
// end of the cone.  `p_frac` is a 0..1 intensity the caller can drive off the
// beam tick (`SP_BEAM_T`), so a beam that is about to run out of oil visibly
// thins instead of cutting.
export fn fx_spell_beam_now(p_x0: f64, p_y0: f64, p_z0: f64,
                            p_x1: f64, p_y1: f64, p_z1: f64,
                            p_frac: f64): i32 {
    sfx_reserve();
    let fr: f64 = sfx_clamp01(p_frac);
    // a hashed 0.85..1.0 jitter off the clock: a beam with a constant width is
    // a painted stripe, and the flicker costs nothing
    let j: f64 = 0.85 + 0.15 * sfx_f01(i32(g_sfx_clock * 40.0), 91);
    let out: i32 = sfx_push_streak(p_x0, p_y0, p_z0, p_x1, p_y1, p_z1,
                                   (0.16 + 0.10 * fr) * j,
                                   g_FXSC_BEAM_SEG, g_FXST_MAGIC,
                                   i32((150.0 + 90.0 * fr) * j));
    return out;
}

// KINDLING.  See "THE THING THIS FILE MUST NOT DO" in the header: this is the
// BOUNDARY of the volume, not its light.  One ground quad on the terrain and
// three motes drifting up out of it; the illumination is a dynamic light and
// belongs to the night model.
//
// The ground quad has NO ALPHA CHANNEL (`emit_quad_world` takes a packed RGB),
// so the fade is spent on the tint instead and `fx_emit` folds the registry
// alpha into the RGB for `g_FXK_GROUND` before submitting it.
export fn fx_spell_pool_now(p_x: f64, p_y: f64, p_z: f64,
                            p_radius: f64, p_frac: f64): i32 {
    sfx_reserve();
    let fr: f64 = sfx_clamp01(p_frac);
    let af: f64 = 1.0;
    if (fr < 0.25) { af = fr * 4.0; }
    let n: i32 = 0;
    // MAGIC_DEEP, not MAGIC: NS_HALO is (232,166,255) and a pale tint on a pale
    // rim lands PINK on grass.  The saturated NS_CORE keeps the pool violet,
    // which is what ties it to the rest of the school.
    n = n + sfx_push(p_x, p_y, p_z, p_radius * 2.0,
                     g_FXSC_KINDLE_POOL, 0, g_FXK_GROUND, g_FXST_MAGIC_DEEP,
                     i32(215.0 * af));
    let tick: i32 = i32(g_sfx_clock * 2.0);
    for (let k = 0; k < 3; k++) {
        let ph: f64 = sfx_f01(tick, k * 13 + 1);
        let mu: f64 = g_sfx_clock * 0.55 + ph;
        while (mu > 1.0) { mu = mu - 1.0; }
        let dx: f64 = sfx_dir_x(tick, k * 13 + 5);
        let dz: f64 = sfx_dir_z(tick, k * 13 + 5);
        let rr: f64 = p_radius * (0.25 + 0.60 * sfx_f01(tick, k * 13 + 9));
        n = n + sfx_push(p_x + dx * rr, p_y + 0.15 + 1.60 * mu, p_z + dz * rr,
                         0.20, g_FXSC_MEND_MOTE, 0, g_FXK_SPRITE,
                         g_FXST_MAGIC, i32(180.0 * af * (1.0 - mu)));
    }
    let out: i32 = n;
    return out;
}

// The Emberlance bolt's head.  Called every frame at the projectile's position;
// `fx_spell_trail` lays the tail down behind it.
export fn fx_spell_bolt_now(p_x: f64, p_y: f64, p_z: f64): i32 {
    sfx_reserve();
    let out: i32 = sfx_push(p_x, p_y, p_z, 0.85, g_FXSC_BOLT_HEAD, 0,
                            g_FXK_SPRITE, g_FXST_FIRE, 255);
    return out;
}

// THE CHANNEL WIND-UP — Mend's 1.2 s channel and the Lance's 1.2 s locked
// wind-up are the same machinery in spells.hml (`CHMODE_TICK` vs
// `CHMODE_FINISH`), so they get the same tell: a sigil at the hand that GROWS,
// with motes converging INTO it.  `p_frac` is `spell_channel_frac`.
//
// The two are told apart by the tint the caller passes through
// `p_heal`: 1 for Mend (green), 0 for anything else (violet).  That is the
// whole difference and it is enough — the shape says "something is charging",
// the colour says which one.
export fn fx_spell_windup_now(p_x: f64, p_y: f64, p_z: f64,
                              p_frac: f64, p_heal: i32): i32 {
    sfx_reserve();
    let fr: f64 = sfx_clamp01(p_frac);
    let tint: i32 = g_FXST_MAGIC;
    let mote_tint: i32 = g_FXST_MAGIC_DEEP;
    if (p_heal != 0) { tint = g_FXST_MEND; mote_tint = g_FXST_MEND_DEEP; }
    let n: i32 = 0;
    n = n + sfx_push(p_x, p_y, p_z, 0.20 + 0.42 * fr, g_FXSC_SIGIL, 0,
                     g_FXK_SPRITE, tint, i32(90.0 + 150.0 * fr));
    let tick: i32 = i32(g_sfx_clock * 3.0);
    for (let k = 0; k < 3; k++) {
        // mu runs 1 -> 0: the motes come IN.  This is the same trick as the
        // heal ring and for the same reason — inward means gathering.
        let ph: f64 = sfx_f01(tick, k * 17 + 2);
        let mu: f64 = g_sfx_clock * 1.10 + ph;
        while (mu > 1.0) { mu = mu - 1.0; }
        let rr: f64 = 0.28 + 1.05 * mu;
        let dx: f64 = sfx_dir_x(tick, k * 17 + 6);
        let dz: f64 = sfx_dir_z(tick, k * 17 + 6);
        n = n + sfx_push(p_x + dx * rr, p_y + 0.35 * mu, p_z + dz * rr,
                         0.15, g_FXSC_MEND_MOTE, 0, g_FXK_SPRITE, mote_tint,
                         i32(210.0 * fr * (1.0 - mu)));
    }
    let out: i32 = n;
    return out;
}
