// ===========================================================================
// nightshade/src/render/hud.hml — THE HUD LAYER'S SURFACE      (renderer-split)
// ===========================================================================
//
// ⚠ READ THIS BEFORE LOOKING FOR THE CROSSHAIR. IT IS NOT HERE YET, AND THAT IS
//   REPORTED, NOT HIDDEN.
//
// ARCHITECTURE.md §5.6 describes this file as "ART_BIBLE §9 verbatim: crosshair
// with real spread bloom, hitmarker, health, ammo, compass, minimap, killfeed,
// XP bar, popups, damage vignette, hit-direction arcs, reload bar, interact
// prompt", exporting `hud_new, hud_build, hud_event, hud_set_tri_cap`.
//
// NONE OF THAT CONTENT WAS IN `world_render.hml` TO EXTRACT. §4 stage 24 is the
// CALLER's by design (§5.6b: the HUD is per-consumer content — the harness draws
// scene labels, the walkaround draws a frame-budget readout, the game draws the
// real §9 HUD), so `hud_build` lives THREE TIMES today, once each in
// `src/game/main.hml`, `tools/shot.hml` and `tools/benchframe.hml`. Those three
// files are not owned by the renderer-split task and were not touched.
//
// So this file is the part of the HUD layer the orchestrator DID hold, extracted
// unchanged in behaviour: the atlas handle, the HUD_SOLID texel every flat quad
// samples, and the two flat-quad primitives that every HUD and postfx element in
// the project is built out of. That is a real module on the real frame path —
// `postfx_geo.hml` draws both of its overlays through it, every frame — and it is
// the surface a future `hud_build` lands on instead of a fourth private copy.
//
// A STUBBED `hud_build` / `hud_event` / `hud_set_tri_cap` IS DELIBERATELY ABSENT.
// Wave 2's lesson was that a harness carrying ~650 lines of stand-in art makes
// every screenshot and every probe pass while depicting nothing real. An empty
// exported function nobody calls is the same defect one layer up: it makes §5.6
// look satisfied. See the task report for the gap, stated plainly.
//
// ---------------------------------------------------------------------------
// WHY THE PRIMITIVES SAMPLE ONE TEXEL
// ---------------------------------------------------------------------------
// There are four SDL textures and no fifth (CLAUDE.md §6), so a flat coloured
// rectangle is not a coloured rectangle — it is the HUD atlas's one known-white
// texel (`HUD_SOLID`) modulated by vertex colour. Vertex colour can only DARKEN
// (§8), which is why that texel is authored at full albedo and why its uv rect
// has to be handed in by the caller: `src/render/**` may not import
// `src/art/**` (§5.6b), so `hudgen`'s cell id reaches this file as four numbers.
// ===========================================================================

import { quad_screen_uv, quad_ring } from "../../../wobbleweed/src/quad.hml";
import { cos, floor } from "@stdlib/math";

// ===========================================================================
// 1. BOUND RESOURCES
// ===========================================================================

let g_tex_hud = null;

// HUD_SOLID's uv rect, the one texel every flat HUD/postfx quad samples.
let g_solid_u0: f64 = 0.0; let g_solid_v0: f64 = 0.0;
let g_solid_u1: f64 = 1.0; let g_solid_v1: f64 = 1.0;

export fn hud_bind_texture(p_tex) { g_tex_hud = p_tex; }
export fn hud_texture() { let out = g_tex_hud; return out; }

export fn hud_set_solid_uv(p_u0: f64, p_v0: f64, p_u1: f64, p_v1: f64) {
    g_solid_u0 = p_u0; g_solid_v0 = p_v0;
    g_solid_u1 = p_u1; g_solid_v1 = p_v1;
}

export fn hud_solid_u0(): f64 { let out: f64 = g_solid_u0; return out; }
export fn hud_solid_v0(): f64 { let out: f64 = g_solid_v0; return out; }
export fn hud_solid_u1(): f64 { let out: f64 = g_solid_u1; return out; }
export fn hud_solid_v1(): f64 { let out: f64 = g_solid_v1; return out; }

// ===========================================================================
// 2. THE TWO FLAT-QUAD PRIMITIVES
// ---------------------------------------------------------------------------
// Both take the batch, because `world_render.hml` owns the four batches by name
// (§5.6) and this file must not learn the layer order.
// ===========================================================================

// A flat screen-space rectangle in the bound HUD atlas's solid texel.
export fn hud_solid_quad(p_b, p_x: f64, p_y: f64, p_w: f64, p_h: f64,
                         p_r: i32, p_g: i32, p_bl: i32, p_a: i32,
                         p_depth: f64): i32 {
    let n: i32 = quad_screen_uv(p_b, g_tex_hud, p_x, p_y, p_w, p_h,
                                g_solid_u0, g_solid_v0, g_solid_u1, g_solid_v1,
                                p_r, p_g, p_bl, p_a, p_depth);
    let out: i32 = n;
    return out;
}

// An elliptical ring of `p_segs` quads, alpha-graded inner -> outer. The uv is
// the CENTRE of the solid texel rather than its rect, because a ring's quads are
// not axis-aligned and a sheared uv rect would sample the texel's neighbours at
// the atlas cell boundary.
export fn hud_solid_ring(p_b, p_cx: f64, p_cy: f64,
                         p_rxi: f64, p_ryi: f64, p_rxo: f64, p_ryo: f64,
                         p_segs: i32,
                         p_r: i32, p_g: i32, p_bl: i32,
                         p_a_in: i32, p_a_out: i32, p_depth: f64): i32 {
    let n: i32 = quad_ring(p_b, g_tex_hud, p_cx, p_cy,
                           p_rxi, p_ryi, p_rxo, p_ryo, p_segs,
                           (g_solid_u0 + g_solid_u1) * 0.5,
                           (g_solid_v0 + g_solid_v1) * 0.5,
                           p_r, p_g, p_bl, p_a_in, p_a_out, p_depth);
    let out: i32 = n;
    return out;
}

// ===========================================================================
// 3. THE FOUR-SEGMENT DAMAGE DIRECTION INDICATOR — THE MATH ONLY  (GDD §7.13)
// ---------------------------------------------------------------------------
// `src/sim/combat.hml:1399` has emitted `EV_DAMAGE_TAKEN` since it was written,
// with the position field deliberately set to where the damage CAME FROM rather
// than where it landed, and its own comment says why: "GDD §7.13's 4-segment
// direction indicator". The event was authoritative, networked and complete.
// What consumed it was a SINGLE arrow sprite placed at
//
//     cx + clamp(sin(bearing - yaw) * 40, -44, 44)
//
// and that is not a direction indicator, it is half of one. `sin` alone cannot
// separate front from back: an attacker dead ahead (rel = 0) and an attacker
// dead behind (rel = pi) both give sin = 0, so BOTH drew the arrow in the exact
// centre of the screen. NAIVE_PLAYER.md §T+0:12 -- "in not one of those frames
// was there anything on screen that had hit me" -- was looking at an indicator
// that was on, and pointing nowhere.
//
// The fix is the missing axis. A bearing needs BOTH components to be a
// direction, so the segment set is the four quadrants and the weight is the
// COSINE of the angle between the segment and the source:
//
//              FRONT (rel 0, above the crosshair)
//     LEFT (-pi/2)        +        RIGHT (+pi/2)
//              BACK  (rel pi, below the crosshair)
//
// WHY IT LIVES IN THIS FILE AND NOT AT THE DRAW SITE. `hud_build` is in
// `src/game/main.hml`, which is a PROGRAM -- it calls `main()` at top level and
// needs a window -- so nothing headless can import it, and every previous
// attempt to test HUD content has had to write a SECOND DESCRIPTION of it (see
// tools/probe_hud.hml's own warning about exactly that). These two functions are
// pure, they take no state, and they are the entire behaviour worth asserting,
// so putting them on the HUD layer's own surface is what lets
// `tools/probe_feedback.hml` test the REAL implementation instead of a copy of
// it. That is also what this file's header says it is for.
// ===========================================================================

export let HUD_DMG_SEGS: i32 = 4;
export let HUD_DMG_FRONT: i32 = 0;
export let HUD_DMG_RIGHT: i32 = 1;
export let HUD_DMG_BACK: i32  = 2;
export let HUD_DMG_LEFT: i32  = 3;

// The view-relative bearing each segment stands for, in radians.
// 0 = straight ahead, +pi/2 = to your right. This matches the convention
// `client.hml` already stores (`atan2(sx - px, sz - pz)`) and the one
// `hud_build` already subtracts yaw in.
export fn hud_dmg_seg_bearing(p_seg: i32): f64 {
    let s: i32 = p_seg;
    let out: f64 = 0.0;
    if (s == HUD_DMG_RIGHT) { out = 1.5707963267948966; }
    if (s == HUD_DMG_BACK)  { out = 3.141592653589793; }
    if (s == HUD_DMG_LEFT)  { out = -1.5707963267948966; }
    return out;
}

// How brightly segment `p_seg` burns for a source at view-relative bearing
// `p_rel`. 0.0 = dark, 1.0 = full.
//
// THE CURVE IS cos^2 AND THE EXPONENT IS THE DESIGN, not a taste knob:
//
//     source exactly on a segment (0 deg off)   that segment 1.00, neighbours 0.00
//     source on a corner        (45 deg off)    the two neighbours 0.50 each
//     source 30 deg off a segment               that one 0.75, the neighbour 0.25
//     source on the OPPOSITE segment            0.00
//
// so a single attacker lights at most TWO segments, a corner reads as a corner
// rather than snapping to one side, and -- the property the arrow never had --
// FRONT and BACK are the two ends of the curve instead of the same point.
// Plain `cos` would leave 0.71 on both neighbours at a corner, which at 320x180
// reads as "everywhere"; squaring is what makes one of them dominant.
export fn hud_dmg_seg_weight(p_rel: f64, p_seg: i32): f64 {
    let d: f64 = p_rel - hud_dmg_seg_bearing(p_seg);
    // Wrap to [-pi, pi] in O(1). NOT a while-loop, and the reason is that the
    // draw site hands in `slot_bearing - yaw` where the yaw is whatever
    // `view.hml` has accumulated -- nothing between here and there normalises
    // it, so a player who has spun in one direction for a while would pay an
    // unbounded loop, ON THE FRAME PATH, once per segment per source.
    let k: f64 = floor((d + 3.141592653589793) * 0.15915494309189535);
    d = d - k * 6.283185307179586;
    let c: f64 = cos(d);
    if (c <= 0.0) { let dark: f64 = 0.0; return dark; }
    let out: f64 = c * c;
    return out;
}
