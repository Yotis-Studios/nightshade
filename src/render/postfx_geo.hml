// ===========================================================================
// nightshade/src/render/postfx_geo.hml — STAGE 23              (renderer-split)
// ===========================================================================
//
// ⚠ THE FILE IS `postfx_geo.hml`, NOT `postfx.hml`, AND THE NAME IS A RULE.
//   `postfx.hml` is one of the SEVEN FROZEN LEGACY WOBBLEWEED MODULES banned
//   everywhere under `nightshade/src/` (CLAUDE.md §3, ci_imports.sh R2:
//   geom / framebuffer / raster / sky / postfx / scene / scene_gpu).
//   ARCHITECTURE.md §5.6 names it `postfx_geo.hml` for exactly that reason.
//   Do not "tidy" it back to `postfx.hml`.
//
// ARCHITECTURE.md §5.6: "Vignette ring (static + damage summed into the same 16
// tris), composite MOD overlay (dither + grain + edge bleed, 3 pre-baked
// variants cycled per frame), sprint speed lines, lightning/level-up flashes."
// §5's export list is `postfx_build_overlay, postfx_emit, postfx_flash,
// postfx_set_vignette`.
//
// WHAT EXISTED IN `world_render.hml` TO EXTRACT is the vignette ring and the
// full-screen flash, and this file is exactly those two, unchanged in behaviour.
// `postfx_build_overlay` (the composite MOD dither/grain overlay) and the sprint
// speed lines HAVE NEVER BEEN WRITTEN by anybody — they are not stubbed here,
// because an exported empty function makes §5.6 look satisfied while the frame
// draws nothing. See the task report.
//
// ---------------------------------------------------------------------------
// STAGE 23 IS THE LAST THING IN LAYER_HUD BEFORE THE CALLER'S STAGE 24
// ---------------------------------------------------------------------------
// LAYER_HUD is flushed in INSERTION ORDER (CLAUDE.md §6), so the vignette sits
// UNDER the HUD, never over it. `world_render.hml` calls `postfx_emit` as the
// last thing in `frame_render()`; the caller then emits its own stage 24 into
// `frame_batch_hud()`; `frame_present()` flushes. That ordering is the whole
// reason the frame graph is two calls with a hole in the middle (§5.6b) and it
// is not this file's to change.
//
// Both overlays are flat quads on the HUD atlas's one solid texel, so they are
// drawn through `hud.hml`'s primitives rather than reaching for the texture and
// the uv rect themselves.
// ===========================================================================

import { g_RES_W, g_RES_H } from "../core/config.hml";
import { hud_solid_quad, hud_solid_ring } from "./hud.hml";

// The vignette ring and the lightning flash are geometry, but their colours are
// palette values, and `src/render/**` may not import `src/art/**` (§5.6b), so
// the caller sets them once at boot as rgb triples.
let g_vig_r: i32 = 0;   let g_vig_g: i32 = 0;   let g_vig_b: i32 = 0;
let g_flash_r: i32 = 255; let g_flash_g: i32 = 255; let g_flash_b: i32 = 255;

export fn postfx_set_vignette(p_r: i32, p_g: i32, p_b: i32) {
    g_vig_r = p_r; g_vig_g = p_g; g_vig_b = p_b;
}

export fn postfx_set_flash_colour(p_r: i32, p_g: i32, p_b: i32) {
    g_flash_r = p_r; g_flash_g = p_g; g_flash_b = p_b;
}

export fn postfx_vignette_r(): i32 { let out: i32 = g_vig_r; return out; }
export fn postfx_vignette_g(): i32 { let out: i32 = g_vig_g; return out; }
export fn postfx_vignette_b(): i32 { let out: i32 = g_vig_b; return out; }
export fn postfx_flash_r(): i32 { let out: i32 = g_flash_r; return out; }
export fn postfx_flash_g(): i32 { let out: i32 = g_flash_g; return out; }
export fn postfx_flash_b(): i32 { let out: i32 = g_flash_b; return out; }

// ===========================================================================
// STAGE 23 — the vignette ring + the lightning flash
// ---------------------------------------------------------------------------
// The ring's numbers are DESIGN ANCHORS and are pinned as literals here, not
// lifted into settable state: 8 segments (16 triangles, which is the §5.6
// budget), inner 128x96 = exactly the 320x240 half-extent so the clear centre is
// the whole frame, outer 260x210 so the corners are covered past the frame
// diagonal, alpha 0 inner -> 150 outer, depth 0.9. The flash is one full-screen
// quad at alpha 54, depth 0.95 — ABOVE the ring, so a lightning frame lifts the
// vignette too.
// Returns the triangle count it added to LAYER_HUD.
// ===========================================================================

export fn postfx_emit(p_b, p_lightning: i32): i32 {
    let tris: i32 = 0;
    tris = tris + hud_solid_ring(p_b, f64(g_RES_W) * 0.5, f64(g_RES_H) * 0.5,
                                 128.0, 96.0, 260.0, 210.0, 8,
                                 g_vig_r, g_vig_g, g_vig_b, 0, 150, 0.9);
    if (p_lightning != 0) {
        tris = tris + hud_solid_quad(p_b, 0.0, 0.0, f64(g_RES_W), f64(g_RES_H),
                                     g_flash_r, g_flash_g, g_flash_b, 54, 0.95);
    }
    let out: i32 = tris;
    return out;
}
