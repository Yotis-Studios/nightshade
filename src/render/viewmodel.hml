    let out: f64 = s[g_VMS_MAGZ]; return out;
}
// The two latches the audio layer drains: the floor clack (GAME_DESIGN 7.11)
// and the reload-complete beat.  Draining is how a cosmetic event survives a
// frame in which the sim ran zero times or five times.
export fn vm_take_clack(p_vm: object): i32 {
    let vm: object = p_vm; let s: array<f64> = vm.s;
    let out: i32 = 0;
    if (s[g_VMS_CLACK] > 0.0) { out = 1; s[g_VMS_CLACK] = 0.0; }
    return out;
}
export fn vm_take_reload_done(p_vm: object): i32 {
    let vm: object = p_vm; let s: array<f64> = vm.s;
    let out: i32 = 0;
    if (s[g_VMS_RELDONE] > 0.0) { out = 1; s[g_VMS_RELDONE] = 0.0; }
    return out;
}
export fn vm_stage_bits(p_vm: object): i32 {
    let vm: object = p_vm; let s: array<f64> = vm.s;
