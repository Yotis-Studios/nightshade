export fn vm_kicks(p_vm: object): i32 {
    let vm: object = p_vm; let s: array<f64> = vm.s;
    let out: i32 = i32(s[g_VMS_KICKS]); return out;
}
export fn vm_kick_peak_s(): f64 { let out: f64 = g_VM_KICK_TPEAK; return out; }
export fn vm_ppm(): f64 { let out: f64 = g_VM_PPM; return out; }
export fn vm_mesh_tris(p_vm: object): i32 {
    let vm: object = p_vm;
    if (vm.mesh == null) { let z: i32 = 0; return z; }
    let out: i32 = mesh_tri_count(vm.mesh);
    return out;
}
