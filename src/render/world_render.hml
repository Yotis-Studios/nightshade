// ---------------------------------------------------------------------------
// the per-stage modules of §5.6. Aliased on import wherever this file
// re-publishes the same public name, because Hemlock has NO transitive
// re-export (verified: `import { x } from "./mid.hml"` where mid.hml only
// imported x is a hard error, "'x' is not exported from module"). The alias +
// same-name wrapper below is the only way to keep the four consumers' import
// lists untouched, which is what makes byte-identity provable.
// ---------------------------------------------------------------------------
import { terrain_emit, terrain_emit_none,
