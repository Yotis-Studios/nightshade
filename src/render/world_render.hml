// ===========================================================================
// 0. FIXED SHAPE
// ===========================================================================

export let g_NEAR: f64 = 0.15;
export let g_GUARD: f64 = 640.0;        // guard-band margin in pixels
export let g_CAP_SKY: i32 = 256;
export let g_CAP_WORLD: i32 = 3500;     // the hard clamp of ARCHITECTURE §8
export let g_CAP_FX: i32 = 640;
// LAYER_HUD's batch capacity. NOT the 250-triangle HUD cap, and conflating the
// two is the defect behind Gate 4b/4c's "HUD peak 248 of 250, one more element
// overflows the layer". They are different numbers about different things:
//
//   g_HUD_TRI_CAP (config.hml)  250   a DESIGN budget on stage 24's CONTENT,
//                                     from ART_BIBLE §9. The game's `hud_build`
//                                     gates its own optional elements on it.
//   g_CAP_HUD     (here)        512   the LAYER's physical capacity — every
//                                     triangle in LAYER_HUD, whoever emitted it.
//
// MEASURED occupancy of the layer, 14 396-frame headless demo of the real game
// plus `tools/probe_budget.hml` section D:
//
//     stage 24, the game's HUD    248 peak   (this is the "248 of 250")
//     the viewmodel, stage 15     122 peak   (LAYER_HUD, and NOT in the 250)
//     stage 23, postfx_geo         18 peak   (16 vignette + 2 flash, ditto)
//     ------------------------------------
//     LAYER_HUD peak              388 of 512  -> 124 triangles spare, 24 %
//
// So the LAYER is not full and never was: `batch_overflow_total` is 0 over every
// frame of every run (benchframe asserts it). What is full is a 250 that two
// other emitters spend against without being counted — the true stage-23+24+15
// spend is 388, not 248. `frame_hud_tris()` below is the number that was
// missing; a HUD builder that wants to know whether one more element fits should
// ask `frame_hud_headroom()` rather than subtract from a literal that is blind to
// two thirds of its own layer.
export let g_CAP_HUD: i32 = 512;
export let g_D2R: f64 = 0.017453292519943295;

// world_fx_add draw kinds, and world_prop_add's fog-relative LOD sentinel.
// SINGLE SOURCE OF TRUTH: each is defined once, in the module that owns the
// concept, and re-published here under the name the four consumers already
// import. Writing the literal twice is how a constant becomes two constants.
export let g_FXK_SPRITE: i32 = fx_k_sprite;   // camera-facing card, size p_s
export let g_FXK_RAIN: i32 = fx_k_rain;       // vertical streak, 1.5 m
export let g_FXK_TRACER: i32 = fx_k_tracer;   // 2.6 m streak from the camera
export let g_LOD_FOG_CARD: f64 = e_lod_fog_card;

// ===========================================================================
// 1. BOUND RESOURCES — everything art-derived arrives here as a handle
// ===========================================================================

let g_win = null;
let g_target = null;
let g_fb = null;                        // ARGB8888 readback destination (ptr)

let g_tex_world = null;
let g_tex_fx = null;
let g_tex_sky = null;
let g_atlas_fx = null;                  // for atlas_cell_uv on the FX cells

let g_mesh_blob = null;                 // the mandatory contact blob (§9 r6)
let g_mesh_vm = null;                   // the viewmodel
let g_cell_glow: i32 = 0;               // the FX cell used for light pools

let g_env: array<f64> = env_new();
let g_frustum: array<f64> = frustum_new();
let g_mvp: array<f64> = [];
// The projection alone, without the view matrix. It is the MVP of VIEW SPACE,
// and it is what the viewmodel is drawn under -- see THE VIEWMODEL IS IN VIEW
// SPACE, below. Rebuilt beside g_mvp at stage 8.
let g_proj: array<f64> = [];

// ---------------------------------------------------------------------------
// THE VIEWMODEL IS IN VIEW SPACE -- and that is the whole fix for defect 6b.
// ---------------------------------------------------------------------------
// It used to be emitted with `mesh_emit_yaw`, which can express yaw and
// nothing else, so the model was given a pitch-aware WORLD POSITION and a
// pitch-blind ORIENTATION. Those two disagree the instant you look up or down:
// by pitch -45 the eye has swung above the lantern while the lantern stayed
// upright, so you see it from on top, its own top pan eclipses the flame, the
// model reads as a grey slab, and the frame loses its >220 anchor outright.
// Measured before the fix, hub_dawn at 00:30, largest contiguous >220 region
// inside the viewmodel window, HUD masked, native 320x240:
//
//     pitch  +45  +20    0   -15   -30   -45   -60   -80
//     anchor 160  192  156   127    98     0     0     0  px
//
// Adding a pitch term to the model would fix the symptom and leave the CLASS
// of bug alive -- the next person to add roll, or weapon sway, or a lowered
// pose gets to rediscover it. A first-person held object is not a thing in the
// world that happens to travel with you; it is a thing bolted to the camera.
// So draw it where it lives: in VIEW SPACE, with the view matrix left out of
// its MVP entirely.
//
// MVP_vm = proj . VM_MODEL, with no `view` term. The camera is at the origin
// looking down -Z (mat_look_dir's convention), so VM_MODEL is a CONSTANT: the
// same sixteen numbers on every frame, at every yaw, at every pitch, forever.
//
//     local +X  ->  view -X   (the model's +X is the camera's LEFT)
//     local +Y  ->  view +Y   (up is up)
//     local +Z  ->  view -Z   (the model's +Z is the camera's FORWARD)
//     origin    ->  (0.26, -0.34, -1.05)   0.26 right, 0.34 down, 1.05 fwd
//
// Those four lines are exactly what the old code produced AT PITCH 0: the
// basis map is what `mesh_emit_yaw(yaw = PI - camera_yaw)` reduces to once the
// view rotation is composed onto it, and the offset is the old
// `cam + fwd*1.05 + right*0.26 + up*(-0.34)` with fwd/right/up read at pitch
// 0. So this does not re-pose the lantern; it FREEZES the pose that was
// already correct, at every pitch. Verified, not asserted: at pitch 0 the
// frame is BYTE-IDENTICAL before and after (0 differing pixels of 76800), and
// at every other pitch the only pixels that change lie inside the viewmodel's
// own screen window.
//
// It also retires a latent trap in `meshgen.hml`: `mg_vm_shell` drops the
// faces the eye cannot see, derived from a constant model-space eye direction
// normalize(0.26, 0.34, -1.05). That derivation was only ever true at pitch 0.
// It is now true everywhere, which is why the lantern needed no geometry
// change to satisfy this task.
//
// The 3x3 block is diag(-1, 1, -1), determinant +1 -- the same handedness as
// the Ry() it replaces, so MESH_CULL_NEG culls exactly the faces it culled
// before and nothing turns inside out.
//
// COST: two `mesh_set_mvp` calls (16 array copies each) plus mesh_emit's
// 64-multiply concatenation instead of mesh_emit_yaw's 24 -- once per frame,
// for one instance. It replaces six trig calls and eighteen multiplies, and
// measures 0.129 -> 0.133 ms on the emit.viewmodel stage, min-of-7.
let g_VM_RIGHT: f64 = 0.26;     // metres right of the eye
let g_VM_DOWN: f64  = 0.34;     // metres below the eye
let g_VM_FWD: f64   = 1.05;     // metres in front of the eye
let g_vm_model: array<f64> = [
    -1.0, 0.0,  0.0, g_VM_RIGHT,
     0.0, 1.0,  0.0, 0.0 - g_VM_DOWN,
     0.0, 0.0, -1.0, 0.0 - g_VM_FWD,
     0.0, 0.0,  0.0, 1.0
];

let g_bsky = null;
let g_bworld = null;
let g_bfx = null;
let g_bhud = null;

// ---------------------------------------------------------------------------
// The four batches, in layer order. Owning these is this file's job by name
// (ARCHITECTURE §5.6). Idempotent: calling it twice does not leak a batch,
// because a batch is refcounted and the old one is dropped.
// ---------------------------------------------------------------------------
export fn frame_batches(): i32 {
    g_bsky = batch_new(g_CAP_SKY, 400.0, LAYER_SKY);
    g_bworld = batch_new(g_CAP_WORLD, 80.0, LAYER_WORLD);
    g_bfx = batch_new(g_CAP_FX, 80.0, LAYER_FX);
    g_bhud = batch_new(g_CAP_HUD, 4.0, LAYER_HUD);
    if (g_bsky == null || g_bworld == null || g_bfx == null || g_bhud == null) {
        let bad: i32 = -1;
        return bad;
    }
    let ok: i32 = 0;
    return ok;
}

// p_fb is the caller's ARGB8888 readback buffer, RES_W * RES_H * 4 bytes. It
// stays the caller's because the caller is the one that turns it into a PNG or
// blits it; the frame graph only fills it.
export fn frame_init(p_win, p_target, p_fb: ptr): i32 {
    g_win = p_win;
    g_target = p_target;
    g_fb = p_fb;
    if (g_win == null || g_target == null) {
        let bad: i32 = -1;
        return bad;
    }
    let rc: i32 = frame_batches();
    return rc;
}

// The HUD atlas goes to `hud.hml`, which owns LAYER_HUD's surface; this file
// never needed it for anything but the two postfx quads.
export fn frame_bind_textures(p_world, p_fx, p_hud, p_sky) {
    g_tex_world = p_world;
    g_tex_fx = p_fx;
    hud_bind_texture(p_hud);
    g_tex_sky = p_sky;
}

export fn frame_bind_fx_atlas(p_atlas) { g_atlas_fx = p_atlas; }

// p_blob is the 2-triangle contact blob every prop gets (CLAUDE.md §9 rule 6,
// no exceptions), p_vm the first-person weapon, p_glow_cell the additive FX
// cell a dynamic light pools onto the ground with.
export fn frame_bind_assets(p_blob, p_vm, p_glow_cell: i32) {
    g_mesh_blob = p_blob;
    g_mesh_vm = p_vm;
    g_cell_glow = p_glow_cell;
}

export fn frame_env(): array<f64> { let out: array<f64> = g_env; return out; }
export fn frame_mvp(): array<f64> { let out: array<f64> = g_mvp; return out; }
export fn frame_frustum(): array<f64> { let out: array<f64> = g_frustum; return out; }
export fn frame_batch_sky() { let out = g_bsky; return out; }
export fn frame_batch_world() { let out = g_bworld; return out; }
export fn frame_batch_fx() { let out = g_bfx; return out; }
export fn frame_batch_hud() { let out = g_bhud; return out; }

// ---------------------------------------------------------------------------
// LAYER_HUD's ACTUAL FILL — the number nothing in the project could read.
// ---------------------------------------------------------------------------
// See the long note on `g_CAP_HUD`. Read these AFTER stage 24 and BEFORE
// `frame_present()`; that is the only window in which the layer is complete,
// because `batch_flush` is what resets it.
//
//   frame_hud_tris()      every triangle in the layer: postfx + viewmodel +
//                         whatever stage 24 emitted.
//   frame_hud_headroom()  how many more will fit. THIS is what "does one more
//                         element fit?" should be asked against.
//   frame_hud_overflow()  triangles `batch_reserve` refused, this frame. It is
//                         never non-zero silently — a refusal drops a triangle
//                         and counts it, it never corrupts (CLAUDE.md §6).
//
// Zero cost: three field reads, no allocation, and nothing on a per-element
// path calls them.
export fn frame_hud_tris(): i32 { let out: i32 = batch_count(g_bhud); return out; }
export fn frame_hud_cap(): i32 { let out: i32 = g_CAP_HUD; return out; }
export fn frame_hud_headroom(): i32 {
    let n: i32 = g_CAP_HUD - batch_count(g_bhud);
    if (n < 0) { n = 0; }
    let out: i32 = n;
    return out;
}
export fn frame_hud_overflow(): i32 { let out: i32 = batch_overflow_count(g_bhud); return out; }

// ===========================================================================
// 2. PER-FRAME INPUT — camera, clear colour, options
// ===========================================================================

let g_camx: f64 = 0.0;
let g_camy: f64 = 0.0;
let g_camz: f64 = 0.0;
let g_yaw: f64 = 0.0;
let g_pitch: f64 = 0.0;
let g_fov: f64 = 70.0;

let g_clear_r: i32 = 0; let g_clear_g: i32 = 0; let g_clear_b: i32 = 0;
let g_sheet_r: i32 = 0; let g_sheet_g: i32 = 0; let g_sheet_b: i32 = 0;

let g_opt_sheet: i32 = 0;       // 2D contact-sheet frame: no world, no postfx
let g_opt_viewmodel: i32 = 0;
let g_opt_lightning: i32 = 0;

export fn frame_set_camera(p_x: f64, p_y: f64, p_z: f64,
                           p_yaw: f64, p_pitch: f64, p_fov: f64) {
    g_camx = p_x; g_camy = p_y; g_camz = p_z;
    g_yaw = p_yaw; g_pitch = p_pitch; g_fov = p_fov;
}

// The clear is the SKY ZENITH, so a dropped sky frame is never black (§4.19).
// Taken as f64 because that is what a sky keyframe is; clamped exactly as the
// Wave-2 code clamped it.
export fn frame_set_clear(p_r: f64, p_g: f64, p_b: f64) {
    g_clear_r = clampi(i32(p_r), 0, 255);
    g_clear_g = clampi(i32(p_g), 0, 255);
    g_clear_b = clampi(i32(p_b), 0, 255);
}

export fn frame_set_sheet_clear(p_r: i32, p_g: i32, p_b: i32) {
    g_sheet_r = p_r; g_sheet_g = p_g; g_sheet_b = p_b;
}

export fn frame_set_options(p_sheet: i32, p_viewmodel: i32, p_lightning: i32) {
    g_opt_sheet = p_sheet;
    g_opt_viewmodel = p_viewmodel;
    g_opt_lightning = p_lightning;
}

export fn frame_camera_x(): f64 { let out: f64 = g_camx; return out; }
export fn frame_camera_y(): f64 { let out: f64 = g_camy; return out; }
export fn frame_camera_z(): f64 { let out: f64 = g_camz; return out; }

// ===========================================================================
// 2b. THE DYNAMIC LIGHT MANAGER — the cap, the slot policy, and the lantern
// ---------------------------------------------------------------------------
// WHY IT IS HERE. `env_add_light` is the engine's append: it takes a light and
// refuses past ENV_MAX_LIGHTS and that is ALL it may do, because wobbleweed
// must not learn a game word (R1). "Four", "the lantern always wins", "nearest
// by distance^2/intensity" are game rules, so they live on this side of the
// wall — and this file is the one on this side that already owns the camera,
// which is exactly what a light manager needs and what nothing else has.
//
// THE PROBLEM IT WAS BUILT FOR, in the art critic's words:
//     "A night muzzle flash that leaves the world unlit is the loudest
//      'this is not a real game' signal in the set."
// The player carries a lantern — it IS the viewmodel, drawn lit, in every
// scene with F_VIEWMODEL — and before this section it illuminated nothing at
// all.  `tools/shot.hml` never put a light at the camera; the only dynamic
// lights in the whole harness were a muzzle flash and a shrine.
//
// ---------------------------------------------------------------------------
// HOW A LIGHT REACHES A PIXEL IN THIS RENDERER — read this before tuning
// ---------------------------------------------------------------------------
// Stage 8 calls `emit_set_lighting(0)`: every world triangle carries BAKED
// vertex colour (`mesh_bake_light`, G16/G19) and the emit kernel applies fog
// and nothing else.  So a dynamic light does NOT reach the world through
// `emit.hml`.  It reaches the frame by exactly two routes, both of which are
// driven off `env_light_count` and both of which are already built:
//
//   1. `fx.hml` stage 16 lays ONE 2-triangle additive ground glow card per
//      light inside 14 m, its four corners on the terrain — THE POOL.
//   2. `entity_render.hml` stage 14 adds a per-INSTANCE point term to every
//      prop's tint — props, NPCs and their contact blobs brighten near a light.
//
// Both are O(props + lights), never O(vertices x lights).  That is why raising
// the cap to 4 costs 0.062 ms and not 4.9 ms — see the long note in
// `src/core/config.hml` at `g_MAX_DYNAMIC_LIGHTS`.
//
// >>> WHAT THIS SECTION CANNOT DO, STATED PLAINLY.
// It cannot throw TERRAIN into relief and it cannot catch WALL faces, because
// both are baked chunk meshes on the `emit_set_lighting(0)` path and neither
// `terrain_render.hml` nor `emit.hml` is this task's file to change.  Turning
// lighting on for them is not a fix: `emit_mesh_buf` re-shades from ONE normal
// per chunk (terrain passes (0,1,0)), which is CLAUDE.md §9 rule 4 "flat-lit
// terrain", and it re-multiplies an already-baked colour by a full light term,
// which double-darkens every vertex.  The real fix is an engine change — a
// point-light term added to emit.hml's BAKED branch, after fog, reading the
// four hoisted `g_env_l*` slots `env_bind` already fills.  Reported upward.
//
// ---------------------------------------------------------------------------
// THE FRAME PROTOCOL
// ---------------------------------------------------------------------------
//   * A caller that already writes lights with `env_clear_lights` +
//     `env_add_light` KEEPS WORKING UNCHANGED.  `lights_commit` ADOPTS whatever
//     is in the env as candidates before it re-ranks, so `main.hml`'s lantern
//     post and `shot.hml`'s muzzle flash and shrine all still land — they are
//     now ranked against each other instead of racing for slot order.
//   * `frame_light_add()` is the new, explicit submission path for transients.
//   * `lights_commit()` runs at the TOP of `frame_render`, after
//     `frame_set_camera` and before any stage reads the env.  It clears the
//     submission list on the way out, so submissions made between frames are
//     never double-counted.
// ===========================================================================

// Candidate capacity. Twelve is three times the cap: enough that a firefight
// can submit everything it wants and let the ranker decide, small enough that
// the O(cap x n) selection scan below is ~36 iterations of pure f64 arithmetic.
let g_LM_CAP: i32 = 12;

// Struct-of-arrays (A7), allocated once and reused (A8/N6/N7): the reset sets
// a counter, it never reallocates and never pushes after the first frame.
let g_lm_x: array<f64> = [];
let g_lm_y: array<f64> = [];
let g_lm_z: array<f64> = [];
let g_lm_r: array<f64> = [];
let g_lm_g: array<f64> = [];
let g_lm_b: array<f64> = [];
let g_lm_rad: array<f64> = [];
let g_lm_int: array<f64> = [];      // intensity, the numerator of the ranking
let g_lm_taken: array<f64> = [];    // 1.0 once a candidate has won a slot
let g_lm_n: i32 = 0;

// ---------------------------------------------------------------------------
// >>> THE ECHO, and why adoption needs two more arrays.
// ---------------------------------------------------------------------------
// `lights_commit` adopts the env's lights as candidates so a caller that still
// writes `env_clear_lights` + `env_add_light` keeps working. But the commit
// also WRITES the winners back into that same env — so on the next frame it
// re-adopts its own output. Measured before this was fixed, `--scene
// muzzle_fog`, one flash posted at stage 6 and never moved:
//
//     frame 1   env=[flash]                        -> writes [lantern, flash]
//     frame 2   adopts lantern+flash               -> writes [lantern, L', flash]
//     frame 3   adopts lantern+L'+flash            -> writes 4, cap reached
//     steady    submitted=4  lights=4  contested=1
//
// Three of the four slots were STALE COPIES OF THE LANTERN. The cap was full
// of one light, so the two slots the slot policy reserves for explosions and
// fire did not exist, and a moving player would have dragged a comet tail of
// last-frame lanterns behind them.
//
// The fix is not "don't adopt" — main.hml, shot.hml and walk.hml all post
// through the env and none of them is this task's file. It is to notice when
// the env still holds OUR OWN OUTPUT untouched, and in that case re-adopt the
// caller's candidates FROM LAST FRAME instead of from the env:
//
//   * `g_lm_shadow`  the exact light block we wrote last commit
//   * `g_lm_saved`   the caller candidates we adopted last commit
//
// If the env matches the shadow bit for bit, nobody wrote lights this frame and
// `g_lm_saved` is the caller's true intent. If it differs by so much as a
// radius, the caller rewrote the block and the env is authoritative again.
// Seven f64 per slot, four slots: 28 compares, once a frame.
//
// This is the case that makes index-matching wrong, and it is why the compare
// is on the WHOLE block: with the lantern gated off in daylight the commit
// writes the caller's own flash back into slot 0, so "env slot i equals shadow
// slot i" would make a re-posted flash look like an echo and delete it.
let g_LM_FIELDS: i32 = 7;
let g_lm_shadow: array<f64> = [];
let g_lm_shadow_n: i32 = -1;        // -1 = nothing written yet
let g_lm_saved: array<f64> = [];
let g_lm_saved_n: i32 = 0;
let g_lm_echoed: i32 = 0;           // 1 if this frame re-used g_lm_saved

// Counters, published through frame_light_stats.
let g_lm_submitted: i32 = 0;
let g_lm_accepted: i32 = 0;
let g_lm_dropped: i32 = 0;          // refused for want of a candidate slot
let g_lm_contested: i32 = 0;        // candidates that lost the ranking

export let g_LMSTAT_SUBMITTED: i32 = 0;
export let g_LMSTAT_ACCEPTED: i32 = 1;
export let g_LMSTAT_DROPPED: i32 = 2;
export let g_LMSTAT_CONTESTED: i32 = 3;
export let g_LMSTAT_ECHOED: i32 = 4;    // 1 if the env held only our own output

export fn frame_light_stats(p_field: i32): i32 {
    let fld: i32 = p_field;
    if (fld == g_LMSTAT_SUBMITTED) { let a: i32 = g_lm_submitted; return a; }
    if (fld == g_LMSTAT_ACCEPTED) { let b: i32 = g_lm_accepted; return b; }
    if (fld == g_LMSTAT_DROPPED) { let c: i32 = g_lm_dropped; return c; }
    if (fld == g_LMSTAT_CONTESTED) { let e: i32 = g_lm_contested; return e; }
    if (fld == g_LMSTAT_ECHOED) { let ech: i32 = g_lm_echoed; return ech; }
    let z: i32 = 0;
    return z;
}

// ---------------------------------------------------------------------------
// THE LANTERN
// ---------------------------------------------------------------------------
//   mode 0  off — no lantern light at all
//   mode 1  auto (DEFAULT) — full strength at night, off in daylight, scaled by
//           the fog-tint gate below.  Default-on is deliberate: the lantern is
//           in the player's hand in every F_VIEWMODEL frame already, and a held
//           lantern that lights nothing is the defect this section exists to
//           remove.  Every existing consumer therefore gets it with no wiring.
//   mode 2  forced — full strength regardless of the hour (cutscenes, caves,
//           the interior of anything).
let g_lant_mode: i32 = 1;
let g_lant_r: f64 = g_LANTERN_LIGHT_R;
let g_lant_g: f64 = g_LANTERN_LIGHT_G;
let g_lant_b: f64 = g_LANTERN_LIGHT_B;
let g_lant_rad: f64 = g_LANTERN_RADIUS;
let g_lant_gain: f64 = g_LANTERN_GAIN;
let g_lant_scale: f64 = 0.0;        // the gate's result for the last frame

export fn frame_set_lantern(p_mode: i32) {
    let m: i32 = p_mode;
    if (m < 0) { m = 0; }
    if (m > 2) { m = 2; }
    g_lant_mode = m;
}

// The authoritative art value lives in `src/art/tod.hml` (`tod_lantern_rgb`),
// which this file may not import.  A caller that wants the time-of-day-varying
// flame colour hands it over here at stage 6; everyone else gets the config
// default, which is the same warm the art module starts from.
export fn frame_set_lantern_rgb(p_r: f64, p_g: f64, p_b: f64) {
    g_lant_r = p_r;
    g_lant_g = p_g;
    g_lant_b = p_b;
}

export fn frame_set_lantern_shape(p_radius: f64, p_gain: f64) {
    if (p_radius > 0.0) { g_lant_rad = p_radius; }
    if (p_gain >= 0.0) { g_lant_gain = p_gain; }
}

export fn frame_lantern_mode(): i32 { let out: i32 = g_lant_mode; return out; }
export fn frame_lantern_scale(): f64 { let out: f64 = g_lant_scale; return out; }

// How dark is the world right now, in [0,1], 1 = fully dark?
//
// Off the FOG TINT, not off ambient+sun.  `tod_eval` normalises ambient+sun to
// (1,1,1) by contract, so ground luminance moves only 0.93 -> 0.56 across a
// whole day and golden hour is indistinguishable from midnight.  The fog tint
// is derived from the horizon band (ART_BIBLE §6.6) and does separate them:
// 0.855 at noon, 0.783 at golden hour, 0.480 at 22:00, 0.409 at 02:00.
// Measured with tod_eval over a full day at WX_CLEAR; the two thresholds are
// `g_LANTERN_GATE_*` in core/config.hml, with that table beside them.
fn lantern_gate(): f64 {
    if (g_lant_mode == 0) { let off: f64 = 0.0; return off; }
    if (g_lant_mode == 2) { let on: f64 = 1.0; return on; }
    let env: array<f64> = g_env;
    let lum: f64 = 0.299 * env_field(env, ENV_FOG_R)
                 + 0.587 * env_field(env, ENV_FOG_G)
                 + 0.114 * env_field(env, ENV_FOG_B);
    let span: f64 = g_LANTERN_GATE_DAY - g_LANTERN_GATE_NIGHT;
    if (span <= 0.0) { let one: f64 = 1.0; return one; }
    let u: f64 = (g_LANTERN_GATE_DAY - lum) / span;
    if (u <= 0.0) { let z: f64 = 0.0; return z; }
    if (u >= 1.0) { let o2: f64 = 1.0; return o2; }
    // Smoothstep, so dusk brings the lantern up over minutes rather than
    // popping it on at one frame boundary.
    let out: f64 = u * u * (3.0 - 2.0 * u);
    return out;
}

// Clear the submission list. `lights_commit` calls this on its way out, so a
// caller only needs it if it wants to abandon submissions mid-frame.
// First-frame growth only; after this the arrays are never resized (A8/N6).
// Called from BOTH ends of the frame: `frame_light_add` may be the very first
// thing that touches the manager, and it indexes rather than pushes.
fn lm_ensure() {
    while (g_lm_x.length < g_LM_CAP) {
        g_lm_x.push(0.0); g_lm_y.push(0.0); g_lm_z.push(0.0);
        g_lm_r.push(0.0); g_lm_g.push(0.0); g_lm_b.push(0.0);
        g_lm_rad.push(0.0); g_lm_int.push(0.0); g_lm_taken.push(0.0);
    }
    let need: i32 = ENV_MAX_LIGHTS * g_LM_FIELDS;
    while (g_lm_shadow.length < need) { g_lm_shadow.push(0.0); g_lm_saved.push(0.0); }
}

export fn frame_lights_reset() {
    lm_ensure();
    g_lm_n = 0;
}

// Submit a dynamic light for THIS frame. Returns the candidate index, or -1 if
// the radius is not positive (a light with no radius lights nothing) or the
// candidate list is full. Submitting is not winning: `lights_commit` ranks.
//
// Colour is a linear multiplier, exactly as `env_add_light` takes it — values
// above 1 are normal and expected for a light (main.hml's lantern post uses
// palette/255 * 2.4). Ranking intensity is the strongest channel.
export fn frame_light_add(p_x: f64, p_y: f64, p_z: f64,
                          p_r: f64, p_g: f64, p_b: f64, p_radius: f64): i32 {
    let rad: f64 = p_radius;
    if (rad <= 0.0) { let bad: i32 = -1; return bad; }
    if (g_lm_x.length < g_LM_CAP) { lm_ensure(); }
    g_lm_submitted++;
    if (g_lm_n >= g_LM_CAP) {
        g_lm_dropped++;
        let full: i32 = -1;
        return full;
    }
    let i: i32 = g_lm_n;
    let cr: f64 = p_r;  let cg: f64 = p_g;  let cb: f64 = p_b;
    // max(r, g, b), hand-inlined (A9)
    let inten: f64 = cr;
    if (cg > inten) { inten = cg; }
    if (cb > inten) { inten = cb; }
    if (inten < 0.0001) { inten = 0.0001; }     // never divide by zero below
    g_lm_x[i] = p_x;   g_lm_y[i] = p_y;   g_lm_z[i] = p_z;
    g_lm_r[i] = cr;    g_lm_g[i] = cg;    g_lm_b[i] = cb;
    g_lm_rad[i] = rad;
    g_lm_int[i] = inten;
    g_lm_taken[i] = 0.0;
    g_lm_n = i + 1;
    let out: i32 = i;
    return out;
}

// ---------------------------------------------------------------------------
// COMMIT — the whole slot policy, once per frame, from the top of frame_render
// ---------------------------------------------------------------------------
// 1. adopt the env's existing lights as candidates (backward compatibility)
// 2. place the lantern at the eye + camera-space offset — RESERVED slot 0
// 3. fill the remaining slots nearest-first by distance^2 / intensity
// 4. write the winners back through env_add_light, in slot order
//
// Cost: the ranking is at most (cap-1) scans of n <= 12 candidates, so <= 36
// iterations of six f64 reads and a divide. Measured inside the frame at
// 0.004 ms; it does not have its own stage timer because it does not deserve
// one.
fn lights_commit() {
    let env: array<f64> = g_env;

    // --- the cap. The GAME's number, clamped to the engine's array bound. ---
    let cap: i32 = g_MAX_DYNAMIC_LIGHTS;
    if (cap > ENV_MAX_LIGHTS) { cap = ENV_MAX_LIGHTS; }
    if (cap < 0) { cap = 0; }

    // --- 1. adopt whatever the caller put in the env, NOT our own echo ------
    // See THE ECHO above `g_lm_shadow`. If the env still holds the exact block
    // this function wrote last frame, no caller has touched it, so the honest
    // candidate set is the one we adopted last frame — not our own winners.
    lm_ensure();
    let n0: i32 = env_light_count(env);
    if (n0 > ENV_MAX_LIGHTS) { n0 = ENV_MAX_LIGHTS; }
    let echo: i32 = 0;
    if (n0 == g_lm_shadow_n) {
        echo = 1;
        for (let i = 0; i < n0; i++) {
            let base: i32 = ENV_LIGHT0_X + i * ENV_LIGHT_STRIDE;
            let o: i32 = i * g_LM_FIELDS;
            if (env_field(env, base + ENV_L_X) != g_lm_shadow[o]) { echo = 0; }
            if (env_field(env, base + ENV_L_Y) != g_lm_shadow[o + 1]) { echo = 0; }
            if (env_field(env, base + ENV_L_Z) != g_lm_shadow[o + 2]) { echo = 0; }
            if (env_field(env, base + ENV_L_R) != g_lm_shadow[o + 3]) { echo = 0; }
            if (env_field(env, base + ENV_L_G) != g_lm_shadow[o + 4]) { echo = 0; }
            if (env_field(env, base + ENV_L_B) != g_lm_shadow[o + 5]) { echo = 0; }
            if (env_field(env, base + ENV_L_RADIUS) != g_lm_shadow[o + 6]) { echo = 0; }
        }
    }
    g_lm_echoed = echo;
    if (echo == 1) {
        for (let i = 0; i < g_lm_saved_n; i++) {
            let o2: i32 = i * g_LM_FIELDS;
            frame_light_add(g_lm_saved[o2], g_lm_saved[o2 + 1], g_lm_saved[o2 + 2],
                            g_lm_saved[o2 + 3], g_lm_saved[o2 + 4], g_lm_saved[o2 + 5],
                            g_lm_saved[o2 + 6]);
        }
    } else {
        g_lm_saved_n = n0;
        for (let i = 0; i < n0; i++) {
            let base: i32 = ENV_LIGHT0_X + i * ENV_LIGHT_STRIDE;
            let o3: i32 = i * g_LM_FIELDS;
            g_lm_saved[o3] = env_field(env, base + ENV_L_X);
            g_lm_saved[o3 + 1] = env_field(env, base + ENV_L_Y);
            g_lm_saved[o3 + 2] = env_field(env, base + ENV_L_Z);
            g_lm_saved[o3 + 3] = env_field(env, base + ENV_L_R);
            g_lm_saved[o3 + 4] = env_field(env, base + ENV_L_G);
            g_lm_saved[o3 + 5] = env_field(env, base + ENV_L_B);
            g_lm_saved[o3 + 6] = env_field(env, base + ENV_L_RADIUS);
            frame_light_add(g_lm_saved[o3], g_lm_saved[o3 + 1], g_lm_saved[o3 + 2],
                            g_lm_saved[o3 + 3], g_lm_saved[o3 + 4], g_lm_saved[o3 + 5],
                            g_lm_saved[o3 + 6]);
        }
    }

    // --- 2. the lantern, at the eye + a camera-space offset -----------------
    // fwd = (sin yaw, -cos yaw), right = (cos yaw, sin yaw): the convention
    // mat_look_dir and every scene builder in the project already use.
    let scale: f64 = lantern_gate();
    g_lant_scale = scale;
    let lant: i32 = 0;
    let lx: f64 = 0.0;  let ly: f64 = 0.0;  let lz: f64 = 0.0;
    let lr: f64 = 0.0;  let lg: f64 = 0.0;  let lb: f64 = 0.0;
    if (scale > 0.0 && g_lant_gain > 0.0 && g_lant_rad > 0.0 && cap > 0) {
        let yr: f64 = g_yaw * g_D2R;
        let fwx: f64 = sin(yr);
        let fwz: f64 = 0.0 - cos(yr);
        let rgx: f64 = cos(yr);
        let rgz: f64 = sin(yr);
        lx = g_camx + fwx * g_LANTERN_OFS_FWD + rgx * g_LANTERN_OFS_RIGHT;
        ly = g_camy - g_LANTERN_OFS_DOWN;
        lz = g_camz + fwz * g_LANTERN_OFS_FWD + rgz * g_LANTERN_OFS_RIGHT;
        let amp: f64 = g_lant_gain * scale;
        lr = g_lant_r * amp;
        lg = g_lant_g * amp;
        lb = g_lant_b * amp;
        lant = 1;
    }

    // --- 3 + 4. write the winners -------------------------------------------
    env_clear_lights(env);
    let used: i32 = 0;
    if (lant == 1) {
        env_add_light(env, lx, ly, lz, lr, lg, lb, g_lant_rad);
        used = 1;
    }

    let n: i32 = g_lm_n;
    let camx: f64 = g_camx;
    let camy: f64 = g_camy;
    let camz: f64 = g_camz;
    for (let s = used; s < cap; s++) {
        let best: i32 = -1;
        let bestscore: f64 = 1.0e300;
        for (let k = 0; k < n; k++) {
            if (g_lm_taken[k] > 0.5) { continue; }
            let dx: f64 = g_lm_x[k] - camx;
            let dy: f64 = g_lm_y[k] - camy;
            let dz: f64 = g_lm_z[k] - camz;
            // distance^2 / intensity: near and bright beats far and dim, and a
            // light you are standing inside always beats one across the field.
            let score: f64 = (dx * dx + dy * dy + dz * dz) / g_lm_int[k];
            if (score < bestscore) { bestscore = score; best = k; }
        }
        if (best < 0) { break; }
        g_lm_taken[best] = 1.0;
        env_add_light(env, g_lm_x[best], g_lm_y[best], g_lm_z[best],
                      g_lm_r[best], g_lm_g[best], g_lm_b[best], g_lm_rad[best]);
        used = s + 1;
    }

    // Everything still untaken lost the ranking. Counted, never silent — a
    // settlement that starts dropping lights should be visible in the stats
    // before it is visible in the picture.
    let lost: i32 = 0;
    for (let k2 = 0; k2 < n; k2++) {
        if (g_lm_taken[k2] < 0.5) { lost++; }
    }
    g_lm_contested = lost;
    g_lm_accepted = env_light_count(env);

    // Remember EXACTLY what we wrote, so next frame can tell our own echo from
    // a caller's fresh post. Four slots x seven fields, unconditionally.
    g_lm_shadow_n = g_lm_accepted;
    for (let s2 = 0; s2 < g_lm_shadow_n; s2++) {
        let sb: i32 = ENV_LIGHT0_X + s2 * ENV_LIGHT_STRIDE;
        let so: i32 = s2 * g_LM_FIELDS;
        g_lm_shadow[so] = env_field(env, sb + ENV_L_X);
        g_lm_shadow[so + 1] = env_field(env, sb + ENV_L_Y);
        g_lm_shadow[so + 2] = env_field(env, sb + ENV_L_Z);
        g_lm_shadow[so + 3] = env_field(env, sb + ENV_L_R);
        g_lm_shadow[so + 4] = env_field(env, sb + ENV_L_G);
        g_lm_shadow[so + 5] = env_field(env, sb + ENV_L_B);
        g_lm_shadow[so + 6] = env_field(env, sb + ENV_L_RADIUS);
    }

    // Republish STAT_LIGHTS. Every consumer sets it during its own stage 6,
    // which is BEFORE the commit, so without this line every stats report in
    // the project would print the pre-ranking count.
    stat_set(STAT_LIGHTS, g_lm_accepted);
    frame_lights_reset();
}

// ---------------------------------------------------------------------------
// STAGE 16b — THE LANTERN'S GROUND POOL
// ---------------------------------------------------------------------------
// `fx.hml` already lays one additive ground card per dynamic light and it is
// the right idea in the right place. It has never drawn one for a light near
// the camera, and the reason is geometric, not numeric: the card is a SINGLE
// QUAD centred ON THE LIGHT, so a lantern in the player's hand puts two of its
// four corners behind the near plane and `emit_quad_world` rejects the whole
// thing as a straddle. Measured, `--scene muzzle_fog`, adding the lantern:
//
//     tris.drawn      1082 -> 1082      (the card contributed NOTHING)
//     clip.straddle    123 ->  125      (+2: the card, rejected)
//
// A grid fixes it exactly: the cells behind the near plane are rejected one by
// one and the cells in front of it survive. Same glow cell, same additive
// blend, same `light_rgb * 96` — the UVs are just interpolated across the
// footprint instead of pinned to four corners.
//
// >>> THIS BELONGS IN `src/render/fx.hml`, which owns stage 16 and the glow
// >>> card (§5.6). It is here because fx.hml is not this task's file to change
// >>> (CLAUDE.md §3) and the pool is the whole point of the task. When fx.hml
// >>> is next opened, move this in and delete the single-quad card: nothing
// >>> else in the project draws a ground pool, so there is no third copy.
//
// Reserved: DIV*DIV*2 triangles. Drawn: whatever survives the near plane and
// the frustum, typically a third of that, because most of a pool centred on
// the player is behind the player.
let g_lp_h: array<f64> = [];        // (HDIV+1)^2 terrain heights, sampled lazily
let g_lp_ok: array<f64> = [];       // 1.0 once the matching height is computed
let g_lp_uv: array<f64> = [0.0, 0.0, 0.0, 0.0];
let g_lp_dep: array<f64> = [0.0, 0.0];
let g_lp_tris: i32 = 0;
let g_lp_calls: i32 = 0;            // terrain_h calls this frame, for the probe

// The coarse height grid's own frame state, set by `lantern_pool_emit` before
// it walks the cells. Module-level rather than parameters because `pool_hy` is
// called four times per drawn cell and Hemlock charges ~10 ns per argument
// (CLAUDE.md A9b) — seven of these as arguments would cost more than the
// bilinear it exists to do.
let g_lp_x0: f64 = 0.0;
let g_lp_z0: f64 = 0.0;
let g_lp_hstep: f64 = 1.0;
let g_lp_hside: i32 = 1;
let g_lp_rep: i32 = 1;

export fn frame_pool_tris(): i32 { let out: i32 = g_lp_tris; return out; }
export fn frame_pool_terrain_calls(): i32 { let out: i32 = g_lp_calls; return out; }

// One coarse sample, computed once per frame per grid point.
fn pool_coarse(p_ci: i32, p_cj: i32): f64 {
    let idx: i32 = p_cj * g_lp_hside + p_ci;
    if (g_lp_ok[idx] > 0.5) { let hit: f64 = g_lp_h[idx]; return hit; }
    let hv: f64 = t_terrain_h(g_lp_x0 + f64(p_ci) * g_lp_hstep,
                              g_lp_z0 + f64(p_cj) * g_lp_hstep)
                + g_LANTERN_POOL_LIFT;
    g_lp_h[idx] = hv;
    g_lp_ok[idx] = 1.0;
    g_lp_calls++;
    let out: f64 = hv;
    return out;
}

// The height of colour-grid vertex (gi, gj), bilinear over the coarse grid.
fn pool_hy(p_gi: i32, p_gj: i32): f64 {
    let rep: i32 = g_lp_rep;
    let gi: i32 = p_gi;   let gj: i32 = p_gj;
    // `divi`, not `/`: Hemlock's `/` ALWAYS yields f64 (CLAUDE.md §4, "API
    // corrections"), and an f64 quotient assigned into an `i32` local is one
    // of the two ways this function used to walk off the end of the grid.
    //
    // The other is the FAR EDGE. The bilinear below always reads (ci+1, cj+1),
    // so a colour vertex sitting exactly on the last coarse line indexes one
    // row past the array. Clamping to the last CELL and setting the fraction
    // to 1.0 evaluates to the same height and stays in bounds. Without it,
    // POOL_DIV=8 died with "Array index 26 out of bounds (length 25)" and
    // POOL_DIV=12 survived only because the cells that would have tripped it
    // are the four corners of the bounding square, which the disc test always
    // rejects. A latent out-of-bounds that one constant edit away from firing
    // is not a bug that gets to stay.
    let last: i32 = g_lp_hside - 1;
    let ci: i32 = divi(gi, rep);   let mi: i32 = gi - ci * rep;
    if (ci >= last) { ci = last - 1; mi = rep; }
    let cj: i32 = divi(gj, rep);   let mj: i32 = gj - cj * rep;
    if (cj >= last) { cj = last - 1; mj = rep; }
    if (mi == 0 && mj == 0) { let exact: f64 = pool_coarse(ci, cj); return exact; }
    let inv: f64 = 1.0 / f64(rep);
    let fi: f64 = f64(mi) * inv;
    let fj: f64 = f64(mj) * inv;
    let h00: f64 = pool_coarse(ci, cj);
    let h10: f64 = pool_coarse(ci + 1, cj);
    let h01: f64 = pool_coarse(ci, cj + 1);
    let h11: f64 = pool_coarse(ci + 1, cj + 1);
    let a: f64 = h00 + (h10 - h00) * fi;
    let b: f64 = h01 + (h11 - h01) * fi;
    let out: f64 = a + (b - a) * fj;
    return out;
}

// Emits into the FX batch. Returns the triangles actually drawn.
// Called from stage 16, after `fx_emit`, so the pool sorts against the
// particles rather than being unconditionally under or over them.
fn lantern_pool_emit(): i32 {
    g_lp_tris = 0;
    if (g_lant_scale <= 0.0) { let z: i32 = 0; return z; }
    if (g_atlas_fx == null) { let z2: i32 = 0; return z2; }
    let div: i32 = g_LANTERN_POOL_DIV;
    if (div < 1) { let z3: i32 = 0; return z3; }
    if (div > 16) { div = 16; }

    // --- the footprint, centred on the lantern (which is at the eye) --------
    let amp: f64 = g_lant_gain * g_lant_scale;
    let span: f64 = g_lant_rad * g_LANTERN_POOL_SPAN;
    let yr: f64 = g_yaw * g_D2R;
    let fwx: f64 = sin(yr);
    let fwz: f64 = 0.0 - cos(yr);
    let rgx: f64 = cos(yr);
    let rgz: f64 = sin(yr);
    let ox: f64 = g_camx + fwx * g_LANTERN_OFS_FWD + rgx * g_LANTERN_OFS_RIGHT;
    let oz: f64 = g_camz + fwz * g_LANTERN_OFS_FWD + rgz * g_LANTERN_OFS_RIGHT;
    let x0: f64 = ox - span;
    let z0: f64 = oz - span;
    let step: f64 = (span * 2.0) / f64(div);

    // --- colour ------------------------------------------------------------
    // >>> `p_rgb` IS `r | g<<8 | b<<16`. emit.hml's `emit_tri_world` reads it
    // >>> that way (`br = rgb & 255`), and `src/render/fx.hml` packs its ground
    // >>> card the OTHER way round, `(r<<16) | (g<<8) | b`. That is a real bug
    // >>> in fx.hml — a warm lantern comes out cyan — and it has been invisible
    // >>> for exactly the reason above: the card it packs has never once been
    // >>> drawn. Reported, not fixed (fx.hml is not this task's file).
    // >>> Copying fx.hml's line is how this pool first rendered ice blue.
    let peak: f64 = amp * g_LANTERN_POOL_SCALE;
    let cr: f64 = g_lant_r * peak;
    let cg: f64 = g_lant_g * peak;
    let cb: f64 = g_lant_b * peak;
    if (cr < 1.0 && cg < 1.0 && cb < 1.0) { let z4: i32 = 0; return z4; }

    // --- the height grid: COARSE, and sampled LAZILY ------------------------
    // Both halves of that are measurements, not taste. `terrain_h` costs
    // 3.234 us a call (see core/config.hml at POOL_HDIV), so:
    //
    //   eager, one sample per colour vertex, 169 calls .... emit.fx  0.90 ms
    //   lazy,  one sample per colour vertex, ~120 calls ... emit.fx  0.73 ms
    //   lazy,  coarse HDIV 6 grid, ~30 calls .............. emit.fx  0.19 ms
    //
    // COARSE cuts the count; LAZY cuts it again, because the pool is centred on
    // the eye and the half of it behind the player is never drawn.
    let hdiv: i32 = g_LANTERN_POOL_HDIV;
    if (hdiv < 1) { hdiv = 1; }
    if (hdiv > div) { hdiv = div; }
    // HDIV must divide DIV or `pool_hy`'s integer split does not tile. Walk
    // down to the nearest divisor rather than trusting the two constants to
    // stay compatible after someone edits one of them.
    //
    // >>> `divi`, NOT `/`. This loop was written with `/` and therefore never
    // >>> ran: `div / hdiv` is an f64 quotient, so `div - (div/hdiv)*hdiv` is
    // >>> algebraically 0.0 for EVERY pair and the divisor walk exited on its
    // >>> first test. DIV 12 / HDIV 6 happened to be a legal pair, so the bug
    // >>> was invisible until DIV was set to 8, which then indexed the coarse
    // >>> grid at 64 of 49 and killed the process. Measured, `--scene
    // >>> muzzle_fog --lantern 1`, POOL_DIV=8: crash before, 7.28 ms after.
    while (div - divi(div, hdiv) * hdiv != 0) { hdiv = hdiv - 1; }
    g_lp_rep = divi(div, hdiv);
    g_lp_hside = hdiv + 1;
    g_lp_hstep = (span * 2.0) / f64(hdiv);
    g_lp_x0 = x0;
    g_lp_z0 = z0;
    let need: i32 = g_lp_hside * g_lp_hside;
    while (g_lp_h.length < need) { g_lp_h.push(0.0); g_lp_ok.push(0.0); }
    for (let iz = 0; iz < need; iz++) { g_lp_ok[iz] = 0.0; }
    g_lp_calls = 0;

    // --- the texture is a CONSTANT WHITE TEXEL, and that is a measurement ----
    // The obvious implementation stretches the glow cell across the pool and
    // lets the affine UV interpolate the falloff per pixel. It does not work,
    // and the cell says why. Dumped, FX_GLOW_L, 16x16, luminance x alpha
    // normalised to 0..10 along the centre row:
    //
    //     0.0  0.0  0.1  0.5  5.5  9.8  9.8  9.8  9.8  9.8  9.8  5.5  0.6  0.1  0.0
    //
    // That is a SATURATED PLATEAU ~7 texels across with a ONE-TEXEL CLIFF to
    // near zero, which is exactly right for a 1.9 m billboard with a white
    // heart (fxgen `cell_glow` argues the case) and exactly wrong stretched
    // over a 14 m pool: the plateau covers the first 3 m flat and the cliff
    // becomes a hard bright ring on the ground at 3-4 m. That is what this
    // stage rendered before this comment existed.
    //
    // So the cell is sampled at ITS CENTRE — one texel, the plateau, a neutral
    // white multiplier — and the whole radial profile lives in the per-cell
    // vertex colour below, where it is a curve we control. The FX atlas has no
    // smooth radial ramp and `src/art/fxgen.hml` is not this task's file.
    atlas_cell_uv(g_atlas_fx, g_cell_glow, g_lp_uv, 0);
    let uc: f64 = (g_lp_uv[0] + g_lp_uv[2]) * 0.5;
    let vc: f64 = (g_lp_uv[1] + g_lp_uv[3]) * 0.5;

    // --- the grid. One reservation per cell so a rejected cell costs nothing.
    let drawn: i32 = 0;
    let bfx = g_bfx;
    let vb: ptr = batch_vbuf(bfx);
    for (let jz2 = 0; jz2 < div; jz2++) {
        let za: f64 = z0 + f64(jz2) * step;
        let zb: f64 = za + step;
        for (let ix2 = 0; ix2 < div; ix2++) {
            let xa: f64 = x0 + f64(ix2) * step;
            let xb: f64 = xa + step;
            // The radial profile, per cell. `emit_quad_world` writes ONE rgb to
            // all four vertices (emit.hml's kernel takes a single `p_rgb` and
            // hands the same br/bg/bb to `pack_v` three times), so a cell is
            // flat-shaded and the pool is a stepped ramp. `g_LANTERN_POOL_DIV`
            // is what buys the steps down: the step between adjacent rings is
            // 4(1-d)/DIV of peak, so DIV 6 steps ~28 % and DIV 12 steps ~14 %.
            //
            // The curve is (1 - d/r)^2 -- the SAME one shade.hml's point light
            // uses -- so the pool on the ground and the tint on a prop standing
            // in it agree instead of arguing about where the light ends.
            //
            // Cells whose centre is outside the disc are skipped: they would
            // cost two triangles each to add a value that is already zero.
            let mcx: f64 = xa + step * 0.5 - ox;
            let mcz: f64 = za + step * 0.5 - oz;
            let d2: f64 = mcx * mcx + mcz * mcz;
            if (d2 > span * span) { continue; }
            // BEHIND THE PLAYER IS NOT DRAWN, and testing it here is what makes
            // the stage affordable: the pool is centred on the eye, so half of
            // it is always outside the frustum, and every one of those cells
            // would otherwise pay four `terrain_h` calls and a 24-argument
            // `emit_quad_world` before being rejected at the near plane.
            // The -1.5 m margin keeps the row straddling the camera, which is
            // the row whose FAR edge is still on screen.
            if (mcx * fwx + mcz * fwz < 0.0 - 1.5) { continue; }
            let att: f64 = 1.0 - __sqrt(d2) / span;
            att = att * att;
            let rgb: i32 = clampi(i32(cr * att), 0, 255)
                         | (clampi(i32(cg * att), 0, 255) << 8)
                         | (clampi(i32(cb * att), 0, 255) << 16);
            if (rgb == 0) { continue; }
            let cur: i32 = batch_reserve(bfx, 2);
            if (cur < 0) { continue; }
            // Corner heights off the COARSE grid, bilinear, computed on demand
            // and remembered for the neighbouring cells that share them.
            // `pool_hy` takes COLOUR-grid indices and does the HDIV split.
            let ya0: f64 = pool_hy(ix2, jz2);
            let ya1: f64 = pool_hy(ix2 + 1, jz2);
            let yb1: f64 = pool_hy(ix2 + 1, jz2 + 1);
            let yb0: f64 = pool_hy(ix2, jz2 + 1);
            // Wound so the quad faces UP: (xa,za) (xb,za) (xb,zb) (xa,zb) with
            // the normal handed in as +Y, exactly as fx.hml's card is.
            let n: i32 = emit_quad_world(vb, cur, g_lp_dep, 0,
                                         xa, ya0, za,
                                         xb, ya1, za,
                                         xb, yb1, zb,
                                         xa, yb0, zb,
                                         uc, vc, uc, vc, uc, vc, uc, vc,
                                         0.0, 1.0, 0.0, rgb);
            bfx.n = bfx.n - (2 - n);
            for (let k = 0; k < n; k++) {
                batch_commit(bfx, cur + k * 60, g_tex_fx, g_lp_dep[k]);
            }
            drawn = drawn + n;
        }
    }
    g_lp_tris = drawn;
    let out: i32 = drawn;
    return out;
}

// ===========================================================================
// 3. THE SKY QUAD — mapping a 360-degree panorama onto a 70-degree frustum
// ---------------------------------------------------------------------------
// The sky STAYS HERE. §5.6 gives this file "the sky mapping" by name, and
// `sky.hml` is one of the seven frozen legacy wobbleweed basenames banned under
// `nightshade/src/` (CLAUDE.md §3), so there is no §5 module to move it to.
//
// skygen bakes U across a full turn of yaw and V from zenith (row 0) to
// horizon (row H-1). Two triangles with corner UVs would squeeze all 360
// degrees into the 70 the camera can see, so the sky is a small grid: each
// vertex takes the exact panorama UV of its own view ray, and the affine error
// inside an 8.75-degree column is under a texel. 48 triangles, at depth = FAR,
// in the SKY layer, flushed in insertion order before anything else.
//
// Below the horizon V clamps to 1.0, which is the row skygen derives from
// FOG_TINT_MUL — so the band under the horizon is the fog colour by
// construction and there is no seam at the skyline (ART_BIBLE §11.5, §6.6).
//
// ---------------------------------------------------------------------------
// ⚠ MIRRORED UVs DRAW NOTHING. Measured, not guessed.
// ---------------------------------------------------------------------------
// SDL 2.0.18's SOFTWARE renderer — the one every headless shot and the CI
// fallback use — silently draws NOTHING for a textured triangle whose u runs
// right-to-left. It is not a blend-mode issue and it is not a clipping issue.
// Minimal repro (a 64x64 target, a 16x16 half-red/half-green texture, one
// full-target quad, SDL_RenderGeometry, read back):
//
//     u 0.00 -> 1.00, BLEND_NONE   left 220,40   right 40,220     drawn
//     u 1.00 -> 0.00, BLEND_NONE   left 0,0      right 0,0        NOTHING
//     u 1.00 -> 0.00, BLEND_BLEND  left 0,0      right 0,0        NOTHING
//     u 0.36 -> 0.60, BLEND_NONE   left 220,40   right 40,220     drawn
//     u 0.60 -> 0.36, BLEND_NONE   left 0,0      right 0,0        NOTHING
//
// This cost two renders to find, because a dropped triangle leaves the CLEAR
// colour behind and a sky cleared to its own zenith looks like a plausible sky.
// It has already bitten twice in this project:
//   * the panorama. This engine's right vector is (cos yaw, 0, sin yaw), so
//     `atan2(x, z)` — skygen's own azimuth convention — DECREASES across the
//     screen from left to right. Sampled literally, every sky quad is mirrored
//     and the whole layer vanishes. sky_uv_at negates the azimuth and the
//     CALLER must negate the x of the sun direction it hands skygen to match.
//   * the minimap. hudgen ships one corner bracket and expects the other three
//     to be uv flips (HUD_MM_CORNER). Three of the four corners were invisible.
// Anything else in this project that plans to mirror a sprite with a uv flip —
// a left-facing icon, a mirrored decal, a flipped viewmodel — has to bake a
// second sprite instead, or draw on hardware only.
// ===========================================================================

// ---------------------------------------------------------------------------
// ⚠⚠ SDL SILENTLY REPLACES AN AXIS-ALIGNED TEXTURED QUAD WITH A RECT BLIT.
//    THE 1/1024 px ON THE BOTTOM-LEFT VERTEX IS WHAT STOPS IT. DO NOT REMOVE.
// ---------------------------------------------------------------------------
// `SDL_RenderGeometry` on the SOFTWARE renderer does not go to the rasterizer.
// It goes to `SDL_SW_RenderGeometryRaw` (SDL_render.c, "For the software
// renderer, try to reinterpret triangles as SDL_Rect"), which walks the vertex
// array in pairs and, whenever two consecutive triangles
//
//     (a) share exactly two vertices, and
//     (b) whose four distinct positions form an EXACTLY axis-aligned rect
//         (float `==` on x and y — no epsilon), and
//     (c) whose four vertex colours are bit-identical,
//
// throws the quad away and emits `SDL_RenderCopyF` instead, with
//
//     s.x = (int)(u_topleft * texw);   s.w = (int)(u_botright * texw - s.x);
//     s.y = (int)(v_topleft * texh);   s.h = (int)(v_botright * texh - s.y);
//
// TWO OF THE FOUR CORNER UVs ARE DISCARDED. Whatever the other two said, the
// cell is drawn as a straight unsheared crop of the panorama. And when the
// source span collapses:
//
//     if (texture && s.w != 0 && s.h != 0) { RenderCopyF }
//     else if (d.w != 0 && d.h != 0) { SetRenderDrawColor(vertex colour);
//                                      RenderFillRectF }   <-- NO TEXTURE
//
// a zero-wide or zero-tall source rect drops into the untextured branch and
// FILLS THE CELL WITH THE FLAT VERTEX COLOUR — rgb(255,255,255) for the sky,
// which emits at full white so the panorama shows unmodulated.
//
// That is the whole "solid white 32x60 rectangles when the camera pitches up"
// bug, and it is also the "solid rectangles" and the hard cell-boundary seams.
// Pitch a spherical panorama and the four UVs of a screen-aligned cell SHEAR:
// the bottom-right corner's u drifts BACK past the top-left corner's, so
// `(int)(u_br*512) - (int)(u_tl*512)` hits 0 and the cell goes white. Measured
// on the real emit at yaw 186 / pitch +45, cell (row 1, col 7):
//     u_tl = 0.6253 -> texel 320.1 -> s.x = 320
//     u_br = 0.6233 -> texel 319.1 -> s.w = (int)(-0.9) = 0   -> WHITE FILL
// and at pitch 0 the shear is zero, u_br is always ahead of u_tl, and the bug
// cannot fire — which is why every committed screenshot missed it.
//
// Condition (b) is the cheapest of the three to break and the only one that is
// free: perturbing a vertex position by 1/1024 px costs nothing, because
// `SW_QueueGeometry` truncates every destination coordinate to a whole pixel
// (`(int)(xy * scale)`) before it rasterizes, and `bounding_rect_fixedpoint`
// works off that integer. So the shear below is EXACTLY invisible in the
// software path and 0.001 px on hardware, while the float `==` in the rect
// test sees it and declines. 1/1024 is a power of two, exact in the f32 the
// vertex carries, and ~32 ulps at x = 224 — it cannot round away.
//
// Breaking (c) instead (one vertex at 254 instead of 255) also works, but it
// sets `has_modulation` in `SDL_SW_BlitTriangle` and drops every sky pixel
// onto the slow per-pixel modulating blit. Breaking (b) keeps the fast one.
//
// Consequences worth knowing, all of them the same root cause:
//   * "MIRRORED UVs DRAW NOTHING" above is this, not the rasterizer: a
//     right-to-left u makes `s.w` NEGATIVE, and RenderCopyF rejects it. The
//     real triangle path handles either winding. The negated azimuth is still
//     correct and still required for the seam split, so it stays.
//   * the 1 px white stripe at the +-180 seam was `s.x = (int)(1.0 * 512)`
//     = 512, one column past a 512-wide panorama. The triangle path clamps it:
//     `SDL_SW_BlitTriangle` decrements whichever source corner sits on its own
//     bounding-box maximum before it interpolates.
//   * every other axis-aligned uniform-colour textured quad in the game — the
//     whole HUD — still takes the rect path. That is harmless there and
//     slightly faster, because a HUD quad's UVs ARE an axis-aligned rect, so
//     the two discarded corners carried no information. Only the sky needs
//     four independent UVs, and only the sky sets the shear.
// ---------------------------------------------------------------------------

// The sub-pixel shear that keeps `SDL_SW_RenderGeometryRaw` off this quad.
// Read the block above before touching it.
let g_SKY_SHEAR: f64 = 0.0009765625;   // 1/1024 px

// ---------------------------------------------------------------------------
// THE HAZARD COUNTER — the shear is load-bearing, so it is also MEASURED.
// ---------------------------------------------------------------------------
// `sw_rect_claims` replays SDL_SW_RenderGeometryRaw's is_quad test on the six
// f32 vertices sky_quad_uv just wrote — AFTER the f64 -> f32 narrowing that the
// vertex buffer performs, which is the only rounding stage between here and
// SDL. It returns 1 when SDL would throw the pair away and issue
// SDL_RenderCopyF, which is the state that produced the white cells.
//
// It replays SDL's WHOLE state machine over the sky batch, not one quad at a
// time: when SDL rejects a pair it emits only the FIRST triangle and keeps the
// second as `prev`, so triangle 2 of one quad is next tested against triangle 1
// of the NEXT quad, and a per-quad check misses that pairing entirely.
//
// Off by default — one branch at the end of sky_emit, once a frame. A harness
// turns it on with `sky_diag_set(1)` and reads `sky_rect_hits()` after
// frame_render(); frame_begin() zeroes it. It exists so "the shear still holds
// at this camera position" is a NUMBER and not an argument. MEASURED with it:
// 0 of 34 408 poses, against 57 of 5 400 before the pole fix.
let g_sky_diag: i32 = 0;
let g_sky_rect_hits: i32 = 0;

export fn sky_diag_set(p_on: i32) { g_sky_diag = p_on; }
export fn sky_rect_hits(): i32 { let out: i32 = g_sky_rect_hits; return out; }

fn vf32(p_buf: ptr, p_off: i32): f64 {
    let out: f64 = ptr_deref_f32(ptr_offset(p_buf, p_off, 1));
    return out;
}

// The four colour bytes, compared byte by byte: SDL compares them as one int,
// but an i32 built from four bytes overflows in Hemlock (rule A13).
fn vceq(p_buf: ptr, p_i: i32, p_j: i32): i32 {
    let b: ptr = p_buf;
    let i: i32 = p_i;
    let j: i32 = p_j;
    for (let k = 8; k < 12; k++) {
        if (ptr_deref_u8(ptr_offset(b, i + k, 1))
         != ptr_deref_u8(ptr_offset(b, j + k, 1))) { let n: i32 = 0; return n; }
    }
    let y: i32 = 1;
    return y;
}

// SDL's remap_one_indice: a vertex of the second triangle collapses onto one
// of the first triangle's when position, colour AND uv are all bit-identical.
fn vsame(p_buf: ptr, p_a: i32, p_b: i32): i32 {
    let b: ptr = p_buf;
    let i: i32 = p_a;
    let j: i32 = p_b;
    if (vf32(b, i) != vf32(b, j)) { let n0: i32 = 0; return n0; }
    if (vf32(b, i + 4) != vf32(b, j + 4)) { let n1: i32 = 0; return n1; }
    if (vceq(b, i, j) == 0) { let n2: i32 = 0; return n2; }
    if (vf32(b, i + 12) != vf32(b, j + 12)) { let n3: i32 = 0; return n3; }
    if (vf32(b, i + 16) != vf32(b, j + 16)) { let n4: i32 = 0; return n4; }
    let y: i32 = 1;
    return y;
}

// One PAIR of consecutive triangles, exactly as SDL sees them: `p_pv` is the
// byte offset of the previous triangle's first vertex, `p_cur` the current
// one's. Returns 1 when SDL replaces the pair with SDL_RenderCopyF.
fn sw_rect_claims(p_buf: ptr, p_pv: i32, p_cur: i32): i32 {
    let b: ptr = p_buf;
    let v: i32 = p_pv;
    let c: i32 = p_cur;
    let k0: i32 = c; let k1: i32 = c + 20; let k2: i32 = c + 40;
    if (vsame(b, k0, v) == 1) { k0 = v; }
    else if (vsame(b, k0, v + 20) == 1) { k0 = v + 20; }
    else if (vsame(b, k0, v + 40) == 1) { k0 = v + 40; }
    if (vsame(b, k1, v) == 1) { k1 = v; }
    else if (vsame(b, k1, v + 20) == 1) { k1 = v + 20; }
    else if (vsame(b, k1, v + 40) == 1) { k1 = v + 40; }
    if (vsame(b, k2, v) == 1) { k2 = v; }
    else if (vsame(b, k2, v + 20) == 1) { k2 = v + 20; }
    else if (vsame(b, k2, v + 40) == 1) { k2 = v + 40; }
    // exactly two shared vertices, or SDL renders triangles
    let cnt: i32 = 0;
    for (let j = 0; j < 3; j++) {
        let p: i32 = v + j * 20;
        if (p == k0 || p == k1 || p == k2) { cnt = cnt + 1; }
    }
    if (cnt != 2) { let z: i32 = 0; return z; }
    let x0: f64 = vf32(b, k0); let y0: f64 = vf32(b, k0 + 4);
    let x1: f64 = vf32(b, k1); let y1: f64 = vf32(b, k1 + 4);
    let x2: f64 = vf32(b, k2); let y2: f64 = vf32(b, k2 + 4);
    // top-left
    let A: i32 = k2;
    if (x0 <= x1 && y0 <= y1) { if (x0 <= x2 && y0 <= y2) { A = k0; } }
    else { if (x1 <= x2 && y1 <= y2) { A = k1; } }
    // bottom-right
    let B: i32 = k2;
    if (x0 >= x1 && y0 >= y1) { if (x0 >= x2 && y0 >= y2) { B = k0; } }
    else { if (x1 >= x2 && y1 >= y2) { B = k1; } }
    let C: i32 = k2;
    if (k0 != A && k0 != B) { C = k0; }
    else if (k1 != A && k1 != B) { C = k1; }
    let C2: i32 = v + 40;
    if (v != A && v != B) { C2 = v; }
    else if (v + 20 != A && v + 20 != B) { C2 = v + 20; }
    let ax: f64 = vf32(b, A); let ay: f64 = vf32(b, A + 4);
    let bx: f64 = vf32(b, B); let by: f64 = vf32(b, B + 4);
    let cx: f64 = vf32(b, C); let cy: f64 = vf32(b, C + 4);
    if ((ax == cx && by == cy) || (ay == cy && bx == cx)) { }
    else { let z2: i32 = 0; return z2; }
    let dx: f64 = vf32(b, C2); let dy: f64 = vf32(b, C2 + 4);
    if ((ax == dx && by == dy) || (ay == dy && bx == dx)) { }
    else { let z3: i32 = 0; return z3; }
    // uniformly coloured
    if (vceq(b, A, B) == 0 || vceq(b, A, C) == 0 || vceq(b, A, C2) == 0) {
        let z4: i32 = 0; return z4;
    }
    let hit: i32 = 1;
    return hit;
}

// Replay SDL_SW_RenderGeometryRaw's WHOLE state machine over the sky batch in
// flush order. The pairing is NOT quad-aligned: when a pair is rejected SDL
// emits only the FIRST triangle and keeps the second as `prev`, so triangle 2
// of one quad is next tested against triangle 1 of the NEXT quad. A per-quad
// check misses exactly that case, which is where the residual flicker lived.
fn sky_rect_scan(p_b): i32 {
    let n: i32 = batch_count(p_b);
    if (n < 2) { let z: i32 = 0; return z; }
    let buf: ptr = batch_vbuf(p_b);
    let hits: i32 = 0;
    let has_prev: i32 = 0;
    let pv: i32 = 0;
    for (let t = 0; t < n; t++) {
        let cur: i32 = t * 60;
        if (has_prev == 0) { pv = cur; has_prev = 1; }
        else if (sw_rect_claims(buf, pv, cur) == 1) { hits = hits + 1; has_prev = 0; }
        else { pv = cur; }
    }
    let out: i32 = hits;
    return out;
}

// One screen-space quad with four independent UVs. Written straight through
// batch_write_vertex — the reference encoder for the 20-byte SDL_Vertex. The
// sky panorama needs per-corner UVs, so the rect form is not enough.
// FOUR INDEPENDENT CORNERS, not a rect. The seam cut is a slanted line (the
// panorama's u = 1 iso-line crosses a screen-aligned cell diagonally at any
// non-zero pitch), so the two halves it produces are TRAPEZOIDS. Forcing them
// into an axis-aligned rect is what used to leave a corner sampling the wrong
// side of the seam; see THE SEAM below.
fn sky_quad_uv(p_b, p_tex,
               p_xa: f64, p_ya: f64, p_xb: f64, p_yb: f64,
               p_xc: f64, p_yc: f64, p_xd: f64, p_yd: f64,
               p_ua: f64, p_va: f64, p_ub: f64, p_vb: f64,
               p_uc: f64, p_vc: f64, p_ud: f64, p_vd: f64,
               p_r: i32, p_g: i32, p_bl: i32, p_a: i32, p_depth: f64): i32 {
    let cur: i32 = batch_reserve(p_b, 2);
    if (cur < 0) { let z: i32 = 0; return z; }
    let buf: ptr = batch_vbuf(p_b);
    // Bottom-left only, and POSITIVE: it is the one corner whose x the rect
    // test compares against the top-left, and a positive nudge can never
    // truncate into the pixel to the left.
    let xbl: f64 = p_xd + g_SKY_SHEAR;
    batch_write_vertex(buf, cur, p_xa, p_ya, p_r, p_g, p_bl, p_a, p_ua, p_va);
    batch_write_vertex(buf, cur + 20, p_xb, p_yb, p_r, p_g, p_bl, p_a, p_ub, p_vb);
    batch_write_vertex(buf, cur + 40, p_xc, p_yc, p_r, p_g, p_bl, p_a, p_uc, p_vc);
    batch_write_vertex(buf, cur + 60, p_xa, p_ya, p_r, p_g, p_bl, p_a, p_ua, p_va);
    batch_write_vertex(buf, cur + 80, p_xc, p_yc, p_r, p_g, p_bl, p_a, p_uc, p_vc);
    batch_write_vertex(buf, cur + 100, xbl, p_yd, p_r, p_g, p_bl, p_a, p_ud, p_vd);
    batch_commit(p_b, cur, p_tex, p_depth);
    batch_commit(p_b, cur + 60, p_tex, p_depth);
    let out: i32 = 2;
    return out;
}

let g_SKY_COLS: i32 = 10;
let g_SKY_ROWS: i32 = 4;

// The camera basis, hoisted once per sky pass, and the one output pair.
let g_sk_thh: f64 = 0.0;   let g_sk_thv: f64 = 0.0;
let g_sk_fx: f64 = 0.0;    let g_sk_fy: f64 = 0.0;   let g_sk_fz: f64 = -1.0;
let g_sk_rx: f64 = 1.0;    let g_sk_rz: f64 = 0.0;
let g_sk_ux: f64 = 0.0;    let g_sk_uy: f64 = 1.0;   let g_sk_uz: f64 = 0.0;
let g_sk_u: f64 = 0.0;     let g_sk_v: f64 = 0.0;

export fn sky_basis() {
    let fovr: f64 = g_fov * g_D2R;
    let aspect: f64 = f64(g_RES_W) / f64(g_RES_H);
    let hh: f64 = fovr * 0.5;
    g_sk_thv = sin(hh) / cos(hh);
    g_sk_thh = g_sk_thv * aspect;
    let cyw: f64 = cos(g_yaw * g_D2R);
    let syw: f64 = sin(g_yaw * g_D2R);
    let cpw: f64 = cos(g_pitch * g_D2R);
    let spw: f64 = sin(g_pitch * g_D2R);
    g_sk_fx = syw * cpw;  g_sk_fy = spw;  g_sk_fz = 0.0 - (cyw * cpw);
    g_sk_rx = cyw;        g_sk_rz = syw;
    g_sk_ux = 0.0 - (syw * spw);  g_sk_uy = cpw;  g_sk_uz = cyw * spw;
}

// Panorama UV of the view ray through NDC (x, y), into sky_u() / sky_v().
// u is NOT wrapped into [0,1) here: the caller wants the continuous turn count
// so it can split the one quad that crosses the seam.
//
// ⚠ THE AZIMUTH IS NEGATED. This is not a taste decision — see MIRRORED UVs in
// the block comment above. `atan2(-wx, wz)` makes u ASCEND with screen x for
// this engine's camera basis (right = (cos yaw, 0, sin yaw)), which is the only
// thing SDL 2.0.18's software renderer will draw. The caller negates the x of
// the sun direction it hands skygen by exactly the same token, so the sun and
// moon still land at their true azimuths; only the procedural cloud and star
// field is mirrored, which is unobservable.
export fn sky_uv_at(p_ndcx: f64, p_ndcy: f64) {
    let dx: f64 = p_ndcx * g_sk_thh;
    let dy: f64 = p_ndcy * g_sk_thv;
    let wx: f64 = g_sk_rx * dx + g_sk_ux * dy + g_sk_fx;
    let wy: f64 = g_sk_uy * dy + g_sk_fy;
    let wz: f64 = g_sk_rz * dx + g_sk_uz * dy + g_sk_fz;
    let l: f64 = sqrt(wx * wx + wy * wy + wz * wz);
    if (l > 0.0) { wx = wx / l; wy = wy / l; wz = wz / l; }
    let az: f64 = atan2(0.0 - wx, wz);
    let el: f64 = asin(clampf(wy, -1.0, 1.0));
    g_sk_u = az / 6.283185307179586 + 0.5;
    // ⚠ V STOPS HALF A TEXEL SHORT OF 1.0, NOT AT 1.0. A uv of exactly 1.0 is
    // the texture's trailing EDGE, and the sample there lands on index SKY_H —
    // one row past the end of a 160-row panorama. This is not theoretical: the
    // identical bug on the u axis (a u of exactly 1.0 at the +-180 split) draws
    // a pure rgb(255,255,255) column, measured at yaw 0. Below the horizon
    // EVERY corner of the lower grid rows clamps here, so the exact-1.0 form
    // put an out-of-bounds fetch under a large part of the frame — the
    // near-white blocks the playtest reported whenever the camera pitched down.
    // 1 - 0.5/SKY_H samples the CENTRE of the last row instead: the same texel
    // under nearest-neighbour, so it is still the FOG_TINT_MUL row that the
    // no-seam-at-the-skyline contract (ART_BIBLE §11.5, §6.6) depends on.
    g_sk_v = clampf(1.0 - el / 1.5707963267948966, 0.0, 0.996875);
}

export fn sky_u(): f64 { let out: f64 = g_sk_u; return out; }
export fn sky_v(): f64 { let out: f64 = g_sk_v; return out; }

fn sky_emit(p_depth: f64): i32 {
    let cols: i32 = g_SKY_COLS;
    let rows: i32 = g_SKY_ROWS;
    sky_basis();
    let w: f64 = f64(g_RES_W) / f64(cols);
    let h: f64 = f64(g_RES_H) / f64(rows);
    let tris: i32 = 0;
    for (let j = 0; j < rows; j++) {
        for (let i = 0; i < cols; i++) {
            let nx0: f64 = f64(i) / f64(cols) * 2.0 - 1.0;
            let nx1: f64 = f64(i + 1) / f64(cols) * 2.0 - 1.0;
            let ny0: f64 = 1.0 - f64(j) / f64(rows) * 2.0;
            let ny1: f64 = 1.0 - f64(j + 1) / f64(rows) * 2.0;
            sky_uv_at(nx0, ny0); let ua: f64 = g_sk_u; let va: f64 = g_sk_v;
            sky_uv_at(nx1, ny0); let ub: f64 = g_sk_u; let vb: f64 = g_sk_v;
            sky_uv_at(nx1, ny1); let uc: f64 = g_sk_u; let vc: f64 = g_sk_v;
            sky_uv_at(nx0, ny1); let ud: f64 = g_sk_u; let vd: f64 = g_sk_v;
            // One quad spans 1/cols of the fov — under 10 degrees of azimuth —
            // so the other three corners are within 0.03 turns of the first.
            // Anything further apart is the +-180 seam, and wraps.
            if (ub - ua > 0.5) { ub = ub - 1.0; }
            if (ua - ub > 0.5) { ub = ub + 1.0; }
            if (uc - ua > 0.5) { uc = uc - 1.0; }
            if (ua - uc > 0.5) { uc = uc + 1.0; }
            if (ud - ua > 0.5) { ud = ud - 1.0; }
            if (ua - ud > 0.5) { ud = ud + 1.0; }
            // The grid cells OVERLAP by 0.6 px on their right and bottom
            // edges. This dates from when every cell was a RenderCopyF of a
            // float rect (see sky_quad_uv) and a 32.0-wide rect left a column
            // no fill rule claimed. On the triangle path it is a no-op: SDL
            // truncates every destination coordinate to a whole pixel, so
            // x1 = 128.6 rasterizes as 128 — exactly the next cell's x0 — and
            // `SDL_SW_BlitTriangle` does implement the top-left fill rule, so
            // the two cells tile without a gap or a double-written column. It
            // is left in place because it costs nothing and the walkaround's
            // committed frames were taken with it.
            let x0: f64 = f64(i) * w;
            let x1: f64 = f64(i + 1) * w + 0.6;
            let y0: f64 = f64(j) * h;
            let y1: f64 = f64(j + 1) * h + 0.6;
            // NOTE — the minimum-uv-span guards that used to live here (epu =
            // 1/512, epv = 1/160, forcing one texel of span onto a collapsed
            // edge) are GONE, and deliberately. They existed because the rect
            // path dropped the quad when `s.w` or `s.h` came out zero, so a
            // sub-horizon cell — every corner of which clamps to the same v —
            // drew nothing at all. The triangle path takes its coverage from
            // the DESTINATION, so a zero-span source edge is simply a cell
            // that samples one texel row, which is the correct answer. Keeping
            // the guard was not free: it pulled `va` a whole texel off the
            // clamp, so the band under the skyline sampled panorama row 158
            // instead of row 159 — and row 159 is the FOG_TINT_MUL row that
            // the no-seam-at-the-skyline contract is built on (ART_BIBLE
            // §11.5, §6.6). Removing it makes that contract hold exactly.
            //
            // -----------------------------------------------------------
            // THE POLE. u ASCENDS WITH SCREEN X ONLY WHILE THE POLE IS
            // OUTSIDE THE FRUSTUM — AND THE SPLIT MUST SURVIVE THAT.
            // -----------------------------------------------------------
            // The vertical half-fov is 35 deg, so from |pitch| >= 55 the
            // zenith (or nadir) is INSIDE the frame and the azimuth of a view
            // ray stops being monotonic in screen x: at the pole every azimuth
            // meets, and past it the azimuth reverses. A reversed u is FINE to
            // draw — `SDL_SW_BlitTriangle` handles either winding, and MIRRORED
            // UVs below is about the rect path, not the rasterizer — but every
            // piece of arithmetic below that assumed "left corner smallest,
            // right corner largest" was wrong there:
            //
            //  * `lo` was taken from the left pair and `hi` from the right
            //    pair, so a cell whose extreme u sat on the OTHER pair got the
            //    wrong whole-turn shift and ran off the panorama.
            //  * `(1 - ua) / (ub - ua)` was evaluated whenever `hi` exceeded 1,
            //    including on the pole row where ub == ua EXACTLY. That is a
            //    division by zero: the cut column came out +-inf and the
            //    cell's vertices were non-finite. MEASURED over yaw 0..360 x
            //    pitch +-89.5 in 64 620 poses: 230 quads in 50 poses, all at
            //    pitch = +-55.0, where the frame edge lands exactly on the
            //    pole. Those 50 poses are also the only ones where SDL's
            //    software rect fast path still claimed a sky quad — the inf
            //    coordinates, not the 1/1024 shear failing.
            //  * even when it was finite, nothing bounded `t` to [0,1], so the
            //    "left" half's right edge could land PAST the cell's own right
            //    edge and the "right" half came out inverted.
            //
            // Everything below is now written to be indifferent to the
            // direction u runs: lo/hi are over all four corners, and a cut is
            // only taken on an edge that demonstrably ASCENDS through 1.0,
            // which makes `t` in (0,1) by construction and can never divide by
            // zero.

            // Shift into [0,1): a negative u is not a wrap. `(int)(u * 512)`
            // truncates toward zero, so a negative u indexes off the front of
            // the panorama. lo/hi are over ALL FOUR corners — taking lo from
            // the left pair and hi from the right pair assumed the same
            // monotonicity the pole breaks.
            let lo: f64 = ua;
            if (ub < lo) { lo = ub; }
            if (uc < lo) { lo = uc; }
            if (ud < lo) { lo = ud; }
            let sh: f64 = floor(lo);
            ua = ua - sh; ub = ub - sh; uc = uc - sh; ud = ud - sh;
            let hi: f64 = ua;
            if (ub > hi) { hi = ub; }
            if (uc > hi) { hi = uc; }
            if (ud > hi) { hi = ud; }
            if (hi > 1.0) {
                // -------------------------------------------------------
                // THE SEAM. The cell straddles the panorama's +-180 cut.
                // -------------------------------------------------------
                // The seam is the u = 1 iso-line of the cell's own uv field,
                // and at any non-zero pitch that line is SLANTED — it enters
                // one edge and leaves another. Cutting the cell with a
                // VERTICAL line at the top edge's crossing (which is what
                // this did) is only right when the line happens to be
                // vertical, i.e. at pitch 0. Everywhere else the bottom
                // corners kept the un-wrapped value, so the right half was
                // handed `uc - 1.0` < 0 — a negative u, straight into the
                // "indexes off the front of the panorama" case above.
                // MEASURED over the same 64 620 poses: 84 012 quads carried
                // a negative u, in 27 778 poses, at EVERY pitch including 0;
                // the overshoot reached 5.9 texels at |pitch| <= 20, 20.7 at
                // 40 and 253 at the pole.
                //
                // So cut along the seam itself. Both halves are trapezoids,
                // which is why sky_quad_uv now takes four independent
                // corners. Two cases cover it exactly:
                //   TOP+BOTTOM crossing -> a near-vertical cut,
                //   LEFT+RIGHT crossing -> a near-horizontal cut,
                // and v is interpolated onto the cut, which the vertical-only
                // version also skipped.
                //
                // KEPT FROM THE OLD SPLIT, STILL LOAD-BEARING. The 1 px white
                // stripe this used to leave over a ~7-degree window of yaw —
                // pure white on one side of the cut, clear colour on the other
                // — was never the split's fault. It was the rect path in
                // sky_quad_uv: `s.x = (int)(1.0 * 512)` is column 512 of a
                // 512-wide panorama, and the float cut column was covered by
                // two RenderCopyF rects that rounded apart. The triangle path
                // fixes both ends, and the cut edges below still rely on it:
                // `SDL_SW_BlitTriangle` decrements whichever source corner
                // sits on its own bounding-box maximum before interpolating,
                // so the u = 1.0 edge samples texel 511 and not 512; and both
                // halves truncate the cut column to the same whole pixel, so
                // the top-left fill rule hands that column to exactly one of
                // them. Measured, ridge_golden 01:24, yaw swept -6..+6 in
                // 0.125 steps at six pitches (582 frames): 206 frames /
                // 272 888 pure-white pixels before, 0 frames / 0 pixels after.
                let tT: f64 = -1.0;
                let tB: f64 = -1.0;
                let tL: f64 = -1.0;
                let tR: f64 = -1.0;
                if (ua < 1.0 && ub > 1.0) { tT = (1.0 - ua) / (ub - ua); }
                if (ud < 1.0 && uc > 1.0) { tB = (1.0 - ud) / (uc - ud); }
                if (ua < 1.0 && ud > 1.0) { tL = (1.0 - ua) / (ud - ua); }
                if (ub < 1.0 && uc > 1.0) { tR = (1.0 - ub) / (uc - ub); }
                if (tT >= 0.0 && tB >= 0.0) {
                    let xt: f64 = x0 + (x1 - x0) * tT;
                    let xb: f64 = x0 + (x1 - x0) * tB;
                    let vt: f64 = va + (vb - va) * tT;
                    let vbo: f64 = vd + (vc - vd) * tB;
                    tris = tris + sky_quad_uv(g_bsky, g_tex_sky,
                                              x0, y0, xt, y0, xb, y1, x0, y1,
                                              clampf(ua, 0.0, 1.0), va,
                                              1.0, vt, 1.0, vbo,
                                              clampf(ud, 0.0, 1.0), vd,
                                              255, 255, 255, 255, p_depth);
                    tris = tris + sky_quad_uv(g_bsky, g_tex_sky,
                                              xt, y0, x1, y0, x1, y1, xb, y1,
                                              0.0, vt,
                                              clampf(ub - 1.0, 0.0, 1.0), vb,
                                              clampf(uc - 1.0, 0.0, 1.0), vc,
                                              0.0, vbo,
                                              255, 255, 255, 255, p_depth);
                    continue;
                }
                if (tL >= 0.0 && tR >= 0.0) {
                    let yl: f64 = y0 + (y1 - y0) * tL;
                    let yr: f64 = y0 + (y1 - y0) * tR;
                    let vl: f64 = va + (vd - va) * tL;
                    let vr: f64 = vb + (vc - vb) * tR;
                    tris = tris + sky_quad_uv(g_bsky, g_tex_sky,
                                              x0, y0, x1, y0, x1, yr, x0, yl,
                                              clampf(ua, 0.0, 1.0), va,
                                              clampf(ub, 0.0, 1.0), vb,
                                              1.0, vr, 1.0, vl,
                                              255, 255, 255, 255, p_depth);
                    tris = tris + sky_quad_uv(g_bsky, g_tex_sky,
                                              x0, yl, x1, yr, x1, y1, x0, y1,
                                              0.0, vl, 0.0, vr,
                                              clampf(uc - 1.0, 0.0, 1.0), vc,
                                              clampf(ud - 1.0, 0.0, 1.0), vd,
                                              255, 255, 255, 255, p_depth);
                    continue;
                }
                // The seam clips a CORNER off the cell — it enters and leaves
                // through two adjacent edges, so neither cut is a quad split.
                // Take the whole-turn shift that leaves the least to clamp
                // (i.e. keep the side of the seam that owns most of the cell)
                // and clamp the rest. The clamped corners are by construction
                // the ones nearest the seam, so the error is bounded by how
                // far into the cell the corner reaches: MEASURED worst case
                // 46.0 texels of 512 at |pitch| <= 50, and every larger value
                // is on a panorama row that is one flat colour (row 0 at the
                // zenith, row 159 = FOG_TINT_MUL below the skyline).
                let over: f64 = 0.0;
                let under: f64 = 0.0;
                if (ua > 1.0) { over = over + ua - 1.0; } else { under = under + 1.0 - ua; }
                if (ub > 1.0) { over = over + ub - 1.0; } else { under = under + 1.0 - ub; }
                if (uc > 1.0) { over = over + uc - 1.0; } else { under = under + 1.0 - uc; }
                if (ud > 1.0) { over = over + ud - 1.0; } else { under = under + 1.0 - ud; }
                if (under < over) {
                    ua = ua - 1.0; ub = ub - 1.0; uc = uc - 1.0; ud = ud - 1.0;
                }
                ua = clampf(ua, 0.0, 1.0); ub = clampf(ub, 0.0, 1.0);
                uc = clampf(uc, 0.0, 1.0); ud = clampf(ud, 0.0, 1.0);
            }
            tris = tris + sky_quad_uv(g_bsky, g_tex_sky,
                                      x0, y0, x1, y0, x1, y1, x0, y1,
                                      ua, va, ub, vb, uc, vc, ud, vd,
                                      255, 255, 255, 255, p_depth);
        }
    }
    if (g_sky_diag != 0) { g_sky_rect_hits = sky_rect_scan(g_bsky); }
    let out: i32 = tris;
    return out;
}

// ===========================================================================
// 4. THE FRAME — ARCHITECTURE.md §4, IN ORDER
// ===========================================================================

// Stage 0 of the caller's frame: reset the counters BEFORE stage 6, so the
// time-of-day and sky-bake stages land inside the frame's own timing.
export fn frame_begin() {
    stat_frame_begin();
    emit_stats_reset();
    mesh_reset_counters();
    billboard_reset_counters();
    g_sky_rect_hits = 0;
    g_lm_submitted = 0;
    g_lm_dropped = 0;
}

// STAGES 8..23. The caller has already run stage 6 (tod_eval into frame_env())
// and stage 7 (the sky re-bake) — see THE IMPORT WALL in the header.
// Returns the number of triangles the SKY layer emitted (0 in sheet mode).
//
// Each per-stage module is called from INSIDE this file's own stat_begin/end
// pair, so every §4 stage timer measures exactly the work it measured before
// the split — one extra function call per frame, not per element.
export fn frame_render(): i32 {
    let sheet: i32 = g_opt_sheet;
    let aspect: f64 = f64(g_RES_W) / f64(g_RES_H);
    let fovr: f64 = g_fov * g_D2R;

    // -- 7b  the dynamic light manager: adopt, rank, cap, commit -------------
    // FIRST, and before `emit_set_env`, because `env_bind` hoists the light
    // block into shade.hml's derived state and stages 13/14/16 read the env
    // array live. Committing after either one would light the frame with the
    // PREVIOUS frame's slots. §2b has the whole policy.
    lights_commit();

    emit_set_env(g_env);

    // -- 8..10  view basis, MVP hoist, frustum extraction --------------------
    stat_begin(STAT_T_VIEW);
    let far: f64 = env_far_plane(g_env);
    let proj = mat_perspective(fovr, aspect, g_NEAR, far);
    let view = mat_look_dir(v3(g_camx, g_camy, g_camz), g_yaw * g_D2R, g_pitch * g_D2R);
    g_mvp = mat_mul(proj, view);
    g_proj = proj;                      // view space, for the viewmodel (15)
    emit_set_mvp(g_mvp);
    emit_set_viewport(f64(g_RES_W), f64(g_RES_H), g_GUARD);
    emit_set_near(g_NEAR);
    emit_set_backface(EMIT_BF_CCW);
    emit_set_lighting(0);               // baked vertex colour + fog only (G19)
    mesh_set_mvp(g_mvp);
    mesh_set_viewport(f64(g_RES_W), f64(g_RES_H));
    mesh_set_near(g_NEAR);
    mesh_set_cull(MESH_CULL_NEG);
    billboard_set_mvp(g_mvp);
    billboard_set_viewport(f64(g_RES_W), f64(g_RES_H));
    billboard_set_near(g_NEAR);
    billboard_set_proj_persp(fovr, aspect, f64(g_RES_W), f64(g_RES_H));
    frustum_from_mvp(g_frustum, g_mvp);
    stat_end(STAT_T_VIEW);

    // The fog wall is the triangle budget (CLAUDE.md §6): nothing is drawn
    // past it. It is read from the env, which stage 6 has already written.
    let fog_far: f64 = env_field(g_env, ENV_FOG_FAR);

    // -- 11  reset all four batches. No allocation past this line. -----------
    stat_begin(STAT_T_BATCH_RESET);
    batch_reset(g_bsky);
    batch_reset(g_bworld);
    batch_reset(g_bfx);
    batch_reset(g_bhud);

    // ---- THE PAINTER-SORT QUANTUM FOLLOWS THE FOG WALL --------------------
    // There is no z-buffer on this path by design (CLAUDE.md §6), so the ONLY
    // thing separating two surfaces at similar depth is which bucket they land
    // in: `batch_sort` quantizes to `depth_far / 2048` and everything inside
    // one bucket keeps EMISSION order. Two surfaces closer together than the
    // quantum therefore swap the moment emission order changes, which is what
    // "textures kinda clip into each other" looks like in motion.
    //
    // `frame_batches` sizes the world batch for the worst case, 80 m, giving a
    // 39.06 mm quantum. But the far plane is `FOG_FAR * 1.06` and FOG_FAR is a
    // per-scene number: at storm_assault's 20 m the far plane is 21.2 m, so
    // 73 % of the 2048 buckets were addressing space beyond the fog wall and
    // the quantum was 3.8x coarser than it needed to be. Retuning it per frame
    // is two field writes (`batch_set_depth_far` does no allocation and no
    // work proportional to n). quantum = min(FOG_FAR * 1.06, 80) / 2048:
    //
    //     FOG_FAR   far plane   quantum before -> after
    //        72 m      76.32 m    39.06 mm ->  37.27 mm    (x1.05)
    //        64 m      67.84 m    39.06 mm ->  33.13 mm    (x1.18)
    //        52 m      55.12 m    39.06 mm ->  26.91 mm    (x1.45)
    //        48 m      50.88 m    39.06 mm ->  24.84 mm    (x1.57)
    //        30 m      31.80 m    39.06 mm ->  15.53 mm    (x2.52)
    //        26 m      27.56 m    39.06 mm ->  13.46 mm    (x2.90)
    //        20 m      21.20 m    39.06 mm ->  10.35 mm    (x3.77)
    //
    // Only the FAR end clamps, and only for geometry past the far plane — a
    // chunk is kept when its NEAREST point is inside `fog_far`, so its far
    // corner can overshoot, and there is no far-plane rejection in emit.hml.
    // Anything that overshoots is at or beyond the fog wall, where fog alpha
    // is at maximum and the ordering is not visible; it lands in bucket 0 and
    // is drawn first, which is where far geometry belongs. Nothing NEW is
    // clamped that was not already clamped past 80 m, and no triangle changes
    // whether it is drawn — only which bucket it sorts into.
    // The sky has its own batch (400 m) and is not touched.
    let sort_far: f64 = far;
    if (sort_far > 80.0) { sort_far = 80.0; }
    if (sort_far < 1.0) { sort_far = 1.0; }
    batch_set_depth_far(g_bworld, sort_far);
    batch_set_depth_far(g_bfx, sort_far);
    stat_end(STAT_T_BATCH_RESET);

    stat_begin(STAT_T_EMIT);

    // -- 12  sky: the panorama, at depth = FAR -------------------------------
    stat_begin(STAT_T_EMIT_SKY);
    let skytris: i32 = 0;
    if (sheet == 0) { skytris = sky_emit(far); }
    stat_end(STAT_T_EMIT_SKY);

    // -- 13  terrain: ring walk -> frustum_sphere per chunk -> emit ----------
    stat_begin(STAT_T_EMIT_TERRAIN);
    if (sheet == 0) {
        terrain_emit(g_bworld, g_tex_world, g_frustum, g_camx, g_camz, fog_far);
    } else {
        terrain_emit_none();
    }
    stat_end(STAT_T_EMIT_TERRAIN);

    // -- 14  entities/props: real LOD + ONE contact blob each ----------------
    stat_begin(STAT_T_EMIT_ENTITY);
    if (sheet == 0) {
        entity_emit(g_bworld, g_tex_world, g_env, g_frustum, g_mesh_blob,
                    g_camx, g_camz, fog_far);
    } else {
        entity_emit_none();
    }
    stat_end(STAT_T_EMIT_ENTITY);

    // -- 15  viewmodel: never culled, never fogged, and IN VIEW SPACE -------
    //
    // Full rationale at g_vm_model's declaration. In one line: the viewmodel is
    // bolted to the camera, so it is drawn under `proj` alone -- the view
    // matrix is the camera's own rotation, and that is the one transform a
    // first-person held object must NOT receive. No yaw term, no pitch term,
    // no camera position: g_vm_model is the same sixteen constants forever,
    // which is why no camera angle can pose it wrongly again.
    //
    // IT STAYS IN THE ORCHESTRATOR. `src/render/viewmodel.hml` (W4-10) owns the
    // ANIMATED first-person weapon — sway, bob, kick, reload stages — and takes
    // the projection rather than the MVP for exactly this reason. What is here
    // is the REST POSE placement, which is the frame graph's own knowledge of
    // where LAYER_WORLD's depth 0.05 slot is; moving it into a per-stage module
    // would have changed which file knows the layer order, and this task's
    // whole proof is that nothing changed.
    stat_begin(STAT_T_EMIT_VIEWMODEL);
    if (sheet == 0 && g_opt_viewmodel != 0) {
        // The viewmodel is never fogged (§6.6) but it IS lit: a full-albedo
        // lantern at night is the single most common first-person lighting
        // bug. It is baked with the world, so the tint is neutral and alpha is
        // opaque. Depth is mesh_emit's usual view-space w, which under this
        // placement is z_local + 1.05 m -- nearer than anything in the world,
        // so it still paints last inside LAYER_WORLD, exactly as before.
        mesh_set_mvp(g_proj);
        mesh_emit(g_mesh_vm, g_bworld, g_tex_world, g_vm_model,
                  255, 255, 255, 255);
        mesh_set_mvp(g_mvp);            // restore world space for stage 16 on
    }
    stat_end(STAT_T_EMIT_VIEWMODEL);

    // -- 16  fx: particles, glow cards, tracers, rain ------------------------
    // STAT_PARTICLES is published unconditionally, including in sheet mode,
    // where it must read 0 rather than the previous frame's count.
    stat_begin(STAT_T_EMIT_FX);
    let nfx: i32 = 0;
    if (sheet == 0) {
        nfx = fx_emit(g_bfx, g_tex_fx, g_atlas_fx, g_env, g_cell_glow,
                      g_camx, g_camz);
        // -- 16b  the lantern's ground pool. See the long note at its
        // definition: fx.hml's single-quad card cannot survive the near plane
        // for a light in the player's hand, and this is the whole reason the
        // lantern lit nothing.
        lantern_pool_emit();
    } else {
        g_lp_tris = 0;
    }
    stat_set(STAT_PARTICLES, nfx);
    stat_end(STAT_T_EMIT_FX);
    stat_end(STAT_T_EMIT);

    // -- 17  overflow accounting --------------------------------------------
    stat_set(STAT_TRIS_SUBMITTED, emit_count_submitted()
                                  + batch_count(g_bsky) + batch_count(g_bhud));
    stat_add(STAT_REJ_BACKFACE, emit_count_backface() + mesh_rej_backface());
    stat_add(STAT_REJ_NEAR, emit_count_near() + mesh_rej_near());
    stat_add(STAT_REJ_GUARD, emit_count_guard() + mesh_rej_guard());
    stat_add(STAT_CLIP_STRADDLE, emit_count_straddle());

    // -- 18  target_begin ----------------------------------------------------
    stat_begin(STAT_T_TARGET_BEGIN);
    target_begin(g_target);
    set_draw_blend(g_win, BLEND_BLEND);
    stat_end(STAT_T_TARGET_BEGIN);

    // -- 19  clear to the sky zenith so a dropped sky frame is never black ---
    stat_begin(STAT_T_CLEAR);
    sdl_clear(g_win, g_clear_r, g_clear_g, g_clear_b, 255);
    if (sheet == 1) { sdl_clear(g_win, g_sheet_r, g_sheet_g, g_sheet_b, 255); }
    stat_end(STAT_T_CLEAR);

    // -- 20  SKY, insertion order, 1-3 draw calls ---------------------------
    stat_begin(STAT_T_FLUSH_SKY);
    batch_flush(g_win, g_bsky);
    stat_end(STAT_T_FLUSH_SKY);

    // -- 21  WORLD, bucket-sorted on view depth, then texture runs ----------
    // batch.hml fuses sort+flush. The counting sort is idempotent, so it is
    // timed on its own here and `flush.world` below still contains one sort;
    // flush.world - sort.world is the pure gather+draw cost.
    stat_begin(STAT_T_SORT_WORLD);
    batch_sort(g_bworld);
    stat_end(STAT_T_SORT_WORLD);
    stat_begin(STAT_T_FLUSH_WORLD);
    batch_sort_flush(g_win, g_bworld);
    stat_end(STAT_T_FLUSH_WORLD);

    // -- 22  FX, sorted, additive -------------------------------------------
    stat_begin(STAT_T_SORT_FX);
    batch_sort(g_bfx);
    stat_end(STAT_T_SORT_FX);
    stat_begin(STAT_T_FLUSH_FX);
    batch_sort_flush(g_win, g_bfx);
    stat_end(STAT_T_FLUSH_FX);

    // -- 23  postfx: the vignette ring + the lightning flash -----------------
    // This is the LAST thing in LAYER_HUD before the caller's stage 24, and it
    // has to stay that way: LAYER_HUD is flushed in insertion order, so the
    // vignette sits UNDER the HUD, not over it.
    stat_begin(STAT_T_POSTFX);
    if (sheet == 0) {
        postfx_emit(g_bhud, g_opt_lightning);
    }
    stat_end(STAT_T_POSTFX);

    let out: i32 = skytris;
    return out;
}

// STAGES 25..28. Between frame_render and this, the caller emits its own HUD
// into frame_batch_hud() — stage 24 of §4, hard-capped at 250 triangles.
//
// The authoritative image is the RES_W x RES_H target, read back while it is
// still bound. Stages 26-27 still run, so the present path is exercised even
// when the caller only wants the pixels.
export fn frame_present(): i32 {
    // -- 25  HUD flush, insertion order --------------------------------------
    stat_begin(STAT_T_FLUSH_HUD);
    batch_flush(g_win, g_bhud);
    stat_end(STAT_T_FLUSH_HUD);

    let rc: i32 = read_pixels_rect(g_win, 0, 0, g_RES_W, g_RES_H,
                                   FMT_ARGB8888, g_fb, g_RES_W * 4);

    // -- 26  target_end + integer upscale present with the shake offset ------
    stat_begin(STAT_T_PRESENT);
    target_end(g_target);
    target_present(g_target);
    // -- 27  present ---------------------------------------------------------
    sdl_present(g_win);
    stat_end(STAT_T_PRESENT);

    // -- 28  stats -----------------------------------------------------------
    stat_frame_end();
    let out: i32 = rc;
    return out;
}

// ===========================================================================
// 5. THE FORWARDING SURFACE
// ---------------------------------------------------------------------------
// Everything below is a one-line bridge to the module that now owns the state.
// It exists so the FOUR consumers of the frame graph — `tools/shot.hml`,
// `tools/walk.hml`, `tools/benchframe.hml` and `src/game/main.hml` — keep the
// exact import list they already have. None of those four files is owned by
// this task, and more importantly: a refactor whose proof is "the nine
// committed scenes are byte-identical" cannot also rewrite its callers, because
// then two things changed at once and a moved pixel has two suspects.
//
// Hemlock has no transitive re-export (verified: importing a name from a module
// that merely imported it is a hard error), so a wrapper is the mechanism, not
// a preference. Cost: one Hemlock call, ~10 ns per argument (A9b). None of
// these is on a per-element path — the registry setters run at world-build
// time, and `terrain_h`'s per-frame callers (the glow cards) go straight to
// `terrain_render.hml` without passing through here.
//
// WHEN A CONSUMER IS NEXT RE-OWNED, point its import at the module directly and
// delete the wrapper. The wrappers are scaffolding for the split, not a
// permanent second surface.
// ===========================================================================

// ---- the ground field -> terrain_render.hml --------------------------------
export fn terrain_set(p_seed: i32, p_ridge: f64) { t_terrain_set(p_seed, p_ridge); }
export fn terrain_seed(): i32 { let out: i32 = t_terrain_seed(); return out; }
export fn terrain_ridge(): f64 { let out: f64 = t_terrain_ridge(); return out; }
export fn terrain_h(p_x: f64, p_z: f64): f64 {
    let out: f64 = t_terrain_h(p_x, p_z);
    return out;
}
export fn vnoise2(p_x: f64, p_y: f64, p_s: i32): f64 {
    let out: f64 = t_vnoise2(p_x, p_y, p_s);
    return out;
}
export fn h2(p_x: i32, p_y: i32, p_s: i32): f64 {
    let out: f64 = t_h2(p_x, p_y, p_s);
    return out;
}

// ---- the render world: three registries behind one clear ------------------
export fn world_clear() {
    terrain_chunk_clear();
    entity_prop_clear();
    fx_clear();
}

export fn world_chunk_add(p_mesh, p_ox: f64, p_oz: f64,
                          p_cx: f64, p_cy: f64, p_cz: f64, p_r: f64): i32 {
    let out: i32 = terrain_chunk_add(p_mesh, p_ox, p_oz, p_cx, p_cy, p_cz, p_r);
    return out;
}

export fn world_prop_add(p_m0, p_m1, p_m2, p_d1: f64, p_d2: f64, p_rad: f64,
                         p_x: f64, p_y: f64, p_z: f64,
                         p_yaw: f64, p_s: f64,
                         p_tr: i32, p_tg: i32, p_tb: i32,
                         p_shadow: f64, p_tag: i32): i32 {
    let out: i32 = entity_prop_add(p_m0, p_m1, p_m2, p_d1, p_d2, p_rad,
                                   p_x, p_y, p_z, p_yaw, p_s,
                                   p_tr, p_tg, p_tb, p_shadow, p_tag);
    return out;
}

export fn world_fx_add(p_x: f64, p_y: f64, p_z: f64, p_s: f64,
                       p_cell: i32, p_kind: i32,
                       p_r: i32, p_g: i32, p_b: i32, p_a: i32): i32 {
    let out: i32 = fx_add(p_x, p_y, p_z, p_s, p_cell, p_kind,
                          p_r, p_g, p_b, p_a);
    return out;
}

export fn world_chunk_count(): i32 { let out: i32 = terrain_chunk_count(); return out; }
export fn world_chunk_mesh(p_i: i32) { let out = terrain_chunk_mesh(p_i); return out; }
export fn world_prop_count(): i32 { let out: i32 = entity_prop_count(); return out; }
export fn world_prop_tag(p_i: i32): i32 { let out: i32 = entity_prop_tag(p_i); return out; }
export fn world_prop_x(p_i: i32): f64 { let out: f64 = entity_prop_x(p_i); return out; }
export fn world_prop_y(p_i: i32): f64 { let out: f64 = entity_prop_y(p_i); return out; }
export fn world_prop_z(p_i: i32): f64 { let out: f64 = entity_prop_z(p_i); return out; }
export fn world_prop_scale(p_i: i32): f64 { let out: f64 = entity_prop_scale(p_i); return out; }
export fn world_fx_count(): i32 { let out: i32 = fx_count(); return out; }

// ---- LAYER_HUD's surface -> hud.hml ---------------------------------------
export fn frame_set_hud_solid_uv(p_u0: f64, p_v0: f64, p_u1: f64, p_v1: f64) {
    hud_set_solid_uv(p_u0, p_v0, p_u1, p_v1);
}

// ---- stage 23's colours -> postfx_geo.hml ---------------------------------
export fn frame_set_vignette_colour(p_r: i32, p_g: i32, p_b: i32) {
    postfx_set_vignette(p_r, p_g, p_b);
}

export fn frame_set_flash_colour(p_r: i32, p_g: i32, p_b: i32) {
    postfx_set_flash_colour(p_r, p_g, p_b);
}
