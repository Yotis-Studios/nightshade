// settle.hml — the settlement simulation.  Camp -> Village -> Town -> City.
//
// ===========================================================================
// WHAT THIS FILE IS
// ===========================================================================
// The SIM HALF of `docs/design/SETTLEMENT.md`, plus `docs/design/DIRECTION.md`
// §8's newest directive (multiple walkable settlements per world).  It owns:
//
//     §1  site selection, per settlement cell, as a pure f(seed)
//     §2  CIVIC LIGHT (LUX), the entropy gradient, and grid points
//     §3  the tier ladder, promotion, brownout, and the high-water mark
//     §4  the Foundry gate (F1..F4), the output ladder, and the three
//         degradation stages
//     §5  the seven layout passes: green, roads, plot lattice, validity,
//         accretion order, assignment
//     §6  construction pacing: STAKED -> FRAMED -> CLAD -> DONE
//     §8.5 the delta-log rows
//
// It owns NO geometry, NO colour, NO mesh, NO draw call and no wall clock.
// `src/art/hubgen.hml` builds the meshes; this file decides where they stand
// and what state they are in.  SETTLEMENT.md §11.2 argues that split at length
// and the import wall enforces it: `src/sim/**` may not import `src/art/**`, so
// a sim module could never ask hubgen where a building goes.
//
// Imports: `src/core/mathx.hml`, `src/core/config.hml`, `src/sim/worldgen.hml`,
// `src/sim/daycycle.hml`.  Nothing else.  No SDL, no wobbleweed, no
// `@stdlib/random`, no `__clock`.  This module is part of the future
// authoritative server and must link headless (ci_imports.sh R1/R5/R8).
//
// ===========================================================================
// THE ONE SENTENCE
// ===========================================================================
// A seed picks a hollow, the hollow gets a green and three roads, the roads get
// a fixed lattice of 72 plots, and plots fill outward in a fixed order as the
// grid points the player has been earning cross four thresholds — so the town
// is f(seed) in SHAPE and f(light) in EXTENT, and every player on a shard sees
// the same town grow in the same order.
//
// ===========================================================================
// LUX IS NOT A NEW CURRENCY
// ===========================================================================
// `MAGIC_KINETIC.md` §6.1a already ships grid points ("1 point per lit lantern;
// 2 if on a Wick Line; -4 while a Pall stands").  CIVIC LIGHT and grid points
// are THE SAME NUMBER AT TWO RESOLUTIONS:
//
//     grid_points = GRID_LUX / 256          integer division
//
// LUX is an i32 in 1/256 of "one unlinked lit lantern at full wick, at its own
// post".  Integers, not floats, because this goes into `sim_hash` and `sim_hash`
// quantizes floats to 1/16 m — a float field would look round-tripped when it
// had drifted.  Do not build a second light economy.  There is one.
//
// ===========================================================================
// THE LANTERN CONTRACT — settle.hml NEVER OWNS A LANTERN
// ===========================================================================
// SETTLEMENT.md §8.5: "settle.hml only ever READS the lantern set — it must
// never own a lantern, or the two modules will disagree about what is lit."
// `src/sim/lantern.hml` is Wave 4 and does not exist yet, so rather than import
// a file that is not there, the lantern set is INJECTED as a caller-owned flat
// array — the same shape `chunk.hml` uses for its terrain source and
// `move_apply_ex` uses for its solids:
//
//     settle_lanterns_set(st, arr: array<f64>, n: i32)
//         arr is flat, stride SET_LAN_STRIDE = 4:
//             arr[i*4 + 0]  world x
//             arr[i*4 + 1]  world z
//             arr[i*4 + 2]  tier, 1..4          -> radius 40/60/85/120 m
//             arr[i*4 + 3]  wick, 0..256        -> 0 means UNLIT
//
//     >>> INDEX 0 IS THE GREAT LANTERN, at the settlement centre. <<<
//     That is the whole of the contract.  `settle_new` installs a default
//     one-entry array holding an UNLIT tier-0 Great Lantern, so a fresh store is
//     valid and correct (a Camp) before anything is injected.
//
//     settle_palls_set(st, arr: array<f64>, n: i32)
//         stride SET_PALL_STRIDE = 4: x, z, radius m, strength (1024 standing /
//         512 shrunk below half radius / 0 extinguished).
//
// When `lantern.hml` lands, its owner fills these two arrays once per change.
// Nothing in this file has to move.
//
// ===========================================================================
// DETERMINISM
// ===========================================================================
// Every layout decision is a pure function of (seed, cell) through
// `mathx.xhash2` and `worldgen.*`, whose mixing is entirely in u64 (CLAUDE.md
// A13).  There is no RNG STATE anywhere in this file — which is what makes the
// layout REGENERABLE rather than PERSISTABLE, and is why a complete City saves
// in a few hundred bytes (§8.5): the site, the terrace height, the name, the
// roads, all 72 plot positions and yaws, plot validity, the entire accretion
// order and the entire kind assignment are recomputed from the seed on load and
// never written down.
//
// Seed derivation is `^`, NEVER `+`: `seed + 31` THROWS "Integer overflow: i32
// addition" when the world seed is near 2^31.  worldgen.hml's header records
// the same rule and the same reason.
//
// ===========================================================================
// COST — where each pass runs
// ===========================================================================
//   settle_new_at()     ONCE PER SETTLEMENT, at world creation or on load.
//                       Site (81 candidates x 17 heights) + roads (3 x 22 steps
//                       x 3 heights) + plots (72 x 4 corners).  Off every frame
//                       path.  Bar: SETTLEMENT.md A6, <= 25 ms.
//   settle_step()       ONE TICK IN 60, at frame-graph step (h).  Re-integrates
//                       SET_SLICE = 8 lanterns per call on a rotating slice, so
//                       a 200-lantern grid fully refreshes in 25 s and never
//                       costs more than 8 distance evaluations per second.
//                       Bar: A5, <= 0.05 ms per tick, <= 0.001 ms/frame.
//   settle_lux_at()     O(lanterns).  Point queries only — never per vertex.
//
// ===========================================================================
// DEVIATIONS FROM SETTLEMENT.md, EACH ARGUED
// ===========================================================================
// Flagged here rather than silently applied (CLAUDE.md §10.5).
//
// D1  ROAD LENGTH.  §5.3 says 12 steps of 8 m (96 m) and §5.4 says 12 plots at
//     a 14 m pitch (168 m of frontage).  Those two cannot both be true: eight
//     of the twelve slots would fall off the end of the road.  The plot lattice
//     is what §5.4 calls "the lattice never runs out and therefore never needs
//     re-planning", so the ROAD is what has to give: the polyline is generated
//     for SET_ROAD_STEPS = 22 steps (176 m), by exactly the algorithm §5.3
//     specifies, and `SET_ROAD_MESH_STEPS = 12` is exported as the DRAWN extent
//     so §5.3's 96 m of road mesh and §7.5's 12 in-wedge segments both stand.
//     Same algorithm, same step size, same pull — only run further.
//
// D2  PLOT YAW.  §5.4 writes "yaw = road segment bearing + 90 deg * side".  With
//     side in {0, 1} that puts the two sides of one street at RIGHT ANGLES to
//     each other.  Implemented as "road bearing + 90 deg, flipped 180 deg on the
//     far side" — which is the sentence's intent (`settle_plot_yaw` is the
//     FACING direction and every building faces the road by construction) and
//     is what the task brief states.
//
// D3  SITE SAMPLES.  §1.3 counts 21 height samples per candidate: centre, an
//     8-ring at 20 m, an 8-ring at 48 m, "4 diagonal probes at r = 34 m".  No
//     criterion C1..C8 consumes the 34 m probes.  17 samples are taken, not 21,
//     and the site pass is correspondingly cheaper.  Nothing is scored on data
//     that was never read.
//
// D4  F4, THE FEEDER LINE.  §4.1 asks for ">= 6 lit lanterns forming an unbroken
//     Wick chain from the Great Lantern to the Foundry's own post".  Read as
//     "the SHORTEST path must be >= 6 nodes long" the gate is UNSATISFIABLE:
//     the accretion order puts the Foundry on a plot inside the 176 m road
//     lattice, well within one 90 m Wick link of the green, so the shortest
//     chain is 2 nodes and no amount of player effort makes it 6.  Implemented
//     as: the Great Lantern and the Foundry post must lie in the SAME connected
//     lit Wick component, AND that component must contain >= SET_FEEDER_MIN = 6
//     lit lanterns.  That keeps every property §4.1 asks for — an unbroken
//     chain, a route the player walks and defends, a graph and not a global
//     average — and `settle_feeder_node` returns the shortest GL -> Foundry
//     chain node by node, which is the HUD route marker §8.1 asks for.
//
// D5  BUILDING COUNT.  §3.3's own tables give 2 (Camp) + 7 (Village) + 8 (Town,
//     with Pip's Stall a green fixture at 14 tris rather than a plot building,
//     which is what makes §6.2's "8" agree with §3.3) + 11 (City) = 28
//     buildings.  §8.5 says "24 buildings x 4 i32 = 384 bytes for a complete
//     City".  28 rows is 448 bytes.  Still a few hundred bytes; the count is 28.
//
// D6  CORE_LUX FLOOR.  §3.2's hard floor of 512 exists "because the Great
//     Lantern has never gone out".  At CAMP it demonstrably has — §3.1 gives
//     CAMP a CORE_LUX floor of 0 and an UNLIT Great Lantern.  The floor is
//     therefore applied from VILLAGE upward (on `tier_ever`, so it can never be
//     lost), which is what makes the Camp -> Village step mean something.
//
// D7  ACCRETION AND ROAD AVAILABILITY.  §5.3 introduces the Wick Road at
//     Village and the Back Lane at Town, but §5.6's order key sorts by ring
//     first — so a ring-0 Back Lane plot would be assigned at Village, on a road
//     that does not exist yet.  Assignment therefore skips plots whose road is
//     not yet open at that building's tier.  The order itself is untouched and
//     is still pure f(seed); only the cursor walks past unavailable plots.
// ===========================================================================

import { clampi, floori, xhash2 } from "../core/mathx.hml";
import { g_LANTERN_R_T1, g_LANTERN_R_T2, g_LANTERN_R_T3, g_LANTERN_R_T4,
         g_WICKLINE_M, g_LANTERN_TIERS } from "../core/config.hml";
import { DAY_TICKS } from "./daycycle.hml";
import { WG_BIOME_FEN, WG_POI_RUIN, WG_POI_CARAVAN,
         WG_SITE_CELL_M, WG_SITE_MIN_SEP_M, WG_SITE_CANDIDATES,
         worldgen_height, worldgen_temp, worldgen_moist,
         worldgen_relief_tm, worldgen_height_rel, worldgen_biome_tmd,
         worldgen_poi_roll, worldgen_block_of,
         worldgen_lantern_x, worldgen_lantern_z,
         worldgen_site_cell_of, worldgen_site_cand_x, worldgen_site_cand_z,
         worldgen_site_occupied_roll } from "./worldgen.hml";

// ===========================================================================
// 1.  THE VOCABULARY
// ===========================================================================

// ---- tiers ---------------------------------------------------------------
export let SET_TIER_CAMP: i32    = 0;
export let SET_TIER_VILLAGE: i32 = 1;
export let SET_TIER_TOWN: i32    = 2;
export let SET_TIER_CITY: i32    = 3;
export let SET_TIER_COUNT: i32   = 4;

// SETTLEMENT.md §3.1, typed in as literals because they ARE the design
// (CLAUDE.md rule 5: pin design anchors with a literal, never with a config
// read that a later edit can move without anyone noticing).
export let SET_RING_CAMP_M: f64    = 64.0;
export let SET_RING_VILLAGE_M: f64 = 120.0;
export let SET_RING_TOWN_M: f64    = 200.0;
export let SET_RING_CITY_M: f64    = 320.0;

export let SET_PTS_VILLAGE: i32 = 10;
export let SET_PTS_TOWN: i32    = 32;
export let SET_PTS_CITY: i32    = 72;

export let SET_CORE_VILLAGE: i32 = 512;
export let SET_CORE_TOWN: i32    = 1024;
export let SET_CORE_CITY: i32    = 2048;

export let SET_GL_VILLAGE: i32 = 1;
export let SET_GL_TOWN: i32    = 2;
export let SET_GL_CITY: i32    = 4;

// ---- the field -----------------------------------------------------------
export let SET_LUX_PER_POINT: i32 = 256;    // grid_points = GRID_LUX / 256
export let SET_CL_MAX: i32        = 4096;   // 16 lantern-equivalents.  §11.4:
                                            // a consequence of the GDD's radii,
                                            // not an arbitrary clamp.
export let SET_WICK_FULL: i32     = 256;
export let SET_WICK_SAFE: i32     = 128;    // >= this and no enemy can snuff it
export let SET_GREEN_R_M: f64     = 16.0;   // keep-out, and the decay-0 zone
export let SET_CORE_FLOOR: i32    = 512;    // D6

// Entropy, §2.3.  decay_per_real_hour = MAX - floor(SPAN * min(1, LUX/SAT)).
export let SET_DECAY_MAX: i32     = 16;
export let SET_DECAY_SPAN: i32    = 14;
export let SET_DECAY_SAT_LUX: i32 = 2048;

// ---- lantern injection ---------------------------------------------------
export let SET_LAN_STRIDE: i32  = 4;    // x, z, tier, wick
export let SET_PALL_STRIDE: i32 = 4;    // x, z, radius, strength
export let SET_PALL_STAND: i32  = 1024; // MAGIC_KINETIC §6.1a: -4 grid points
export let SET_PALL_SHRUNK: i32 = 512;
export let SET_SLICE: i32       = 8;    // lanterns re-integrated per settle tick
export let SET_STEP_EVERY: i32  = 60;   // one settle tick in 60 sim ticks

// ---- the plot lattice, §5.3 / §5.4 ---------------------------------------
export let SET_ROADS: i32          = 3;
export let SET_PLOT_SLOTS: i32     = 12;
export let SET_PLOT_SIDES: i32     = 2;
export let SET_PLOTS: i32          = 72;   // ROADS * SIDES * SLOTS
export let SET_PLOT_W_M: f64       = 12.0; // along the road
export let SET_PLOT_D_M: f64       = 10.0; // across it
export let SET_PLOT_PITCH_M: f64   = 14.0;
export let SET_PLOT_A0_M: f64      = 22.0; // arc length of slot 0.  Chosen so the
                                           // NEAREST CORNER of slot 0 clears the
                                           // 16 m green: (22-6)^2 + 4^2 = 272 > 256.
export let SET_PLOT_LATERAL_M: f64 = 9.0;  // 2 m road half-width + 2 m verge + 5 m
export let SET_PLOT_RANGE_M: f64   = 2.4;  // §5.5 max corner height range
export let SET_RING_BUCKET_M: f64  = 24.0; // §5.6 accretion ring width

export let SET_ROAD_STEP_M: f64    = 8.0;
export let SET_ROAD_STEPS: i32     = 22;   // D1.  176 m, reaching plot slot 11.
export let SET_ROAD_MESH_STEPS: i32 = 12;  // §5.3's 96 m of DRAWN road deck
export let SET_ROAD_PTS: i32       = 23;   // SET_ROAD_STEPS + 1
export let SET_ROAD_FAN_RAD: f64   = 0.3490658503988659;  // 20 degrees
export let SET_ROAD_PULL: f64      = 0.40;                // §5.3's 40 %
export let SET_BACKLANE_JIT_RAD: f64 = 0.4363323129985824; // +/- 25 degrees

