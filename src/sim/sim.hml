// ===========================================================================
//  1.  CONSTANTS
// ===========================================================================

// The ten stages of ARCHITECTURE §4.3, as integers, in their documented order.
// These ids are API: `sim.order` holds them and the probe asserts the sequence
// against these literals, not against the array's own contents.
export let SIM_STAGE_COMMANDS: i32 = 0;   // a
export let SIM_STAGE_MOVEMENT: i32 = 1;   // b
export let SIM_STAGE_WEAPONS: i32  = 2;   // c
export let SIM_STAGE_PROJ: i32     = 3;   // d
export let SIM_STAGE_AI: i32       = 4;   // e
export let SIM_STAGE_DAMAGE: i32   = 5;   // f
export let SIM_STAGE_INTERACT: i32 = 6;   // g
export let SIM_STAGE_WORLD: i32    = 7;   // h
export let SIM_STAGE_HISTORY: i32  = 8;   // i
export let SIM_STAGE_EFFECTS: i32  = 9;   // j
export let SIM_STAGE_COUNT: i32    = 10;

// Player slots this sim can hold.  v1 plays one, but the command queue, the
// per-slot PredictedState and the "player-slot order, then seq" rule only mean
// something with more than one, and a rule that is never exercised is a rule
// that is already broken.
export let SIM_PLAYERS_DEFAULT: i32 = 4;

// Commands buffered per player.  NETWORKING's client sends one per tick and the
// server consumes one per tick; the buffer absorbs jitter.  Overflow DROPS THE
// OLDEST and counts it — dropping the newest would make a laggy client
// permanently stale instead of briefly behind.
export let SIM_CMD_QUEUE: i32 = 8;

// The cosmetic queue `sim_effects` fills.  Client-only, never hashed, never
// replicated, always zero while replaying.
export let SIM_FX_CAP: i32 = 128;

export let SIM_FX_SOUND: i32     = 0;
export let SIM_FX_PARTICLE: i32  = 1;
export let SIM_FX_SHAKE: i32     = 2;
export let SIM_FX_HITMARKER: i32 = 3;
export let SIM_FX_FLASH: i32     = 4;
export let SIM_FX_NUMBER: i32    = 5;
export let SIM_FX_KIND_COUNT: i32 = 6;

// Interaction reach, metres.  OWNED HERE, NOT A GDD NUMBER — GDD §8 says "you
// reach the lantern post" and never gives a distance.  The channel DURATION is
// the GDD's (`g_LANTERN_CHANNEL_S`, 2.5 s) and so is the XP (`XPS_LANTERN`,
// 350).  When W5-6 builds `lantern.hml` it owns this constant and this file
// should import it.
export let SIM_INTERACT_R_M: f64 = 2.5;

// Lantern lit state rides the replicated `anim` field: 0 unlit, 1 lit.  Using
// an existing replicated field costs zero bytes on the wire and means the
// client learns a lantern is lit through the same path as everything else.
export let SIM_LANTERN_UNLIT: i32 = 0;
export let SIM_LANTERN_LIT: i32   = 1;

// A stall longer than this is clamped rather than simulated (ARCHITECTURE §3's
// spiral-of-death clamp).  250 ms at 60 Hz is 15 ticks — the most `sim_step`
// can ever be asked to run from one frame.
export let SIM_MAX_FRAME_MS: f64 = g_FRAME_CLAMP_MS;
export let SIM_MAX_TICKS_PER_FRAME: i32 = 15;

export let SIM_MISS: i32 = -1;

// ---------------------------------------------------------------------------
// CHUNKS GENERATED INSIDE ONE TICK.  This is the budget line, not a tuning dial.
// ---------------------------------------------------------------------------
// MEASURED, compiled -O1, headless, one player sprinting 960 m in a straight
// line (7200 ticks, seed 1337, `tools/probe_budget.hml`):
//
//     ticks that did NOT cross a chunk boundary : mean 0.121 ms  worst 0.233 ms
//     ticks that DID                            : mean 3.354 ms  worst 3.766 ms
//
// 34 crossings of 7200 ticks — 0.47 % of ticks carrying the entire worst case,
// against a 2.0 ms sim budget (ARCHITECTURE §8).  32 of those 34 ticks were over
// budget; nothing else in the run came within 8x of it.  The cause was
// `stage_world` calling `chunk_pin_ring`, which calls `chunk_get` on all 25 cells
// of the RING_RADIUS=2 ring and therefore GENERATES every cell the crossing
// brought into view — ~6 chunks at ~0.75 ms each, synchronously, in one tick.
//
// This is also why the scripted demo never showed it and the gate did: the demo
// walks 40 m to the lantern and stops, which crosses one boundary in 14 396
// frames (worst 1.2 ms).  A player sprints, and crosses one every ~4 s.
//
// The renderer already amortises its half of this (`g_BUDGET_CHUNKGEN_MS` is
// documented "amortised, per frame", and `main.hml` builds 2 chunk meshes a
// frame).  The sim did not amortise its half.  That asymmetry was the whole
// defect: nothing about heightfield generation needs to finish in the tick that
// discovered it was needed.
//
// WHY DEFERRING IS SAFE, AND IT IS A MARGIN ARGUMENT, NOT A HOPE.
//   The ring's radius is 2 chunks = at least 64 m of resident terrain in every
//   direction.  The cells a crossing newly needs are the LEADING EDGE of that
//   ring, so they are 64-96 m away, and at the sprint speed that produced the
//   measurement above the player needs ~4 s (240 ticks) to reach them.  The
//   walk below is INNER-FIRST (Chebyshev distance order), so the player's own
//   chunk and its eight neighbours are pinned before anything is generated, and
//   the ring completes in at most `ring cells missing / SIM_STREAM_PER_TICK`
//   ticks.  At 1/tick the worst crossing (a diagonal, 9 new cells) is whole
//   again in 9 ticks = 150 ms, which is 27x sooner than the player can arrive.
//
//   Determinism is untouched: the schedule is a pure function of tick order and
//   world state, never of a clock, and chunk contents are a pure function of
//   (seed, cx, cz), so WHEN a cell is generated cannot change WHAT it contains.
//   Verified, not asserted: `server_hash` after 10 000 and 20 000 ticks of an
//   identical command stream is BIT-IDENTICAL to the eager policy's on four
//   seed/route combinations, and `chunk_sample_miss_count` stays 0.  See
//   `tools/probe_budget.hml` section C.
//
// WHY IT IS 1, AND WHY 2 IS NOT A CHOICE.  Measured, same 7200-tick sprint, one
// binary per value, `tools/probe_budget.hml` section A:
//
//                            worst tick   ticks over 2.0 ms   generating ticks
//     eager (what was here)    3.766 ms          32           34 @ mean 3.354
//     SIM_STREAM_PER_TICK=2    2.122 ms           1           97 @ mean 1.335
//     SIM_STREAM_PER_TICK=1    1.066 ms           0          161 @ mean 0.872
//
//   2 STILL BREAKS THE BUDGET — 2.122 ms — because one chunk of worldgen is
//   ~0.75 ms on this box, so two of them plus a tick of sim does not fit in
//   2.0 ms.  1 is therefore the only value that holds, and it holds with 47 % of
//   the budget free.  This is a budget line, not a dial: raising it requires
//   making chunk generation cheaper first, and THAT is the next lever if this
//   ever needs more room (it lives in `chunk.hml` / `worldgen.hml`, not here).
export let SIM_STREAM_PER_TICK: i32 = 1;

// ===========================================================================
//  2.  THE ACCUMULATOR  (clock-free, and that is the whole point)
// ===========================================================================
//  `wobbleweed/src/time.hml` has one of these, and it is correct, and this file
//  MAY NOT IMPORT IT: wobbleweed's version samples SDL's performance counter,
//  and `src/sim/**` may not link SDL or read a wall clock at all.  So the sim
//  owns the arithmetic and `src/game/main.hml` owns the clock:
//
//      let ms = clock_ms_between(prev, clock_now());   // main.hml, wobbleweed
//      let n  = sim_accum_advance(g_acc, ms);          // here, pure
//      while (i < n) { sim_step(g_world, g_tick); g_tick++; i++; }
//      let alpha = sim_accum_alpha(g_acc);
//
//  The arithmetic is deliberately identical to wobbleweed's, for the reasons
//  written there and re-verified here:
//
//    * the tick index is DERIVED from a running total, never accumulated by
//      repeated subtraction — `total ticks == floor(total_ms / tick_ms)` then
//      holds exactly, forever, instead of drifting one tick per hour;
//    * `total_ms` is summed with Kahan compensation, because naive summation
//      loses a whole tick across 200 000 frames;
//    * `eps` is `tick_ms * 1e-9`, which repairs 250.0 / (1000.0/60.0) ==
//      14.999999999999998 without ever firing a tick early.
//
//  The one thing this version adds is a HARD CEILING on ticks per call.  The
//  clamp bounds the milliseconds, but a caller that passes an un-clamped 30 s
//  (a debugger breakpoint, a laptop lid) would otherwise ask for 1800 steps in
//  one frame and hang for 0.3 s.  `SIM_MAX_TICKS_PER_FRAME` is the second wall,
//  and the debt it discards is FORGIVEN (the total is rebased) rather than
//  carried, because carrying it is the death spiral by another name.

export fn sim_accum_new(): object {
    let a: object = {
        tick_ms: g_TICK_MS,
        eps: g_TICK_MS * 0.000000001,
        clamp_ms: SIM_MAX_FRAME_MS,
        max_ticks: SIM_MAX_TICKS_PER_FRAME,
        total_ms: 0.0,
        comp: 0.0,
        ticks: 0,
        acc: 0.0,
        frame_ms: 0.0,
        raw_ms: 0.0,
        stalls: 0,
        forgiven: 0
    };
    let out: object = a;
    return out;
}

export fn sim_accum_reset(p_a: object) {
    let a: object = p_a;
    a.total_ms = 0.0;
    a.comp = 0.0;
    a.ticks = 0;
    a.acc = 0.0;
    a.frame_ms = 0.0;
    a.raw_ms = 0.0;
    a.stalls = 0;
    a.forgiven = 0;
}

export fn sim_accum_set_clamp_ms(p_a: object, p_ms: f64) {
    let a: object = p_a;
    let ms: f64 = p_ms;
    if (ms > 0.0) { a.clamp_ms = ms; }
}

// Feed a measured millisecond delta; get back the number of fixed ticks due.
// The caller runs exactly that many `sim_step`s and no more.
export fn sim_accum_advance(p_a: object, p_ms: f64): i32 {
    let a: object = p_a;
    let ms: f64 = p_ms;
    if (ms < 0.0) { ms = 0.0; }
    a.raw_ms = ms;
    let cap: f64 = a.clamp_ms;
    if (ms > cap) { ms = cap; a.stalls = a.stalls + 1; }
    a.frame_ms = ms;

    let prev_total: f64 = a.total_ms;
    let comp: f64 = a.comp;
    let y: f64 = ms - comp;
    let total: f64 = prev_total + y;
    a.comp = (total - prev_total) - y;
    a.total_ms = total;

    let tick: f64 = a.tick_ms;
    let target: i64 = i64((total + a.eps) / tick);
    let issued: i64 = a.ticks;
    let n: i32 = i32(target - issued);

    let maxn: i32 = a.max_ticks;
    if (n > maxn) {
        // Forgive the excess instead of carrying it.  Rebasing the total keeps
        // the derived-index invariant true for every FUTURE frame; carrying it
        // would ask for the same overrun again next frame, and the frame after.
        let dropped: i32 = n - maxn;
        n = maxn;
        target = issued + i64(n);
        a.total_ms = f64(target) * tick;
        a.comp = 0.0;
        total = a.total_ms;
        a.forgiven = a.forgiven + dropped;
    }

    a.ticks = target;
    let acc: f64 = total - f64(target) * tick;
    if (acc < 0.0) { acc = 0.0; }
    a.acc = acc;
    let out: i32 = n;
    return out;
}

// The renderer's interpolation factor: how far it is between the last completed
// tick and the next.  Always in [0, 1).  This is `rsnap_build`'s third argument.
export fn sim_accum_alpha(p_a: object): f64 {
    let a: object = p_a;
    let t: f64 = a.acc / a.tick_ms;
    if (t < 0.0) { t = 0.0; }
    if (t >= 1.0) { t = 0.999999999; }
    let out: f64 = t;
    return out;
}

export fn sim_accum_ticks(p_a: object): i64 { let a: object = p_a; let o: i64 = a.ticks; return o; }
export fn sim_accum_stalls(p_a: object): i32 { let a: object = p_a; let o: i32 = a.stalls; return o; }
export fn sim_accum_forgiven(p_a: object): i32 { let a: object = p_a; let o: i32 = a.forgiven; return o; }
export fn sim_accum_frame_ms(p_a: object): f64 { let a: object = p_a; let o: f64 = a.frame_ms; return o; }
export fn sim_accum_raw_ms(p_a: object): f64 { let a: object = p_a; let o: f64 = a.raw_ms; return o; }
export fn sim_accum_total_ms(p_a: object): f64 { let a: object = p_a; let o: f64 = a.total_ms; return o; }
export fn sim_accum_residual_ms(p_a: object): f64 { let a: object = p_a; let o: f64 = a.acc; return o; }

// ===========================================================================
//  3.  CONSTRUCTION
// ===========================================================================

fn zeros_i(p_n: i32): array<i32> {
    let n: i32 = p_n;
    let a: array<i32> = [];
    let i: i32 = 0;
    while (i < n) { a.push(0); i++; }
    let out: array<i32> = a;
    return out;
}

fn zeros_f(p_n: i32): array<f64> {
    let n: i32 = p_n;
    let a: array<f64> = [];
    let i: i32 = 0;
    while (i < n) { a.push(0.0); i++; }
    let out: array<f64> = a;
    return out;
}

// The pin ring's cell offsets, ordered by CHEBYSHEV DISTANCE from the centre:
// (0,0) first, then the eight cells at distance 1, then the sixteen at
// distance 2.  Built once, never rebuilt, and pure in `p_r` — which is what
// makes the streaming walk's order API rather than an accident of loop nesting.
// Inner-first is the whole safety argument: the walk pins everything within one
// chunk of the player BEFORE it generates anything, so a bounded budget can
// never leave the ground under the player's feet unresident.
fn ring_offsets(p_r: i32, p_axis: i32): array<i32> {
    let r: i32 = p_r;
    let axis: i32 = p_axis;             // 0 = dx, 1 = dz
    let a: array<i32> = [];
    let d: i32 = 0;
    while (d <= r) {
        let dz: i32 = 0 - d;
        while (dz <= d) {
            let dx: i32 = 0 - d;
            while (dx <= d) {
                let ax: i32 = dx;
                if (ax < 0) { ax = 0 - ax; }
                let az: i32 = dz;
                if (az < 0) { az = 0 - az; }
                let cheb: i32 = ax;
                if (az > cheb) { cheb = az; }
                if (cheb == d) {
                    if (axis == 0) { a.push(dx); } else { a.push(dz); }
                }
                dx++;
            }
            dz++;
        }
        d++;
    }
    let out: array<i32> = a;
    return out;
}

// A world with a simulation attached, at the shipping caps.
export fn sim_new(p_seed: i32): object {
    let out: object = sim_new_cap(g_MAX_ENTS, SIM_PLAYERS_DEFAULT, p_seed);
    return out;
}

// EVERYTHING allocates here.  `sim_step` allocates nothing, ever: no object
// literal, no array growth, no string.  The probe proves it by stepping 10 000
// ticks and watching RSS.
export fn sim_new_cap(p_cap: i32, p_players: i32, p_seed: i32): object {
    let cap: i32 = p_cap;
    if (cap < 8) { cap = 8; }
    let np: i32 = p_players;
    if (np < 1) { np = 1; }

    let w: object = world_new_cap(cap);
    world_set_seed(w, p_seed);
    world_set_tick(w, 0);

    // ---- per-player state, one flat array per player ----------------------
    let ps_all: array = [];
    let cmd_all: array = [];
    let q_all: array = [];
    let prog_all: array = [];
    let i: i32 = 0;
    while (i < np) {
        ps_all.push(ps_new());
        cmd_all.push(cmd_new());
        prog_all.push(prog_new());
        let q: array = [];
        let k: i32 = 0;
        while (k < SIM_CMD_QUEUE) { q.push(cmd_new()); k++; }
        q_all.push(q);
        i++;
    }

    // ---- combat needs the weapon table injected, not imported -------------
    // `combat.hml` deliberately does not import `weapons.hml`: they were built
    // in the same sub-wave, and a content dependency inside a wave is what the
    // WAVE-CONSTRUCTION RULE forbids.  The integrator is the correct place to
    // tie them together, and this is the only place it happens.
    let cx: object = combat_new_cap(512);
    combat_set_weapon_source(cx, wpn_dmg_at, wpn_hs_mult, wpn_pellets, wpn_spread);

    let pj: object = proj_new_cap(32, 64, 32);
    proj_set_combat(pj, cx);

    // A placeholder chunk store with no generator installed.  `chunk_get`
    // refuses without a source, so terrain reads MISS and the sim runs flat and
    // obviously unfinished rather than crashing.  `sim_set_chunks` replaces it
    // with the real one; the boot path owns the worldgen adapter because
    // `chunk.hml` takes an injected source (ARCHITECTURE §5.4b).
    let cs: object = chunk_store_new_cap(1, 1, p_seed);

    let s: object = {
        ver: 1,
        players: np,
        cap: cap,
        prev_tick: -1,
        steps: 0,

        // ---- the stage order.  DATA, not control flow. -------------------
        order: zeros_i(SIM_STAGE_COUNT),
        swaps: 0,

        // ---- the eight Wave-4a modules -----------------------------------
        move_ps: ps_all,
        solids: move_solids_new(),
        wpn: wpn_state_new(np),
        cx: cx,
        proj: pj,
        ai: ai_new_cap(cap),
        dir: director_new(),
        prog: prog_all,
        item: loot_new_item(),

        // ---- support ------------------------------------------------------
        hist: history_new(cap),
        cs: cs,
        has_cs: 0,
        rng: rng_new(),
        wpn_out: zeros_f(4),

        // ---- the command pipeline ----------------------------------------
        cmd: cmd_all,           // the latched command, one per player
        queue: q_all,           // the pending ring, one per player
        q_head: zeros_i(np),
        q_n: zeros_i(np),
        q_seq: zeros_i(np),     // last applied seq, per player
        has_cmd: zeros_i(np),
        pslot_id: zeros_i(np),  // entity id of each player slot, or ID_NONE
        chan_t: zeros_f(np),    // lantern channel progress, seconds
        move_ev: zeros_i(np),
        p_dead: zeros_i(np),    // edge latch: prog_on_death fires exactly once

        // ---- day cycle / streaming ---------------------------------------
        phase: 0,
        day_t: 0.0,
        horn: 0,
        tier: 0,
        ccx: 2147483647,
        ccz: 2147483647,
        streams: 0,
        // ---- the bounded streaming walk (SIM_STREAM_PER_TICK) -------------
        ring_dx: ring_offsets(g_RING_RADIUS, 0),
        ring_dz: ring_offsets(g_RING_RADIUS, 1),
        ring_n: 0,              // set below, from the table's own length
        ring_i: 0,              // resume index; == ring_n means "ring complete"
        streamed: 0,            // chunks generated by the walk, ever
        stream_tick_n: 0,       // ticks that generated at least one
        stream_worst: 0,        // most chunks generated in any one tick

        // ---- the cosmetic queue.  Never hashed.  Zero while replaying. ----
        fx_kind: zeros_i(SIM_FX_CAP),
        fx_a: zeros_i(SIM_FX_CAP),
        fx_b: zeros_i(SIM_FX_CAP),
        fx_x: zeros_f(SIM_FX_CAP),
        fx_y: zeros_f(SIM_FX_CAP),
        fx_z: zeros_f(SIM_FX_CAP),
        fx_n: 0,
        fx_dropped: 0,
        fx_total: 0,

        // ---- counters.  Every refusal is visible. ------------------------
        cmds_queued: 0,
        cmds_applied: 0,
        cmds_dropped: 0,
        cmds_stale: 0,
        cmds_bad: 0,
        cmds_missing: 0,
        shots: 0,
        reloads: 0,
        swaps_wpn: 0,
        // W7-3. A client asked to hold a gun it does not own and was refused.
        // Not saved: it is a counter about the WIRE, not about the world.
        swaps_denied: 0,
        spawns_req: 0,
        spawns_ok: 0,
        deaths: 0,
        player_deaths: 0,
        ai_attacks: 0,
        adds_spawned: 0,
        pickups: 0,
        lanterns_lit: 0,
        loot_rolls: 0,
        loot_hash: 0,
        last_rarity: RARITY_NONE,
        fall_hits: 0,
        ground_miss: 0
    };

    let rdx = s.ring_dx;
    s.ring_n = rdx.length;

    // The identity order.  `sim_stage_swap` is the only thing that changes it.
    let ord = s.order;
    let j: i32 = 0;
    while (j < SIM_STAGE_COUNT) { ord[j] = j; j++; }

    let pid = s.pslot_id;
    let k2: i32 = 0;
    while (k2 < np) { pid[k2] = ID_NONE; k2++; }

    director_reset(s.dir, p_seed, 0);

    w.sim = s;
    let out: object = w;
    return out;
}

// Install the real heightfield.  The caller owns the store and the injected
// worldgen adapter (ARCHITECTURE §5.4b); the sim only reads it.
export fn sim_set_chunks(p_w: object, p_cs: object): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    s.cs = p_cs;
    s.has_cs = 1;
    proj_set_chunks(s.proj, p_cs);
    s.ccx = 2147483647;
    s.ccz = 2147483647;
    let out: i32 = 1;
    return out;
}

export fn sim_of(p_w: object): object { let w: object = p_w; let s: object = w.sim; return s; }
export fn sim_players(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.players; return o; }
export fn sim_steps(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.steps; return o; }
export fn sim_combat(p_w: object): object { let w: object = p_w; let s: object = w.sim; let o: object = s.cx; return o; }
export fn sim_events(p_w: object): object { let w: object = p_w; let s: object = w.sim; let o: object = combat_events(s.cx); return o; }
export fn sim_projectiles(p_w: object): object { let w: object = p_w; let s: object = w.sim; let o: object = s.proj; return o; }
export fn sim_ai(p_w: object): object { let w: object = p_w; let s: object = w.sim; let o: object = s.ai; return o; }
export fn sim_director(p_w: object): object { let w: object = p_w; let s: object = w.sim; let o: object = s.dir; return o; }
export fn sim_history(p_w: object): object { let w: object = p_w; let s: object = w.sim; let o: object = s.hist; return o; }
export fn sim_chunks(p_w: object): object { let w: object = p_w; let s: object = w.sim; let o: object = s.cs; return o; }
export fn sim_weapon_state(p_w: object): array { let w: object = p_w; let s: object = w.sim; let o: array = s.wpn; return o; }
export fn sim_phase(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.phase; return o; }
export fn sim_day_t(p_w: object): f64 { let w: object = p_w; let s: object = w.sim; let o: f64 = s.day_t; return o; }
export fn sim_tier(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.tier; return o; }

// Per-player handles.  `p_pslot` is the POSITIONAL player slot, 1..players,
// exactly as `world_spawn_player` defines it (a player's id IS its slot).
export fn sim_player_id(p_w: object, p_pslot: i32): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let k: i32 = p_pslot - 1;
    if (k < 0 || k >= s.players) { let bad: i32 = ID_NONE; return bad; }
    let a = s.pslot_id;
    let out: i32 = a[k];
    return out;
}

export fn sim_predicted(p_w: object, p_pslot: i32): array<f64> {
    let w: object = p_w;
    let s: object = w.sim;
    let k: i32 = p_pslot - 1;
    if (k < 0) { k = 0; }
    if (k >= s.players) { k = s.players - 1; }
    let a = s.move_ps;
    let out: array<f64> = a[k];
    return out;
}

export fn sim_progression(p_w: object, p_pslot: i32): array {
    let w: object = p_w;
    let s: object = w.sim;
    let k: i32 = p_pslot - 1;
    if (k < 0) { k = 0; }
    if (k >= s.players) { k = s.players - 1; }
    let a = s.prog;
    let out: array = a[k];
    return out;
}

export fn sim_command(p_w: object, p_pslot: i32): object {
    let w: object = p_w;
    let s: object = w.sim;
    let k: i32 = p_pslot - 1;
    if (k < 0) { k = 0; }
    if (k >= s.players) { k = s.players - 1; }
    let a = s.cmd;
    let out: object = a[k];
    return out;
}

// ---- counters ---------------------------------------------------------------
