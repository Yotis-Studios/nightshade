export fn sim_stat_cmds_dropped(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.cmds_dropped; return o; }
export fn sim_stat_cmds_stale(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.cmds_stale; return o; }
export fn sim_stat_cmds_bad(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.cmds_bad; return o; }
export fn sim_stat_cmds_missing(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.cmds_missing; return o; }
export fn sim_stat_shots(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.shots; return o; }
