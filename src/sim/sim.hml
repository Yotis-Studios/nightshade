export fn sim_stat_swaps_denied(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.swaps_denied; return o; }

// ---------------------------------------------------------------------------
// W7-3. THE OWNED SET, AND THE GRANT EDGE, FOR ONE PLAYER SLOT.
// ---------------------------------------------------------------------------
// Thin readers over `weapons.hml`, so that `server.hml` and the probes name a
// PLAYER SLOT (1..64) rather than computing `(pslot - 1) * WS_FIELDS` at yet
// another call site. Every one of those multiplications is a place a future
// widening of `WS_FIELDS` could be missed.
export fn sim_wpn_owned(p_w: object, p_pslot: i32, p_wid: i32): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let st: array = s.wpn;
    let out: i32 = wpn_owned(st, (p_pslot - 1) * WS_FIELDS, p_wid);
    return out;
}
export fn sim_wpn_own_mask(p_w: object, p_pslot: i32): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let st: array = s.wpn;
    let out: i32 = wpn_own_mask(st, (p_pslot - 1) * WS_FIELDS);
    return out;
}
export fn sim_wpn_force_w(p_w: object, p_pslot: i32): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let st: array = s.wpn;
    let out: i32 = wpn_force_w(st, (p_pslot - 1) * WS_FIELDS);
    return out;
}
export fn sim_wpn_force_n(p_w: object, p_pslot: i32): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let st: array = s.wpn;
    let out: i32 = wpn_force_n(st, (p_pslot - 1) * WS_FIELDS);
    return out;
}
export fn sim_stat_deaths(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.deaths; return o; }
export fn sim_stat_player_deaths(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.player_deaths; return o; }
export fn sim_player_dead(p_w: object, p_pslot: i32): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let k: i32 = p_pslot - 1;
    if (k < 0 || k >= s.players) { let bad: i32 = 0; return bad; }
    let a = s.p_dead;
    let out: i32 = a[k];
    return out;
}
export fn sim_stat_spawns(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.spawns_ok; return o; }
export fn sim_stat_ai_attacks(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.ai_attacks; return o; }
export fn sim_stat_pickups(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.pickups; return o; }
export fn sim_stat_lanterns(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.lanterns_lit; return o; }
export fn sim_stat_loot_rolls(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.loot_rolls; return o; }
export fn sim_stat_last_rarity(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.last_rarity; return o; }
export fn sim_stat_fall_hits(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.fall_hits; return o; }
export fn sim_stat_ground_miss(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.ground_miss; return o; }
export fn sim_stat_streams(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.streams; return o; }
// The streaming walk, made visible.  `sim_stat_stream_worst` is the one that
// matters: it is the most chunks any single tick generated, and if it ever
// exceeds SIM_STREAM_PER_TICK outside the cold first fill, the bound leaked.
export fn sim_stat_streamed(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.streamed; return o; }
// NOT `sim_stat_stream_ticks`.  `tools/probe_sim_core.hml`'s F1 bans the
// substring `ticks(` to catch wobbleweed's wall-clock `ticks()`, and that
// pattern already false-positives on three legitimate names at HEAD
// (`sim_accum_ticks`, `director_hold_ticks`, `proj_burn_duration_ticks`), so F1
// is red before this file is touched.  Adding a fourth hit would bury the
// pre-existing defect under a change that has nothing to do with it.  The fix
// belongs in that probe's pattern (`[^_A-Za-z]ticks\(`) and it is reported, not
// silently worked around — this name is merely declining to make it worse.
export fn sim_stat_stream_tick_count(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.stream_tick_n; return o; }
export fn sim_stat_stream_worst(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.stream_worst; return o; }
export fn sim_stream_pending(p_w: object): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let o: i32 = s.ring_n - s.ring_i;
    if (o < 0) { o = 0; }
    return o;
}
export fn sim_stat_swaps(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.swaps; return o; }

// ===========================================================================
//  4.  PLAYERS
// ===========================================================================

// Create the body for positional player slot `p_pslot` (1..players) at (x, z),
// standing on the terrain, with the GDD §8 loadout: a Kestrel, `6 / 12`.
// Returns the entity id, or ID_NONE.
export fn sim_add_player(p_w: object, p_pslot: i32, p_x: f64, p_z: f64): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let k: i32 = p_pslot - 1;
    if (k < 0 || k >= s.players) { let bad: i32 = ID_NONE; return bad; }

    // `world_spawn_player` returns the ENTITY SLOT, not the id — the same
    // convention as `world_spawn`.  ARCHITECTURE §5.4's "a player id IS its
    // slot" means the POSITIONAL PLAYER slot (1..64), which is the id, not the
    // dense array index this returns.  Reading it as an id yields 0 == ID_NONE
    // for player 1 and the body then exists but is never driven.
    let slot: i32 = world_spawn_player(w, p_pslot);
    if (slot == SLOT_NONE) { let full: i32 = ID_NONE; return full; }
    let id: i32 = world_id_of(w, slot);
    if (id == ID_NONE) { let lost: i32 = ID_NONE; return lost; }

    let psa = s.move_ps;
    let ps: array<f64> = psa[k];
    move_place(ps, s.cs, p_x, p_z);
    move_to_world(w, slot, ps);

    let hp = w.hp;
    let hpm = w.hp_max;
    let team = w.team;
    let flags = w.flags;
    let model = w.model;
    let weapon = w.weapon;
    hp[slot] = i32(g_HP_MAX);
    hpm[slot] = i32(g_HP_MAX);
    team[slot] = 1;
    flags[slot] = flags[slot] | EF_VISIBLE;
    model[slot] = 0;
    weapon[slot] = WPN_KESTREL;

    wpn_state_reset(s.wpn, k * WS_FIELDS, WPN_KESTREL);
    prog_reset(s.prog[k]);

    // Seed the LATCH with the loadout.  A zeroed command selects weapon 0, so a
    // player who has not sent a command yet would be silently restowed to the
    // Sparrow on their first tick.  GDD §8: the Kestrel is in your hands.
    let ca0 = s.cmd;
    let c0: object = ca0[k];
    c0.weapon_sel = WPN_KESTREL;

    let pid = s.pslot_id;
    pid[k] = id;
    let seq = s.q_seq;
    seq[k] = -1;
    let chan = s.chan_t;
    chan[k] = 0.0;
    let pd = s.p_dead;
    pd[k] = 0;

    let out: i32 = id;
    return out;
}

// Put a dead player back on their feet.  The sim owns the PRIMITIVE; the
// RESPAWN TIMER (`g_RESPAWN_S`, 4 s) and the Wick revive of GDD §2.7 are game
// policy and belong to W4-11 / W5.  A sim that respawned on its own schedule
// would make that policy unimplementable.
export fn sim_respawn_player(p_w: object, p_pslot: i32, p_x: f64, p_z: f64): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let k: i32 = p_pslot - 1;
    if (k < 0 || k >= s.players) { let bad: i32 = 0; return bad; }
    let pid = s.pslot_id;
    let id: i32 = pid[k];
    if (id == ID_NONE) { let none: i32 = 0; return none; }
    let slot: i32 = world_slot_of(w, id);
    if (slot == SLOT_NONE) { let gone: i32 = 0; return gone; }

    let psa = s.move_ps;
    let ps: array<f64> = psa[k];
    move_place(ps, s.cs, p_x, p_z);
    move_to_world(w, slot, ps);

    let hp = w.hp;
    let hpm = w.hp_max;
    let flags = w.flags;
    hp[slot] = hpm[slot];
    if (hp[slot] <= 0) { hp[slot] = i32(g_HP_MAX); hpm[slot] = i32(g_HP_MAX); }
    flags[slot] = (flags[slot] & (0 - 1 - EF_DEAD)) | EF_VISIBLE;
    let pd = s.p_dead;
    pd[k] = 0;
    let chan = s.chan_t;
    chan[k] = 0.0;
    let out: i32 = 1;
    return out;
}

// ===========================================================================
//  5.  THE COMMAND PIPELINE
// ===========================================================================

// Queue one command for a player.  The transport calls this; nothing else
// should.  Returns 1 if queued, 0 if the command is malformed (and counted).
//
// The command is COPIED, never aliased.  Aliasing the caller's live command is
// how reconciliation starts lying (command.hml says the same thing about the
// pending ring).
export fn sim_queue_command(p_w: object, p_pslot: i32, p_cmd: object): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let k: i32 = p_pslot - 1;
    if (k < 0 || k >= s.players) { let bad: i32 = 0; return bad; }
    if (cmd_wire_ok(p_cmd) != 0) {
        s.cmds_bad = s.cmds_bad + 1;
        let ill: i32 = 0;
        return ill;
    }

    let qn = s.q_n;
    let qh = s.q_head;
    let qa = s.queue;
    let ring: array = qa[k];

    if (qn[k] >= SIM_CMD_QUEUE) {
        // Drop the OLDEST.  A client that is behind should become current, not
        // stay permanently one buffer-length in the past.
        qh[k] = (qh[k] + 1) & (SIM_CMD_QUEUE - 1);
        qn[k] = qn[k] - 1;
        s.cmds_dropped = s.cmds_dropped + 1;
    }
    let at: i32 = (qh[k] + qn[k]) & (SIM_CMD_QUEUE - 1);
    cmd_copy(ring[at], p_cmd);
    qn[k] = qn[k] + 1;
    s.cmds_queued = s.cmds_queued + 1;
    let out: i32 = 1;
    return out;
}

export fn sim_queued(p_w: object, p_pslot: i32): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let k: i32 = p_pslot - 1;
    if (k < 0 || k >= s.players) { let bad: i32 = 0; return bad; }
    let qn = s.q_n;
    let out: i32 = qn[k];
    return out;
}

// ARCHITECTURE §3 / §5.4: `sim_apply_command(world, slot, cmd)`, pure with
// respect to the world.
//
// "Apply" here means STAGE (a) FOR ONE COMMAND: validate it, reject a stale or
// duplicated sequence number, and latch it as this player's command for the
// tick.  It deliberately does NOT integrate movement or fire the weapon —
// §4.3 lists those as stages (b) and (c), and if applying a command ran them
// then stages a, b and c would be one stage with three names.
//
// It writes no world field, emits no event, plays no sound, allocates nothing
// and reads no clock.  Returns 1 if the command was latched.
export fn sim_apply_command(p_w: object, p_pslot: i32, p_cmd: object): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let k: i32 = p_pslot - 1;
    if (k < 0 || k >= s.players) { let bad: i32 = 0; return bad; }
    if (cmd_wire_ok(p_cmd) != 0) {
        s.cmds_bad = s.cmds_bad + 1;
        let ill: i32 = 0;
        return ill;
    }
    let seq = s.q_seq;
    let sq: i32 = p_cmd.seq;
    if (sq <= seq[k]) {
        // A replayed or reordered packet.  Dropping it is what keeps the
        // authoritative stream monotonic; applying it would rewind the player.
        s.cmds_stale = s.cmds_stale + 1;
        let old: i32 = 0;
        return old;
    }
    let ca = s.cmd;
    cmd_copy(ca[k], p_cmd);
    seq[k] = sq;
    let hc = s.has_cmd;
    hc[k] = 1;
    s.cmds_applied = s.cmds_applied + 1;
    let out: i32 = 1;
    return out;
}

// ===========================================================================
//  6.  THE TEN STAGES
// ===========================================================================

// ---- (a) apply queued commands, in player-slot order, then seq -------------
// One command per player per tick.  A player with an empty queue is stepped
// with a HOLD command: the same aim, no movement axes, no buttons.  Repeating
// the last command instead would keep a dropped packet's trigger held down and
// empty the magazine of a player whose network hiccuped, which is a worse
// failure than a single frame of stillness.
fn stage_commands(p_w: object, p_s: object) {
    let w: object = p_w;
    let s: object = p_s;
    let np: i32 = s.players;
    let qn = s.q_n;
    let qh = s.q_head;
    let qa = s.queue;
    let ca = s.cmd;
    let hc = s.has_cmd;
    let tick: i32 = w.tick;

    let k: i32 = 0;
    while (k < np) {
        hc[k] = 0;
        let got: i32 = 0;
        if (qn[k] > 0) {
            let ring: array = qa[k];
            let head: i32 = qh[k];
            got = sim_apply_command(w, k + 1, ring[head]);
            qh[k] = (head + 1) & (SIM_CMD_QUEUE - 1);
            qn[k] = qn[k] - 1;
        }
        if (got == 0) {
            // HOLD.  Keep the quantized aim EXACTLY as it was (no dequantize /
            // requantize round trip, which is idempotent but not free) and zero
            // everything a player could be holding down.  `weapon_sel` is left
            // alone: a dropped packet must not restow the player's weapon.
            let c: object = ca[k];
            c.tick = tick;
            c.move_x = 0;
            c.move_y = 0;
            c.buttons = 0;
            s.cmds_missing = s.cmds_missing + 1;
            hc[k] = 1;
        }
        k++;
    }
}

// ---- (b) movement integration + terrain/AABB collision ---------------------
fn stage_movement(p_w: object, p_s: object) {
    let w: object = p_w;
    let s: object = p_s;
    let np: i32 = s.players;
    let psa = s.move_ps;
    let ca = s.cmd;
    let pid = s.pslot_id;
    let ev = s.move_ev;
    let cs: object = s.cs;
    let sol = s.solids;
    let flags = w.flags;
    let tick: i32 = w.tick;
    let cxo: object = s.cx;

    let k: i32 = 0;
    while (k < np) {
        let id: i32 = pid[k];
        ev[k] = 0;
        if (id != ID_NONE) {
            let slot: i32 = world_slot_of(w, id);
            if (slot != SLOT_NONE) {
                if ((flags[slot] & EF_DEAD) == 0) {
                    let ps: array<f64> = psa[k];
                    let e: i32 = move_apply_ex(ps, cs, ca[k], sol);
                    ev[k] = e;
                    move_to_world(w, slot, ps);
                    if ((e & MOVE_EV_GROUND_MISS) != 0) { s.ground_miss = s.ground_miss + 1; }
                    if ((e & MOVE_EV_FALL_DMG) != 0) {
                        let dmg: f64 = move_take_fall_damage(ps);
                        if (dmg > 0.0) {
                            // The world, not the player, is the attacker.  A
                            // fall is DMG_FALL so the plate arc and the hit
                            // chain never see it.
                            combat_apply_damage(cxo, w, ID_NONE, slot, dmg,
                                                WPN_NONE, DMG_FALL, 0,
                                                0.0, 0.0,
                                                ps[0], ps[1], ps[2]);
                            s.fall_hits = s.fall_hits + 1;
                        }
                    }
                }
            }
        }
        k++;
    }
}

// ---- (c) weapons: fire, reload, cooldowns, recoil_aim ----------------------
// Sub-order, and it is API for the same reason the stage order is:
//     1. swap request   (the command's `weapon_sel` is the REQUEST; W7-3 —
//                        it stopped being the switch when `wpn_swap_begin`
//                        started checking the owned set)
//     2. reload request
//     3. wpn_step       (cooldowns, ADS lerp, bloom decay, recoil recovery)
//     4. fire
// Step before fire, because a cooldown that expires this tick must expire
// BEFORE the trigger is read or the weapon loses one tick of rate of fire on
// every shot — the same carry argument `wpn_fire` makes about its interval.
fn stage_weapons(p_w: object, p_s: object) {
    let w: object = p_w;
    let s: object = p_s;
    let np: i32 = s.players;
    let ca = s.cmd;
    let pid = s.pslot_id;
    let psa = s.move_ps;
    let st: array = s.wpn;
    let rng: array = s.rng;
    let outv: array<f64> = s.wpn_out;
    let cxo: object = s.cx;
    let pjo: object = s.proj;
    let cs: object = s.cs;
    let flags = w.flags;
    let weapon = w.weapon;
    let amag = w.ammo_mag;
    let ares = w.ammo_res;
    let seed: i32 = w.seed;
    let tick: i32 = w.tick;

    let k: i32 = 0;
    while (k < np) {
        let id: i32 = pid[k];
        if (id != ID_NONE) {
            let slot: i32 = world_slot_of(w, id);
            if (slot != SLOT_NONE) {
                let o: i32 = k * WS_FIELDS;
                let c: object = ca[k];
                let dead: i32 = 0;
                if ((flags[slot] & EF_DEAD) != 0) { dead = 1; }

                // >>> THE SWAP REQUEST IS NOW CHECKED, NOT OBEYED. <<<
                // `wpn_swap_begin` refuses a gun this slot does not own
                // (`weapons.hml` WS_OWNED), so `weapon_sel` is a REQUEST off
                // the wire and no longer an instruction. The refusal is
                // COUNTED and separately from a swap that merely could not
                // start yet: `swaps_denied` moving is a client asking for
                // something it was never given, which is the one thing an
                // authoritative server most wants to see in a counter, and
                // `swaps_wpn` not moving because a swap is already in flight
                // is nothing at all. `wpn_valid` gates the count so a
                // main-hand id that is a club or a spell (8..17) is not
                // reported as a stolen rifle.
                let want: i32 = c.weapon_sel;
                if (dead == 0) {
                    if (want != wpn_cur(st, o)) {
                        if (wpn_swap_begin(st, o, want) == 1) { s.swaps_wpn = s.swaps_wpn + 1; }
                        else if (wpn_valid(want) == 1) {
                            if (wpn_owned(st, o, want) == 0) {
                                s.swaps_denied = s.swaps_denied + 1;
                            }
                        }
                    }
                    if (cmd_btn(c, BTN_RELOAD) == 1) {
                        if (wpn_reload_begin(st, o) == 1) { s.reloads = s.reloads + 1; }
                    }
                }

                let ads: i32 = 0;
                let spr: i32 = 0;
                if (dead == 0) {
                    ads = cmd_btn(c, BTN_ADS);
                    spr = cmd_btn(c, BTN_SPRINT);
                }
                wpn_step(st, o, ads, spr);

                if (dead == 0 && cmd_btn(c, BTN_FIRE) == 1) {
                    if (wpn_can_fire(st, o) == 1) {
                        // The spread stream is reseeded per shot from
                        // (world_seed, RNG_SPREAD, tick, shooter id), exactly
                        // as weapons.hml requires, so a predicting client draws
                        // the same numbers without talking to the server.
                        rng_seed(rng, seed, RNG_SPREAD, tick, id);
                        if (wpn_fire(st, o, rng, outv) == 1) {
                            s.shots = s.shots + 1;
                            let wid: i32 = wpn_cur(st, o);
                            let ps: array<f64> = psa[k];
                            let eye: f64 = move_eye_y(ps);
                            if (wid == WPN_EMBERLANCE) {
                                proj_spawn_aim(pjo, w, PROJ_EMBERLANCE, id,
                                               ps[0], eye, ps[2],
                                               cmd_yaw(c), cmd_pitch(c));
                            } else {
                                let bl: f64 = wpn_cur_spread(st, o);
                                let a01: f64 = st[o + WS_ADS];
                                combat_fire(cxo, w, cs, slot, eye, c, bl, a01);
                            }
                        }
                    }
                }

                // Mirror the owner-replicated ammo counters onto the entity so
                // the snapshot carries them.  weapons.hml owns the truth; this
                // is a copy for the wire, refreshed once per tick.
                let cur: i32 = wpn_cur(st, o);
                weapon[slot] = cur;
                amag[slot] = wpn_ammo(st, o, cur);
                ares[slot] = wpn_reserve_ammo(st, o, cur);
            }
        }
        k++;
    }
}

// ---- (d) projectiles -------------------------------------------------------
fn stage_projectiles(p_w: object, p_s: object) {
    let w: object = p_w;
    let s: object = p_s;
    proj_step(s.proj, w);
}

// ---- (e) AI steering -------------------------------------------------------
// The director runs FIRST, inside this stage, because a body it releases this
// tick must steer this tick — a spawn that waits a tick for its first step
// appears one frame frozen, which at 24 m of spawn distance is visible.
// director.hml's own header calls itself stage (e) for this reason.
fn stage_ai(p_w: object, p_s: object) {
    let w: object = p_w;
    let s: object = p_s;
    let d: object = s.dir;
    let ai: object = s.ai;
    let tick: i32 = w.tick;

    // The anchor is player slot 1's body: the hold happens where the light is,
    // and in v1 the light is where the player is.
    let pid = s.pslot_id;
    let np: i32 = s.players;
    let ax: f64 = 0.0;
    let ay: f64 = 0.0;
    let az: f64 = 0.0;
    let ayaw: f64 = 0.0;
    let have: i32 = 0;
    let px = w.px;
    let py = w.py;
    let pz = w.pz;
    let yaws = w.yaw;
    let k: i32 = 0;
    while (k < np) {
        if (have == 0) {
            let id: i32 = pid[k];
            if (id != ID_NONE) {
                let slot: i32 = world_slot_of(w, id);
                if (slot != SLOT_NONE) {
                    ax = px[slot]; ay = py[slot]; az = pz[slot];
                    ayaw = yaws[slot];
                    have = 1;
                }
            }
        }
        k++;
    }
    if (have == 1) { director_set_anchor(d, ax, ay, az); }

    let nreq: i32 = director_step(d, w, tick, ax, az, ayaw);
    s.spawns_req = s.spawns_req + nreq;
    let i: i32 = 0;
    while (i < nreq) {
        let kind: i32 = director_req_kind(d, i);
        let sx: f64 = director_req_x(d, i);
        let sy: f64 = director_req_y(d, i);
        let sz: f64 = director_req_z(d, i);
        let yw: f64 = ai_yaw_of_dir(ax - sx, az - sz);
        let nid: i32 = ai_spawn(ai, w, kind, sx, sy, sz, yw);
        director_bind(d, i, nid);
        if (nid != ID_NONE) { s.spawns_ok = s.spawns_ok + 1; }
        i++;
    }

    ai_step(ai, w, s.cs);
}

// ---- (f) damage resolution + death -----------------------------------------
// Two halves, in this order:
//   1. the AI's attack events become damage.  `ai.hml` steers and swings; it
//      does not import `combat.hml` and it must not — the integrator is the
//      only place the two meet, exactly as with weapons/combat above.
//   2. the reaper.  `combat.hml` never despawns (its own header says so,
//      because a stable slot index is what makes a multi-pellet shot correct).
//      This is the later stage it is talking about.
fn stage_damage(p_w: object, p_s: object) {
    let w: object = p_w;
    let s: object = p_s;
    let ai: object = s.ai;
    let cxo: object = s.cx;
    let tick: i32 = w.tick;
    let seed: i32 = w.seed;

    let px = w.px;
    let py = w.py;
    let pz = w.pz;
    let flags = w.flags;
    let kinds = w.kind;
    let ids = w.id;
    let lastby = w.last_hit_by;

    // ---- 1. AI swings ------------------------------------------------------
    let nev: i32 = ai_event_count(ai);
    let i: i32 = 0;
    while (i < nev) {
        let ty: i32 = ai_event_type(ai, i);
        if (ty == AIEV_ATTACK) {
            let tid: i32 = ai_event_target(ai, i);
            let tslot: i32 = world_slot_of(w, tid);
            if (tslot != SLOT_NONE) {
                let aid: i32 = ai_event_id(ai, i);
                let aslot: i32 = world_slot_of(w, aid);
                let dx: f64 = 0.0;
                let dz: f64 = 0.0;
                if (aslot != SLOT_NONE) {
                    dx = px[tslot] - px[aslot];
                    dz = pz[tslot] - pz[aslot];
                    let l: f64 = sqrt(dx * dx + dz * dz);
                    if (l > 0.0001) { dx = dx / l; dz = dz / l; }
                }
                combat_apply_damage(cxo, w, aid, tslot, f64(ai_event_ival(ai, i)),
                                    WPN_NONE, DMG_CONTACT, 0, dx, dz,
                                    ai_event_x(ai, i), ai_event_y(ai, i), ai_event_z(ai, i));
                s.ai_attacks = s.ai_attacks + 1;
            }
        } else if (ty == AIEV_ADDS) {
            let n_add: i32 = ai_event_ival(ai, i);
            let ex: f64 = ai_event_x(ai, i);
            let ey: f64 = ai_event_y(ai, i);
            let ez: f64 = ai_event_z(ai, i);
            let j: i32 = 0;
            while (j < n_add) {
                // Placed on a deterministic ring around the slammer: no RNG
                // draw, so a replay of the same tick places them identically
                // without consuming a stream the client cannot reproduce.
                let ang: f64 = f64(j) * 1.2566370614359172;
                let ox: f64 = ex + 1.5 * cos(ang);
                let oz: f64 = ez + 1.5 * sin(ang);
                let nid: i32 = ai_spawn(ai, w, g_ENEMY_WISP, ox, ey, oz, ang);
                if (nid != ID_NONE) { s.adds_spawned = s.adds_spawned + 1; }
                j++;
            }
        }
        i++;
    }

    // ---- 2. the reaper -----------------------------------------------------
    // Walked BACKWARDS because `world_despawn` swaps the last slot into the
    // hole; a forward walk would skip the entity it just moved.
    let bus: object = combat_events(cxo);
    let itemv: array = s.item;
    let progs = s.prog;
    let np: i32 = s.players;
    let tier: i32 = loot_clamp_tier(s.tier);
    let pdead = s.p_dead;
    let slot: i32 = w.count - 1;
    while (slot >= 0) {
        if ((flags[slot] & EF_DEAD) != 0) {
            let vid: i32 = ids[slot];
            let vkind: i32 = kinds[slot];
            if (vkind == KIND_PLAYER) {
                // A PLAYER IS NEVER REAPED.  The corpse stays in the world so
                // the client can dissolve it, the killfeed can name it and
                // `sim_respawn_player` has something to put back on its feet.
                // Despawning it would drop the id every other system holds.
                let dk: i32 = vid - 1;
                if (dk >= 0 && dk < np) {
                    if (pdead[dk] == 0) {
                        pdead[dk] = 1;
                        prog_on_death(progs[dk]);
                        s.player_deaths = s.player_deaths + 1;
                        evbus_push(bus, tick, EV_DESPAWN, vkind, ID_NONE, vid,
                                   ev_q(px[slot]), ev_q(py[slot]), ev_q(pz[slot]));
                    }
                }
                slot = slot - 1;
                continue;
            }
            if (vkind == KIND_AI) {
                let killer: i32 = lastby[slot];
                // The corpse's drop is a PURE FUNCTION of
                // (world seed, victim id, killer id, tier, weapon family), so
                // it never has to be replicated and it reproduces in a replay.
                let fam: i32 = 0;
                let pk: i32 = killer - 1;
                if (pk >= 0 && pk < np) {
                    let stw: array = s.wpn;
                    fam = wpn_cur(stw, pk * WS_FIELDS);
                    if (fam < 0) { fam = 0; }
                }
                let rar: i32 = loot_roll_at(itemv, seed, vid, killer, tier, fam);
                s.loot_rolls = s.loot_rolls + 1;
                s.last_rarity = rar;
                s.loot_hash = s.loot_hash ^ loot_item_hash(itemv);

                if (pk >= 0 && pk < np) {
                    let bonus: i32 = XPB_NONE;
                    if (kill_was_headshot(bus, vid) == 1) { bonus = XPB_HEADSHOT; }
                    let pr: array = progs[pk];
                    prog_on_kill(pr, ai_class_index(w, slot), bonus);
                    evbus_push(bus, tick, EV_XP, prog_last_xp(pr), killer, vid,
                               ev_q(px[slot]), ev_q(py[slot]), ev_q(pz[slot]));
                    if (prog_last_levels(pr) > 0) {
                        evbus_push(bus, tick, EV_LEVELUP, prog_level(pr), killer, vid,
                                   ev_q(px[slot]), ev_q(py[slot]), ev_q(pz[slot]));
                    }
                }
            }
            evbus_push(bus, tick, EV_DESPAWN, vkind, ID_NONE, vid,
                       ev_q(px[slot]), ev_q(py[slot]), ev_q(pz[slot]));
            world_despawn(w, slot);
            s.deaths = s.deaths + 1;
        }
        slot = slot - 1;
    }

    // Streak timers are a per-tick decay and belong with the rest of the
    // per-tick bookkeeping, not with the kill that armed them.
    let k: i32 = 0;
    while (k < np) {
        prog_streak_step(progs[k], 1);
        k++;
    }
}

// The enemy CLASS of a slot, for the XP table.  `world.hml` stores the class in
// `model` offset by nothing at spawn time; `ai.hml` writes `ai_state` and the
// class-derived hp.  The class is recoverable from `model`, which `ai_spawn`
// sets to the class index.
fn ai_class_index(p_w: object, p_slot: i32): i32 {
    let w: object = p_w;
    let mdl = w.model;
    let m: i32 = mdl[p_slot];
    if (m < 0) { m = 0; }
    if (m > 5) { m = 5; }
    let out: i32 = m;
    return out;
}

// Did the killing blow on `p_vid` land on the head?  The hitmarker event
// carries both bits, so this reads the authority's own record rather than
// keeping a second copy of it.
fn kill_was_headshot(p_bus: object, p_vid: i32): i32 {
    let b: object = p_bus;
    let want: i32 = p_vid;
    let n: i32 = evbus_count(b);
    let i: i32 = 0;
    while (i < n) {
        if (evbus_type(b, i) == EV_HITMARKER) {
            if (evbus_target(b, i) == want) {
                let sb: i32 = evbus_sub(b, i);
                if ((sb & HM_KILL) != 0 && (sb & HM_HEAD) != 0) {
                    let yes: i32 = 1;
                    return yes;
                }
            }
        }
        i++;
    }
    let no: i32 = 0;
    return no;
}

// ---- (g) pickups / interactions / lantern channel / block placement --------
// v1 implements the two that exist:
//   * the lantern channel — GDD §8's 2.5 s hold, the beat the whole first
//     minute is built around.  `lantern.hml` is a Wave 5 file; ARCHITECTURE
//     §4.3 puts the CHANNEL in this stage, so the timer lives here until W5-6
//     takes it.
//   * pickups — any KIND_PICKUP body inside reach is collected.
// Block placement is `build.hml`, Wave 5.  This stage is where it goes.
fn stage_interact(p_w: object, p_s: object) {
    let w: object = p_w;
    let s: object = p_s;
    let np: i32 = s.players;
    let pid = s.pslot_id;
    let ca = s.cmd;
    let chan = s.chan_t;
    let progs = s.prog;
    let bus: object = combat_events(s.cx);
    let tick: i32 = w.tick;

    let px = w.px;
    let py = w.py;
    let pz = w.pz;
    let kinds = w.kind;
    let anims = w.anim;
    let ids = w.id;
    let r2: f64 = SIM_INTERACT_R_M * SIM_INTERACT_R_M;
    let n: i32 = w.count;

    let k: i32 = 0;
    while (k < np) {
        let id: i32 = pid[k];
        if (id != ID_NONE) {
            let slot: i32 = world_slot_of(w, id);
            if (slot != SLOT_NONE) {
                let ax: f64 = px[slot];
                let ay: f64 = py[slot];
                let az: f64 = pz[slot];
                let c: object = ca[k];
                let use: i32 = cmd_btn(c, BTN_USE);

                // ---- the lantern channel -------------------------------
                let best: i32 = SIM_MISS;
                let bestd: f64 = r2;
                let i: i32 = 0;
                while (i < n) {
                    if (kinds[i] == KIND_LANTERN) {
                        if (anims[i] == SIM_LANTERN_UNLIT) {
                            let dx: f64 = px[i] - ax;
                            let dy: f64 = py[i] - ay;
                            let dz: f64 = pz[i] - az;
                            let d: f64 = dx * dx + dy * dy + dz * dz;
                            if (d <= bestd) { bestd = d; best = i; }
                        }
                    }
                    i++;
                }
                if (use == 1 && best >= 0) {
                    chan[k] = chan[k] + g_TICK_DT;
                    if (chan[k] >= g_LANTERN_CHANNEL_S) {
                        anims[best] = SIM_LANTERN_LIT;
                        chan[k] = 0.0;
                        s.lanterns_lit = s.lanterns_lit + 1;
                        // GDD §8 at 0:30: "+350 XP" — `XPS_LANTERN`.
                        prog_award(progs[k], XPS_LANTERN, 0);
                        evbus_push(bus, tick, EV_XP, prog_last_xp(progs[k]),
                                   id, ids[best],
                                   ev_q(px[best]), ev_q(py[best]), ev_q(pz[best]));
                        if (prog_last_levels(progs[k]) > 0) {
                            evbus_push(bus, tick, EV_LEVELUP, prog_level(progs[k]),
                                       id, ids[best],
                                       ev_q(px[best]), ev_q(py[best]), ev_q(pz[best]));
                        }
                    }
                } else {
                    // Releasing cancels.  A channel that survived a release
                    // would let a player light a lantern in five separate
                    // half-second taps while dodging, which is not the beat.
                    chan[k] = 0.0;
                }

                // ---- pickups --------------------------------------------
                // Backwards: `world_despawn` swaps the last slot into the hole.
                let j: i32 = w.count - 1;
                while (j >= 0) {
                    if (kinds[j] == KIND_PICKUP) {
                        let dx2: f64 = px[j] - ax;
                        let dy2: f64 = py[j] - ay;
                        let dz2: f64 = pz[j] - az;
                        if (dx2 * dx2 + dy2 * dy2 + dz2 * dz2 <= r2) {
                            evbus_push(bus, tick, EV_PICKUP, 0, id, ids[j],
                                       ev_q(px[j]), ev_q(py[j]), ev_q(pz[j]));
                            world_despawn(w, j);
                            s.pickups = s.pickups + 1;
                        }
                    }
                    j = j - 1;
                }
            }
        }
        k++;
    }
}

// ---- (h) day-cycle tick, chunk streaming decisions -------------------------
// The day cycle is a pure function of the tick, so this stage does not ADVANCE
// it — it PUBLISHES it, and derives the two things that depend on it: the shade
// tier the director will run at, and which chunk ring is resident.
//
// The tier reaches the director on the FOLLOWING tick, because `director_step`
// ran in stage (e).  That is deliberate and it is not a bug: the tier changes
// at a 200 m chunk boundary or a phase edge of a 16-minute cycle, and one tick
// of lag on either is 16.7 ms.  Moving the tier before the director would mean
// running the day cycle before the AI, which contradicts §4.3's order — and the
// order is API.
fn stage_world(p_w: object, p_s: object) {
    let w: object = p_w;
    let s: object = p_s;
    let tick: i32 = w.tick;
    let seed: i32 = w.seed;

    s.phase = day_phase(tick);
    s.day_t = day_frac(tick);
    s.horn = day_horn_edge(s.prev_tick, tick);

    let pid = s.pslot_id;
    let np: i32 = s.players;
    let px = w.px;
    let pz = w.pz;
    let k: i32 = 0;
    let have: i32 = 0;
    let ax: f64 = 0.0;
    let az: f64 = 0.0;
    while (k < np) {
        if (have == 0) {
            let id: i32 = pid[k];
            if (id != ID_NONE) {
                let slot: i32 = world_slot_of(w, id);
                if (slot != SLOT_NONE) { ax = px[slot]; az = pz[slot]; have = 1; }
            }
        }
        k++;
    }
    if (have == 0) { return; }

    let cx: i32 = floori(ax / g_CHUNK_M);
    let cz: i32 = floori(az / g_CHUNK_M);
    let tier: i32 = worldgen_shade_tier(seed, cx, cz, day_tier_bonus(tick));
    s.tier = tier;
    // LATCH THE TIER FOR THE DURATION OF A HOLD.
    //
    // This pushed the tier into the director EVERY TICK, recomputed from whatever
    // chunk the player happened to be standing in -- so it flapped as they walked:
    // measured 1->2->0->1->2->1->2->3 over 90 s of ordinary movement.
    //
    // That made wave 1 unwinnable. The instant the player stepped into a tier-0
    // chunk, director_min_cost(0) returns 0, the spawner's
    // `if (mincost <= 0 || ...) done_spawning = 1` latched DIR_CLEARING with 42-46
    // of the 60-point budget UNSPENT, and it then waited forever for alive <= 0 --
    // which never arrives, because the bodies that would have been spawned never
    // were. Instrumented: `done_spawning budget=60 spent=18 free=42 mincost=0`.
    //
    // A hold's difficulty belongs to WHERE AND WHEN IT STARTED. A player walking
    // during a fight must not retune the wave they are already fighting.
    // s.tier stays live for everything else (danger readouts, ambience); only the
    // director's copy is latched.
    if (director_hold_active(s.dir) == 0) {
        // THE OPENING HOLD IS PINNED TO TIER 1. It is a tutorial, and a tutorial
        // that kills you is not one.
        //
        // The spawn chunk's tier is a function of the seed, so it rolled 2 on
        // 5 of 12 sampled seeds -- and tier 2's wave 1 is ~15 bodies against a
        // 14-body alive cap, so it SATURATES BY CONSTRUCTION and can never
        // clear. probe_waveone measured the split exactly:
        //
        //   tier 1 seeds  CLEAR 0:51 - 1:20, peak alive 7-11/14, deaths 0-2
        //   tier 2 seeds  never clears,      peak alive 12-14/14, deaths 2-7
        //
        // Every tier-1 seed finished the first minute. Every tier-2 seed killed
        // the player. That is not difficulty variance, it is a coin flip on
        // whether the game is completable, decided before the player has a
        // second weapon or a single stat point.
        //
        // Only the FIRST hold is pinned. Once holds_done > 0 the world's own
        // danger gradient takes over and the seed means what it says.
        let t_eff: i32 = tier;
        if (director_holds_done(s.dir) == 0 && t_eff > 1) { t_eff = 1; }
        director_set_tier(s.dir, t_eff);
    }

    if (s.has_cs == 1) {
        if (cx != s.ccx || cz != s.ccz) {
            stream_recentre(s, cx, cz);
            s.ccx = cx;
            s.ccz = cz;
            s.streams = s.streams + 1;
        }
        stream_step(s, cx, cz);
    }
}

// ---------------------------------------------------------------------------
// STREAMING — the ring moved.  Re-pin, do not re-generate.
// ---------------------------------------------------------------------------
// Two passes, and the order between them is the safety property:
//
//   1. RELEASE the ring we are leaving, so cells that fell out become
//      evictable again.  A cell that is in BOTH rings is unpinned here and
//      re-pinned in pass 2 of the same tick, before any `chunk_get` in
//      `stream_step` can reach `slot_acquire`.  Nothing is ever unpinned
//      across a tick boundary that should have stayed pinned.
//   2. PIN every cell of the NEW ring that is already resident, WITHOUT
//      generating anything.  For any single-boundary crossing the new ring's
//      inner 3x3 is a subset of the old 5x5, so this pass alone guarantees
//      residency within one chunk of the player at every tick.
//
// The COLD case (`ocx` still the sentinel — a store nobody pre-warmed) is
// deliberately eager: `stream_step` is called with an unbounded budget so the
// first ring is whole before the first movement integration reads it.  That is
// a BOOT cost, inside ARCHITECTURE §8's 400 ms asset allowance, and it is what
// keeps this change invisible to `sim_set_chunks` callers that hand over an
// empty store.  `src/game/server.hml` pre-warms to RING_RADIUS+1 anyway, so the
// shipping path generates nothing here at all.
fn stream_recentre(p_s: object, p_cx: i32, p_cz: i32) {
    let s: object = p_s;
    let cs: object = s.cs;
    let dxa = s.ring_dx;
    let dza = s.ring_dz;
    let n: i32 = s.ring_n;
    let cx: i32 = p_cx;
    let cz: i32 = p_cz;
    let ocx: i32 = s.ccx;
    let ocz: i32 = s.ccz;
    let cold: i32 = 0;
    if (ocx == 2147483647) { cold = 1; }

    if (cold == 0) {
        let i: i32 = 0;
        while (i < n) { chunk_pin(cs, ocx + dxa[i], ocz + dza[i], 0); i++; }
    }

    let j: i32 = 0;
    while (j < n) {
        let gx: i32 = cx + dxa[j];
        let gz: i32 = cz + dza[j];
        if (chunk_find(cs, gx, gz) >= 0) { chunk_pin(cs, gx, gz, 1); }
        j++;
    }

    s.ring_i = 0;
    if (cold == 1) { stream_fill(s, cx, cz, n); }
}

// At most `p_budget` GENERATIONS, resuming where the last tick stopped.  A
// resident cell costs one `chunk_find`; a missing one costs a generation and
// spends a unit of budget.  When the walk reaches the end it parks at `ring_n`
// and every later tick returns on the first compare — so the steady state of
// this stage is one integer test, not a 25-cell scan.
fn stream_fill(p_s: object, p_cx: i32, p_cz: i32, p_budget: i32) {
    let s: object = p_s;
    let n: i32 = s.ring_n;
    let i: i32 = s.ring_i;
    if (i >= n) { return; }
    let cs: object = s.cs;
    let dxa = s.ring_dx;
    let dza = s.ring_dz;
    let cx: i32 = p_cx;
    let cz: i32 = p_cz;
    let budget: i32 = p_budget;
    let gen: i32 = 0;
    while (i < n) {
        let gx: i32 = cx + dxa[i];
        let gz: i32 = cz + dza[i];
        if (chunk_find(cs, gx, gz) < 0) {
            if (gen >= budget) { break; }
            let got: i32 = chunk_get(cs, gx, gz);
            if (got >= 0) { chunk_pin(cs, gx, gz, 1); }
            gen = gen + 1;
        }
        i++;
    }
    s.ring_i = i;
    if (gen > 0) {
        s.streamed = s.streamed + gen;
        s.stream_tick_n = s.stream_tick_n + 1;
        if (gen > s.stream_worst) { s.stream_worst = gen; }
    }
}

fn stream_step(p_s: object, p_cx: i32, p_cz: i32) {
    stream_fill(p_s, p_cx, p_cz, SIM_STREAM_PER_TICK);
}

// ---- (i) history_capture ---------------------------------------------------
// Every tick, even in v1, even though nothing samples it yet.  A history that
// is only captured when someone is watching has holes exactly where lag
// compensation needs them.
fn stage_history(p_w: object, p_s: object) {
    let w: object = p_w;
    let s: object = p_s;
    history_capture(s.hist, w);
}

// ===========================================================================
//  7.  sim_effects — STAGE (j), AND THE ONLY COSMETIC CODE IN src/sim
// ===========================================================================
//  ARCHITECTURE §3 / CLAUDE.md §7: `sim_apply_command` is pure with respect to
//  the world — no sound, no particle, no shake — and every cosmetic lives here,
//  in a pass that is SKIPPED when `world.replaying == 1`.  "Replaying 8
//  commands must produce 0 sounds."
//
//  What it actually does: translate this tick's authoritative events into a
//  client-side effect queue.  It emits nothing itself — `src/sim/**` has no
//  audio device and no particle system and must never acquire one — it decides
//  WHAT should happen and lets `src/game/client.hml` decide HOW.  That split is
//  what makes the queue empty during a replay observable rather than notional:
//  the counters are the proof.
//
//  It is a READER of the event bus and a WRITER of nothing but the queue.  It
//  cannot change the simulation, so skipping it cannot change the state hash —
//  which is the property that makes a replay's hash comparable to a live run's.
export fn sim_effects(p_w: object): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    s.fx_n = 0;
    if (w.replaying == 1) { let none: i32 = 0; return none; }

    let bus: object = combat_events(s.cx);
    let n: i32 = evbus_count(bus);
    let made: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        let ty: i32 = evbus_type(bus, i);
        let kind: i32 = SIM_MISS;
        if (ty == EV_SOUND)             { kind = SIM_FX_SOUND; }
        else if (ty == EV_IMPACT)       { kind = SIM_FX_PARTICLE; }
        else if (ty == EV_HITMARKER)    { kind = SIM_FX_HITMARKER; }
        else if (ty == EV_HIT_FLASH)    { kind = SIM_FX_FLASH; }
        else if (ty == EV_DAMAGE_NUMBER){ kind = SIM_FX_NUMBER; }
        else if (ty == EV_DAMAGE_TAKEN) { kind = SIM_FX_SHAKE; }
        if (kind >= 0) {
            if (fx_push(s, kind, evbus_sub(bus, i), evbus_target(bus, i),
                        evbus_x(bus, i), evbus_y(bus, i), evbus_z(bus, i)) == 1) {
                made++;
            }
        }
        i++;
    }

    // The director's four beats are cosmetic at this layer: the horn, the wave
    // start, the 0.4 s of silence before the ember rain, and the hold ending.
    let de: i32 = director_events(s.dir);
    if ((de & DIR_EV_HORN) != 0)       { if (fx_push(s, SIM_FX_SOUND, DIR_EV_HORN, 0, 0.0, 0.0, 0.0) == 1) { made++; } }
    if ((de & DIR_EV_WAVE_START) != 0) { if (fx_push(s, SIM_FX_SOUND, DIR_EV_WAVE_START, 0, 0.0, 0.0, 0.0) == 1) { made++; } }
    if ((de & DIR_EV_WAVE_CLEAR) != 0) { if (fx_push(s, SIM_FX_PARTICLE, DIR_EV_WAVE_CLEAR, 0, 0.0, 0.0, 0.0) == 1) { made++; } }
    if ((de & DIR_EV_HOLD_DONE) != 0)  { if (fx_push(s, SIM_FX_SOUND, DIR_EV_HOLD_DONE, 0, 0.0, 0.0, 0.0) == 1) { made++; } }

    s.fx_total = s.fx_total + made;
    let out: i32 = made;
    return out;
}

fn fx_push(p_s: object, p_kind: i32, p_a: i32, p_b: i32,
           p_x: f64, p_y: f64, p_z: f64): i32 {
    let s: object = p_s;
    let n: i32 = s.fx_n;
    if (n >= SIM_FX_CAP) {
        s.fx_dropped = s.fx_dropped + 1;
        let full: i32 = 0;
        return full;
    }
    let ak = s.fx_kind; ak[n] = p_kind;
    let aa = s.fx_a;    aa[n] = p_a;
    let ab = s.fx_b;    ab[n] = p_b;
    let ax = s.fx_x;    ax[n] = p_x;
    let ay = s.fx_y;    ay[n] = p_y;
    let az = s.fx_z;    az[n] = p_z;
    s.fx_n = n + 1;
    let out: i32 = 1;
    return out;
}

export fn sim_fx_count(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.fx_n; return o; }
export fn sim_fx_total(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.fx_total; return o; }
export fn sim_fx_dropped(p_w: object): i32 { let w: object = p_w; let s: object = w.sim; let o: i32 = s.fx_dropped; return o; }
export fn sim_fx_kind(p_w: object, p_i: i32): i32 { let w: object = p_w; let s: object = w.sim; let a = s.fx_kind; let o: i32 = a[p_i]; return o; }
export fn sim_fx_a(p_w: object, p_i: i32): i32 { let w: object = p_w; let s: object = w.sim; let a = s.fx_a; let o: i32 = a[p_i]; return o; }
export fn sim_fx_b(p_w: object, p_i: i32): i32 { let w: object = p_w; let s: object = w.sim; let a = s.fx_b; let o: i32 = a[p_i]; return o; }
export fn sim_fx_x(p_w: object, p_i: i32): f64 { let w: object = p_w; let s: object = w.sim; let a = s.fx_x; let o: f64 = a[p_i]; return o; }
export fn sim_fx_y(p_w: object, p_i: i32): f64 { let w: object = p_w; let s: object = w.sim; let a = s.fx_y; let o: f64 = a[p_i]; return o; }
export fn sim_fx_z(p_w: object, p_i: i32): f64 { let w: object = p_w; let s: object = w.sim; let a = s.fx_z; let o: f64 = a[p_i]; return o; }

// ===========================================================================
//  8.  THE STEP
// ===========================================================================

fn run_stage(p_w: object, p_s: object, p_id: i32) {
    let w: object = p_w;
    let s: object = p_s;
    let id: i32 = p_id;
    if (id == SIM_STAGE_COMMANDS) { stage_commands(w, s); return; }
    if (id == SIM_STAGE_MOVEMENT) { stage_movement(w, s); return; }
    if (id == SIM_STAGE_WEAPONS)  { stage_weapons(w, s); return; }
    if (id == SIM_STAGE_PROJ)     { stage_projectiles(w, s); return; }
    if (id == SIM_STAGE_AI)       { stage_ai(w, s); return; }
    if (id == SIM_STAGE_DAMAGE)   { stage_damage(w, s); return; }
    if (id == SIM_STAGE_INTERACT) { stage_interact(w, s); return; }
    if (id == SIM_STAGE_WORLD)    { stage_world(w, s); return; }
    if (id == SIM_STAGE_HISTORY)  { stage_history(w, s); return; }
    if (id == SIM_STAGE_EFFECTS)  {
        // The ONE conditional stage.  Gated here as well as inside
        // `sim_effects` so a reordering test cannot accidentally run cosmetics
        // during a replay by moving the stage.
        if (w.replaying == 0) { sim_effects(w); } else { s.fx_n = 0; }
        return;
    }
}

// ONE fixed tick.  ARCHITECTURE §5.4: `sim_step(world, tick)`.
//
// The PROLOGUE below is not a stage and cannot be reordered: the event bus must
// be empty before anything pushes into it, and `world.tick` must be current
// before any stage reads it.  Everything that IS a stage goes through
// `sim.order`.
//
// Returns the number of stages executed (SIM_STAGE_COUNT), so a caller that
// gets 0 knows the sim was never built rather than silently rendering a frozen
// world.
export fn sim_step(p_w: object, p_tick: i32): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let tick: i32 = p_tick;

    // ---- prologue ---------------------------------------------------------
    s.prev_tick = w.tick;
    w.tick = tick;
    combat_begin_tick(s.cx);

    // ---- the ten stages, through the order table --------------------------
    let ord = s.order;
    let i: i32 = 0;
    while (i < SIM_STAGE_COUNT) {
        run_stage(w, s, ord[i]);
        i++;
    }

    s.steps = s.steps + 1;
    let out: i32 = SIM_STAGE_COUNT;
    return out;
}

// The stage at position `p_i` of the executed order.
export fn sim_stage_at(p_w: object, p_i: i32): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let i: i32 = p_i;
    if (i < 0 || i >= SIM_STAGE_COUNT) { let bad: i32 = SIM_MISS; return bad; }
    let a = s.order;
    let out: i32 = a[i];
    return out;
}

// TEST HOOK.  Swap two positions in the executed order and count that it
// happened.  This exists so BUILD_PLAN W4-9's "reorder two stages and expect a
// different hash" is a test of the REAL order rather than of a copy of it.
// `sim_stat_swaps` is non-zero forever afterwards, so a build that ever called
// this is visible in the stats.
export fn sim_stage_swap(p_w: object, p_i: i32, p_j: i32): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let i: i32 = p_i;
    let j: i32 = p_j;
    if (i < 0 || i >= SIM_STAGE_COUNT) { let bad: i32 = 0; return bad; }
    if (j < 0 || j >= SIM_STAGE_COUNT) { let bad2: i32 = 0; return bad2; }
    let a = s.order;
    let t: i32 = a[i];
    a[i] = a[j];
    a[j] = t;
    s.swaps = s.swaps + 1;
    let out: i32 = 1;
    return out;
}

// Restore the documented order.
export fn sim_stage_order_reset(p_w: object): i32 {
    let w: object = p_w;
    let s: object = w.sim;
    let a = s.order;
    let i: i32 = 0;
    while (i < SIM_STAGE_COUNT) { a[i] = i; i++; }
    let out: i32 = 1;
    return out;
}

// `world.replaying`.  1 makes stage (j) a no-op; nothing else changes, which is
// exactly why a replay's hash is comparable to a live run's.
export fn sim_set_replaying(p_w: object, p_r: i32): i32 {
    let w: object = p_w;
    world_set_replaying(w, p_r);
    let out: i32 = p_r;
    return out;
}

// ===========================================================================
//  9.  THE STATE HASH — the acceptance criterion, in one number
// ===========================================================================
//  Folds every authoritative field of every entity plus every module's own
//  hash.  It does NOT fold the cosmetic queue, the effect counters or anything
//  else stage (j) touches — that is the whole point: a replay with
//  `replaying = 1` must produce the same number as the live run it is
//  reproducing, and it cannot if the number contains the cosmetics the replay
//  deliberately skipped.
//
//  Positions are folded through the 1/16 m WIRE grid rather than as raw f64
//  bits.  A hash over raw bits would flag a 1e-16 difference that the wire
//  cannot carry and the client can never see, which trains everyone to ignore
//  the hash.  Divergence that survives quantisation is divergence that would
//  desync a real client.  `move_state_hash` folds the raw IEEE bytes of the
//  PredictedState in ADDITION, so a 1e-13 movement divergence is still caught —
//  by the module that owns those bits.
fn mixh(p_h: u64, p_v: i32): u64 {
    let k: i32 = p_v;
    let u: u64 = u64(k & 2147483647);
    if (k < 0) { u = u + 2147483648; }
    let h: u64 = (p_h ^ u) * 1099511628211;
    h = h ^ (h >> 29);
    let out: u64 = h;
    return out;
}

fn mixh64(p_h: u64, p_v: u64): u64 {
    let h: u64 = (p_h ^ p_v) * 1099511628211;
    h = h ^ (h >> 29);
    let out: u64 = h;
    return out;
}

fn qpos(p_v: f64): i32 {
    let v: f64 = p_v * 16.0;
    if (v > 2147483000.0) { v = 2147483000.0; }
    if (v < -2147483000.0) { v = -2147483000.0; }
    let q: i32 = 0;
    if (v >= 0.0) { q = i32(v + 0.5); }
    if (v < 0.0)  { q = i32(v - 0.5); }
    let out: i32 = q;
    return out;
}

export fn sim_hash(p_w: object): u64 {
    let w: object = p_w;
    let s: object = w.sim;
    let h: u64 = 14695981039346656037;

    h = mixh(h, w.tick);
    h = mixh(h, w.seed);
    h = mixh(h, w.count);

    let n: i32 = w.count;
    let ids = w.id;
    let kinds = w.kind;
    let px = w.px;
    let py = w.py;
    let pz = w.pz;
    let vx = w.vx;
    let vy = w.vy;
    let vz = w.vz;
    let yaw = w.yaw;
    let pit = w.pitch;
    let hp = w.hp;
    let armor = w.armor;
    let flags = w.flags;
    let model = w.model;
    let anim = w.anim;
    let tint = w.tint;
    let weapon = w.weapon;
    let amag = w.ammo_mag;
    let i: i32 = 0;
    while (i < n) {
        h = mixh(h, ids[i]);
        h = mixh(h, kinds[i]);
        h = mixh(h, qpos(px[i]));
        h = mixh(h, qpos(py[i]));
        h = mixh(h, qpos(pz[i]));
        h = mixh(h, qpos(vx[i]));
        h = mixh(h, qpos(vy[i]));
        h = mixh(h, qpos(vz[i]));
        h = mixh(h, qpos(yaw[i]));
        h = mixh(h, qpos(pit[i]));
        h = mixh(h, hp[i]);
        h = mixh(h, armor[i]);
        h = mixh(h, flags[i]);
        h = mixh(h, model[i]);
        h = mixh(h, anim[i]);
        h = mixh(h, tint[i]);
        h = mixh(h, weapon[i]);
        h = mixh(h, amag[i]);
        i++;
    }

    // ---- the eight modules, each through its own hash --------------------
    let np: i32 = s.players;
    let psa = s.move_ps;
    let progs = s.prog;
    let k: i32 = 0;
    while (k < np) {
        h = mixh(h, move_state_hash(psa[k]));
        h = mixh(h, prog_hash(progs[k]));
        k++;
    }
    h = mixh(h, wpn_hash_all(s.wpn, np));
    h = mixh(h, evbus_hash(combat_events(s.cx)));
    h = mixh64(h, proj_state_hash(s.proj, w));
    h = mixh(h, ai_hash(s.ai, w));
    h = mixh64(h, director_hash(s.dir));
    h = mixh(h, s.loot_hash);
    h = mixh(h, s.loot_rolls);

    let out: u64 = h;
    return out;
}

// A cheaper hash for a per-tick trace: transforms only.  `tools/replay.hml`
// compares one of these per tick over 10 000 ticks, so it has to be cheap
// enough that the trace is not the measurement.
export fn sim_pos_hash(p_w: object): u64 {
    let w: object = p_w;
    let h: u64 = 14695981039346656037;
    h = mixh(h, w.tick);
    let n: i32 = w.count;
    let ids = w.id;
    let px = w.px;
    let py = w.py;
    let pz = w.pz;
    let yaw = w.yaw;
    let i: i32 = 0;
    while (i < n) {
        h = mixh(h, ids[i]);
        h = mixh(h, qpos(px[i]));
        h = mixh(h, qpos(py[i]));
        h = mixh(h, qpos(pz[i]));
        h = mixh(h, qpos(yaw[i]));
        i++;
    }
    let out: u64 = h;
    return out;
}
