// worldgen.hml — the world, as a pure function of a seed.            W3-1.
//
// ===========================================================================
// WHAT THIS FILE IS
// ===========================================================================
// A HEIGHTFIELD generator, not a voxel generator.  Everything the world is
// made of is a function of (seed, world x, world z):
//
//     worldgen_height(seed, wx, wz) -> metres          the terrain
//     worldgen_temp / worldgen_moist                   the two biome fields
//     worldgen_biome(seed, wx, wz)  -> WG_BIOME_*      biome selection
//     worldgen_shade_tier(seed, cx, cz, phase) -> 0..5 the danger gradient
//     worldgen_poi_roll(seed, cx, cz)          -> WG_POI_*
//     worldgen_chunk(seed, cx, cz, heights, biomes)    the batched form
//
// There is no state.  There is no I/O.  There is no wall clock.  There are no
// mutable top-level variables — every `export let` below is a constant, and
// every constant a hot loop needs is re-stated as a function-local literal so
// that no top-level slot is read per sample (CLAUDE.md §1 rule 3).
//
// It imports `src/core/mathx.hml` and NOTHING else — not even `@stdlib/math`
// (mathx is a leaf that calls the `__floor` / `__sqrt` builtins directly, and
// this file does the same).  No SDL, no wobbleweed, no `@stdlib/random`, no
// `@stdlib/time`.  This module is part of the future dedicated server and must
// link headless.  The `src/core/config.hml` constants it mirrors are asserted
// equal by `probe_worldgen` §A rather than imported, so that no top-level slot
// from another module is read 567 times per chunk.
//
// ===========================================================================
// DETERMINISM
// ===========================================================================
// Every random decision goes through `mathx.vnoise` / `mathx.xhash2`, whose
// mixing is entirely in `u64` (CLAUDE.md A13 — i32/i64 `* + -` TRAP on
// overflow; u64 wraps).  The only arithmetic here is f64 and small-magnitude
// i32, so the same (seed, cx, cz) produces bit-identical output on the
// interpreter and the compiler.  `probe_worldgen` pins that with checksums
// over 1 000 000 samples and is run BOTH ways.
//
// >>> SEED DERIVATION IS `^`, NEVER `+`. <<<
// `vnoise(..., seed + 31)` THROWS "Integer overflow: i32 addition" when the
// world seed is near 2^31.  (That is also a latent bug in `mathx.fbm2`, which
// derives its octave seeds with `+31` / `+97`; reported, not fixed — this file
// does not own mathx.hml.)  Every octave seed below is `seed ^ <odd constant>`,
// which cannot overflow and which `xhash2`'s avalanche decorrelates.
//
// ===========================================================================
// THE HEIGHT FIELD — 3 octaves of value noise on a 4 m grid
// ===========================================================================
//   h(x,z) = BASE + 2*AMP * ( (n96 - .5)*.48*relief
//                           + (n32 - .5)*.30
//                           + (n12 - .5)*.22 )
//
// `relief` is a smooth function of the temperature/moisture fields, in
// [0.40, 1.70].  It scales ONLY the 96 m octave, which is what gives each
// biome its terrain character (Ironpine's big cold ridges, the Fen's smooth
// flats) WITHOUT introducing a discontinuity at a biome boundary — biome is a
// hard classification of (t, m), but `relief` is continuous in (t, m), so the
// height field stays C0 across every biome edge.  The 32 m and 12 m octaves
// are never scaled: a "flat" biome still has to have local relief, because a
// flat horizon is an anti-goal (CLAUDE.md §9.5) and a chunk with no undulation
// renders as cardboard.
//
// The finest cell is 12 m against a 4 m sample grid — 3 samples per cell — so
// the stored heightfield actually resolves the octave it is carrying.  An 8 m
// finest cell measures a higher per-chunk range but aliases against the grid,
// which would put the collision surface and the visible surface in different
// places.
//
// MEASURED per-chunk relief (max - min over a chunk's 81 samples), 8 seeds
// including both i32 extremes, 51x51 chunks each = 20 808 chunks:
//     worst chunk 3.58 m   mean 10.3 m   chunks below 3.0 m: 0
// The acceptance bar is +/-1.5 m (a 3.0 m range).  See `probe_worldgen` §D,
// which re-measures it every run.  This is an EMPIRICAL floor over 20 808
// chunks, not a proof: value noise cannot guarantee a lower bound on the range
// of any particular window, and this file does not pretend otherwise.
//
// ===========================================================================
// CHUNK BUFFER LAYOUT (the contract with `chunk.hml`, W3-2)
// ===========================================================================
// `worldgen_chunk(seed, cx, cz, heights, biomes)` writes 9x9 = 81 samples,
// ROW-MAJOR with x fastest:   index = j * 9 + i,  i along +X, j along +Z
//   sample (i, j) is at world (cx*32 + i*4, cz*32 + j*4)
//   `heights` : u16 LITTLE-ENDIAN centimetres at byte offset index*2.
//               Read it back with `heights.read_u16_le(index * 2)`.
//               Needs >= 162 bytes.  Heights are clamped to [0, 65535] cm;
//               the generator's own range is ~[8 m, 56 m] so the clamp never
//               fires in practice.
//   `biomes`  : u8 WG_BIOME_* at byte offset index.  Needs >= 81 bytes.
// Row j = 8 of chunk (cx, cz) and row j = 0 of chunk (cx, cz+1) are the SAME
// world coordinates and therefore the same bytes — that is what makes the
// chunk grid C0-continuous with no seam and no stitching pass.
//
// ===========================================================================
// COST, MEASURED (hemlockc -O1, __clock min-of-7, this box is never idle)
// ===========================================================================
// A chunk is 81 samples of 7 octaves.  W7-4 replaced the per-sample `vnoise`
// calls with the lattice table described above §"THE LATTICE TABLE":
//     worldgen_chunk   0.111 ms/chunk         compiled -O1, loadavg 9.5
//                      0.725 - 0.731 ms       the per-sample vnoise it replaced
//     worldgen_height  8.1 - 9.2 us/point     compiled -O1, loaded  (unchanged:
//                      the single-point entry points still call vnoise, because
//                      one point touches one lattice cell and has nothing to
//                      amortise)
// The acceptance bar and `g_BUDGET_CHUNKGEN_MS` are both 2.0 ms, so a chunk
// now costs ~5.5 % of its per-frame allowance, down from ~34 %.
// There is no idle number for this box
// (CLAUDE.md §1.2); `probe_worldgen` §G re-measures and prints it every run and
// scales its bound by an empty-loop calibration so the same assertion holds
// interpreted.
//
// The batched path exists because a sample needs a height AND a biome, and
// both need the temperature and moisture fields.  Calling worldgen_height()
// then worldgen_biome() per sample evaluates them twice: 11 vnoise instead of
// 7.  Measured ratio 0.648 (probe §G3), i.e. the batch is 1.54x cheaper.
// ===========================================================================

import { clamp01, clampi, floori, vnoise, xhash2 } from "../core/mathx.hml";

// ---------------------------------------------------------------------------
// CONSTANTS.
// These are the module's public vocabulary.  `probe_worldgen` §A asserts every
// one of them against its `src/core/config.hml` counterpart, so the two files
// cannot drift.  Hot loops below re-state them as literals: reading a
// top-level slot 567 times per chunk is the CLAUDE.md rule-3 tax for nothing.
// ---------------------------------------------------------------------------

export let WG_CHUNK_N        = 9;        // height samples per chunk edge
export let WG_CHUNK_SAMPLES  = 81;       // WG_CHUNK_N * WG_CHUNK_N
export let WG_CHUNK_M        = 32.0;     // chunk edge, metres
export let WG_GRID_M         = 4.0;      // heightfield cell, metres
export let WG_HEIGHT_STRIDE  = 2;        // bytes per stored height (u16 LE)
export let WG_HEIGHT_SCALE_CM = 100.0;   // metres -> centimetres

// The field's shape.  BASE is chosen so the generator never produces a
// negative height (it bottoms out near 8 m), because the store is UNSIGNED.
export let WG_BASE_M         = 32.0;
export let WG_AMP_M          = 18.0;     // +/- peak of the unit-relief field
export let WG_CELL0_M        = 96.0;     // coarse octave, relief-scaled
export let WG_CELL1_M        = 32.0;     // mid octave
export let WG_CELL2_M        = 12.0;     // fine octave, 3 samples per cell
export let WG_TEMP_CELL_M    = 512.0;
export let WG_MOIST_CELL_M   = 448.0;

// Biomes.  GDD §4.3 order; this is the on-disk and on-the-wire encoding.
// NOTE (reported to the orchestrator): `src/art/biome.hml` (Wave 4) is
// specified to export `BIOME_HOLLOWFIELD..BIOME_DEEPSHADE` too, and it may not
// import `src/sim/**`.  These are `WG_`-prefixed so the two cannot collide;
// the indices belong in `src/core/config.hml` where BOTH may read them.
export let WG_BIOME_HOLLOWFIELD = 0;
export let WG_BIOME_ASHWOOD     = 1;
export let WG_BIOME_CHALKDOWNS  = 2;
export let WG_BIOME_FEN         = 3;
export let WG_BIOME_IRONPINE    = 4;
export let WG_BIOME_DEEPSHADE   = 5;
export let WG_BIOME_COUNT       = 6;

// POIs.  GDD §4.4 frequency table.
export let WG_POI_NONE     = 0;
export let WG_POI_LANTERN  = 1;
export let WG_POI_RUIN     = 2;
export let WG_POI_CARAVAN  = 3;
export let WG_POI_SHRINE   = 4;
export let WG_POI_BURROW   = 5;
export let WG_POI_COUNT    = 6;

// The shade tier ladder (GDD §4.2).
export let WG_TIER_MAX     = 5;
export let WG_TIER_M       = 200.0;      // metres from town per tier

// Ember Hollow.  GDD §5: "a small walled town at world origin", a 40x40 m
// plot, and "the town is a tier-0 island and the only guaranteed one at world
// start".  Two radii, both deliberate:
//   TIER_R   forces tier 0 — the guarantee above, at every phase, every seed.
//   BIOME_R  forces Hollowfield — you always start in the starting biome.
// Height is NOT flattened here.  Levelling the town plot is `hubgen.hml`'s job
// (Wave 4); a worldgen that flattens 2 chunks would fail its own undulation
// criterion in exactly the place the player spends the most time looking.
export let WG_TOWN_TIER_R_M  = 64.0;
export let WG_TOWN_BIOME_R_M = 96.0;

// Lantern posts.  GDD §4.4 asks for "1 per ~4 chunks, guaranteed 1 within
// 120 m of anywhere".  A per-chunk probability roll delivers the first and
// CANNOT deliver the second, so lanterns are placed structurally instead:
// exactly one per 2x2-chunk block (= 4 chunks), positioned inside the middle
// half of the block.  The worst case is then a block corner to the far corner
// of the middle half: sqrt(48^2 + 48^2) = 67.9 m, which is the guarantee.
// Everything else still rolls per chunk.
export let WG_LANTERN_BLOCK_C  = 2;      // chunks per block edge
export let WG_LANTERN_INSET_M  = 16.0;   // keep-out from the block edge
export let WG_LANTERN_MAX_D_M  = 67.9;   // proven bound on distance to nearest

// ---------------------------------------------------------------------------
// OCTAVE SEED SALTS.  Written inline as `seed ^ <constant>` at every call site
// rather than through a helper: A9b measures a Hemlock call at ~10 ns PER
// ARGUMENT, and this would be seven two-argument calls per sample — 567 calls
// and ~11 us per chunk to save writing an XOR seven times.  XOR, never `+`
// (see the header: `+` traps at the i32 extremes).
// ---------------------------------------------------------------------------

// ===========================================================================
// THE BIOME FIELDS
// ===========================================================================
// Two low-frequency fields, two octaves each so the borders are irregular
// rather than circular.  Both land in [0, 1) with a standard deviation near
// 0.147, so every threshold below is expressed relative to 0.5.

export fn worldgen_temp(p_seed: i32, p_wx: f64, p_wz: f64): f64 {
    let x: f64 = p_wx;
    let z: f64 = p_wz;
    let s: i32 = p_seed;
    let a: f64 = vnoise(x, z, 512.0, 0, s ^ 774863155);
    let b: f64 = vnoise(x, z, 171.0, 0, s ^ 2087834729);
    let out: f64 = a * 0.72 + b * 0.28;
    return out;
}

export fn worldgen_moist(p_seed: i32, p_wx: f64, p_wz: f64): f64 {
    let x: f64 = p_wx;
    let z: f64 = p_wz;
    let s: i32 = p_seed;
    let a: f64 = vnoise(x, z, 448.0, 0, s ^ 1315423911);
    let b: f64 = vnoise(x, z, 149.0, 0, s ^ 950706376);
    let out: f64 = a * 0.72 + b * 0.28;
    return out;
}

// Terrain character in [0.40, 1.70], continuous in (t, m): cold is rugged,
// wet is smooth.  Scales the 96 m octave only.
export fn worldgen_relief_tm(p_t: f64, p_m: f64): f64 {
    let t: f64 = p_t;
    let m: f64 = p_m;
    let r: f64 = clamp01(0.5 + (0.5 - t) * 1.10 - (m - 0.5) * 0.70);
    let out: f64 = 0.40 + 1.30 * r;
    return out;
}

export fn worldgen_relief(p_seed: i32, p_wx: f64, p_wz: f64): f64 {
    let t: f64 = worldgen_temp(p_seed, p_wx, p_wz);
    let m: f64 = worldgen_moist(p_seed, p_wx, p_wz);
    let out: f64 = worldgen_relief_tm(t, m);
    return out;
}

// ===========================================================================
// HEIGHT
// ===========================================================================

// The height field given a relief that the caller has already computed.  This
// is the one place the formula exists; `worldgen_height` and `worldgen_chunk`
// both route through it, so the batched path cannot drift from the point
// query.  `probe_worldgen` §E asserts they agree sample for sample.
export fn worldgen_height_rel(p_seed: i32, p_wx: f64, p_wz: f64, p_relief: f64): f64 {
    let x: f64 = p_wx;
    let z: f64 = p_wz;
    let s: i32 = p_seed;
    let rel: f64 = p_relief;
    let n0: f64 = vnoise(x, z, 96.0, 0, s);
    let n1: f64 = vnoise(x, z, 32.0, 0, s ^ 1013904223);
    let n2: f64 = vnoise(x, z, 12.0, 0, s ^ 1597334677);
    let acc: f64 = (n0 - 0.5) * 0.48 * rel + (n1 - 0.5) * 0.30 + (n2 - 0.5) * 0.22;
    let out: f64 = 32.0 + 36.0 * acc;
    return out;
}

// Terrain height in METRES at any world point.  7 `vnoise` calls.
export fn worldgen_height(p_seed: i32, p_wx: f64, p_wz: f64): f64 {
    let s: i32 = p_seed;
    let x: f64 = p_wx;
    let z: f64 = p_wz;
    let rel: f64 = worldgen_relief(s, x, z);
    let out: f64 = worldgen_height_rel(s, x, z, rel);
    return out;
}

// The stored form: unsigned centimetres, rounded half-up, clamped to u16.
export fn worldgen_height_cm(p_seed: i32, p_wx: f64, p_wz: f64): i32 {
    let h: f64 = worldgen_height(p_seed, p_wx, p_wz);
    let out: i32 = clampi(floori(h * 100.0 + 0.5), 0, 65535);
    return out;
}

// ===========================================================================
// BIOME
// ===========================================================================
// Classification of (temperature, moisture) plus two overrides:
//   - the town disc is always the starting biome
//   - Deepshade only exists beyond a distance threshold that is itself a
//     function of (t, m), so the "shade line" is an irregular front rather
//     than a drawn circle.  Cold, dry ground goes dark soonest.
// GDD §4.3 look/terrain in comments so the thresholds can be argued about.
export fn worldgen_biome_tmd(p_t: f64, p_m: f64, p_d: f64): i32 {
    let t: f64 = p_t;
    let m: f64 = p_m;
    let d: f64 = p_d;

    if (d < 96.0) {
        let town: i32 = 0;                       // WG_BIOME_HOLLOWFIELD
        return town;
    }
    // Deepshade — permanent night, alien plateaus, endgame.
    let dthr: f64 = 640.0 + 520.0 * (t + m) * 0.5;
    if (d >= dthr) {
        if (t < 0.45) {
            if (m < 0.45) {
                let deep: i32 = 5;               // WG_BIOME_DEEPSHADE
                return deep;
            }
        }
    }
    // The Fen — black water, reeds, mist.  Warm and wet.
    if (m > 0.615) {
        if (t > 0.44) {
            let fen: i32 = 3;
            return fen;
        }
    }
    // Ironpine — steep dark conifer slopes.  Cold.
    if (t < 0.425) {
        let iron: i32 = 4;
        return iron;
    }
    // Chalk Downs — pale open hills, standing stones.  Warm and dry.
    if (t > 0.585) {
        if (m < 0.475) {
            let chalk: i32 = 2;
            return chalk;
        }
    }
    // Ashwood — dead white birch, thick grey fog.  Damp.
    if (m > 0.535) {
        let ash: i32 = 1;
        return ash;
    }
    // Hollowfield — warm gold grass, gentle rolling.  The default.
    let hollow: i32 = 0;
    return hollow;
}

export fn worldgen_biome(p_seed: i32, p_wx: f64, p_wz: f64): i32 {
    let s: i32 = p_seed;
    let x: f64 = p_wx;
    let z: f64 = p_wz;
    let t: f64 = worldgen_temp(s, x, z);
    let m: f64 = worldgen_moist(s, x, z);
    // Declared-then-assigned on purpose: `let d: f64 = <call>` compiles to
    // `HmlValue d = hml_convert_to_type(...)` and stays BOXED, while
    // `let d: f64 = 0.0; d = <call>` compiles to a native `double`.
    // Verified with `hemlockc -c --emit-c`; `ci_unbox.sh` watches this name.
    let d: f64 = 0.0;
    d = __sqrt(x * x + z * z);
    let out: i32 = worldgen_biome_tmd(t, m, d);
    return out;
}

// ===========================================================================
// SHADE TIER  (GDD §4.2)
// ===========================================================================
//   base_tier(d) = clamp(floor(d / 200), 0, 5)
//   tier = clamp(base + noise_tier(chunk) + phase_bonus, 0, 5)
//   noise_tier in {-1, 0, 0, +1}, hashed per chunk
// Tier is a CHUNK property, evaluated at the chunk centre, because it drives
// fog distance and sky tint — those must not change halfway across a chunk.

// {-1, 0, 0, +1} — the pockets of "too deep, too soon".
export fn worldgen_tier_jitter(p_seed: i32, p_cx: i32, p_cz: i32): i32 {
    let h: u64 = xhash2(p_cx, p_cz, p_seed ^ 1735287159);
    let q: i32 = i32(h & 3);
    let out: i32 = 0;
    if (q == 0) { out = -1; }
    if (q == 3) { out = 1; }
    return out;
}

// Distance from town (the origin) to the CENTRE of chunk (cx, cz), in metres.
export fn worldgen_chunk_dist(p_cx: i32, p_cz: i32): f64 {
    let x: f64 = f64(p_cx) * 32.0 + 16.0;
    let z: f64 = f64(p_cz) * 32.0 + 16.0;
    let out: f64 = __sqrt(x * x + z * z);
    return out;
}

// `p_phase_bonus`: 0 day, +1 dusk, +2 night — `daycycle.hml` (W3-12) supplies
// it.  Lantern-forced tier 0 is a RUNTIME override and lives in lantern.hml;
// the only tier-0 island worldgen knows about is the town.
export fn worldgen_shade_tier(p_seed: i32, p_cx: i32, p_cz: i32, p_phase_bonus: i32): i32 {
    let cx: i32 = p_cx;
    let cz: i32 = p_cz;
    let d: f64 = 0.0;                            // declared-then-assigned: unboxes
    d = worldgen_chunk_dist(cx, cz);
    if (d < 64.0) {
        let town: i32 = 0;                       // the guaranteed tier-0 island
        return town;
    }
    let base: i32 = floori(d * 0.005);           // d / 200
    let j: i32 = worldgen_tier_jitter(p_seed, cx, cz);
    let out: i32 = clampi(base + j + p_phase_bonus, 0, 5);
    return out;
}

// ===========================================================================
// POINTS OF INTEREST  (GDD §4.4)
// ===========================================================================
// Lanterns are structural (one per 2x2-chunk block, see the constants above);
// everything else is a per-chunk hash roll.  The four rolled frequencies are
// divided by 0.75 because the roll only reaches the 3-in-4 chunks that are not
// lantern anchors — which makes the WORLD-WIDE frequency come out at the GDD's
// 1-in-6 / 1-in-10 / 1-in-14 / 1-in-20 rather than 25 % short of it.
// `probe_worldgen` §F measures all five over 250 000 chunks.

// Floor-division by the block size, correct for negative chunk coords.
export fn worldgen_block_of(p_c: i32): i32 {
    let out: i32 = floori(f64(p_c) * 0.5);
    return out;
}

// The lantern of block (bx, bz), in world metres.  Constrained to the middle
// half of the 64 m block, which is what bounds the walk to the nearest one.
export fn worldgen_lantern_x(p_seed: i32, p_bx: i32, p_bz: i32): f64 {
    let h: u64 = xhash2(p_bx, p_bz, p_seed ^ 464775923);
    let u: f64 = f64(h & 65535) * 0.0000152587890625;   // /65536, in [0,1)
    let out: f64 = f64(p_bx) * 64.0 + 16.0 + 32.0 * u;
    return out;
}

export fn worldgen_lantern_z(p_seed: i32, p_bx: i32, p_bz: i32): f64 {
    let h: u64 = xhash2(p_bx, p_bz, p_seed ^ 1103515245);
    let u: f64 = f64(h & 65535) * 0.0000152587890625;
    let out: f64 = f64(p_bz) * 64.0 + 16.0 + 32.0 * u;
    return out;
}

// 1 if this chunk is the lantern anchor of its block.
export fn worldgen_is_lantern_chunk(p_seed: i32, p_cx: i32, p_cz: i32): i32 {
    let cx: i32 = p_cx;
    let cz: i32 = p_cz;
    let bx: i32 = worldgen_block_of(cx);
    let bz: i32 = worldgen_block_of(cz);
    let lx: f64 = worldgen_lantern_x(p_seed, bx, bz);
    let lz: f64 = worldgen_lantern_z(p_seed, bx, bz);
    let ax: i32 = floori(lx * 0.03125);          // / 32 -> chunk x
    let az: i32 = floori(lz * 0.03125);
    let out: i32 = 0;
    if (ax == cx) {
        if (az == cz) { out = 1; }
    }
    return out;
}

export fn worldgen_poi_roll(p_seed: i32, p_cx: i32, p_cz: i32): i32 {
    let cx: i32 = p_cx;
    let cz: i32 = p_cz;
    if (worldgen_is_lantern_chunk(p_seed, cx, cz) == 1) {
        let lan: i32 = 1;                        // WG_POI_LANTERN
        return lan;
    }
    let h: u64 = xhash2(cx, cz, p_seed ^ 1911520717);
    let u: f64 = f64(h) * 2.3283064365386963e-10;         // [0,1)
    if (u < 0.222222222222) { let r: i32 = 2; return r; }  // ruin,    1 in 6
    if (u < 0.355555555555) { let c: i32 = 3; return c; }  // caravan, 1 in 10
    if (u < 0.450793650793) { let s: i32 = 4; return s; }  // shrine,  1 in 14
    if (u < 0.517460317460) { let b: i32 = 5; return b; }  // burrow,  1 in 20
    let none: i32 = 0;
    return none;
}

// Where the POI stands, in world metres.  For a lantern that is the block
// position; for a rolled POI it is a hashed point kept 6 m clear of the chunk
// edge so its footprint cannot straddle two chunks.  For WG_POI_NONE it is the
// chunk centre, which is a harmless answer rather than a trap value.
export fn worldgen_poi_x(p_seed: i32, p_cx: i32, p_cz: i32): f64 {
    let cx: i32 = p_cx;
    let cz: i32 = p_cz;
    if (worldgen_is_lantern_chunk(p_seed, cx, cz) == 1) {
        let bx: i32 = worldgen_block_of(cx);
        let bz: i32 = worldgen_block_of(cz);
        let lx: f64 = worldgen_lantern_x(p_seed, bx, bz);
        return lx;
    }
    if (worldgen_poi_roll(p_seed, cx, cz) == 0) {
        let mid: f64 = f64(cx) * 32.0 + 16.0;
        return mid;
    }
    let h: u64 = xhash2(cx, cz, p_seed ^ 2027808477);
    let u: f64 = f64(h & 65535) * 0.0000152587890625;
    let out: f64 = f64(cx) * 32.0 + 6.0 + 20.0 * u;
    return out;
}

export fn worldgen_poi_z(p_seed: i32, p_cx: i32, p_cz: i32): f64 {
    let cx: i32 = p_cx;
    let cz: i32 = p_cz;
    if (worldgen_is_lantern_chunk(p_seed, cx, cz) == 1) {
        let bx: i32 = worldgen_block_of(cx);
        let bz: i32 = worldgen_block_of(cz);
        let lz: f64 = worldgen_lantern_z(p_seed, bx, bz);
        return lz;
    }
    if (worldgen_poi_roll(p_seed, cx, cz) == 0) {
        let mid: f64 = f64(cz) * 32.0 + 16.0;
        return mid;
    }
    let h: u64 = xhash2(cx, cz, p_seed ^ 1442695041);
    let u: f64 = f64(h & 65535) * 0.0000152587890625;
    let out: f64 = f64(cz) * 32.0 + 6.0 + 20.0 * u;
    return out;
}

// ===========================================================================
// THE LATTICE TABLE — why this file no longer calls `vnoise` per sample
// ===========================================================================
// MEASURED, and it is the whole reason W7-4 exists.  `mathx.vnoise` costs
// **1.18 us per call** compiled -O1 (567 calls = 0.668 ms of a 0.705 ms
// chunk), and it is not the arithmetic: it is that **`u64` and `i64` locals
// never unbox in hemlockc v2.9.1**.  `--emit-c` on mathx.hml shows every
// `i64(x) & mask` compiled to `hml_parse_string_to_type` and every `*`, `^`,
// `>>` on the u64 accumulator compiled to a boxed `hml_binary_op` dispatch
// with a retain/release pair -- about fifty of them per call.  CLAUDE.md §4
// A13 tells you to do hash mixing in u64 because `i32 * + -` THROW on
// overflow; that advice is right for correctness and expensive for speed, and
// nothing in the rules said so.  REPORTED IN THE W7-4 TASK SUMMARY with a
// repro; docs/HEMLOCK_ISSUES.md is not this task's file, so no issue number is
// claimed here -- do not cite one until it exists.
//
// `mathx.hml` is `src/core/**` and is not this task's file, so the fix here is
// not to make one hash cheaper -- it is to STOP ASKING FOR THE SAME HASH OVER
// AND OVER.  A value-noise sample interpolates the four corners of one lattice
// cell.  Over a 32 m chunk sampled every 4 m, the coarse octaves have exactly
// ONE lattice cell under the whole chunk (32/512 = 0.06 of a cell), so all 81
// samples of that octave share the same four corners -- and the old code
// hashed those same four corners 81 times.
//
// So each LATTICE POINT is now hashed exactly once per octave per chunk, into
// a small table, and the 81 samples read it.  Same expressions, same operand
// order, same IEEE result -- `probe_simcost` §A asserts the new path is
// BIT-IDENTICAL to `vnoise` over 4096 chunks, and `probe_worldgen` and the
// replay hash both pin it from the other side.
//
//     lattice hashes per chunk   2268  ->  54       (42x fewer)
//     worldgen_chunk_at         0.725 ms -> 0.111 ms  (min-of-7, loadavg 9.5)
//     the worst SIM TICK        1.444 ms -> 0.584 ms  (probe_simcost, headless)
//
// ===========================================================================
// THE BATCHED FORM — one chunk into caller-owned buffers
// ===========================================================================
// The hot function in this file.  No allocation, no object literal, no
// closure, no `defer`, no `try`, no template string.  The two field
// evaluations are inlined rather than called so that `t` and `m` are computed
// ONCE per sample and shared by the height, the relief and the biome —
// calling worldgen_height() and worldgen_biome() per sample would evaluate
// them twice, at +57 % cost.
//
// Returns the number of samples written (WG_CHUNK_SAMPLES), or 0 if either
// buffer is too small — never a partial write, never a throw.
export fn worldgen_chunk(p_seed: i32, p_cx: i32, p_cz: i32,
                         p_heights: buffer, p_biomes: buffer): i32 {
    let hb: buffer = p_heights;
    let bb: buffer = p_biomes;
    if (hb.length < 162) { let bad: i32 = 0; return bad; }
    if (bb.length < 81) { let bad2: i32 = 0; return bad2; }
    let n: i32 = wg_fill(p_seed, p_cx, p_cz, hb, 0, bb, 0, 0);
    return n;
}

// ---------------------------------------------------------------------------
// THE OCTAVE SCRATCH — CALLER-OWNED, ALLOCATED PER `wg_fill`, NEVER MODULE STATE
// ---------------------------------------------------------------------------
// A8 says "allocate every buffer once at startup", and the first version of
// this did exactly that: six module-level `let g_wg_*` scratch arrays.
// `probe_worldgen` §H4 failed it immediately -- "worldgen holds no mutable
// top-level state -- 8 g_ globals" -- and H4 was right.
//
// H4 is not a style rule.  This file's contract, in its own header and in
// CLAUDE.md §7, is that the world is a PURE FUNCTION OF A SEED: it is the
// future dedicated server's terrain source, it must link headless, and it must
// be reproducible and re-entrant.  A8 is a rule about PER-FRAME allocation
// (N6); a chunk is generated about once a second while walking, so the
// exemption A8 exists to grant does not apply here and the purity does.
//
// MEASURED both ways, min-of-7, because "it is probably free" is not a number:
//     module-level scratch   0.110 ms/chunk
//     per-call scratch       0.111 ms/chunk
// against the 0.725 - 0.731 ms this replaced.  The seven allocations do not
// register above run-to-run noise -- 676 `push`es once a second is nothing
// next to 54 boxed u64 lattice hashes.  So the invariant cost nothing, and an
// earlier draft of this comment claiming "+13 us, +12 %" was quoting a
// measurement taken before the unboxing fixes below and was simply stale.
//
// The finest octave is 12 m and a chunk is 32 m, so a chunk spans at most
// 32/12 = 2.67 lattice cells -> 4 distinct indices -> 5 lattice POINTS per
// axis; WG_LAT_DIM 8 is that with margin.  `wg_field` falls back to a
// per-sample `vnoise` if an octave ever exceeded it, so adding a finer octave
// can cost speed but can NEVER silently corrupt terrain.
export let WG_LAT_DIM: i32 = 8;

fn wg_zeros(p_n: i32): array<f64> {
    let a: array<f64> = [];
    let i: i32 = 0;
    while (i < p_n) { a.push(0.0); i++; }
    let o: array<f64> = a;
    return o;
}

fn wg_zeros_i(p_n: i32): array<i32> {
    let a: array<i32> = [];
    let i: i32 = 0;
    while (i < p_n) { a.push(0); i++; }
    let o: array<i32> = a;
    return o;
}

// ---------------------------------------------------------------------------
// ONE OCTAVE OVER THE CHUNK'S 9x9 SAMPLE GRID -> `p_oct[p_off .. p_off+80]`
// ---------------------------------------------------------------------------
// BIT-IDENTICAL to `vnoise(wx, wz, p_cell, 0, p_seed)` at each of the 81
// samples.  Every expression below is copied verbatim from `mathx.vnoise`'s
// `wrap == 0` path in the same operand order, because f64 does not care WHEN
// an operation happens but does care in what order:
//
//     inv = 1/cell ; b = floor(w*inv) ; t = w*inv - b ; s = t*t*(3 - 2*t)
//     h   = cx + cy + hs ; three xorshift-multiply rounds ; * 2^-32
//     a   = n00 + (n10 - n00)*sx ; b = n01 + (n11 - n01)*sx
//     out = a + (b - a)*sy
//
// The ONE structural change is that `h` is evaluated per LATTICE POINT rather
// than per sample.  `probe_simcost` §A is the assertion that this is true.
//
// `floor(w * inv)` is non-decreasing in w, so the lattice indices this chunk
// touches are the contiguous run ix[0] .. ix[8] + 1 and a dense table is the
// right shape -- no hashing, no probing, no eviction.
//
// The seven scratch arrays are the CALLER's (see the scratch note above).
// A9b prices a Hemlock argument at ~10 ns, so seven extra arguments over seven
// calls per chunk is ~0.5 us -- below the noise on a 0.111 ms chunk, and
// measured to be so: the per-call version came out at 0.111 ms against the
// module-global version's 0.110 ms.
fn wg_field(p_ox: f64, p_oz: f64, p_cell: f64, p_seed: i32, p_off: i32,
            p_oct: array<f64>, p_lat: array<f64>, p_step: array<f64>,
            p_ixa: array<i32>, p_sxa: array<f64>,
            p_iza: array<i32>, p_sza: array<f64>) {
    let ox: f64 = p_ox;
    let oz: f64 = p_oz;
    let cell: f64 = p_cell;
    let seed: i32 = p_seed;
    let off: i32 = p_off;

    let inv: f64 = 1.0 / cell;
    let ixa: array<i32> = p_ixa;
    let sxa: array<f64> = p_sxa;
    let iza: array<i32> = p_iza;
    let sza: array<f64> = p_sza;

    // `bx`/`bz` are DECLARED-THEN-ASSIGNED (as `d` is in `wg_fill`): a
    // `let bx: f64 = __floor(fx)` keeps the local BOXED, and `i32(bx)` on a
    // boxed value compiles to `hml_parse_string_to_type`.  Verified with
    // --emit-c both ways.
    let step: array<f64> = p_step;
    let i: i32 = 0;
    while (i < 9) {
        let bx: f64 = 0.0;
        let bz: f64 = 0.0;
        let wx: f64 = ox + step[i];
        let fx: f64 = wx * inv;
        bx = __floor(fx);
        let tx: f64 = fx - bx;
        ixa[i] = i32(bx);
        sxa[i] = tx * tx * (3.0 - 2.0 * tx);

        let wz: f64 = oz + step[i];
        let fz: f64 = wz * inv;
        bz = __floor(fz);
        let tz: f64 = fz - bz;
        iza[i] = i32(bz);
        sza[i] = tz * tz * (3.0 - 2.0 * tz);
        i++;
    }

    let ix0: i32 = ixa[0];
    let iz0: i32 = iza[0];
    let nx: i32 = ixa[8] - ix0 + 2;
    let nz: i32 = iza[8] - iz0 + 2;
    // `dim` is the lattice table's ROW STRIDE and it is read from the constant,
    // never written as a literal.  `lat[a * dim + b]` and the `k + dim` /
    // `k + dim + 1` neighbour reads below all depend on it, and a baked `8` in
    // any one of them would survive a change to WG_LAT_DIM and silently
    // interpolate the wrong corner -- CLAUDE.md's "grep for every place a
    // global was baked into a literal", in a place where the symptom would be
    // subtly wrong terrain rather than a crash.  `probe_simcost` §A pins it.
    let dim: i32 = WG_LAT_DIM;
    let cap: i32 = dim;
    let oct: array<f64> = p_oct;

    // The guard, not an assumption.  An octave fine enough to span more than
    // WG_LAT_DIM - 1 lattice cells across a 32 m chunk takes the slow path and
    // stays CORRECT.
    if (nx > cap || nz > cap) {
        let j2: i32 = 0;
        while (j2 < 9) {
            let wz2: f64 = oz + step[j2];
            let r2: i32 = j2 * 9;
            let i2: i32 = 0;
            while (i2 < 9) {
                oct[off + r2 + i2] = vnoise(ox + step[i2], wz2, cell, 0, seed);
                i2++;
            }
            j2++;
        }
        return;
    }

    // ---- every lattice point this chunk touches, hashed exactly once -------
    let lat: array<f64> = p_lat;
    let ls: i64 = i64(seed) & 4294967295;
    let hs: u64 = u64(ls) * 3266489917;
    let a: i32 = 0;
    while (a < nx) {
        let lx: i64 = i64(ix0 + a) & 4294967295;
        let cx: u64 = u64(lx) * 2654435761;
        let b: i32 = 0;
        while (b < nz) {
            let ly: i64 = i64(iz0 + b) & 4294967295;
            let cy: u64 = u64(ly) * 2246822519;
            let h: u64 = cx + cy + hs;
            h = (h ^ (h >> 15)) * 2246822507;
            h = (h ^ (h >> 13)) * 3266489909;
            h = (h ^ (h >> 16)) & 4294967295;
            lat[a * dim + b] = f64(h) * 2.3283064365386963e-10;
            b++;
        }
        a++;
    }

    // ---- 81 bilinear reads -------------------------------------------------
    // >>> EVERY f64 READ OUT OF AN ARRAY IS DECLARED-THEN-ASSIGNED. <<<
    // `let n00: f64 = lat[k];` compiles to `HmlValue n00 =
    // hml_convert_to_type(..., HML_VAL_F64)` — CLAUDE.md §2's own signature
    // for a BOXED local — and then all six lerp operations below become boxed
    // `hml_binary_op` dispatches.  Declaring first and assigning second gives
    // `double n00 = hml_to_f64(...)` and native arithmetic.  This loop runs
    // 567 times per chunk and the difference is measured in §"COST" above.
    let sy: f64 = 0.0;
    let sx: f64 = 0.0;
    let n00: f64 = 0.0;
    let n10: f64 = 0.0;
    let n01: f64 = 0.0;
    let n11: f64 = 0.0;
    let j: i32 = 0;
    while (j < 9) {
        let dz: i32 = iza[j] - iz0;
        sy = sza[j];
        let row: i32 = off + j * 9;
        let i3: i32 = 0;
        while (i3 < 9) {
            let k: i32 = (ixa[i3] - ix0) * dim + dz;
            sx = sxa[i3];
            n00 = lat[k];
            n10 = lat[k + dim];
            n01 = lat[k + 1];
            n11 = lat[k + dim + 1];
            let av: f64 = n00 + (n10 - n00) * sx;
            let bv: f64 = n01 + (n11 - n01) * sx;
            oct[row + i3] = av + (bv - av) * sy;
            i3++;
        }
        j++;
    }
}

// The generator core.  Private: every public entry point routes through this
// one loop, so there is exactly one copy of the field evaluation in the file.
//   p_hoff / p_aoff : BYTE offsets into the two buffers
//   p_light         : 1 to also write 81 neutral baked-light bytes after the
//                     81 biome bytes (see worldgen_chunk_at)
fn wg_fill(p_seed: i32, p_cx: i32, p_cz: i32,
           p_hb: buffer, p_hoff: i32, p_bb: buffer, p_aoff: i32, p_light: i32): i32 {
    let hb: buffer = p_hb;
    let bb: buffer = p_bb;
    let hoff: i32 = p_hoff;
    let aoff: i32 = p_aoff;

    let s: i32 = p_seed;
    let s0: i32 = s;
    let s1: i32 = s ^ 1013904223;
    let s2: i32 = s ^ 1597334677;
    let st0: i32 = s ^ 774863155;
    let st1: i32 = s ^ 2087834729;
    let sm0: i32 = s ^ 1315423911;
    let sm1: i32 = s ^ 950706376;

    let ox: f64 = f64(p_cx) * 32.0;
    let oz: f64 = f64(p_cz) * 32.0;

    // ---- the caller-owned scratch, for this call only ---------------------
    let oct: array<f64> = wg_zeros(567);          // 7 octaves x 81 samples
    let lat: array<f64> = wg_zeros(WG_LAT_DIM * WG_LAT_DIM);
    let step: array<f64> = wg_zeros(9);           // sample offsets along an edge
    let sxa: array<f64> = wg_zeros(9);
    let sza: array<f64> = wg_zeros(9);
    let ixa: array<i32> = wg_zeros_i(9);
    let iza: array<i32> = wg_zeros_i(9);
    let q0: i32 = 0;
    while (q0 < 9) { step[q0] = f64(q0) * 4.0; q0++; }

    // The seven octaves, each evaluated over the whole 9x9 grid with its
    // lattice hashed once.  Order and salts are exactly the seven `vnoise`
    // calls this loop used to make per sample.
    wg_field(ox, oz, 512.0, st0,   0, oct, lat, step, ixa, sxa, iza, sza);  // ta
    wg_field(ox, oz, 171.0, st1,  81, oct, lat, step, ixa, sxa, iza, sza);  // tb
    wg_field(ox, oz, 448.0, sm0, 162, oct, lat, step, ixa, sxa, iza, sza);  // ma
    wg_field(ox, oz, 149.0, sm1, 243, oct, lat, step, ixa, sxa, iza, sza);  // mb
    wg_field(ox, oz,  96.0, s0,  324, oct, lat, step, ixa, sxa, iza, sza);  // n0
    wg_field(ox, oz,  32.0, s1,  405, oct, lat, step, ixa, sxa, iza, sza);  // n1
    wg_field(ox, oz,  12.0, s2,  486, oct, lat, step, ixa, sxa, iza, sza);  // n2

    // Declared-then-assigned, for the reason spelled out in `wg_field`: a
    // `let ta: f64 = oct[q];` inside the loop is a BOXED local and boxes every
    // expression it feeds.
    let ta: f64 = 0.0;
    let tb: f64 = 0.0;
    let ma: f64 = 0.0;
    let mb: f64 = 0.0;
    let n0: f64 = 0.0;
    let n1: f64 = 0.0;
    let n2: f64 = 0.0;
    let fh: f64 = 0.0;
    let d: f64 = 0.0;
    let j = 0;
    while (j < 9) {
        let wz: f64 = oz + step[j];
        let row: i32 = j * 9;
        let i = 0;
        while (i < 9) {
            let wx: f64 = ox + step[i];
            let q: i32 = row + i;

            ta = oct[q];
            tb = oct[81 + q];
            let t: f64 = ta * 0.72 + tb * 0.28;
            ma = oct[162 + q];
            mb = oct[243 + q];
            let m: f64 = ma * 0.72 + mb * 0.28;

            // relief — hand-inlined worldgen_relief_tm (A9)
            let rr: f64 = 0.5 + (0.5 - t) * 1.10 - (m - 0.5) * 0.70;
            if (rr < 0.0) { rr = 0.0; }
            if (rr > 1.0) { rr = 1.0; }
            let rel: f64 = 0.40 + 1.30 * rr;

            n0 = oct[324 + q];
            n1 = oct[405 + q];
            n2 = oct[486 + q];
            let acc: f64 = (n0 - 0.5) * 0.48 * rel + (n1 - 0.5) * 0.30 + (n2 - 0.5) * 0.22;
            let h: f64 = 32.0 + 36.0 * acc;

            // A9: `floori` hand-inlined.  `mathx.floori` keeps its `f0` local
            // BOXED (`let f0: f64 = __floor(x)`), so `i32(f0)` inside it goes
            // through `hml_parse_string_to_type` — 81 times a chunk.  The
            // declared-then-assigned form below is the same two operations
            // with a native double in between, and gives the same i32.
            fh = __floor(h * 100.0 + 0.5);
            let cm: i32 = i32(fh);
            if (cm < 0) { cm = 0; }
            if (cm > 65535) { cm = 65535; }

            d = __sqrt(wx * wx + wz * wz);
            let b: i32 = worldgen_biome_tmd(t, m, d);

            let idx: i32 = row + i;
            let o: i32 = hoff + idx * 2;
            hb[o] = cm & 255;
            hb[o + 1] = (cm >> 8) & 255;
            bb[aoff + idx] = b;

            i++;
        }
        j++;
    }
    if (p_light == 1) {
        let k = 0;
        while (k < 81) { bb[aoff + 81 + k] = 255; k++; }
    }
    let out: i32 = 81;
    return out;
}

// ---------------------------------------------------------------------------
// THE `chunk.hml` SOURCE ADAPTER
// ---------------------------------------------------------------------------
// `src/sim/chunk.hml` (W3-2) takes its terrain from an INJECTED source rather
// than importing this file, and documents the contract as
//
//     fn source(hbuf, hoff, abuf, aoff, cx, cz, seed): i32
//
// writing 81 u16-LE centimetre heights at `hoff`, 81 biome bytes at `aoff`,
// 81 baked-light bytes at `aoff + 81`, and returning one opaque META word.
// This is that function, with the arguments in worldgen's own (seed, cx, cz)
// order; the boot path's adapter is a one-line reorder.
//
// TWO THINGS TO KNOW.
//  * **worldgen does not bake light.**  Light depends on the sun angle and the
//    time of day, neither of which is a property of the world.  The 81 light
//    bytes are filled with 255 — "fully lit" — so that a chunk whose bake has
//    not run yet renders FLAT BRIGHT and obviously unfinished, rather than
//    black, which would look exactly like night and hide the bug.  `chunk.hml`
//    already owns `chunk_set_light` for the real bake to write back through.
//  * The META word packs the chunk's discrete decisions, none of which vary
//    per sample:  bits 0-2 POI kind, bits 3-5 shade tier at phase 0,
//    bits 6-7 tier jitter + 1.  Decode with worldgen_meta_*.
// Returns -1 if either buffer is too small at the given offset.
export fn worldgen_chunk_at(p_seed: i32, p_cx: i32, p_cz: i32,
                            p_heights: buffer, p_hoff: i32,
                            p_attrs: buffer, p_aoff: i32): i32 {
    let hb: buffer = p_heights;
    let bb: buffer = p_attrs;
    if (p_hoff < 0 || p_aoff < 0) { let bad: i32 = -1; return bad; }
    if (hb.length < p_hoff + 162) { let bad2: i32 = -1; return bad2; }
    if (bb.length < p_aoff + 162) { let bad3: i32 = -1; return bad3; }
    wg_fill(p_seed, p_cx, p_cz, hb, p_hoff, bb, p_aoff, 1);
    let poi: i32 = worldgen_poi_roll(p_seed, p_cx, p_cz);
    let tier: i32 = worldgen_shade_tier(p_seed, p_cx, p_cz, 0);
    let jit: i32 = worldgen_tier_jitter(p_seed, p_cx, p_cz) + 1;
    let out: i32 = poi | (tier << 3) | (jit << 6);
    return out;
}

export fn worldgen_meta_poi(p_meta: i32): i32 {
    let out: i32 = p_meta & 7;
    return out;
}

export fn worldgen_meta_tier(p_meta: i32): i32 {
    let out: i32 = (p_meta >> 3) & 7;
    return out;
}

export fn worldgen_meta_jitter(p_meta: i32): i32 {
    let out: i32 = ((p_meta >> 6) & 3) - 1;
    return out;
}

// Read a height back out of a `worldgen_chunk` buffer, in metres.  Provided so
// nothing downstream has to re-derive the u16-little-endian-centimetres
// layout by hand.
export fn worldgen_chunk_height_m(p_heights: buffer, p_i: i32, p_j: i32): f64 {
    let hb: buffer = p_heights;
    let o: i32 = (p_j * 9 + p_i) * 2;
    let lo: i32 = hb[o];
    let hi: i32 = hb[o + 1];
    let out: f64 = f64(lo + hi * 256) * 0.01;
    return out;
}

// ===========================================================================
// MULTI-SITE SELECTION — the settlement anchor lattice.   DIRECTION.md §8.
// ===========================================================================
// > Owner: "is it possible for settlements to be travelable by foot? ... you
// > would need to have logic to prevent the seed from putting places too close"
//
// This block is the WHERE-CAN-A-TOWN-BE half of that.  It answers, purely from
// the seed, two questions and no others:
//
//     * which 1200 m cells of the world hold a settlement at all
//     * which 81 world points inside such a cell are the candidate centres
//
// It does NOT score them.  Scoring needs `settle_site_score`, which needs the
// SETTLEMENT.md §1.3 criteria, which live in `src/sim/settle.hml`.  Putting the
// lattice here and the scorer there is what keeps the dependency acyclic:
// settle.hml imports worldgen.hml and never the reverse.
//
// ---------------------------------------------------------------------------
// WHY A JITTERED CELL LATTICE AND NOT DART-THROWING
// ---------------------------------------------------------------------------
// DIRECTION.md §8 asks for "deterministic blue-noise / Poisson-disc sampling
// with a minimum radius, seeded".  Classic dart-throwing needs a global
// accept/reject pass over the whole world and therefore global state; it cannot
// answer "is there a town near (x, z)?" without generating every town first.
// That is exactly the property a streaming open world cannot afford, and it is
// the property `worldgen` has protected everywhere else (lanterns are placed
// STRUCTURALLY, one per 2x2 block, for the same reason — see the header).
//
// So the sampler is a jittered cell lattice with a HARD, PROVABLE separation
// bound instead of a statistical one:
//
//     cell edge                 CELL     = 1200 m     (DIRECTION.md's typical)
//     anchor jitter, per axis   JITTER   = +/- 52 m
//     candidate lattice         9 x 9 at 12 m         (SETTLEMENT.md §1.3)
//     => max deviation of a chosen site from its cell centre, per axis:
//            DEV = JITTER + (9 - 1)/2 * 12 = 52 + 48 = 100 m
//     => two sites in ADJACENT cells differ on that axis by at least
//            CELL - 2*DEV = 1200 - 200 = 1000 m = WG_SITE_MIN_SEP_M
//
// which is DIRECTION.md §8's "minimum separation ~1000 m guarantees real wild
// between two settlements even at full City growth (320 + 320 = 640 m of
// rings)".  Non-adjacent cells are trivially further.  The bound is ARITHMETIC,
// not measured — `probe_settle` §S measures it too, over 8 seeds x 441 cells,
// precisely because an arithmetic bound that nobody re-checks is a comment.
//
// Blue-noise irregularity comes from OCCUPANCY, not from the lattice: roughly
// three cells in five hold a settlement (`worldgen_site_occupied_roll`), so the
// pattern the player walks through is a sparse irregular scatter at 1000 -
// 2700 m spacing, not a grid of towns.  A cell that rolls empty is a cell whose
// wild you cross on the way somewhere.
//
// ---------------------------------------------------------------------------
// CELL (0, 0) IS THE HOME CELL AND IS SPECIAL, DELIBERATELY
// ---------------------------------------------------------------------------
// SETTLEMENT.md §1.1 requires the tutorial settlement's centre to lie inside the
// +/-48 m square around the world origin, because `worldgen_shade_tier` forces
// tier 0 inside 64 m and `worldgen_biome_tmd` forces Hollowfield inside 96 m and
// neither takes a settlement position.  So cell (0, 0) has ZERO anchor jitter —
// its 81 candidates are exactly the +/-48 m lattice that document specifies —
// and it is ALWAYS occupied.  Every other cell jitters.  The separation proof
// above is unaffected: zero jitter is inside the +/-52 m bound.
// ===========================================================================

export let WG_SITE_CELL_M     = 1200.0;   // settlement cell edge, metres
export let WG_SITE_MIN_SEP_M  = 1000.0;   // proven lower bound on separation
export let WG_SITE_JITTER_M   = 52.0;     // anchor jitter half-range, per axis
export let WG_SITE_LAT_N      = 9;        // candidate lattice edge
export let WG_SITE_LAT_STEP_M = 12.0;     // candidate lattice pitch
export let WG_SITE_CANDIDATES = 81;       // WG_SITE_LAT_N * WG_SITE_LAT_N
export let WG_SITE_MAX_DEV_M  = 100.0;    // JITTER + 4 * LAT_STEP; see the proof
export let WG_SITE_OCCUPANCY  = 0.60;     // target fraction of cells with a town

// World metres -> settlement cell coordinate.  Floor division, correct for
// negatives: cell 0 spans [-600, +600) so the origin sits at its centre.
export fn worldgen_site_cell_of(p_w: f64): i32 {
    let w: f64 = p_w;
    let out: i32 = floori((w + 600.0) * 0.0008333333333333334);   // /1200
    return out;
}

// Centre of cell (gx, gz), in world metres.
export fn worldgen_site_cell_cx(p_gx: i32): f64 {
    let out: f64 = f64(p_gx) * 1200.0;
    return out;
}

export fn worldgen_site_cell_cz(p_gz: i32): f64 {
    let out: f64 = f64(p_gz) * 1200.0;
    return out;
}

// The jittered anchor of a cell — the centre of its 9x9 candidate lattice.
// Cell (0, 0) does not jitter (see the header).
export fn worldgen_site_anchor_x(p_seed: i32, p_gx: i32, p_gz: i32): f64 {
    let gx: i32 = p_gx;
    let gz: i32 = p_gz;
    let c: f64 = f64(gx) * 1200.0;
    if (gx == 0) {
        if (gz == 0) { let home: f64 = c; return home; }
    }
    let h: u64 = xhash2(gx, gz, p_seed ^ 1442695041);
    let u: f64 = f64(h & 65535) * 0.0000152587890625;    // [0, 1)
    let out: f64 = c + (u - 0.5) * 104.0;                // +/- 52 m
    return out;
}

export fn worldgen_site_anchor_z(p_seed: i32, p_gx: i32, p_gz: i32): f64 {
    let gx: i32 = p_gx;
    let gz: i32 = p_gz;
    let c: f64 = f64(gz) * 1200.0;
    if (gx == 0) {
        if (gz == 0) { let home: f64 = c; return home; }
    }
    let h: u64 = xhash2(gx, gz, p_seed ^ 1103515245);
    let u: f64 = f64(h & 65535) * 0.0000152587890625;
    let out: f64 = c + (u - 0.5) * 104.0;
    return out;
}

// Candidate k of cell (gx, gz), k in 0..80, on the 9x9 / 12 m lattice.
// k = j * 9 + i, i along +X and j along +Z — the same row-major order
// `worldgen_chunk` uses, so nothing downstream has to remember two conventions.
export fn worldgen_site_cand_x(p_seed: i32, p_gx: i32, p_gz: i32, p_k: i32): f64 {
    let k: i32 = clampi(p_k, 0, 80);
    let i: i32 = k % 9;
    let a: f64 = worldgen_site_anchor_x(p_seed, p_gx, p_gz);
    let out: f64 = a + f64(i - 4) * 12.0;
    return out;
}

export fn worldgen_site_cand_z(p_seed: i32, p_gx: i32, p_gz: i32, p_k: i32): f64 {
    let k: i32 = clampi(p_k, 0, 80);
    let j: i32 = (k - (k % 9)) / 9;
    let a: f64 = worldgen_site_anchor_z(p_seed, p_gx, p_gz);
    let out: f64 = a + f64(j - 4) * 12.0;
    return out;
}

// 1 if this cell holds a settlement at all.  Cell (0, 0) always does — it is
// the one the player wakes up in.  Everything else is a hash roll at
// WG_SITE_OCCUPANCY.  This is the blue-noise term: the lattice is regular, the
// OCCUPANCY is not, and it is occupancy the player experiences as spacing.
export fn worldgen_site_occupied_roll(p_seed: i32, p_gx: i32, p_gz: i32): i32 {
    let gx: i32 = p_gx;
    let gz: i32 = p_gz;
    if (gx == 0) {
        if (gz == 0) { let home: i32 = 1; return home; }
    }
    let h: u64 = xhash2(gx, gz, p_seed ^ 1911520717);
    let u: f64 = f64(h) * 2.3283064365386963e-10;        // [0, 1)
    let out: i32 = 0;
    if (u < 0.60) { out = 1; }
    return out;
}
