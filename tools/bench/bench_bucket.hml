// bench_bucket.hml — how big should the painter's ordering table be?
//
// The counting sort pays O(NB) twice per frame (clear + prefix scan) on top of
// O(n) over the triangles, so a huge table costs real time at low triangle
// counts. This measures the fixed per-frame cost of the table itself against
// NB, and the resulting depth quantum, so PERF.md can recommend a size.
//
// Also compares a Hemlock array for the counters against a raw i32 buffer.

import { time_ms } from "@stdlib/time";

let FRAMES = 2000;
let sink = 0;

fn bench_array(NB: i32, n: i32, depths): f64 {
    let counts = [];
    for (let i = 0; i <= NB; i++) { counts.push(0); }
    let out = [];
    for (let i = 0; i < n; i++) { out.push(0); }
    let scale = NB / 128.0;
    let t0 = time_ms();
    for (let f = 0; f < FRAMES; f++) {
        for (let i = 0; i < NB; i++) { counts[i] = 0; }
        for (let i = 0; i < n; i++) {
            let k = i32(depths[i] * scale);
            if (k >= NB) { k = NB - 1; } if (k < 0) { k = 0; }
            counts[k] = counts[k] + 1;
        }
        let acc = 0;
        for (let i = NB - 1; i >= 0; i--) { let c = counts[i]; counts[i] = acc; acc = acc + c; }
        for (let i = 0; i < n; i++) {
            let k = i32(depths[i] * scale);
            if (k >= NB) { k = NB - 1; } if (k < 0) { k = 0; }
            out[counts[k]] = i;
            counts[k] = counts[k] + 1;
        }
        sink = sink + out[0];
    }
    return (time_ms() - t0) / FRAMES;
}

fn bench_ptr(NB: i32, n: i32, dbuf: ptr): f64 {
    let counts = alloc((NB + 1) * 4);
    let out = alloc(n * 4);
    let scale = NB / 128.0;
    let t0 = time_ms();
    for (let f = 0; f < FRAMES; f++) {
        memset(counts, 0, NB * 4);
        for (let i = 0; i < n; i++) {
            let k = i32(ptr_deref_f64(ptr_offset(dbuf, i * 8, 1)) * scale);
            if (k >= NB) { k = NB - 1; } if (k < 0) { k = 0; }
            let o = ptr_offset(counts, k * 4, 1);
            ptr_write_i32(o, ptr_deref_i32(o) + 1);
        }
        let acc = 0;
        for (let i = NB - 1; i >= 0; i--) {
            let o = ptr_offset(counts, i * 4, 1);
            let c = ptr_deref_i32(o);
            ptr_write_i32(o, acc);
            acc = acc + c;
        }
        for (let i = 0; i < n; i++) {
            let k = i32(ptr_deref_f64(ptr_offset(dbuf, i * 8, 1)) * scale);
            if (k >= NB) { k = NB - 1; } if (k < 0) { k = 0; }
            let o = ptr_offset(counts, k * 4, 1);
            let slot = ptr_deref_i32(o);
            ptr_write_i32(ptr_offset(out, slot * 4, 1), i);
            ptr_write_i32(o, slot + 1);
        }
        sink = sink + ptr_deref_i32(out);
    }
    let r = (time_ms() - t0) / FRAMES;
    free(counts); free(out);
    return r;
}

fn hash01(n: i32): f64 {
    let m: i64 = 4294967295;
    let x: i64 = (i64(n) * 2654435761) & m;
    x = ((x ^ (x >> 13)) * 1274126177) & m;
    x = x ^ (x >> 16);
    return (x & 65535) / 65536.0;
}

fn main() {
    for (n in [2000, 8000]) {
        let depths = [];
        let dbuf = alloc(n * 8);
        for (let i = 0; i < n; i++) {
            let d = hash01(i) * 100.0;
            depths.push(d);
            ptr_write_f64(ptr_offset(dbuf, i * 8, 1), d);
        }
        for (NB in [256, 512, 1024, 2048, 4096, 8192, 16384]) {
            let a = bench_array(NB, n, depths);
            let p = bench_ptr(NB, n, dbuf);
            // depth quantum over a 128-unit draw distance
            let q = 128.0 / NB;
            print(`BUCKET n=${n} NB=${NB} array_ms=${a} ptr_ms=${p} quantum_m=${q}`);
        }
        free(dbuf);
    }
    print(`sink=${sink % 1000003}`);
}

main();
