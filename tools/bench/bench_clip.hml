// bench_clip.hml — what do the clip functions actually cost?
//
// The main pipeline benchmark keeps every triangle fully on screen, so both
// clip functions take their early-exit fast path. That is the common case, but
// the proposed flat path REJECTS straddling triangles instead of clipping them
// and must fall back to the object path for those — so we need the price of
// each case separately to know how big that fallback is allowed to be.
//
// Cases measured, per triangle:
//   near_accept  all three vertices in front of the near plane (fast path)
//   near_reject  all three behind (fast path)
//   near_split   straddling -> real Sutherland-Hodgman, allocates 1-2 triangles
//   rect_accept  fully inside the guard band (fast path)
//   rect_clip    straddling the guard band -> 4 half-plane passes + closures

import { time_ms } from "@stdlib/time";
import { clip_tri_near, clip_tri_rect } from "../../../wobbleweed/src/clip.hml";

let N = 200000;
let sink = 0.0;

fn cvx(x: f64, y: f64, z: f64, w: f64) {
    return { x: x, y: y, z: z, w: w, u: 0.0, v: 0.0, l: 1.0 };
}
fn svx(x: f64, y: f64) {
    return { x: x, y: y, z: 0.5, u: 0.0, v: 0.0, r: 200, g: 200, b: 200 };
}

fn report(name: string, net: f64, count: i32) {
    print(`CLIP ${name} net_ms=${net} ns_per_tri=${(net * 1000000.0) / count}`);
}

fn main() {
    // ---- baseline: build the vertices but do not clip ----
    let t0 = time_ms();
    for (let k = 0; k < N; k++) {
        let a = cvx(0.1, 0.1, 0.5, 1.0);
        sink = sink + a.x;
    }
    let base_cv = time_ms() - t0;
    print(`CLIP baseline_vertex_build net_ms=${base_cv}`);

    // ---- near plane: all in front (ndist > 0 for all three) ----
    let a1 = cvx(0.1, 0.1, 0.5, 1.0);
    let b1 = cvx(0.3, 0.1, 0.5, 1.0);
    let c1 = cvx(0.2, 0.3, 0.5, 1.0);
    t0 = time_ms();
    for (let k = 0; k < N; k++) {
        let r = clip_tri_near(a1, b1, c1);
        sink = sink + r.length;
    }
    report("near_accept", time_ms() - t0, N);

    // ---- near plane: all behind ----
    let a2 = cvx(0.1, 0.1, 0.0 - 2.0, 1.0);
    let b2 = cvx(0.3, 0.1, 0.0 - 2.0, 1.0);
    let c2 = cvx(0.2, 0.3, 0.0 - 2.0, 1.0);
    t0 = time_ms();
    for (let k = 0; k < N; k++) {
        let r = clip_tri_near(a2, b2, c2);
        sink = sink + r.length;
    }
    report("near_reject", time_ms() - t0, N);

    // ---- near plane: straddling (one vertex behind) ----
    let a3 = cvx(0.1, 0.1, 0.5, 1.0);
    let b3 = cvx(0.3, 0.1, 0.5, 1.0);
    let c3 = cvx(0.2, 0.3, 0.0 - 2.0, 1.0);
    t0 = time_ms();
    for (let k = 0; k < N; k++) {
        let r = clip_tri_near(a3, b3, c3);
        sink = sink + r.length;
    }
    report("near_split_1behind", time_ms() - t0, N);

    // ---- near plane: straddling (two vertices behind) ----
    let c4 = cvx(0.2, 0.3, 0.0 - 2.0, 1.0);
    let b4 = cvx(0.3, 0.1, 0.0 - 2.0, 1.0);
    t0 = time_ms();
    for (let k = 0; k < N; k++) {
        let r = clip_tri_near(a3, b4, c4);
        sink = sink + r.length;
    }
    report("near_split_2behind", time_ms() - t0, N);

    // ---- guard-band rect: fully inside ----
    let W = 320.0; let H = 240.0; let m = 2.0 * W;
    let p0 = svx(50.0, 50.0); let p1 = svx(200.0, 60.0); let p2 = svx(120.0, 180.0);
    t0 = time_ms();
    for (let k = 0; k < N; k++) {
        let r = clip_tri_rect(p0, p1, p2, 0.0 - m, 0.0 - m, W + m, H + m);
        sink = sink + r.length;
    }
    report("rect_accept", time_ms() - t0, N);

    // ---- guard-band rect: straddling the band ----
    let q0 = svx(0.0 - 700.0, 50.0); let q1 = svx(200.0, 60.0); let q2 = svx(120.0, 900.0);
    t0 = time_ms();
    for (let k = 0; k < N; k++) {
        let r = clip_tri_rect(q0, q1, q2, 0.0 - m, 0.0 - m, W + m, H + m);
        sink = sink + r.length;
    }
    report("rect_clip", time_ms() - t0, N);

    print(`sink=${i64(sink) % 1000003}`);
}

main();
