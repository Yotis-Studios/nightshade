// bench_entities.hml — AoS objects vs SoA arrays vs SoA buffers for entities.
//
// 2000 entities, position += velocity * dt, 200 ticks.
//
// Build: hemlockc -O3 bench_entities.hml -o /tmp/b_ent

import { time_ms } from "@stdlib/time";

let ENTS: i32 = 2000;
let TICKS: i32 = 200;

// --- A: array of objects (AoS) ---
fn make_aos(n0: i32) {
    let n: i32 = n0;
    let a = [];
    a.reserve(n);
    for (let i = 0; i < n; i++) {
        a.push({ x: 0.0, y: 0.0, z: 0.0, vx: 1.0, vy: 0.5, vz: 0.25, hp: 100, alive: true });
    }
    return a;
}

fn tick_aos(ents, n0: i32, dt0: f64): i32 {
    let n: i32 = n0;
    let dt: f64 = dt0;
    for (let i = 0; i < n; i++) {
        let e = ents[i];
        e.x = e.x + e.vx * dt;
        e.y = e.y + e.vy * dt;
        e.z = e.z + e.vz * dt;
    }
    let out: i32 = n;
    return out;
}

// --- B: struct of arrays, Hemlock arrays ---
fn make_soa_arrays(n0: i32) {
    let n: i32 = n0;
    let xs: array<f64> = []; let ys: array<f64> = []; let zs: array<f64> = [];
    let vx: array<f64> = []; let vy: array<f64> = []; let vz: array<f64> = [];
    xs.reserve(n); ys.reserve(n); zs.reserve(n);
    vx.reserve(n); vy.reserve(n); vz.reserve(n);
    for (let i = 0; i < n; i++) {
        xs.push(0.0); ys.push(0.0); zs.push(0.0);
        vx.push(1.0); vy.push(0.5); vz.push(0.25);
    }
    return { xs: xs, ys: ys, zs: zs, vx: vx, vy: vy, vz: vz };
}

fn tick_soa_arrays(xs, ys, zs, vx, vy, vz, n0: i32, dt0: f64): i32 {
    let n: i32 = n0;
    let dt: f64 = dt0;
    for (let i = 0; i < n; i++) {
        xs[i] = xs[i] + vx[i] * dt;
        ys[i] = ys[i] + vy[i] * dt;
        zs[i] = zs[i] + vz[i] * dt;
    }
    let out: i32 = n;
    return out;
}

// --- C: struct of arrays, raw f64 pointers ---
fn tick_soa_ptr(px: ptr, py: ptr, pz: ptr, pvx: ptr, pvy: ptr, pvz: ptr,
                n0: i32, dt0: f64): i32 {
    let n: i32 = n0;
    let dt: f64 = dt0;
    for (let i = 0; i < n; i++) {
        let o: i32 = i * 8;
        let x: f64 = ptr_read_f64(ptr_offset(px, o, 1));
        let v: f64 = ptr_read_f64(ptr_offset(pvx, o, 1));
        ptr_write_f64(ptr_offset(px, o, 1), x + v * dt);
        let y: f64 = ptr_read_f64(ptr_offset(py, o, 1));
        let w: f64 = ptr_read_f64(ptr_offset(pvy, o, 1));
        ptr_write_f64(ptr_offset(py, o, 1), y + w * dt);
        let z: f64 = ptr_read_f64(ptr_offset(pz, o, 1));
        let u: f64 = ptr_read_f64(ptr_offset(pvz, o, 1));
        ptr_write_f64(ptr_offset(pz, o, 1), z + u * dt);
    }
    let out: i32 = n;
    return out;
}

// --- D: one interleaved f64 buffer, 6 lanes per entity ---
fn tick_interleaved(p: ptr, n0: i32, dt0: f64): i32 {
    let n: i32 = n0;
    let dt: f64 = dt0;
    for (let i = 0; i < n; i++) {
        let b: i32 = i * 48;
        let x: f64 = ptr_read_f64(ptr_offset(p, b, 1));
        let y: f64 = ptr_read_f64(ptr_offset(p, b + 8, 1));
        let z: f64 = ptr_read_f64(ptr_offset(p, b + 16, 1));
        let vx: f64 = ptr_read_f64(ptr_offset(p, b + 24, 1));
        let vy: f64 = ptr_read_f64(ptr_offset(p, b + 32, 1));
        let vz: f64 = ptr_read_f64(ptr_offset(p, b + 40, 1));
        ptr_write_f64(ptr_offset(p, b, 1), x + vx * dt);
        ptr_write_f64(ptr_offset(p, b + 8, 1), y + vy * dt);
        ptr_write_f64(ptr_offset(p, b + 16, 1), z + vz * dt);
    }
    let out: i32 = n;
    return out;
}

print(`--- ${ENTS} entities x ${TICKS} ticks ---`);

let AOS = make_aos(ENTS);
let t0 = time_ms();
for (let t = 0; t < TICKS; t++) { tick_aos(AOS, ENTS, 0.016); }
let t1 = time_ms();
print(`A array-of-objects   : ${t1 - t0} ms total = ${(t1 - t0) / TICKS} ms/tick`);

let S = make_soa_arrays(ENTS);
let t2 = time_ms();
for (let t = 0; t < TICKS; t++) { tick_soa_arrays(S.xs, S.ys, S.zs, S.vx, S.vy, S.vz, ENTS, 0.016); }
let t3 = time_ms();
print(`B SoA hemlock arrays : ${t3 - t2} ms total = ${(t3 - t2) / TICKS} ms/tick`);

let PX: ptr = alloc(ENTS * 8); let PY: ptr = alloc(ENTS * 8); let PZ: ptr = alloc(ENTS * 8);
let PVX: ptr = alloc(ENTS * 8); let PVY: ptr = alloc(ENTS * 8); let PVZ: ptr = alloc(ENTS * 8);
memset(PX, 0, ENTS * 8); memset(PY, 0, ENTS * 8); memset(PZ, 0, ENTS * 8);
memset(PVX, 0, ENTS * 8); memset(PVY, 0, ENTS * 8); memset(PVZ, 0, ENTS * 8);
let t4 = time_ms();
for (let t = 0; t < TICKS; t++) { tick_soa_ptr(PX, PY, PZ, PVX, PVY, PVZ, ENTS, 0.016); }
let t5 = time_ms();
print(`C SoA raw f64 ptrs   : ${t5 - t4} ms total = ${(t5 - t4) / TICKS} ms/tick`);

let IL: ptr = alloc(ENTS * 48);
memset(IL, 0, ENTS * 48);
let t6 = time_ms();
for (let t = 0; t < TICKS; t++) { tick_interleaved(IL, ENTS, 0.016); }
let t7 = time_ms();
print(`D interleaved buffer : ${t7 - t6} ms total = ${(t7 - t6) / TICKS} ms/tick`);

free(PX); free(PY); free(PZ); free(PVX); free(PVY); free(PVZ); free(IL);
