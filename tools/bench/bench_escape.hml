// bench_escape.hml — the `return acc;` unboxing killer, and how to dodge it.
//
// The compiler's escape analysis treats `return <bare ident>;` as an escape and
// refuses to give that variable native C storage. It stays a boxed HmlValue and
// every `acc = acc + x` becomes a runtime-dispatched hml_binary_op.
//
// Copying into a throwaway local right before the return keeps the hot variable
// native (a plain `let out = acc;` is NOT an escape).
//
// NOTE: `acc + 0.0` / `acc * 1.0` are folded away by the AST optimizer, so they
// do NOT work as an escape dodge — they fold straight back to `return acc;`.
//
// Build: hemlockc -O3 bench_escape.hml -o /tmp/b_escape

import { time_ms } from "@stdlib/time";

let ITERS: i32 = 50000000;

// acc escapes via `return acc;`  -> stays HmlValue (boxed, dispatched)
fn f64_boxed(n: i32): f64 {
    let lim: i32 = n;
    let acc: f64 = 0.0;
    for (let i = 0; i < lim; i++) { acc = acc + 1.5; }
    return acc;
}

// acc copied out first -> native `double acc`
fn f64_native(n: i32): f64 {
    let lim: i32 = n;
    let acc: f64 = 0.0;
    for (let i = 0; i < lim; i++) { acc = acc + 1.5; }
    let out: f64 = acc;
    return out;
}

fn i32_boxed(n: i32): i32 {
    let lim: i32 = n;
    let acc: i32 = 0;
    for (let i = 0; i < lim; i++) { acc = acc + 3; }
    return acc;
}

fn i32_native(n: i32): i32 {
    let lim: i32 = n;
    let acc: i32 = 0;
    for (let i = 0; i < lim; i++) { acc = acc + 3; }
    let out: i32 = acc;
    return out;
}

// A closure literal ANYWHERE later in the same block forces boxing
// (escape analysis is conservative: EXPR_FUNCTION => escapes).
fn f64_closure_in_scope(n: i32): f64 {
    let lim: i32 = n;
    let acc: f64 = 0.0;
    for (let i = 0; i < lim; i++) { acc = acc + 1.5; }
    let g = fn(z) { return z; };
    let out: f64 = acc;
    return out;
}

// Arithmetic on function parameters is never unboxed.
fn f64_param_arith(k: f64, n: i32): f64 {
    let lim: i32 = n;
    let acc: f64 = 0.0;
    for (let i = 0; i < lim; i++) { acc = acc + k; }
    let out: f64 = acc;
    return out;
}

// Same, but the parameter is copied to a local first.
fn f64_param_copied(k: f64, n: i32): f64 {
    let lim: i32 = n;
    let lk: f64 = k;
    let acc: f64 = 0.0;
    for (let i = 0; i < lim; i++) { acc = acc + lk; }
    let out: f64 = acc;
    return out;
}

let t0 = time_ms(); let r0 = f64_boxed(ITERS);            let t1 = time_ms();
let r1 = f64_native(ITERS);                               let t2 = time_ms();
let r2 = i32_boxed(ITERS);                                let t3 = time_ms();
let r3 = i32_native(ITERS);                               let t4 = time_ms();
let r4 = f64_closure_in_scope(ITERS);                     let t5 = time_ms();
let r5 = f64_param_arith(1.5, ITERS);                     let t6 = time_ms();
let r6 = f64_param_copied(1.5, ITERS);                    let t7 = time_ms();

print(`--- ${ITERS} iterations of acc = acc + k ---`);
print(`f64 'return acc;'            : ${t1 - t0} ms  (${r0})`);
print(`f64 copy-out (native)        : ${t2 - t1} ms  (${r1})`);
print(`i32 'return acc;'            : ${t3 - t2} ms  (${r2})`);
print(`i32 copy-out (native)        : ${t4 - t3} ms  (${r3})`);
print(`f64 closure later in block   : ${t5 - t4} ms  (${r4})`);
print(`f64 param operand            : ${t6 - t5} ms  (${r5})`);
print(`f64 param copied to local    : ${t7 - t6} ms  (${r6})`);
