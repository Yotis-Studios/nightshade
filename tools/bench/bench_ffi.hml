// bench_ffi.hml — cost of an `extern fn` FFI call (SDL calls are all FFI).
//
// Build: hemlockc -O3 bench_ffi.hml -o /tmp/b_ffi

import { time_ms } from "@stdlib/time";
import "libm.so.6";

extern fn fabs(x: f64): f64;
extern fn fmax(a: f64, b: f64): f64;

fn hml_fabs(x: f64): f64 { if (x < 0.0) { return 0.0 - x; } return x; }

let N: i32 = 5000000;

fn f_ffi1(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + fabs(-1.5); }
    let out: f64 = acc; return out;
}
fn f_ffi2(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + fmax(1.5, 0.5); }
    let out: f64 = acc; return out;
}
fn f_hml(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + hml_fabs(-1.5); }
    let out: f64 = acc; return out;
}
fn f_none(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + 1.5; }
    let out: f64 = acc; return out;
}

let t0 = time_ms(); let a = f_none(N); let t1 = time_ms();
let b = f_hml(N);                      let t2 = time_ms();
let c = f_ffi1(N);                     let t3 = time_ms();
let d = f_ffi2(N);                     let t4 = time_ms();
print(`--- ${N} iterations ---`);
print(`no call              : ${t1 - t0} ms`);
print(`hemlock fn call      : ${t2 - t1} ms`);
print(`extern fn, 1 f64 arg : ${t3 - t2} ms`);
print(`extern fn, 2 f64 args: ${t4 - t3} ms`);
