// bench_float_storage.hml — how should we hold a large array of floats?
//
// Compares: dynamic array, typed array<f64>, buffer via ptr_*, raw ptr via
// ptr_*, and a hoisted base pointer. Every kernel uses the "copy-out" trick
// (`let out = acc; return out;`) so the accumulator is a native C double and
// the measurement is of the *storage*, not of accumulator boxing. N/REPS are
// copied into function-local typed vars for the same reason (top-level "main"
// variables are never unboxed).
//
// Build:  hemlockc -O3 bench_float_storage.hml -o /tmp/b_float
// Run:    /tmp/b_float

import { time_ms } from "@stdlib/time";

let N: i32 = 1000000;
let REPS: i32 = 10;

fn bench_dyn_array(n0: i32, reps0: i32): f64 {
    let n: i32 = n0; let reps: i32 = reps0;
    let t0 = time_ms();
    let a = [];
    for (let i = 0; i < n; i++) { a.push(0.0); }
    let acc: f64 = 0.0;
    for (let r = 0; r < reps; r++) {
        for (let i = 0; i < n; i++) { a[i] = i * 0.5; }
        for (let i = 0; i < n; i++) { acc = acc + a[i]; }
    }
    let t1 = time_ms();
    print(`dyn array           : ${t1 - t0} ms   (checksum ${acc})`);
    let out: f64 = acc;
    return out;
}

fn bench_typed_array(n0: i32, reps0: i32): f64 {
    let n: i32 = n0; let reps: i32 = reps0;
    let t0 = time_ms();
    let a: array<f64> = [];
    for (let i = 0; i < n; i++) { a.push(0.0); }
    let acc: f64 = 0.0;
    for (let r = 0; r < reps; r++) {
        for (let i = 0; i < n; i++) { a[i] = i * 0.5; }
        for (let i = 0; i < n; i++) { acc = acc + a[i]; }
    }
    let t1 = time_ms();
    print(`typed array<f64>    : ${t1 - t0} ms   (checksum ${acc})`);
    let out: f64 = acc;
    return out;
}

fn bench_buffer_direct(n0: i32, reps0: i32): f64 {
    // buffer_ptr() called inside the loop — the naive spelling
    let n: i32 = n0; let reps: i32 = reps0;
    let t0 = time_ms();
    let b = buffer(n * 4);
    let acc: f64 = 0.0;
    for (let r = 0; r < reps; r++) {
        for (let i = 0; i < n; i++) { ptr_write_f32(ptr_offset(buffer_ptr(b), i * 4, 1), i * 0.5); }
        for (let i = 0; i < n; i++) { acc = acc + ptr_read_f32(ptr_offset(buffer_ptr(b), i * 4, 1)); }
    }
    let t1 = time_ms();
    free(b);
    print(`buffer_ptr() in loop: ${t1 - t0} ms   (checksum ${acc})`);
    let out: f64 = acc;
    return out;
}

fn bench_buffer_hoisted(n0: i32, reps0: i32): f64 {
    let n: i32 = n0; let reps: i32 = reps0;
    let t0 = time_ms();
    let b = buffer(n * 4);
    let base: ptr = buffer_ptr(b);
    let acc: f64 = 0.0;
    for (let r = 0; r < reps; r++) {
        for (let i = 0; i < n; i++) { ptr_write_f32(ptr_offset(base, i * 4, 1), i * 0.5); }
        for (let i = 0; i < n; i++) { acc = acc + ptr_read_f32(ptr_offset(base, i * 4, 1)); }
    }
    let t1 = time_ms();
    free(b);
    print(`buffer hoisted ptr  : ${t1 - t0} ms   (checksum ${acc})`);
    let out: f64 = acc;
    return out;
}

fn bench_buffer_bounds(n0: i32, reps0: i32): f64 {
    // ptr_write_f32(buffer, v) — buffer operand => bounds-checked path.
    // Note: there is no way to offset a buffer, so this only ever hits elt 0;
    // included to show the per-call cost of the bounds-checked entry point.
    let n: i32 = n0; let reps: i32 = reps0;
    let t0 = time_ms();
    let b = buffer(n * 4);
    let acc: f64 = 0.0;
    for (let r = 0; r < reps; r++) {
        for (let i = 0; i < n; i++) { ptr_write_f32(b, i * 0.5); }
        for (let i = 0; i < n; i++) { acc = acc + ptr_read_f32(b); }
    }
    let t1 = time_ms();
    free(b);
    print(`buffer bounds-check : ${t1 - t0} ms   (checksum ${acc})`);
    let out: f64 = acc;
    return out;
}

fn bench_raw_ptr_f32(n0: i32, reps0: i32): f64 {
    let n: i32 = n0; let reps: i32 = reps0;
    let t0 = time_ms();
    let p: ptr = alloc(n * 4);
    let acc: f64 = 0.0;
    for (let r = 0; r < reps; r++) {
        for (let i = 0; i < n; i++) { ptr_write_f32(ptr_offset(p, i * 4, 1), i * 0.5); }
        for (let i = 0; i < n; i++) { acc = acc + ptr_read_f32(ptr_offset(p, i * 4, 1)); }
    }
    let t1 = time_ms();
    free(p);
    print(`raw ptr f32         : ${t1 - t0} ms   (checksum ${acc})`);
    let out: f64 = acc;
    return out;
}

fn bench_raw_ptr_f32_elemsize(n0: i32, reps0: i32): f64 {
    // ptr_offset(p, i, 4) — let the builtin do the multiply
    let n: i32 = n0; let reps: i32 = reps0;
    let t0 = time_ms();
    let p: ptr = alloc(n * 4);
    let acc: f64 = 0.0;
    for (let r = 0; r < reps; r++) {
        for (let i = 0; i < n; i++) { ptr_write_f32(ptr_offset(p, i, 4), i * 0.5); }
        for (let i = 0; i < n; i++) { acc = acc + ptr_read_f32(ptr_offset(p, i, 4)); }
    }
    let t1 = time_ms();
    free(p);
    print(`raw ptr f32 (es=4)  : ${t1 - t0} ms   (checksum ${acc})`);
    let out: f64 = acc;
    return out;
}

fn bench_raw_ptr_f64(n0: i32, reps0: i32): f64 {
    let n: i32 = n0; let reps: i32 = reps0;
    let t0 = time_ms();
    let p: ptr = alloc(n * 8);
    let acc: f64 = 0.0;
    for (let r = 0; r < reps; r++) {
        for (let i = 0; i < n; i++) { ptr_write_f64(ptr_offset(p, i * 8, 1), i * 0.5); }
        for (let i = 0; i < n; i++) { acc = acc + ptr_read_f64(ptr_offset(p, i * 8, 1)); }
    }
    let t1 = time_ms();
    free(p);
    print(`raw ptr f64         : ${t1 - t0} ms   (checksum ${acc})`);
    let out: f64 = acc;
    return out;
}

fn bench_ptr_index(n0: i32, reps0: i32): i64 {
    // p[i] on a raw ptr — byte access, no bounds check
    let n: i32 = n0; let reps: i32 = reps0;
    let t0 = time_ms();
    let p: ptr = alloc(n);
    let acc: i64 = 0;
    for (let r = 0; r < reps; r++) {
        for (let i = 0; i < n; i++) { p[i] = i & 255; }
        for (let i = 0; i < n; i++) { acc = acc + p[i]; }
    }
    let t1 = time_ms();
    free(p);
    print(`raw ptr[i] u8 index : ${t1 - t0} ms   (checksum ${acc})`);
    let out: i64 = acc;
    return out;
}

fn bench_buffer_index_u8(n0: i32, reps0: i32): i64 {
    // b[i] on a buffer is byte-level, bounds checked
    let n: i32 = n0; let reps: i32 = reps0;
    let t0 = time_ms();
    let b = buffer(n);
    let acc: i64 = 0;
    for (let r = 0; r < reps; r++) {
        for (let i = 0; i < n; i++) { b[i] = i & 255; }
        for (let i = 0; i < n; i++) { acc = acc + b[i]; }
    }
    let t1 = time_ms();
    free(b);
    print(`buffer[i] u8 index  : ${t1 - t0} ms   (checksum ${acc})`);
    let out: i64 = acc;
    return out;
}

print(`--- float storage, N=${N} elements, ${REPS} write+read passes each ---`);
bench_dyn_array(N, REPS);
bench_typed_array(N, REPS);
bench_buffer_direct(N, REPS);
bench_buffer_hoisted(N, REPS);
bench_buffer_bounds(N, REPS);
bench_raw_ptr_f32(N, REPS);
bench_raw_ptr_f32_elemsize(N, REPS);
bench_raw_ptr_f64(N, REPS);
bench_ptr_index(N, REPS);
bench_buffer_index_u8(N, REPS);
