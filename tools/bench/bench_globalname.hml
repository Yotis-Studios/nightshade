// bench_globalname.hml — the "a top-level variable poisons every local with
// the same name" trap.
//
// codegen_stmt refuses to unbox a `let` whose NAME matches any top-level
// ("main") variable — the check is by name only, with no scope awareness. So a
// module-level `let acc = ...` anywhere in the entry file silently forces every
// function-local `acc` in the whole program back to boxed HmlValue.
//
// The two functions below are byte-for-byte identical apart from the variable
// name; only `hot_shadowed`'s name collides with a top-level `let`.
//
// Build: hemlockc -O3 bench_globalname.hml -o /tmp/b_gname

import { time_ms } from "@stdlib/time";

let ITERS: i32 = 50000000;

fn hot_shadowed(n0: i32): f64 {
    let n: i32 = n0;
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + 1.5; }
    let o: f64 = acc;
    return o;
}

fn hot_clean(n0: i32): f64 {
    let n: i32 = n0;
    let g_sum: f64 = 0.0;
    for (let i = 0; i < n; i++) { g_sum = g_sum + 1.5; }
    let o: f64 = g_sum;
    return o;
}

// THIS LINE is what makes hot_shadowed slow.
let acc = 0;

let t0 = time_ms(); let r0 = hot_shadowed(ITERS); let t1 = time_ms();
let r1 = hot_clean(ITERS);                        let t2 = time_ms();
print(`--- ${ITERS} iterations ---`);
print(`local named 'acc' (a top-level 'acc' exists): ${t1 - t0} ms  (${r0})`);
print(`local named 'g_sum' (no collision)         : ${t2 - t1} ms  (${r1})`);
print(`top-level acc is still ${acc}`);
