// bench_hotpath.hml — the per-frame patterns a game actually uses.
//
// Objects vs arrays vs flat locals; call kinds; iteration kinds; allocation.
// All kernels use the copy-out trick so accumulator boxing is not measured.
//
// Build: hemlockc -O3 bench_hotpath.hml -o /tmp/b_hot

import { time_ms } from "@stdlib/time";

let ITERS: i32 = 5000000;

fn ms(): i64 { let t = time_ms(); let o: i64 = t; return o; }

// ---------------------------------------------------------------- allocation

// 1. allocate a fresh {x,y,z} object every iteration (the wobbleweed v3 style)
fn alloc_object(n0: i32): f64 {
    let n: i32 = n0;
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) {
        let v = { x: 1.0, y: 2.0, z: 3.0 };
        acc = acc + v.x + v.y + v.z;
    }
    let out: f64 = acc;
    return out;
}

// 2. allocate a fresh 3-element array every iteration
fn alloc_array(n0: i32): f64 {
    let n: i32 = n0;
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) {
        let v = [1.0, 2.0, 3.0];
        acc = acc + v[0] + v[1] + v[2];
    }
    let out: f64 = acc;
    return out;
}

// 3. no allocation at all — three scalars
fn alloc_none(n0: i32): f64 {
    let n: i32 = n0;
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) {
        let vx: f64 = 1.0; let vy: f64 = 2.0; let vz: f64 = 3.0;
        acc = acc + vx + vy + vz;
    }
    let out: f64 = acc;
    return out;
}

// 4. write into a preallocated flat f64 array (struct-of-arrays style)
fn alloc_soa(n0: i32): f64 {
    let n: i32 = n0;
    let xs: array<f64> = [0.0, 0.0, 0.0];
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) {
        xs[0] = 1.0; xs[1] = 2.0; xs[2] = 3.0;
        acc = acc + xs[0] + xs[1] + xs[2];
    }
    let out: f64 = acc;
    return out;
}

// ---------------------------------------------------------------- field access

fn read_object_field(n0: i32, v): f64 {
    let n: i32 = n0;
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + v.x + v.y + v.z; }
    let out: f64 = acc;
    return out;
}

fn read_array_index(n0: i32, v): f64 {
    let n: i32 = n0;
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + v[0] + v[1] + v[2]; }
    let out: f64 = acc;
    return out;
}

fn read_locals(n0: i32, a: f64, b: f64, c: f64): f64 {
    let n: i32 = n0;
    let la: f64 = a; let lb: f64 = b; let lc: f64 = c;
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + la + lb + lc; }
    let out: f64 = acc;
    return out;
}

// ---------------------------------------------------------------- call kinds

fn plain_add(a: f64, b: f64): f64 { return a + b; }

@inline
fn inline_add(a: f64, b: f64): f64 => a + b;

fn call_direct(n0: i32): f64 {
    let n: i32 = n0;
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = plain_add(acc, 1.5); }
    let out: f64 = acc;
    return out;
}

fn call_inline(n0: i32): f64 {
    let n: i32 = n0;
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = inline_add(acc, 1.5); }
    let out: f64 = acc;
    return out;
}

fn call_closure(n0: i32, f): f64 {
    let n: i32 = n0;
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = f(acc, 1.5); }
    let out: f64 = acc;
    return out;
}

fn call_method(n0: i32, o): f64 {
    let n: i32 = n0;
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = o.add(acc, 1.5); }
    let out: f64 = acc;
    return out;
}

fn call_none(n0: i32): f64 {
    let n: i32 = n0;
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + 1.5; }
    let out: f64 = acc;
    return out;
}

// ---------------------------------------------------------------- iteration

fn iter_indexed(a): f64 {
    let acc: f64 = 0.0;
    let len: i32 = a.length;
    for (let i = 0; i < len; i++) { acc = acc + a[i]; }
    let out: f64 = acc;
    return out;
}

fn iter_forin(a): f64 {
    let acc: f64 = 0.0;
    for (v in a) { acc = acc + v; }
    let out: f64 = acc;
    return out;
}

fn iter_length_each_time(a): f64 {
    let acc: f64 = 0.0;
    for (let i = 0; i < a.length; i++) { acc = acc + a[i]; }
    let out: f64 = acc;
    return out;
}

// ---------------------------------------------------------------- array growth

fn grow_push(n0: i32): i32 {
    let n: i32 = n0;
    let a = [];
    for (let i = 0; i < n; i++) { a.push(i); }
    let out: i32 = a.length;
    return out;
}

fn grow_reserve_push(n0: i32): i32 {
    let n: i32 = n0;
    let a = [];
    a.reserve(n);
    for (let i = 0; i < n; i++) { a.push(i); }
    let out: i32 = a.length;
    return out;
}

fn grow_clear_reuse(n0: i32, a): i32 {
    let n: i32 = n0;
    a.clear();
    for (let i = 0; i < n; i++) { a.push(i); }
    let out: i32 = a.length;
    return out;
}

fn run(label: string, f, a): i64 {
    let t0 = time_ms();
    let r = f(a);
    let t1 = time_ms();
    print(`${label}: ${t1 - t0} ms   (${r})`);
    return t1 - t0;
}

print(`--- allocation, ${ITERS} iterations ---`);
run("object literal {x,y,z}/iter ", alloc_object, ITERS);
run("array literal [x,y,z]/iter  ", alloc_array,  ITERS);
run("3 scalar locals/iter        ", alloc_none,   ITERS);
run("reused flat array/iter      ", alloc_soa,    ITERS);

print(`--- field access, ${ITERS} iterations x3 reads ---`);
let OV = { x: 1.0, y: 2.0, z: 3.0 };
let AV = [1.0, 2.0, 3.0];
let t0 = time_ms(); let q0 = read_object_field(ITERS, OV); let t1 = time_ms();
print(`object v.x/v.y/v.z          : ${t1 - t0} ms   (${q0})`);
let q1 = read_array_index(ITERS, AV); let t2 = time_ms();
print(`array  v[0]/v[1]/v[2]       : ${t2 - t1} ms   (${q1})`);
let q2 = read_locals(ITERS, 1.0, 2.0, 3.0); let t3 = time_ms();
print(`native locals               : ${t3 - t2} ms   (${q2})`);

print(`--- call kinds, ${ITERS} iterations ---`);
run("no call (inline arithmetic) ", call_none,   ITERS);
run("@inline fn                  ", call_inline, ITERS);
run("plain named fn              ", call_direct, ITERS);
let CL = fn(a, b) { return a + b; };
let t4 = time_ms(); let q3 = call_closure(ITERS, CL); let t5 = time_ms();
print(`closure through variable    : ${t5 - t4} ms   (${q3})`);
let OBJ = { fn add(a, b) { return a + b; } };
let q4 = call_method(ITERS, OBJ); let t6 = time_ms();
print(`obj.method()                : ${t6 - t5} ms   (${q4})`);

print(`--- iteration over a 3,000,000-element array ---`);
let BIG: array<f64> = [];
BIG.reserve(3000000);
for (let i = 0; i < 3000000; i++) { BIG.push(1.0); }
let t7 = time_ms(); let q5 = iter_indexed(BIG); let t8 = time_ms();
print(`for (i=0; i<len; i++) a[i]  : ${t8 - t7} ms   (${q5})`);
let q6 = iter_forin(BIG); let t9 = time_ms();
print(`for (v in a)                : ${t9 - t8} ms   (${q6})`);
let q7 = iter_length_each_time(BIG); let t10 = time_ms();
print(`i < a.length each iteration : ${t10 - t9} ms   (${q7})`);

print(`--- array growth, ${ITERS} pushes ---`);
run("push (grow as needed)       ", grow_push,         ITERS);
run("reserve() then push         ", grow_reserve_push, ITERS);
let REUSE = [];
REUSE.reserve(ITERS);
let t11 = time_ms(); let q8 = grow_clear_reuse(ITERS, REUSE); let t12 = time_ms();
print(`clear() + push (reused)     : ${t12 - t11} ms   (${q8})`);
