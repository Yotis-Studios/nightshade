// bench_interp_vs_compiled.hml — run the SAME file both ways.
//
//   hemlock  bench_interp_vs_compiled.hml
//   hemlockc -O3 bench_interp_vs_compiled.hml -o /tmp/b_ivc && /tmp/b_ivc

import { time_ms } from "@stdlib/time";
import { sqrt } from "@stdlib/math";

let N: i32 = 300000;

fn k_arith(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + i * 0.5; }
    let out: f64 = acc; return out;
}

fn k_objects(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { let v = { x: 1.0, y: 2.0, z: 3.0 }; acc = acc + v.x + v.y + v.z; }
    let out: f64 = acc; return out;
}

fn k_array(n0: i32): f64 {
    let n: i32 = n0;
    let a: array<f64> = []; a.reserve(n);
    for (let i = 0; i < n; i++) { a.push(f64(i)); }
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + a[i]; }
    let out: f64 = acc; return out;
}

fn k_ptr(n0: i32): f64 {
    let n: i32 = n0;
    let p: ptr = alloc(n * 4);
    for (let i = 0; i < n; i++) { ptr_write_f32(ptr_offset(p, i * 4, 1), f64(i)); }
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + ptr_read_f32(ptr_offset(p, i * 4, 1)); }
    free(p);
    let out: f64 = acc; return out;
}

fn k_calls(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + sqrt(f64(i)); }
    let out: f64 = acc; return out;
}

fn run(label: string, f, a) {
    let t0 = time_ms();
    let r = f(a);
    let t1 = time_ms();
    print(`${label}: ${t1 - t0} ms`);
}

print(`--- N=${N} ---`);
run("native arithmetic  ", k_arith,   N);
run("object alloc+read  ", k_objects, N);
run("array push+index   ", k_array,   N);
run("ptr write+read     ", k_ptr,     N);
run("stdlib sqrt() calls", k_calls,   N);
