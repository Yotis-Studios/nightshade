// bench_leaks.hml — what leaks in a long-running compiled Hemlock program?
//
// Runs each construct N times and prints process RSS (Linux) before/after.
// A construct that leaks shows a monotonically growing RSS.
//
// Build: hemlockc -O3 bench_leaks.hml -o /tmp/b_leaks && /tmp/b_leaks

import { open } from "@stdlib/fs";

let N: i32 = 300000;

// /proc/self/statm: "size resident shared text lib data dt" in pages
fn rss_kb(): i64 {
    let f = open("/proc/self/statm", "r");
    let s = f.read();
    f.close();
    let parts = s.trim().split(" ");
    let pages: i64 = i64(parts[1]);
    let out: i64 = pages * 4;
    return out;
}

fn c_objects(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) { let o = { x: 1.0, y: 2.0, z: 3.0 }; acc = acc + 1; }
    let out: i32 = acc; return out;
}
fn c_arrays(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) { let a = [1.0, 2.0, 3.0]; acc = acc + 1; }
    let out: i32 = acc; return out;
}
fn c_strings(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) { let s = "v" + i; acc = acc + s.length; }
    let out: i32 = acc; return out;
}
fn c_closures(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) { let f = fn(z) { return z + 1; }; acc = acc + f(1); }
    let out: i32 = acc; return out;
}
fn c_alloc_free(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) { let p = alloc(128); acc = acc + 1; free(p); }
    let out: i32 = acc; return out;
}
fn c_alloc_noleak_free(n0: i32): i32 {
    // alloc WITHOUT free — this must leak (proves the harness works)
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) { let p = alloc(128); acc = acc + 1; }
    let out: i32 = acc; return out;
}
fn c_buffer_noexplicit_free(n0: i32): i32 {
    // buffer() with NO free — refcounting should reclaim at scope exit
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) { let b = buffer(128); acc = acc + 1; }
    let out: i32 = acc; return out;
}
fn c_forin_keys(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    let o = { a: 1, b: 2, c: 3 };
    for (let i = 0; i < n; i++) { for (k in o.keys()) { acc = acc + 1; } }
    let out: i32 = acc; return out;
}
fn c_throw_catch(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) {
        try { let junk = [1.0, 2.0, 3.0]; throw "e"; } catch (e) { acc = acc + 1; }
    }
    let out: i32 = acc; return out;
}
fn c_object_field_assign(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    let o = { v: [0.0] };
    for (let i = 0; i < n; i++) { o.v = [1.0, 2.0]; acc = acc + 1; }
    let out: i32 = acc; return out;
}

fn probe(label: string, f, a) {
    let before = rss_kb();
    f(a);
    f(a);
    let after = rss_kb();
    print(`${label}: RSS ${before} -> ${after} KB   (delta ${after - before})`);
}

print(`--- leak probe, ${N} iterations x2 each ---`);
probe("object literal        ", c_objects,                 N);
probe("array literal         ", c_arrays,                  N);
probe("string concat         ", c_strings,                 N);
probe("closure literal       ", c_closures,                N);
probe("alloc + free          ", c_alloc_free,              N);
probe("buffer, no free       ", c_buffer_noexplicit_free,  N);
probe("for k in obj.keys()   ", c_forin_keys,              N);
probe("throw/catch w/ locals ", c_throw_catch,             N);
probe("obj.field = [..]      ", c_object_field_assign,     N);
probe("alloc WITHOUT free    ", c_alloc_noleak_free,       N);
