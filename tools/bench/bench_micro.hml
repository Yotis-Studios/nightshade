// bench_micro.hml — cost of the individual Hemlock operations the renderer is
// built out of. Everything is timed over the same iteration count and reported
// as nanoseconds per operation, with the empty loop subtracted.
//
// This is the grounding data for every other recommendation: it says what a
// property read, an object literal, an array index and a raw pointer write
// actually cost in the COMPILED runtime.

import { time_ms } from "@stdlib/time";

let N = 2000000;
let sink = 0.0;
let isink = 0;

fn ms(): f64 { return time_ms(); }

fn report(name: string, t: f64, base: f64, ops_per_iter: i32) {
    let net = t - base;
    let ns = (net * 1000000.0) / (N * ops_per_iter);
    print(`MICRO ${name} total_ms=${t} net_ms=${net} ns_per_op=${ns}`);
}

fn main() {
    // ---- empty loop baseline ----
    let t0 = ms();
    for (let i = 0; i < N; i++) { isink = isink + 1; }
    let base = ms() - t0;
    print(`MICRO empty_loop total_ms=${base} net_ms=0 ns_per_op=0`);

    // ---- f64 arithmetic on locals (3 mul + 3 add, like one row of mat_apply) ----
    let a = 1.0000001; let b = 2.0; let c = 3.0;
    t0 = ms();
    for (let i = 0; i < N; i++) {
        sink = sink + (a * b + c * a + b * c);
    }
    report("f64_arith_6ops", ms() - t0, base, 1);

    // ---- object property READ ----
    let v = { x: 1.0, y: 2.0, z: 3.0, w: 4.0, u: 0.5, v: 0.5, l: 1.0 };
    t0 = ms();
    for (let i = 0; i < N; i++) { sink = sink + v.x; }
    report("obj_read_1field_7wide", ms() - t0, base, 1);

    t0 = ms();
    for (let i = 0; i < N; i++) { sink = sink + v.x + v.y + v.z + v.w; }
    report("obj_read_4field_7wide", ms() - t0, base, 4);

    let v3o = { x: 1.0, y: 2.0, z: 3.0 };
    t0 = ms();
    for (let i = 0; i < N; i++) { sink = sink + v3o.x + v3o.y + v3o.z; }
    report("obj_read_3field_3wide", ms() - t0, base, 3);

    // ---- object property WRITE ----
    t0 = ms();
    for (let i = 0; i < N; i++) { v3o.x = 1.0; }
    report("obj_write_1field", ms() - t0, base, 1);

    // ---- object literal CREATION ----
    t0 = ms();
    for (let i = 0; i < N; i++) { let o = { x: 1.0, y: 2.0, z: 3.0 }; sink = sink + o.x; }
    report("obj_new_3field_plus1read", ms() - t0, base, 1);

    t0 = ms();
    for (let i = 0; i < N; i++) { let o = { x: 1.0, y: 2.0, z: 3.0, w: 4.0 }; sink = sink + o.x; }
    report("obj_new_4field_plus1read", ms() - t0, base, 1);

    t0 = ms();
    for (let i = 0; i < N; i++) {
        let o = { x: 1.0, y: 2.0, z: 3.0, u: 0.0, v: 0.0, r: 1, g: 1, b: 1 };
        sink = sink + o.x;
    }
    report("obj_new_8field_plus1read", ms() - t0, base, 1);

    // ---- array indexing (f64 array, i32 index -> fast path) ----
    let arr = [];
    for (let i = 0; i < 32; i++) { arr.push(i * 1.0); }
    t0 = ms();
    for (let i = 0; i < N; i++) { sink = sink + arr[0]; }
    report("arr_read_1", ms() - t0, base, 1);

    t0 = ms();
    for (let i = 0; i < N; i++) { sink = sink + arr[0] + arr[1] + arr[2] + arr[3]; }
    report("arr_read_4", ms() - t0, base, 4);

    t0 = ms();
    for (let i = 0; i < N; i++) { arr[0] = 1.0; }
    report("arr_write_1", ms() - t0, base, 1);

    // ---- array push + reset (the batch_tri pattern) ----
    let acc2 = [];
    t0 = ms();
    for (let i = 0; i < N; i++) {
        acc2.push(1.0);
        if (acc2.length >= 4096) { acc2 = []; }
    }
    report("arr_push_f64", ms() - t0, base, 1);

    // ---- raw pointer f64 read/write ----
    let p = alloc(4096);
    t0 = ms();
    for (let i = 0; i < N; i++) { ptr_write_f64(ptr_offset(p, 0, 1), 1.0); }
    report("ptr_write_f64", ms() - t0, base, 1);

    t0 = ms();
    for (let i = 0; i < N; i++) { sink = sink + ptr_deref_f64(ptr_offset(p, 0, 1)); }
    report("ptr_deref_f64", ms() - t0, base, 1);

    t0 = ms();
    for (let i = 0; i < N; i++) { ptr_write_f32(ptr_offset(p, 0, 1), 1.0); }
    report("ptr_write_f32", ms() - t0, base, 1);

    t0 = ms();
    for (let i = 0; i < N; i++) { ptr_write_u8(ptr_offset(p, 0, 1), 255); }
    report("ptr_write_u8", ms() - t0, base, 1);

    // ---- buffer typed access ----
    let bf = buffer(4096);
    t0 = ms();
    for (let i = 0; i < N; i++) { ptr_write_f64(bf, 1.0); }
    report("buffer_write_f64", ms() - t0, base, 1);

    // ---- function call ----
    t0 = ms();
    for (let i = 0; i < N; i++) { sink = sink + addf(1.0, 2.0); }
    report("static_fn_call_2arg", ms() - t0, base, 1);

    // ---- closure call (what array.sort does per comparison) ----
    let cmp = fn(x, y) { if (x > y) { return 0 - 1; } if (x < y) { return 1; } return 0; };
    t0 = ms();
    for (let i = 0; i < N; i++) { isink = isink + cmp(1.0, 2.0); }
    report("closure_call_2arg", ms() - t0, base, 1);

    // ---- closure call with object args + 2 field reads (the sort comparator) ----
    let pa = { depth: 1.0 }; let pb = { depth: 2.0 };
    let cmp2 = fn(x, y) {
        if (x.depth > y.depth) { return 0 - 1; }
        if (x.depth < y.depth) { return 1; }
        return 0;
    };
    t0 = ms();
    for (let i = 0; i < N; i++) { isink = isink + cmp2(pa, pb); }
    report("sort_comparator_call", ms() - t0, base, 1);

    print(`sink=${i64(sink) % 1000003} isink=${isink % 1000003}`);
}

fn addf(x: f64, y: f64): f64 { return x + y; }

main();
