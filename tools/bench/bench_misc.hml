// bench_misc.hml — math calls, strings, error handling, division, allocation.
//
// Build: hemlockc -O3 bench_misc.hml -o /tmp/b_misc

import { time_ms } from "@stdlib/time";
import { sqrt, sin, cos, floor, divi, abs, min, max, clamp } from "@stdlib/math";

let ITERS: i32 = 5000000;
let SMALL: i32 = 200000;

// ---------------------------------------------------------------- math calls

fn m_sqrt(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + sqrt(i * 1.0); }
    let out: f64 = acc; return out;
}
fn m_sincos(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + sin(i * 0.001) + cos(i * 0.001); }
    let out: f64 = acc; return out;
}
fn m_floor(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + floor(i * 0.5); }
    let out: f64 = acc; return out;
}
fn m_i32cast(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + i32(i * 0.5); }
    let out: f64 = acc; return out;
}
fn m_none(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + i * 0.5; }
    let out: f64 = acc; return out;
}
fn m_clamp_call(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + clamp(i * 0.001, 0.0, 1.0); }
    let out: f64 = acc; return out;
}
fn m_clamp_manual(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) {
        let v: f64 = i * 0.001;
        if (v < 0.0) { v = 0.0; }
        if (v > 1.0) { v = 1.0; }
        acc = acc + v;
    }
    let out: f64 = acc; return out;
}

// ---------------------------------------------------------------- division

fn d_slash(n0: i32): f64 {
    let n: i32 = n0; let acc: f64 = 0.0;
    for (let i = 1; i < n; i++) { acc = acc + 1000 / i; }
    let out: f64 = acc; return out;
}
fn d_divi(n0: i32): i64 {
    let n: i32 = n0; let acc: i64 = 0;
    for (let i = 1; i < n; i++) { acc = acc + divi(1000, i); }
    let out: i64 = acc; return out;
}
fn d_recip(n0: i32): f64 {
    // multiply by a precomputed reciprocal instead of dividing
    let n: i32 = n0; let acc: f64 = 0.0;
    let k: f64 = 1000.0;
    for (let i = 1; i < n; i++) { let inv: f64 = 1.0 / i; acc = acc + k * inv; }
    let out: f64 = acc; return out;
}

// ---------------------------------------------------------------- error handling

fn e_none(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) { acc = acc + i; }
    let out: i32 = acc; return out;
}
fn e_try(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) {
        try { acc = acc + i; } catch (err) { acc = 0; }
    }
    let out: i32 = acc; return out;
}
fn e_defer_body() { let x: i32 = 1; }
fn e_defer(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) { e_defer_body(); acc = acc + i; }
    let out: i32 = acc; return out;
}
fn e_noop() { }
fn e_with_defer_body() { defer e_noop(); let x: i32 = 1; }
fn e_with_defer(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) { e_with_defer_body(); acc = acc + i; }
    let out: i32 = acc; return out;
}
fn e_throwcatch(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) {
        try { throw "x"; } catch (err) { acc = acc + 1; }
    }
    let out: i32 = acc; return out;
}

// ---------------------------------------------------------------- strings

fn s_concat(n0: i32): i32 {
    let n: i32 = n0; let total: i32 = 0;
    for (let i = 0; i < n; i++) { let s = "hp: " + i + " / 100"; total = total + s.length; }
    let out: i32 = total; return out;
}
fn s_template(n0: i32): i32 {
    let n: i32 = n0; let total: i32 = 0;
    for (let i = 0; i < n; i++) { let s = `hp: ${i} / 100`; total = total + s.length; }
    let out: i32 = total; return out;
}
fn s_nostring(n0: i32): i32 {
    let n: i32 = n0; let total: i32 = 0;
    for (let i = 0; i < n; i++) { total = total + i; }
    let out: i32 = total; return out;
}

// ---------------------------------------------------------------- allocation

fn a_alloc_free(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) { let p = alloc(64); acc = acc + 1; free(p); }
    let out: i32 = acc; return out;
}
fn a_buffer(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) { let b = buffer(64); acc = acc + 1; free(b); }
    let out: i32 = acc; return out;
}
fn a_object8(n0: i32): i32 {
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) {
        let o = { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 };
        acc = acc + o.a;
    }
    let out: i32 = acc; return out;
}
fn a_object9(n0: i32): i32 {
    // 9 fields: outgrows the 8-slot object pool
    let n: i32 = n0; let acc: i32 = 0;
    for (let i = 0; i < n; i++) {
        let o = { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9 };
        acc = acc + o.a;
    }
    let out: i32 = acc; return out;
}

fn run(label: string, f, a) {
    let t0 = time_ms();
    let r = f(a);
    let t1 = time_ms();
    print(`${label}: ${t1 - t0} ms   (${r})`);
}

print(`--- math, ${ITERS} iterations ---`);
run("baseline (no call)         ", m_none,         ITERS);
run("sqrt()                     ", m_sqrt,         ITERS);
run("sin()+cos()                ", m_sincos,       ITERS);
run("floor()                    ", m_floor,        ITERS);
run("i32() cast                 ", m_i32cast,      ITERS);
run("clamp() stdlib call        ", m_clamp_call,   ITERS);
run("clamp() manual if/if       ", m_clamp_manual, ITERS);

print(`--- division, ${ITERS} iterations ---`);
run("a / b  (always f64)        ", d_slash, ITERS);
run("divi(a, b)                 ", d_divi,  ITERS);
run("multiply by reciprocal     ", d_recip, ITERS);

print(`--- error handling, ${ITERS} iterations ---`);
run("plain loop                 ", e_none,       ITERS);
run("try/catch around body      ", e_try,        ITERS);
run("call fn (no defer)         ", e_defer,      ITERS);
run("call fn with defer{}       ", e_with_defer, ITERS);
print(`--- throw/catch, ${SMALL} iterations ---`);
run("throw + catch per iteration", e_throwcatch, SMALL);

print(`--- strings, ${SMALL} iterations ---`);
run("no string                  ", s_nostring, SMALL);
run("\"a\" + i + \"b\" concat       ", s_concat,   SMALL);
run("`template ${i}`            ", s_template, SMALL);

print(`--- allocation, ${SMALL} iterations ---`);
run("alloc(64) + free           ", a_alloc_free, SMALL);
run("buffer(64) + free          ", a_buffer,     SMALL);
run("object literal, 8 fields   ", a_object8,    SMALL);
run("object literal, 9 fields   ", a_object9,    SMALL);
