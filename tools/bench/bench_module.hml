// bench_module.hml — named import vs namespace import vs local call.
//
// Build: hemlockc -O3 bench_module.hml -o /tmp/b_mod

import { time_ms } from "@stdlib/time";
import { add2, K } from "./module_lib.hml";
import * as lib from "./module_lib.hml";

let g_n: i32 = 20000000;

fn local_add2(a: f64, b: f64): f64 { return a + b; }

fn call_local(n0: i32): f64  { let n: i32 = n0; let s: f64 = 0.0; for (let i=0;i<n;i++) { s = local_add2(s, 1.5); } let o: f64 = s; return o; }
fn call_import(n0: i32): f64 { let n: i32 = n0; let s: f64 = 0.0; for (let i=0;i<n;i++) { s = add2(s, 1.5); }       let o: f64 = s; return o; }
fn call_ns(n0: i32): f64     { let n: i32 = n0; let s: f64 = 0.0; for (let i=0;i<n;i++) { s = lib.add2(s, 1.5); }   let o: f64 = s; return o; }
fn use_import_const(n0: i32): f64 { let n: i32 = n0; let s: f64 = 0.0; for (let i=0;i<n;i++) { s = s + K; } let o: f64 = s; return o; }
fn use_local_const(n0: i32): f64  { let n: i32 = n0; let k: f64 = K; let s: f64 = 0.0; for (let i=0;i<n;i++) { s = s + k; } let o: f64 = s; return o; }

let t0 = time_ms(); let a = call_local(g_n);       let t1 = time_ms();
let b = call_import(g_n);                          let t2 = time_ms();
let c = call_ns(g_n);                              let t3 = time_ms();
let d = use_import_const(g_n);                     let t4 = time_ms();
let e = use_local_const(g_n);                      let t5 = time_ms();

print(`--- ${g_n} calls / reads ---`);
print(`local fn call           : ${t1 - t0} ms`);
print(`named-import fn call    : ${t2 - t1} ms`);
print(`namespace lib.fn() call : ${t3 - t2} ms`);
print(`imported const in loop  : ${t4 - t3} ms`);
print(`const copied to a local : ${t5 - t4} ms`);
let v: Vec2 = { x: 1.0, y: 2.0 };
print(`exported define usable without importing it by name: ${v.x}`);
