// bench_numeric.hml — cost of each numeric type in a fully-unboxed hot loop,
// and the price of Hemlock's i32/i64 overflow check.
//
// NOTE: every local here is named `s`, and the only top-level variable is
// `g_n` — deliberately, so no top-level name collides with a local and the
// unboxer actually fires (see bench_globalname.hml for what happens otherwise).
//
// Build: hemlockc -O3 bench_numeric.hml -o /tmp/b_num

import { time_ms } from "@stdlib/time";

let g_n: i32 = 50000000;

fn k_i32(n0: i32): i32 { let n: i32 = n0; let s: i32 = 0; for (let i=0;i<n;i++) { s = s + 1; } let o: i32 = s; return o; }
fn k_inc(n0: i32): i32 { let n: i32 = n0; let s: i32 = 0; for (let i=0;i<n;i++) { s++; }       let o: i32 = s; return o; }
fn k_u32(n0: i32): u32 { let n: i32 = n0; let s: u32 = 0; for (let i=0;i<n;i++) { s = s + 1; } let o: u32 = s; return o; }
fn k_i64(n0: i32): i64 { let n: i32 = n0; let s: i64 = 0; for (let i=0;i<n;i++) { s = s + 1; } let o: i64 = s; return o; }
fn k_f64(n0: i32): f64 { let n: i32 = n0; let s: f64 = 0.0; for (let i=0;i<n;i++) { s = s + 1.0; } let o: f64 = s; return o; }
fn k_mul(n0: i32): f64 { let n: i32 = n0; let s: f64 = 0.0; for (let i=0;i<n;i++) { s = s + 1.5 * 2.0; } let o: f64 = s; return o; }

let t0 = time_ms(); let r1 = k_i32(g_n); let t1 = time_ms();
let r2 = k_inc(g_n);                     let t2 = time_ms();
let r3 = k_u32(g_n);                     let t3 = time_ms();
let r4 = k_i64(g_n);                     let t4 = time_ms();
let r5 = k_f64(g_n);                     let t5 = time_ms();
let r6 = k_mul(g_n);                     let t6 = time_ms();

print(`--- ${g_n} iterations, all accumulators unboxed ---`);
print(`i32  s = s + 1  (overflow-checked): ${t1 - t0} ms`);
print(`i32  s++        (wraps, no check) : ${t2 - t1} ms`);
print(`u32  s = s + 1  (wraps)           : ${t3 - t2} ms`);
print(`i64  s = s + 1  (overflow-checked): ${t4 - t3} ms`);
print(`f64  s = s + 1.0                  : ${t5 - t4} ms`);
print(`f64  s = s + 1.5 * 2.0            : ${t6 - t5} ms`);
