// bench_sort.hml — depth sorting for the painter's algorithm.
//
// A PS1-style renderer must order triangles back-to-front every frame.
// array.sort(comparator) turns out to be pathologically slow; this measures
// the alternatives.
//
// Build: hemlockc -O3 bench_sort.hml -o /tmp/b_sort

import { time_ms } from "@stdlib/time";

let N: i32 = 3000;
let FRAMES: i32 = 20;
let BUCKETS: i32 = 1024;

fn make_objs(n0: i32) {
    let n: i32 = n0;
    let a = [];
    a.reserve(n);
    let s: i32 = 12345;
    for (let t = 0; t < n; t++) {
        s = (s * 1103515245 + 12345) & 2147483647;
        a.push({ depth: (s % 100000) * 0.00001, i: t });
    }
    return a;
}

fn make_keys(n0: i32) {
    let n: i32 = n0;
    let a: array<f64> = [];
    a.reserve(n);
    let s: i32 = 12345;
    for (let t = 0; t < n; t++) {
        s = (s * 1103515245 + 12345) & 2147483647;
        a.push((s % 100000) * 0.00001);
    }
    return a;
}

fn copy_arr(src) {
    let a = [];
    a.reserve(src.length);
    for (v in src) { a.push(v); }
    return a;
}

// --- 1. array.sort with a closure comparator over objects (wobbleweed today)
fn sort_closure(a): i32 {
    a.sort(fn(p, q) {
        if (p.depth > q.depth) { return -1; }
        if (p.depth < q.depth) { return 1; }
        return 0;
    });
    let out: i32 = a.length;
    return out;
}

// --- 2. array.sort with no comparator, over plain f64 keys
fn sort_default(a): i32 {
    a.sort();
    let out: i32 = a.length;
    return out;
}

// --- 3. hand-written counting/bucket sort of indices by depth
//        (O(n), and stable enough for a painter's pass)
fn bucket_sort(keys, order, counts, buckets0: i32, n0: i32): i32 {
    let n: i32 = n0;
    let nb: i32 = buckets0;
    for (let i = 0; i < nb; i++) { counts[i] = 0; }
    // histogram
    for (let i = 0; i < n; i++) {
        let d: f64 = keys[i];
        let b: i32 = i32(d * nb);
        if (b < 0) { b = 0; }
        if (b >= nb) { b = nb - 1; }
        counts[b] = counts[b] + 1;
    }
    // prefix sums, back-to-front (largest depth first)
    let run: i32 = 0;
    for (let i = nb - 1; i >= 0; i--) {
        let c: i32 = counts[i];
        counts[i] = run;
        run = run + c;
    }
    // scatter
    for (let i = 0; i < n; i++) {
        let d: f64 = keys[i];
        let b: i32 = i32(d * nb);
        if (b < 0) { b = 0; }
        if (b >= nb) { b = nb - 1; }
        let slot: i32 = counts[b];
        order[slot] = i;
        counts[b] = slot + 1;
    }
    let out: i32 = n;
    return out;
}

// --- 4. insertion sort on f64 keys (baseline for "nearly sorted" frames)
fn insertion_sort(keys, n0: i32): i32 {
    let n: i32 = n0;
    for (let i = 1; i < n; i++) {
        let k: f64 = keys[i];
        let j: i32 = i - 1;
        while (j >= 0 && keys[j] < k) {
            keys[j + 1] = keys[j];
            j = j - 1;
        }
        keys[j + 1] = k;
    }
    let out: i32 = n;
    return out;
}

print(`--- depth sort, N=${N}, ${FRAMES} frames ---`);

// 1: objects + closure comparator, freshly shuffled each frame
let t0 = time_ms();
for (let f = 0; f < FRAMES; f++) {
    let a = make_objs(N);
    sort_closure(a);
}
let t1 = time_ms();
print(`array.sort(closure) on objects : ${t1 - t0} ms = ${(t1 - t0) / FRAMES} ms/frame`);

// 1b: same but the array is ALREADY sorted (steady-state camera)
let PRE = make_objs(N);
sort_closure(PRE);
let t1b = time_ms();
for (let f = 0; f < FRAMES; f++) { sort_closure(PRE); }
let t1c = time_ms();
print(`array.sort(closure) presorted  : ${t1c - t1b} ms = ${(t1c - t1b) / FRAMES} ms/frame`);

// 2: default sort on f64 keys
let t2 = time_ms();
for (let f = 0; f < FRAMES; f++) {
    let k = make_keys(N);
    sort_default(k);
}
let t3 = time_ms();
print(`array.sort() on f64 keys       : ${t3 - t2} ms = ${(t3 - t2) / FRAMES} ms/frame`);

// 3: bucket sort
let KEYS = make_keys(N);
let ORDER: array<i32> = [];
for (let i = 0; i < N; i++) { ORDER.push(0); }
let COUNTS: array<i32> = [];
for (let i = 0; i < BUCKETS; i++) { COUNTS.push(0); }
let t4 = time_ms();
for (let f = 0; f < FRAMES; f++) { bucket_sort(KEYS, ORDER, COUNTS, BUCKETS, N); }
let t5 = time_ms();
print(`bucket sort (${BUCKETS} buckets)     : ${t5 - t4} ms = ${(t5 - t4) / FRAMES} ms/frame`);

// 4: insertion sort, random then nearly-sorted
let t6 = time_ms();
for (let f = 0; f < FRAMES; f++) {
    let k = make_keys(N);
    insertion_sort(k, N);
}
let t7 = time_ms();
print(`insertion sort (random)        : ${t7 - t6} ms = ${(t7 - t6) / FRAMES} ms/frame`);

let SK = make_keys(N);
insertion_sort(SK, N);
let t8 = time_ms();
for (let f = 0; f < FRAMES; f++) { insertion_sort(SK, N); }
let t9 = time_ms();
print(`insertion sort (presorted)     : ${t9 - t8} ms = ${(t9 - t8) / FRAMES} ms/frame`);

// baseline: cost of make_objs / make_keys alone (subtract from 1 and 2)
let t10 = time_ms();
for (let f = 0; f < FRAMES; f++) { make_objs(N); }
let t11 = time_ms();
print(`(baseline) make_objs alone     : ${t11 - t10} ms = ${(t11 - t10) / FRAMES} ms/frame`);
for (let f = 0; f < FRAMES; f++) { make_keys(N); }
let t12 = time_ms();
print(`(baseline) make_keys alone     : ${t12 - t11} ms = ${(t12 - t11) / FRAMES} ms/frame`);
