// bench_unboxing.hml — does the compiler's unboxing actually fire?
//
// The compiler refuses to unbox: function parameters, top-level ("main")
// variables, closure-captured variables and shadow (inlined-param) variables.
// Only function-local `let` variables with a known numeric type get native C
// storage. This benchmark measures how much that costs.
//
// Build: hemlockc -O3 bench_unboxing.hml -o /tmp/b_unbox

import { time_ms } from "@stdlib/time";

let ITERS: i32 = 20000000;

// --- 1. arithmetic straight off function parameters (NOT unboxable) ---
fn sum_params(x: f64, y: f64, n: i32): f64 {
    let acc: f64 = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + x * y; }
    return acc;
}

// --- 2. copy params into locals first (locals ARE unboxable) ---
fn sum_locals(x: f64, y: f64, n: i32): f64 {
    let lx: f64 = x;
    let ly: f64 = y;
    let acc: f64 = 0.0;
    let lim: i32 = n;
    for (let i = 0; i < lim; i++) { acc = acc + lx * ly; }
    return acc;
}

// --- 3. same, i32 flavour ---
fn isum_params(x: i32, y: i32, n: i32): i32 {
    let acc: i32 = 0;
    for (let i = 0; i < n; i++) { acc = acc + (x ^ y); }
    return acc;
}

fn isum_locals(x: i32, y: i32, n: i32): i32 {
    let lx: i32 = x;
    let ly: i32 = y;
    let acc: i32 = 0;
    let lim: i32 = n;
    for (let i = 0; i < lim; i++) { acc = acc + (lx ^ ly); }
    return acc;
}

// --- 4. untyped locals (no annotations at all) ---
fn sum_untyped(x, y, n) {
    let lx = x;
    let ly = y;
    let acc = 0.0;
    for (let i = 0; i < n; i++) { acc = acc + lx * ly; }
    return acc;
}

fn timeit(label: string, f, a, b, n): i64 {
    let t0 = time_ms();
    let r = f(a, b, n);
    let t1 = time_ms();
    print(`${label}: ${t1 - t0} ms  (r=${r})`);
    return t1 - t0;
}

print(`--- unboxing, ${ITERS} iterations of acc = acc + x*y ---`);
timeit("f64 via params      ", sum_params,  1.0000001, 1.0000001, ITERS);
timeit("f64 via typed locals", sum_locals,  1.0000001, 1.0000001, ITERS);
timeit("f64 untyped locals  ", sum_untyped, 1.0000001, 1.0000001, ITERS);
timeit("i32 via params      ", isum_params, 3, 5, ITERS);
timeit("i32 via typed locals", isum_locals, 3, 5, ITERS);

// --- 5. top-level ("main") loop: main vars are never unboxed ---
let mx: f64 = 1.0000001;
let my: f64 = 1.0000001;
let macc: f64 = 0.0;
let t0 = time_ms();
for (let i = 0; i < ITERS; i++) { macc = macc + mx * my; }
let t1 = time_ms();
print(`f64 top-level main  : ${t1 - t0} ms  (r=${macc})`);
