// bench_voxel.hml — chunked-world storage: memory footprint AND access speed.
//
// A HmlValue is 16 bytes, so a Hemlock `array` of block ids costs 16 B/block
// plus the array header. A `buffer`/`ptr` of u8 costs 1 B/block. For a
// Minecraft-style world that is the difference between shipping and swapping.
//
// Build: hemlockc -O3 bench_voxel.hml -o /tmp/b_voxel

import { time_ms } from "@stdlib/time";
import { open } from "@stdlib/fs";

let CHUNK: i32 = 32;                 // 32x32x32 = 32768 blocks
let BLOCKS: i32 = 32768;
let CHUNKS: i32 = 64;                // 64 loaded chunks
let SWEEPS: i32 = 200;

fn rss_kb(): i64 {
    let f = open("/proc/self/statm", "r");
    let s = f.read();
    f.close();
    let parts = s.trim().split(" ");
    let pages: i64 = i64(parts[1]);
    let out: i64 = pages * 4;
    return out;
}

// ---------------------------------------------------------------- footprint

fn make_array_chunks(nc: i32, nb: i32) {
    let chunks = [];
    chunks.reserve(nc);
    for (let c = 0; c < nc; c++) {
        let a: array<i32> = [];
        a.reserve(nb);
        for (let i = 0; i < nb; i++) { a.push(i & 7); }
        chunks.push(a);
    }
    return chunks;
}

fn make_buffer_chunks(nc: i32, nb: i32) {
    let chunks = [];
    chunks.reserve(nc);
    for (let c = 0; c < nc; c++) {
        let b = buffer(nb);
        let base: ptr = buffer_ptr(b);
        for (let i = 0; i < nb; i++) { ptr_write_u8(ptr_offset(base, i, 1), i & 7); }
        chunks.push(b);
    }
    return chunks;
}

// ---------------------------------------------------------------- access

fn sweep_array(a, nb: i32): i64 {
    let n: i32 = nb;
    let acc: i64 = 0;
    for (let i = 0; i < n; i++) { acc = acc + a[i]; }
    let out: i64 = acc;
    return out;
}

fn sweep_buffer_index(b, nb: i32): i64 {
    let n: i32 = nb;
    let acc: i64 = 0;
    for (let i = 0; i < n; i++) { acc = acc + b[i]; }
    let out: i64 = acc;
    return out;
}

fn sweep_ptr(base: ptr, nb: i32): i64 {
    let n: i32 = nb;
    let acc: i64 = 0;
    for (let i = 0; i < n; i++) { acc = acc + ptr_deref_u8(ptr_offset(base, i, 1)); }
    let out: i64 = acc;
    return out;
}

fn sweep_ptr_index(base: ptr, nb: i32): i64 {
    let n: i32 = nb;
    let acc: i64 = 0;
    for (let i = 0; i < n; i++) { acc = acc + base[i]; }
    let out: i64 = acc;
    return out;
}

print(`--- footprint: ${CHUNKS} chunks x ${BLOCKS} blocks (${CHUNKS * BLOCKS} blocks total) ---`);
let r0 = rss_kb();
let AC = make_array_chunks(CHUNKS, BLOCKS);
let r1 = rss_kb();
print(`array<i32> chunks : ${r1 - r0} KB  (${(r1 - r0) * 1024 / (CHUNKS * BLOCKS)} bytes/block)`);
let BC = make_buffer_chunks(CHUNKS, BLOCKS);
let r2 = rss_kb();
print(`buffer(u8) chunks : ${r2 - r1} KB  (${(r2 - r1) * 1024 / (CHUNKS * BLOCKS)} bytes/block)`);

print(`--- access: ${SWEEPS} full sweeps of one ${BLOCKS}-block chunk ---`);
let A0 = AC[0];
let B0 = BC[0];
let P0: ptr = buffer_ptr(B0);

let t0 = time_ms();
for (let s = 0; s < SWEEPS; s++) { sweep_array(A0, BLOCKS); }
let t1 = time_ms();
print(`array a[i]              : ${t1 - t0} ms`);
for (let s = 0; s < SWEEPS; s++) { sweep_buffer_index(B0, BLOCKS); }
let t2 = time_ms();
print(`buffer b[i] (bounds chk): ${t2 - t1} ms`);
for (let s = 0; s < SWEEPS; s++) { sweep_ptr(P0, BLOCKS); }
let t3 = time_ms();
print(`ptr_deref_u8(ptr_offset): ${t3 - t2} ms`);
for (let s = 0; s < SWEEPS; s++) { sweep_ptr_index(P0, BLOCKS); }
let t4 = time_ms();
print(`raw ptr p[i]            : ${t4 - t3} ms`);
