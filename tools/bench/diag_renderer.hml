// diag_renderer.hml — why does wobbleweed's upload_texture segfault on the
// accelerated (real display) renderer? Reports which renderer SDL picked, which
// texture formats it supports, and whether the RGB24 static texture used by
// upload_texture actually gets created.

import "libSDL2-2.0.so.0";

extern fn SDL_Init(flags: u32): i32;
extern fn SDL_CreateWindow(title: string, x: i32, y: i32, w: i32, h: i32, flags: u32): ptr;
extern fn SDL_CreateRenderer(win: ptr, index: i32, flags: u32): ptr;
extern fn SDL_CreateTexture(ren: ptr, format: u32, access: i32, w: i32, h: i32): ptr;
extern fn SDL_GetRendererInfo(ren: ptr, info: ptr): i32;
extern fn SDL_GetError(): string;
extern fn SDL_GetNumRenderDrivers(): i32;
extern fn SDL_Quit(): void;

let SDL_INIT_VIDEO = 32;
let SDL_WINDOWPOS_CENTERED = 805240832;
let SDL_WINDOW_SHOWN = 4;
let SDL_PIXELFORMAT_RGB24 = 386930691;
let SDL_PIXELFORMAT_ARGB8888 = 372645892;
let SDL_PIXELFORMAT_RGB888 = 370546692;
let SDL_TEXTUREACCESS_STATIC = 0;
let SDL_TEXTUREACCESS_STREAMING = 1;

// SDL_RendererInfo { const char *name; Uint32 flags; Uint32 num_texture_formats;
//                    Uint32 texture_formats[16]; int max_texture_width, height; }
let INFO_SIZE = 128;

// Hemlock has no ptr->string builtin; read the NUL-terminated name by hand.
fn cstr(p: ptr): string {
    if (p == null) { return "<null>"; }
    let s = "";
    for (let i = 0; i < 64; i++) {
        let c = ptr_deref_u8(ptr_offset(p, i, 1));
        if (c == 0) { break; }
        s = s + rune(c);
    }
    return s;
}

fn main() {
    if (SDL_Init(SDL_INIT_VIDEO) != 0) { print(`init failed: ${SDL_GetError()}`); return; }
    print(`render drivers: ${SDL_GetNumRenderDrivers()}`);

    let win = SDL_CreateWindow("diag", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
                               320, 240, SDL_WINDOW_SHOWN);
    if (win == null) { print(`window failed: ${SDL_GetError()}`); return; }

    let ren = SDL_CreateRenderer(win, -1, 0);
    if (ren == null) { print(`renderer failed: ${SDL_GetError()}`); return; }

    let info = alloc(INFO_SIZE);
    memset(info, 0, INFO_SIZE);
    if (SDL_GetRendererInfo(ren, info) == 0) {
        let namep = ptr_deref_ptr(info);
        print(`renderer name: ${cstr(namep)}`);
        print(`renderer flags: ${ptr_deref_u32(ptr_offset(info, 8, 1))}`);
        let nfmt = ptr_deref_u32(ptr_offset(info, 12, 1));
        print(`num_texture_formats: ${nfmt}`);
        for (let i = 0; i < nfmt; i++) {
            print(`  format[${i}] = ${ptr_deref_u32(ptr_offset(info, 16 + i * 4, 1))}`);
        }
    } else {
        print(`GetRendererInfo failed: ${SDL_GetError()}`);
    }

    print(`--- texture creation (this is what upload_texture does) ---`);
    let t1 = SDL_CreateTexture(ren, SDL_PIXELFORMAT_RGB24, SDL_TEXTUREACCESS_STATIC, 64, 64);
    print(`RGB24  STATIC    -> ${t1}   err='${SDL_GetError()}'`);
    let t2 = SDL_CreateTexture(ren, SDL_PIXELFORMAT_RGB24, SDL_TEXTUREACCESS_STREAMING, 64, 64);
    print(`RGB24  STREAMING -> ${t2}   err='${SDL_GetError()}'`);
    let t3 = SDL_CreateTexture(ren, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STATIC, 64, 64);
    print(`ARGB8888 STATIC  -> ${t3}   err='${SDL_GetError()}'`);
    let t4 = SDL_CreateTexture(ren, SDL_PIXELFORMAT_RGB888, SDL_TEXTUREACCESS_STATIC, 64, 64);
    print(`RGB888 STATIC    -> ${t4}   err='${SDL_GetError()}'`);

    SDL_Quit();
}

main();
