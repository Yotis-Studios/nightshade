// diag_seq.hml — replicate wobbleweed's window_open + upload_texture as raw SDL
// calls, printing between each one, to find which call actually faults.
// DIAG_LOGICAL=0 skips SDL_RenderSetLogicalSize
// DIAG_PRETEX=0 skips creating the framebuffer streaming texture first
// DIAG_SCALEMODE=0 skips SDL_SetTextureScaleMode

import "libSDL2-2.0.so.0";
import { getenv } from "@stdlib/env";

extern fn SDL_Init(flags: u32): i32;
extern fn SDL_CreateWindow(title: string, x: i32, y: i32, w: i32, h: i32, flags: u32): ptr;
extern fn SDL_CreateRenderer(win: ptr, index: i32, flags: u32): ptr;
extern fn SDL_CreateTexture(ren: ptr, format: u32, access: i32, w: i32, h: i32): ptr;
extern fn SDL_RenderSetLogicalSize(ren: ptr, w: i32, h: i32): i32;
extern fn SDL_UpdateTexture(tex: ptr, rect: ptr, pixels: ptr, pitch: i32): i32;
extern fn SDL_SetTextureScaleMode(tex: ptr, mode: i32): i32;
extern fn SDL_GetError(): string;
extern fn SDL_Quit(): void;

let SDL_INIT_VIDEO = 32;
let SDL_WINDOWPOS_CENTERED = 805240832;
let SDL_WINDOW_SHOWN = 4;
let SDL_PIXELFORMAT_RGB24 = 386930691;
let SDL_TEXTUREACCESS_STATIC = 0;
let SDL_TEXTUREACCESS_STREAMING = 1;
let SDL_SCALEMODE_NEAREST = 0;

fn envi(n: string, d: i32): i32 { let s = getenv(n); if (s == null) { return d; } return i32(s); }

fn main() {
    let do_logical = envi("DIAG_LOGICAL", 1);
    let do_pretex = envi("DIAG_PRETEX", 1);
    let do_scalemode = envi("DIAG_SCALEMODE", 1);

    SDL_Init(SDL_INIT_VIDEO);
    let win = SDL_CreateWindow("diag", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, 320, 240, SDL_WINDOW_SHOWN);
    print(`window ${win}`);
    let ren = SDL_CreateRenderer(win, -1, 0);
    print(`renderer ${ren}`);

    if (do_logical == 1) {
        print("SDL_RenderSetLogicalSize...");
        print(`  -> ${SDL_RenderSetLogicalSize(ren, 320, 240)}`);
    }
    if (do_pretex == 1) {
        print("framebuffer streaming texture...");
        let fbt = SDL_CreateTexture(ren, SDL_PIXELFORMAT_RGB24, SDL_TEXTUREACCESS_STREAMING, 320, 240);
        print(`  -> ${fbt}`);
    }

    print("upload: SDL_CreateTexture RGB24 STATIC 64x64...");
    let t = SDL_CreateTexture(ren, SDL_PIXELFORMAT_RGB24, SDL_TEXTUREACCESS_STATIC, 64, 64);
    print(`  -> ${t} err='${SDL_GetError()}'`);

    let px = buffer(64 * 64 * 3);
    print(`upload: SDL_UpdateTexture ptr=${buffer_ptr(px)} pitch=192 ...`);
    let r = SDL_UpdateTexture(t, null, buffer_ptr(px), 64 * 3);
    print(`  -> ${r} err='${SDL_GetError()}'`);

    if (do_scalemode == 1) {
        print("upload: SDL_SetTextureScaleMode...");
        print(`  -> ${SDL_SetTextureScaleMode(t, SDL_SCALEMODE_NEAREST)}`);
    }
    print("SURVIVED");
    SDL_Quit();
}

main();
