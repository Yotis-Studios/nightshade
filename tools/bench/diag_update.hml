// diag_update.hml — isolate the upload_texture segfault.
// DIAG_FMT = rgb24 | argb8888 | rgb888     DIAG_ACCESS = static | streaming
// Run one combination per process (a crash takes the process with it).

import "libSDL2-2.0.so.0";
import { getenv } from "@stdlib/env";

extern fn SDL_Init(flags: u32): i32;
extern fn SDL_CreateWindow(title: string, x: i32, y: i32, w: i32, h: i32, flags: u32): ptr;
extern fn SDL_CreateRenderer(win: ptr, index: i32, flags: u32): ptr;
extern fn SDL_CreateTexture(ren: ptr, format: u32, access: i32, w: i32, h: i32): ptr;
extern fn SDL_UpdateTexture(tex: ptr, rect: ptr, pixels: ptr, pitch: i32): i32;
extern fn SDL_GetError(): string;
extern fn SDL_Quit(): void;

let SDL_INIT_VIDEO = 32;
let SDL_WINDOWPOS_CENTERED = 805240832;
let SDL_WINDOW_SHOWN = 4;
let SDL_PIXELFORMAT_RGB24 = 386930691;
let SDL_PIXELFORMAT_ARGB8888 = 372645892;
let SDL_PIXELFORMAT_RGB888 = 370546692;

fn main() {
    let fmtname = getenv("DIAG_FMT") ?? "rgb24";
    let accname = getenv("DIAG_ACCESS") ?? "static";
    let fmt = SDL_PIXELFORMAT_RGB24; let bpp = 3;
    if (fmtname == "argb8888") { fmt = SDL_PIXELFORMAT_ARGB8888; bpp = 4; }
    if (fmtname == "rgb888") { fmt = SDL_PIXELFORMAT_RGB888; bpp = 4; }
    let acc = 0;
    if (accname == "streaming") { acc = 1; }

    SDL_Init(SDL_INIT_VIDEO);
    let win = SDL_CreateWindow("diag", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
                               320, 240, SDL_WINDOW_SHOWN);
    let ren = SDL_CreateRenderer(win, -1, 0);
    if (ren == null) { print("no renderer"); return; }

    let W = 64; let H = 64;
    let tex = SDL_CreateTexture(ren, fmt, acc, W, H);
    print(`create ${fmtname}/${accname} -> ${tex}`);
    if (tex == null) { print(`create failed: ${SDL_GetError()}`); return; }

    let px = alloc(W * H * bpp);
    memset(px, 128, W * H * bpp);
    print(`calling SDL_UpdateTexture pitch=${W * bpp} ...`);
    let r = SDL_UpdateTexture(tex, null, px, W * bpp);
    print(`SDL_UpdateTexture -> ${r}  err='${SDL_GetError()}'`);
    print(`OK ${fmtname}/${accname}`);
    SDL_Quit();
}

main();
