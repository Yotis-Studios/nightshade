// diag_wobble.hml — bisect wobbleweed's own window_open + upload_texture path
// on the accelerated renderer, printing between every step.

import { window_open, upload_texture } from "../../../wobbleweed/src/sdl.hml";
import { tex_grass } from "../../../wobbleweed/src/texture.hml";

fn main() {
    print("step 1: window_open");
    let win = window_open("diag", 320, 240, 1);
    if (win == null) { print("window_open returned null"); return; }
    print(`  win=${win.win} ren=${win.ren} tex=${win.tex}`);

    print("step 2: build the wobbleweed texture object");
    let t = tex_grass(64, 64);
    print(`  width=${t.width} height=${t.height} data_len=${t.data.length}`);
    print(`  buffer_ptr=${buffer_ptr(t.data)}`);
    print(`  expected bytes = ${t.width * t.height * 3}`);

    print("step 3: upload_texture (this is where it dies)");
    let st = upload_texture(win, t);
    print(`  -> ${st}`);
    print("SURVIVED");
}

main();
