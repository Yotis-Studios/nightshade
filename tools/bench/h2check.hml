// H-2 verification + does it change our renderer's sort decision?
// The old compiled backend used a non-randomized Lomuto quicksort: O(n^2) time and
// O(n) recursion depth on ALREADY-SORTED input — which is exactly what a camera
// moving through a world produces frame to frame. v2.9.1 claims a stable merge sort.
import { time_ms } from "@stdlib/time";

fn build(n: i32, mode: i32): array {
    let a = [];
    let seed: u64 = 88172645463325252;
    for (let i = 0; i < n; i++) {
        if (mode == 0) {                       // already sorted — the pathological case
            a.push(f64(i));
        } else if (mode == 1) {                // reverse sorted
            a.push(f64(n - i));
        } else if (mode == 2) {                // random
            seed = seed ^ (seed << 13);
            seed = seed ^ (seed >> 7);
            seed = seed ^ (seed << 17);
            a.push(f64(seed & 65535));
        } else {                               // all equal — stability / degenerate pivot
            a.push(1.0);
        }
    }
    return a;
}

fn timed(n: i32, mode: i32, name: string) {
    let a = build(n, mode);
    let t0 = time_ms();
    a.sort(fn(p, q) { if (p > q) { return 1; } if (p < q) { return 0 - 1; } return 0; });
    let t1 = time_ms();
    // verify it actually sorted
    let bad = 0;
    for (let i = 1; i < a.length; i++) { if (a[i] < a[i-1]) { bad = bad + 1; } }
    print(`  ${name}  n=${n}  ${t1 - t0} ms   out-of-order=${bad}`);
}

fn main() {
    print("--- 2000 elements (our per-frame triangle count) ---");
    timed(2000, 2, "random  ");
    timed(2000, 0, "SORTED  ");
    timed(2000, 1, "reversed");
    timed(2000, 3, "all-equal");

    print("--- 20000 elements ---");
    timed(20000, 2, "random  ");
    timed(20000, 0, "SORTED  ");

    print("--- 200000 elements PRESORTED (this used to segfault) ---");
    timed(200000, 0, "SORTED  ");
    print("survived — no stack overflow");
}
main();
