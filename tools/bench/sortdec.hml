// Does v2.9.1's merge sort obsolete the per-triangle bucket sort in W1-1?
// Budget context: 2500 triangles/frame, 16.67 ms total, render slice <= 11 ms.
// The architecture chose a counting/bucket sort (claimed 0.39 ms @ 2000 tris).
import { time_ms } from "@stdlib/time";

let N = 2500;      // our real per-frame triangle count
let REPS = 200;    // repeat to get resolution below 1 ms

fn make(): array {
    let a = [];
    let seed: u64 = 88172645463325252;
    for (let i = 0; i < N; i++) {
        seed = seed ^ (seed << 13); seed = seed ^ (seed >> 7); seed = seed ^ (seed << 17);
        a.push(f64(seed & 1048575) / 1048575.0 * 72.0);   // depths over the 72 m fog range
    }
    return a;
}

// A: array.sort with a comparison closure — what the engine does today
fn bench_sort(): f64 {
    let t0 = time_ms();
    for (let r = 0; r < REPS; r++) {
        let a = make();
        a.sort(fn(p, q) { if (p > q) { return 1; } if (p < q) { return 0 - 1; } return 0; });
    }
    let t1 = time_ms();
    return t1 - t0;
}

// baseline: cost of make() alone, so we can subtract it
fn bench_make(): f64 {
    let t0 = time_ms();
    for (let r = 0; r < REPS; r++) { let a = make(); }
    let t1 = time_ms();
    return t1 - t0;
}

// B: O(n) counting/bucket sort on quantized depth — the W1-1 design.
// NB = 2048 buckets over the 72 m range.
let NB = 2048;
fn bench_bucket(): f64 {
    let counts = []; for (let i = 0; i < NB; i++) { counts.push(0); }
    let order = [];  for (let i = 0; i < N; i++) { order.push(0); }
    let t0 = time_ms();
    for (let r = 0; r < REPS; r++) {
        let a = make();
        for (let i = 0; i < NB; i++) { counts[i] = 0; }
        for (let i = 0; i < N; i++) {
            let b: i32 = i32(a[i] * 28.44);          // depth -> bucket
            if (b < 0) { b = 0; } if (b >= NB) { b = NB - 1; }
            counts[b] = counts[b] + 1;
        }
        let run: i32 = 0;
        for (let i = 0; i < NB; i++) { let c: i32 = counts[i]; counts[i] = run; run = run + c; }
        for (let i = 0; i < N; i++) {
            let b: i32 = i32(a[i] * 28.44);
            if (b < 0) { b = 0; } if (b >= NB) { b = NB - 1; }
            order[counts[b]] = i;
            counts[b] = counts[b] + 1;
        }
    }
    let t1 = time_ms();
    return t1 - t0;
}

fn main() {
    let mk = bench_make();
    let s = bench_sort();
    let b = bench_bucket();
    print(`build-only baseline : ${mk / REPS} ms/frame`);
    print(`array.sort(closure) : ${(s - mk) / REPS} ms/frame   (${N} tris, v2.9.1 merge sort)`);
    print(`bucket sort (O(n))  : ${(b - mk) / REPS} ms/frame   (NB=${NB})`);
    print(`bucket is ${(s - mk) / (b - mk)}x faster`);
}
main();
