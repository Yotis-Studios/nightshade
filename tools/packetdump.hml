// packetdump.hml — the wire-protocol reference dump and byte-layout gate. W4-13.
//
// Run COMPILED. Headless, and it links NO SDL: it imports src/net/{protocol,
// packing,quantize}.hml and @stdlib only.
//
//     hemlockc -O1 tools/packetdump.hml -o /tmp/pd && /tmp/pd
//     nm /tmp/pd | grep -c SDL_          # must be 0
//
// Modes:
//     (none)        reference + dump + verify   (the CI gate; exits 1 on failure)
//     --reference   just the protocol shapes, for a human writing server code
//     --dump        just the hexdump + decode of one real S_SNAPSHOT
//     --verify      just the assertions
//     --negative    just the "a one-byte layout change must fail" proof
//     --help
//
// ---------------------------------------------------------------------------
// WHAT THIS ASSERTS, AND THE ONE THING IT DELIBERATELY DOES NOT
// ---------------------------------------------------------------------------
// BUILD_PLAN W4-13 says "asserting every field's byte offset". There are two
// kinds of offset in a gn.hml packet and only one of them is a contract:
//
//   * ELEMENT offsets inside the packet are NOT fixed and MUST NOT be asserted.
//     gn.hml's `determine_type` picks the smallest type that fits the VALUE, so
//     "element 0: u32 server_tick" is two bytes on the wire at tick 5 and five
//     bytes at tick 70000. protocol.hml's own header says this in capitals.
//     Section E asserts that this is true — it builds the same message at two
//     tick values and shows the later elements move — precisely so that nobody
//     "fixes" the dump by pinning them.
//
//   * The byte layout INSIDE each blob IS the contract, and every field of
//     every stride is asserted here, empirically, against the REAL writers:
//     one field is set to a sentinel whose every byte is non-zero, the record
//     is built by `proto_write_snapshot` / `proto_write_input` /
//     `proto_write_events`, and the dump asserts that the sentinel's bytes are
//     exactly at the documented offset and that every other byte is zero. That
//     catches a wrong offset, a wrong width and a wrong endianness with one
//     test, and it cannot pass by restating the constant it is checking.
//
// Section D then flips every single byte of every stride, one at a time, and
// requires the decode to change. 80 bytes, 80 detections: no padding, no dead
// byte, nothing the wire carries that the decoder ignores.
//
// Section G is BUILD_PLAN's "a deliberate one-byte protocol change that must
// fail the dump": a mutant writer that puts px_q at +5 instead of +4 — one
// byte — is fed to the same offset checker that passes the real one, and the
// checker must reject it.
//
// ---------------------------------------------------------------------------
// DESIGN ANCHORS ARE PINNED WITH LITERALS
// ---------------------------------------------------------------------------
// CLAUDE.md: "assert the design, not the digits — but pin design ANCHORS to the
// doc with a literal." So `ENT_STRIDE == 20` is written as the literal 20 from
// NETWORKING §11.3, not as `ENT_STRIDE == ENT_STRIDE`. Editing packing.hml's
// constant turns this file red, which is the entire point of the file.

import { exit } from "@stdlib/process";
import { TAU } from "@stdlib/math";

import {
    NET_C_HELLO, NET_C_PING, NET_C_READY, NET_C_ACK_SNAPSHOT, NET_C_INPUT,
    NET_C_CHAT, NET_C_ACTION,
    NET_S_WELCOME, NET_S_PONG, NET_S_DISCONNECT, NET_S_SNAPSHOT,
    NET_S_SNAPSHOT_DELTA, NET_S_EVENT, NET_S_PLAYER_JOIN, NET_S_PLAYER_LEAVE,
    NET_S_CHUNK,
    EV_HIT, EV_KILL, EV_DAMAGE_TAKEN, EV_SPAWN, EV_DESPAWN, EV_PICKUP,
    EV_RELOAD_DONE, EV_WEAPON_SWITCH, EV_DOOR, EV_BLOCK_PLACED,
    EV_BLOCK_BROKEN, EV_XP, EV_LEVELUP, EV_SOUND,
    EF_TEAM_MASK, EF_CROUCH, EF_ADS, EF_FIRING, EF_DEAD, EF_HITFLASH,
    EF_DISSOLVE,
    MAX_CMDS_PER_PACKET, MAX_PAYLOAD,
    WT_U8, WT_U16, WT_U32, WT_S8, WT_S16, WT_S32, WT_F32, WT_F64,
    WT_STRING, WT_BUFFER, WT_UNDEF, WT_COUNT,
    ENT_STRIDE, CMD_STRIDE, EV_STRIDE,
    proto_msg, proto_msg_reset, proto_net_id, proto_count, proto_get, proto_add,
    proto_audit, proto_audit_gameplay, proto_wtype, proto_build, proto_load,
    proto_parse_frame, proto_blob_count,
    proto_refused, proto_oversize, proto_malformed, proto_diag_reset,
    cmdq_new, cmdq_reset, cmdq_count, cmdq_push,
    proto_write_input, proto_read_input,
    netents_new, netents_reset, netents_count, netents_push_q, netents_push,
