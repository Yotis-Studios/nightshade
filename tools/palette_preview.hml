// Seven keyframes. Fields per key, in one flat array<f64> of stride TOD_N.
let TOD_HOUR: i32 = 0;
let TOD_SUNX: i32 = 1;   let TOD_SUNY: i32 = 2;   let TOD_SUNZ: i32 = 3;
let TOD_SUNR: i32 = 4;   let TOD_SUNG: i32 = 5;   let TOD_SUNB: i32 = 6;
let TOD_AMBR: i32 = 7;   let TOD_AMBG: i32 = 8;   let TOD_AMBB: i32 = 9;
let TOD_BNCR: i32 = 10;  let TOD_BNCG: i32 = 11;  let TOD_BNCB: i32 = 12;
let TOD_FTR: i32 = 13;   let TOD_FTG: i32 = 14;   let TOD_FTB: i32 = 15;
let TOD_FNEAR: i32 = 16; let TOD_FFAR: i32 = 17;  let TOD_FAMAX: i32 = 18;
let TOD_ZENR: i32 = 19;  let TOD_ZENG: i32 = 20;  let TOD_ZENB: i32 = 21;
let TOD_MIDR: i32 = 22;  let TOD_MIDG: i32 = 23;  let TOD_MIDB: i32 = 24;
let TOD_HORR: i32 = 25;  let TOD_HORG: i32 = 26;  let TOD_HORB: i32 = 27;
let TOD_MIST: i32 = 28;  let TOD_STAR: i32 = 29;
let TOD_CLR: i32 = 30;   let TOD_CLG: i32 = 31;   let TOD_CLB: i32 = 32;
let TOD_CSR: i32 = 33;   let TOD_CSG: i32 = 34;   let TOD_CSB: i32 = 35;
let TOD_N: i32 = 36;

let g_tod: array<f64> = [];
let g_TOD_KEYS: i32 = 8;

fn tod_key(p_hour: f64,
           p_sx: f64, p_sy: f64, p_sz: f64,
           p_sr: f64, p_sg: f64, p_sb: f64,
           p_ar: f64, p_ag: f64, p_ab: f64,
           p_br: f64, p_bg: f64, p_bb: f64,
           p_tr: f64, p_tg: f64, p_tb: f64,
           p_fn: f64, p_ff: f64, p_fa: f64,
           p_zen: i32, p_mid: i32, p_hor: i32,
           p_mist: f64, p_star: f64,
           p_clit: i32, p_cshadow: i32) {
    g_tod.push(p_hour);
    g_tod.push(p_sx); g_tod.push(p_sy); g_tod.push(p_sz);
    g_tod.push(p_sr); g_tod.push(p_sg); g_tod.push(p_sb);
    g_tod.push(p_ar); g_tod.push(p_ag); g_tod.push(p_ab);
    g_tod.push(p_br); g_tod.push(p_bg); g_tod.push(p_bb);
    g_tod.push(p_tr); g_tod.push(p_tg); g_tod.push(p_tb);
    g_tod.push(p_fn); g_tod.push(p_ff); g_tod.push(p_fa);
    g_tod.push(f64(pal_r(p_zen))); g_tod.push(f64(pal_g(p_zen))); g_tod.push(f64(pal_b(p_zen)));
    g_tod.push(f64(pal_r(p_mid))); g_tod.push(f64(pal_g(p_mid))); g_tod.push(f64(pal_b(p_mid)));
    g_tod.push(f64(pal_r(p_hor))); g_tod.push(f64(pal_g(p_hor))); g_tod.push(f64(pal_b(p_hor)));
    g_tod.push(p_mist); g_tod.push(p_star);
    g_tod.push(f64(pal_r(p_clit))); g_tod.push(f64(pal_g(p_clit))); g_tod.push(f64(pal_b(p_clit)));
    g_tod.push(f64(pal_r(p_cshadow))); g_tod.push(f64(pal_g(p_cshadow))); g_tod.push(f64(pal_b(p_cshadow)));
}

fn tod_build() {
    // hour  sun dir          sun rgb            ambient rgb        bounce rgb         fog tint mul       near  far  amax   zenith           mid              horizon           mist star
    tod_key( 2.0,  0.20,-0.90, 0.39, 0.14,0.16,0.26, 0.14,0.15,0.26, 0.02,0.03,0.05, 0.13,0.16,0.30,  3.0, 22.0, 0.45,
             pal(8,10,30),    pal(14,18,48),   pal(22,28,52),   0.70, 1.00, pal(42,48,80), pal(18,24,44));
    tod_key( 5.5,  0.94, 0.10, 0.32, 0.80,0.50,0.28, 0.20,0.18,0.28, 0.09,0.08,0.04, 0.86,0.62,0.52,  8.0, 52.0, 1.00,
             pal(42,58,114),  pal(122,90,150), pal(232,164,104), 0.55, 0.15, pal(255,208,160), pal(142,110,136));
    tod_key( 8.0,  0.66, 0.60, 0.45, 0.72,0.64,0.48, 0.28,0.30,0.38, 0.11,0.13,0.06, 0.82,0.86,0.94, 14.0, 66.0, 1.00,
             pal(50,104,194), pal(90,150,218), pal(168,204,228), 0.18, 0.00, pal(242,240,228), pal(168,180,198));
    tod_key(12.0,  0.18, 0.96, 0.22, 0.58,0.56,0.50, 0.42,0.44,0.50, 0.13,0.16,0.07, 0.76,0.84,0.94, 20.0, 72.0, 1.00,
             pal(44,95,184),  pal(78,143,214), pal(168,210,232), 0.00, 0.00, pal(242,240,228), pal(150,163,184));
    tod_key(18.25,-0.72, 0.42,-0.55, 0.76,0.54,0.24, 0.24,0.22,0.32, 0.12,0.09,0.04, 0.96,0.72,0.44, 12.0, 64.0, 1.00,
             pal(46,74,142),  pal(138,90,130), pal(255,158,68),  0.55, 0.00, pal(255,192,112), pal(142,90,114));
    tod_key(19.5, -0.95, 0.08,-0.30, 0.44,0.24,0.30, 0.22,0.20,0.34, 0.06,0.05,0.05, 0.52,0.42,0.62,  6.0, 40.0, 0.90,
             pal(35,28,70),   pal(74,44,86),   pal(158,78,82),   0.60, 0.35, pal(180,112,122), pal(78,52,80));
    tod_key(22.0, -0.30,-0.55,-0.78, 0.22,0.24,0.34, 0.16,0.18,0.30, 0.03,0.04,0.06, 0.18,0.22,0.36,  4.0, 26.0, 0.55,
             pal(12,16,40),   pal(20,26,56),   pal(38,48,78),    0.70, 1.00, pal(58,66,96), pal(26,32,56));
    tod_key(26.0,  0.20,-0.90, 0.39, 0.14,0.16,0.26, 0.14,0.15,0.26, 0.02,0.03,0.05, 0.13,0.16,0.30,  3.0, 22.0, 0.45,
             pal(8,10,30),    pal(14,18,48),   pal(22,28,52),    0.70, 1.00, pal(42,48,80), pal(18,24,44));
}
tod_build();

let WX_CLEAR: i32 = 0;
let WX_OVERCAST: i32 = 1;
let WX_RAIN: i32 = 2;
let WX_STORM: i32 = 3;
let WX_BLOOM: i32 = 4;

fn wx_name(p_w: i32): string {
    if (p_w == WX_OVERCAST) { return "overcast"; }
    if (p_w == WX_RAIN) { return "rain"; }
    if (p_w == WX_STORM) { return "storm"; }
    if (p_w == WX_BLOOM) { return "bloom"; }
    return "clear";
}
fn wx_parse(p_s: string): i32 {
    if (p_s == "overcast") { return WX_OVERCAST; }
    if (p_s == "rain") { return WX_RAIN; }
    if (p_s == "storm") { return WX_STORM; }
    if (p_s == "bloom") { return WX_BLOOM; }
    if (p_s == "clear") { return WX_CLEAR; }
    return -1;
}

// The evaluated frame environment, one f64 per TOD_* field, after keyframe
// interpolation and the weather override. Read by the sky, the fog, the
let g_ev: array<f64> = [];
for (let i = 0; i < TOD_N; i++) { g_ev.push(0.0); }

// tod_eval: hours (0..24) + weather -> g_ev + the engine RenderEnv.
// Same shape as src/art/tod.hml's `tod_eval(env, day_t, weather)` (§5.3).
fn tod_eval(p_env: array<f64>, p_hours: f64, p_wx: i32, p_lightning: i32,
            p_fog_far_override: f64, p_mist_override: f64,
            p_camx: f64, p_camy: f64, p_camz: f64, p_ground: f64) {
    let h: f64 = p_hours;
    if (h < 2.0) { h = h + 24.0; }
    if (h > 26.0) { h = 26.0; }
    let k: i32 = 0;
    while (k < g_TOD_KEYS - 2 && g_tod[(k + 1) * TOD_N + TOD_HOUR] < h) { k++; }
    let h0: f64 = g_tod[k * TOD_N + TOD_HOUR];
    let h1: f64 = g_tod[(k + 1) * TOD_N + TOD_HOUR];
    let t: f64 = 0.0;
    if (h1 > h0) { t = clamp01((h - h0) / (h1 - h0)); }
    let a: i32 = k * TOD_N;
    let b: i32 = (k + 1) * TOD_N;
    for (let f = 0; f < TOD_N; f++) {
        g_ev[f] = lerpf(g_tod[a + f], g_tod[b + f], t);
    }

    // --- weather override (ART_BIBLE §5.2) --------------------------------
    let wx: i32 = p_wx;
    let sunmul: f64 = 1.0;
    let ambt: f64 = 0.0;
    let ambr: f64 = 0.0; let ambg: f64 = 0.0; let ambb: f64 = 0.0;
    let ftr: f64 = 1.0; let ftg: f64 = 1.0; let ftb: f64 = 1.0;
    let fnear: f64 = g_ev[TOD_FNEAR];
    let ffar: f64 = g_ev[TOD_FFAR];
    if (wx == WX_OVERCAST) {
        sunmul = 0.42; ambt = 0.65; ambr = 0.58; ambg = 0.59; ambb = 0.62;
        ftr = 0.94; ftg = 0.95; ftb = 0.97; fnear = 10.0; ffar = 48.0;
    } else if (wx == WX_RAIN) {
        sunmul = 0.30; ambt = 0.70; ambr = 0.44; ambg = 0.46; ambb = 0.52;
        ftr = 0.80; ftg = 0.84; ftb = 0.90; fnear = 6.0; ffar = 34.0;
    } else if (wx == WX_STORM) {
        sunmul = 0.20; ambt = 0.80; ambr = 0.30; ambg = 0.31; ambb = 0.38;
        ftr = 0.60; ftg = 0.62; ftb = 0.72; fnear = 3.0; ffar = 20.0;
    } else if (wx == WX_BLOOM) {
        sunmul = 0.55; ambt = 0.60; ambr = 0.22; ambg = 0.14; ambb = 0.32;
        ftr = 0.66; ftg = 0.40; ftb = 0.92; fnear = 5.0; ffar = 30.0;
    }
    g_ev[TOD_SUNR] = g_ev[TOD_SUNR] * sunmul;
    g_ev[TOD_SUNG] = g_ev[TOD_SUNG] * sunmul;
    g_ev[TOD_SUNB] = g_ev[TOD_SUNB] * sunmul;
    g_ev[TOD_AMBR] = lerpf(g_ev[TOD_AMBR], ambr, ambt);
    g_ev[TOD_AMBG] = lerpf(g_ev[TOD_AMBG], ambg, ambt);
    g_ev[TOD_AMBB] = lerpf(g_ev[TOD_AMBB], ambb, ambt);
    g_ev[TOD_FTR] = g_ev[TOD_FTR] * ftr;
    g_ev[TOD_FTG] = g_ev[TOD_FTG] * ftg;
    g_ev[TOD_FTB] = g_ev[TOD_FTB] * ftb;
    if (wx != WX_CLEAR) { g_ev[TOD_FNEAR] = fnear; g_ev[TOD_FFAR] = ffar; }

    // Lightning: two frames of flat blue-white ambient (§5.2). Two triangles
    // and one variable, for the most dramatic image in the game.
    if (p_lightning != 0) {
        g_ev[TOD_AMBR] = 0.90; g_ev[TOD_AMBG] = 0.92; g_ev[TOD_AMBB] = 1.00;
        g_ev[TOD_SUNR] = 0.10; g_ev[TOD_SUNG] = 0.08; g_ev[TOD_SUNB] = 0.00;
    }

    if (p_fog_far_override > 0.0) { g_ev[TOD_FFAR] = p_fog_far_override; }
    if (p_mist_override >= 0.0) { g_ev[TOD_MIST] = p_mist_override; }
    // CLAUDE.md §6: FOG_FAR never exceeds 72 m.
    if (g_ev[TOD_FFAR] > 72.0) { g_ev[TOD_FFAR] = 72.0; }
    if (g_ev[TOD_FNEAR] < 3.0) { g_ev[TOD_FNEAR] = 3.0; }
    if (g_ev[TOD_FNEAR] > g_ev[TOD_FFAR] - 4.0) { g_ev[TOD_FNEAR] = g_ev[TOD_FFAR] - 4.0; }

    // --- into the engine RenderEnv ----------------------------------------
    // At night SUN_DIR drives the moon term, negated (ART_BIBLE §5.1 note 1).
    let sx: f64 = g_ev[TOD_SUNX];
    let sy: f64 = g_ev[TOD_SUNY];
    let sz: f64 = g_ev[TOD_SUNZ];
    if (sy < 0.0) { sx = 0.0 - sx; sy = 0.0 - sy; sz = 0.0 - sz; }
    env_set_sun(p_env, sx, sy, sz, g_ev[TOD_SUNR], g_ev[TOD_SUNG], g_ev[TOD_SUNB]);
    env_set_ambient(p_env, g_ev[TOD_AMBR], g_ev[TOD_AMBG], g_ev[TOD_AMBB]);
    env_set_bounce(p_env, g_ev[TOD_BNCR], g_ev[TOD_BNCG], g_ev[TOD_BNCB]);
    env_set_camera(p_env, p_camx, p_camy, p_camz);
    env_set_fog(p_env, g_ev[TOD_FNEAR], g_ev[TOD_FFAR],
                g_ev[TOD_FTR], g_ev[TOD_FTG], g_ev[TOD_FTB], g_ev[TOD_FAMAX]);
    // §6.4 height fog. The literal reading of "MIST_BOTTOM = terrain height"
    // puts every ground vertex at h = 1 and drowns the whole world in mist —
    // the point is that VALLEYS fill and hilltops stand clear, so the band is
    // an absolute world-Y band pinned just BELOW the camera's own ground.
    // Walking downhill then visibly submerges you, which is the effect §6.4
    // is actually describing.
    env_set_mist(p_env, p_ground - 1.1, p_ground - 4.6, g_ev[TOD_MIST]);
}

// --- texture generation (ART_BIBLE §7 -> src/art/texgen.hml, W2-5) --------
// ===========================================================================
