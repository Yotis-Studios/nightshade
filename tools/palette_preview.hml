// ===========================================================================
// nightshade/tools/palette_preview.hml — the palette contact sheet (W2-11)
// ===========================================================================
//
// Built BEFORE texgen on purpose (BUILD_PLAN W2-11): a palette error caught
// here costs minutes; the same error caught after fifty tiles are baked costs
// a day. It answers three questions and nothing else:
//
//   1. What does every colour in the palette actually look like, together?
//   2. What does a single albedo look like under all eight ToD keyframes and
//      all five weathers — evaluated through the REAL lighting kernel
//      (shade.hml `env_bind` + `env_light_rgb`), not a re-implementation?
//   3. Does `ambient + sun` still sum to <= (1,1,1) at every keyframe? That
//      invariant is what makes "vertex colour can only darken" true, and it is
//      the one palette rule the renderer cannot recover from.
//
//   hemlockc -O1 tools/palette_preview.hml -o /tmp/palprev
//   /tmp/palprev --out docs/shots/palette_preview.png
//
// No SDL window, no renderer: it rasterises into an RGB buffer and writes PNG.
//
// ---------------------------------------------------------------------------
// WAVE-2 STAND-IN CONTENT
// ---------------------------------------------------------------------------
// The palette and the ToD keyframe table below are the same fenced stand-ins
// as in tools/shot.hml (W2-3 and W2-4 were being written in parallel with this
// file). W3-7 deletes the fence and imports src/art/palette.hml and
// src/art/tod.hml. The LIGHTING is not a stand-in: it is shade.hml's shipping
// kernel, which is the whole point of the sphere.
// ===========================================================================

import { exit } from "@stdlib/process";
import { exists, make_dirs } from "@stdlib/fs";
import { sin, cos, sqrt, floor, divi } from "@stdlib/math";
import { write_png } from "../../wobbleweed/src/png.hml";
import { env_new, env_set_sun, env_set_ambient, env_set_bounce, env_set_camera,
         env_set_fog, env_set_mist, env_bind, env_light_rgb, env_fog_factor,
         env_field, ENV_SUN_R, ENV_SUN_G, ENV_SUN_B,
         ENV_AMB_R, ENV_AMB_G, ENV_AMB_B }
       from "../../wobbleweed/src/shade.hml";

fn h2(p_x: i32, p_y: i32, p_s: i32): f64 {
    let hx: u64 = u64(p_x & 1048575);
    let hy: u64 = u64(p_y & 1048575);
    let hs: u64 = u64(p_s & 1048575);
    let h: u64 = hx * 374761393 + hy * 668265263 + hs * 2246822519 + 3266489917;
    h = h ^ (h >> 13);
    h = h * 1274126177;
    h = h ^ (h >> 16);
    let out: f64 = f64(h & 65535) * 0.0000152587890625;
    return out;
}

fn vnoise2(p_x: f64, p_y: f64, p_s: i32): f64 {
    let xi: i32 = i32(floor(p_x));
    let yi: i32 = i32(floor(p_y));
    let xf: f64 = p_x - f64(xi);
    let yf: f64 = p_y - f64(yi);
    let u: f64 = xf * xf * (3.0 - 2.0 * xf);
    let v: f64 = yf * yf * (3.0 - 2.0 * yf);
    let a: f64 = h2(xi, yi, p_s);
    let b: f64 = h2(xi + 1, yi, p_s);
    let c: f64 = h2(xi, yi + 1, p_s);
    let d: f64 = h2(xi + 1, yi + 1, p_s);
    let ab: f64 = a + (b - a) * u;
    let cd: f64 = c + (d - c) * u;
    let out: f64 = ab + (cd - ab) * v;
    return out;
}

fn clamp01(p_v: f64): f64 {
    let v: f64 = p_v;
    if (v < 0.0) { v = 0.0; }
    if (v > 1.0) { v = 1.0; }
    let out: f64 = v;
    return out;
}

fn lerpf(p_a: f64, p_b: f64, p_t: f64): f64 {
    let out: f64 = p_a + (p_b - p_a) * p_t;
    return out;
}

fn clampi(p_v: i32, p_lo: i32, p_hi: i32): i32 {
    let v: i32 = p_v;
    if (v < p_lo) { v = p_lo; }
    if (v > p_hi) { v = p_hi; }
    let out: i32 = v;
    return out;
}

