// ===========================================================================
// nightshade/tools/palette_preview.hml — the palette contact sheet (W2-11)
// ===========================================================================
//
// Built BEFORE texgen on purpose (BUILD_PLAN W2-11): a palette error caught
// here costs minutes; the same error caught after fifty tiles are baked costs
// a day. It answers four questions and nothing else:
//
//   1. What does every colour in the palette actually look like, together?
//      All 125 of them, read from `pal_table()` — not a hand-copied subset.
//   2. What does a single albedo look like under all seven ToD keyframes and
//      all five weathers — evaluated through the REAL lighting kernel
//      (shade.hml `env_bind` + `env_light_rgb`), not a re-implementation?
//   3. Does `ambient + sun` still sum to <= (1,1,1) at every keyframe? That
//      invariant is what makes "vertex colour can only darken" true, and it is
//      the one palette rule the renderer cannot recover from.
//   4. §2.1's minimum-albedo-luminance ruling: are the three sub-72 world
//      albedos actually unreadable on the shadow side? The last panel shows
//      the palette entry, the tile texgen builds from it, and that tile
//      multiplied by the darkest shading the game can produce — at 1:1, which
//      is the size these tiles occupy at 320x240.
//
//   hemlockc -O1 tools/palette_preview.hml -o /tmp/palprev
//   /tmp/palprev --out docs/shots/palette_preview.png
//
// No SDL window, no renderer: it rasterises into an RGB buffer and writes PNG.
//
// ---------------------------------------------------------------------------
// W3-7 — THE STAND-INS ARE GONE
// ---------------------------------------------------------------------------
// Until W3-7 this file carried ~250 lines of fenced stand-in palette and ToD
// tables (W2-3 and W2-4 were being written in parallel with it). The sheet it
// produced therefore showed a throwaway palette under a throwaway ToD, and its
// most-cited artefact — IDENTICAL sky bands for CLEAR / OVERCAST / RAIN /
// STORM, filed as a tod.hml bug — was a property of the stand-in's flat
// weather table. The fence is DELETED; this tool now imports
// src/art/{palette,tod,texgen}.hml. The real `tod_sky_keys` blends the three
// sky bands toward the cloud colours by `occ = (cover - 0.25) / 0.75`, so the
// four weather rows are now four visibly different skies. See the report.
//
// The LIGHTING was never a stand-in: it is shade.hml's shipping kernel, which
// is the whole point of the spheres.
// ===========================================================================

import { exit } from "@stdlib/process";
import { exists, make_dirs } from "@stdlib/fs";
import { sqrt, divi } from "@stdlib/math";
import { write_png } from "../../wobbleweed/src/png.hml";
import { atlas_new, atlas_get, atlas_cell_x, atlas_cell_y }
       from "../../wobbleweed/src/atlas.hml";
import { env_new, env_bind, env_light_rgb, env_fog_factor, env_field,
         ENV_SUN_X, ENV_SUN_Y, ENV_SUN_Z,
         ENV_SUN_R, ENV_SUN_G, ENV_SUN_B,
         ENV_AMB_R, ENV_AMB_G, ENV_AMB_B,
         ENV_FOG_NEAR, ENV_FOG_FAR, ENV_FOG_R, ENV_FOG_G, ENV_FOG_B }
       from "../../wobbleweed/src/shade.hml";

import { pal_r, pal_g, pal_b, pal_lum, pal_table, pal_names, pal_families,
         g_PAL_FAM_TERRAIN, g_PAL_FAM_METAL,
         g_GRASS_MID, g_CONCRETE_MID, g_NIGHTSHADE_FLORA, g_STONE_MID,
         g_BARK_LO, g_RUST_DARK, g_WOOD_LO,
         g_UI_WHITE, g_UI_DIM, g_UI_BLACK, g_UI_AMBER, g_UI_DANGER, g_UI_GOOD }
       from "../src/art/palette.hml";

import { tod_eval, tod_reset, tod_clock_hours, tod_sky_keys, tod_mist_density,
         tod_key_anchor, tod_key_field,
         TOD_KEY_COUNT, TODSKY_COUNT,
         TODSKY_ZENITH_R, TODSKY_MID_R, TODSKY_HORIZON_R,
         TODSKY_STAR_ALPHA, TODSKY_CLOUD_COVER,
         WX_CLEAR, WX_OVERCAST, WX_RAIN, WX_STORM, WX_BLOOM }
       from "../src/art/tod.hml";

import { texgen_build_world_atlas, texgen_cell_name,
         CELL_BARK, CELL_METAL_RUST, CELL_WOOD_PLANK }
       from "../src/art/texgen.hml";

fn clampi(p_v: i32, p_lo: i32, p_hi: i32): i32 {
    let v: i32 = p_v;
    if (v < p_lo) { v = p_lo; }
    if (v > p_hi) { v = p_hi; }
    let out: i32 = v;
    return out;
}

fn lerpf(p_a: f64, p_b: f64, p_t: f64): f64 {
    let out: f64 = p_a + (p_b - p_a) * p_t;
    return out;
}

// ===========================================================================
// THE SHEET
// ===========================================================================

let g_img: buffer = buffer(1);
let g_iw: i32 = 1;
let g_ih: i32 = 1;

fn img_new(p_w: i32, p_h: i32) {
    g_iw = p_w; g_ih = p_h;
    g_img = buffer(p_w * p_h * 3);
}
fn img_px(p_x: i32, p_y: i32, p_r: i32, p_g: i32, p_b: i32) {
    if (p_x < 0 || p_y < 0 || p_x >= g_iw || p_y >= g_ih) { return; }
    let o: i32 = (p_y * g_iw + p_x) * 3;
    let p: ptr = buffer_ptr(g_img);
    ptr_write_u8(ptr_offset(p, o, 1), p_r & 255);
    ptr_write_u8(ptr_offset(p, o + 1, 1), p_g & 255);
    ptr_write_u8(ptr_offset(p, o + 2, 1), p_b & 255);
}
fn img_rect(p_x: i32, p_y: i32, p_w: i32, p_h: i32, p_c: i32) {
    for (let y = 0; y < p_h; y++) {
        for (let x = 0; x < p_w; x++) {
            img_px(p_x + x, p_y + y, pal_r(p_c), pal_g(p_c), pal_b(p_c));
        }
    }
}

// 3x5 label font, same bitfields as FONT_MICRO, blitted straight into the RGB
// buffer with the mandatory 1-px UI_BLACK shadow. Local on purpose: this sheet
// must stay readable even when hudgen's font is the thing that is broken.
let g_lbl: array<i32> = [];
fn lbl_add(p_cp: i32, p_a: i32, p_b: i32, p_c: i32, p_d: i32, p_e: i32) {
    g_lbl.push(p_cp);
    g_lbl.push(p_a); g_lbl.push(p_b); g_lbl.push(p_c); g_lbl.push(p_d); g_lbl.push(p_e);
}
fn lbl_build() {
    lbl_add(32, 0,0,0,0,0);
    lbl_add(48, 7,5,5,5,7); lbl_add(49, 2,6,2,2,7); lbl_add(50, 7,1,7,4,7);
    lbl_add(51, 7,1,7,1,7); lbl_add(52, 5,5,7,1,1); lbl_add(53, 7,4,7,1,7);
    lbl_add(54, 7,4,7,5,7); lbl_add(55, 7,1,1,1,1); lbl_add(56, 7,5,7,5,7);
    lbl_add(57, 7,5,7,1,7);
    lbl_add(65, 7,5,7,5,5); lbl_add(66, 6,5,6,5,6); lbl_add(67, 7,4,4,4,7);
    lbl_add(68, 6,5,5,5,6); lbl_add(69, 7,4,7,4,7); lbl_add(70, 7,4,7,4,4);
    lbl_add(71, 7,4,5,5,7); lbl_add(72, 5,5,7,5,5); lbl_add(73, 7,2,2,2,7);
    lbl_add(74, 1,1,1,5,7); lbl_add(75, 5,5,6,5,5); lbl_add(76, 4,4,4,4,7);
    lbl_add(77, 5,7,7,5,5); lbl_add(78, 5,7,7,7,5); lbl_add(79, 7,5,5,5,7);
    lbl_add(80, 7,5,7,4,4); lbl_add(81, 7,5,5,7,3); lbl_add(82, 7,5,7,6,5);
    lbl_add(83, 7,4,7,1,7); lbl_add(84, 7,2,2,2,2); lbl_add(85, 5,5,5,5,7);
    lbl_add(86, 5,5,5,5,2); lbl_add(87, 5,5,7,7,5); lbl_add(88, 5,5,2,5,5);
    lbl_add(89, 5,5,2,2,2); lbl_add(90, 7,1,2,4,7);
    lbl_add(46, 0,0,0,0,2); lbl_add(58, 0,2,0,2,0); lbl_add(47, 1,1,2,4,4);
    lbl_add(45, 0,0,7,0,0); lbl_add(95, 0,0,0,0,7); lbl_add(37, 5,1,2,4,5);
    lbl_add(40, 1,2,2,2,1); lbl_add(41, 4,2,2,2,4); lbl_add(44, 0,0,0,2,4);
    lbl_add(43, 0,2,7,2,0); lbl_add(62, 4,2,1,2,4); lbl_add(33, 2,2,2,0,2);
}
lbl_build();

fn img_text(p_x: i32, p_y: i32, p_s: string, p_c: i32) {
    let n: i32 = g_lbl.length;
    let cx: i32 = p_x;
    for (let i = 0; i < p_s.length; i++) {
        let cp: i32 = i32(p_s.byte_at(i));
        if (cp >= 97 && cp <= 122) { cp = cp - 32; }
        let gi: i32 = -1;
        for (let k = 0; k < n; k = k + 6) {
            if (g_lbl[k] == cp) { gi = k; }
        }
        if (gi >= 0) {
            for (let r = 0; r < 5; r++) {
                let bits: i32 = g_lbl[gi + 1 + r];
                for (let c = 0; c < 3; c++) {
                    if (((bits >> (2 - c)) & 1) == 1) { img_px(cx + c + 1, p_y + r + 1, 10, 12, 16); }
                }
            }
            for (let r2 = 0; r2 < 5; r2++) {
                let bits2: i32 = g_lbl[gi + 1 + r2];
                for (let c2 = 0; c2 < 3; c2++) {
                    if (((bits2 >> (2 - c2)) & 1) == 1) {
                        img_px(cx + c2, p_y + r2, pal_r(p_c), pal_g(p_c), pal_b(p_c));
                    }
                }
            }
        }
        cx = cx + 4;
    }
}

let g_bayer4: array<i32> = [ 0, 8, 2,10, 12, 4,14, 6, 3,11, 1, 9, 15, 7,13, 5];
let g_fail: i32 = 0;

// One sphere of `albedo`, lit by whatever env is currently bound. This is the
// SHIPPING kernel: env_light_rgb is the same function mesh_bake_light calls.
fn sphere(p_x: i32, p_y: i32, p_r: i32, p_albedo: i32) {
    let r: i32 = p_r;
    let ar: f64 = f64(pal_r(p_albedo));
    let ag: f64 = f64(pal_g(p_albedo));
    let ab: f64 = f64(pal_b(p_albedo));
    for (let j = 0 - r; j <= r; j++) {
        for (let i = 0 - r; i <= r; i++) {
            let nx: f64 = f64(i) / f64(r);
            let ny: f64 = 0.0 - f64(j) / f64(r);
            let d2: f64 = nx * nx + ny * ny;
            if (d2 <= 1.0) {
                let nz: f64 = sqrt(1.0 - d2);
                let c: u32 = env_light_rgb(nx, ny, nz, 0.0, 1.0, 0.0);
                let lr: f64 = f64(c & 255) / 255.0;
                let lg: f64 = f64((c >> 8) & 255) / 255.0;
                let lb: f64 = f64((c >> 16) & 255) / 255.0;
                img_px(p_x + i, p_y + j,
                       clampi(i32(ar * lr), 0, 255),
                       clampi(i32(ag * lg), 0, 255),
                       clampi(i32(ab * lb), 0, 255));
            }
        }
    }
}

// The fog ramp: the same albedo marched from 0 to FOG_FAR through the shipping
// fog curve, so "does the fog colour match the horizon" is a look, not a guess.
fn fog_ramp(p_x: i32, p_y: i32, p_w: i32, p_h: i32, p_albedo: i32,
            p_env: array<f64>) {
    let far: f64 = env_field(p_env, ENV_FOG_FAR);
    let ftr: f64 = env_field(p_env, ENV_FOG_R);
    let ftg: f64 = env_field(p_env, ENV_FOG_G);
    let ftb: f64 = env_field(p_env, ENV_FOG_B);
    for (let x = 0; x < p_w; x++) {
        let d: f64 = far * f64(x) / f64(p_w);
        let f: f64 = env_fog_factor(0.0, 1.5, d);
        let r: i32 = clampi(i32(f64(pal_r(p_albedo)) * (1.0 - f * (1.0 - ftr))), 0, 255);
        let g: i32 = clampi(i32(f64(pal_g(p_albedo)) * (1.0 - f * (1.0 - ftg))), 0, 255);
        let b: i32 = clampi(i32(f64(pal_b(p_albedo)) * (1.0 - f * (1.0 - ftb))), 0, 255);
        for (let y = 0; y < p_h; y++) { img_px(p_x + x, p_y + y, r, g, b); }
    }
}

// The three sky bands as tod.hml computes them RIGHT NOW. Weather reaches this
// strip through tod_sky_keys' cloud-cover blend, which is exactly the thing
// the old stand-in could not do.
fn sky_strip(p_x: i32, p_y: i32, p_w: i32, p_h: i32, p_s: array<f64>) {
    let s: array<f64> = p_s;
    for (let y = 0; y < p_h; y++) {
        let t: f64 = f64(y) / f64(p_h);
        let r: f64 = 0.0; let g: f64 = 0.0; let b: f64 = 0.0;
        if (t < 0.55) {
            let k: f64 = t / 0.55;
            r = lerpf(s[TODSKY_ZENITH_R], s[TODSKY_MID_R], k) * 255.0;
            g = lerpf(s[TODSKY_ZENITH_R + 1], s[TODSKY_MID_R + 1], k) * 255.0;
            b = lerpf(s[TODSKY_ZENITH_R + 2], s[TODSKY_MID_R + 2], k) * 255.0;
        } else {
            let k2: f64 = (t - 0.55) / 0.45;
            r = lerpf(s[TODSKY_MID_R], s[TODSKY_HORIZON_R], k2) * 255.0;
            g = lerpf(s[TODSKY_MID_R + 1], s[TODSKY_HORIZON_R + 1], k2) * 255.0;
            b = lerpf(s[TODSKY_MID_R + 2], s[TODSKY_HORIZON_R + 2], k2) * 255.0;
        }
        for (let x = 0; x < p_w; x++) {
            let d: f64 = f64(g_bayer4[(y % 4) * 4 + (x % 4)]) * 0.0625 - 0.47;
            img_px(p_x + x, p_y + y,
                   clampi(i32(r + d * 5.0), 0, 255),
                   clampi(i32(g + d * 5.0), 0, 255),
                   clampi(i32(b + d * 5.0), 0, 255));
        }
    }
}

// ===========================================================================
// THE §2.1 RULING PANEL
//
// ART_BIBLE §2.1 says no ATLAS_WORLD albedo may fall below luminance ~72,
// because "its shadow side (ambient floor ~ 0.35) lands at luminance 25 and
// becomes an unreadable black hole". Three §3 palette entries land under it:
// BARK_LO 70, RUST_DARK 71, WOOD_LO 67.
//
// This panel exists because the arithmetic settles the question and a swatch
// does not. For each case it draws, at 1:1 — the size a 4 m quad occupies at
// 320x240 — the palette entry, the tile texgen actually builds from it, and
// that tile multiplied by the darkest shading the shipping kernel produces
// (the shadow side, N = -SUN_DIR, at the DEEP keyframe where the ambient sits
// on TOD_AMBIENT_FLOOR = 0.14). If the ruling is wrong, it is wrong HERE and
// visibly so.
// ===========================================================================

// Shadow-side light multiplier under the currently bound env: the normal is
// turned away from the key, so N.L clamps to 0 and only ambient and bounce
// remain. Writes r,g,b (0..1) into p_out[0..2].
fn shadow_light(p_env: array<f64>, p_out: array<f64>) {
    let sx: f64 = env_field(p_env, ENV_SUN_X);
    let sy: f64 = env_field(p_env, ENV_SUN_Y);
    let sz: f64 = env_field(p_env, ENV_SUN_Z);
    let c: u32 = env_light_rgb(0.0 - sx, 0.0 - sy, 0.0 - sz, 0.0, 1.0, 0.0);
    let o: array<f64> = p_out;
    o[0] = f64(c & 255) / 255.0;
    o[1] = f64((c >> 8) & 255) / 255.0;
    o[2] = f64((c >> 16) & 255) / 255.0;
}

// Blit one 32x32 texgen cell at p_mag, multiplied by (mr,mg,mb). Returns the
// minimum Rec.601 luminance it produced — the number the ruling turns on.
fn tile_blit(p_a: object, p_cell: i32, p_x: i32, p_y: i32, p_mag: i32,
             p_mr: f64, p_mg: f64, p_mb: f64): i32 {
    let ox: i32 = atlas_cell_x(p_a, p_cell);
    let oy: i32 = atlas_cell_y(p_a, p_cell);
    let mag: i32 = p_mag;
    let lmin: i32 = 255;
    for (let y = 0; y < 32; y++) {
        for (let x = 0; x < 32; x++) {
            let p: u32 = atlas_get(p_a, ox + x, oy + y);
            let r: i32 = clampi(i32(f64(i32(p & 255)) * p_mr), 0, 255);
            let g: i32 = clampi(i32(f64(i32((p >> 8) & 255)) * p_mg), 0, 255);
            let b: i32 = clampi(i32(f64(i32((p >> 16) & 255)) * p_mb), 0, 255);
            let l: i32 = (77 * r + 151 * g + 28 * b) >> 8;
            if (l < lmin) { lmin = l; }
            for (let sy = 0; sy < mag; sy++) {
                for (let sx = 0; sx < mag; sx++) {
                    img_px(p_x + x * mag + sx, p_y + y * mag + sy, r, g, b);
                }
            }
        }
    }
    let out: i32 = lmin;
    return out;
}

fn swatch_lit(p_x: i32, p_y: i32, p_w: i32, p_h: i32, p_c: i32,
              p_mr: f64, p_mg: f64, p_mb: f64) {
    let r: i32 = clampi(i32(f64(pal_r(p_c)) * p_mr), 0, 255);
    let g: i32 = clampi(i32(f64(pal_g(p_c)) * p_mg), 0, 255);
    let b: i32 = clampi(i32(f64(pal_b(p_c)) * p_mb), 0, 255);
    for (let y = 0; y < p_h; y++) {
        for (let x = 0; x < p_w; x++) { img_px(p_x + x, p_y + y, r, g, b); }
    }
}

fn wx_name(p_wx: i32): string {
    if (p_wx == WX_CLEAR) { return "CLEAR"; }
    if (p_wx == WX_OVERCAST) { return "OVERCAST"; }
    if (p_wx == WX_RAIN) { return "RAIN"; }
    if (p_wx == WX_STORM) { return "STORM"; }
    return "NS BLOOM";
}

let g_KF_CLOCK: i32 = 38;

fn running_interpreted(): bool {
    if (args.length < 1) { return false; }
    let a0: string = args[0];
    let out: bool = a0.ends_with(".hml");
    return out;
}

fn main() {
    if (running_interpreted()) {
        eprint("palette_preview.hml is COMPILED-ONLY (ARCHITECTURE.md §7).");
        eprint("    hemlockc -O1 tools/palette_preview.hml -o /tmp/palprev");
        exit(2);
    }
    let out: string = "palette_preview.png";
    let seed: i32 = 1337;
    let i: i32 = 1;
    while (i < args.length) {
        let a: string = args[i];
        if (a == "--out" && i + 1 < args.length) { i++; out = args[i]; }
        else if (a == "--seed" && i + 1 < args.length) { i++; seed = i32(f64(args[i])); }
        else if (a == "--help") {
            print("palette_preview.hml — the palette contact sheet");
            print("  --out <path>   PNG path (default palette_preview.png)");
            print("  --seed <n>     texgen seed for the §2.1 ruling panel (default 1337)");
            exit(0);
        }
        else { eprint(`palette_preview: unknown argument '${a}'`); exit(2); }
        i++;
    }

    // ---- the real table, all of it ----------------------------------------
    let vals: array<i32> = pal_table();
    let names: array<string> = pal_names();
    let fams: array<i32> = pal_families();
    let n: i32 = vals.length;

    let cols: i32 = 8;
    let sw_w: i32 = 78;
    let sw_h: i32 = 40;
    let rows: i32 = divi(n + cols - 1, cols);
    let top_h: i32 = 24 + rows * sw_h;

    let row_h: i32 = 104;
    let mid_h: i32 = 16 + TOD_KEY_COUNT * row_h;
    let bot_h: i32 = 16 + 5 * row_h;
    let rule_h: i32 = 28 + 3 * 190;

    img_new(cols * sw_w + 16, top_h + mid_h + bot_h + rule_h + 24);
    img_rect(0, 0, g_iw, g_ih, 0x14161A);
    img_text(8, 4, "NIGHTSHADE PALETTE CONTACT SHEET", g_UI_WHITE);
    img_text(8, 11, `ART BIBLE 3 AND 5 - SRC/ART/PALETTE.HML AND TOD.HML - EVALUATED THROUGH SHADE.HML`, g_UI_DIM);
    img_text(8, 18, `${n} COLOURS - ${TOD_KEY_COUNT} KEYFRAMES - 5 WEATHERS - SEED ${seed}`, g_UI_DIM);

    // --- swatches ---------------------------------------------------------
    let below72: i32 = 0;
    for (let s = 0; s < n; s++) {
        let cx: i32 = 8 + (s % cols) * sw_w;
        let cy: i32 = 24 + divi(s, cols) * sw_h;
        img_rect(cx, cy, sw_w - 2, sw_h - 2, vals[s]);
        let lum: i32 = pal_lum(vals[s]);
        let ink: i32 = g_UI_WHITE;
        if (lum > 128) { ink = g_UI_BLACK; }
        img_text(cx + 3, cy + 3, names[s], ink);
        img_text(cx + 3, cy + 11, `${pal_r(vals[s])} ${pal_g(vals[s])} ${pal_b(vals[s])}`, ink);
        img_text(cx + 3, cy + 19, `L ${lum} F ${fams[s]}`, ink);
        // §2.1's minimum world-albedo luminance. Flagged, never hidden — the
        // last panel of this sheet is the ruling on the three that are under.
        if (fams[s] >= g_PAL_FAM_TERRAIN && fams[s] <= g_PAL_FAM_METAL) {
            if (lum < 72) {
                below72++;
                img_text(cx + 3, cy + 27, "SUB 72 - SEE 2.1", g_UI_AMBER);
            }
        }
    }

    // --- one keyframe per row: sphere, sky, fog ramp, sum check ------------
    let env: array<f64> = env_new();
    let sky: array<f64> = [];
    for (let z = 0; z < TODSKY_COUNT; z++) { sky.push(0.0); }

    let y0: i32 = top_h + 8;
    img_text(8, y0 - 6, "TIME OF DAY - GRASS MID, CONCRETE MID, NS FLORA SPHERES - SKY BAND - FOG RAMP TO FOG FAR", g_UI_WHITE);
    for (let k = 0; k < TOD_KEY_COUNT; k++) {
        let ry: i32 = y0 + 6 + k * row_h;
        // tod_reset before every eval: tod_eval advances a stateful weather
        // crossfade off the change in day_t, so a sweep that did not reset
        // would photograph half-finished fades and would not be reproducible.
        tod_reset();
        let day_t: f64 = tod_key_anchor(k);
        tod_eval(env, day_t, WX_CLEAR);
        tod_sky_keys(sky);
        env_bind(env);
        img_text(10, ry + 2, `KEY ${k} - ${i32(tod_key_field(k, g_KF_CLOCK))}H`, g_UI_WHITE);
        sphere(60, ry + 46, 40, g_GRASS_MID);
        sphere(150, ry + 46, 40, g_CONCRETE_MID);
        sphere(240, ry + 46, 40, g_NIGHTSHADE_FLORA);
        sky_strip(300, ry + 6, 60, 88, sky);
        fog_ramp(370, ry + 6, 230, 40, g_GRASS_MID, env);
        fog_ramp(370, ry + 50, 230, 40, g_STONE_MID, env);
        img_text(370, ry + 92,
                 `FOG ${i32(env_field(env, ENV_FOG_NEAR))} TO ${i32(env_field(env, ENV_FOG_FAR))}M  MIST ${i32(tod_mist_density() * 100.0)}%  STAR ${i32(sky[TODSKY_STAR_ALPHA] * 100.0)}%`,
                 g_UI_DIM);
        // ambient + sun must sum to <= 1 per channel, or a texture authored at
        // full-sun-noon albedo can be BRIGHTENED, which the renderer cannot do.
        let sr: f64 = env_field(env, ENV_SUN_R) + env_field(env, ENV_AMB_R);
        let sg: f64 = env_field(env, ENV_SUN_G) + env_field(env, ENV_AMB_G);
        let sb: f64 = env_field(env, ENV_SUN_B) + env_field(env, ENV_AMB_B);
        let okc: i32 = g_UI_GOOD;
        let msg: string = "AMB PLUS SUN LE 1 - OK";
        if (sr > 1.001 || sg > 1.001 || sb > 1.001) {
            okc = g_UI_DANGER;
            msg = "AMB PLUS SUN GT 1 - CANNOT DARKEN ONLY";
            g_fail = 1;
        }
        img_text(10, ry + 92, msg, okc);
        img_text(10, ry + 10, `T ${i32(day_t * 1000.0)}/1000  SUM ${i32(sr * 100.0)} ${i32(sg * 100.0)} ${i32(sb * 100.0)}`, g_UI_DIM);
    }

    // --- weather rows -----------------------------------------------------
    let y1: i32 = top_h + mid_h + 12;
    img_text(8, y1 - 6, "WEATHER OVERRIDES AT NOON - THE SKY BANDS MUST DIFFER (THE STAND-IN'S DID NOT)", g_UI_WHITE);
    let wxs: array<i32> = [WX_CLEAR, WX_OVERCAST, WX_RAIN, WX_STORM, WX_BLOOM];
    let noon_t: f64 = tod_key_anchor(2);
    for (let w = 0; w < 5; w++) {
        let ry2: i32 = y1 + 6 + w * row_h;
        tod_reset();
        tod_eval(env, noon_t, wxs[w]);
        tod_sky_keys(sky);
        env_bind(env);
        img_text(10, ry2 + 2, wx_name(wxs[w]), g_UI_WHITE);
        sphere(60, ry2 + 46, 40, g_GRASS_MID);
        sphere(150, ry2 + 46, 40, g_CONCRETE_MID);
        sphere(240, ry2 + 46, 40, g_NIGHTSHADE_FLORA);
        sky_strip(300, ry2 + 6, 60, 88, sky);
        fog_ramp(370, ry2 + 6, 230, 40, g_GRASS_MID, env);
        fog_ramp(370, ry2 + 50, 230, 40, g_STONE_MID, env);
        img_text(370, ry2 + 92,
                 `FOG ${i32(env_field(env, ENV_FOG_NEAR))} TO ${i32(env_field(env, ENV_FOG_FAR))}M  MIST ${i32(tod_mist_density() * 100.0)}%`,
                 g_UI_DIM);
        img_text(10, ry2 + 10,
                 `COVER ${i32(sky[TODSKY_CLOUD_COVER] * 100.0)}%  ZEN ${i32(sky[TODSKY_ZENITH_R] * 255.0)} ${i32(sky[TODSKY_ZENITH_R + 1] * 255.0)} ${i32(sky[TODSKY_ZENITH_R + 2] * 255.0)}`,
                 g_UI_DIM);
        img_text(10, ry2 + 92,
                 `HOR ${i32(sky[TODSKY_HORIZON_R] * 255.0)} ${i32(sky[TODSKY_HORIZON_R + 1] * 255.0)} ${i32(sky[TODSKY_HORIZON_R + 2] * 255.0)}`,
                 g_UI_DIM);
    }

    // --- the §2.1 ruling --------------------------------------------------
    let y2: i32 = top_h + mid_h + bot_h + 18;
    img_text(8, y2 - 8, "ART BIBLE 2.1 MINIMUM ALBEDO LUMINANCE 72 - THE RULING", g_UI_WHITE);
    img_text(8, y2 - 1, "PALETTE ENTRY IS NOT THE ALBEDO - THE TEXEL IS. TILES AT 1:1 AND 4X, LIT BY THE SHADOW SIDE AT THE DARKEST KEYFRAME.", g_UI_DIM);

    let world = atlas_new(256, 256, 8, 8);
    let ncell: i32 = texgen_build_world_atlas(world, seed);

    // The darkest light the game can produce: the DEEP keyframe (last row of
    // the ART_BIBLE §5.1 table) with the normal turned away from the key.
    tod_reset();
    tod_eval(env, tod_key_anchor(TOD_KEY_COUNT - 1), WX_CLEAR);
    env_bind(env);
    let sl: array<f64> = [0.0, 0.0, 0.0];
    shadow_light(env, sl);
    // The ART_BIBLE's own worked example uses a 0.35 ambient — the DAY floor,
    // not tod.hml's 0.14 night floor. Both are shown so the rule's stated
    // arithmetic can be checked against the shipping arithmetic.
    let ab35: f64 = 0.35;

    let cases_c: array<i32> = [g_BARK_LO, g_RUST_DARK, g_WOOD_LO];
    let cases_n: array<string> = ["BARK LO", "RUST DARK", "WOOD LO"];
    let cases_t: array<i32> = [CELL_BARK, CELL_METAL_RUST, CELL_WOOD_PLANK];

    for (let ci = 0; ci < 3; ci++) {
        let ry3: i32 = y2 + 10 + ci * 190;
        let c: i32 = cases_c[ci];
        let cell: i32 = cases_t[ci];
        img_text(10, ry3, `${cases_n[ci]}  PAL LUM ${pal_lum(c)}  (FLOOR 72)  TILE ${texgen_cell_name(cell)}`, g_UI_AMBER);

        // Three lightings, left to right: full sun (the authored albedo),
        // the shadow side at the DEEP keyframe, and the ART_BIBLE's own 0.35.
        img_text(10, ry3 + 9, "ENTRY", g_UI_DIM);
        img_text(50, ry3 + 9, "1:1", g_UI_DIM);
        img_text(96, ry3 + 9, "FULL SUN", g_UI_DIM);
        img_text(232, ry3 + 9, "SHADOW SIDE - DEEP", g_UI_DIM);
        img_text(368, ry3 + 9, "0.35 AMBIENT - THE 2.1 EXAMPLE", g_UI_DIM);

        // column 1: the palette entry alone, at the three lightings
        swatch_lit(10, ry3 + 17, 32, 32, c, 1.0, 1.0, 1.0);
        swatch_lit(10, ry3 + 51, 32, 32, c, sl[0], sl[1], sl[2]);
        swatch_lit(10, ry3 + 85, 32, 32, c, ab35, ab35, ab35);

        // column 2: the tile texgen actually builds from it, at 1:1 — the
        // size a 4 m ground quad occupies at 320x240.
        let t_raw: i32 = tile_blit(world, cell, 50, ry3 + 17, 1, 1.0, 1.0, 1.0);
        let t_shd: i32 = tile_blit(world, cell, 50, ry3 + 51, 1, sl[0], sl[1], sl[2]);
        let t_35: i32 = tile_blit(world, cell, 50, ry3 + 85, 1, ab35, ab35, ab35);

        // column 3: the same three at 4x, so the structure is inspectable
        tile_blit(world, cell, 96, ry3 + 17, 4, 1.0, 1.0, 1.0);
        tile_blit(world, cell, 232, ry3 + 17, 4, sl[0], sl[1], sl[2]);
        tile_blit(world, cell, 368, ry3 + 17, 4, ab35, ab35, ab35);

        img_text(10, ry3 + 150,
                 `PALETTE ENTRY LUM ${pal_lum(c)} - AT 0.35 AMBIENT ${i32(f64(pal_lum(c)) * ab35)} (THE 72 FLOOR GIVES 25)`,
                 g_UI_DIM);
        img_text(10, ry3 + 158,
                 `TILE MIN LUM  FULL SUN ${t_raw}   SHADOW SIDE ${t_shd}   0.35 AMBIENT ${t_35}   - THE TEXEL, NOT THE ENTRY, IS THE ALBEDO`,
                 g_UI_DIM);
    }

    write_png(out, g_img, g_iw, g_ih);
    if (exists(out) == false) {
        eprint(`palette_preview: failed to write ${out}`);
        exit(4);
    }

    // ---- the sidecar. A picture without its numbers is not evidence. ------
    print(`wrote ${out}  (${g_iw}x${g_ih})`);
    print("");
    print("palette_preview stats");
    print(`  palette entries       ${n}`);
    print(`  world albedos sub-72  ${below72}  (ART_BIBLE §2.1; see the ruling panel)`);
    print(`  keyframes             ${TOD_KEY_COUNT}`);
    print(`  weathers              5`);
    print(`  texgen cells          ${ncell} at seed ${seed}`);
    print(`  shadow-side light     ${sl[0]} ${sl[1]} ${sl[2]}  (DEEP keyframe, N = -SUN_DIR)`);
    if (g_fail != 0) {
        eprint("palette_preview: AMBIENT + SUN EXCEEDS 1 AT SOME KEYFRAME.");
        eprint("  Textures are authored at full-sun-noon albedo and vertex colour");
        eprint("  can only darken, so this keyframe is unreachable. Fix the table.");
        exit(1);
    }
    exit(0);
}

main();
