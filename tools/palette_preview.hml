// ===========================================================================
// THE SHEET
// ===========================================================================

let g_img: buffer = buffer(1);
let g_iw: i32 = 1;
let g_ih: i32 = 1;

fn img_new(p_w: i32, p_h: i32) {
    g_iw = p_w; g_ih = p_h;
    g_img = buffer(p_w * p_h * 3);
}
fn img_px(p_x: i32, p_y: i32, p_r: i32, p_g: i32, p_b: i32) {
    if (p_x < 0 || p_y < 0 || p_x >= g_iw || p_y >= g_ih) { return; }
    let o: i32 = (p_y * g_iw + p_x) * 3;
    let p: ptr = buffer_ptr(g_img);
    ptr_write_u8(ptr_offset(p, o, 1), p_r & 255);
    ptr_write_u8(ptr_offset(p, o + 1, 1), p_g & 255);
    ptr_write_u8(ptr_offset(p, o + 2, 1), p_b & 255);
}
fn img_rect(p_x: i32, p_y: i32, p_w: i32, p_h: i32, p_c: i32) {
    for (let y = 0; y < p_h; y++) {
        for (let x = 0; x < p_w; x++) {
            img_px(p_x + x, p_y + y, pal_r(p_c), pal_g(p_c), pal_b(p_c));
        }
    }
}

// 3x5 label font, same bitfields as FONT_MICRO, blitted straight into the RGB
// buffer with the mandatory 1-px UI_BLACK shadow.
let g_lbl: array<i32> = [];
fn lbl_add(p_cp: i32, p_a: i32, p_b: i32, p_c: i32, p_d: i32, p_e: i32) {
    g_lbl.push(p_cp);
    g_lbl.push(p_a); g_lbl.push(p_b); g_lbl.push(p_c); g_lbl.push(p_d); g_lbl.push(p_e);
}
fn lbl_build() {
    lbl_add(32, 0,0,0,0,0);
    lbl_add(48, 7,5,5,5,7); lbl_add(49, 2,6,2,2,7); lbl_add(50, 7,1,7,4,7);
    lbl_add(51, 7,1,7,1,7); lbl_add(52, 5,5,7,1,1); lbl_add(53, 7,4,7,1,7);
    lbl_add(54, 7,4,7,5,7); lbl_add(55, 7,1,1,1,1); lbl_add(56, 7,5,7,5,7);
    lbl_add(57, 7,5,7,1,7);
    lbl_add(65, 7,5,7,5,5); lbl_add(66, 6,5,6,5,6); lbl_add(67, 7,4,4,4,7);
    lbl_add(68, 6,5,5,5,6); lbl_add(69, 7,4,7,4,7); lbl_add(70, 7,4,7,4,4);
    lbl_add(71, 7,4,5,5,7); lbl_add(72, 5,5,7,5,5); lbl_add(73, 7,2,2,2,7);
    lbl_add(74, 1,1,1,5,7); lbl_add(75, 5,5,6,5,5); lbl_add(76, 4,4,4,4,7);
    lbl_add(77, 5,7,7,5,5); lbl_add(78, 5,7,7,7,5); lbl_add(79, 7,5,5,5,7);
    lbl_add(80, 7,5,7,4,4); lbl_add(81, 7,5,5,7,3); lbl_add(82, 7,5,7,6,5);
    lbl_add(83, 7,4,7,1,7); lbl_add(84, 7,2,2,2,2); lbl_add(85, 5,5,5,5,7);
    lbl_add(86, 5,5,5,5,2); lbl_add(87, 5,5,7,7,5); lbl_add(88, 5,5,2,5,5);
    lbl_add(89, 5,5,2,2,2); lbl_add(90, 7,1,2,4,7);
    lbl_add(46, 0,0,0,0,2); lbl_add(58, 0,2,0,2,0); lbl_add(47, 1,1,2,4,4);
    lbl_add(45, 0,0,7,0,0); lbl_add(95, 0,0,0,0,7); lbl_add(37, 5,1,2,4,5);
    lbl_add(40, 1,2,2,2,1); lbl_add(41, 4,2,2,2,4); lbl_add(44, 0,0,0,2,4);
    lbl_add(43, 0,2,7,2,0); lbl_add(62, 4,2,1,2,4); lbl_add(33, 2,2,2,0,2);
}
lbl_build();

fn img_text(p_x: i32, p_y: i32, p_s: string, p_c: i32) {
    let n: i32 = g_lbl.length;
    let cx: i32 = p_x;
    for (let i = 0; i < p_s.length; i++) {
        let cp: i32 = i32(p_s.byte_at(i));
        if (cp >= 97 && cp <= 122) { cp = cp - 32; }
        let gi: i32 = -1;
        for (let k = 0; k < n; k = k + 6) {
            if (g_lbl[k] == cp) { gi = k; }
        }
        if (gi >= 0) {
            for (let r = 0; r < 5; r++) {
                let bits: i32 = g_lbl[gi + 1 + r];
                for (let c = 0; c < 3; c++) {
                    if (((bits >> (2 - c)) & 1) == 1) { img_px(cx + c + 1, p_y + r + 1, 10, 12, 16); }
                }
            }
            for (let r2 = 0; r2 < 5; r2++) {
                let bits2: i32 = g_lbl[gi + 1 + r2];
                for (let c2 = 0; c2 < 3; c2++) {
                    if (((bits2 >> (2 - c2)) & 1) == 1) {
                        img_px(cx + c2, p_y + r2, pal_r(p_c), pal_g(p_c), pal_b(p_c));
                    }
                }
            }
        }
        cx = cx + 4;
    }
}

// --- the swatch table ------------------------------------------------------
let g_sw_name: array = [];
let g_sw_col: array<i32> = [];
fn sw(p_name: string, p_c: i32) { g_sw_name.push(p_name); g_sw_col.push(p_c); }

fn swatches_build() {
    sw("SKY ZEN", pal(44,95,184));   sw("SKY MID", pal(78,143,214));
    sw("SKY HOR", pal(168,210,232)); sw("CLOUD LIT", pal(242,240,228));
    sw("CLOUD SHD", pal(150,163,184)); sw("SUN DISC", pal(255,244,200));
    sw("SUN HALO", pal(255,217,138)); sw("MOON", pal(220,228,240));
    sw("GRASS HI", g_GRASS_HI);   sw("GRASS MID", g_GRASS_MID);
    sw("GRASS LO", g_GRASS_LO);   sw("GRASS DRY", g_GRASS_DRY);
    sw("DIRT HI", g_DIRT_HI);     sw("DIRT MID", g_DIRT_MID);
    sw("DIRT LO", g_DIRT_LO);     sw("SAND", pal(216,198,142));
    sw("SNOW HI", g_SNOW_HI);     sw("SNOW LO", g_SNOW_LO);
    sw("LEAF HI", pal(140,196,78)); sw("LEAF MID", g_LEAF_MID);
    sw("LEAF LO", pal(53,107,46)); sw("PINE HI", g_PINE_HI);
    sw("PINE LO", g_PINE_LO);     sw("AUTUMN", pal(206,126,48));
    sw("BARK HI", g_BARK_HI);     sw("BARK LO", g_BARK_LO);
    sw("STONE HI", g_STONE_HI);   sw("STONE MID", g_STONE_MID);
    sw("STONE LO", g_STONE_LO);   sw("GRANIT HI", g_GRANITE_HI);
    sw("GRANIT LO", g_GRANITE_LO); sw("MOSS", pal(102,116,74));
    sw("CONCR HI", g_CONCRETE_HI); sw("CONCR MID", g_CONCRETE_MID);
    sw("CONCR LO", g_CONCRETE_LO); sw("RUST", g_RUST);
    sw("WOOD HI", g_WOOD_HI);     sw("WOOD MID", g_WOOD_MID);
    sw("WOOD LO", g_WOOD_LO);     sw("ROOF TILE", g_ROOF_TILE);
    sw("PAINT TL", g_PAINT_TEAL); sw("PAINT OCH", g_PAINT_OCHRE);
    sw("FABRIC RD", pal(154,58,52)); sw("FABRIC CR", g_FABRIC_CREAM);
    sw("STEEL HI", pal(196,200,208)); sw("STEEL MID", g_STEEL_MID);
    sw("STEEL LO", g_STEEL_LO);   sw("GUNMTL HI", g_GUNMETAL_HI);
    sw("GUNMTL LO", g_GUNMETAL_LO); sw("BRASS", g_BRASS);
    sw("POLYMER", g_POLYMER);     sw("NS CORE", g_NS_CORE);
    sw("NS MID", g_NS_MID);       sw("NS DEEP", pal(61,18,89));
    sw("NS HALO", g_NS_HALO);     sw("NS FLORA", g_NS_FLORA);
    sw("VENOM", pal(107,224,122)); sw("VENOM HALO", pal(180,255,192));
    sw("MUZZLE CR", g_MUZZLE_CORE); sw("MUZZLE MD", g_MUZZLE_MID);
    sw("MUZZLE ED", pal(255,112,32)); sw("TRACER", pal(255,220,110));
    sw("EMBER", g_EMBER);         sw("LIGHTNING", g_LIGHTNING);
    sw("UI WHITE", g_UI_WHITE);   sw("UI DIM", g_UI_DIM);
    sw("UI BLACK", g_UI_BLACK);   sw("UI AMBER", g_UI_AMBER);
    sw("UI DANGER", g_UI_DANGER); sw("UI GOOD", g_UI_GOOD);
    sw("BLOOD", pal(180,30,30));  sw("ICHOR", pal(138,58,220));
}
swatches_build();

fn luminance(p_c: i32): i32 {
    let l: f64 = 0.2126 * f64(pal_r(p_c)) + 0.7152 * f64(pal_g(p_c)) + 0.0722 * f64(pal_b(p_c));
    let out: i32 = i32(l);
    return out;
}

// One sphere of `albedo`, lit by whatever env is currently bound. This is the
// SHIPPING kernel: env_light_rgb is the same function mesh_bake_light calls.
fn sphere(p_x: i32, p_y: i32, p_r: i32, p_albedo: i32) {
    let r: i32 = p_r;
    let ar: f64 = f64(pal_r(p_albedo));
    let ag: f64 = f64(pal_g(p_albedo));
    let ab: f64 = f64(pal_b(p_albedo));
    for (let j = 0 - r; j <= r; j++) {
        for (let i = 0 - r; i <= r; i++) {
            let nx: f64 = f64(i) / f64(r);
            let ny: f64 = 0.0 - f64(j) / f64(r);
            let d2: f64 = nx * nx + ny * ny;
            if (d2 <= 1.0) {
                let nz: f64 = sqrt(1.0 - d2);
                let c: u32 = env_light_rgb(nx, ny, nz, 0.0, 1.0, 0.0);
                let lr: f64 = f64(c & 255) / 255.0;
                let lg: f64 = f64((c >> 8) & 255) / 255.0;
                let lb: f64 = f64((c >> 16) & 255) / 255.0;
                img_px(p_x + i, p_y + j,
                       clampi(i32(ar * lr), 0, 255),
                       clampi(i32(ag * lg), 0, 255),
                       clampi(i32(ab * lb), 0, 255));
            }
        }
    }
}

// The fog ramp: the same albedo marched from 0 to FOG_FAR through the shipping
// fog curve, so "does the fog colour match the horizon" is a look, not a guess.
fn fog_ramp(p_x: i32, p_y: i32, p_w: i32, p_h: i32, p_albedo: i32, p_far: f64) {
    let ftr: f64 = g_ev[TOD_FTR]; let ftg: f64 = g_ev[TOD_FTG]; let ftb: f64 = g_ev[TOD_FTB];
    for (let x = 0; x < p_w; x++) {
        let d: f64 = p_far * f64(x) / f64(p_w);
        let f: f64 = env_fog_factor(0.0, 1.5, d);
        let r: i32 = clampi(i32(f64(pal_r(p_albedo)) * (1.0 - f * (1.0 - ftr))), 0, 255);
        let g: i32 = clampi(i32(f64(pal_g(p_albedo)) * (1.0 - f * (1.0 - ftg))), 0, 255);
        let b: i32 = clampi(i32(f64(pal_b(p_albedo)) * (1.0 - f * (1.0 - ftb))), 0, 255);
        for (let y = 0; y < p_h; y++) { img_px(p_x + x, p_y + y, r, g, b); }
    }
}

fn sky_strip(p_x: i32, p_y: i32, p_w: i32, p_h: i32) {
    for (let y = 0; y < p_h; y++) {
        let t: f64 = f64(y) / f64(p_h);
        let r: f64 = 0.0; let g: f64 = 0.0; let b: f64 = 0.0;
        if (t < 0.55) {
            let k: f64 = t / 0.55;
            r = lerpf(g_ev[TOD_ZENR], g_ev[TOD_MIDR], k);
            g = lerpf(g_ev[TOD_ZENG], g_ev[TOD_MIDG], k);
            b = lerpf(g_ev[TOD_ZENB], g_ev[TOD_MIDB], k);
        } else {
            let k2: f64 = (t - 0.55) / 0.45;
            r = lerpf(g_ev[TOD_MIDR], g_ev[TOD_HORR], k2);
            g = lerpf(g_ev[TOD_MIDG], g_ev[TOD_HORG], k2);
            b = lerpf(g_ev[TOD_MIDB], g_ev[TOD_HORB], k2);
        }
        for (let x = 0; x < p_w; x++) {
            let d: f64 = f64(g_bayer4[(y % 4) * 4 + (x % 4)]) * 0.0625 - 0.47;
            img_px(p_x + x, p_y + y,
                   clampi(i32(r + d * 5.0), 0, 255),
                   clampi(i32(g + d * 5.0), 0, 255),
                   clampi(i32(b + d * 5.0), 0, 255));
        }
    }
}

let g_bayer4: array<i32> = [ 0, 8, 2,10, 12, 4,14, 6, 3,11, 1, 9, 15, 7,13, 5];

let g_fail: i32 = 0;

fn running_interpreted(): bool {
    if (args.length < 1) { return false; }
    let a0: string = args[0];
    let out: bool = a0.ends_with(".hml");
    return out;
}

fn main() {
    if (running_interpreted()) {
        eprint("palette_preview.hml is COMPILED-ONLY (ARCHITECTURE.md §7).");
        eprint("    hemlockc -O1 tools/palette_preview.hml -o /tmp/palprev");
        exit(2);
    }
    let out: string = "palette_preview.png";
    let i: i32 = 1;
    while (i < args.length) {
        let a: string = args[i];
        if (a == "--out" && i + 1 < args.length) { i++; out = args[i]; }
        else if (a == "--help") {
            print("palette_preview.hml — the palette contact sheet");
            print("  --out <path>   PNG path (default palette_preview.png)");
            exit(0);
        }
        else { eprint(`palette_preview: unknown argument '${a}'`); exit(2); }
        i++;
    }

    let cols: i32 = 8;
    let sw_w: i32 = 78;
    let sw_h: i32 = 40;
    let n: i32 = g_sw_col.length;
    let rows: i32 = divi(n + cols - 1, cols);
    let top_h: i32 = 22 + rows * sw_h;

    // eight keyframes x (sphere + sky strip + fog ramp) + five weathers
    let keys: array<f64> = [2.0, 5.5, 8.0, 12.0, 18.25, 19.5, 22.0, 26.0];
    let knames: array = ["DEEP 02", "DAWN 05.5", "MORN 08", "NOON 12",
                         "GOLDEN 18.25", "DUSK 19.5", "NIGHT 22", "DEEP 26"];
    let wxs: array<i32> = [WX_CLEAR, WX_OVERCAST, WX_RAIN, WX_STORM, WX_BLOOM];
    let row_h: i32 = 104;
    let mid_h: i32 = 16 + 8 * row_h;
    let bot_h: i32 = 16 + 5 * row_h;

    img_new(cols * sw_w + 16, top_h + mid_h + bot_h + 24);
    img_rect(0, 0, g_iw, g_ih, pal(20, 22, 26));
    img_text(8, 6, "NIGHTSHADE PALETTE CONTACT SHEET", g_UI_WHITE);
    img_text(8, 13, "ART BIBLE 3 AND 5 - EVALUATED THROUGH SHADE.HML", g_UI_DIM);

    // --- swatches ---------------------------------------------------------
    for (let s = 0; s < n; s++) {
        let cx: i32 = 8 + (s % cols) * sw_w;
        let cy: i32 = 22 + divi(s, cols) * sw_h;
        img_rect(cx, cy, sw_w - 2, sw_h - 2, g_sw_col[s]);
        let lum: i32 = luminance(g_sw_col[s]);
        let ink: i32 = g_UI_WHITE;
        if (lum > 128) { ink = g_UI_BLACK; }
        img_text(cx + 3, cy + 3, g_sw_name[s], ink);
        img_text(cx + 3, cy + 11, `${pal_r(g_sw_col[s])} ${pal_g(g_sw_col[s])} ${pal_b(g_sw_col[s])}`, ink);
        img_text(cx + 3, cy + 19, `L ${lum}`, ink);
        // Minimum albedo luminance 72 in the world atlas: vertex colour can
        // only darken, so anything below it can never be made bright again.
        if (lum < 72) { img_text(cx + 3, cy + 27, "LUM LT 72", g_UI_DANGER); }
    }

    // --- one keyframe per row: sphere, sky, fog ramp, sum check ------------
    let env: array<f64> = env_new();
    let y0: i32 = top_h + 8;
    img_text(8, y0 - 6, "TIME OF DAY - GRASS MID SPHERE, SKY BAND, FOG RAMP TO FOG FAR", g_UI_WHITE);
    for (let k = 0; k < 8; k++) {
        let ry: i32 = y0 + 6 + k * row_h;
        tod_eval(env, keys[k], WX_CLEAR, 0, -1.0, -1.0, 0.0, 1.5, 0.0, 0.0);
        env_bind(env);
        img_text(10, ry + 2, knames[k], g_UI_WHITE);
        sphere(60, ry + 46, 40, g_GRASS_MID);
        sphere(150, ry + 46, 40, g_CONCRETE_MID);
        sphere(240, ry + 46, 40, g_NS_FLORA);
        sky_strip(300, ry + 6, 60, 88);
        fog_ramp(370, ry + 6, 230, 40, g_GRASS_MID, g_ev[TOD_FFAR]);
        fog_ramp(370, ry + 50, 230, 40, g_STONE_MID, g_ev[TOD_FFAR]);
        img_text(370, ry + 92, `FOG NEAR ${i32(g_ev[TOD_FNEAR])} FAR ${i32(g_ev[TOD_FFAR])} MIST ${i32(g_ev[TOD_MIST] * 100.0)}%`, g_UI_DIM);
        // ambient + sun must sum to <= 1 per channel, or a texture authored at
        // full-sun-noon albedo can be BRIGHTENED, which the renderer cannot do.
        let sr: f64 = env_field(env, ENV_SUN_R) + env_field(env, ENV_AMB_R);
        let sg: f64 = env_field(env, ENV_SUN_G) + env_field(env, ENV_AMB_G);
        let sb: f64 = env_field(env, ENV_SUN_B) + env_field(env, ENV_AMB_B);
        let okc: i32 = g_UI_GOOD;
        let msg: string = "AMB PLUS SUN LE 1 - OK";
        if (sr > 1.001 || sg > 1.001 || sb > 1.001) {
            okc = g_UI_DANGER;
            msg = "AMB PLUS SUN GT 1 - CANNOT DARKEN ONLY";
            g_fail = 1;
        }
        img_text(10, ry + 92, msg, okc);
        img_text(10, ry + 10, `SUM ${i32(sr * 100.0)} ${i32(sg * 100.0)} ${i32(sb * 100.0)}`, g_UI_DIM);
    }

    // --- weather rows -----------------------------------------------------
    let y1: i32 = top_h + mid_h + 12;
    img_text(8, y1 - 6, "WEATHER OVERRIDES AT NOON", g_UI_WHITE);
    let wnames: array = ["CLEAR", "OVERCAST", "RAIN", "STORM", "NS BLOOM"];
    for (let w = 0; w < 5; w++) {
        let ry2: i32 = y1 + 6 + w * row_h;
        tod_eval(env, 12.0, wxs[w], 0, -1.0, -1.0, 0.0, 1.5, 0.0, 0.0);
        env_bind(env);
        img_text(10, ry2 + 2, wnames[w], g_UI_WHITE);
        sphere(60, ry2 + 46, 40, g_GRASS_MID);
        sphere(150, ry2 + 46, 40, g_CONCRETE_MID);
        sphere(240, ry2 + 46, 40, g_NS_FLORA);
        sky_strip(300, ry2 + 6, 60, 88);
        fog_ramp(370, ry2 + 6, 230, 40, g_GRASS_MID, g_ev[TOD_FFAR]);
        fog_ramp(370, ry2 + 50, 230, 40, g_STONE_MID, g_ev[TOD_FFAR]);
        img_text(370, ry2 + 92, `FOG NEAR ${i32(g_ev[TOD_FNEAR])} FAR ${i32(g_ev[TOD_FFAR])}`, g_UI_DIM);
    }

    write_png(out, g_img, g_iw, g_ih);
    if (exists(out) == false) {
        eprint(`palette_preview: failed to write ${out}`);
        exit(4);
    }
    print(`wrote ${out}  (${g_iw}x${g_ih}, ${n} swatches, 8 ToD keyframes, 5 weathers)`);
    if (g_fail != 0) {
        eprint("palette_preview: AMBIENT + SUN EXCEEDS 1 AT SOME KEYFRAME.");
        eprint("  Textures are authored at full-sun-noon albedo and vertex colour");
        eprint("  can only darken, so this keyframe is unreachable. Fix the table.");
        exit(1);
    }
    exit(0);
}

main();
