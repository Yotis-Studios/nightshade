    g_DIR_ALIVE_CAP, g_BUDGET_SIM_MS, g_WORLD_SEED_DEFAULT
} from "../src/core/config.hml";

// ---------------------------------------------------------------------------
// EXPECTED ASSERTION COUNT — bump deliberately, never to make red go green
// ---------------------------------------------------------------------------
let g_expect_asserts = 105;

let g_asserts = 0;
let g_pass = 0;
let g_fail = 0;

fn ck(p_cond: bool, p_name: string, p_detail: string) {
    g_asserts = g_asserts + 1;
    if (p_cond) {
        g_pass = g_pass + 1;
    } else {
        g_fail = g_fail + 1;
        print(`  FAIL  ${p_name}  --  ${p_detail}`);
    }
}

fn near(p_a: f64, p_b: f64, p_tol: f64): bool {
    let d: f64 = p_a - p_b;
    if (d < 0.0) { d = 0.0 - d; }
    let out: bool = d <= p_tol;
    return out;
}

// ===========================================================================
// TERRAIN SOURCES — three worlds, injected into chunk.hml (its header contract)
// ===========================================================================
let g_FLAT_CM = 1000;      // 10.00 m, flat
let g_WALL_CM = 1600;      // 16.00 m ridge crest

// Every sample the same height: the control surface. Steering has nowhere to
// hide behind terrain, so a stacking or seeking failure is unambiguous.
fn flat_source(p_hbuf: buffer, p_hoff: i32, p_abuf: buffer, p_aoff: i32,
               p_cx: i32, p_cz: i32, p_seed: i32): i32 {
    let hp: ptr = buffer_ptr(p_hbuf);
    let ap: ptr = buffer_ptr(p_abuf);
    let n: i32 = CHUNK_SAMPLES;
    let i: i32 = 0;
    while (i < n) {
        ptr_write_u16(ptr_offset(hp, p_hoff + i * 2, 1), g_FLAT_CM);
        ptr_write_u8(ptr_offset(ap, p_aoff + i, 1), 0);
        ptr_write_u8(ptr_offset(ap, p_aoff + CHUNK_SAMPLES + i, 1), 255);
        i++;
    }
    let meta: i32 = 0;
    return meta;
}

// Flat, plus one 6 m ridge along x = 0 that stops at |z| = 20 — so there IS a
// way around it, which is the only way to tell avoidance from being blocked.
fn wall_source(p_hbuf: buffer, p_hoff: i32, p_abuf: buffer, p_aoff: i32,
               p_cx: i32, p_cz: i32, p_seed: i32): i32 {
    let hp: ptr = buffer_ptr(p_hbuf);
    let ap: ptr = buffer_ptr(p_abuf);
    let n: i32 = CHUNK_N;
    let iz: i32 = 0;
    while (iz < n) {
        let ix: i32 = 0;
        while (ix < n) {
            let si: i32 = iz * n + ix;
            let wx: f64 = f64(p_cx) * CHUNK_M + f64(ix) * CHUNK_CELL_M;
            let wz: f64 = f64(p_cz) * CHUNK_M + f64(iz) * CHUNK_CELL_M;
            let h: i32 = g_FLAT_CM;
            let axm: f64 = wx;
            if (axm < 0.0) { axm = 0.0 - axm; }
            let azm: f64 = wz;
            if (azm < 0.0) { azm = 0.0 - azm; }
            if (axm < 2.0) {
                if (azm < 20.0) { h = g_WALL_CM; }
            }
            ptr_write_u16(ptr_offset(hp, p_hoff + si * 2, 1), h);
            ptr_write_u8(ptr_offset(ap, p_aoff + si, 1), 0);
            ptr_write_u8(ptr_offset(ap, p_aoff + CHUNK_SAMPLES + si, 1), 255);
            ix++;
        }
        iz++;
    }
    let meta: i32 = 0;
    return meta;
}

// The real thing: the shipping generator, through its documented adapter form.
fn wg_source(p_hbuf: buffer, p_hoff: i32, p_abuf: buffer, p_aoff: i32,
             p_cx: i32, p_cz: i32, p_seed: i32): i32 {
    let m: i32 = worldgen_chunk_at(p_seed, p_cx, p_cz, p_hbuf, p_hoff, p_abuf, p_aoff);
    return m;
}

fn store_flat(): object {
    let cs: object = chunk_store_new_cap(64, 16, 1);
    chunk_set_source(cs, flat_source);
    let out: object = cs;
    return out;
}

fn store_wall(): object {
    let cs: object = chunk_store_new_cap(64, 16, 1);
    chunk_set_source(cs, wall_source);
    let out: object = cs;
    return out;
}

fn store_wg(p_seed: i32): object {
    let cs: object = chunk_store_new_cap(64, 16, p_seed);
    chunk_set_source(cs, wg_source);
    let out: object = cs;
    return out;
}

// A store with NO source: every height sample misses. Used to prove that an
// unloaded chunk is treated as "no information" and never as an obstacle or a
// teleport to y = 0.
fn store_none(): object {
    let cs: object = chunk_store_new_cap(4, 4, 1);
    let out: object = cs;
    return out;
}

// ===========================================================================
// WORLD / SCENARIO HELPERS
// ===========================================================================
fn mk_world(p_seed: i32): object {
    let w: object = world_new_cap(128);
    world_set_seed(w, p_seed);
    world_set_tick(w, 0);
    let out: object = w;
    return out;
}

// Player 1 at (x, y, z), 100 HP, team 0. Returns its slot.
fn put_player(p_w: object, p_x: f64, p_y: f64, p_z: f64): i32 {
    let w: object = p_w;
    let s: i32 = world_spawn_player(w, 1);
    let px = w.px; let py = w.py; let pz = w.pz;
    let hp = w.hp; let hpm = w.hp_max; let fl = w.flags; let tm = w.team;
    px[s] = p_x; py[s] = p_y; pz[s] = p_z;
    hp[s] = 100; hpm[s] = 100; fl[s] = EF_VISIBLE; tm[s] = 0;
    let out: i32 = s;
    return out;
}

fn dist_xz(p_w: object, p_a: i32, p_b: i32): f64 {
    let w: object = p_w;
    let px = w.px; let pz = w.pz;
    let dx: f64 = px[p_a] - px[p_b];
    let dz: f64 = pz[p_a] - pz[p_b];
    let out: f64 = __sqrt(dx * dx + dz * dz);
    return out;
}

// A fingerprint of every PLAYER field ai_step could conceivably touch. Used to
// prove it touches none of them.
fn player_hash(p_w: object): u64 {
    let w: object = p_w;
    let h: u64 = 1469598103934665603;
    let kind = w.kind;
    let px = w.px; let py = w.py; let pz = w.pz;
    let vx = w.vx; let vy = w.vy; let vz = w.vz;
    let yaw = w.yaw; let pitch = w.pitch;
    let hp = w.hp; let armor = w.armor; let flags = w.flags;
    let anim = w.anim; let animt = w.anim_t;
    let ais = w.ai_state; let ait = w.ai_target_id; let aim = w.ai_timer;
    let n: i32 = w.count;
    let s: i32 = 0;
    while (s < n) {
        if (kind[s] == KIND_PLAYER) {
            h = hmix(h, qbits(px[s]));  h = hmix(h, qbits(py[s]));  h = hmix(h, qbits(pz[s]));
            h = hmix(h, qbits(vx[s]));  h = hmix(h, qbits(vy[s]));  h = hmix(h, qbits(vz[s]));
            h = hmix(h, qbits(yaw[s])); h = hmix(h, qbits(pitch[s]));
            h = hmix(h, hp[s]); h = hmix(h, armor[s]); h = hmix(h, flags[s]);
            h = hmix(h, anim[s]); h = hmix(h, qbits(animt[s]));
            h = hmix(h, ais[s]); h = hmix(h, ait[s]); h = hmix(h, qbits(aim[s]));
        }
        s++;
    }
    let out: u64 = h;
    return out;
}

// micro-quantized: 1e-6 resolution, so this catches a change no renderer could
// ever hide, without depending on the last bit of an f64.
fn qbits(p_v: f64): i32 {
    let v: f64 = p_v * 1000000.0;
    if (v > 2000000000.0) { v = 2000000000.0; }
    if (v < 0.0 - 2000000000.0) { v = 0.0 - 2000000000.0; }
    if (v >= 0.0) { let a: i32 = i32(v + 0.5); return a; }
    let b: i32 = 0 - i32(0.5 - v);
    return b;
}

fn hmix(p_h: u64, p_k: i32): u64 {
    let h: u64 = p_h;
    let k: i64 = i64(p_k) & 4294967295;
    h = (h ^ u64(k)) * 1099511628211;
    h = h ^ (h >> 29);
    let out: u64 = h;
    return out;
}

// ===========================================================================
// A. THE CLASS TABLE  (GDD §2.2)
// ===========================================================================
fn section_table() {
    print("A. Class table (GAME_DESIGN §2.2)");

    ck(AI_CLASS_COUNT == g_ENEMY_KIND_COUNT,
       "A1 ai.hml's class count equals config's g_ENEMY_KIND_COUNT",
       `${AI_CLASS_COUNT} vs ${g_ENEMY_KIND_COUNT}`);

    // ---- the GDD digits. These ARE the design. --------------------------
    ck(ai_hp_of(AI_WISP) == 15 && ai_hp_of(AI_MOTE) == 30 && ai_hp_of(AI_HUSK) == 90
       && ai_hp_of(AI_SPITTER) == 70 && ai_hp_of(AI_WARDEN) == 220
       && ai_hp_of(AI_BULWARK) == 900,
       "A2 HP column is 15/30/90/70/220/900",
       `${ai_hp_of(0)} ${ai_hp_of(1)} ${ai_hp_of(2)} ${ai_hp_of(3)} ${ai_hp_of(4)} ${ai_hp_of(5)}`);

    ck(ai_damage_of(AI_WISP) == 6 && ai_damage_of(AI_MOTE) == 12
       && ai_damage_of(AI_HUSK) == 18 && ai_damage_of(AI_SPITTER) == 22
       && ai_damage_of(AI_WARDEN) == 30 && ai_damage_of(AI_BULWARK) == 40,
       "A3 damage column is 6/12/18/22/30/40",
       `${ai_damage_of(0)} ${ai_damage_of(1)} ${ai_damage_of(2)} ${ai_damage_of(3)} ${ai_damage_of(4)} ${ai_damage_of(5)}`);

    ck(near(ai_speed_of(AI_WISP), 6.4, 0.0001) && near(ai_speed_of(AI_MOTE), 2.2, 0.0001)
       && near(ai_speed_of(AI_HUSK), 3.0, 0.0001) && near(ai_speed_of(AI_SPITTER), 2.6, 0.0001)
       && near(ai_speed_of(AI_WARDEN), 3.4, 0.0001) && near(ai_speed_of(AI_BULWARK), 2.8, 0.0001),
       "A4 walk speeds are 6.4/2.2/3.0/2.6/3.4/2.8 m/s",
       `${ai_speed_of(0)} ${ai_speed_of(2)} ${ai_speed_of(4)}`);

    let pr: array = [];
    let z: i32 = 0;
    while (z < AIP_COUNT) { pr.push(0.0); z++; }
    ai_kind_params(AI_HUSK, pr);
    ck(near(pr[AIP_SPEED_HI], 5.2, 0.0001),
       "A5 the Husk charge speed is 5.2 m/s (GDD: '5.2 charge, 3.0 walk')", `${pr[AIP_SPEED_HI]}`);

    ck(near(ai_range_of(AI_HUSK), 1.8, 0.0001) && near(ai_range_of(AI_SPITTER), 30.0, 0.0001)
       && near(ai_range_of(AI_WARDEN), 2.2, 0.0001) && near(ai_range_of(AI_BULWARK), 5.0, 0.0001),
       "A6 attack ranges are 1.8 / 30 / 2.2 / 5.0 m", `${ai_range_of(2)} ${ai_range_of(3)}`);

    ck(near(ai_range_of(AI_WISP), AI_CONTACT_M, 0.0001)
       && near(ai_range_of(AI_MOTE), AI_CONTACT_M, 0.0001),
       "A7 'range 0' for Wisp and Mote means contact range", `${ai_range_of(0)}`);

    ck(near(ai_tell_s_of(AI_HUSK), 0.45, 0.0001), "A8 the Husk tell is 0.45 s", `${ai_tell_s_of(2)}`);
    ck(near(ai_tell_s_of(AI_SPITTER), 1.40, 0.0001), "A9 the Spitter tell is 1.4 s", `${ai_tell_s_of(3)}`);
    ck(near(ai_tell_s_of(AI_WISP), 0.50, 0.0001), "A10 the Wisp chime tell is 0.5 s", `${ai_tell_s_of(0)}`);
    ck(near(ai_tell_s_of(AI_BULWARK), 1.10, 0.0001), "A11 the Bulwark crouch tell is 1.1 s", `${ai_tell_s_of(5)}`);

    ck(ai_ember_of(0) == 1 && ai_ember_of(1) == 2 && ai_ember_of(2) == 4
       && ai_ember_of(3) == 5 && ai_ember_of(4) == 12 && ai_ember_of(5) == 60,
       "A12 ember column is 1/2/4/5/12/60", `${ai_ember_of(4)}`);
    ck(ai_xp_of(0) == 6 && ai_xp_of(1) == 12 && ai_xp_of(2) == 25
       && ai_xp_of(3) == 30 && ai_xp_of(4) == 90 && ai_xp_of(5) == 400,
       "A13 XP column is 6/12/25/30/90/400", `${ai_xp_of(5)}`);
    ck(ai_cost_of(0) == 2 && ai_cost_of(1) == 3 && ai_cost_of(2) == 6
       && ai_cost_of(3) == 8 && ai_cost_of(4) == 20 && ai_cost_of(5) == 90,
       "A14 spawn-cost column is 2/3/6/8/20/90", `${ai_cost_of(5)}`);

    ai_kind_params(AI_WARDEN, pr);
    ck(pr[AIP_ARMOR] == 80, "A15 the Warden front plate is 80 points of armor", `${pr[AIP_ARMOR]}`);

    // ---- the properties. These survive a retune. ------------------------
    let c: i32 = 0;
    let mono_cost: bool = true;
    let mono_xp: bool = true;
    let mono_em: bool = true;
    let all_tell: bool = true;
    let all_notice: bool = true;
    let all_slower: bool = true;
    let all_positive: bool = true;
    while (c < AI_CLASS_COUNT) {
        if (c > 0) {
            if (ai_cost_of(c) <= ai_cost_of(c - 1)) { mono_cost = false; }
            if (ai_xp_of(c) <= ai_xp_of(c - 1)) { mono_xp = false; }
            if (ai_ember_of(c) <= ai_ember_of(c - 1)) { mono_em = false; }
        }
        if (ai_tell_s_of(c) <= 0.0) { all_tell = false; }
        if (ai_tell_ticks_of(c) < 1) { all_tell = false; }
        ai_kind_params(c, pr);
        if (pr[AIP_AGGRO_M] < pr[AIP_RANGE_M]) { all_notice = false; }
        if (pr[AIP_SPEED] > g_SPEED_SPRINT) { all_slower = false; }
        if (pr[AIP_SPEED_HI] > g_SPEED_SPRINT) { all_slower = false; }
        if (pr[AIP_HP] <= 0.0) { all_positive = false; }
        if (pr[AIP_DAMAGE] <= 0.0) { all_positive = false; }
        if (pr[AIP_RADIUS] <= 0.0) { all_positive = false; }
        if (pr[AIP_HEIGHT] <= 0.0) { all_positive = false; }
        if (pr[AIP_TURN] <= 0.0) { all_positive = false; }
        if (pr[AIP_ACCEL] <= 0.0) { all_positive = false; }
        if (pr[AIP_RECOVER_S] <= 0.0) { all_positive = false; }
        c++;
    }
    ck(mono_cost, "A16 spawn cost rises strictly with the class index", "not monotone");
    ck(mono_xp, "A17 XP rises strictly with the class index", "not monotone");
    ck(mono_em, "A18 ember rises strictly with the class index", "not monotone");
    ck(all_tell, "A19 every class has a positive wind-up tell of at least one tick", "a class has none");
    ck(all_notice, "A20 every class notices you at least as far as it can hit you", "aggro < range");
    ck(all_slower, `A21 no enemy outruns a sprinting player (${g_SPEED_SPRINT} m/s)`, "a class is faster");
    ck(all_positive, "A22 hp/damage/radius/height/turn/accel/recover are all positive", "a column has a non-positive entry");

    // Only the Warden is armoured — the front plate is its whole identity.
    let armored: i32 = 0;
    c = 0;
    while (c < AI_CLASS_COUNT) {
        ai_kind_params(c, pr);
        if (pr[AIP_ARMOR] > 0.0) { armored = armored + 1; }
        c++;
    }
    ck(armored == 1, "A23 exactly one class carries armor (the Warden's plate)", `${armored}`);

    // The tell in ticks is the seconds, rounded, at the sim rate.
    let tick_ok: bool = true;
    c = 0;
    while (c < AI_CLASS_COUNT) {
        let want: i32 = i32(ai_tell_s_of(c) * f64(g_TICK_HZ) + 0.5);
        if (ai_tell_ticks_of(c) != want) { tick_ok = false; }
        c++;
    }
    ck(tick_ok, "A24 ai_tell_ticks_of == round(tell_s * TICK_HZ) for every class", "rounding disagrees");
    ck(ai_tell_ticks_of(AI_HUSK) == 27, "A25 the Husk tell is 27 ticks (0.45 s at 60 Hz)", `${ai_tell_ticks_of(2)}`);
    ck(ai_tell_ticks_of(AI_SPITTER) == 84, "A26 the Spitter tell is 84 ticks (1.4 s at 60 Hz)", `${ai_tell_ticks_of(3)}`);

    // Refusals are total: out of range and short arrays return 0, never throw.
    ck(ai_kind_params(-1, pr) == 0, "A27 ai_kind_params refuses a negative class", "accepted");
    ck(ai_kind_params(AI_CLASS_COUNT, pr) == 0, "A28 ai_kind_params refuses an out-of-range class", "accepted");
    let short: array = [0.0, 0.0];
    ck(ai_kind_params(AI_HUSK, short) == 0, "A29 ai_kind_params refuses a short output array", "accepted");
    ck(ai_hp_of(99) == 0 && ai_damage_of(-3) == 0 && ai_cost_of(77) == 0,
       "A30 the single-column accessors return 0 for a bad class rather than throwing", "threw or returned junk");

    ck(AI_HARD_SEP_M >= 0.9,
       "A31 the hard separation floor is at least the 0.9 m the acceptance requires", `${AI_HARD_SEP_M}`);
    ck(near(g_AI_WHISKER_DEG, 35.0, 0.0001) && near(g_AI_WHISKER_M, 4.0, 0.0001)
       && near(g_AI_SEPARATION_M, 1.2, 0.0001),
       "A32 the three steering numbers come from config: ±35°, 4 m, 1.2 m separation",
       `${g_AI_WHISKER_DEG} ${g_AI_WHISKER_M} ${g_AI_SEPARATION_M}`);
}

// ===========================================================================
// B. SPAWN
// ===========================================================================
fn section_spawn() {
    print("B. Spawn");

    let ai: object = ai_new();
    let w: object = mk_world(7);
    let pr: array = [];
    let z: i32 = 0;
    while (z < AIP_COUNT) { pr.push(0.0); z++; }

    let ok_hp: bool = true;
    let ok_model: bool = true;
    let ok_state: bool = true;
    let ok_team: bool = true;
    let ok_vis: bool = true;
    let ok_id: bool = true;
    let c: i32 = 0;
    while (c < AI_CLASS_COUNT) {
        let id: i32 = ai_spawn(ai, w, c, f64(c) * 10.0, 3.0, 0.0, 0.0);
        if (id == ID_NONE) { ok_id = false; }
        let s: i32 = world_slot_of(w, id);
        if (s < 0) { ok_id = false; }
        else {
            ai_kind_params(c, pr);
            let hp = w.hp; let hpm = w.hp_max; let armor = w.armor;
            let model = w.model; let team = w.team; let flags = w.flags;
            let ais = w.ai_state; let ait = w.ai_target_id; let aim = w.ai_timer;
            if (f64(hp[s]) != pr[AIP_HP]) { ok_hp = false; }
            if (hp[s] != hpm[s]) { ok_hp = false; }
            if (f64(armor[s]) != pr[AIP_ARMOR]) { ok_hp = false; }
            if (model[s] != c) { ok_model = false; }
            if (ai_class_of(w, s) != c) { ok_model = false; }
            if (ais[s] != AI_ST_IDLE) { ok_state = false; }
            if (ait[s] != ID_NONE) { ok_state = false; }
            if (aim[s] != 0.0) { ok_state = false; }
            if (team[s] != AI_TEAM_SHADE) { ok_team = false; }
            if ((flags[s] & EF_VISIBLE) == 0) { ok_vis = false; }
            if ((flags[s] & EF_DEAD) != 0) { ok_vis = false; }
        }
        c++;
    }
    ck(ok_id, "B1 every class spawns and its id resolves to a live slot", "a spawn failed");
    ck(ok_hp, "B2 hp == hp_max == the table, and armor is the table's", "mismatch");
    ck(ok_model, "B3 model IS the class index for KIND_AI (the renderer's contract)", "mismatch");
    ck(ok_state, "B4 a fresh agent is IDLE with no target and a zero timer", "mismatch");
    ck(ok_team, "B5 every agent is on the shade team, never the player's", "mismatch");
    ck(ok_vis, "B6 a fresh agent is VISIBLE and not DEAD", "mismatch");
    ck(ai_spawn_count(ai) == AI_CLASS_COUNT, "B7 the spawn counter counts every spawn", `${ai_spawn_count(ai)}`);
    ck(world_count(w) == AI_CLASS_COUNT, "B8 the world holds exactly the agents spawned", `${world_count(w)}`);
    ck(world_check(w) == 0, "B9 the world is internally consistent after the spawns", `${world_check(w)}`);

    ck(ai_spawn(ai, w, -1, 0.0, 0.0, 0.0, 0.0) == ID_NONE,
       "B10 spawning a negative class is refused, not clamped", "accepted");
    ck(ai_spawn(ai, w, AI_CLASS_COUNT, 0.0, 0.0, 0.0, 0.0) == ID_NONE,
       "B11 spawning an out-of-range class is refused", "accepted");
    ck(ai_spawn_fail_count(ai) == 2, "B12 both refusals are counted, never silent", `${ai_spawn_fail_count(ai)}`);

    // Despawn is world.hml's swap-with-last. The AI must survive it: nothing in
    // this module may cache a slot across ticks.
    let victim: i32 = 0;
    world_despawn(w, victim);
    ck(world_check(w) == 0, "B13 the world stays consistent after a despawn (slots move)", `${world_check(w)}`);
    let cs: object = store_flat();
    let n: i32 = ai_step(ai, w, cs);
    ck(n == AI_CLASS_COUNT - 1, "B14 ai_step steps exactly the surviving agents after a swap-with-last", `${n}`);
}

// ===========================================================================
// C. SEEK — the 30-second loop's most basic promise
// ===========================================================================
fn section_seek() {
    print("C. Seek and stop");

    let ai: object = ai_new();
    let w: object = mk_world(11);
    let cs: object = store_flat();
    let gy: f64 = f64(g_FLAT_CM) / 100.0;

    let ps: i32 = put_player(w, 0.0, gy, 0.0);
    let hid: i32 = ai_spawn(ai, w, AI_HUSK, 0.0, gy, 0.0 - 20.0, 0.0);
    let hs: i32 = world_slot_of(w, hid);

    let d0: f64 = dist_xz(w, hs, ps);
    let d60: f64 = 0.0;
    let d120: f64 = 0.0;
    let windup_tick: i32 = -1;
    let windup_dist: f64 = 0.0;
    let min_dist: f64 = 1000.0;
    let alerts: i32 = 0;

    let t: i32 = 0;
    while (t < 600) {
        world_set_tick(w, t);
        ai_step(ai, w, cs);
        let sl: i32 = world_slot_of(w, hid);
        let d: f64 = dist_xz(w, sl, ps);
        if (d < min_dist) { min_dist = d; }
        let e: i32 = 0;
        while (e < ai_event_count(ai)) {
            if (ai_event_type(ai, e) == AIEV_ALERT) { alerts = alerts + 1; }
            e++;
        }
        let ais = w.ai_state;
        if (windup_tick < 0) {
            if (ais[sl] == AI_ST_WINDUP) { windup_tick = t; windup_dist = d; }
        }
        if (t == 59) { d60 = d; }
        if (t == 119) { d120 = d; }
        t++;
    }

    ck(d60 < d0 && d120 < d60, "C1 seeking closes the distance monotonically", `${d0} ${d60} ${d120}`);
    ck(alerts == 1, "C2 acquiring a target emits exactly one ALERT (the bark), not one per tick", `${alerts}`);
    ck(windup_tick >= 0, "C3 the Husk reaches attack range and commits to a swing", "never wound up");
    ck(windup_dist <= ai_range_of(AI_HUSK) + 0.0001,
       "C4 it commits at or inside its attack range, never outside", `${windup_dist} vs ${ai_range_of(AI_HUSK)}`);
    ck(min_dist >= 0.0, "C5 it never passes through the player", `${min_dist}`);

    // The arrival time is bounded by the table, not by a recorded constant:
    // 6 m of walk at 3.0 plus 12.2 m of charge at 5.2 is the fastest it could
    // possibly be, and half that speed is the slowest anything sane could be.
    let walk_m: f64 = 20.0 - 14.0;
    let chg_m: f64 = 14.0 - ai_range_of(AI_HUSK);
    let ideal_s: f64 = walk_m / 3.0 + chg_m / 5.2;
    let lo: i32 = i32(ideal_s * f64(g_TICK_HZ));
    let hi: i32 = i32(ideal_s * 2.0 * f64(g_TICK_HZ));
    ck(windup_tick >= lo, `C6 it cannot arrive faster than its table speeds allow (>= ${lo} ticks)`, `${windup_tick}`);
    ck(windup_tick <= hi, `C7 it arrives within 2x the ideal travel time (<= ${hi} ticks)`, `${windup_tick}`);

    // A Mote at 2.2 m/s must take strictly longer over the same ground than a
    // Husk that charges at 5.2. Ordering, not a stopwatch reading.
    let ai2: object = ai_new();
    let w2: object = mk_world(11);
    let ps2: i32 = put_player(w2, 0.0, gy, 0.0);
    let mid: i32 = ai_spawn(ai2, w2, AI_MOTE, 0.0, gy, 0.0 - 20.0, 0.0);
    let mtick: i32 = -1;
    t = 0;
    while (t < 1400) {
        world_set_tick(w2, t);
        ai_step(ai2, w2, cs);
        let ms: i32 = world_slot_of(w2, mid);
        let ais2 = w2.ai_state;
        if (mtick < 0) { if (ais2[ms] == AI_ST_WINDUP) { mtick = t; } }
        t++;
    }
    ck(mtick > windup_tick, "C8 a 2.2 m/s Mote takes strictly longer to arrive than a charging Husk",
       `mote ${mtick} husk ${windup_tick}`);

    // No target in range: an agent stands still. It does not drift, and it does
    // not wander off the map over 600 ticks.
    let ai3: object = ai_new();
    let w3: object = mk_world(11);
    put_player(w3, 0.0, gy, 0.0);
    let fid: i32 = ai_spawn(ai3, w3, AI_HUSK, 200.0, gy, 200.0, 0.0);
    let fs0: i32 = world_slot_of(w3, fid);
    let sx0: f64 = w3.px[fs0];
    let sz0: f64 = w3.pz[fs0];
    t = 0;
    while (t < 600) { world_set_tick(w3, t); ai_step(ai3, w3, cs); t++; }
    let fs1: i32 = world_slot_of(w3, fid);
    let drift: f64 = __sqrt((w3.px[fs1] - sx0) * (w3.px[fs1] - sx0) + (w3.pz[fs1] - sz0) * (w3.pz[fs1] - sz0));
    let ais3 = w3.ai_state;
    ck(ais3[fs1] == AI_ST_IDLE, "C9 an agent with no target in range stays IDLE", `${ais3[fs1]}`);
    ck(drift < 0.001, "C10 an IDLE agent does not drift", `${drift} m over 600 ticks`);
    ck(ai_event_count(ai3) == 0, "C11 an IDLE agent emits nothing", `${ai_event_count(ai3)}`);
}

// ===========================================================================
// D. THE WIND-UP TELL CONTRACT  (BUILD_PLAN W4-5)
// ===========================================================================
// "every class's wind-up tell is emitted as an event before the damage
//  (0.45 s for Husk, 1.4 s for Spitter)"
fn section_tells() {
    print("D. Wind-up tells");

    let cs: object = store_flat();
    let gy: f64 = f64(g_FLAT_CM) / 100.0;

    let ok_order: bool = true;
    let ok_delta: bool = true;
    let ok_dmg: bool = true;
    let ok_ival: bool = true;
    let ok_target: bool = true;
    let husk_delta: i32 = -1;
    let spit_delta: i32 = -1;
    let adds_seen: i32 = 0;
    let adds_count: i32 = 0;

    let c: i32 = 0;
    while (c < AI_CLASS_COUNT) {
        let ai: object = ai_new();
        let w: object = mk_world(101 + c);
        let ps: i32 = put_player(w, 0.0, gy, 0.0);
        let pid: i32 = world_id_of(w, ps);
        // Placed just inside its own attack range, so the very first decision
        // it makes is to swing.
        let d: f64 = ai_range_of(c) * 0.90;
        let id: i32 = ai_spawn(ai, w, c, 0.0, gy, 0.0 - d, 0.0);

        let tell_tick: i32 = -1;
        let atk_tick: i32 = -1;
        let tell_ival: i32 = -1;
        let atk_dmg: i32 = -1;
        let atk_target: i32 = -1;

        let t: i32 = 0;
        while (t < 300) {
            world_set_tick(w, t);
            ai_step(ai, w, cs);
            let e: i32 = 0;
            while (e < ai_event_count(ai)) {
                let ty: i32 = ai_event_type(ai, e);
                if (ty == AIEV_TELL) {
                    if (tell_tick < 0) { tell_tick = ai_event_tick(ai, e); tell_ival = ai_event_ival(ai, e); }
                }
                if (ty == AIEV_ATTACK) {
                    if (atk_tick < 0) {
                        atk_tick = ai_event_tick(ai, e);
                        atk_dmg = ai_event_ival(ai, e);
                        atk_target = ai_event_target(ai, e);
                    }
                }
                if (ty == AIEV_ADDS) { adds_seen = adds_seen + 1; adds_count = ai_event_ival(ai, e); }
                e++;
            }
            t++;
        }

        if (tell_tick < 0) { ok_order = false; }
        if (atk_tick < 0) { ok_order = false; }
        if (tell_tick >= 0 && atk_tick >= 0) {
            if (tell_tick >= atk_tick) { ok_order = false; }
            let delta: i32 = atk_tick - tell_tick;
            if (delta != ai_tell_ticks_of(c)) { ok_delta = false; }
            if (c == AI_HUSK) { husk_delta = delta; }
            if (c == AI_SPITTER) { spit_delta = delta; }
        }
        if (tell_ival != ai_tell_ticks_of(c)) { ok_ival = false; }
        if (atk_dmg != ai_damage_of(c)) { ok_dmg = false; }
        if (atk_target != pid) { ok_target = false; }
        c++;
    }

    ck(ok_order, "D1 every class emits a TELL strictly before its ATTACK", "a class did not");
    ck(ok_delta, "D2 ATTACK lands exactly tell_ticks after TELL, for every class", "a class was off");
    ck(husk_delta == 27, "D3 the Husk's tell is 0.45 s == 27 ticks (BUILD_PLAN W4-5)", `${husk_delta}`);
    ck(spit_delta == 84, "D4 the Spitter's tell is 1.4 s == 84 ticks (BUILD_PLAN W4-5)", `${spit_delta}`);
    ck(ok_ival, "D5 the TELL event carries its own length in ticks, so audio can schedule against it", "mismatch");
    ck(ok_dmg, "D6 the ATTACK event carries the GDD damage for its class", "mismatch");
    ck(ok_target, "D7 the ATTACK event names the target it was wound up against", "mismatch");
    ck(adds_seen > 0 && adds_count == 4,
       "D8 the Bulwark's slam requests 4 Wisps (it does not spawn them: the director owns the cap)",
       `${adds_seen} events, ival ${adds_count}`);

    // A committed swing must be dodgeable. Wind a Husk up, then teleport the
    // player out of reach: the swing must WHIFF and deal nothing.
    let ai2: object = ai_new();
    let w2: object = mk_world(303);
    let ps2: i32 = put_player(w2, 0.0, gy, 0.0);
    let id2: i32 = ai_spawn(ai2, w2, AI_HUSK, 0.0, gy, 0.0 - 1.6, 0.0);
    let whiffs: i32 = 0;
    let atks: i32 = 0;
    let t2: i32 = 0;
    while (t2 < 120) {
        world_set_tick(w2, t2);
        ai_step(ai2, w2, cs);
        if (t2 == 5) {
            // The dodge. Out of range * AI_STRIKE_SLACK, still inside aggro.
            let pxs = w2.px;
            pxs[ps2] = 30.0;
        }
        let e2: i32 = 0;
        while (e2 < ai_event_count(ai2)) {
            let ty2: i32 = ai_event_type(ai2, e2);
            if (ty2 == AIEV_WHIFF) { whiffs = whiffs + 1; }
            if (ty2 == AIEV_ATTACK) { atks = atks + 1; }
            e2++;
        }
        t2++;
    }
    ck(whiffs >= 1, "D9 a committed swing WHIFFs when the target leaves range — the wind-up is dodgeable", `${whiffs}`);
    ck(atks == 0, "D10 a whiffed swing emits no ATTACK, so it can deal no damage", `${atks}`);
    ck(ai_whiff_count(ai2) == whiffs, "D11 the whiff counter agrees with the event log", `${ai_whiff_count(ai2)}`);

    // Cadence: recovery is real. Over 10 s a Husk cannot attack more often than
    // 1 / (tell + recover), which is the whole reason RECOVER exists.
    let ai3: object = ai_new();
    let w3: object = mk_world(404);
    put_player(w3, 0.0, gy, 0.0);
    ai_spawn(ai3, w3, AI_HUSK, 0.0, gy, 0.0 - 1.6, 0.0);
    let t3: i32 = 0;
    while (t3 < 600) { world_set_tick(w3, t3); ai_step(ai3, w3, cs); t3++; }
    let pr: array = [];
    let zz: i32 = 0;
    while (zz < AIP_COUNT) { pr.push(0.0); zz++; }
    ai_kind_params(AI_HUSK, pr);
    let cycle_s: f64 = pr[AIP_TELL_S] + pr[AIP_RECOVER_S];
    let max_atk: i32 = i32(10.0 / cycle_s) + 1;
    ck(ai_attack_count(ai3) <= max_atk,
       `D12 attack cadence is bounded by tell + recover (<= ${max_atk} in 10 s)`, `${ai_attack_count(ai3)}`);
    ck(ai_attack_count(ai3) >= 3, "D13 and a Husk in contact does keep attacking", `${ai_attack_count(ai3)}`);
    ck(ai_tell_count(ai3) == ai_attack_count(ai3) + ai_whiff_count(ai3),
       "D14 every tell resolves into exactly one attack or one whiff — no swing is lost",
       `${ai_tell_count(ai3)} tells, ${ai_attack_count(ai3)} atk, ${ai_whiff_count(ai3)} whiff`);
    ck(ai_event_dropped(ai3) == 0, `D15 no event was dropped (log cap ${AI_EVENT_CAP})`, `${ai_event_dropped(ai3)}`);
}

// ===========================================================================
// E. SEPARATION — "agents never stack"
// ===========================================================================
// BUILD_PLAN W4-5: min pairwise distance >= 0.9 m over 10 000 ticks.
fn section_separation() {
    print("E. Separation (14 agents, 10 000 ticks)");

    let ai: object = ai_new();
    let w: object = mk_world(g_WORLD_SEED_DEFAULT);
    let cs: object = store_flat();
    let gy: f64 = f64(g_FLAT_CM) / 100.0;

    let ps: i32 = put_player(w, 0.0, gy, 0.0);

    // The director's alive cap, in a plausible tier-3 mix. They are spawned
    // deliberately close together — 0.6 m apart, already overlapping — because
    // an agent that starts stacked is the case that must not stay stacked.
    let mix: array = [AI_HUSK, AI_HUSK, AI_HUSK, AI_HUSK, AI_HUSK, AI_HUSK, AI_HUSK,
                      AI_WISP, AI_WISP, AI_WISP, AI_WISP,
                      AI_SPITTER, AI_SPITTER, AI_WARDEN];
    let k: i32 = 0;
    while (k < mix.length) {
        let fx: f64 = f64(k % 4) * 0.6 - 0.9;
        let fz: f64 = f64(i32(f64(k) / 4.0)) * 0.6 - 12.0;
        ai_spawn(ai, w, mix[k], fx, gy, fz, 0.0);
        k++;
    }
    ck(mix.length == g_DIR_ALIVE_CAP, `E1 the test runs the director's alive cap of ${g_DIR_ALIVE_CAP} agents`, `${mix.length}`);
    ck(ai_agent_count(ai) == 0, "E2 the agent counter is zero before the first step", `${ai_agent_count(ai)}`);

    let min_all: f64 = 100000.0;
    let min_tick: i32 = -1;
    let max_passes: i32 = 0;
    let ticks: i32 = 10000;
    let c: object = cmd_new();

    let t: i32 = 0;
    while (t < ticks) {
        // The player walks a slow circle, so the crowd keeps re-converging.
        let ang: f64 = f64(t) * 0.004;
        let pxs = w.px; let pzs = w.pz;
        pxs[ps] = 8.0 * __sin(ang);
        pzs[ps] = 8.0 * __cos(ang);

        world_set_tick(w, t);
        ai_step(ai, w, cs);
        if (ai_relax_passes(ai) > max_passes) { max_passes = ai_relax_passes(ai); }

        // min pairwise distance among AI agents, measured AFTER the step —
        // which is the state the renderer and the player will ever see.
        let kind = w.kind; let px = w.px; let pz = w.pz;
        let n: i32 = w.count;
        let i: i32 = 0;
        while (i < n) {
            if (kind[i] == KIND_AI) {
                let j: i32 = i + 1;
                while (j < n) {
                    if (kind[j] == KIND_AI) {
                        let dx: f64 = px[i] - px[j];
                        let dz: f64 = pz[i] - pz[j];
                        let d: f64 = __sqrt(dx * dx + dz * dz);
                        if (d < min_all) { min_all = d; min_tick = t; }
                    }
                    j++;
                }
            }
            i++;
        }
        t++;
    }

    print(`   E   min pairwise distance ${min_all} m (first at tick ${min_tick}); max relaxation passes ${max_passes}`);
    ck(ai_agent_count(ai) == g_DIR_ALIVE_CAP, "E3 all 14 agents were alive for the whole run", `${ai_agent_count(ai)}`);
    ck(min_all >= 0.9, `E4 min pairwise distance >= 0.9 m over ${ticks} ticks (BUILD_PLAN W4-5)`, `${min_all} m at tick ${min_tick}`);
    ck(max_passes <= AI_SEP_PASSES, `E5 separation relaxation stays inside its ${AI_SEP_PASSES}-pass budget`, `${max_passes}`);
    ck(world_check(w) == 0, "E6 the world is still consistent after 10 000 ticks", `${world_check(w)}`);
    ck(ai_terrain_miss_count(ai) == 0, "E7 no terrain sample missed on a resident heightfield", `${ai_terrain_miss_count(ai)}`);

    // The crowd is an arc, not a queue: they surround rather than conga-line.
    // Property: the agents' bounding box is wider than one agent diameter.
    let kind2 = w.kind; let px2 = w.px; let pz2 = w.pz;
    let n2: i32 = w.count;
    let lo_x: f64 = 100000.0; let hi_x: f64 = 0.0 - 100000.0;
    let lo_z: f64 = 100000.0; let hi_z: f64 = 0.0 - 100000.0;
    let q: i32 = 0;
    while (q < n2) {
        if (kind2[q] == KIND_AI) {
            if (px2[q] < lo_x) { lo_x = px2[q]; }
            if (px2[q] > hi_x) { hi_x = px2[q]; }
            if (pz2[q] < lo_z) { lo_z = pz2[q]; }
            if (pz2[q] > hi_z) { hi_z = pz2[q]; }
        }
        q++;
    }
    let spread: f64 = (hi_x - lo_x) + (hi_z - lo_z);
    ck(spread > 2.0, "E8 the crowd occupies real ground rather than one silhouette", `${spread} m of extent`);
}

// One lane run: an agent of `p_class` at (0, -25) walking to a player at
// (0, +25) over the given terrain. Returns its final |x| — the lateral
// deviation from the straight line between them.
fn run_lane(p_class: i32, p_cs: object): f64 {
    let gy: f64 = f64(g_FLAT_CM) / 100.0;
    let ai: object = ai_new();
    let w: object = mk_world(55);
    put_player(w, 0.0, gy, 25.0);
    let id: i32 = ai_spawn(ai, w, p_class, 0.0, gy, 0.0 - 25.0, 0.0);
    let t: i32 = 0;
    while (t < 400) { world_set_tick(w, t); ai_step(ai, w, p_cs); t++; }
    let s: i32 = world_slot_of(w, id);
    let px = w.px;
    let x: f64 = px[s];
    if (x < 0.0) { x = 0.0 - x; }
    let out: f64 = x;
    return out;
}

// ===========================================================================
// F. WHISKERS — ±35°, Husks only
// ===========================================================================
fn section_whiskers() {
    print("F. Whisker avoidance");

    let cs: object = store_wall();
    let none: object = store_none();
    let gy: f64 = f64(g_FLAT_CM) / 100.0;

    // The primitive first: a probe aimed at the ridge is blocked, one aimed
    // along flat ground is not, and an unloaded chunk is not an obstacle.
    let bl_wall: i32 = ai_probe_blocked(cs, 0.0, gy, 0.0 - 8.0, 0.0, 1.0, g_AI_WHISKER_M);
    let bl_flat: i32 = ai_probe_blocked(cs, 20.0, gy, 0.0 - 8.0, 0.0, 1.0, g_AI_WHISKER_M);
    let bl_none: i32 = ai_probe_blocked(none, 0.0, gy, 0.0 - 8.0, 0.0, 1.0, g_AI_WHISKER_M);
    ck(bl_wall == 1, "F1 a whisker aimed into the ridge reports blocked", `${bl_wall}`);
    ck(bl_flat == 0, "F2 a whisker over flat ground reports clear", `${bl_flat}`);
    ck(bl_none == 0, "F3 an unloaded chunk is 'no information', never an obstacle", `${bl_none}`);

    // A shallow rise is walkable: the threshold is a slope, not a height.
    let shallow: i32 = ai_probe_blocked(cs, 0.0 - 6.0, gy + 2.0, 0.0 - 8.0, 0.0, 1.0, g_AI_WHISKER_M);
    ck(shallow == 0, `F4 a rise below the ${AI_WHISKER_SLOPE} slope threshold is walkable, not a wall`, `${shallow}`);

    // Now the behaviour, as a CONTROLLED experiment. Four runs: Husk and
    // Warden, each on the ridge terrain and on flat ground. Same class, same
    // seed, same start, same target — only the terrain differs. The flat run is
    // the control that measures the steering jitter alone, so "it deviated"
    // cannot be confused with "it wobbles".
    let hx_wall: f64 = run_lane(AI_HUSK, cs);
    let hx_flat: f64 = run_lane(AI_HUSK, store_flat());
    let wx_wall: f64 = run_lane(AI_WARDEN, cs);
    let wx_flat: f64 = run_lane(AI_WARDEN, store_flat());
    print(`   F   lateral deviation after 400 ticks — Husk: ${hx_wall} m ridge / ${hx_flat} m flat`);
    print(`   F                                       Warden: ${wx_wall} m ridge / ${wx_flat} m flat`);
    ck(hx_wall > 1.0, "F5 a Husk facing a ridge leaves the straight line (whiskers on)", `${hx_wall} m`);
    ck(hx_wall > hx_flat * 2.0,
       "F6 and it is the TERRAIN that moved it: more than twice its own flat-ground wobble",
       `${hx_wall} vs ${hx_flat}`);
    ck(wx_wall < wx_flat * 2.0,
       "F7 a Warden is not steered by terrain at all (whiskers are Husks-only, per W4-5)",
       `${wx_wall} vs ${wx_flat}`);

    // Line of sight, the Spitter's gate.
    let clear: i32 = ai_los_clear(cs, 20.0, gy + 1.5, 0.0 - 10.0, 20.0, gy + 1.5, 10.0);
    let thru: i32 = ai_los_clear(cs, 0.0 - 10.0, gy + 1.5, 0.0, 10.0, gy + 1.5, 0.0);
    ck(clear == 1, "F8 LOS across flat ground is clear", `${clear}`);
    ck(thru == 0, "F9 LOS through the ridge is blocked — a Spitter cannot fire through a hill", `${thru}`);

    // And the gate is load-bearing: behind the ridge, the Spitter never fires.
    let aiS: object = ai_new();
    let wS: object = mk_world(56);
    put_player(wS, 10.0, gy, 0.0);
    ai_spawn(aiS, wS, AI_SPITTER, 0.0 - 10.0, gy, 0.0, 0.0);
    let t2: i32 = 0;
    let tells: i32 = 0;
    while (t2 < 200) {
        world_set_tick(wS, t2);
        ai_step(aiS, wS, cs);
        let e: i32 = 0;
        while (e < ai_event_count(aiS)) {
            if (ai_event_type(aiS, e) == AIEV_TELL) { tells = tells + 1; }
            e++;
        }
        t2++;
    }
    ck(tells == 0, "F10 a Spitter with a hill between it and the player never winds up", `${tells} tells`);
}

// ===========================================================================
// G. SERVER-ONLY — nothing an AI does may influence a predicted value
// ===========================================================================
fn section_serveronly() {
    print("G. Server-only");

    let ai: object = ai_new();
    let w: object = mk_world(909);
    let cs: object = store_flat();
    let gy: f64 = f64(g_FLAT_CM) / 100.0;
    let ps: i32 = put_player(w, 0.0, gy, 0.0);

    let k: i32 = 0;
    while (k < 8) {
        ai_spawn(ai, w, k % AI_CLASS_COUNT, f64(k) * 0.9 - 3.0, gy, 0.0 - 3.0, 0.0);
        k++;
    }

    // 600 ticks of agents surrounding, winding up and hitting the player.
    // Every player field must come out bit-identical: the AI does not move,
    // damage, flag or animate a player. `combat.hml` applies damage, from the
    // events; that is the whole point of the split.
    let before: u64 = player_hash(w);
    let t: i32 = 0;
    while (t < 600) { world_set_tick(w, t); ai_step(ai, w, cs); t++; }
    let after: u64 = player_hash(w);
    ck(before == after, "G1 600 ticks of AI leave every player field bit-identical", `${before} vs ${after}`);
    ck(ai_attack_count(ai) > 0, "G2 and the AI really did attack during those ticks (the test is not vacuous)", `${ai_attack_count(ai)}`);

    // The AI never writes outside its own kind: a PROP entity is untouched too.
    let hp = w.hp;
    ck(hp[ps] == 100, "G3 the player's health is not the AI's to change", `${hp[ps]}`);

    // ---- the CI grep: no ai_* server field is read on a predicted path ----
    let banned = ["ai_state", "ai_target_id", "ai_timer"];
    let scanned: i32 = 0;
    let hits: string = "";
    scanned = scanned + scan_dir("src/render", banned);
    scanned = scanned + scan_dir("src/net", banned);
    if (exists("src/sim/movement.hml")) {
        scanned = scanned + 1;
        hits = `${hits}${scan_file("src/sim/movement.hml", banned)}`;
    }
    if (exists("src/game/client.hml")) {
        scanned = scanned + 1;
        hits = `${hits}${scan_file("src/game/client.hml", banned)}`;
    }
    hits = `${hits}${g_scan_hits}`;
    print(`   G   scanned ${scanned} predicted-path files for ai_* server fields`);
    ck(scanned >= 1, "G4 the grep actually scanned something (an empty scan must not pass)", `${scanned} files`);
    ck(hits == "", "G5 no ai_* server field is named on any predicted code path", `${hits}`);
}

let g_scan_hits: string = "";

fn scan_file(p_path: string, p_banned: array): string {
    let src = read_file(p_path);
    let lines = src.split("\n");
    let found: string = "";
    let l: i32 = 0;
    while (l < lines.length) {
        let code = lines[l].split("//")[0];
        let b: i32 = 0;
        while (b < p_banned.length) {
            if (code.contains(p_banned[b])) { found = `${found} ${p_path}:${l}:${p_banned[b]}`; }
            b = b + 1;
        }
        l = l + 1;
    }
    let out: string = found;
    return out;
}

fn scan_dir(p_dir: string, p_banned: array): i32 {
    if (is_dir(p_dir) != true) { let z: i32 = 0; return z; }
    let names = list_dir(p_dir);
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < names.length) {
        let nm: string = names[i];
        if (nm.ends_with(".hml")) {
            n = n + 1;
            let path: string = p_dir + "/" + nm;
            g_scan_hits = `${g_scan_hits}${scan_file(path, p_banned)}`;
        }
        i = i + 1;
    }
    let out: i32 = n;
    return out;
}

// ===========================================================================
// H. DETERMINISM
// ===========================================================================
// Same seed + the same command sequence twice -> a bit-identical state hash.
// A different seed -> a different one. Run this file compiled AND interpreted
// and the printed hashes must match across backends.
fn drive_player(p_w: object, p_slot: i32, p_c: object) {
    let w: object = p_w;
    let s: i32 = p_slot;
    // Everything comes out of the InputCommand, dequantized — the exact values
    // the server would read off the wire, never the pre-quantization floats.
    let yw: f64 = cmd_yaw(p_c);
    let mx: f64 = cmd_move_x(p_c);
    let my: f64 = cmd_move_y(p_c);
    // view.hml's basis: forward = (sin yaw, -cos yaw), right = (cos yaw, sin yaw).
    let wx: f64 = mx * __cos(yw) + my * __sin(yw);
    let wz: f64 = mx * __sin(yw) - my * __cos(yw);
    let px = w.px; let pz = w.pz; let yaw = w.yaw;
    let spd: f64 = 4.4;
    px[s] = px[s] + wx * spd * g_TICK_DT;
    pz[s] = pz[s] + wz * spd * g_TICK_DT;
    yaw[s] = yw;
}

fn run_scripted(p_seed: i32, p_ticks: i32): u64 {
    let ai: object = ai_new();
    let w: object = mk_world(p_seed);
    let cs: object = store_wg(p_seed);
    let px0: f64 = 0.0;
    let pz0: f64 = 0.0;
    let gy: f64 = chunk_height_at(cs, px0, pz0);
    let ps: i32 = put_player(w, px0, gy, pz0);

    let mix: array = [AI_HUSK, AI_WISP, AI_HUSK, AI_SPITTER, AI_MOTE, AI_HUSK,
                      AI_WARDEN, AI_WISP, AI_HUSK, AI_WISP, AI_SPITTER, AI_MOTE,
                      AI_HUSK, AI_BULWARK];
    let k: i32 = 0;
    while (k < mix.length) {
        let ang: f64 = f64(k) * 0.4487989505128276;
        let r: f64 = 9.0 + f64(k % 3) * 4.0;
        let sx: f64 = r * __sin(ang);
        let sz: f64 = r * __cos(ang);
        ai_spawn(ai, w, mix[k], sx, chunk_height_at(cs, sx, sz), sz, ang);
        k++;
    }

    let c: object = cmd_new();
    let h: u64 = 1469598103934665603;
    let t: i32 = 0;
    while (t < p_ticks) {
        // The command sequence. Identical for every run, by construction.
        let yw: f64 = f64(t) * 0.006;
        let mvx: f64 = __sin(f64(t) * 0.017);
        cmd_set(c, t, 16, mvx, 1.0, yw, 0.0, 0, 0, t);
        drive_player(w, ps, c);
        world_set_tick(w, t);
        ai_step(ai, w, cs);
        h = hmix(h, ai_hash(ai, w));
        t++;
    }
    let out: u64 = h;
    return out;
}

fn section_determinism() {
    print("H. Determinism");

    let ticks: i32 = 900;
    let a1: u64 = run_scripted(g_WORLD_SEED_DEFAULT, ticks);
    let a2: u64 = run_scripted(g_WORLD_SEED_DEFAULT, ticks);
    let b1: u64 = run_scripted(g_WORLD_SEED_DEFAULT + 1, ticks);
    let b2: u64 = run_scripted(g_WORLD_SEED_DEFAULT + 1, ticks);

    print(`   H   seed ${g_WORLD_SEED_DEFAULT} over ${ticks} ticks -> HASH ${a1}`);
    print(`   H   seed ${g_WORLD_SEED_DEFAULT + 1} over ${ticks} ticks -> HASH ${b1}`);
    print("   H   (run this probe compiled AND interpreted: these two lines must match)");

    ck(a1 == a2, "H1 same seed + same command sequence -> bit-identical state hash", `${a1} vs ${a2}`);
    ck(b1 == b2, "H2 and again for the second seed", `${b1} vs ${b2}`);
    ck(a1 != b1, "H3 NEGATIVE CONTROL: a different seed produces a different hash", `${a1} == ${b1}`);

    // Determinism is not "the sim converged and stopped moving". Prove the run
    // is live: the hash of the first half differs from the hash of the whole.
    let half: u64 = run_scripted(g_WORLD_SEED_DEFAULT, ticks / 2);
    ck(half != a1, "H4 the run is live, not converged (half the ticks hashes differently)", `${half}`);

    // Rewind-freedom: the AI stores nothing outside the world, so two stores
    // stepping the same world from the same state agree. This is what makes
    // lag compensation and replay possible later.
    let aiA: object = ai_new();
    let aiB: object = ai_new_cap(64);
    let wA: object = mk_world(77);
    let wB: object = mk_world(77);
    let cs: object = store_flat();
    let gy: f64 = f64(g_FLAT_CM) / 100.0;
    put_player(wA, 0.0, gy, 0.0);
    put_player(wB, 0.0, gy, 0.0);
    let j: i32 = 0;
    while (j < 6) {
        ai_spawn(aiA, wA, j, f64(j) * 1.5 - 4.0, gy, 0.0 - 6.0, 0.0);
        ai_spawn(aiB, wB, j, f64(j) * 1.5 - 4.0, gy, 0.0 - 6.0, 0.0);
        j++;
    }
    let same: bool = true;
    let t: i32 = 0;
    while (t < 400) {
        world_set_tick(wA, t); ai_step(aiA, wA, cs);
        world_set_tick(wB, t); ai_step(aiB, wB, cs);
        if (ai_hash(aiA, wA) != ai_hash(aiB, wB)) { same = false; }
        t++;
    }
    ck(same, "H5 two independent AI stores stepping identical worlds never diverge", "diverged");

    // The hash is sensitive: nudge one agent by a millimetre and it changes.
    let hA: i32 = ai_hash(aiA, wA);
    let pxA = wA.px;
    pxA[1] = pxA[1] + 0.001;
    ck(ai_hash(aiA, wA) != hA, "H6 the state hash notices a 1 mm change (it is not a constant)", `${hA}`);
}

// ===========================================================================
// I. PERFORMANCE  (RULE T: __clock CPU time, min of 7)
// ===========================================================================
fn build_bench(p_ai: object, p_w: object, p_cs: object): i32 {
    let ai: object = p_ai;
    let w: object = p_w;
    let gy: f64 = f64(g_FLAT_CM) / 100.0;
    let ps: i32 = put_player(w, 0.0, gy, 0.0);
    let mix: array = [AI_HUSK, AI_HUSK, AI_HUSK, AI_HUSK, AI_HUSK, AI_HUSK, AI_HUSK,
                      AI_WISP, AI_WISP, AI_WISP, AI_WISP,
                      AI_SPITTER, AI_SPITTER, AI_WARDEN];
    let k: i32 = 0;
    while (k < mix.length) {
        let ang: f64 = f64(k) * 0.4487989505128276;
        let r: f64 = 6.0 + f64(k % 3) * 2.0;
        ai_spawn(ai, w, mix[k], r * __sin(ang), gy, r * __cos(ang), ang);
        k++;
    }
    let out: i32 = ps;
    return out;
}

fn section_perf() {
    print("I. Performance (RULE T: __clock CPU time, min of 7 trials)");

    let TRIALS = 7;

    // Backend + load calibration, exactly as probe_daycycle does it: every
    // bound below is a ratio against an empty loop, so the same assertion holds
    // compiled and interpreted, on a loaded box or an idle one (CLAUDE.md §1.2).
    let NC = 2000000;
    let bestc: f64 = 1000000.0;
    let calsink: i32 = 0;
    let tc = 0;
    while (tc < TRIALS) {
        let t0: f64 = __clock();
        let i = 0;
        while (i < NC) { calsink = calsink ^ i; i = i + 1; }
        let dt: f64 = __clock() - t0;
        if (dt < bestc) { bestc = dt; }
        tc = tc + 1;
    }
    let cal: f64 = bestc * 1000000000.0 / f64(NC);
    let scale: f64 = cal / 12.5;
    if (scale < 1.0) { scale = 1.0; }
    print(`   I0  empty-loop calibration ${cal} ns/iter -> bound scale x${scale}   sink=${calsink}`);

    // I1 — the shipping case: the director's 14 alive agents, all engaged.
    let N: i32 = 2000;
    let best: f64 = 1000000.0;
    let sink: i32 = 0;
    let tr: i32 = 0;
    while (tr < TRIALS) {
        let ai: object = ai_new();
        let w: object = mk_world(g_WORLD_SEED_DEFAULT + tr);
        let cs: object = store_flat();
        let ps: i32 = build_bench(ai, w, cs);
        // Warm the chunk store so the first tick is not paying for a load.
        world_set_tick(w, 0);
        ai_step(ai, w, cs);

        let t0: f64 = __clock();
        let t: i32 = 0;
        while (t < N) {
            world_set_tick(w, t);
            sink = sink + ai_step(ai, w, cs);
            t++;
        }
        let dt: f64 = __clock() - t0;
        if (dt < best) { best = dt; }
        tr++;
    }
    let ms14: f64 = best * 1000.0 / f64(N);
    let norm14: f64 = ms14 / scale;
    print(`   I1  ai_step, 14 agents  ${ms14} ms/tick raw  (${norm14} ms/tick scale-normalised, min of ${TRIALS}, ${N} ticks)  sink=${sink}`);

    // The bound is a REGRESSION GUARD at ~2x the loaded measurement, not a
    // certification of an idle box. Both numbers live in the assertion text.
    ck(norm14 < 0.5,
       "I1 14 agents cost < 0.50 ms/tick scale-normalised (BUILD_PLAN W4-5; measured 0.068-0.072 ms compiled under a 17-core load; the bound is a ~7x regression guard, not a certification of an idle box)",
       `${norm14} ms/tick normalised, ${ms14} ms raw`);

    let pct: f64 = norm14 * 100.0 / g_BUDGET_SIM_MS;
    print(`   I2  = ${pct} % of the ${g_BUDGET_SIM_MS} ms sim budget`);
    ck(pct < 25.0,
       `I2 AI takes under a quarter of the ${g_BUDGET_SIM_MS} ms sim budget (measured ~1.2 %)`,
       `${pct} %`);

    // I3 — scaling. Doubling the agent count must not more than quadruple the
    // cost: separation is O(n^2) and everything else is O(n), so the ratio is
    // the shape check that catches an accidental O(n^3).
    let N2: i32 = 1500;
    let best2: f64 = 1000000.0;
    let sink2: i32 = 0;
    let tr2: i32 = 0;
    while (tr2 < TRIALS) {
        let ai2: object = ai_new();
        let w2: object = mk_world(g_WORLD_SEED_DEFAULT + tr2);
        let cs2: object = store_flat();
        let gy: f64 = f64(g_FLAT_CM) / 100.0;
        put_player(w2, 0.0, gy, 0.0);
        let k: i32 = 0;
        while (k < 28) {
            let ang: f64 = f64(k) * 0.2243994752564138;
            let r: f64 = 6.0 + f64(k % 5) * 2.0;
            ai_spawn(ai2, w2, k % AI_CLASS_COUNT, r * __sin(ang), gy, r * __cos(ang), ang);
            k++;
        }
        world_set_tick(w2, 0);
        ai_step(ai2, w2, cs2);
        let t0: f64 = __clock();
        let t: i32 = 0;
        while (t < N2) { world_set_tick(w2, t); sink2 = sink2 + ai_step(ai2, w2, cs2); t++; }
        let dt: f64 = __clock() - t0;
        if (dt < best2) { best2 = dt; }
        tr2++;
    }
    let ms28: f64 = best2 * 1000.0 / f64(N2);
    let ratio: f64 = ms28 / ms14;
    print(`   I3  ai_step, 28 agents  ${ms28} ms/tick raw -> 28/14 cost ratio ${ratio}  sink=${sink2}`);
    // The shape check. Everything per agent is O(n); separation is O(n^2) in
    // agents, and the relaxation runs it once per pass, so the true shape is
    // passes x n^2 and doubling n costs somewhat more than 4x because a denser
    // crowd also needs more passes (measured 4.5-5.0x). What this bound exists
    // to catch is an accidental O(n^3), which would be 8x.
    ck(ratio < 8.0,
       "I3 doubling the agents stays sub-cubic — separation is passes x O(n^2), never O(n^3) (measured 4.5-5.0x; pure n^2 would be 4.0x, cubic 8.0x)",
       `${ratio}x`);
    ck(ms28 < 0.5 * scale,
       "I4 even at TWICE the director's alive cap the step stays inside the 0.5 ms/tick bound",
       `${ms28} ms/tick at 28 agents`);
}

// ===========================================================================
fn main() {
    print("probe_ai  —  W4-5  (src/sim/ai.hml)");
    print("");

    if (is_dir("src/sim") != true) {
        print("FAIL  run this from the nightshade repo root: src/sim/ not found from here");
        exit(1);
    }

    section_table();
    print("");
    section_spawn();
    print("");
    section_seek();
    print("");
    section_tells();
    print("");
    section_separation();
    print("");
    section_whiskers();
    print("");
    section_serveronly();
    print("");
    section_determinism();
    print("");
    section_perf();
    print("");

    print(`ASSERTIONS  ran ${g_asserts}  expected ${g_expect_asserts}  pass ${g_pass}  fail ${g_fail}`);
    if (g_asserts != g_expect_asserts) {
        print(`FAIL  assertion COUNT mismatch: ran ${g_asserts}, expected ${g_expect_asserts}`);
        exit(1);
    }
    if (g_fail != 0) {
        print(`FAIL  ${g_fail} of ${g_asserts} assertions failed`);
        exit(1);
    }
    print(`PASS  ${g_pass}/${g_asserts} assertions`);
}

main();
