    AIEV_ALERT, AIEV_TELL, AIEV_ATTACK, AIEV_WHIFF, AIEV_ADDS,
    AIP_HP, AIP_ARMOR, AIP_SPEED, AIP_SPEED_HI, AIP_DAMAGE, AIP_RANGE_M,
    AIP_TELL_S, AIP_RECOVER_S, AIP_AGGRO_M, AIP_TURN, AIP_ACCEL,
    AIP_RADIUS, AIP_HEIGHT, AIP_EMBER, AIP_XP, AIP_COST, AIP_COUNT,
    AI_CONTACT_M, AI_HARD_SEP_M, AI_SEP_PASSES, AI_EVENT_CAP,
    AI_WHISKER_SLOPE, AI_STRIKE_SLACK, AI_TEAM_SHADE,
    ai_new, ai_new_cap, ai_spawn, ai_step, ai_kind_params, ai_hash,
    ai_class_of, ai_tell_ticks_of, ai_probe_blocked, ai_los_clear,
    ai_yaw_of_dir, ai_forward_x, ai_forward_z,
    ai_event_count, ai_event_type, ai_event_tick, ai_event_id, ai_event_class,
    ai_event_target, ai_event_ival, ai_event_dropped,
    ai_agent_count, ai_spawn_count, ai_spawn_fail_count, ai_attack_count,
    ai_tell_count, ai_whiff_count, ai_relax_passes, ai_terrain_miss_count,
    ai_hp_of, ai_damage_of, ai_cost_of, ai_xp_of, ai_ember_of,
    ai_speed_of, ai_range_of, ai_tell_s_of, ai_radius_of, ai_height_of
} from "../src/sim/ai.hml";

