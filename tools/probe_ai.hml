// probe_ai.hml — W4-5 acceptance probe for src/sim/ai.hml.
//
// Run it FROM THE NIGHTSHADE REPO ROOT, both ways:
//     hemlockc -O1 tools/probe_ai.hml -o /tmp/pai && /tmp/pai
//     hemlock  tools/probe_ai.hml
//
// It exits 1 on any failure AND on an assertion-count mismatch. A probe that
// silently stops running half its checks is worse than no probe.
//
// ---------------------------------------------------------------------------
// WHAT THIS PROBE ASSERTS, AND WHAT IT REFUSES TO
// ---------------------------------------------------------------------------
// The GDD §2.2 table IS the design — HP, damage, speed, attack range, ember, XP
// and spawn cost are typed there and typed here, and if they diverge the game
// is not the game that was designed. Those are asserted as digits, on purpose.
//
// Everything else is asserted as a PROPERTY, because the project has already
// been burned by probes that froze a consequence as a constant and went stale
// in silence:
//
//     a wind-up TELL always precedes the damage, by exactly tell_ticks
//     no enemy is faster than a sprinting player
//     every class notices you at least as far away as it can hit you
//     ember / XP / spawn cost all rise strictly with the class index
//     seeking monotonically closes the distance, and stops at attack range
//     agents never stack: min pairwise distance over 10 000 ticks
//     ai_step leaves every player field bit-identical
//     the same seed and the same commands give the same hash; a different seed
//         gives a different one
//
// The two digits in the wind-up section (27 ticks for a Husk, 84 for a Spitter)
// are the exception, because BUILD_PLAN W4-5 names 0.45 s and 1.4 s explicitly
// and something has to hold that line. They are asserted against the seconds in
// the table AND against the tick count, so a retune of the table moves both.

import { exit } from "@stdlib/process";
import { read_file, exists, is_dir, list_dir } from "@stdlib/fs";

