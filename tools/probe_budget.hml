// scratch: find the worst tick while WALKING, and attribute it.
import { exit } from "@stdlib/process";

import { g_BUDGET_SIM_MS } from "../src/core/config.hml";

import { sim_accum_new, sim_accum_advance, sim_accum_alpha, sim_step,
         sim_stat_streams, sim_stat_ground_miss
       } from "../src/sim/sim.hml";
import { world_count } from "../src/sim/world.hml";
import { chunk_hit_count, chunk_miss_count, chunk_resident,
         chunk_sample_miss_count } from "../src/sim/chunk.hml";

import { transport_loopback } from "../src/net/transport.hml";

import { server_new, server_tick, server_snapshot, server_local, server_world,
         server_t0, server_spawn_yaw, server_enemies_alive, server_chunks
       } from "../src/game/server.hml";
import { client_new, client_apply, client_send_command, client_set_angles,
         client_set_move, client_set_button, client_frame, client_build_render
       } from "../src/game/client.hml";
import { BTN_SPRINT } from "../src/sim/command.hml";

fn f3(p_x: f64): string {
    let neg: i32 = 0;
    let x: f64 = p_x;
    if (x < 0.0) { neg = 1; x = 0.0 - x; }
    let s: i32 = i32(x * 1000.0 + 0.5);
    let w: i32 = i32(f64(s) / 1000.0);
    let f: i32 = s - w * 1000;
    let fs: string = `${f}`;
    if (f < 10) { fs = "00" + fs; } else if (f < 100) { fs = "0" + fs; }
    let o: string = `${w}.${fs}`;
    if (neg == 1) { o = "-" + o; }
    return o;
}

fn session_new(p_seed: i32): object {
    let net: object = transport_loopback();
    let sv: object = server_new(p_seed, net);
    let cl: object = client_new(net, p_seed);
    let s: object = { net: net, sv: sv, cl: cl, acc: sim_accum_new(),
                      tick: server_t0(sv) };
    client_set_angles(cl, server_spawn_yaw(sv), 0.0);
    server_tick(sv, s.tick);
    client_apply(cl, server_snapshot(sv), server_local(sv), s.tick);
    s.tick = s.tick + 1;
    let o: object = s;
    return o;
}

// One tick, timed. Returns ms.
fn timed_tick(p_s: object): f64 {
    let s: object = p_s;
    let t0: f64 = __clock();
    client_send_command(s.cl, s.tick);
    server_tick(s.sv, s.tick);
    client_apply(s.cl, server_snapshot(s.sv), server_local(s.sv), s.tick);
    let ms: f64 = (__clock() - t0) * 1000.0;
    s.tick = s.tick + 1;
    let o: f64 = ms;
    return o;
}

fn main() {
    let s: object = session_new(1337);
    let cs: object = server_chunks(s.sv);
    let w: object = server_world(s.sv);

    // Sprint in a straight line for 120 s. At ~8 m/s that is ~960 m = 30 chunk
    // crossings, which is what a real playtest does and the scripted demo does
    // not.
    let n: i32 = 120 * 60;
    let i: i32 = 0;
    let worst: f64 = 0.0;
    let worst_at: i32 = 0;
    let worst_streams: i32 = 0;
    let hist_ms: array<f64> = [];
    let acc: f64 = 0.0;
    let prev_streams: i32 = sim_stat_streams(w);
    let cross_worst: f64 = 0.0;
    let cross_n: i32 = 0;
    let cross_acc: f64 = 0.0;
    let plain_worst: f64 = 0.0;
    let plain_acc: f64 = 0.0;
    let plain_n: i32 = 0;
    let over2: i32 = 0;
    while (i < n) {
        client_set_move(s.cl, 1.0, 0.0);
        client_set_button(s.cl, BTN_SPRINT, 1);
        let ms: f64 = timed_tick(s);
        let st: i32 = sim_stat_streams(w);
        acc = acc + ms;
        if (ms > worst) { worst = ms; worst_at = i; worst_streams = st; }
        if (ms > 2.0) { over2 = over2 + 1; }
        if (st != prev_streams) {
            cross_n = cross_n + 1;
            cross_acc = cross_acc + ms;
            if (ms > cross_worst) { cross_worst = ms; }
            prev_streams = st;
        } else {
            plain_n = plain_n + 1;
            plain_acc = plain_acc + ms;
            if (ms > plain_worst) { plain_worst = ms; }
        }
        i++;
    }
    print(`sprint 120 s, ${n} ticks, seed 1337`);
    print(`  mean tick            ${f3(acc / f64(n))} ms`);
    print(`  WORST tick           ${f3(worst)} ms at tick ${worst_at} (budget ${f3(g_BUDGET_SIM_MS)})`);
    print(`  ticks over 2.0 ms    ${over2}`);
    print(`  chunk-crossing ticks ${cross_n}: mean ${f3(cross_acc / f64(cross_n + 1))} worst ${f3(cross_worst)} ms`);
    print(`  other ticks          ${plain_n}: mean ${f3(plain_acc / f64(plain_n + 1))} worst ${f3(plain_worst)} ms`);
    print(`  streams ${sim_stat_streams(w)}  ground_miss ${sim_stat_ground_miss(w)}  ents ${world_count(w)} alive ${server_enemies_alive(s.sv)}`);
    print(`  chunk hits ${chunk_hit_count(cs)} misses ${chunk_miss_count(cs)} resident ${chunk_resident(cs)} sample_miss ${chunk_sample_miss_count(cs)}`);
    exit(0);
}

main();
