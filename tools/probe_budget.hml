// ===========================================================================
//  probe_budget.hml — the two budget lines Gate 4b/4c flagged.
// ---------------------------------------------------------------------------
//  (a) sim+net worst 3.0-3.2 ms against ARCHITECTURE §8's 2.0 ms budget.
//  (b) HUD peak 248 of the 250-triangle layer cap.
//
//  Headless, no SDL linked, COMPILED.  Exits 1 on any failure AND on running
//  the wrong NUMBER of assertions, so a criterion that silently stops being
//  checked is a build failure rather than a green run.
//
//  RULE T (CLAUDE.md §1.2): every timing is `__clock()` CPU time.  Where a
//  steady-state cost is wanted it is the MINIMUM of seven batches.  Where a
//  WORST CASE is wanted — which is exactly what a 3.0 ms spike is — a minimum
//  would hide the thing being measured, so the per-tick maximum over a whole
//  run is reported instead, and the bound on it is a regression guard at ~2x
//  the loaded figure with BOTH numbers in the assertion text.
// ===========================================================================

import { exit } from "@stdlib/process";

import { g_BUDGET_SIM_MS, g_HUD_TRI_CAP, g_TRIS_STEADY, g_RING_RADIUS
       } from "../src/core/config.hml";

import { sim_accum_new, sim_accum_advance, sim_accum_alpha, sim_step,
         sim_stat_streams, sim_stat_ground_miss, sim_stat_streamed,
         sim_stat_stream_tick_count, sim_stat_stream_worst, sim_stream_pending,
         sim_hash, SIM_STREAM_PER_TICK, SIM_MAX_TICKS_PER_FRAME,
         sim_accum_stalls, sim_accum_forgiven
       } from "../src/sim/sim.hml";
import { world_count } from "../src/sim/world.hml";
import { chunk_hit_count, chunk_miss_count, chunk_resident,
         chunk_sample_miss_count } from "../src/sim/chunk.hml";
import { BTN_SPRINT } from "../src/sim/command.hml";

import { transport_loopback } from "../src/net/transport.hml";

import { server_new, server_tick, server_snapshot, server_local, server_world,
         server_t0, server_spawn_yaw, server_enemies_alive, server_chunks,
         server_hash
       } from "../src/game/server.hml";
import { client_new, client_apply, client_send_command, client_set_angles,
         client_set_move, client_set_button, client_frame, client_build_render
       } from "../src/game/client.hml";

let g_EXPECT: i32 = 19;
let g_n: i32 = 0;
let g_ok: i32 = 0;

fn ck(p_ok: bool, p_msg: string) {
    g_n = g_n + 1;
    if (p_ok) { g_ok = g_ok + 1; }
    if (!p_ok) { print(`  FAIL [${g_n}] ${p_msg}`); }
    if (p_ok) { print(`  ok   [${g_n}] ${p_msg}`); }
}

fn f3(p_x: f64): string {
    let neg: i32 = 0;
    let x: f64 = p_x;
    if (x < 0.0) { neg = 1; x = 0.0 - x; }
    let s: i32 = i32(x * 1000.0 + 0.5);
    let w: i32 = i32(f64(s) / 1000.0);
    let f: i32 = s - w * 1000;
    let fs: string = `${f}`;
    if (f < 10) { fs = "00" + fs; } else if (f < 100) { fs = "0" + fs; }
    let o: string = `${w}.${fs}`;
    if (neg == 1) { o = "-" + o; }
    return o;
}

// ---------------------------------------------------------------------------
// A SESSION — `main.hml`'s tick loop with the window, the renderer and the
// clock removed, copied from `tools/probe_game.hml` for the same reason it
// copied it from main.hml: a probe that drives a different loop from the game
// measures a loop nobody ships.
// ---------------------------------------------------------------------------
fn session_new(p_seed: i32): object {
    let net: object = transport_loopback();
    let sv: object = server_new(p_seed, net);
    let cl: object = client_new(net, p_seed);
    let s: object = { net: net, sv: sv, cl: cl, acc: sim_accum_new(),
                      tick: server_t0(sv) };
    client_set_angles(cl, server_spawn_yaw(sv), 0.0);
    server_tick(sv, s.tick);
    client_apply(cl, server_snapshot(sv), server_local(sv), s.tick);
    s.tick = s.tick + 1;
    let o: object = s;
    return o;
}

fn tick_once(p_s: object) {
    let s: object = p_s;
    client_send_command(s.cl, s.tick);
    server_tick(s.sv, s.tick);
    client_apply(s.cl, server_snapshot(s.sv), server_local(s.sv), s.tick);
    s.tick = s.tick + 1;
}

fn timed_tick(p_s: object): f64 {
    let s: object = p_s;
    let t0: f64 = __clock();
    tick_once(s);
    let ms: f64 = (__clock() - t0) * 1000.0;
    let o: f64 = ms;
    return o;
}

// ===========================================================================
//  A.  THE WORST TICK, AND WHERE IT COMES FROM
// ---------------------------------------------------------------------------
//  The scripted demo walks 40 m and stops, which crosses one chunk boundary
//  and therefore never sees this.  A player sprints, so the probe sprints.
// ===========================================================================
let g_a_worst: f64 = 0.0;
let g_a_mean: f64 = 0.0;
let g_a_cross_worst: f64 = 0.0;
let g_a_plain_worst: f64 = 0.0;
let g_a_cross_n: i32 = 0;

fn section_a() {
    print("A. the worst tick while SPRINTING (the spike the demo never reaches)");
    let s: object = session_new(1337);
    let cs: object = server_chunks(s.sv);
    let w: object = server_world(s.sv);

    let n: i32 = 120 * 60;
    let i: i32 = 0;
    let acc: f64 = 0.0;
    let worst: f64 = 0.0;
    let worst_at: i32 = 0;
    let prev_streams: i32 = sim_stat_streams(w);
    let prev_gen: i32 = sim_stat_streamed(w);
    let cross_n: i32 = 0;
    let gen_n: i32 = 0;
    let gen_acc: f64 = 0.0;
    let gen_worst: f64 = 0.0;
    let quiet_worst: f64 = 0.0;
    let quiet_acc: f64 = 0.0;
    let quiet_n: i32 = 0;
    let over: i32 = 0;
    while (i < n) {
        client_set_move(s.cl, 1.0, 0.0);
        client_set_button(s.cl, BTN_SPRINT, 1);
        let ms: f64 = timed_tick(s);
        acc = acc + ms;
        if (ms > worst) { worst = ms; worst_at = i; }
        if (ms > g_BUDGET_SIM_MS) { over = over + 1; }
        let st: i32 = sim_stat_streams(w);
        if (st != prev_streams) { cross_n = cross_n + 1; prev_streams = st; }
        // The classification that matters is NOT "did the player cross a
        // boundary" but "did this tick GENERATE a chunk" -- with the bounded
        // walk those are different ticks, and lumping them hides where the
        // cost is.  A generating tick is one chunk of worldgen; every other
        // tick is the sim proper.
        let gn: i32 = sim_stat_streamed(w);
        if (gn != prev_gen) {
            gen_n = gen_n + 1;
            gen_acc = gen_acc + ms;
            if (ms > gen_worst) { gen_worst = ms; }
            prev_gen = gn;
        } else {
            quiet_n = quiet_n + 1;
            quiet_acc = quiet_acc + ms;
            if (ms > quiet_worst) { quiet_worst = ms; }
        }
        i++;
    }
    g_a_worst = worst;
    g_a_mean = acc / f64(n);
    g_a_cross_worst = gen_worst;
    g_a_plain_worst = quiet_worst;
    g_a_cross_n = cross_n;

    print(`   ${n} ticks, ${cross_n} chunk-boundary crossings, ${sim_stat_streamed(w)} chunks streamed`);
    print(`   mean ${f3(g_a_mean)} ms   WORST ${f3(worst)} ms at tick ${worst_at}`);
    print(`   ticks that GENERATED a chunk  ${gen_n}: mean ${f3(gen_acc / f64(gen_n + 1))} ms  worst ${f3(gen_worst)} ms   <- one chunk of worldgen`);
    print(`   every other tick              ${quiet_n}: mean ${f3(quiet_acc / f64(quiet_n + 1))} ms  worst ${f3(quiet_worst)} ms   <- the sim proper`);
    print(`   chunks: hits ${chunk_hit_count(cs)} misses ${chunk_miss_count(cs)} resident ${chunk_resident(cs)}  stream ticks ${sim_stat_stream_tick_count(w)} worst/tick ${sim_stat_stream_worst(w)}  pending ${sim_stream_pending(w)}`);

    ck(worst < g_BUDGET_SIM_MS,
       `worst single networked tick ${f3(worst)} ms is inside ARCHITECTURE §8's ${f3(g_BUDGET_SIM_MS)} ms sim budget (was 3.766 ms before the streaming walk)`);
    ck(over == 0,
       `no tick of ${n} exceeded the budget; ${over} did (32 did before)`);
    // RULE T asks for a guard at ~2x the loaded figure.  IT CANNOT BE 2x HERE
    // and saying so is the honest thing: 2 x 1.18 ms = 2.36 ms is ABOVE the
    // 2.0 ms budget the guard exists to protect, so a 2x guard would be
    // vacuous.  It is set just under the budget instead, which still catches
    // the regression that motivated this work by a factor of two (the eager
    // pin measured 3.766 ms).  The load-INDEPENDENT guard is the structural
    // one on the next line, and that is the one to trust: CLAUDE.md §1.2 says
    // prefer a structural assertion to an absolute one, because contention
    // moves absolute numbers and cannot move a counter.
    ck(worst < 1.9,
       `regression guard: worst tick ${f3(worst)} ms on a box sharing 17 of 24 cores; the guard is 1.9 ms, just under the ${f3(g_BUDGET_SIM_MS)} ms budget, and the defect it guards against measured 3.766 ms`);
    // The DESIGN anchor, pinned with a literal rather than to the config value
    // it is supposed to constrain.
    ck(SIM_STREAM_PER_TICK == 1,
       `SIM_STREAM_PER_TICK is the documented literal 1; it is ${SIM_STREAM_PER_TICK}`);
    ck(sim_stat_stream_worst(w) <= SIM_STREAM_PER_TICK,
       `no tick in the run generated more than SIM_STREAM_PER_TICK chunks: worst ${sim_stat_stream_worst(w)} of ${SIM_STREAM_PER_TICK}`);
    ck(g_RING_RADIUS == 2,
       `the safety margin this rests on is g_RING_RADIUS = 2 chunks (64 m); it is ${g_RING_RADIUS}`);
    // The correctness consequence of deferring: if the walk ever fell behind
    // the player, a height sample would land on an unresident chunk.
    ck(chunk_sample_miss_count(cs) == 0,
       `not one height sample landed on an unresident chunk in ${n} ticks of sprinting: ${chunk_sample_miss_count(cs)} misses`);
    ck(sim_stat_ground_miss(w) == 0,
       `the player never lost the ground: ${sim_stat_ground_miss(w)} GROUND_MISS events`);
    ck(sim_stream_pending(w) == 0,
       `the ring is complete at the end of the run: ${sim_stream_pending(w)} cells pending`);
}

// ===========================================================================
//  B.  THE STEADY-STATE TICK, DECOMPOSED
// ---------------------------------------------------------------------------
//  Wave 4a measured the eight sim modules at 0.152 ms/tick.  This says what
//  the WIRING around them costs, so "the overrun is in the wiring" is a
//  measurement rather than an inference.
// ===========================================================================
fn min7_full(p_s: object, p_iters: i32): f64 {
    let s: object = p_s;
    let iters: i32 = p_iters;
    let best: f64 = 1.0e30;
    let t: i32 = 0;
    while (t < 7) {
        let t0: f64 = __clock();
        let k: i32 = 0;
        while (k < iters) { tick_once(s); k++; }
        let ms: f64 = (__clock() - t0) * 1000.0 / f64(iters);
        if (ms < best) { best = ms; }
        t++;
    }
    let o: f64 = best;
    return o;
}

fn min7_sim(p_s: object, p_iters: i32): f64 {
    let s: object = p_s;
    let w: object = server_world(s.sv);
    let iters: i32 = p_iters;
    let best: f64 = 1.0e30;
    let t: i32 = 0;
    while (t < 7) {
        let t0: f64 = __clock();
        let k: i32 = 0;
        while (k < iters) { sim_step(w, s.tick); s.tick = s.tick + 1; k++; }
        let ms: f64 = (__clock() - t0) * 1000.0 / f64(iters);
        if (ms < best) { best = ms; }
        t++;
    }
    let o: f64 = best;
    return o;
}

fn min7_apply(p_s: object, p_iters: i32): f64 {
    let s: object = p_s;
    let pk: object = server_snapshot(s.sv);
    let lc: object = server_local(s.sv);
    let iters: i32 = p_iters;
    let best: f64 = 1.0e30;
    let t: i32 = 0;
    while (t < 7) {
        let t0: f64 = __clock();
        let k: i32 = 0;
        while (k < iters) { client_apply(s.cl, pk, lc, s.tick); k++; }
        let ms: f64 = (__clock() - t0) * 1000.0 / f64(iters);
        if (ms < best) { best = ms; }
        t++;
    }
    let o: f64 = best;
    return o;
}

fn section_b() {
    print("B. the steady-state tick, decomposed (RULE T, min of 7 batches of 600)");
    let s: object = session_new(1337);
    // Into combat first: the population is what the cost scales with, and a
    // measurement taken on an empty world is a measurement of nothing.
    let i: i32 = 0;
    while (i < 6 * 60) { client_set_move(s.cl, 1.0, 0.0); tick_once(s); i++; }
    // Saturate before timing, so the ordering of the three measurements below
    // cannot bias them: an unsaturated world grows DURING the first one.
    let j: i32 = 0;
    while (j < 60 * 60) { client_set_move(s.cl, 0.2, 0.0); tick_once(s); j++; }
    let w: object = server_world(s.sv);
    let pop: i32 = world_count(w);

    let full: f64 = min7_full(s, 600);
    let sim: f64 = min7_sim(s, 600);
    let app: f64 = min7_apply(s, 600);
    print(`   population ${pop} entities, ${server_enemies_alive(s.sv)} enemies alive`);
    print(`   whole networked tick  ${f3(full)} ms   of which sim_step ${f3(sim)} ms, client_apply ${f3(app)} ms`);
    print(`   wiring (tick - sim_step - client_apply) ${f3(full - sim - app)} ms`);
    ck(full < g_BUDGET_SIM_MS,
       `steady-state networked tick ${f3(full)} ms is inside the ${f3(g_BUDGET_SIM_MS)} ms budget`);
    ck(full < 0.6,
       `regression guard: steady tick ${f3(full)} ms on a loaded box; the guard is 0.6 ms`);
    ck(sim < full,
       `sim_step ${f3(sim)} ms is a PART of the ${f3(full)} ms tick, not all of it — the wiring is real and measured`);
}

// ===========================================================================
//  C.  DETERMINISM IS UNTOUCHED BY THE STREAMING WALK
// ---------------------------------------------------------------------------
//  Two sessions, same seed, same command stream, 10 000 ticks, compared on
//  `server_hash` (which is `sim_hash`).  This is the assertion that makes the
//  deferral legitimate rather than merely faster.
// ===========================================================================
fn section_c() {
    print("C. determinism across 10 000 ticks of sprinting");
    let a: object = session_new(4242);
    let b: object = session_new(4242);
    let i: i32 = 0;
    while (i < 10000) {
        client_set_move(a.cl, 1.0, 0.0);
        client_set_button(a.cl, BTN_SPRINT, 1);
        client_set_move(b.cl, 1.0, 0.0);
        client_set_button(b.cl, BTN_SPRINT, 1);
        tick_once(a);
        tick_once(b);
        i++;
    }
    let wa: object = server_world(a.sv);
    print(`   hash ${server_hash(a.sv)}   streamed ${sim_stat_streamed(wa)} chunks over ${sim_stat_streams(wa)} crossings`);
    ck(server_hash(a.sv) == server_hash(b.sv),
       `the same seed and command stream give the identical world hash after 10 000 ticks with the streaming walk live`);
    ck(chunk_sample_miss_count(server_chunks(a.sv)) == 0,
       `10 000 ticks of sprinting, still zero unresident height samples: ${chunk_sample_miss_count(server_chunks(a.sv))}`);
}

// ===========================================================================
//  D.  WHAT THE GATE'S 3.0-3.2 ms ACTUALLY WAS
// ---------------------------------------------------------------------------
//  Reproduced on DISPLAY=:0, `main.hml --demo 60`: 5083 frames, 78.4 fps, 0
//  frames over 16.67 ms, and `sim+net: worst 3.0 ms of the 2.0 ms budget` —
//  with `stalls 1` on the same line.  That is the whole explanation, and it is
//  NOT a per-tick overrun.
//
//  `main.hml` brackets the ENTIRE tick loop with one `__clock()` pair:
//
//      let sim0 = __clock();
//      let n = sim_accum_advance(g_acc, frame_ms);   // 0, 1, or up to 15
//      while (i < n) { send; server_tick; apply; }
//      let sim_ms = (__clock() - sim0) * 1000.0;     // <- reported vs 2.0 ms
//
//  So `sim_worst` is a per-FRAME sum over however many ticks that frame owed,
//  while ARCHITECTURE §8's 2.0 ms and net §17.1 are a PER-TICK figure — which is
//  how `probe_game` and `benchframe` both assert it.  One stalled frame issues
//  SIM_MAX_TICKS_PER_FRAME ticks and the sum is 15x a per-tick cost that is
//  itself 7 % of the budget.  The number is real; the comparison is not.
//
//  This section measures the burst directly, through the accumulator this file
//  owns, so the correction is a measurement rather than an argument.
// ===========================================================================
fn section_d() {
    print("D. the accumulator's catch-up burst — what `sim+net worst` really sums");
    let s: object = session_new(1337);
    let i: i32 = 0;
    while (i < 6 * 60) { client_set_move(s.cl, 1.0, 0.0); tick_once(s); i++; }

    // A normal frame.
    let n1: i32 = sim_accum_advance(s.acc, 16.667);
    let t0: f64 = __clock();
    let k: i32 = 0;
    while (k < n1) { tick_once(s); k++; }
    let ms1: f64 = (__clock() - t0) * 1000.0;

    // A stalled frame: 400 ms of wall time, clamped to SIM_MAX_FRAME_MS.
    let n2: i32 = sim_accum_advance(s.acc, 400.0);
    let t1: f64 = __clock();
    let k2: i32 = 0;
    while (k2 < n2) { tick_once(s); k2++; }
    let ms2: f64 = (__clock() - t1) * 1000.0;
    let per: f64 = ms2 / f64(n2);

    print(`   a 16.667 ms frame owes ${n1} tick(s)  -> the loop costs ${f3(ms1)} ms`);
    print(`   a 400 ms STALL owes ${n2} tick(s)     -> the loop costs ${f3(ms2)} ms = ${f3(per)} ms PER TICK`);
    print(`   stalls ${sim_accum_stalls(s.acc)}  forgiven ${sim_accum_forgiven(s.acc)}`);
    ck(n2 == SIM_MAX_TICKS_PER_FRAME,
       `a stalled frame is capped at SIM_MAX_TICKS_PER_FRAME = ${SIM_MAX_TICKS_PER_FRAME} ticks, not 24; it issued ${n2}`);
    ck(sim_accum_stalls(s.acc) == 1,
       `the stall was COUNTED, so a 3.0 ms report always carries its own explanation on the same line: ${sim_accum_stalls(s.acc)}`);
    // The claim is a RATIO, not an absolute: contention moves both numbers
    // together (CLAUDE.md §1.2), and on this headless box the per-tick cost is
    // ~0.09 ms so the burst lands at ~1.4 ms, while on DISPLAY=:0 it is ~0.2 ms
    // and the same 15 ticks land at 3.0 ms — the number the gate reported. What
    // is invariant is that the frame total is ~15x one tick.
    ck(ms2 > ms1 * 5.0,
       `the catch-up frame's TOTAL ${f3(ms2)} ms is ${f3(ms2 / ms1)}x a single tick's ${f3(ms1)} ms — the gate's 3.0 ms is a SUM of ${n2} ticks, not one tick overrunning`);
    ck(per < g_BUDGET_SIM_MS,
       `but PER TICK it is ${f3(per)} ms, ${f3(100.0 * per / g_BUDGET_SIM_MS)} % of the ${f3(g_BUDGET_SIM_MS)} ms budget — the budget is per-tick, so nothing is over it`);
    // No spiral: the frame after the stall owes ONE tick, not the backlog.
    let n3: i32 = sim_accum_advance(s.acc, 16.667);
    ck(n3 == 1,
       `the frame after the stall owes ${n3} tick, not a backlog — the clamp discards the debt, so there is no spiral to bound and nothing to fix here`);
    print(`   note: 'forgiven' stays ${sim_accum_forgiven(s.acc)} because SIM_MAX_FRAME_MS (250) / g_TICK_MS is EXACTLY SIM_MAX_TICKS_PER_FRAME (15), so the second wall cannot fire from one advance. Reported, not fixed — the accumulator's two walls are redundant by construction.`);
}

fn main() {
    print("probe_budget — the two flagged budget lines");
    print("");
    section_a();
    print("");
    section_b();
    print("");
    section_c();
    print("");
    section_d();
    print("");
    if (g_n != g_EXPECT) {
        print(`FAIL: ran ${g_n} assertions, expected ${g_EXPECT}`);
        exit(1);
    }
    if (g_ok != g_n) {
        print(`FAIL ${g_ok} / ${g_n}`);
        exit(1);
    }
    print(`PASS ${g_ok} / ${g_n}`);
    exit(0);
}

main();
