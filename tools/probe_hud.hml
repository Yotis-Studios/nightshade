// ===========================================================================
//  probe_hud.hml — THE HUD'S TRIANGLE BUDGET, WORST CASE, AND ITS HEADROOM.
//  (about-to-break, 2026-07-31)
// ---------------------------------------------------------------------------
//      hemlockc -O1 tools/probe_hud.hml -o /tmp/probe_hud
//      SDL_VIDEODRIVER=dummy /tmp/probe_hud
//
//  Compiled, headless, no window.  SDL is LINKED because `hudgen.hml` reaches
//  wobbleweed's `atlas.hml` and `font.hml`; nothing here presents.  Exits 1 on
//  any failure AND on running the wrong NUMBER of assertions.
//
// ---------------------------------------------------------------------------
//  WHY IT EXISTS
// ---------------------------------------------------------------------------
//  Gate 7: "HUD peak 248 of 250 in every long run.  Two triangles of headroom.
//  Nobody flagged it; it will break."  Two things had to be established before
//  a cap could honestly be moved, and both are measured here rather than
//  asserted:
//
//  1. WHAT THE FAILURE MODE ACTUALLY IS.  It is NOT a dropped triangle.
//     `batch_reserve` refuses at the LAYER's `g_CAP_HUD` = 512, and stage 24's
//     `g_HUD_TRI_CAP` is a CONTENT budget far below it — overrunning it prints
//     one `eprint` and fails `--selftest`, and drops nothing.  What actually
//     happens first is worse and quieter: `hud_build` hands every optional line
//     `clampi(cap - used, 0, N)` as its TEXT budget, and `font_text_shadowed`
//     TRUNCATES at its budget.  A saturated HUD SHORTENS WORDS.  The hour
//     session's 248 is `g_HUD_TRI_CAP - 6` = 244 plus the four fixed triangles
//     emitted after the last clamped line, which means that session was
//     truncating HUD text for its whole hour and nothing counted it.
//
//  2. WHAT THE CONTENT ACTUALLY COSTS.  Every string below is measured through
//     the SHIPPING fonts with wobbleweed's own `font_tri_cost`, not counted by
//     hand: FONT_MICRO and FONT_BIG are one quad per glyph (2 triangles) and the
//     mandatory 1-px shadow (ART_BIBLE §9.8) doubles it to FOUR.  Spaces and
//     any codepoint the font does not carry cost ZERO, which is why hand counts
//     of these strings have been wrong before.
//
// ---------------------------------------------------------------------------
//  ⚠ WHAT THIS PROBE CANNOT DO, STATED PLAINLY
// ---------------------------------------------------------------------------
//  It cannot call `hud_build`.  That function lives in `src/game/main.hml`,
//  which is a PROGRAM (it calls `main()` at top level) and needs a window, so
//  nothing headless can import it — the same wall `main.hml`'s own comment
//  records about `g_TB_CARD`.  So the element table below is a SECOND
//  DESCRIPTION of `hud_build`, and a second description can drift from the code
//  it describes.  Three things bound that risk, and they are the reason this is
//  worth having rather than a comfort:
//    * the strings are the SAME LITERALS, measured through the SAME FONTS, so
//      the expensive half of the table cannot drift silently;
//    * the total is BRACKETED by numbers the GAME printed — the priced combat
//      core must be a subset of the worst frame the renderer actually produced
//      and the everything-at-once total a superset of it (§C);
//    * the LIVE check stays where it must be — at the draw site, in
//      `--selftest`'s `g_st_hud_peak <= g_HUD_TRI_CAP`.  This file guards the
//      HEADROOM; that one guards the CAP.
// ===========================================================================

import { exit } from "@stdlib/process";

import { g_HUD_TRI_CAP, g_TRIS_STEADY, g_MAX_TRIS_HUD, g_POSTFX_TRI_CAP
       } from "../src/core/config.hml";
import { g_CAP_HUD } from "../src/render/world_render.hml";
import { hudgen_build_atlas, hud_font_micro, hud_font_big } from "../src/art/hudgen.hml";
import { font_tri_cost } from "../../wobbleweed/src/font.hml";

let g_EXPECT: i32 = 17;
let g_n: i32 = 0;
let g_ok: i32 = 0;

fn ck(p_ok: bool, p_msg: string) {
    g_n = g_n + 1;
    if (p_ok) { g_ok = g_ok + 1; print(`  ok   [${g_n}] ${p_msg}`); }
    if (!p_ok) { print(`  FAIL [${g_n}] ${p_msg}`); }
}

// ---------------------------------------------------------------------------
//  THE THREE NUMBERS THE RUNNING GAME PRINTED.  Everything below is checked
//  against these rather than against itself.
// ---------------------------------------------------------------------------
//  docs/design/THE_HOUR.md §7, one wall-clock hour on DISPLAY=:0, seed 1337:
//      triangles: PEAK 1857 of 3000   HUD peak 248 of 250   viewmodel peak 122
//
//  >>> AND THE MEASUREMENT THAT MADE THAT ONE MEANINGLESS.  248 was a CLAMPED
//  >>> number, not a content number.  The same 45 s opening, same seed 1337,
//  >>> same binary except for this constant:
//  >>>     cap 250   HUD peak 248 of 250     <- pinned to cap - 6 + 4
//  >>>     cap 320   HUD peak 294 of 320
//  >>>     cap 334   HUD peak 294 of 334     <- unchanged, so 294 is the
//  >>>                                          CONTENT's number, not the cap's
//  >>> 46 triangles -- up to eleven glyphs of the game's own text -- were being
//  >>> dropped from the opening of every session that has ever run, silently,
//  >>> because the only truncation counters in the file are the unlock card's
//  >>> and the two modal panels'.
let g_PEAK_CLAMPED: i32 = 248;    // what a 250 cap let through, hour + 45 s demo
let g_PEAK_WORST: i32 = 294;      // the CONTENT's peak, measured at 320 and 334
let g_PEAK_DEMO: i32 = 228;       // 420 s --demo-ui --town 2, identical at 320 and 334
let g_CORE_PRICED: i32 = 212;     // what the table below prices the combat core at
let g_PEAK_VM: i32 = 122;         // stage 15, same run
let g_PEAK_POSTFX: i32 = 18;      // probe_hudlayer measures this from postfx_emit
let g_PEAK_FRAME: i32 = 1857;     // stage-total triangles, same run

// ===========================================================================
//  >>> AND EVERY NUMBER ABOVE THIS LINE IS A SIGHTING. <<<
// ---------------------------------------------------------------------------
//  Gate 10: "HUD peak is a sample, not a bound. Three identical
//  `--demo 75 --seed 1337` invocations gave 324, 308, 186." Reproduced on the
//  wave-11 tree: 324, 322, 308. The demo bot runs off `clock_now()` deltas, so
//  WHICH HUD ELEMENTS ARE ALIGHT ON THE SAME FRAME depends on how busy the box
//  was. 294 above is the best of a handful of such frames and it was the number
//  this file's headroom rule was being evaluated against.
//
//  `nightshade --demo-ui` (with NO `--demo`) is now a DETERMINISTIC harness. No
//  clock, no bot, no sim ticks: it forces client state and calls the REAL
//  `hud_build` -- the one in `src/game/main.hml`, which is a program and which
//  nothing headless can import, which is why this file has always been a second
//  description -- over 2048 switch masks x 5 transient bands x 3 lantern bands
//  x 6 modal modes plus the wake, 215040 states, and reports the maximum.
//
//  MEASURED, three consecutive invocations, wave 11 tree, loadavg 3.6:
//      358    358    358
//  against 324 / 322 / 308 from three invocations of the sampler.
//
//  358 is a BOUND over a SUPERSET of what a session can reach -- the state that
//  produces it is the wake frame with a full lantern-kit pack and eight owned
//  guns, which the opening does not hand you. That is the right kind of number
//  for a cap to hold: every state in it is one `hud_build` can be ASKED to draw.
let g_PEAK_DET: i32 = 358;        // --demo-ui, the bound over 215040 states
let g_PEAK_DET_CTL: i32 = 354;    // ...the worst with the player in control
let g_PEAK_DET_SAMPLE: i32 = 324; // the best a wall-clock demo ever sighted
// The two modal panels, SWEPT (every villager x every row count x every cursor
// row x every panel message) rather than sighted. The 212 / 208 this file
// carried came from a 420 s `--demo-ui --town 2` run whose robot never opened
// the widest of either -- it presses a fixed key schedule at one villager.
let g_PANEL_CHAR: i32 = 252;
let g_PANEL_TRADE: i32 = 236;
let g_PANEL_CHAR_SEEN: i32 = 212; // what that robot actually saw
let g_PANEL_TRADE_SEEN: i32 = 208;

// THE HEADROOM RULE, stated as a rule so it survives the next change: the cap
// must clear the worst measured CONTENT peak by at least this much.
//
// 36 is derived, not chosen.  The thing that overflows a HUD is an element with
// NO `used + N <= cap` gate, landing after the clamped text has already eaten
// the budget; the largest such element in `hud_build` today is the owned-weapon
// pip strip, a contrast plate plus eight 2-triangle marks = 18 triangles.  The
// rule is TWO of those, so one more element of the biggest ungated kind already
// in the file can be added and a second one still fits before anyone has to
// think about it again.
let g_UNGATED_MAX: i32 = 18;      // the owned-weapon pip strip: 2 + 8 x 2
let g_HEADROOM_MIN: i32 = 36;     // 2 x g_UNGATED_MAX

// And the CEILING, which is not a taste number either.  LAYER_HUD is 512
// triangles (`g_CAP_HUD`) and three emitters share it.  Two of them are not
// stage 24's: the vignette, which config caps at `g_POSTFX_TRI_CAP`, and the
// viewmodel, whose measured peak is 122 triangles of `MESH_LANTERN_VM`.  128 is
// that peak rounded up to the next multiple of 16, and it is the reserve stage
// 24 must leave behind.  So the content cap can never honestly exceed
//     g_CAP_HUD - g_POSTFX_TRI_CAP - g_VM_RESERVE
// and the assertion below is the ceiling that number implies.
let g_VM_RESERVE: i32 = 128;

// FONT_MICRO / FONT_BIG are one quad a glyph and the 1-px UI_BLACK shadow
// (ART_BIBLE §9.8) doubles it.  `font_tri_cost` returns the unshadowed cost.
fn cost_micro(p_s: string): i32 {
    let out: i32 = font_tri_cost(hud_font_micro(), p_s) * 2;
    return out;
}
fn cost_big(p_s: string): i32 {
    let out: i32 = font_tri_cost(hud_font_big(), p_s) * 2;
    return out;
}
// A line as `hud_build` actually spends it: the string's real cost, capped by
// the budget the draw site passes.  This is the only honest way to price a line
// that `font_text_shadowed` may truncate.
fn line(p_want: i32, p_budget: i32): i32 {
    let out: i32 = p_want;
    if (out > p_budget) { out = p_budget; }
    return out;
}

let g_trunc_names: array<string> = [];
fn line_trunc(p_name: string, p_want: i32, p_budget: i32): i32 {
    if (p_want > p_budget) { g_trunc_names.push(`${p_name} (${p_want} > ${p_budget})`); }
    let out: i32 = line(p_want, p_budget);
    return out;
}

fn main() {
    print("probe_hud — the HUD's triangle budget, worst case, and its headroom");
    print("");

    let atlas = hudgen_build_atlas();
    ck(atlas != null,
       `the shipping HUD atlas and both fonts built headless, so every string below is priced through the REAL FONT_MICRO / FONT_BIG`);

    // =====================================================================
    //  A.  THE GLYPH PRICE, VERIFIED RATHER THAN ASSUMED
    // =====================================================================
    print("");
    print("A. what a glyph costs, measured through the shipping fonts");
    let c_hp: i32 = cost_micro("100");
    let c_sp: i32 = cost_micro("A B");           // the space must be free
    let c_ab: i32 = cost_micro("AB");
    print(`   FONT_MICRO "100"  = ${c_hp} triangles   (3 glyphs x 2 quads-with-shadow)`);
    print(`   FONT_MICRO "AB"   = ${c_ab}   "A B" = ${c_sp}   -> a space costs ${c_sp - c_ab}`);
    ck(c_hp == 12 && c_ab == 8,
       `a drawable FONT_MICRO glyph is 4 triangles once the mandatory 1-px shadow is counted: "100" = ${c_hp}, "AB" = ${c_ab}`);
    ck(c_sp == c_ab,
       `a space is free, which is why hand counts of these strings have been wrong: "A B" ${c_sp} == "AB" ${c_ab}`);

    // ---- AND THE ONE THIS MEASUREMENT WALKED INTO ------------------------
    // FONT_BIG has TWELVE glyphs: `hud_big_cp` in src/art/hudgen.hml returns
    // '0'..'9', '/' and '%', and `HUD_BIG_N` is 12.  IT HAS NO LETTERS.  Every
    // `hud_text_big` / `hud_centre_big` call in `hud_build` with a word in it
    // therefore draws only the digits it happens to contain:
    //     hud_centre_big(g_Y_BANNER, client_banner(...))  "WAVE 1"  -> "1"
    //     hud_centre_big(g_Y_LEVEL,  "LEVEL n")           -> the numeral only
    //     hud_centre_big(cy-10,      "THE DARK TOOK YOU") -> NOTHING AT ALL
    // and the centring divides by the WHOLE string's length, so the surviving
    // digit is not even in the middle.  The ammo counter, "6 / 12", is the one
    // FONT_BIG string in the game that is all digits and a slash -- which is
    // exactly why nobody has caught this: the element FONT_BIG was built for
    // still works perfectly.
    //
    // REPORTED, NOT FIXED.  `src/art/hudgen.hml` and `hud_build`'s draw sites
    // are not this task's files.  This assertion is the tripwire: it goes RED
    // the day somebody adds letters to FONT_BIG, and whoever sees it red will
    // read this note and go and delete the yield gates that are sized against a
    // banner costing nothing.
    let c_death: i32 = cost_big("THE DARK TOOK YOU");
    let c_banner: i32 = cost_big("WAVE CLEARED");
    let c_lvl: i32 = cost_big("LEVEL 5");
    let c_ammo: i32 = cost_big("6 / 12");
    print(`   FONT_BIG "THE DARK TOOK YOU" = ${c_death}   "WAVE CLEARED" = ${c_banner}   "LEVEL 5" = ${c_lvl}   "6 / 12" = ${c_ammo}`);
    ck(c_death == 0 && c_banner == 0 && c_lvl == 4 && c_ammo == 16,
       `FONT_BIG carries only 0-9, / and % (HUD_BIG_N = 12), so the death line draws ${c_death} triangles, the wave banner ${c_banner}, and LEVEL n only its numeral. REPORTED, not fixed -- and if this ever goes RED, the yield budgets below are sized against banners that cost nothing`);

    // =====================================================================
    //  B.  THE ELEMENT TABLE — src/game/main.hml's `hud_build`, priced
    // ---------------------------------------------------------------------
    //  Fixed quads are 2 triangles each (`hud_rect` / `hud_sprite`).  Text is
    //  priced above.  The GROUPS are the ones `hud_build`'s own comments draw:
    //  what is emitted unconditionally, what is in the player's hands, what the
    //  hit-feedback contract owes (CLAUDE.md §9), and what is allowed to yield.
    // =====================================================================
    print("");
    print("B. the element table, priced through those fonts");
    // ⚠ AND IT IS NO LONGER THE AUTHORITY, AND SAYS SO RATHER THAN QUIETLY
    // ROTTING. `nightshade --demo-ui` calls the REAL `hud_build` now, so the
    // number this section exists to approximate is measured directly. What the
    // table is still FOR is the bracket in section C -- a subset and a superset
    // that go red if it drifts from `hud_build` in either direction.
    //
    // KNOWN MISSING, STATED SO THE SUPERSET CLAIM IS NOT MISTAKEN FOR
    // COMPLETENESS: the lantern-kit pack row (2 + 6 x 2 = 14, and it was
    // missing before this wave too), and wave 11's four additions -- the
    // compass KEEP-TURNING chevron pair, the SIGHTED lantern band, the
    // `F1 CONTROLS` hint and the elevation-graded damage bands. `worst_all` is
    // ~2.7x the cap so the superset assertion still holds with room; the honest
    // reading is that the table UNDER-prices, which is the safe direction for a
    // superset and the wrong one for a subset -- and the subset it prices,
    // ${g_CORE_PRICED}, is pinned by its own assertion below.

    // ---- mandatory: emitted on every combat frame, no gate ---------------
    let e_xh: i32 = 5 * 2;                                   // 4 arms + the dot
    let e_compass: i32 = 2 + 2 * 2 + 2;                      // plate, <=2 ticks, chevron
    let e_health: i32 = 2 + 2 + line(cost_micro("100"), 28); // plate, bar, numeral (g_TB_HP)
    let e_ammo: i32 = 2 + line(cost_big("30 / 120"), 40);    // plate, FONT_BIG (g_TB_AMMO)
    let e_xp: i32 = 2 + 2;
    let g_mand: i32 = e_xh + e_compass + e_health + e_ammo + e_xp;
    print(`   crosshair ${e_xh}  compass ${e_compass}  health ${e_health}  ammo ${e_ammo}  XP ${e_xp}`);
    print(`   MANDATORY                                        ${g_mand}`);

    // ---- the hands: what the player is carrying --------------------------
    let e_diamond: i32 = 2;                                  // objective OR home
    let e_wname: i32 = line(cost_micro("BLKTHRN"), 28);
    let e_pips: i32 = 2 + 8 * 2;                             // plate + 8 owned slots
    let e_oil: i32 = 2 + 2 + 2 + line(cost_micro("EMBERLANCE"), 48) + 2;
    let g_hands: i32 = e_diamond + e_wname + e_pips + e_oil;
    print(`   diamond ${e_diamond}  weapon name ${e_wname}  owned pips ${e_pips}  oil block ${e_oil}`);
    print(`   THE HANDS                                        ${g_hands}`);

    // ---- the hit-feedback contract + the two bars ------------------------
    let e_hit: i32 = 2;
    let e_vig: i32 = 2 + 2 + 2;                              // two bands + the arc
    let e_reload: i32 = 2 + 2 + line(cost_micro("RELOADING"), 40);
    let e_chan: i32 = 2 + 2;
    let g_fb: i32 = e_hit + e_vig + e_reload + e_chan;
    print(`   hitmarker ${e_hit}  damage vignette ${e_vig}  reload ${e_reload}  channel ${e_chan}`);
    print(`   FEEDBACK                                         ${g_fb}`);

    let g_never_yield: i32 = g_mand + g_hands + g_fb;
    print(`   ------------------------------------------------------`);
    print(`   THE SET THAT MAY NEVER YIELD, minus prompts       ${g_never_yield}`);

    // ---- the prompts.  Two of them, and only one can be near you --------
    let p1: i32 = line_trunc("HOLD [E] line 1", cost_micro("HOLD [E] - LIGHT THE LANTERN"), 108);
    let p2: i32 = line_trunc("HOLD [E] line 2", cost_micro("IT'S GOING TO GET THEIR ATTENTION"), 108);
    let e_prompt: i32 = 2 + p1 + p2 + 2 + 2;                 // plate, 2 lines, charge bar
    let t1: i32 = line_trunc("[E] MABEL", cost_micro("[E] MABEL"), 48);
    let t2: i32 = line_trunc("[T] TRADE", cost_micro("[T] TRADE"), 36);
    let e_talk: i32 = 2 + t1 + t2 + 2;                       // plate, 2 lines, new-line mark
    // The longest line `client_talk_line` can return, apostrophe-free because
    // FONT_MICRO has no apostrophe either (`hud_micro_cp`, 50 glyphs).
    let e_line: i32 = 2 + line_trunc("speech", cost_micro("THE NORTHEAST ROAD IS DARK."), 96);
    print(`   interact prompt ${e_prompt}   villager prompt ${e_talk}   their line ${e_line}`);

    // ---- the celebratory block, which is GATED and may yield -------------
    let e_ring: i32 = 2;
    let e_level: i32 = line(cost_big("LEVEL 5"), 60);
    let e_card: i32 = 2 + line(cost_micro("UNLOCKED"), 36)
                    + line_trunc("unlock card name", cost_micro("TINKER SMG - AT THE BENCH"), 80);
    let e_banner: i32 = line(cost_big("WAVE CLEARED"), 88);
    let e_toast: i32 = line(cost_micro("THE DARK IS COMING BACK"), 60);
    let e_wave: i32 = line(cost_micro("WAVE 3  x14"), 44);
    print(`   ring flash ${e_ring}  LEVEL n ${e_level}  unlock card ${e_card}  banner ${e_banner}  toast ${e_toast}  wave ${e_wave}`);

    // The simultaneous sets, computed here so section C can bracket the game's
    // measured peak between the smallest and the largest of them.
    let worst_post: i32 = g_never_yield + e_prompt;
    let worst_town: i32 = g_never_yield + e_talk + e_line;
    let worst_030: i32 = g_never_yield + e_ring + e_card + e_level;
    let worst_all: i32 = g_never_yield + e_prompt + e_talk + e_line
                       + e_ring + e_card + e_level + e_banner + e_toast + e_wave;

    // =====================================================================
    //  C.  THE TABLE REPRODUCES A NUMBER THE GAME PRINTED
    // ---------------------------------------------------------------------
    //  This is what stops the table from being a story.  The 420 s
    //  `--demo-ui --town 2` run peaked at 212 and it peaked there in COMBAT,
    //  not in a panel (the panels measured 212 and 208 and are modal, so they
    //  cannot stack on it).  Mandatory + hands + feedback is the set that is on
    //  screen in that frame, and it must come out at 212 or this table is
    //  describing a HUD that does not exist.
    // =====================================================================
    print("");
    print("C. the table against the numbers the running game printed");
    print(`   mandatory ${g_mand} + hands ${g_hands} + feedback ${g_fb} = ${g_never_yield}   (priced here)`);
    print(`   the game's 420 s --demo-ui --town 2 peak            = ${g_PEAK_DEMO}`);
    print(`   the game's 45 s opening peak, untruncated           = ${g_PEAK_WORST}`);
    // ⚠ AN EARLIER VERSION OF THIS ASSERTED `g_never_yield == 212` AND CALLED IT
    // A VALIDATION.  It was a COINCIDENCE and it is written down rather than
    // deleted: 212 was the peak the game printed AT A CAP OF 250, i.e. a
    // TRUNCATED number, and the same run at 320 prints 228.  Matching a clamped
    // measurement with an unclamped table means nothing at all.  What the table
    // can honestly claim is a BRACKET: the combat core it prices is a SUBSET of
    // any real frame, and the everything-at-once total is a SUPERSET of one.
    print(`   the DETERMINISTIC bound, --demo-ui, 215040 states       = ${g_PEAK_DET}`);
    ck(g_never_yield <= g_PEAK_DET,
       `the priced combat core, ${g_never_yield}, is a subset of the worst frame hud_build can emit, ${g_PEAK_DET} -- if it ever exceeds it, the table has grown elements hud_build does not have`);
    ck(worst_all >= g_PEAK_DET,
       `and the priced everything-at-once total is a superset of it -- if it ever falls below, the table has LOST an element hud_build does have`);
    ck(g_CORE_PRICED == g_never_yield,
       `the priced core is still ${g_CORE_PRICED}; this line exists so a change to any string or budget in the table above shows up as a number in a diff rather than as silence`);

    // =====================================================================
    //  D.  WHAT THE CONTENT WANTS, AND THEREFORE WHY THE GATES STAY
    // =====================================================================
    print("");
    print("D. the worst SIMULTANEOUS sets");
    print(`   at an unlit post, holding two guns and a spell, reloading, hurt  ${worst_post}`);
    print(`   in town, in front of a villager who is talking                   ${worst_town}`);
    print(`   the 0:30 beat: ring flash + unlock card + LEVEL n                ${worst_030}`);
    print(`   every element in the file at once (not reachable, for scale)     ${worst_all}`);
    print(`   cap ${g_HUD_TRI_CAP}`);
    ck(worst_all > g_HUD_TRI_CAP,
       `the content genuinely wants ${worst_all} triangles, so the "used + N <= cap" YIELD GATES in hud_build are load-bearing and must stay; a bigger cap is not a substitute for them`);
    print(`   NOT COVERED AND IT CANNOT BE: the post frame (${worst_post}) is bigger than the`);
    print(`   ${g_CAP_HUD - g_POSTFX_TRI_CAP - g_VM_RESERVE} triangles LAYER_HUD has left for stage 24 after the vignette and the`);
    print(`   viewmodel. No value of g_HUD_TRI_CAP fixes that -- it wants a bigger`);
    print(`   g_CAP_HUD or a shorter prompt, and neither file is this task's.`);
    ck(worst_post > g_CAP_HUD - g_POSTFX_TRI_CAP - g_VM_RESERVE,
       `stated rather than hidden: the must-never-yield set WITH the lantern prompt is ${worst_post} and stage 24 can physically hold ${g_CAP_HUD - g_POSTFX_TRI_CAP - g_VM_RESERVE}. This assertion is written to be TRUE today so the gap is on the record; it goes red only when somebody actually fixes it, and that is the right day to re-read this file`);

    // =====================================================================
    //  E.  THE HEADROOM ASSERTION.  This is the one this task exists for.
    // =====================================================================
    print("");
    print("E. headroom, against a BOUND instead of a sighting");
    let head: i32 = g_HUD_TRI_CAP - g_PEAK_DET;
    print(`   the sightings this file used to reason from:`);
    print(`     worst CONTENT frame, 45 s opening, cap raised    ${g_PEAK_WORST}`);
    print(`     what a 250 cap let through instead               ${g_PEAK_CLAMPED}  -> ${g_PEAK_WORST - g_PEAK_CLAMPED} triangles of text dropped`);
    print(`     the best a wall-clock --demo ever sighted        ${g_PEAK_DET_SAMPLE}   (the other two runs: 322, 308)`);
    print(`   THE BOUND, --demo-ui, 215040 enumerated states     ${g_PEAK_DET}   (${g_PEAK_DET_CTL} with the player in control)`);
    print(`   cap                                                ${g_HUD_TRI_CAP}`);
    print(`   headroom                                           ${head}   (rule: >= ${g_HEADROOM_MIN})`);
    // ---- THE TRUNCATION SIDE. -------------------------------------------
    // This is the assertion that goes RED if anybody lowers the cap: at 250 the
    // HUD's worst frame is 108 triangles -- twenty-seven glyphs of the game's
    // own text -- short of what hud_build was measured emitting.
    ck(g_HUD_TRI_CAP >= g_PEAK_DET,
       `the cap ${g_HUD_TRI_CAP} is at least the ${g_PEAK_DET} triangles hud_build was MEASURED emitting in its worst enumerated state. Lower it and the difference is not a saving, it is glyphs: font_text_shadowed truncates at its budget and only the unlock card and the two panels count it`);
    // ---- AND THE GAP, ON THE RECORD, IN THE IDIOM THIS FILE ALREADY USES.
    // Section D's assertion is written to be TRUE today so a known shortfall is
    // a red line in a report rather than a comment nobody reads. This is the
    // same: the headroom rule wants 36 and the bound leaves 2, and NOTHING IN
    // THIS TASK'S FILES CAN FIX IT -- F derives the ceiling as
    // g_CAP_HUD - g_POSTFX_TRI_CAP - g_VM_RESERVE and the cap is already ON it,
    // so the next element needs g_CAP_HUD raised in src/render/world_render.hml.
    // It goes red the day somebody does, and that is the right day to re-read
    // this file.
    ck(head < g_HEADROOM_MIN,
       `>>> REPORTED, NOT FIXED: the HUD has ${head} triangles of headroom against a ${g_HEADROOM_MIN} rule (2 x the ${g_UNGATED_MAX}-triangle pip strip, the largest UNGATED element in hud_build). Gate 7 flagged exactly this shape -- "248 of 250, two triangles, nobody flagged it; it will break" -- and it is back, at 358 of 360, because three elements landed this wave against a peak nobody could reproduce. The cap is ON its derived ceiling (F), so the fix is g_CAP_HUD in world_render.hml, not this number. This assertion is TRUE today so the gap is a red line in a report; it goes RED when it is fixed <<<`);
    ck(g_HUD_TRI_CAP - g_PANEL_CHAR >= g_HEADROOM_MIN
       && g_HUD_TRI_CAP - g_PANEL_TRADE >= g_HEADROOM_MIN,
       `both MODAL panels clear the rule with room: character ${g_PANEL_CHAR} (+${g_HUD_TRI_CAP - g_PANEL_CHAR}), trade ${g_PANEL_TRADE} (+${g_HUD_TRI_CAP - g_PANEL_TRADE}). Both are SWEPT -- every villager, every row count, every cursor row, every panel message -- where the numbers this file used to carry (${g_PANEL_CHAR_SEEN} / ${g_PANEL_TRADE_SEEN}) were what one robot on one key schedule happened to open. They are modal and replace the combat HUD, so they are budgeted separately and never stack on it`);

    // =====================================================================
    //  F.  THE PHYSICAL WALL — the only place a triangle is actually DROPPED
    // ---------------------------------------------------------------------
    //  LAYER_HUD carries three emitters: stage 23's vignette, stage 15's
    //  viewmodel and stage 24's HUD.  `g_HUD_TRI_CAP` polices only the third.
    //  `batch_reserve` returns -1 and drops at `g_CAP_HUD`, and NOTHING between
    //  here and there notices.
    // =====================================================================
    print("");
    print("F. the layer, which is where a triangle would actually be dropped");
    let layer: i32 = g_PEAK_POSTFX + g_PEAK_VM + g_HUD_TRI_CAP;
    print(`   postfx ${g_PEAK_POSTFX} + viewmodel ${g_PEAK_VM} + a FULL stage-24 HUD ${g_HUD_TRI_CAP} = ${layer} of g_CAP_HUD ${g_CAP_HUD}`);
    print(`   -> ${g_CAP_HUD - layer} triangles of physical margin`);
    ck(layer <= g_CAP_HUD,
       `even a COMPLETELY full HUD leaves LAYER_HUD inside its ${g_CAP_HUD} capacity: ${layer}, ${g_CAP_HUD - layer} spare. Raising the content cap past ${g_CAP_HUD - g_PEAK_POSTFX - g_PEAK_VM} would put the drop back on the table`);
    // THE CEILING, DERIVED.  This is the assertion that makes the cap a
    // consequence rather than a preference: it goes RED the moment somebody
    // raises g_HUD_TRI_CAP past what the layer can carry with the vignette's own
    // cap and a rounded-up viewmodel reserve honoured.
    let ceil: i32 = g_CAP_HUD - g_POSTFX_TRI_CAP - g_VM_RESERVE;
    print(`   derived ceiling: ${g_CAP_HUD} - postfx cap ${g_POSTFX_TRI_CAP} - viewmodel reserve ${g_VM_RESERVE} = ${ceil}`);
    ck(g_HUD_TRI_CAP <= ceil,
       `the cap is BOUNDED BY THE LAYER, not chosen: ${g_HUD_TRI_CAP} <= ${g_CAP_HUD} - ${g_POSTFX_TRI_CAP} - ${g_VM_RESERVE} = ${ceil}. >>> AND THE FLOOR HAS OVERTAKEN IT. <<< Gate 10 quoted the legal range as ${g_PEAK_WORST + g_HEADROOM_MIN}..${ceil}, "thirty-one triangles wide", off a SIGHTED peak of ${g_PEAK_WORST}. Against the ${g_PEAK_DET} the deterministic harness measures, the floor is ${g_PEAK_DET + g_HEADROOM_MIN} and the ceiling is ${ceil}: THE LEGAL RANGE IS EMPTY, by ${g_PEAK_DET + g_HEADROOM_MIN - ceil} triangles. The cap is not "about to break" and it is not merely FULL -- it is already past the headroom rule, and the next element needs g_CAP_HUD raised in world_render.hml`);
    // The dead constant, named so nobody plans against it.
    ck(g_MAX_TRIS_HUD != g_CAP_HUD,
       `REPORTED, not fixed: config's g_MAX_TRIS_HUD is ${g_MAX_TRIS_HUD} and world_render builds the batch at its own literal ${g_CAP_HUD}. The config value is read by nothing; a plan made against it is ${g_MAX_TRIS_HUD - g_CAP_HUD} triangles wrong`);

    // =====================================================================
    //  G.  THE FRAME BUDGET
    // =====================================================================
    print("");
    print("G. the frame budget");
    let grew: i32 = g_HUD_TRI_CAP - 250;
    print(`   the cap grew by ${grew}; the frame peak was ${g_PEAK_FRAME} of ${g_TRIS_STEADY}`);
    ck(g_PEAK_FRAME + grew <= g_TRIS_STEADY,
       `worst case the raise costs ${grew} triangles: ${g_PEAK_FRAME} + ${grew} = ${g_PEAK_FRAME + grew} of the ${g_TRIS_STEADY}-triangle steady budget`);

    // =====================================================================
    //  H.  THE TRUNCATIONS THE TABLE FOUND ON THE WAY PAST
    // ---------------------------------------------------------------------
    //  `0 truncated strings (MUST be 0)` in the game's report counts the two
    //  MODAL PANELS only (`g_panel_trunc`), and `g_hud_card_trunc` counts the
    //  unlock card.  Nothing counts the prompts or the speech line.  If a string
    //  costs more than the budget its draw site passes, it is short EVERY TIME
    //  it is drawn, on an idle frame, with no counter anywhere.
    // =====================================================================
    print("");
    print("H. strings that cost more than their own budget");
    let nt: i32 = g_trunc_names.length;
    if (nt == 0) { print("   none"); }
    for (let i = 0; i < nt; i++) { print(`   ${g_trunc_names[i]}`); }
    ck(nt == 0,
       `no HUD string costs more than the budget its draw site hands it (${nt} do). A string over its budget is not a full HUD -- it is a half-sentence, on every frame, uncounted`);

    print("");
    if (g_n != g_EXPECT) {
        print(`FAIL: ran ${g_n} assertions, expected ${g_EXPECT}`);
        exit(1);
    }
    if (g_ok != g_n) {
        print(`FAIL ${g_ok} / ${g_n}`);
        exit(1);
    }
    print(`PASS ${g_ok} / ${g_n}`);
    exit(0);
}

main();
