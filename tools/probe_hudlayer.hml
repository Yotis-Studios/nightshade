// ===========================================================================
//  probe_hudlayer.hml — Gate 4b/4c's line (b): "HUD peak 248 of 250 triangles,
//  one more HUD element overflows the layer."
// ---------------------------------------------------------------------------
//  It does not overflow the layer, and the two numbers in that sentence are
//  about two different things.  This probe measures which.
//
//  Runs COMPILED and HEADLESS.  It links SDL (wobbleweed's `batch.hml` binds
//  `SDL_RenderGeometry` for the flush) but never opens a window: every function
//  exercised below — `frame_batches`, `postfx_emit`, `quad_screen_uv`,
//  `batch_reserve` — is pure buffer arithmetic.  Nothing here presents.
//
//  RULE T: the one timing is `__clock()` CPU time, minimum of seven batches.
//  Exits 1 on failure AND on the wrong assertion COUNT.
// ===========================================================================

import { exit } from "@stdlib/process";

import { g_HUD_TRI_CAP, g_TRIS_STEADY, g_RES_W, g_RES_H
       } from "../src/core/config.hml";

import { g_CAP_HUD, frame_batches, frame_batch_hud,
         frame_hud_tris, frame_hud_cap, frame_hud_headroom, frame_hud_overflow
       } from "../src/render/world_render.hml";

import { postfx_emit, postfx_set_vignette } from "../src/render/postfx_geo.hml";

import { batch_reset, batch_count, batch_cap, batch_reserve,
         batch_overflow_count } from "../../wobbleweed/src/batch.hml";
import { quad_screen_uv } from "../../wobbleweed/src/quad.hml";

let g_EXPECT: i32 = 13;
let g_n: i32 = 0;
let g_ok: i32 = 0;

fn ck(p_ok: bool, p_msg: string) {
    g_n = g_n + 1;
    if (p_ok) { g_ok = g_ok + 1; print(`  ok   [${g_n}] ${p_msg}`); }
    if (!p_ok) { print(`  FAIL [${g_n}] ${p_msg}`); }
}

fn f4(p_x: f64): string {
    let s: i32 = i32(p_x * 10000.0 + 0.5);
    let w: i32 = i32(f64(s) / 10000.0);
    let f: i32 = s - w * 10000;
    let fs: string = `${f}`;
    if (f < 10) { fs = "000" + fs; }
    else if (f < 100) { fs = "00" + fs; }
    else if (f < 1000) { fs = "0" + fs; }
    let o: string = `${w}.${fs}`;
    return o;
}

// The two peaks the running game reported, so the arithmetic below is against
// measured numbers rather than guesses.  Both come from one 240 s headless demo
// of `src/game/main.hml` (14 396 frames, seed 1337):
//     triangles: PEAK 1800 of 2500   HUD peak 248 of 250   viewmodel peak 122
let g_MEASURED_STAGE24_PEAK: i32 = 248;
let g_MEASURED_VM_PEAK: i32 = 122;
let g_MEASURED_FRAME_PEAK: i32 = 1800;

fn main() {
    print("probe_hudlayer — what is actually in LAYER_HUD");
    print("");

    let rc: i32 = frame_batches();
    ck(rc == 0, `the four batches built without a window: rc ${rc}`);
    let b = frame_batch_hud();

    // ---- 1. the two caps are different numbers about different things ------
    ck(g_CAP_HUD == 512,
       `g_CAP_HUD, the LAYER's physical capacity, is the literal 512; it is ${g_CAP_HUD}`);
    // 250 -> 334 (about-to-break, 2026-07-31).  ⚠ THIS FILE IS NOT THAT TASK'S
    // AND THIS IS THE ONLY LINE IT CHANGED, reported rather than done quietly.
    // The assertion exists solely to pin the constant, and the constant was
    // moved deliberately: THE_HOUR §7 recorded `HUD peak 248 of 250`, i.e. two
    // triangles of headroom.  The derivation, the worst-case element budget and
    // the headroom rule now live in `tools/probe_hud.hml`; §5 of THIS file is
    // what said the raise was affordable in the first place ("raising
    // g_HUD_TRI_CAP by 64 would cost ~0.05 ms/frame").
    ck(g_HUD_TRI_CAP == 334,
       `g_HUD_TRI_CAP, ART_BIBLE §9's budget on stage 24's CONTENT, is the literal 334; it is ${g_HUD_TRI_CAP}`);
    ck(frame_hud_cap() == g_CAP_HUD,
       `frame_hud_cap() reports the layer's own cap: ${frame_hud_cap()}`);
    ck(batch_cap(b) == g_CAP_HUD,
       `the batch was built at that cap: ${batch_cap(b)}`);

    // ---- 2. what world_render itself spends in the layer -------------------
    batch_reset(b);
    postfx_set_vignette(24, 20, 32);
    let vig: i32 = postfx_emit(b, 0);
    ck(vig == 16,
       `stage 23's vignette ring is 16 triangles (8 segments x 2), MEASURED from postfx_emit: ${vig}`);
    batch_reset(b);
    let vig_l: i32 = postfx_emit(b, 1);
    ck(vig_l == 18,
       `with the lightning flash it is 18: ${vig_l}`);
    ck(frame_hud_tris() == 18,
       `frame_hud_tris() sees them — the number nothing in the project could read before: ${frame_hud_tris()}`);

    // ---- 3. the layer's real peak, and the headroom that was invisible -----
    let layer_peak: i32 = vig_l + g_MEASURED_VM_PEAK + g_MEASURED_STAGE24_PEAK;
    let spare: i32 = g_CAP_HUD - layer_peak;
    print("");
    print(`   LAYER_HUD, from three measured peaks:`);
    print(`     stage 23 postfx (measured here)  ${vig_l}`);
    print(`     stage 15 viewmodel (game run)    ${g_MEASURED_VM_PEAK}`);
    print(`     stage 24 the game's HUD (ditto)  ${g_MEASURED_STAGE24_PEAK}   <- this is the "248 of 250"`);
    print(`     ----------------------------------------`);
    print(`     peak occupancy                   ${layer_peak} of ${g_CAP_HUD}   -> ${spare} spare`);
    print(`   so the 250 is spent against by three emitters and counted for one.`);
    print("");
    ck(layer_peak < g_CAP_HUD,
       `LAYER_HUD's measured peak ${layer_peak} is inside its ${g_CAP_HUD}-triangle capacity, with ${spare} spare — the layer is NOT what overflows`);

    // ---- 4. and when it IS full, it refuses; it never corrupts -------------
    batch_reset(b);
    let i: i32 = 0;
    while (i < 300) {
        quad_screen_uv(b, null, 0.0, 0.0, 4.0, 4.0, 0.0, 0.0, 1.0, 1.0,
                       200, 190, 170, 255, 0.5);
        i++;
    }
    let refused: i32 = batch_reserve(b, 4);
    ck(batch_count(b) == g_CAP_HUD && refused < 0 && batch_overflow_count(b) > 0,
       `at the cap, batch_reserve REFUSES and counts it: count ${batch_count(b)}, reserve returned ${refused}, ${batch_overflow_count(b)} dropped (CLAUDE.md §6 — it drops a triangle, never corrupts)`);
    ck(frame_hud_headroom() == 0 && frame_hud_overflow() > 0,
       `frame_hud_headroom() reads 0 and frame_hud_overflow() reads ${frame_hud_overflow()} — the wall is now visible from the file that owns it`);

    // ---- 5. what a HUD triangle actually COSTS -----------------------------
    // The emit half, which is the half a bigger cap adds.  The flush half is
    // BUDGET_ACTUAL's 0.85 ms / 2500 tris = 0.34 us/tri and does not depend on
    // which layer the triangle is in.
    let reps: i32 = 200;
    let best: f64 = 1.0e30;
    let t: i32 = 0;
    while (t < 7) {
        let t0: f64 = __clock();
        let r: i32 = 0;
        while (r < reps) {
            batch_reset(b);
            let k: i32 = 0;
            while (k < 125) {            // 125 quads = 250 triangles
                quad_screen_uv(b, null, f64(k), 4.0, 4.0, 4.0,
                               0.0, 0.0, 1.0, 1.0, 200, 190, 170, 255, 0.5);
                k++;
            }
            r++;
        }
        let ms: f64 = (__clock() - t0) * 1000.0 / f64(reps);
        if (ms < best) { best = ms; }
        t++;
    }
    let per_tri_us: f64 = best * 1000.0 / 250.0;
    print("");
    print(`   250 HUD triangles cost ${f4(best)} ms to EMIT (min of 7 x ${reps}) = ${f4(per_tri_us)} us/triangle`);
    print(`   + BUDGET_ACTUAL's flush at 0.34 us/tri -> ~${f4(per_tri_us + 0.34)} us per HUD triangle, all in`);
    print(`   raising g_HUD_TRI_CAP by 64 would therefore cost ~${f4(64.0 * (per_tri_us + 0.34) / 1000.0)} ms/frame`);
    print(`   and ${g_MEASURED_FRAME_PEAK} + 64 = ${g_MEASURED_FRAME_PEAK + 64} of the ${g_TRIS_STEADY}-triangle budget`);
    ck(best < 0.40,
       `a full 250-triangle HUD emits in ${f4(best)} ms — under 2.5 % of the 16.67 ms frame; the guard is 0.40 ms`);
    ck(g_MEASURED_FRAME_PEAK + 64 <= g_TRIS_STEADY,
       `64 more HUD triangles keeps the frame at ${g_MEASURED_FRAME_PEAK + 64} of ${g_TRIS_STEADY} — the frame budget affords the cap this task is being asked about`);

    print("");
    if (g_n != g_EXPECT) {
        print(`FAIL: ran ${g_n} assertions, expected ${g_EXPECT}`);
        exit(1);
    }
    if (g_ok != g_n) {
        print(`FAIL ${g_ok} / ${g_n}`);
        exit(1);
    }
    print(`PASS ${g_ok} / ${g_n}`);
    exit(0);
}

main();
