// probe_mathx.hml — verification program for W2-2:
//   src/core/config.hml   every tunable constant
//   src/core/mathx.hml    scalar helpers + the noise stack
//
// Run COMPILED (hemlockc is ground truth) AND interpreted — the hash parity
// criterion is only meaningful if both backends run the same checksum:
//
//     hemlockc -O1 tools/probe_mathx.hml -o /tmp/probe_mathx && /tmp/probe_mathx
//     hemlock  tools/probe_mathx.hml
//
// It needs no display and links no SDL.
//
// Exits 0 only if every assertion held AND the number of assertions executed
// equals g_EXPECTED_ASSERTS — a probe that silently skips a section must FAIL,
// not pass.  Exits 1 otherwise.
//
// The three W2-2 acceptance criteria are tagged where they are checked:
//   [A1] xhash2 produces identical values interpreted and compiled over 1 M
//        inputs, and never throws                                -> §3
//   [A2] vnoise tiles seamlessly when the period divides the tile size,
//        verified by comparing edge columns                      -> §5
//   [A3] the inlined clamp is measured faster than @stdlib's clamp -> §7
//
// TIMING METHOD (CLAUDE.md §1.2 / BUDGET_ACTUAL.md).  This box permanently
// shares ~17 of its 24 cores with a llama-server.  Every number below is
// __clock() CPU time, minimum of g_TRIALS=7 batches, and every perf ASSERTION is
// a regression guard set at ~2x the loaded measurement (or a ratio, which
// survives contention because both sides inflate together).  The idle and
// loaded numbers are both printed.  A probe that fails on machine state
// instead of code trains everyone to ignore red.

import { exit } from "@stdlib/process";
import { clamp, min, max, abs } from "@stdlib/math";
import {
    absf, minf, maxf, clampf, clamp01, lerpf, smooth01, smoothstep,
    deg2rad, rad2deg, absi, mini, maxi, clampi, floori,
    xhash2, xhash3, h01, h01_3, bayer4, bayer4i, vnoise, fbm2
} from "../src/core/mathx.hml";
import {
    g_TICK_HZ, g_TICK_MS, g_TICK_DT, g_FRAME_CLAMP_MS, g_FRAME_BUDGET_MS,
    g_HISTORY_TICKS, g_RES_W, g_RES_H, g_RES_CX, g_RES_CY, g_ASPECT,
    g_UPSCALE_MIN, g_UPSCALE_DEFAULT, g_UPSCALE_MAX,
    g_TRIS_STEADY, g_TRIS_CLAMP, g_TRIS_CEILING,
    g_MAX_TRIS_SKY, g_MAX_TRIS_WORLD, g_MAX_TRIS_FX, g_MAX_TRIS_HUD,
    g_HUD_TRI_CAP, g_NB_BUCKETS,
    g_BUDGET_RENDER_MS, g_BUDGET_SIM_MS, g_BUDGET_NET_MS, g_BUDGET_IO_MS,
    g_BUDGET_SLACK_MS, g_BUDGET_BOOT_MS,
    g_FOG_FAR_CAP, g_FOG_NEAR_MIN, g_FAR_PLANE_SCALE, g_FOG_ALPHA_T,
    g_MAX_DYNAMIC_LIGHTS, g_ENV_LIGHT_SLOTS,
    g_FOV_HIP, g_FOV_ADS, g_FOV_SPRINT, g_DEPTH_VIEWMODEL,
    g_SHADE_TIER_MAX, g_FOG_FAR_TIER0, g_FOG_FAR_TIER1, g_FOG_FAR_TIER2,
    g_FOG_FAR_TIER3, g_FOG_FAR_TIER4, g_FOG_FAR_TIER5,
    g_FOG_FAR_HOLLOWFIELD, g_FOG_FAR_ASHWOOD, g_FOG_FAR_CHALKDOWNS,
    g_FOG_FAR_FEN, g_FOG_FAR_IRONPINE, g_FOG_FAR_DEEPSHADE,
    g_CHUNK_M, g_CHUNK_QUADS, g_CHUNK_GRID_M, g_CHUNK_N,
    g_RING_RADIUS, g_RING_CHUNKS, g_LOD0_M, g_LOD1_M,
    g_LOD0_TRIS, g_LOD1_TRIS, g_LOD2_TRIS, g_STREAM_IN_M,
    g_MAX_ENTS, g_MAX_RENDER_ENTS, g_MAX_PARTICLES,
    g_HP_MAX, g_SPEED_WALK, g_SPEED_SPRINT, g_SPEED_CROUCH, g_SPEED_ADS,
    g_GRAVITY, g_JUMP_IMPULSE, g_EYE_STAND, g_HEIGHT_STAND,
    g_SLIDE_MIN_SPEED, g_SLIDE_BURST, g_SLIDEJUMP_KEEP,
    g_DIR_BUDGET_BASE, g_DIR_BUDGET_PER_TIER, g_DIR_BUDGET_PER_WAVE,
    g_DIR_ALIVE_CAP, g_DIR_ONSCREEN_CAP,
    g_DAY_MINUTES, g_DAY_SECONDS, g_DAY_TICKS,
    g_PHASE_DAWN_END, g_PHASE_DAY_END, g_PHASE_DUSK_END,
    g_XP_BASE, g_XP_LINEAR, g_XP_QUAD, g_LEVEL_SOFT_CAP,
    g_ATLAS_WORLD_PX, g_ATLAS_WORLD_CELLS, g_TILE_PX,
    g_ATLAS_FX_PX, g_FX_CELL_PX, g_ATLAS_HUD_PX, g_SKY_W, g_SKY_H,
    g_ALBEDO_LUM_MIN, g_TILE_COLORS_MAX, g_GRAIN_AMT,
    g_AUDIO_HZ, g_AUDIO_VOICES,
    g_NET_ENT_STRIDE_B, g_NET_BLOB_MAX_B, g_NET_ENTS_PER_BLOB,
    g_BUFFER_ELEM_CAP, g_CMD_FIELDS
} from "../src/core/config.hml";

// ---------------------------------------------------------------------------
// Harness
// ---------------------------------------------------------------------------
let g_EXPECTED_ASSERTS = 212;   // +8: the 16:9 frame-shape and exact-upscale pins (see the resolution block)
let g_TRIALS = 7;

// [A1] golden checksum over 1 048 576 xhash2 inputs.  Identical on both
// backends by construction (u64 wraps identically) — the probe is run BOTH
// ways and this constant is what pins them to each other.
let g_HASH_GOLDEN: u64 = 4110202624736850356;

let g_pass: i32 = 0;
let g_total: i32 = 0;
let g_sink: f64 = 0.0;

fn ok(cond: bool, label: string) {
    g_total++;
    if (cond) { g_pass++; } else { print(`  FAIL  ${label}`); }
}

fn eqi(label: string, got: i32, want: i32) {
    g_total++;
    if (got == want) { g_pass++; } else { print(`  FAIL  ${label}: got ${got} want ${want}`); }
}

fn eqf(label: string, got: f64, want: f64, tol: f64) {
    g_total++;
    let d: f64 = got - want;
    if (d < 0.0) { d = 0.0 - d; }
    if (d <= tol) { g_pass++; } else { print(`  FAIL  ${label}: got ${got} want ${want}`); }
}

// Bit-exact float equality — used for the tiling criterion, where "close" is
// not good enough: a seam of one ULP is still a seam in a hashed lattice.
fn eqexact(label: string, got: f64, want: f64) {
    g_total++;
    if (got == want) { g_pass++; } else { print(`  FAIL  ${label}: got ${got} want ${want}`); }
}

fn f3(p_x: f64): string {
    let x: f64 = p_x;
    let neg: i32 = 0;
    if (x < 0.0) { neg = 1; x = 0.0 - x; }
    let scaled: i64 = i64(x * 1000.0 + 0.5);
    let whole: i64 = scaled / 1000;
    let frac: i64 = scaled - whole * 1000;
    let fs: string = `${frac}`;
    if (frac < 100) { fs = `0${frac}`; }
    if (frac < 10) { fs = `00${frac}`; }
    let s: string = `${whole}.${fs}`;
    if (neg == 1) { s = `-${s}`; }
    return s;
}

// ===========================================================================
// §1  CONFIG — the constants that other tasks will break if they drift
// ===========================================================================
fn section_config() {
    print("");
    print("[1] config.hml — the tunables");

    // Fixed timestep.  TICK_DT is a compile-time constant; nothing measures it.
    eqi("TICK_HZ", g_TICK_HZ, 60);
    eqf("TICK_MS == 1000/60", g_TICK_MS, 16.666666666666668, 1e-12);
    eqf("TICK_DT == 1/60", g_TICK_DT, 0.016666666666666666, 1e-15);
    eqf("TICK_DT * TICK_HZ == 1 s", g_TICK_DT * f64(g_TICK_HZ), 1.0, 1e-12);
    eqf("TICK_MS == TICK_DT * 1000", g_TICK_MS, g_TICK_DT * 1000.0, 1e-12);
    ok(g_FRAME_CLAMP_MS > g_TICK_MS * 10.0, "spiral clamp leaves room for catch-up");
    eqf("frame budget is the 60 fps floor", g_FRAME_BUDGET_MS, 16.67, 0.01);
    eqi("HISTORY_TICKS", g_HISTORY_TICKS, 32);

    // Resolution.  320x180 is not negotiable and there are no options.
    // (Was 320x240 through W7; see config.hml §2 for why 16:9 and why not more
    // pixels.  These four lines are the three constants that task changed, so
    // they are re-pinned to what shipped rather than left asserting the frame
    // shape the game no longer has.)
    eqi("RES_W", g_RES_W, 320);
    eqi("RES_H", g_RES_H, 180);
    eqf("RES_CX is the screen centre", g_RES_CX, 160.0, 0.0);
    eqf("RES_CY is the screen centre", g_RES_CY, 90.0, 0.0);
    // The centre must be a pixel BOUNDARY in both axes: hudgen builds the
    // crosshair arms symmetric about it and a 1-px tick cannot straddle a
    // pixel.  Both 320 and 180 are even, so both are.
    eqi("RES_W is even, so the aim axis is a pixel boundary", g_RES_W % 2, 0);
    eqi("RES_H is even, so the aim axis is a pixel boundary", g_RES_H % 2, 0);
    // 16:9 exactly — not approximately.  320*9 == 180*16, and g_ASPECT is that
    // ratio, which is what keeps the pixels square at every upscale factor.
    eqi("the frame is 16:9 in integers", g_RES_W * 9, g_RES_H * 16);
    eqf("ASPECT is RES_W/RES_H", g_ASPECT, f64(g_RES_W) / f64(g_RES_H), 1e-15);
    ok(g_UPSCALE_MIN <= g_UPSCALE_DEFAULT && g_UPSCALE_DEFAULT <= g_UPSCALE_MAX,
       "upscale ladder is ordered");
    // THE WHOLE POINT OF 320x180: the integer ladder lands on real panels.
    // x4 is exactly 1280x720 and x6 is exactly 1920x1080, with no remainder and
    // no non-square pixel anywhere.  The old bound here was "<= 1280", which
    // was the 4:3 window budget; 1920 is the 16:9 one and it is EXACT, not a
    // fit-with-slack.
    eqi("x4 is exactly 1280 wide", g_RES_W * 4, 1280);
    eqi("x4 is exactly 720 tall", g_RES_H * 4, 720);
    eqi("x6 is exactly 1920 wide", g_RES_W * 6, 1920);
    eqi("x6 is exactly 1080 tall", g_RES_H * 6, 1080);
    ok(g_RES_W * g_UPSCALE_MAX <= 1920, "the max upscale still fits a 1920 window");

    // Triangle budget (D1).
    eqi("TRIS_STEADY", g_TRIS_STEADY, 2500);
    eqi("TRIS_CLAMP", g_TRIS_CLAMP, 3500);
    ok(g_TRIS_STEADY < g_TRIS_CLAMP, "steady < hard clamp");
    ok(g_TRIS_CLAMP <= g_TRIS_CEILING, "hard clamp <= renderer ceiling");
    eqi("WORLD pool == hard clamp", g_MAX_TRIS_WORLD, g_TRIS_CLAMP);
    ok(g_MAX_TRIS_SKY >= 4, "sky pool holds the panorama quad");
    ok(g_MAX_TRIS_HUD >= g_HUD_TRI_CAP, "HUD pool holds the HUD cap");
    eqi("HUD tri cap (ART_BIBLE 9)", g_HUD_TRI_CAP, 250);
    eqi("sort buckets", g_NB_BUCKETS, 2048);
    ok(g_MAX_TRIS_FX >= 512, "FX pool holds a full particle burst");

    // Millisecond budget: the parts must fit the whole.
    let sum_ms: f64 = g_BUDGET_RENDER_MS + g_BUDGET_SIM_MS + g_BUDGET_NET_MS
                    + g_BUDGET_IO_MS + g_BUDGET_SLACK_MS;
    ok(sum_ms <= g_FRAME_BUDGET_MS + 0.001, "render+sim+net+io+slack <= 16.67 ms");
    ok(g_BUDGET_SLACK_MS >= 1.3, "slack >= 1.3 ms");
    ok(g_BUDGET_BOOT_MS <= 400.0, "boot budget <= 400 ms");

    // >>> THE TWO CAPS THIS TASK EXISTS TO PIN <<<
    eqf("FOG_FAR_CAP == 72 m (RULE T6)", g_FOG_FAR_CAP, 72.0, 0.0);
    ok(g_FOG_FAR_CAP <= 72.0, "FOG_FAR_CAP never exceeds 72 m");
    eqi("MAX_DYNAMIC_LIGHTS == 2 (ratified)", g_MAX_DYNAMIC_LIGHTS, 2);
    ok(g_MAX_DYNAMIC_LIGHTS <= g_ENV_LIGHT_SLOTS,
       "the game cap fits the engine's 4 slots");
    ok(g_ENV_LIGHT_SLOTS == 4, "RenderEnv keeps 4 slots; we just never fill them");

    // Fog / camera.
    ok(g_FOG_NEAR_MIN >= 3.0, "fog never reaches the gun barrel");
    eqf("far plane scale", g_FAR_PLANE_SCALE, 1.06, 0.0);
    eqf("derived far plane at the cap", g_FOG_FAR_CAP * g_FAR_PLANE_SCALE, 76.32, 0.001);
    ok(g_FOG_ALPHA_T > 0.0 && g_FOG_ALPHA_T < 1.0, "D7 alpha threshold in range");
    ok(g_FOV_ADS < g_FOV_HIP && g_FOV_HIP < g_FOV_SPRINT, "FOV ladder ADS<hip<sprint");
    ok(g_DEPTH_VIEWMODEL > 0.0 && g_DEPTH_VIEWMODEL < 1.0,
       "viewmodel sorts last inside LAYER_WORLD");

    // Every fog distance in the project obeys the cap.  This is the assertion
    // that stops a tier or a biome quietly reintroducing a 140 m sightline.
    ok(g_FOG_FAR_TIER0 <= g_FOG_FAR_CAP, "tier 0 fog <= cap");
    ok(g_FOG_FAR_TIER1 <= g_FOG_FAR_CAP, "tier 1 fog <= cap");
    ok(g_FOG_FAR_TIER2 <= g_FOG_FAR_CAP, "tier 2 fog <= cap");
    ok(g_FOG_FAR_TIER3 <= g_FOG_FAR_CAP, "tier 3 fog <= cap");
    ok(g_FOG_FAR_TIER4 <= g_FOG_FAR_CAP, "tier 4 fog <= cap");
    ok(g_FOG_FAR_TIER5 <= g_FOG_FAR_CAP, "tier 5 fog <= cap");
    ok(g_FOG_FAR_TIER0 > g_FOG_FAR_TIER1, "fog tightens with tier 0>1");
    ok(g_FOG_FAR_TIER1 > g_FOG_FAR_TIER2, "fog tightens with tier 1>2");
    ok(g_FOG_FAR_TIER2 > g_FOG_FAR_TIER3, "fog tightens with tier 2>3");
    ok(g_FOG_FAR_TIER3 > g_FOG_FAR_TIER4, "fog tightens with tier 3>4");
    ok(g_FOG_FAR_TIER4 > g_FOG_FAR_TIER5, "fog tightens with tier 4>5");
    eqi("shade tiers", g_SHADE_TIER_MAX, 5);
    ok(g_FOG_FAR_HOLLOWFIELD <= g_FOG_FAR_CAP, "Hollowfield sightline <= cap");
    ok(g_FOG_FAR_ASHWOOD <= g_FOG_FAR_CAP, "Ashwood sightline <= cap");
    ok(g_FOG_FAR_CHALKDOWNS <= g_FOG_FAR_CAP, "Chalk Downs sightline <= cap");
    ok(g_FOG_FAR_FEN <= g_FOG_FAR_CAP, "The Fen sightline <= cap");
    ok(g_FOG_FAR_IRONPINE <= g_FOG_FAR_CAP, "Ironpine sightline <= cap");
    ok(g_FOG_FAR_DEEPSHADE <= g_FOG_FAR_CAP, "Deepshade sightline <= cap");

    // The ground-triangle arithmetic that the cap exists to satisfy:
    // tris ~= (pi/4) * FOG_FAR^2 / 16 * 2.
    let far2: f64 = g_FOG_FAR_CAP * g_FOG_FAR_CAP;
    let ground: f64 = 0.7853981633974483 * far2 / 16.0 * 2.0;
    ok(ground < 600.0, "ground tris at the cap stay under 600");
    ok(ground < f64(g_TRIS_STEADY) * 0.25, "ground is under a quarter of the budget");

    // World.
    eqf("chunk edge", g_CHUNK_M, 32.0, 0.0);
    eqi("chunk quads", g_CHUNK_QUADS, 8);
    eqf("heightfield cell", g_CHUNK_GRID_M, 4.0, 0.0);
    eqi("height samples per side", g_CHUNK_N, g_CHUNK_QUADS + 1);
    eqf("quads * cell == chunk", f64(g_CHUNK_QUADS) * g_CHUNK_GRID_M, g_CHUNK_M, 1e-12);
    eqi("LOD0 tris == 2 * quads^2", g_LOD0_TRIS, 2 * g_CHUNK_QUADS * g_CHUNK_QUADS);
    ok(g_LOD1_TRIS < g_LOD0_TRIS && g_LOD2_TRIS < g_LOD1_TRIS, "LOD tris decrease");
    ok(g_LOD0_M < g_LOD1_M, "LOD rings are ordered");
    ok(g_LOD1_M <= g_FOG_FAR_CAP, "LOD2 begins inside the fog wall");
    eqi("ring chunk count", g_RING_CHUNKS, (2 * g_RING_RADIUS + 1) * (2 * g_RING_RADIUS + 1));
    let ring_reach: f64 = (f64(g_RING_RADIUS) + 0.5) * g_CHUNK_M;
    ok(ring_reach >= g_FOG_FAR_CAP, "the ring covers the whole fog sphere");
    ok(g_STREAM_IN_M >= g_FOG_FAR_CAP, "chunks never stream in closer than the fog wall");

    // Caps.
    ok(g_MAX_RENDER_ENTS <= g_MAX_ENTS, "render snapshot <= world slots");
    ok(g_MAX_PARTICLES >= 512, "particle SoA is 512");

    // Player (GDD 2.3).
    eqf("health", g_HP_MAX, 100.0, 0.0);
    ok(g_SPEED_CROUCH < g_SPEED_ADS, "crouch is the slowest stance");
    ok(g_SPEED_ADS < g_SPEED_WALK, "ADS is slower than walking");
    ok(g_SPEED_WALK < g_SPEED_SPRINT, "sprint is the fastest");
    ok(g_SLIDE_MIN_SPEED < g_SLIDE_BURST, "a slide accelerates you");
    ok(g_SLIDE_BURST > g_SPEED_SPRINT, "sliding beats sprinting");
    ok(g_SLIDEJUMP_KEEP > 0.8 && g_SLIDEJUMP_KEEP < 1.0, "slide-jump keeps most speed");
    ok(g_EYE_STAND < g_HEIGHT_STAND, "the eye is inside the capsule");
    // apex = v^2 / 2g must clear a 0.95 m crouch ledge (GDD 6).
    let apex: f64 = g_JUMP_IMPULSE * g_JUMP_IMPULSE / (2.0 * g_GRAVITY);
    ok(apex > 0.95, "a jump clears a 0.95 m ledge without mantling");
    eqf("jump apex", apex, 0.99, 0.01);

    // Director (GDD 2.6 + §8).
    //
    // 231 -> 294.  NOT A FREE EDIT, and this file is not the wave1-winnable
    // task's file — it is changed because the old literal became ARITHMETICALLY
    // UNREACHABLE, and left alone it would have been a permanently red probe.
    // GAME_DESIGN §8 anchors director_budget(1, 0) at 60, so
    //     BASE + PER_TIER      == 60
    //     BASE + 3*PER_TIER + 2*PER_WAVE == 231   (this line, as it was)
    // together give PER_TIER + PER_WAVE == 85.5, which has no integer solution.
    // One of the two had to move and §8 is the design document, so 231 moved.
    // The shipped values are BASE 15 / PER_TIER 45 / PER_WAVE 72 -> 294.
    // The §8 anchor itself is pinned in tools/probe_director.hml section A.
    let b3: i32 = g_DIR_BUDGET_BASE + g_DIR_BUDGET_PER_TIER * 3 + g_DIR_BUDGET_PER_WAVE * 2;
    eqi("budget(tier 3, wave 2)", b3, 294);
    eqi("GAME_DESIGN §8 anchor: budget(tier 1, wave 1)",
        g_DIR_BUDGET_BASE + g_DIR_BUDGET_PER_TIER, 60);
    ok(g_DIR_ONSCREEN_CAP < g_DIR_ALIVE_CAP, "onscreen cap is tighter than alive cap");
    eqi("alive cap", g_DIR_ALIVE_CAP, 14);

    // Day cycle (D6): 16 minutes, Dawn 2 / Day 7 / Dusk 2 / Night 5.
    eqf("day minutes", g_DAY_MINUTES, 16.0, 0.0);
    eqf("day seconds", g_DAY_SECONDS, g_DAY_MINUTES * 60.0, 1e-12);
    eqi("day ticks", g_DAY_TICKS, 57600);
    eqf("day ticks == seconds * hz", f64(g_DAY_TICKS), g_DAY_SECONDS * f64(g_TICK_HZ), 1e-9);
    eqf("dawn ends at 2/16", g_PHASE_DAWN_END, 0.125, 1e-12);
    eqf("day ends at 9/16", g_PHASE_DAY_END, 0.5625, 1e-12);
    eqf("dusk ends at 11/16", g_PHASE_DUSK_END, 0.6875, 1e-12);
    ok(g_PHASE_DAWN_END < g_PHASE_DAY_END, "phases are ordered dawn<day");
    ok(g_PHASE_DAY_END < g_PHASE_DUSK_END, "phases are ordered day<dusk");
    ok(g_PHASE_DUSK_END < 1.0, "night closes the day");
    eqf("night is 5 of 16 minutes", 1.0 - g_PHASE_DUSK_END, 0.3125, 1e-12);

    // XP curve: 500 + 250L + 25L^2.
    let xp1: i32 = g_XP_BASE + g_XP_LINEAR * 1 + g_XP_QUAD * 1 * 1;
    let xp30: i32 = g_XP_BASE + g_XP_LINEAR * 30 + g_XP_QUAD * 30 * 30;
    eqi("xp_to_next(1)", xp1, 775);
    eqi("xp_to_next(30)", xp30, 30500);
    eqi("level soft cap", g_LEVEL_SOFT_CAP, 30);

    // Atlases.
    eqi("world atlas is 8x8 cells of 32", g_ATLAS_WORLD_PX, g_ATLAS_WORLD_CELLS * g_TILE_PX);
    eqi("FX atlas cells divide the atlas", g_ATLAS_FX_PX % g_FX_CELL_PX, 0);
    eqi("HUD atlas", g_ATLAS_HUD_PX, 128);
    eqi("sky panorama width", g_SKY_W, 512);
    eqi("sky panorama height", g_SKY_H, 160);
    eqi("minimum albedo luminance", g_ALBEDO_LUM_MIN, 72);
    ok(g_TILE_COLORS_MAX <= 12, "<= 12 colours per tile");
    ok(g_GRAIN_AMT <= 6, "grain stays within +/-6 luminance");

    // Audio (HOST_FACTS).
    eqi("mixer rate", g_AUDIO_HZ, 22050);
    ok(g_AUDIO_VOICES >= 8, "at least 8 mixing voices");

    // Net shapes.
    eqi("entity blob stride", g_NET_ENT_STRIDE_B, 20);
    eqi("entities per blob", g_NET_ENTS_PER_BLOB, g_NET_BLOB_MAX_B / g_NET_ENT_STRIDE_B);
    ok(g_NET_BLOB_MAX_B <= g_BUFFER_ELEM_CAP, "a blob fits the 255 B element cap");
    eqi("InputCommand is nine integers", g_CMD_FIELDS, 9);
}

// ===========================================================================
// §2  SCALAR HELPERS
// ===========================================================================
fn section_scalars() {
    print("");
    print("[2] mathx scalar helpers");

    eqf("absf(-3.5)", absf(-3.5), 3.5, 0.0);
    eqf("absf(3.5)", absf(3.5), 3.5, 0.0);
    eqf("absf(0)", absf(0.0), 0.0, 0.0);
    eqf("minf", minf(2.0, -1.0), -1.0, 0.0);
    eqf("minf equal", minf(2.0, 2.0), 2.0, 0.0);
    eqf("maxf", maxf(2.0, -1.0), 2.0, 0.0);
    eqf("clampf below", clampf(-5.0, 0.0, 1.0), 0.0, 0.0);
    eqf("clampf above", clampf(5.0, 0.0, 1.0), 1.0, 0.0);
    eqf("clampf inside", clampf(0.25, 0.0, 1.0), 0.25, 0.0);
    eqf("clamp01 below", clamp01(-0.001), 0.0, 0.0);
    eqf("clamp01 above", clamp01(1.001), 1.0, 0.0);
    eqf("clamp01 inside", clamp01(0.5), 0.5, 0.0);
    eqf("lerpf t=0", lerpf(2.0, 6.0, 0.0), 2.0, 0.0);
    eqf("lerpf t=1", lerpf(2.0, 6.0, 1.0), 6.0, 1e-15);
    eqf("lerpf t=0.5", lerpf(2.0, 6.0, 0.5), 4.0, 1e-15);
    eqf("smooth01(0)", smooth01(0.0), 0.0, 0.0);
    eqf("smooth01(1)", smooth01(1.0), 1.0, 1e-15);
    eqf("smooth01(0.5)", smooth01(0.5), 0.5, 1e-15);
    eqf("smooth01 clamps low", smooth01(-2.0), 0.0, 0.0);
    eqf("smooth01 clamps high", smooth01(2.0), 1.0, 0.0);
    eqf("smoothstep below e0", smoothstep(1.0, 3.0, 0.0), 0.0, 0.0);
    eqf("smoothstep above e1", smoothstep(1.0, 3.0, 9.0), 1.0, 0.0);
    eqf("smoothstep midpoint", smoothstep(1.0, 3.0, 2.0), 0.5, 1e-15);
    eqf("smoothstep degenerate low", smoothstep(2.0, 2.0, 1.0), 0.0, 0.0);
    eqf("smoothstep degenerate high", smoothstep(2.0, 2.0, 3.0), 1.0, 0.0);
    eqf("deg2rad(180)", deg2rad(180.0), 3.141592653589793, 1e-12);
    eqf("rad2deg round trip", rad2deg(deg2rad(37.5)), 37.5, 1e-12);
    eqi("absi(-9)", absi(-9), 9);
    eqi("mini", mini(-4, 7), -4);
    eqi("maxi", maxi(-4, 7), 7);
    eqi("clampi below", clampi(-4, 0, 5), 0);
    eqi("clampi above", clampi(40, 0, 5), 5);
    eqi("clampi inside", clampi(3, 0, 5), 3);
    eqi("floori(2.9)", floori(2.9), 2);
    eqi("floori(-2.1) is -3, not -2", floori(-2.1), -3);
    eqi("floori(-3.0)", floori(-3.0), -3);
    eqi("floori(0.0)", floori(0.0), 0);

    // mathx's clampf/minf/maxf/absf are thin wrappers over the __clamp/__min/
    // __max/__abs BUILTINS (1.4x faster than an if-chain, see §7).  So they are
    // checked against comparison logic written out by hand HERE — checking them
    // against @stdlib would be checking the builtin against itself.
    let mism: i32 = 0;
    let par: i32 = 0;
    let i: i32 = 0;
    while (i < 2001) {
        let v: f64 = f64(i) * 0.001 - 1.0;

        let rc: f64 = v;
        if (rc < -0.25) { rc = -0.25; }
        if (rc > 0.75) { rc = 0.75; }
        if (clampf(v, -0.25, 0.75) != rc) { mism++; }

        let rm: f64 = v;
        if (0.1 < rm) { rm = 0.1; }
        if (minf(v, 0.1) != rm) { mism++; }

        let rx: f64 = v;
        if (0.1 > rx) { rx = 0.1; }
        if (maxf(v, 0.1) != rx) { mism++; }

        let ra: f64 = v;
        if (ra < 0.0) { ra = 0.0 - ra; }
        if (absf(v) != ra) { mism++; }

        let r01: f64 = v;
        if (r01 < 0.0) { r01 = 0.0; }
        if (r01 > 1.0) { r01 = 1.0; }
        if (clamp01(v) != r01) { mism++; }

        if (clampf(v, -0.25, 0.75) != clamp(v, -0.25, 0.75)) { par++; }
        if (minf(v, 0.1) != min(v, 0.1)) { par++; }
        if (maxf(v, 0.1) != max(v, 0.1)) { par++; }
        if (absf(v) != abs(v)) { par++; }
        i++;
    }
    eqi("clampf/minf/maxf/absf/clamp01 match hand-written ifs on 2001 values", mism, 0);
    eqi("...and agree with @stdlib on the same 2001 values", par, 0);
}

// ===========================================================================
// §3  HASHING — [A1]
// ===========================================================================
// The 1 M-input checksum.  u64 wraps identically on both backends (the i64
// forms TRAP instead, which is why A13 exists), so this constant is the same
// number interpreted and compiled or the hash is broken.
fn hash_checksum(p_n: i32): u64 {
    let n: i32 = p_n;
    let chk: u64 = 14695981039346656037;
    let i: i32 = 0;
    while (i < n) {
        let x: i32 = (i & 1023) - 512;          // spans negative and positive
        let y: i32 = (i >> 10) - 512;
        let h: u64 = xhash2(x, y, 1337);
        chk = chk ^ h;
        chk = chk * 1099511628211;
        i++;
    }
    let out: u64 = chk;
    return out;
}

fn section_hash() {
    print("");
    print("[3] xhash2 / xhash3 / h01   [A1]");

    // Determinism and independence.
    ok(xhash2(0, 0, 0) == xhash2(0, 0, 0), "xhash2 is a function of its inputs");
    ok(xhash2(1, 0, 0) != xhash2(0, 1, 0), "x and y are not interchangeable");
    ok(xhash2(0, 0, 1) != xhash2(0, 0, 0), "the seed changes the value");
    ok(xhash2(-1, 0, 0) != xhash2(1, 0, 0), "negative x is its own input");
    ok(xhash3(1, 2, 0, 3) != xhash2(1, 2, 3), "xhash3 never collides with xhash2 at z=0");
    ok(xhash3(1, 2, 3, 4) != xhash3(1, 3, 2, 4), "xhash3 y and z are not interchangeable");

    // 32-bit range: every value must fit, or a consumer's / 2^32 is wrong.
    let over: i32 = 0;
    let i: i32 = 0;
    while (i < 20000) {
        let h: u64 = xhash2(i - 10000, i * 7 - 3, 99);
        if (h > 4294967295) { over++; }
        let h3: u64 = xhash3(i, -i, i * 3, 5);
        if (h3 > 4294967295) { over++; }
        i++;
    }
    eqi("40 000 hashes all fit in 32 bits", over, 0);

    // h01 range.
    let bad: i32 = 0;
    i = 0;
    while (i < 20000) {
        let v: f64 = h01(i - 10000, 17 - i, 7);
        if (v < 0.0 || v >= 1.0) { bad++; }
        let v3: f64 = h01_3(i, i - 5, 3 - i, 7);
        if (v3 < 0.0 || v3 >= 1.0) { bad++; }
        i++;
    }
    eqi("40 000 h01 values in [0,1)", bad, 0);

    // Distribution: 64 buckets over 65 536 values, chi-square against uniform.
    // A hash that ignores an input, or that carries a low-bit pattern through
    // the finalizer, fails this hard.
    let counts: array<i32> = [];
    i = 0;
    while (i < 64) { counts.push(0); i++; }
    i = 0;
    while (i < 65536) {
        let x: i32 = (i & 255) - 128;
        let y: i32 = (i >> 8) - 128;
        let v: f64 = h01(x, y, 20260728);
        let b: i32 = i32(v * 64.0);
        if (b > 63) { b = 63; }
        counts[b] = counts[b] + 1;
        i++;
    }
    let expect: f64 = 1024.0;
    let chi: f64 = 0.0;
    let worst: i32 = 0;
    i = 0;
    while (i < 64) {
        let d: f64 = f64(counts[i]) - expect;
        chi = chi + d * d / expect;
        let dv: i32 = counts[i] - 1024;
        if (dv < 0) { dv = 0 - dv; }
        if (dv > worst) { worst = dv; }
        i++;
    }
    // chi-square, 63 dof: the 99.9 % critical value is ~112.  A real failure
    // (an ignored input) lands in the thousands, not the hundreds.
    print(`    chi2(63 dof) = ${f3(chi)}   worst bucket deviation = ${worst}/1024`);
    ok(chi < 112.0, "h01 is uniform over 64 buckets (chi2 < 112)");
    ok(worst < 160, "no bucket deviates more than ~15 %");

    // Adjacency: neighbouring lattice cells must not correlate, or value noise
    // shows a visible grid.  Compare the top 8 bits of adjacent hashes.
    let same: i32 = 0;
    i = 0;
    while (i < 20000) {
        let a: u64 = xhash2(i, 0, 4) >> 24;
        let b: u64 = xhash2(i + 1, 0, 4) >> 24;
        if (a == b) { same++; }
        i++;
    }
    // 20 000 draws from 256 buckets: ~78 collisions expected.
    print(`    adjacent-cell top-byte collisions: ${same}/20000 (expect ~78)`);
    ok(same > 20 && same < 200, "adjacent cells are uncorrelated");

    // [A1] the parity checksum over 1 048 576 inputs.  Never throws: an
    // overflow trap here would abort the process, not fail an assertion.
    let n: i32 = 1048576;
    let chk: u64 = hash_checksum(n);
    print(`    xhash2 checksum over ${n} inputs = ${chk}`);
    ok(chk == g_HASH_GOLDEN, "[A1] 1 M-input checksum matches the golden value");
    ok(chk == hash_checksum(n), "[A1] the checksum is reproducible in-process");
}

// ===========================================================================
// §4  BAYER, and vnoise pinned against h01
// ===========================================================================
fn section_bayer_pin() {
    print("");
    print("[4] bayer4, and vnoise's inlined hash pinned against h01");

    // All 16 thresholds present exactly once.
    let seen: array<i32> = [];
    let i: i32 = 0;
    while (i < 16) { seen.push(0); i++; }
    let y: i32 = 0;
    while (y < 4) {
        let x: i32 = 0;
        while (x < 4) {
            let v: i32 = bayer4i(x, y);
            if (v >= 0 && v < 16) { seen[v] = seen[v] + 1; }
            x++;
        }
        y++;
    }
    let dup: i32 = 0;
    i = 0;
    while (i < 16) { if (seen[i] != 1) { dup++; } i++; }
    eqi("the 4x4 Bayer matrix is a permutation of 0..15", dup, 0);
    eqi("bayer4i(0,0)", bayer4i(0, 0), 0);
    eqi("bayer4i(1,0)", bayer4i(1, 0), 8);
    eqi("bayer4i(0,1)", bayer4i(0, 1), 12);
    eqi("bayer4i(3,3)", bayer4i(3, 3), 5);
    eqf("bayer4 is bayer4i/16", bayer4(1, 0), 0.5, 0.0);
    eqf("bayer4 max is 15/16", bayer4(0, 3), 0.9375, 0.0);
    // Periodic in both axes, including negatives — dither must not seam at 0.
    let per: i32 = 0;
    i = -8;
    while (i < 8) {
        let j: i32 = -8;
        while (j < 8) {
            if (bayer4i(i, j) != bayer4i(i + 4, j)) { per++; }
            if (bayer4i(i, j) != bayer4i(i, j + 4)) { per++; }
            j++;
        }
        i++;
    }
    eqi("bayer4 is 4-periodic on both axes, negatives included", per, 0);

    // vnoise hand-inlines four copies of xhash2.  At an exact lattice point the
    // interpolation weights are 0, so the value IS the corner hash: this pins
    // the inlined copies to h01() bit-for-bit and stops them drifting.
    let mism: i32 = 0;
    i = -6;
    while (i < 6) {
        let j: i32 = -6;
        while (j < 6) {
            let vx: f64 = f64(i) * 8.0;
            let vy: f64 = f64(j) * 8.0;
            let got: f64 = vnoise(vx, vy, 8.0, 0, 4242);
            let want: f64 = h01(i, j, 4242);
            if (got != want) { mism++; }
            j++;
        }
        i++;
    }
    eqi("144 lattice points: vnoise's inlined hash == h01 exactly", mism, 0);

    // fbm2 is pinned against a hand-composed sum of vnoise calls.
    let fx: f64 = 3.25;
    let fy: f64 = -7.75;
    let a0: f64 = vnoise(fx, fy, 8.0, 32, 11);
    let a1: f64 = vnoise(fx, fy, 4.0, 32, 42);
    let a2: f64 = vnoise(fx, fy, 2.0, 32, 108);
    let want2: f64 = a0 * 0.60 + a1 * 0.28 + a2 * 0.12;
    eqexact("fbm2 == 0.60/0.28/0.12 octave sum", fbm2(fx, fy, 8.0, 32, 11), want2);
}

// ===========================================================================
// §5  VNOISE — range, continuity, and TILING [A2]
// ===========================================================================
fn section_vnoise() {
    print("");
    print("[5] vnoise / fbm2   [A2] tiling");

    // Range over 40 000 samples, wrapped and unwrapped.
    let bad: i32 = 0;
    let i: i32 = 0;
    while (i < 40000) {
        let x: f64 = f64(i % 313) * 0.37 - 40.0;
        let y: f64 = f64(i / 313) * 0.53 - 40.0;
        let v: f64 = vnoise(x, y, 8.0, 32, 5);
        if (v < 0.0 || v >= 1.0) { bad++; }
        let f: f64 = fbm2(x, y, 8.0, 32, 5);
        if (f < 0.0 || f >= 1.0) { bad++; }
        i++;
    }
    eqi("80 000 vnoise/fbm2 samples in [0,1)", bad, 0);

    // Continuity: value noise is C0.  A 1/64-texel step must not move the value
    // more than the lattice slope allows.
    let jump: f64 = 0.0;
    i = 0;
    while (i < 4000) {
        let x: f64 = f64(i) * 0.015625;
        let a: f64 = vnoise(x, 3.5, 8.0, 32, 9);
        let b: f64 = vnoise(x + 0.015625, 3.5, 8.0, 32, 9);
        let d: f64 = a - b;
        if (d < 0.0) { d = 0.0 - d; }
        if (d > jump) { jump = d; }
        i++;
    }
    print(`    largest 1/64-texel step in vnoise: ${f3(jump)}`);
    ok(jump < 0.02, "vnoise is continuous (no lattice discontinuity)");

    // Not constant, and not degenerate: it must actually vary.
    let lo: f64 = 2.0;
    let hi: f64 = -1.0;
    i = 0;
    while (i < 4096) {
        let v: f64 = vnoise(f64(i & 63) * 0.5, f64(i >> 6) * 0.5, 8.0, 32, 3);
        if (v < lo) { lo = v; }
        if (v > hi) { hi = v; }
        i++;
    }
    ok(hi - lo > 0.6, "vnoise spans most of [0,1] over a tile");

    // ---- [A2] SEAMLESS TILING: compare the edge columns. -----------------
    // 32-texel tile, cell 8 -> 4 lattice cells per repeat.  Column x=0 and
    // column x=32 must be BIT-IDENTICAL, and so must rows y=0 and y=32.
    let colmis: i32 = 0;
    let rowmis: i32 = 0;
    let t: i32 = 0;
    while (t < 32) {
        let fy: f64 = f64(t);
        if (vnoise(0.0, fy, 8.0, 32, 77) != vnoise(32.0, fy, 8.0, 32, 77)) { colmis++; }
        let fx: f64 = f64(t);
        if (vnoise(fx, 0.0, 8.0, 32, 77) != vnoise(fx, 32.0, 8.0, 32, 77)) { rowmis++; }
        t++;
    }
    eqi("[A2] vnoise edge columns x=0 and x=32 are identical", colmis, 0);
    eqi("[A2] vnoise edge rows y=0 and y=32 are identical", rowmis, 0);

    // Sub-texel too — a seam can hide between samples.
    let submis: i32 = 0;
    t = 0;
    while (t < 128) {
        let fy: f64 = f64(t) * 0.25;
        if (vnoise(0.25, fy, 4.0, 32, 5) != vnoise(32.25, fy, 4.0, 32, 5)) { submis++; }
        t++;
    }
    eqi("[A2] tiling holds at quarter-texel offsets", submis, 0);

    // Every cell that divides 32 tiles; and negative coordinates tile too.
    let cellmis: i32 = 0;
    let negmis: i32 = 0;
    let cells: array<f64> = [2.0, 4.0, 8.0, 16.0];
    let ci: i32 = 0;
    while (ci < 4) {
        let c: f64 = cells[ci];
        t = 0;
        while (t < 32) {
            let fy: f64 = f64(t) * 0.5;
            if (vnoise(1.5, fy, c, 32, 21) != vnoise(33.5, fy, c, 32, 21)) { cellmis++; }
            if (vnoise(-30.5, fy, c, 32, 21) != vnoise(1.5, fy, c, 32, 21)) { negmis++; }
            t++;
        }
        ci++;
    }
    eqi("[A2] cells 2/4/8/16 all tile a 32-unit period", cellmis, 0);
    eqi("[A2] tiling holds across x < 0", negmis, 0);

    // fbm2 tiles when cell*4 divides the wrap (all three octaves close).
    let fmis: i32 = 0;
    t = 0;
    while (t < 32) {
        let fy: f64 = f64(t);
        if (fbm2(0.0, fy, 8.0, 32, 13) != fbm2(32.0, fy, 8.0, 32, 13)) { fmis++; }
        t++;
    }
    eqi("[A2] fbm2 edge columns are identical at cell 8, wrap 32", fmis, 0);

    // The negative control: the wrap must actually DO something.  With
    // wrap = 0 the lattice is open and the edge columns must differ, and with a
    // cell that does not divide the wrap the lattice cannot close.
    let openmis: i32 = 0;
    t = 0;
    while (t < 32) {
        let fy: f64 = f64(t);
        if (vnoise(0.0, fy, 8.0, 0, 77) != vnoise(32.0, fy, 8.0, 0, 77)) { openmis++; }
        t++;
    }
    ok(openmis > 24, "wrap=0 genuinely disables tiling (control)");
    let nondiv: i32 = 0;
    t = 0;
    while (t < 32) {
        let fy: f64 = f64(t);
        if (vnoise(0.0, fy, 12.0, 32, 77) != vnoise(32.0, fy, 12.0, 32, 77)) { nondiv++; }
        t++;
    }
    ok(nondiv > 24, "a cell that does not divide the wrap does not tile (control)");

    // The wrapped and unwrapped functions agree inside the first period — the
    // wrap must be a domain fold, not a different noise field.
    let agree: i32 = 0;
    t = 0;
    while (t < 32) {
        let fx: f64 = f64(t) * 0.5;
        if (vnoise(fx, 2.0, 8.0, 32, 77) != vnoise(fx, 2.0, 8.0, 0, 77)) { agree++; }
        t++;
    }
    eqi("wrapping does not change the field inside one period", agree, 0);
}

// ===========================================================================
// §6  DETERMINISM ACROSS THE WHOLE STACK
// ===========================================================================
fn section_determinism() {
    print("");
    print("[6] determinism");

    // Same inputs, same bits, every time — src/sim depends on this.
    let a: f64 = fbm2(12.5, -7.25, 8.0, 32, 909);
    let b: f64 = fbm2(12.5, -7.25, 8.0, 32, 909);
    eqexact("fbm2 is bit-reproducible", a, b);
    let c: f64 = vnoise(0.125, 0.125, 4.0, 16, 1);
    let d: f64 = vnoise(0.125, 0.125, 4.0, 16, 1);
    eqexact("vnoise is bit-reproducible", c, d);
    ok(h01(3, 4, 5) == h01(3, 4, 5), "h01 is bit-reproducible");

    // A different seed is a different field (not merely an offset of it).
    let same: i32 = 0;
    let i: i32 = 0;
    while (i < 256) {
        let x: f64 = f64(i) * 0.25;
        if (vnoise(x, 1.0, 8.0, 32, 1) == vnoise(x, 1.0, 8.0, 32, 2)) { same++; }
        i++;
    }
    ok(same < 4, "seeds 1 and 2 produce different fields");

    // Cold-path guards.
    eqf("vnoise with a non-positive cell returns 0.5", vnoise(1.0, 1.0, 0.0, 0, 1), 0.5, 0.0);
    ok(vnoise(1.0, 1.0, -4.0, 0, 1) == 0.5, "vnoise with a negative cell returns 0.5");
}

// ===========================================================================
// §7  TIMING — [A3] and the regression guards
// ===========================================================================
// RULE T: __clock() CPU time, minimum of 7 batches.  Bounds are ~2x the loaded
// measurement, because a probe that fails on machine state is worse than no
// probe at all.

fn bench_baseline(p_n: i32): f64 {
    let n: i32 = p_n;
    let best: f64 = 0.0;
    let t: i32 = 0;
    while (t < g_TRIALS) {
        let c0: f64 = __clock();
        let acc: f64 = 0.0;
        let v: f64 = -0.5;
        let i: i32 = 0;
        while (i < n) {
            acc = acc + v;
            v = v + 0.0000131;
            i++;
        }
        let c1: f64 = __clock();
        g_sink = g_sink + acc;
        let ns: f64 = (c1 - c0) * 1000000000.0 / f64(n);
        if (t == 0 || ns < best) { best = ns; }
        t++;
    }
    let out: f64 = best;
    return out;
}

fn bench_stdlib_clamp(p_n: i32): f64 {
    let n: i32 = p_n;
    let best: f64 = 0.0;
    let t: i32 = 0;
    while (t < g_TRIALS) {
        let c0: f64 = __clock();
        let acc: f64 = 0.0;
        let v: f64 = -0.5;
        let i: i32 = 0;
        while (i < n) {
            acc = acc + clamp(v, 0.0, 1.0);
            v = v + 0.0000131;
            i++;
        }
        let c1: f64 = __clock();
        g_sink = g_sink + acc;
        let ns: f64 = (c1 - c0) * 1000000000.0 / f64(n);
        if (t == 0 || ns < best) { best = ns; }
        t++;
    }
    let out: f64 = best;
    return out;
}

fn bench_mathx_clamp(p_n: i32): f64 {
    let n: i32 = p_n;
    let best: f64 = 0.0;
    let t: i32 = 0;
    while (t < g_TRIALS) {
        let c0: f64 = __clock();
        let acc: f64 = 0.0;
        let v: f64 = -0.5;
        let i: i32 = 0;
        while (i < n) {
            acc = acc + clampf(v, 0.0, 1.0);
            v = v + 0.0000131;
            i++;
        }
        let c1: f64 = __clock();
        g_sink = g_sink + acc;
        let ns: f64 = (c1 - c0) * 1000000000.0 / f64(n);
        if (t == 0 || ns < best) { best = ns; }
        t++;
    }
    let out: f64 = best;
    return out;
}

fn bench_builtin_clamp(p_n: i32): f64 {
    let n: i32 = p_n;
    let best: f64 = 0.0;
    let t: i32 = 0;
    while (t < g_TRIALS) {
        let c0: f64 = __clock();
        let acc: f64 = 0.0;
        let v: f64 = -0.5;
        let i: i32 = 0;
        while (i < n) {
            acc = acc + __clamp(v, 0.0, 1.0);
            v = v + 0.0000131;
            i++;
        }
        let c1: f64 = __clock();
        g_sink = g_sink + acc;
        let ns: f64 = (c1 - c0) * 1000000000.0 / f64(n);
        if (t == 0 || ns < best) { best = ns; }
        t++;
    }
    let out: f64 = best;
    return out;
}

// A9: two `if`s written where they are used.
fn bench_inline_clamp(p_n: i32): f64 {
    let n: i32 = p_n;
    let best: f64 = 0.0;
    let t: i32 = 0;
    while (t < g_TRIALS) {
        let c0: f64 = __clock();
        let acc: f64 = 0.0;
        let v: f64 = -0.5;
        let i: i32 = 0;
        while (i < n) {
            let w: f64 = v;
            if (w < 0.0) { w = 0.0; }
            if (w > 1.0) { w = 1.0; }
            acc = acc + w;
            v = v + 0.0000131;
            i++;
        }
        let c1: f64 = __clock();
        g_sink = g_sink + acc;
        let ns: f64 = (c1 - c0) * 1000000000.0 / f64(n);
        if (t == 0 || ns < best) { best = ns; }
        t++;
    }
    let out: f64 = best;
    return out;
}

fn bench_xhash2(p_n: i32): f64 {
    let n: i32 = p_n;
    let best: f64 = 0.0;
    let t: i32 = 0;
    while (t < g_TRIALS) {
        let c0: f64 = __clock();
        let acc: u64 = 0;
        let i: i32 = 0;
        while (i < n) {
            acc = acc + xhash2(i, i * 3, 7);
            i++;
        }
        let c1: f64 = __clock();
        g_sink = g_sink + f64(acc & 1023);
        let ns: f64 = (c1 - c0) * 1000000000.0 / f64(n);
        if (t == 0 || ns < best) { best = ns; }
        t++;
    }
    let out: f64 = best;
    return out;
}

fn bench_vnoise(p_n: i32): f64 {
    let n: i32 = p_n;
    let best: f64 = 0.0;
    let t: i32 = 0;
    while (t < g_TRIALS) {
        let c0: f64 = __clock();
        let acc: f64 = 0.0;
        let i: i32 = 0;
        while (i < n) {
            acc = acc + vnoise(f64(i) * 0.37, f64(i) * 0.11, 8.0, 32, 3);
            i++;
        }
        let c1: f64 = __clock();
        g_sink = g_sink + acc;
        let ns: f64 = (c1 - c0) * 1000000000.0 / f64(n);
        if (t == 0 || ns < best) { best = ns; }
        t++;
    }
    let out: f64 = best;
    return out;
}

fn bench_fbm2(p_n: i32): f64 {
    let n: i32 = p_n;
    let best: f64 = 0.0;
    let t: i32 = 0;
    while (t < g_TRIALS) {
        let c0: f64 = __clock();
        let acc: f64 = 0.0;
        let i: i32 = 0;
        while (i < n) {
            acc = acc + fbm2(f64(i) * 0.37, f64(i) * 0.11, 8.0, 32, 3);
            i++;
        }
        let c1: f64 = __clock();
        g_sink = g_sink + acc;
        let ns: f64 = (c1 - c0) * 1000000000.0 / f64(n);
        if (t == 0 || ns < best) { best = ns; }
        t++;
    }
    let out: f64 = best;
    return out;
}

// Pick a batch size that takes ~30 ms on WHATEVER backend is running, so the
// same probe finishes quickly interpreted (5-18x slower) without giving the
// compiled run a batch too short to measure.  One calibration pass, then every
// bench scales off it.
fn calibrate(): i32 {
    let probe: i32 = 20000;
    let c0: f64 = __clock();
    let acc: f64 = 0.0;
    let v: f64 = -0.5;
    let i: i32 = 0;
    while (i < probe) {
        acc = acc + v;
        v = v + 0.0000131;
        i++;
    }
    let c1: f64 = __clock();
    g_sink = g_sink + acc;
    let per: f64 = (c1 - c0) / f64(probe);
    let n: i32 = 2000000;
    if (per > 0.0) {
        let want: f64 = 0.03 / per;
        n = i32(want);
    }
    if (n < 20000) { n = 20000; }
    if (n > 2000000) { n = 2000000; }
    let out: i32 = n;
    return out;
}

fn section_timing() {
    print("");
    print("[7] timing   [A3]   __clock CPU time, min of 7 batches");

    let n: i32 = calibrate();
    let base: f64 = bench_baseline(n);
    let std: f64 = bench_stdlib_clamp(n);
    let mx: f64 = bench_mathx_clamp(n);
    let inl: f64 = bench_inline_clamp(n);
    let bin: f64 = bench_builtin_clamp(n);

    let std_net: f64 = std - base;
    let mx_net: f64 = mx - base;
    let inl_net: f64 = inl - base;
    let bin_net: f64 = bin - base;

    // The interpreter's cost model is not the shipping one — a builtin call is
    // relatively cheaper there and an inlined comparison relatively dearer —
    // so [A3] and the ratio guards are asserted only on the backend we ship.
    // The baseline iteration cost tells us which backend we are on: ~15 ns
    // compiled, hundreds of ns interpreted.
    let compiled: i32 = 0;
    if (base < 100.0) { compiled = 1; }
    if (compiled == 1) {
        print(`    backend: COMPILED, batch = ${n} iterations`);
    } else {
        print(`    backend: INTERPRETED (baseline ${f3(base)} ns/iter), batch = ${n}`);
        print(`    timing assertions are compiled-only truth — reported, not asserted`);
    }

    print(`    loop baseline            ${f3(base)} ns/iter`);
    print(`    __clamp() builtin        ${f3(bin)} ns/iter   (net ${f3(bin_net)})`);
    print(`    hand-inlined two ifs     ${f3(inl)} ns/iter   (net ${f3(inl_net)})`);
    print(`    @stdlib clamp()          ${f3(std)} ns/iter   (net ${f3(std_net)})`);
    print(`    mathx clampf()           ${f3(mx)} ns/iter   (net ${f3(mx_net)})`);

    // [A3].  RATIO assertions, because contention inflates both sides together
    // (BUDGET_ACTUAL: absolute bounds drift 60-100 %, ratios stay honest).
    let a3a: bool = inl < std;
    let a3b: bool = std_net > inl_net * 1.15;
    let a3c: bool = bin < std;
    let a3d: bool = bin_net < inl_net * 1.25;
    let a3e: bool = mx_net < std_net * 2.0;
    if (compiled == 0) { a3a = true; a3b = true; a3c = true; a3d = true; a3e = true; }
    ok(a3a, "[A3] the inlined clamp is faster than @stdlib clamp");
    ok(a3b, "[A3] and by at least 15 % of net cost");
    ok(a3c, "the __clamp builtin is faster than @stdlib's alias for it");
    ok(a3d, "the builtin is within 25 % of hand-inlining");
    ok(a3e, "clampf (a call on top of the builtin) stays within 2x");

    let hn: i32 = n;
    let vnn: i32 = n / 40;
    let fbn: i32 = n / 120;
    if (vnn < 2000) { vnn = 2000; }
    if (fbn < 1000) { fbn = 1000; }
    let hns: f64 = bench_xhash2(hn);
    let vn: f64 = bench_vnoise(vnn);
    let fb: f64 = bench_fbm2(fbn);
    print(`    xhash2()                 ${f3(hns)} ns/call`);
    print(`    vnoise()                 ${f3(vn)} ns/call`);
    print(`    fbm2()   (3 octaves)     ${f3(fb)} ns/call`);

    // Regression guards.  Expressed as RATIOS against this process's own
    // measured loop cost, because the absolute numbers on this box move ~2x
    // with llama-server load and an absolute bound would either false-fail or
    // be so loose it catches nothing.  The regression these catch is the one
    // that matters: a change that boxes or allocates in the noise stack costs
    // 5-20x, not 30 %.
    let hr: f64 = hns / base;
    let vr: f64 = vn / base;
    let fr: f64 = fb / base;
    print(`    ratios vs the ${f3(base)} ns baseline iteration:  xhash2 ${f3(hr)}x  vnoise ${f3(vr)}x  fbm2 ${f3(fr)}x`);
    let g1: bool = hr < 30.0;
    let g2: bool = vr < 130.0;
    let g3: bool = fr < 380.0;
    let g4: bool = vn < hns * 8.0;
    let g5: bool = fb < vn * 4.0;
    if (compiled == 0) { g1 = true; g2 = true; g3 = true; g4 = true; g5 = true; }
    ok(g1, "xhash2 regression guard: < 30 baseline iterations");
    ok(g2, "vnoise regression guard: < 130 baseline iterations");
    ok(g3, "fbm2 regression guard: < 380 baseline iterations");
    ok(g4, "vnoise costs less than 8 xhash2 calls (it inlines 4)");
    ok(g5, "fbm2 costs less than 4 vnoise calls (3 octaves + 1 call)");
}

// ===========================================================================
fn main() {
    print("probe_mathx — W2-2  config.hml + mathx.hml");
    section_config();
    section_scalars();
    section_hash();
    section_bayer_pin();
    section_vnoise();
    section_determinism();
    section_timing();

    print("");
    if (g_total != g_EXPECTED_ASSERTS) {
        print(`ASSERTION COUNT MISMATCH: ran ${g_total}, expected ${g_EXPECTED_ASSERTS}`);
        print(`FAIL ${g_pass}/${g_total}`);
        exit(1);
    }
    if (g_pass != g_total) {
        print(`FAIL ${g_pass}/${g_total}`);
        exit(1);
    }
    print(`PASS ${g_pass}/${g_total}`);
    if (g_sink == 12345.6789) { print(""); }
    exit(0);
}

main();
