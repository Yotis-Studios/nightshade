// ---------------------------------------------------------------------------
// probe_nightanchor.hml — THE NIGHT'S BRIGHT HALF.            (night-anchor)
//
//   hemlockc -O1 tools/probe_nightanchor.hml -o /tmp/probe_nightanchor
//   SDL_VIDEODRIVER=dummy /tmp/probe_nightanchor
//
// Exits 0 only if every assertion held AND the number of assertions executed is
// exactly the number this file says it should — a skipped branch cannot shrink
// numerator and denominator together and read green.
//
// No window is opened.  `skygen_init` / `skygen_bake_all` are explicitly
// windowless ("No SDL: the panorama can be baked and inspected with no window
// open"), and this file never calls `skygen_build`.  SDL is still LINKED,
// because skygen imports `BLEND_NONE` from wobbleweed's sdl.hml, which is why
// the dummy driver is on the command line; nothing here touches a surface.
//
// ---------------------------------------------------------------------------
// WHAT THIS PROBE IS FOR
// ---------------------------------------------------------------------------
// CLAUDE.md §8: "every frame needs something below luminance 30 and something
// above 220.  No darks and no lights means no contrast anchor, and the image
// reads as a toy."  After the night veil landed, the night owned the dark half
// outright and had NOTHING for the bright half: measured over 49 in-game night
// frames, zero carried a >= 40 px contiguous WORLD region above 220, and the
// brightest world pixel in a night frame was 208.9 — a tier-1 star, not a body.
//
// The cause was not brightness.  It was two of them:
//
//   1. THE NIGHT SKY WAS DRAWING THE SUN.  skygen decided sun-vs-moon from the
//      SIGN of the key direction's elevation; tod.hml's night rows store the
//      key ALREADY NEGATED ("direction negated: this is the moon"), so at 22:00
//      the body was above the horizon and got SUN_DISC (255,244,200) with a
//      warm SUN_HALO corona.  Reproduce on the pre-fix build with
//      `shot --scene ridge_golden --tod 22 --look 201,25`: a golden sun at
//      midnight, and its disc measured 243.2 on screen.
//   2. THE MOON WAS ABOVE THE TOP OF THE SCREEN.  The NIGHT keyframe put the
//      body at 33.0 degrees elevation.  A camera's visible band is
//      `fov/2 + pitch` — 30 degrees on `ns_bloom`, 27 on `flat_debug` — so even
//      once it WAS a moon it was out of shot in every authored night frame.
//
//   3. AND THEN THE CAMERA MOVED UNDER IT.  (moon-anchor, 2026-07-31)  Cause 2
//      was fixed by bringing tod.hml's NIGHT key down to 18.06 degrees, sized
//      against `fov/2 + pitch` with fov = 70 -- the 4:3 vertical fov.  The 16:9
//      conversion landed the same week and moved `g_FOV_HIP` to 58, which drops
//      the band top from 27 degrees to 21, and 18.06 + 6.23 overruns it.  The
//      moon shipped CLIPPED BY THE TOP EDGE.  Section [3] below was ALSO sized
//      against 70 and therefore certified the defect.  Every angle in it is now
//      recomputed from `g_FOV_HIP` and `g_RES_H`, and the placement itself is
//      derived in `skygen.hml` (`skygen_moon_el_max`), so the next aspect
//      change moves the moon and this probe together.
//
// So this file pins, with literals (CLAUDE.md rule 5):
//   [1] the moon is selected at night and the sun at noon, through tod.hml's
//       own TODSKY_MOON flag rather than through a sign test;
//   [2] the baked disc clears the ART_BIBLE 220 bar, and clears it by enough
//       texels that a 40-px screen region is arithmetically guaranteed;
//   [3] the whole disc is inside the visible band of a normal playing pitch;
//   [4] the corona implies light on its surroundings without dissolving the
//       hard limb §11.3 asks for;
//   [5] the crossfade into the moon is continuous and monotone;
//   [6] the NIGHT keyframe's FLAT-GROUND light is what it was before the moon
//       came down, which is the number the inversion is graded on;
//   [7] the day did not move.
//  [10] (the-lamp, 2026-07-31) THE CURE, and its guard rail.  A lamp is three
//       additive cards, smallest last: an EMBER haze, a MUZZLE_MID body, and a
//       MUZZLE_CORE core.  The core is the only one over 220 and the two amber
//       cards must SUM under it -- because additive cards stack, and if they
//       summed over the bar the bright region would be the size of the biggest
//       card instead of the smallest and the lamp would be a white blob.  Every
//       number is imported from `src/render/settle_render.hml`, never retyped.
//   [9] (real-night-anchor, 2026-07-31) THE CEILING LAW.  The moon is one
//       object at one azimuth and can never anchor eight yaws; the rest has to
//       be LAMPS, and lamps were failing for a reason nobody had written down.
//       An additive card's luminance ceiling is `Rec709(tint) * alpha / 255`,
//       so g_UI_AMBER (199.3) can never anchor at any alpha or any size and
//       g_WINDOW_LIGHT (220.3) anchors only at alpha 255.  That is why the
//       shipping town has no night anchor and why no edit to `fxgen.hml` could
//       ever have given it one.  Pinned against the palette so a colour edit
//       cannot silently un-anchor the night.
//
// >>> WHAT THIS PROBE CANNOT DO, STATED PLAINLY.
// It cannot measure a SCREEN pixel or a contiguous region.  "a >= 40 px world
// region above 220" is a rendered-frame measurement made with `tools/shot.hml`
// and reported in the task's anchor table.  What this file pins is everything
// that has to be true for that measurement to keep reproducing: the selection,
// the placement, the disc's own luminance, and the ground it must not brighten.
// ---------------------------------------------------------------------------

import { exit } from "@stdlib/process";
import { floor, sqrt, asin, atan2, tan } from "@stdlib/math";

import { SKY_W, SKY_H,
         SKYK_ZEN, SKYK_MID, SKYK_HOR, SKYK_CLOUD_LIT, SKYK_CLOUD_SHADOW,
         SKYK_FOG, SKYK_STAR_ALPHA, SKYK_SUN, SKYK_HALO_R, SKYK_HALO_EXP,
         SKYK_MOON_PHASE, SKYK_CLOUD_COVER, SKYK_COUNT,
         skygen_init, skygen_keys_new, skygen_set_keys, skygen_set_clock,
         skygen_bake_all, skygen_atlas, skygen_body_uv, skygen_body_moon,
         skygen_sun_uv, skygen_moon_disc_deg, skygen_moon_el_max,
         skygen_sun_is_up } from "../src/art/skygen.hml";

// (moon-anchor) The camera the game actually ships, so this file cannot go on
// grading the moon against a 4:3 fov nobody has rendered since 2026-07-31.
import { g_FOV_HIP, g_RES_H, g_RES_W } from "../src/core/config.hml";

import { tod_eval, tod_reset, tod_set_weather, tod_key_anchor, tod_sky_keys,
         TOD_NOON, TOD_GOLDEN, TOD_DUSK, TOD_NIGHT, TOD_DEEP,
         WX_CLEAR, WX_BLOOM,
         TODSKY_ZENITH_R, TODSKY_MID_R, TODSKY_HORIZON_R,
         TODSKY_CLOUD_LIT_R, TODSKY_CLOUD_SHADOW_R,
         TODSKY_STAR_ALPHA, TODSKY_HALO, TODSKY_MOON,
         TODSKY_BODY_X, TODSKY_BODY_Y, TODSKY_CLOUD_COVER,
         TODSKY_COUNT } from "../src/art/tod.hml";

import { env_new, env_field,
         ENV_FOG_R, ENV_FOG_G, ENV_FOG_B,
         ENV_AMB_R, ENV_AMB_G, ENV_AMB_B,
         ENV_SUN_R, ENV_SUN_G, ENV_SUN_B,
         ENV_SUN_X, ENV_SUN_Y, ENV_SUN_Z } from "../../wobbleweed/src/shade.hml";

import { pal_r, pal_g, pal_b, g_MOON_DISC, g_SUN_DISC,
         g_WINDOW_LIGHT, g_UI_AMBER, g_UI_WHITE, g_EMBER,
         g_MUZZLE_CORE, g_MUZZLE_MID, g_STAR_BRIGHT } from "../src/art/palette.hml";

// (the-lamp) The lamp ladder, IMPORTED rather than retyped.  It lives in
// `src/art/meshgen.hml`, beside the VIEWMODEL flame it is copied from, and that
// module's whole import list is `@stdlib/math`, wobbleweed's `mesh.hml` and
// `palette.hml` -- so this costs the probe nothing.  (It was briefly taken from
// `src/render/settle_render.hml` instead, which drags in `worldgen.hml` and the
// whole sim; that is a lot of link surface for four numbers.)
import { MG_LAMP_A_HAZE, MG_LAMP_A_BODY, MG_LAMP_A_CORE,
         MG_LAMP_S_HAZE, MG_LAMP_S_BODY, MG_LAMP_S_CORE,
         MG_LAMP_WIN_A_BODY, MG_LAMP_WIN_A_CORE, MG_LAMP_WIN_CORE_F }
       from "../src/art/meshgen.hml";

let g_EXPECTED_ASSERTIONS = 54;

let g_pass: i32 = 0;
let g_n: i32 = 0;
let g_notes: array = [];

fn ok(label: string, cond: bool) {
    g_n = g_n + 1;
    if (cond) { g_pass = g_pass + 1; } else { print(`  FAIL  ${label}`); }
}
fn note(s: string) { g_notes.push(s); }

fn f4(p_x: f64): string {
    let x: f64 = p_x;
    let neg: i32 = 0;
    if (x < 0.0) { neg = 1; x = 0.0 - x; }
    let scaled: i64 = i64(x * 10000.0 + 0.5);
    let whole: i64 = scaled / 10000;
    let frac: i64 = scaled - whole * 10000;
    let fs: string = `${frac}`;
    while (fs.length < 4) { fs = `0${fs}`; }
    let s: string = `${whole}.${fs}`;
    if (neg == 1) { s = `-${s}`; }
    return s;
}

fn adiff(a: f64, b: f64): f64 {
    let d: f64 = a - b;
    if (d < 0.0) { d = 0.0 - d; }
    return d;
}

// Rec.709, the weights every ground measurement in src/art/tod.hml quotes.
fn luma709(p_r: f64, p_g: f64, p_b: f64): f64 {
    let out: f64 = 0.2126 * p_r + 0.7152 * p_g + 0.0722 * p_b;
    return out;
}

// ---------------------------------------------------------------------------
// THE tod -> skygen BRIDGE.  Byte-for-byte what tools/shot.hml, tools/walk.hml
// and src/game/main.hml all do (all three carry the same eight lines; see
// benchframe's note about it).  Copied rather than invented, because a probe
// that bridges DIFFERENTLY from the frame is a probe of nothing.
// ---------------------------------------------------------------------------
let g_env: array<f64> = env_new();
let g_todsky: array<f64> = [];
let g_skyk: array<f64> = [];

fn clamp01(p_x: f64): f64 {
    let x: f64 = p_x;
    if (x < 0.0) { x = 0.0; }
    if (x > 1.0) { x = 1.0; }
    return x;
}

fn bake_at(p_key: i32, p_wx: i32) {
    tod_reset();
    tod_set_weather(p_wx);
    tod_eval(g_env, tod_key_anchor(p_key), p_wx);
    tod_sky_keys(g_todsky);
    for (let c = 0; c < 3; c++) {
        g_skyk[SKYK_ZEN + c] = g_todsky[TODSKY_ZENITH_R + c] * 255.0;
        g_skyk[SKYK_MID + c] = g_todsky[TODSKY_MID_R + c] * 255.0;
        g_skyk[SKYK_HOR + c] = g_todsky[TODSKY_HORIZON_R + c] * 255.0;
        g_skyk[SKYK_CLOUD_LIT + c] = g_todsky[TODSKY_CLOUD_LIT_R + c] * 255.0;
        g_skyk[SKYK_CLOUD_SHADOW + c] = g_todsky[TODSKY_CLOUD_SHADOW_R + c] * 255.0;
        g_skyk[SKYK_SUN + c] = g_todsky[TODSKY_BODY_X + c];
    }
    g_skyk[SKYK_SUN] = 0.0 - g_todsky[TODSKY_BODY_X];
    g_skyk[SKYK_FOG] = env_field(g_env, ENV_FOG_R);
    g_skyk[SKYK_FOG + 1] = env_field(g_env, ENV_FOG_G);
    g_skyk[SKYK_FOG + 2] = env_field(g_env, ENV_FOG_B);
    g_skyk[SKYK_STAR_ALPHA] = g_todsky[TODSKY_STAR_ALPHA];
    let halo: f64 = g_todsky[TODSKY_HALO];
    g_skyk[SKYK_HALO_R] = 34.0 + 22.0 * halo;
    g_skyk[SKYK_HALO_EXP] = 1.8 - 0.6 * halo;
    g_skyk[SKYK_MOON_PHASE] = 0.5;
    let occ: f64 = clamp01((g_todsky[TODSKY_CLOUD_COVER] - 0.25) / 0.75);
    g_skyk[SKYK_CLOUD_COVER] = occ * 0.45;
    skygen_set_keys(g_skyk);
    skygen_bake_all();
}

// ---------------------------------------------------------------------------
// panorama readers
// ---------------------------------------------------------------------------
fn px_luma(p_x: i32, p_y: i32): f64 {
    let d: buffer = skygen_atlas().data;
    let xx: i32 = p_x % SKY_W;
    if (xx < 0) { xx = xx + SKY_W; }
    let o: i32 = (p_y * SKY_W + xx) * 4;
    let out: f64 = luma709(f64(d[o]), f64(d[o + 1]), f64(d[o + 2]));
    return out;
}

// (moon-anchor) THE SCREEN AREA OF ONE SKY TEXEL, DERIVED -- the old 6.83 was
// a 4:3 number (320 px over an 86.1 degree hfov) and survived the 16:9 change.
// The honest local scale is the focal length in pixels, `RES_H/2 / tan(fov/2)`,
// which `src/render/viewmodel.hml` and `world_render.sky_basis` both use.  The
// panorama carries 2pi over SKY_W in U and pi/2 over SKY_H-1 in V, so
//
//     px/texel = f * (2pi/SKY_W)   horizontally,  f * ((pi/2)/(SKY_H-1))  vertically
//
// At 320x180 / fov 58 that is 1.99 x 1.60 = 3.20 px of area per texel.  It is a
// LOWER BOUND on what the frame shows: the tan projection magnifies away from
// the centre, and the moon is deliberately placed off-centre, which is why the
// rendered blobs measure 863-1412 px against the ~400 this predicts.
fn px_per_texel(): f64 {
    let f: f64 = f64(g_RES_H) * 0.5 / tan(g_FOV_HIP * 0.5 * 0.017453292519943295);
    let out: f64 = (f * 6.283185307179586 / f64(SKY_W))
                 * (f * 1.5707963267948966 / f64(SKY_H - 1));
    return out;
}

// How many texels within `p_r` of the body clear `p_th` luminance.
fn body_texels_over(p_r: f64, p_th: f64): i32 {
    let uv: array<f64> = [0.0, 0.0];
    skygen_body_uv(uv, 0);
    let cu: f64 = uv[0];
    let cv: f64 = uv[1];
    let r: f64 = p_r;
    let n: i32 = 0;
    let y0: i32 = i32(floor(cv - r));
    let y1: i32 = i32(floor(cv + r)) + 1;
    if (y0 < 0) { y0 = 0; }
    if (y1 > SKY_H - 1) { y1 = SKY_H - 1; }
    let y: i32 = y0;
    while (y <= y1) {
        let x: i32 = i32(floor(cu - r)) - 1;
        let xe: i32 = i32(floor(cu + r)) + 1;
        while (x <= xe) {
            let dx: f64 = f64(x) - cu;
            let dy: f64 = f64(y) - cv;
            if (dx * dx + dy * dy <= r * r) {
                if (px_luma(x, y) >= p_th) { n = n + 1; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let out: i32 = n;
    return out;
}

// The panorama's V is elevation: v = (1 - el/90deg) * (SKY_H - 1).
fn v_to_elev_deg(p_v: f64): f64 {
    let out: f64 = (1.0 - p_v / f64(SKY_H - 1)) * 90.0;
    return out;
}

fn main() {
    print("probe_nightanchor — the night's BRIGHT half (CLAUDE.md §8)");
    print("");

    g_todsky = [];
    for (let i = 0; i < TODSKY_COUNT; i++) { g_todsky.push(0.0); }
    g_skyk = skygen_keys_new();
    skygen_init();
    skygen_set_clock(0.0);

    let uv: array<f64> = [0.0, 0.0];

    // -----------------------------------------------------------------------
    print("[1] the body at night is the MOON, and at noon it is the SUN");
    // -----------------------------------------------------------------------
    // The flag comes from tod.hml, which has carried it since W2-4 and which
    // no caller has ever forwarded. It is read here through exactly the bridge
    // the frame uses, so if a caller ever DOES forward it this still holds.
    bake_at(TOD_NOON, WX_CLEAR);
    let noon_moon: f64 = skygen_body_moon();
    print(`  noon  body_moon ${f4(noon_moon)}   sun_is_up ${skygen_sun_is_up()}`);
    ok("noon draws the sun", noon_moon == 0.0);

    bake_at(TOD_NIGHT, WX_CLEAR);
    let night_moon: f64 = skygen_body_moon();
    skygen_body_uv(uv, 0);
    let nu: f64 = uv[0];
    let nv: f64 = uv[1];
    print(`  22:00 body_moon ${f4(night_moon)}   body u,v = ${f4(nu)}, ${f4(nv)}`);
    ok("22:00 draws the moon", night_moon == 1.0);

    bake_at(TOD_DEEP, WX_CLEAR);
    ok("02:00 draws the moon", skygen_body_moon() == 1.0);

    // The one weather that shares the night with the flagship violet scene.
    // `ns_bloom` renders at 22:00 under WX_BLOOM; if the flag did not survive
    // the weather blend the money shot would keep its golden midnight sun.
    bake_at(TOD_NIGHT, WX_BLOOM);
    ok("22:00 under the nightshade bloom still draws the moon",
       skygen_body_moon() == 1.0);

    // -----------------------------------------------------------------------
    print("[2] the disc clears the ART_BIBLE §8 bar of 220, with margin");
    // -----------------------------------------------------------------------
    bake_at(TOD_NIGHT, WX_CLEAR);
    skygen_body_uv(uv, 0);
    let cu: f64 = uv[0];
    let cv: f64 = uv[1];
    let centre: f64 = px_luma(i32(cu + 0.5), i32(cv + 0.5));
    let moon_alb: f64 = luma709(f64(pal_r(g_MOON_DISC)), f64(pal_g(g_MOON_DISC)),
                                f64(pal_b(g_MOON_DISC)));
    print(`  MOON_DISC albedo luminance ${f4(moon_alb)}   baked centre ${f4(centre)}`);
    // MOON_DISC is (220,228,240) = 227.2 by Rec.709. The bar is a LITERAL 220,
    // not `moon_alb - epsilon`: a bound derived from the thing it guards passes
    // for ever. The panorama reaches the screen UNDARKENED (measured: SUN_DISC
    // lands as exactly (255,244,200) on a rendered frame), so a texel over 220
    // here is a pixel over 220 there.
    ok("the baked disc centre is at or above 220", centre >= 220.0);
    ok("the disc is the MOON's colour, not the SUN's",
       adiff(centre, moon_alb) < 1.5);

    // 13 texels is 41 screen px at the shipping camera, so this is the >= 40 px
    // contiguous region the rule asks for, arithmetically. 120 is ~9x that: the
    // assertion is that the disc is a DISC, not that some texel got lucky.
    let over220: i32 = body_texels_over(11.0, 220.0);
    let disc_px: f64 = f64(over220) * px_per_texel();
    print(`  disc texels >= 220: ${over220}  ==  ${f4(disc_px)} screen px`);
    note(`the 22:00 moon carries ${over220} sky texels over luminance 220 == ${f4(disc_px)} screen px`);
    ok("the disc is a large contiguous region, not a sparkle", over220 >= 120);

    // The mare are MOON_MARE (168,180,200) = 178.6 and are BELOW the bar on
    // purpose: a disc with no internal structure is a sticker. This checks
    // they did not eat the disc.
    let over178: i32 = body_texels_over(11.0, 178.0);
    ok("the mare are darker than the disc but do not eat it",
       over178 > over220 && over220 * 100 > over178 * 60);

    // -----------------------------------------------------------------------
    print("[3] the moon is INSIDE the visible band of a playing camera");
    // -----------------------------------------------------------------------
    // >>> THIS SECTION USED TO BE SIZED AGAINST A CAMERA THE GAME NO LONGER
    // >>> HAS, AND THAT IS WHY IT PASSED WHILE THE MOON SHIPPED CLIPPED.
    // It read: "the five authored night cameras run pitch -8 to 0 at a 70
    // degree fov, so the tightest band top is 27 degrees", and it asserted
    // `el + 6.19 < 27.0` against an 18.06-degree moon.  70 was the 4:3 vertical
    // fov.  The 16:9 conversion moved `g_FOV_HIP` to 58, which makes the same
    // band top 21 degrees, and 18.06 + 6.23 = 24.29 OVERRUNS IT -- measured on
    // the rendered frame as blob rows 0..30 (`flat_debug`) and 0..41
    // (`hub_dawn`), a moon cut in half by the top of the screen.  A stale
    // constant in a TEST is worse than one in the code: this one turned the
    // defect into a green tick.
    //
    // Nothing below is a typed angle any more.  Every bound is recomputed HERE
    // from `g_FOV_HIP` / `g_RES_H` and compared against skygen's own derivation,
    // so the two have to agree and the next aspect change moves both.
    let el: f64 = v_to_elev_deg(cv);
    let half: f64 = g_FOV_HIP * 0.5;
    let pitch_floor: f64 = -8.0;                 // flat_debug, the steepest authored
    let band_px: f64 = 14.0;                     // the HUD top band at 320x180
    let pxdeg: f64 = f64(g_RES_H) / g_FOV_HIP;
    let rdeg: f64 = skygen_moon_disc_deg();
    let want: f64 = half + pitch_floor - rdeg - band_px / pxdeg;
    let cap: f64 = skygen_moon_el_max();
    print(`  fov ${f4(g_FOV_HIP)} -> band top ${f4(half + pitch_floor)} deg at pitch ${f4(pitch_floor)}`);
    print(`  disc radius ${f4(rdeg)} deg   HUD band ${f4(band_px / pxdeg)} deg   ceiling ${f4(cap)} deg`);
    print(`  22:00 moon elevation ${f4(el)} deg   disc top ${f4(el + rdeg)} deg`);
    note(`the moon ceiling is DERIVED from g_FOV_HIP=${f4(g_FOV_HIP)}: ${f4(cap)} deg`);
    note(`the 22:00 moon sits at ${f4(el)} deg elevation, disc top ${f4(el + rdeg)} deg, band top ${f4(half + pitch_floor)} deg`);
    ok("skygen's ceiling is the one this file re-derives from config",
       adiff(cap, want) < 0.0001);
    ok("the ceiling really is fov-dependent (it moves with g_FOV_HIP)",
       adiff(cap, 20.90) > 1.0);
    ok("the 22:00 disc is at or under the ceiling", el <= cap + 0.0001);
    ok("the WHOLE disc clears the top of frame at the steepest authored pitch",
       el + rdeg < half + pitch_floor);
    // ... and clears the HUD's own top band as well, so the anchor is not
    // hiding behind the compass plate.  PIXELS, not degrees, because that is
    // what the band is.  `pxdeg` is the frame AVERAGE; the true local scale at
    // the top of a tan projection is larger, so this bound is conservative and
    // the rendered margin is bigger than it claims (measured: 19 px at pitch
    // -8 against the 14 asserted here).
    ok("the disc top clears the HUD band in target pixels",
       (half + pitch_floor - (el + rdeg)) * pxdeg >= band_px);
    // ... and not so low that it is buried in the fog band and the terrain.
    // The stars are fully gone by v = 0.92 of the panorama, which is elevation
    // 7.2 degrees; the disc CENTRE must stay above that or the moon is a smudge
    // in the mist.  The old bound was 10.0 and the ceiling is 10.26, so this is
    // still met -- but it is stated against the thing it protects now.
    ok("the moon centre is clear of the horizon mist (> 7.2 deg)", el > 7.2);

    // 02:00 USED TO BE THE HOUR THE MOON WAS OVERHEAD AND OFF SCREEN.
    // DEEP's key sits at dir.y 0.8988 -- 64 degrees -- and probe_tod pins it
    // there, so the KEY is untouched.  The DRAWN DISC is capped like every
    // other night hour, which is what puts an anchor in a 02:00 frame at all.
    // The cost is real and is not hidden: at DEEP the disc and its own shading
    // key disagree by ~54 degrees.  See skygen.hml's MOON_PITCH_FLOOR block.
    bake_at(TOD_DEEP, WX_CLEAR);
    skygen_body_uv(uv, 0);
    let el_deep: f64 = v_to_elev_deg(uv[1]);
    let key_deep: f64 = asin(0.8988) * 57.29577951308232;
    print(`  02:00 moon elevation ${f4(el_deep)} deg  (its key is at ${f4(key_deep)} deg)`);
    note(`02:00's disc is drawn at ${f4(el_deep)} deg while DEEP's key is at ${f4(key_deep)} deg — a ${f4(key_deep - el_deep)} deg disagreement, reported not hidden`);
    ok("02:00's disc is inside the playing band too", el_deep <= cap + 0.0001);
    ok("02:00's disc clears the top of frame at the steepest authored pitch",
       el_deep + rdeg < half + pitch_floor);

    // -----------------------------------------------------------------------
    print("[4] the corona implies light, and the limb stays hard");
    // -----------------------------------------------------------------------
    bake_at(TOD_NIGHT, WX_CLEAR);
    skygen_body_uv(uv, 0);
    cu = uv[0];
    cv = uv[1];
    // Sampled along +U at the body's own row, so the gradient row is identical
    // for all three and only the corona differs.
    let just_out: f64 = px_luma(i32(cu + 13.0), i32(cv + 0.5));
    let mid_out: f64 = px_luma(i32(cu + 22.0), i32(cv + 0.5));
    let far_out: f64 = px_luma(i32(cu + 40.0), i32(cv + 0.5));
    print(`  luminance at r = 13 / 22 / 40 texels: ${f4(just_out)} / ${f4(mid_out)} / ${f4(far_out)}`);
    note(`moon corona: ${f4(just_out)} at the limb, ${f4(mid_out)} mid, ${f4(far_out)} clear sky`);
    ok("the corona lifts the sky next to the limb", just_out > far_out + 20.0);
    ok("the corona falls off monotonically",
       just_out > mid_out && mid_out > far_out);
    // MOON_HALO_R is 30, so at r = 40 the corona contributes exactly zero and
    // what is left is the night sky's own gradient. The bound is a literal
    // fifth of the disc rather than a delta against another sample, because
    // every other sample on this row can carry a cloud or a star.
    ok("the corona is spent by r = 40 (MOON_HALO_R is 30)",
       far_out < centre * 0.20);
    // A corona brighter than about half the disc reads as a pale hole in the
    // sky rather than as a glow, and the hard limb §11.3 asks for is gone.
    ok("the limb is still a STEP: the corona is under half the disc",
       just_out * 2.0 < centre);

    // -----------------------------------------------------------------------
    print("[5] the sun -> moon crossfade is continuous and monotone");
    // -----------------------------------------------------------------------
    // tod.hml's KF_MOON lerps 0 -> 1 across the DUSK -> NIGHT segment, so the
    // swap is a dissolve, not a one-frame colour pop. Walked at the keyframe
    // anchors plus the two ends.
    let d0: f64 = tod_key_anchor(TOD_DUSK);
    let d1: f64 = tod_key_anchor(TOD_NIGHT);
    let prev: f64 = -1.0;
    let bad_mono: i32 = 0;
    let max_step: f64 = 0.0;
    let i: i32 = 0;
    while (i <= 40) {
        let t: f64 = d0 + (d1 - d0) * (f64(i) / 40.0);
        tod_reset();
        tod_set_weather(WX_CLEAR);
        tod_eval(g_env, t, WX_CLEAR);
        tod_sky_keys(g_todsky);
        let m: f64 = g_todsky[TODSKY_MOON];
        if (m < prev - 0.000000001) { bad_mono = bad_mono + 1; }
        if (prev >= 0.0) {
            let s: f64 = adiff(m, prev);
            if (s > max_step) { max_step = s; }
        }
        prev = m;
        i = i + 1;
    }
    print(`  worst step over 1/40 of the DUSK->NIGHT segment: ${f4(max_step)}`);
    ok("the moon amount never goes backwards into the night", bad_mono == 0);
    ok("the moon amount is a dissolve, not a step", max_step < 0.20);
    ok("the segment ends at a full moon and starts at none", prev == 1.0);

    // -----------------------------------------------------------------------
    print("[6] THE GROUND DID NOT MOVE — the inversion is graded on it");
    // -----------------------------------------------------------------------
    // Flat ground catches `ambient + dir.y * key`. The NIGHT key came down from
    // 33.0 to 18.06 degrees so the moon would be in shot, and the key colour
    // was rescaled by 0.5446/0.3100 in the two channels with headroom so this
    // product is unchanged. These are the PRE-CHANGE products, written as
    // literals: 0.5446*0.30 = 0.163380 and 0.5446*0.32 = 0.174272.
    tod_reset();
    tod_set_weather(WX_CLEAR);
    tod_eval(g_env, tod_key_anchor(TOD_NIGHT), WX_CLEAR);
    let ny: f64 = env_field(g_env, ENV_SUN_Y);
    let kr: f64 = env_field(g_env, ENV_SUN_R);
    let kg: f64 = env_field(g_env, ENV_SUN_G);
    let kb: f64 = env_field(g_env, ENV_SUN_B);
    let ar: f64 = env_field(g_env, ENV_AMB_R);
    let ag: f64 = env_field(g_env, ENV_AMB_G);
    let ab: f64 = env_field(g_env, ENV_AMB_B);
    print(`  22:00 key dir.y ${f4(ny)}  key rgb (${f4(kr)}, ${f4(kg)}, ${f4(kb)})`);
    print(`        flat-ground gain (${f4(ar + ny * kr)}, ${f4(ag + ny * kg)}, ${f4(ab + ny * kb)})`);
    note(`22:00 flat-ground light (${f4(ar + ny * kr)}, ${f4(ag + ny * kg)}, ${f4(ab + ny * kb)}) at key elevation ${f4(asin(ny) * 57.29577951308232)} deg`);
    ok("the red the ground catches is what it was", adiff(ny * kr, 0.163380) < 0.0005);
    ok("the green the ground catches is what it was", adiff(ny * kg, 0.174272) < 0.0005);
    // Blue CANNOT be rescaled: the ambient's blue is 0.91 and `ambient + sun`
    // is capped at 1 per channel, so the key's blue is pinned at 0.09. The cost
    // is bounded here rather than left to be discovered.
    ok("the blue the ground gives up is under a quarter of a byte of albedo",
       (0.163380 / 0.30 * 0.09 - ny * kb) * 32.0 < 0.75);
    // The whole point of the veil is that night is the darkest ground of the
    // day; a key change that lifted it would undo the inversion.
    ok("ambient + key still fits the multiply-only budget",
       ar + kr <= 1.0 && ag + kg <= 1.0 && ab + kb <= 1.0);

    tod_reset();
    tod_set_weather(WX_CLEAR);
    tod_eval(g_env, tod_key_anchor(TOD_DEEP), WX_CLEAR);
    let dy2: f64 = env_field(g_env, ENV_SUN_Y);
    let deep_g: f64 = env_field(g_env, ENV_AMB_G) + dy2 * env_field(g_env, ENV_SUN_G);
    let night_g: f64 = ag + ny * kg;
    print(`  flat-ground GREEN: 22:00 ${f4(night_g)}   02:00 ${f4(deep_g)}`);
    ok("02:00 is still darker than 22:00 on flat ground", deep_g < night_g);

    // >>> WHAT IS DELIBERATELY *NOT* ASSERTED HERE.
    // "night is darker than golden hour" is NOT a statement about this number.
    // Flat-ground GAIN at 22:00 (green 0.5642) is legitimately higher than at
    // golden hour (a 9-degree key puts almost nothing on flat ground), and it
    // always was — what makes the night dark is THE VEIL, which multiplies the
    // whole world down afterwards and which `tools/probe_night.hml` owns. An
    // assertion here would be measuring the wrong stage and would fail on a
    // correct build. The elevation itself is pinned instead, because that is
    // what this task changed and what a future edit would silently undo.
    // (moon-anchor) This used to read "the 22:00 key elevation is the one the
    // moon is placed at".  It is not, any more, and that is the point: the
    // DISC is capped by skygen against the shipping fov while the KEY stays
    // exactly where tod.hml put it, because the key is the LIGHT and the light
    // is what the inversion is graded on.  The literal stays; only the claim
    // around it changed.
    ok("the 22:00 key direction is untouched — the ground cannot have moved",
       adiff(ny, 0.3100) < 0.0001);

    // -----------------------------------------------------------------------
    print("[7] the day did not move");
    // -----------------------------------------------------------------------
    // The noon body must still be the SUN, at full strength.  It is measured as
    // a COUNT of texels at or above 240 inside SUN_DISC_R, not as the centre
    // texel: pass 5 draws the clouds AFTER the body and at NOON the coverage is
    // 0.25, so the centre texel is often cloud (measured 189.4).  240 separates
    // the two bodies outright — SUN_DISC is 243.2 and MOON_DISC is 227.2 — so
    // a non-zero count is proof the sun is there and is unfaded.
    bake_at(TOD_NOON, WX_CLEAR);
    let sun_alb: f64 = luma709(f64(pal_r(g_SUN_DISC)), f64(pal_g(g_SUN_DISC)),
                               f64(pal_b(g_SUN_DISC)));
    let sun_hot: i32 = body_texels_over(9.0, 240.0);
    print(`  noon: ${sun_hot} texels >= 240 inside SUN_DISC_R  (SUN_DISC albedo ${f4(sun_alb)})`);
    note(`the noon sun still bakes ${sun_hot} texels at or above 240; MOON_DISC could not reach it (227.2)`);
    // MEASURED 16 of the 254 texels inside SUN_DISC_R, because NOON's cloud
    // coverage buries most of the disc — that is pre-existing and correct, and
    // it is why the bound is 8 and not 200. Independently confirmed: every
    // rendered frame from 05:30 through 19:30 is FNV-IDENTICAL before and after
    // this task (ridge_golden at tod 5.5 / 12.0 / 18.25 / 19.5).
    ok("the noon sun disc is still SUN_DISC, hard and unfaded", sun_hot >= 8);

    // (moon-anchor) THE CAP IS THE MOON'S ALONE.  A sun clipped by the top of
    // the frame is a sun you are squinting past, which is correct, and daylight
    // has a hundred things over 220 already.  So at noon the drawn body must be
    // EXACTLY the sun antipode, to the bit -- if the cap ever leaked into the
    // day it would show up here first.
    let sunuv: array<f64> = [0.0, 0.0];
    skygen_sun_uv(sunuv, 0);
    skygen_body_uv(uv, 0);
    print(`  noon body v ${f4(uv[1])}  vs sun v ${f4(sunuv[1])}  (elev ${f4(v_to_elev_deg(uv[1]))} deg)`);
    ok("the noon body is the sun's own V, uncapped", adiff(uv[1], sunuv[1]) < 0.000001);
    ok("the noon sun is ABOVE the moon's ceiling, i.e. the cap did not fire",
       v_to_elev_deg(uv[1]) > skygen_moon_el_max() + 1.0);

    // -----------------------------------------------------------------------
    print("[8] the disc SLIDES down as it becomes a moon — it does not teleport");
    // -----------------------------------------------------------------------
    // The cap is lerped by tod.hml's own sun->moon crossfade, so the body walks
    // from its true elevation to the capped one over the same minutes the disc
    // turns from a sun into a moon.  A bare min() would have jumped it the
    // instant the flag crossed a threshold, which at 320x180 is a pop.
    let e0: f64 = tod_key_anchor(TOD_DUSK);
    let e1: f64 = tod_key_anchor(TOD_NIGHT);
    let pv: f64 = -999.0;
    let worst: f64 = 0.0;
    let over: i32 = 0;
    let j: i32 = 0;
    while (j <= 20) {
        let t2: f64 = e0 + (e1 - e0) * (f64(j) / 20.0);
        tod_reset();
        tod_set_weather(WX_CLEAR);
        tod_eval(g_env, t2, WX_CLEAR);
        tod_sky_keys(g_todsky);
        for (let c2 = 0; c2 < 3; c2++) {
            g_skyk[SKYK_ZEN + c2] = g_todsky[TODSKY_ZENITH_R + c2] * 255.0;
            g_skyk[SKYK_MID + c2] = g_todsky[TODSKY_MID_R + c2] * 255.0;
            g_skyk[SKYK_HOR + c2] = g_todsky[TODSKY_HORIZON_R + c2] * 255.0;
            g_skyk[SKYK_SUN + c2] = g_todsky[TODSKY_BODY_X + c2];
        }
        g_skyk[SKYK_SUN] = 0.0 - g_todsky[TODSKY_BODY_X];
        g_skyk[SKYK_STAR_ALPHA] = g_todsky[TODSKY_STAR_ALPHA];
        g_skyk[SKYK_CLOUD_COVER] = 0.0;
        skygen_set_keys(g_skyk);
        // The placement is done in `sky_snapshot`, which only runs on a BAKE.
        // Reading body_uv straight after set_keys returns the PREVIOUS
        // snapshot's body -- which is how the first version of this loop
        // measured a worst step of exactly 0.0000 degrees and looked green.
        skygen_bake_all();
        skygen_body_uv(uv, 0);
        let ev: f64 = v_to_elev_deg(uv[1]);
        if (ev > skygen_moon_el_max() + 0.0001 && g_todsky[TODSKY_MOON] >= 0.999) { over = over + 1; }
        if (pv > -900.0) {
            let st: f64 = adiff(ev, pv);
            if (st > worst) { worst = st; }
        }
        pv = ev;
        j = j + 1;
    }
    print(`  worst elevation step over 1/20 of the DUSK->NIGHT segment: ${f4(worst)} deg`);
    note(`the disc slides down over the crossfade; worst step ${f4(worst)} deg per 1/20 segment`);
    ok("the body never jumps more than a disc radius in one step", worst < skygen_moon_disc_deg());
    ok("a fully-crossfaded moon is never above the ceiling anywhere on the segment", over == 0);

    // -----------------------------------------------------------------------
    print("[9] THE CEILING LAW — an additive card cannot outshine its own tint");
    // -----------------------------------------------------------------------
    // (real-night-anchor, 2026-07-31)  The moon is ONE object at ONE azimuth,
    // so it can never be the whole answer to "every night frame needs a bright
    // anchor".  The rest of the answer has to come from lamps, and the reason
    // there were none is arithmetic that nobody had written down:
    //
    //     BLEND_ADD contributes  texel * tint * alpha / 255^2,
    //     so  ceiling = Rec709(tint) * alpha / 255   (+ what is behind it)
    //
    // and NOTHING a texture does can exceed it.  `src/art/fxgen.hml`
    // `cell_glow` already records one attempt to beat it from the texture side
    // -- a radius-9 gain-40 splat that rendered the lantern as a hard white
    // square -- and `src/art/tod.hml` E5 says ">>> DO NOT SOLVE THIS IN
    // fxgen.hml".  Both are right, and this section is why: the ceiling is a
    // property of the CALL SITE, and no cell can be authored past it.
    //
    // MEASURED IN THE SHIPPING GAME, /tmp/ns_base at f4644f7, DISPLAY=:0,
    // native 320x180, HUD off (H twice) and viewmodel off (--vm 0), the player
    // standing in his own town at 22:00, eight yaws at 45 degrees:
    //     largest contiguous WORLD component over 220 = 0 px at all eight.
    // The two non-zero components in the set were 6 px and 4 px of SKY (tier-1
    // stars).  The town's lit windows are `settle_render.hml`'s UI_AMBER cards
    // at alpha 215, and row 2 below is the whole explanation.
    let a205: f64 = 205.0 / 255.0;
    let a210: f64 = 210.0 / 255.0;
    let a215: f64 = 215.0 / 255.0;
    let lw: f64 = luma709(f64(pal_r(g_WINDOW_LIGHT)), f64(pal_g(g_WINDOW_LIGHT)),
                          f64(pal_b(g_WINDOW_LIGHT)));
    let la: f64 = luma709(f64(pal_r(g_UI_AMBER)), f64(pal_g(g_UI_AMBER)),
                          f64(pal_b(g_UI_AMBER)));
    let le: f64 = luma709(f64(pal_r(g_EMBER)), f64(pal_g(g_EMBER)), f64(pal_b(g_EMBER)));
    let lu: f64 = luma709(f64(pal_r(g_UI_WHITE)), f64(pal_g(g_UI_WHITE)),
                          f64(pal_b(g_UI_WHITE)));
    let lm: f64 = luma709(f64(pal_r(g_MUZZLE_CORE)), f64(pal_g(g_MUZZLE_CORE)),
                          f64(pal_b(g_MUZZLE_CORE)));
    let ls: f64 = luma709(f64(pal_r(g_STAR_BRIGHT)), f64(pal_g(g_STAR_BRIGHT)),
                          f64(pal_b(g_STAR_BRIGHT)));
    print(`  WINDOW_LIGHT ${f4(lw)}   UI_AMBER ${f4(la)}   EMBER ${f4(le)}`);
    print(`  UI_WHITE ${f4(lu)}   MUZZLE_CORE ${f4(lm)}   STAR_BRIGHT ${f4(ls)}`);
    print(`  WINDOW_LIGHT at a205 ${f4(lw * a205)}  a210 ${f4(lw * a210)}  a255 ${f4(lw)}`);
    print(`  UI_AMBER at a215 ${f4(la * a215)}  a255 ${f4(la)}`);
    note(`ceiling law: WINDOW_LIGHT ${f4(lw)} is ON the 220 bar, UI_AMBER ${f4(la)} is under it at any alpha`);

    // 1. g_WINDOW_LIGHT is the ONLY warm lamp colour in the palette that
    //    reaches the bar, and it reaches it EXACTLY, so a lamp card anchors
    //    only at alpha 255.  A tighter bound than 220 would be a lie about a
    //    colour that lands on 220.3.
    ok("g_WINDOW_LIGHT at alpha 255 clears the 220 bar", lw >= 220.0);
    ok("g_WINDOW_LIGHT lands ON the bar, not comfortably over it", lw < 221.0);
    // 2. THE SHIPPING TOWN'S WINDOWS CANNOT ANCHOR ANYTHING.  This is not a
    //    tuning opinion; UI_AMBER's own luminance is below the bar, so no
    //    alpha, no card size and no texture edit can put one over 220.
    ok("g_UI_AMBER cannot reach 220 at alpha 255 — settle_render's windows can never anchor", la < 220.0);
    ok("g_EMBER cannot reach 220 at alpha 255 — an unlit lantern can never anchor", le < 220.0);
    // 3. The three near-whites that CAN. The muzzle flash is UI_WHITE at 255,
    //    which is why muzzle_fog is the one scene that ever passed.
    ok("g_UI_WHITE clears the bar at alpha 255", lu >= 220.0);
    ok("g_MUZZLE_CORE clears the bar at alpha 255", lm >= 220.0);
    ok("g_STAR_BRIGHT clears the bar at alpha 255", ls >= 220.0);
    // 4. The three shipping alphas that were measured failing, pinned as
    //    literals so nobody re-derives them.  205 was tools/shot.hml's window,
    //    210 is src/game/main.hml:1240's lit Great Lantern, 215 is
    //    src/render/settle_render.hml:704's town window.
    ok("alpha 205 on WINDOW_LIGHT could not anchor (shot.hml's old window)", lw * a205 < 220.0);
    ok("alpha 210 on WINDOW_LIGHT cannot anchor (main.hml:1240, the LIT Great Lantern)", lw * a210 < 220.0);
    ok("alpha 215 on UI_AMBER cannot anchor (settle_render.hml:704, the town)", la * a215 < 220.0);

    // -----------------------------------------------------------------------
    print("[10] THE LAMP THAT CLEARS IT — the construction, and its guard rail");
    // -----------------------------------------------------------------------
    // (the-lamp, 2026-07-31)  Section [9] is the diagnosis and it is complete;
    // this is the cure, pinned so it cannot be un-pinned by a tuning pass.
    //
    // The lamp is THREE additive cards, smallest last, and every number below
    // is IMPORTED from `src/render/settle_render.hml` rather than retyped —
    // CLAUDE.md rule 8, "a stale constant in a TEST is worse than one in the
    // code", and this file has been burned by exactly that once already (see
    // section [3]'s block on the fov-70 ceiling that certified a clipped moon).
    //
    //     haze   EMBER        a 76   size 1.90 s     the air around the flame
    //     body   MUZZLE_MID   a132   size 1.00 s     the falloff
    //     core   MUZZLE_CORE  a255   size 0.62 s     THE ANCHOR
    //
    // THE ONE ASSERTION THAT MATTERS MOST IS NOT "THE CORE IS BRIGHT".  It is
    // that HAZE + BODY TOGETHER STAY UNDER 220.  Additive cards stack, so if
    // the two amber cards summed over the bar, the >220 region would be the
    // size of the BIGGEST card instead of the smallest and the lamp would
    // render as the hard white blob `src/art/fxgen.hml` records as the fifth
    // time this rule was gamed.  A small bright core with a warm falloff is a
    // lamp; a large flat white disc is a sticker, and the arithmetic that
    // separates them is one addition.
    let ah: f64 = MG_LAMP_A_HAZE / 255.0;
    let ab2: f64 = MG_LAMP_A_BODY / 255.0;
    let ac: f64 = MG_LAMP_A_CORE / 255.0;
    let lmm: f64 = luma709(f64(pal_r(g_MUZZLE_MID)), f64(pal_g(g_MUZZLE_MID)),
                           f64(pal_b(g_MUZZLE_MID)));
    let c_haze: f64 = le * ah;
    let c_body: f64 = lmm * ab2;
    let c_core: f64 = lm * ac;
    print(`  haze ${f4(c_haze)}   body ${f4(c_body)}   falloff sum ${f4(c_haze + c_body)}   core ${f4(c_core)}`);
    note(`the lamp's amber falloff sums to ${f4(c_haze + c_body)} — ${f4(220.0 - c_haze - c_body)} under the bar — and its core to ${f4(c_core)}`);
    ok("the CORE clears 220 on its own", c_core >= 220.0);
    ok("the core clears it with real margin, not by a rounding", c_core >= 240.0);
    ok("the HAZE is frankly under the bar", c_haze < 220.0);
    ok("the BODY is frankly under the bar", c_body < 220.0);
    // >>> THE GUARD RAIL.
    ok("haze + body TOGETHER stay under 220 — only the smallest card is bright",
       c_haze + c_body < 220.0);
    ok("and they stay under it with room, so a fog-free near view cannot tip it",
       c_haze + c_body < 190.0);
    // The bright region is bounded by the SMALLEST card. If a later pass ever
    // makes the core the biggest of the three, the lamp becomes a white disc
    // with an amber rim, which is the same defect wearing a different hat.
    ok("the core card is the smallest of the three",
       MG_LAMP_S_CORE < MG_LAMP_S_BODY && MG_LAMP_S_BODY < MG_LAMP_S_HAZE);

    // The town's windows are the same law with the town's own colour. The body
    // stays UI_AMBER — the settlement does not change hue — and only the core
    // is near-white.
    let wb: f64 = la * (MG_LAMP_WIN_A_BODY / 255.0);
    let wc: f64 = lm * (MG_LAMP_WIN_A_CORE / 255.0);
    print(`  window body ${f4(wb)} (UI_AMBER a${i32(MG_LAMP_WIN_A_BODY)})   window core ${f4(wc)}`);
    note(`the town window's amber stays at ${f4(wb)} and its core reaches ${f4(wc)}`);
    ok("the town window's amber body is still honestly under the bar", wb < 220.0);
    ok("the town window's core clears the bar", wc >= 220.0);
    ok("the window core card is smaller than the amber it sits in",
       MG_LAMP_WIN_CORE_F < 1.0 && MG_LAMP_WIN_CORE_F > 0.0);

    // WHAT IS DELIBERATELY *NOT* ASSERTED HERE, for the same reason as the
    // header's warning: this file cannot measure a screen region. It cannot
    // know that the core is 40 contiguous pixels at 15 m — that is
    // `nightshade --anchorscan 22`, in the shipping binary, and its table is in
    // the task report. What is pinned here is every arithmetic fact that has to
    // hold for that measurement to keep reproducing.
    //
    // Nor is the FOG REACH asserted. `src/render/fx.hml` scales sprite alpha by
    // `1 - fog * 0.85`, so the core's ceiling falls with distance and stops
    // clearing 220 somewhere past 35 m; reproducing that curve here would be a
    // second copy of `shade.hml`'s smoothstep, which is the stale-literal trap
    // this section is otherwise careful to avoid. It is MEASURED in the report.

    print("");
    print("--- notes ---");
    let ni: i32 = 0;
    while (ni < g_notes.length) { print(`  ${g_notes[ni]}`); ni = ni + 1; }
    print("");
    if (g_n != g_EXPECTED_ASSERTIONS) {
        print(`FAIL assertion count: ran ${g_n}, expected ${g_EXPECTED_ASSERTIONS} — a branch was skipped`);
        exit(1);
    }
    if (g_pass == g_n) { print(`PASS ${g_pass}/${g_n}`); }
    else {
        print(`FAIL ${g_pass}/${g_n}`);
        exit(1);
    }
}

main();
