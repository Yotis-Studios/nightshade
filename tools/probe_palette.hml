// probe_palette.hml — verification program for W2-3 (src/art/palette.hml).
//
// W2-3 owns exactly one file, so every assertion lives inside
// `pal_selftest()`; this is the driver that gives it an exit code. It links
// nothing — no SDL, no wobbleweed, no engine — because the palette is pure
// data. `nm` on the compiled binary finds zero SDL symbols.
//
//     hemlockc -O1 tools/probe_palette.hml -o /tmp/probe_palette
//     /tmp/probe_palette                     # no display needed at all
//
// Exits 0 only if every assertion held AND the number of assertions executed
// equals `g_PAL_SELFTEST_ASSERTS`.

import { exit } from "@stdlib/process";
import { pal_selftest } from "../src/art/palette.hml";

fn main() {
    let fails: i32 = pal_selftest();
    if (fails != 0) {
        print(`probe_palette: FAILED (${fails})`);
        exit(1);
    }
    print("probe_palette: OK");
    exit(0);
}

main();
