// ---------------------------------------------------------------------------
//  CONFIGURATION
// ---------------------------------------------------------------------------
let g_PS_SEED: i32     = 1337;      // the seed both hours run
let g_PS_MINUTES: i32  = 60;        // THE HOUR
let g_PS_DT_MS: f64    = 16.667;
let g_PS_SAMPLE: i32   = 60 * 60;   // one sample per game minute, in frames
// The seed sweep. 30 minutes, not 24: `settle_step` holds the threshold one
// continuous in-game day before promoting, so the Village lands at ~25:00 and a
// 24-minute window stops before the thing it exists to assert (probe_lanfeed's
// own note, and the same mistake cost THE_HOUR_2 a section).
let g_PS_SEEDS: i32    = 8;
let g_PS_SWEEP_MIN: i32 = 30;
let g_PS_EXPECT: i32   = 44;        // counted from the run, then pinned

// ---------------------------------------------------------------------------
//  ASSERTIONS
// ---------------------------------------------------------------------------
fn sv(p_v): string { let out: string = `${p_v}`; return out; }

let g_n: i32 = 0;
let g_ok: i32 = 0;

fn ck(p_ok: bool, p_msg: string) {
    g_n = g_n + 1;
    if (p_ok) { g_ok = g_ok + 1; }
    if (!p_ok) { print("  FAIL [" + sv(g_n) + "] " + p_msg); }
}

fn compiled(): i32 {
    let a0: string = args[0];
    let out: i32 = 1;
    if (a0.ends_with(".hml")) { out = 0; }
    return out;
}

fn f1(p_x: f64): string { let out: string = sv(floor(p_x * 10.0) / 10.0); return out; }

fn padl(p_s: string, p_w: i32): string {
    let s: string = p_s;
    while (s.length < p_w) { s = " " + s; }
    let out: string = s;
    return out;
}
fn padr(p_s: string, p_w: i32): string {
    let s: string = p_s;
    while (s.length < p_w) { s = s + " "; }
    let out: string = s;
    return out;
}
fn pi(p_v: i32, p_w: i32): string { let out: string = padl(sv(p_v), p_w); return out; }

fn mmss(p_s: i32): string {
    let m: i32 = p_s / 60;
    let r: i32 = p_s - m * 60;
    let pad: string = "";
    if (r < 10) { pad = "0"; }
    let out: string = sv(m) + ":" + pad + sv(r);
    return out;
}

fn phase_ch(p_p: i32): string {
    if (p_p == PHASE_DAWN) { let a: string = "dawn"; return a; }
    if (p_p == PHASE_DAY) { let b: string = "day "; return b; }
    if (p_p == PHASE_DUSK) { let c: string = "dusk"; return c; }
    let d: string = "NGHT";
    return d;
}

// ---------------------------------------------------------------------------
//  THE SESSION — `main.hml`'s run_loop with the window, the renderer and the
//  wall clock removed.  Identical in shape to probe_firstminute §HARNESS on
//  purpose: a probe that drives a different loop tests a loop nobody ships.
// ---------------------------------------------------------------------------
fn session_new(p_seed: i32, p_errand: i32): object {
    let net: object = transport_loopback();
    let sv2: object = server_new(p_seed, net);
    let cl: object = client_new(net, p_seed);
    let s: object = {
        seed: p_seed,
        net: net, sv: sv2, cl: cl,
        acc: sim_accum_new(),
        t0: server_t0(sv2),
        tick: server_t0(sv2),
        bot: demobot_new(cl, sv2),
        // --- what the run measured, sampled every frame ---------------------
        latch: 0,           // frames of an EMPTY MODEL over a LOADED GUN
        lrun: 0,            // ...the worst unbroken run of them
        errf: 0,            // frames the errand layer was steering
        vill_tick: 0 - 1,   // the tick the town first read VILLAGE
        vill_kits: 0 - 1    // ...and how many posts the player had planted
    };
    demobot_set_errand(s.bot, p_errand);
    client_set_angles(cl, server_spawn_yaw(sv2), 0.0);
    server_tick(sv2, s.tick);
    client_apply(cl, server_snapshot(sv2), server_local(sv2), s.tick);
    s.tick = s.tick + 1;
    let out: object = s;
    return out;
}

// >>> `client_build_render` IS NOT OPTIONAL. <<< `demobot.hml` picks its target
// from `client_ent_*`, which read the RENDER snapshot, filled only here. A
// harness that skips this call has a bot that can see nothing, never fires and
// never clears wave 1 — and it fails silently, looking exactly like a broken
// director.
fn session_frame(p_s: object): i32 {
    let s: object = p_s;
    let cl: object = s.cl;
    let sv2: object = s.sv;
    let n: i32 = sim_accum_advance(s.acc, g_PS_DT_MS);
    let i: i32 = 0;
    while (i < n) {
        client_send_command(cl, s.tick);
        server_tick(sv2, s.tick);
        client_apply(cl, server_snapshot(sv2), server_local(sv2), s.tick);
        s.tick = s.tick + 1;
        i++;
    }
    client_frame(cl, g_PS_DT_MS * 0.001, s.tick);
    client_build_render(cl, sim_accum_alpha(s.acc));
    let out: i32 = n;
    return out;
}

// ---------------------------------------------------------------------------
//  §L — THE LATCH, SAMPLED EVERY FRAME OF EVERY ARM
// ---------------------------------------------------------------------------
//  `demobot.hml` reconstructs its own magazine, and before this wave that model
//  could desynchronise LOW and never repair itself: the bot will not fire while
//  it believes the gun is empty, and the model is only ever repaired by firing
//  or by a reload `wpn_reload_begin` refuses on a FULL magazine. Measured in
//  the previous version of this file, seed 1337, from t = 1509 s to the end of
//  the hour, EVERY sample read `mag 0 / client_ammo 4 / reserve 12`. 223 player
//  deaths, `client_shots` frozen, thirty-five minutes of a bot sprinting in
//  circles at the leash radius holding a loaded gun.
//
//  `client_ammo` is min(authority, prediction) — both terms are at most the
//  real magazine, so a POSITIVE `client_ammo` means there are rounds in the
//  gun. This counts the exact disagreement, and the WORST UNBROKEN RUN is the
//  number that discriminates a wire lag from a deadlock.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
//  THE SAMPLE TABLE.  Struct-of-arrays; one row per game minute.
// ---------------------------------------------------------------------------
let g_rows: i32 = 0;
let g_s_min: array<i32> = [];
let g_s_day: array<i32> = [];
let g_s_ph: array<i32> = [];
let g_s_beat: array<i32> = [];
let g_s_hp: array<i32> = [];
let g_s_lvl: array<i32> = [];
let g_s_xp: array<i32> = [];
let g_s_purse: array<i32> = [];
let g_s_earn: array<i32> = [];
let g_s_tier: array<i32> = [];       // settlement tier
let g_s_lux: array<i32> = [];        // core lux
let g_s_pts: array<i32> = [];        // grid points
let g_s_bld: array<i32> = [];
let g_s_npc: array<i32> = [];
let g_s_nmd: array<i32> = [];        // NAMED villagers present
let g_s_lan: array<i32> = [];        // lit lanterns feeding the town
let g_s_lit: array<i32> = [];        // lanterns the PLAYER lit, ever
let g_s_kits: array<i32> = [];       // posts PLANTED
let g_s_pack: array<i32> = [];       // kits still in the pack
let g_s_holds: array<i32> = [];
let g_s_kills: array<i32> = [];
let g_s_own: array<i32> = [];
let g_s_trd: array<i32> = [];
let g_s_ref: array<i32> = [];
let g_s_talk: array<i32> = [];
let g_s_regw: array<i32> = [];       // regard: Wick
let g_s_regm: array<i32> = [];       // regard: Mabel
let g_s_pt: array<i32> = [];         // unspent stat points
let g_s_dist: array<i32> = [];       // metres from the settlement centre
let g_s_dth: array<i32> = [];
let g_s_dtier: array<i32> = [];      // the DIRECTOR's tier
let g_s_ctier: array<i32> = [];      // the chunk shade tier under the player
let g_s_fall: array<i32> = [];       // cumulative fall-damage hits
let g_s_shot: array<i32> = [];       // >>> §L: the authority's shot counter <<<
let g_s_trip: array<i32> = [];       // completed round trips

fn sample(p_s: object, p_min: i32) {
    let s: object = p_s;
    let cl: object = s.cl;
    let sv2: object = s.sv;
    let w: object = server_world(sv2);
    let st: object = server_settle(sv2);
    let sto: object = server_npcs(sv2);
    let tick: i32 = server_tick_now(sv2);
    let dx: f64 = settle_cx(st) - client_px(cl);
    let dz: f64 = settle_cz(st) - client_pz(cl);

    g_s_min.push(p_min);
    g_s_day.push(day_number(tick));
    g_s_ph.push(day_phase(tick));
    g_s_beat.push(server_beat(sv2));
    g_s_hp.push(client_hp(cl));
    g_s_lvl.push(client_level(cl));
    g_s_xp.push(client_xp_total(cl));
    g_s_purse.push(npc_purse(sto));
    g_s_earn.push(server_salvage_earned(sv2));
    g_s_tier.push(settle_tier(st));
    g_s_lux.push(settle_core_lux(st));
    g_s_pts.push(settle_grid_points(st));
    g_s_bld.push(client_settle_buildings(cl));
    g_s_npc.push(npc_count(sto));
    g_s_nmd.push(npc_named_count(sto));
    g_s_lan.push(server_lan_count(sv2));
    g_s_lit.push(sim_stat_lanterns(w));
    g_s_kits.push(server_kits_placed(sv2));
    g_s_pack.push(client_pack_kits(cl));
    g_s_holds.push(director_holds_done(sim_director(w)));
    g_s_kills.push(sim_stat_deaths(w));
    g_s_own.push(server_own_count(sv2));
    g_s_trd.push(server_trades(sv2));
    g_s_ref.push(server_trades_refused(sv2));
    g_s_talk.push(server_talks(sv2));
    g_s_regw.push(npc_regard(sto, NPC_WICK));
    g_s_regm.push(npc_regard(sto, NPC_MABEL));
    g_s_pt.push(client_points(cl));
    g_s_dist.push(i32(sqrt(dx * dx + dz * dz)));
    g_s_dth.push(sim_stat_player_deaths(w));
    g_s_dtier.push(director_tier(sim_director(w)));
    g_s_ctier.push(client_tier(cl));
    g_s_fall.push(sim_stat_fall_hits(w));
    g_s_shot.push(client_shots(cl));
    g_s_trip.push(demobot_trips(s.bot));
    g_rows = g_rows + 1;
}

fn table_reset() {
    g_rows = 0;
    g_s_min.clear(); g_s_day.clear(); g_s_ph.clear(); g_s_beat.clear();
    g_s_hp.clear(); g_s_lvl.clear(); g_s_xp.clear(); g_s_purse.clear();
    g_s_earn.clear(); g_s_tier.clear(); g_s_lux.clear(); g_s_pts.clear();
    g_s_bld.clear(); g_s_npc.clear(); g_s_nmd.clear(); g_s_lan.clear();
    g_s_lit.clear(); g_s_kits.clear(); g_s_pack.clear(); g_s_holds.clear();
    g_s_kills.clear(); g_s_own.clear(); g_s_trd.clear(); g_s_ref.clear();
    g_s_talk.clear(); g_s_regw.clear(); g_s_regm.clear(); g_s_pt.clear();
    g_s_dist.clear(); g_s_dth.clear(); g_s_dtier.clear(); g_s_ctier.clear();
    g_s_fall.clear(); g_s_shot.clear(); g_s_trip.clear();
}

fn table_print(p_title: string) {
    print("");
    print("  " + p_title);
    print("  min  d ph   beat  hp lvl    xp purse  town lux pts bld npc nmd lan kits pack holds kills own trd ref talk regW regM pt  dist deaths  shots trips");
    let i: i32 = 0;
    while (i < g_rows) {
        let m: i32 = g_s_min[i];
        // Print every minute for the first six, then every five.
        let show: i32 = 0;
        if (m <= 6) { show = 1; }
        if (m - (m / 5) * 5 == 0) { show = 1; }
        if (m == g_PS_MINUTES) { show = 1; }
        if (show == 1) {
            print("  " + pi(m, 3) + " " + pi(g_s_day[i], 2) + " "
                + phase_ch(g_s_ph[i]) + " "
                + padr(server_beat_name(g_s_beat[i]), 6) + " "
                + pi(g_s_hp[i], 3) + " " + pi(g_s_lvl[i], 3) + " "
                + pi(g_s_xp[i], 5) + " " + pi(g_s_purse[i], 5) + " "
                + pi(g_s_tier[i], 4) + " " + pi(g_s_lux[i], 4) + " "
                + pi(g_s_pts[i], 3) + " " + pi(g_s_bld[i], 3) + " "
                + pi(g_s_npc[i], 3) + " " + pi(g_s_nmd[i], 3) + " "
                + pi(g_s_lan[i], 3) + " " + pi(g_s_kits[i], 4) + " "
                + pi(g_s_pack[i], 4) + " " + pi(g_s_holds[i], 5) + " "
                + pi(g_s_kills[i], 5) + " " + pi(g_s_own[i], 3) + " "
                + pi(g_s_trd[i], 3) + " " + pi(g_s_ref[i], 3) + " "
                + pi(g_s_talk[i], 4) + " " + pi(g_s_regw[i], 4) + " "
                + pi(g_s_regm[i], 4) + " " + pi(g_s_pt[i], 2) + " "
                + pi(g_s_dist[i], 5) + " " + pi(g_s_dth[i], 6) + " "
                + pi(g_s_shot[i], 6) + " " + pi(g_s_trip[i], 5));
        }
        i++;
    }
}

// The minute at which a column last CHANGED.  This is the whole instrument:
// a column whose last change is at minute 3 is a system that stopped
// contributing to the experience at minute 3.
fn last_change(p_a: array<i32>): i32 {
    let n: i32 = g_rows;
    let last: i32 = 0;
    let i: i32 = 1;
    while (i < n) {
        if (p_a[i] != p_a[i - 1]) { last = g_s_min[i]; }
        i++;
    }
    let out: i32 = last;
    return out;
}

// The FIRST minute at which a column reached a value. -1 if it never did.
fn first_at(p_a: array<i32>, p_v: i32): i32 {
    let i: i32 = 0;
    while (i < g_rows) {
        if (p_a[i] >= p_v) { let out: i32 = g_s_min[i]; return out; }
        i++;
    }
    let none: i32 = 0 - 1;
    return none;
}

fn report_change(p_name: string, p_a: array<i32>) {
    let lc: i32 = last_change(p_a);
    let first: i32 = p_a[0];
    let lastv: i32 = p_a[g_rows - 1];
    print("    " + padr(p_name, 22) + " " + pi(first, 7) + " -> " + pi(lastv, 7)
        + "   last moved at " + padl(mmss(lc * 60), 6));
}

// ---------------------------------------------------------------------------
//  RUN ONE ARM
// ---------------------------------------------------------------------------
fn run_arm(p_errand: i32, p_title: string): object {
    let s: object = session_new(g_PS_SEED, p_errand);
    let st: object = server_settle(s.sv);
    table_reset();
    let f: i32 = 0;
    let frames: i32 = g_PS_MINUTES * 60 * 60;
    let next: i32 = g_PS_SAMPLE;
    let m: i32 = 0;
    let run: i32 = 0;
    sample(s, 0);                       // minute 0, before anything
    while (f < frames) {
        demobot_frame(s.bot, client_px(s.cl), client_pz(s.cl));
        session_frame(s);

        // §L, every frame, both arms.
        if (demobot_mag(s.bot) == 0 && client_ammo(s.cl) > 0) {
            s.latch = s.latch + 1;
            run = run + 1;
            if (run > s.lrun) { s.lrun = run; }
        } else { run = 0; }
        if (demobot_state(s.bot) != DBOT_ST_HOLD) { s.errf = s.errf + 1; }
        if (s.vill_tick < 0) {
            if (settle_tier(st) >= SET_TIER_VILLAGE) {
                s.vill_tick = server_tick_now(s.sv);
                s.vill_kits = server_kits_placed(s.sv);
            }
        }

        f++;
        if (f >= next) {
            m++;
            next = next + g_PS_SAMPLE;
            sample(s, m);
        }
    }
    table_print(p_title);
    let out: object = s;
    return out;
}

// ---------------------------------------------------------------------------
//  THE SEED SWEEP — DOES THE SHIPPING DRIVER'S TOWN GROW, AND ON WHICH SEEDS?
// ---------------------------------------------------------------------------
//  No fixture: `server_new` -> `server_tick` -> a bot pressing buttons, which is
//  the only path a player has. The seeds that DO NOT promote are printed with
//  the same weight as the ones that do; a sweep that only reports its successes
//  is an advertisement.
// ---------------------------------------------------------------------------
fn run_sweep_seed(p_seed: i32): object {
    let s: object = session_new(p_seed, 1);
    let st: object = server_settle(s.sv);
    let frames: i32 = g_PS_SWEEP_MIN * 60 * 60;
    let f: i32 = 0;
    let run: i32 = 0;
    while (f < frames) {
        demobot_frame(s.bot, client_px(s.cl), client_pz(s.cl));
        session_frame(s);
        if (demobot_mag(s.bot) == 0 && client_ammo(s.cl) > 0) {
            s.latch = s.latch + 1;
            run = run + 1;
            if (run > s.lrun) { s.lrun = run; }
        } else { run = 0; }
        if (s.vill_tick < 0) {
            if (settle_tier(st) >= SET_TIER_VILLAGE) {
                s.vill_tick = server_tick_now(s.sv);
                s.vill_kits = server_kits_placed(s.sv);
            }
        }
        f++;
    }
    let out: object = s;
    return out;
}

// ---------------------------------------------------------------------------
//  WHERE THE LANTERNS ACTUALLY ARE.  The posts the player planted, with their
//  distance from the green, so the ring is a MEASUREMENT and not a claim.
// ---------------------------------------------------------------------------
let g_geo_in: i32 = 0;

fn lantern_geography(p_s: object) {
    let s: object = p_s;
    let w: object = server_world(s.sv);
    let st: object = server_settle(s.sv);
    let cx: f64 = settle_cx(st);
    let cz: f64 = settle_cz(st);
    print("");
    print("  WHERE THE LANTERNS ARE  (the settlement green is the origin here)");
    print("    ring the feed gathers over: " + f1(settle_ring_m(SET_TIER_CITY))
        + " m;  a Camp counts a post inside " + f1(SET_RING_CAMP_M) + " m");
    let cnt: i32 = world_count(w);
    let n: i32 = 0;
    let lit: i32 = 0;
    let inring: i32 = 0;
    let slot: i32 = 0;
    while (slot < cnt) {
        let kd = w.kind;
        let fl = w.flags;
        if (kd[slot] == KIND_LANTERN && (fl[slot] & EF_DEAD) == 0) {
            let an = w.anim;
            let xs = w.px; let zs = w.pz;
            let dx: f64 = xs[slot] - cx;
            let dz: f64 = zs[slot] - cz;
            let d: f64 = sqrt(dx * dx + dz * dz);
            let state: string = "unlit";
            if (an[slot] == SIM_LANTERN_LIT) {
                state = "LIT  ";
                lit = lit + 1;
                if (d <= SET_RING_CAMP_M) { inring = inring + 1; }
            }
            let mark: string = "  ";
            if (d <= SET_RING_CAMP_M) { mark = ">>"; }
            print("    " + mark + " post " + pi(n, 2) + "  " + state + "  "
                + padl(f1(d), 7) + " m from the green");
            n++;
        }
        slot++;
    }
    print("    " + sv(lit) + " lit of " + sv(n) + " posts, of which "
        + sv(inring) + " are inside the Camp ring and therefore worth grid points.");
    g_geo_in = inring;
}

// ---------------------------------------------------------------------------
//  THE OFFER AUDIT — what the shop can EVER sell, independent of any run.
// ---------------------------------------------------------------------------
let g_unbuilt: i32 = 0;

fn audit_offers(p_s: object) {
    let s: object = p_s;
    let sto: object = server_npcs(s.sv);
    let st: object = server_settle(s.sv);
    print("");
    print("  THE SHOP, ROW BY ROW  (class UNBUILT = the honest gap)");
    print("  row who      kind price tier regard  class     open-now");
    let unbuilt: i32 = 0;
    let r: i32 = 0;
    while (r < NPC_OFF_ROWS) {
        let cls: i32 = npc_offer_class(r);
        let cn: string = "SERVICE";
        if (cls == 1) { cn = "STOCK  "; }
        if (cls == 2) { cn = "FIT    "; }
        if (cls == NPC_OC_UNBUILT) { cn = "UNBUILT"; unbuilt = unbuilt + 1; }
        let op: string = "no";
        if (npc_offer_open(sto, st, r) == 1) { op = "YES"; }
        print("  " + pi(r, 3) + " " + padr(client_npc_name(npc_offer_who(r)), 8)
            + " " + pi(npc_offer_kind(r), 4) + " " + pi(npc_offer_price(r), 5)
            + " " + pi(npc_offer_tier(r), 4) + " " + pi(npc_offer_regard(r), 6)
            + "  " + cn + "   " + op);
        r++;
    }
    print("  UNBUILT rows: " + sv(unbuilt) + " of " + sv(NPC_OFF_ROWS));
    g_unbuilt = unbuilt;
}

// ---------------------------------------------------------------------------
//  WHAT WOULD IT TAKE?  A pure evaluation of `settle.hml`, no session.
// ---------------------------------------------------------------------------
//  HOW MANY LIT POSTS, AND HOW CLOSE, does the shipped `settle.hml` want before
//  it will call the place a Village?  It builds synthetic lantern sets on a ring
//  around the green and asks `settle_refresh` — the module's own full
//  re-integration — what they are worth.  This is settle.hml answering about
//  itself, and it is what the driver's plant ring is checked against.
// ---------------------------------------------------------------------------
let g_need_posts: i32 = 0;
let g_need_r: f64 = 0.0;

fn what_would_it_take() {
    print("");
    print("  WHAT THE TOWN ACTUALLY WANTS  (settle.hml, evaluated directly)");
    print("    Village needs core lux >= " + sv(SET_CORE_VILLAGE)
        + " AND grid points >= " + sv(SET_PTS_VILLAGE));
    print("    Town    needs core lux >= " + sv(SET_CORE_TOWN)
        + " AND grid points >= " + sv(SET_PTS_TOWN));
    print("");
    print("    posts   ring     core lux   grid pts   tier");
    let gx: i32 = settle_cell_x_of(0.0);
    let gz: i32 = settle_cell_z_of(0.0);
    let radii: array<f64> = [20.0, 40.0, 60.0, 100.0];
    let ri: i32 = 0;
    while (ri < radii.length) {
        let r: f64 = radii[ri];
        let np: i32 = 2;
        while (np <= 16) {
            let st: object = settle_new_at(g_PS_SEED, gx, gz);
            let cx: f64 = settle_cx(st);
            let cz: f64 = settle_cz(st);
            let a: array<f64> = [];
            // row 0: the Great Lantern, tier 1, lit.
            a.push(cx); a.push(cz); a.push(1.0); a.push(f64(SET_WICK_FULL));
            let i: i32 = 0;
            while (i < np) {
                let ang: f64 = 6.283185307179586 * f64(i) / f64(np);
                a.push(cx + sin(ang) * r);
                a.push(cz - cos(ang) * r);
                a.push(1.0);
                a.push(f64(SET_WICK_FULL));
                i++;
            }
            settle_lanterns_set(st, a, np + 1);
            settle_refresh(st);
            let core: i32 = settle_core_lux(st);
            let pts: i32 = settle_grid_points(st);
            let ok: i32 = 0;
            if (core >= SET_CORE_VILLAGE) { if (pts >= SET_PTS_VILLAGE) { ok = 1; } }
            if (ok == 1 || np == 16) {
                print("    " + pi(np, 5) + "   " + padl(f1(r), 5) + " m  "
                    + pi(core, 9) + "  " + pi(pts, 9) + "   "
                    + client_settle_tier_name(settle_tier(st)));
            }
            if (ok == 1) {
                if (g_need_posts == 0) { g_need_posts = np; g_need_r = r; }
                np = 17;
            } else { np++; }
        }
        ri++;
    }
    if (g_need_posts > 0) {
        print("");
        print("    THE ANSWER: " + sv(g_need_posts) + " lit posts on a "
            + f1(g_need_r) + " m ring around the green makes it a Village,");
        print("    and the shipping driver's plant ring starts at 24 m and steps out by 12.");
    }
}

// ===========================================================================
//  MAIN
// ===========================================================================
fn main() {
    let ai: i32 = 1;
    while (ai < args.length) {
        let a: string = args[ai];
        if (a == "--seeds" && ai + 1 < args.length) { g_PS_SEEDS = i32(args[ai + 1]); ai++; }
        else if (a == "--sweep" && ai + 1 < args.length) { g_PS_SWEEP_MIN = i32(args[ai + 1]); ai++; }
        else if (a == "--minutes" && ai + 1 < args.length) { g_PS_MINUTES = i32(args[ai + 1]); ai++; }
        ai++;
    }

    print("=================================================================");
    print(" probe_session — ONE HOUR OF GAME TIME, MEASURED, TWICE");
    print("=================================================================");
    let bmode: string = "COMPILED";
    if (compiled() == 0) { bmode = "INTERPRETED"; }
    print(" build      " + bmode);
    print(" seed       " + sv(g_PS_SEED));
    print(" duration   " + sv(g_PS_MINUTES) + " game minutes per arm");
    print(" the day    " + sv(g_DAY_TICKS / g_TICK_HZ / 60) + " minutes, so the hour is "
        + f1(f64(g_PS_MINUTES) * 60.0 * f64(g_TICK_HZ) / f64(g_DAY_TICKS)) + " days");
    print("");

    // -----------------------------------------------------------------------
    print("-----------------------------------------------------------------");
    print(" ARM LAMP — src/game/demobot.hml, THE SHIPPING DRIVER, ERRAND ON");
    print("   holds the post through the night; at dawn it walks home, plants");
    print("   its kits inside the ring the HUD draws, talks to whoever is home,");
    print("   presses every shop row, and walks back out.");
    print("   This is what `main.hml --demo 3600` does on the display.");
    print("-----------------------------------------------------------------");
    let a_lamp: object = run_arm(1, "ARM LAMP");
    print("");
    print("  WHAT STOPPED MOVING, AND WHEN  (ARM LAMP)");
    report_change("settlement tier", g_s_tier);
    report_change("core lux", g_s_lux);
    report_change("grid points", g_s_pts);
    report_change("buildings", g_s_bld);
    report_change("villagers", g_s_npc);
    report_change("named villagers", g_s_nmd);
    report_change("lanterns lit", g_s_lit);
    report_change("posts planted", g_s_kits);
    report_change("kits in the pack", g_s_pack);
    report_change("guns owned", g_s_own);
    report_change("trades", g_s_trd);
    report_change("conversations", g_s_talk);
    report_change("regard (Wick)", g_s_regw);
    report_change("regard (Mabel)", g_s_regm);
    report_change("character level", g_s_lvl);
    report_change("purse", g_s_purse);
    report_change("holds done", g_s_holds);
    report_change("shots fired", g_s_shot);
    report_change("town trips", g_s_trip);

    let lamp_tier: i32 = g_s_tier[g_rows - 1];
    let lamp_lux: i32 = g_s_lux[g_rows - 1];
    let lamp_pts: i32 = g_s_pts[g_rows - 1];
    let lamp_bld: i32 = g_s_bld[g_rows - 1];
    let lamp_npc: i32 = g_s_npc[g_rows - 1];
    let lamp_nmd: i32 = g_s_nmd[g_rows - 1];
    let lamp_lit: i32 = g_s_lit[g_rows - 1];
    let lamp_kits: i32 = g_s_kits[g_rows - 1];
    let lamp_trd: i32 = g_s_trd[g_rows - 1];
    let lamp_ref: i32 = g_s_ref[g_rows - 1];
    let lamp_talk: i32 = g_s_talk[g_rows - 1];
    let lamp_own: i32 = g_s_own[g_rows - 1];
    let lamp_regw: i32 = g_s_regw[g_rows - 1];
    let lamp_lvl: i32 = g_s_lvl[g_rows - 1];
    let lamp_purse: i32 = g_s_purse[g_rows - 1];
    let lamp_kills: i32 = g_s_kills[g_rows - 1];
    let lamp_dth: i32 = g_s_dth[g_rows - 1];
    let lamp_holds: i32 = g_s_holds[g_rows - 1];
    let lamp_lan: i32 = g_s_lan[g_rows - 1];
    let lamp_shot_lc: i32 = last_change(g_s_shot);
    let lamp_kill_lc: i32 = last_change(g_s_kills);
    let lamp_tier_at: i32 = first_at(g_s_tier, SET_TIER_VILLAGE);
    let lamp_tier_1: i32 = g_s_tier[1];         // the town at 1:00
    let lamp_trips: i32 = g_s_trip[g_rows - 1];

    // -----------------------------------------------------------------------
    print("");
    print("-----------------------------------------------------------------");
    print(" ARM HOLD — THE SAME MODULE, `demobot_set_errand(b, 0)`");
    print("   the errand layer stops running and what is left is the driver");
    print("   that SHIPPED BEFORE THIS WAVE, byte for byte: leashed to the");
    print("   first post at 16 m, and it never leaves. THE CONTROL.");
    print("-----------------------------------------------------------------");
    let a_hold: object = run_arm(0, "ARM HOLD");
    print("");
    print("  WHAT STOPPED MOVING, AND WHEN  (ARM HOLD)");
    report_change("settlement tier", g_s_tier);
    report_change("core lux", g_s_lux);
    report_change("villagers", g_s_npc);
    report_change("lanterns lit", g_s_lit);
    report_change("posts planted", g_s_kits);
    report_change("kits in the pack", g_s_pack);
    report_change("guns owned", g_s_own);
    report_change("trades", g_s_trd);
    report_change("conversations", g_s_talk);
    report_change("character level", g_s_lvl);
    report_change("shots fired", g_s_shot);

    let hold_tier: i32 = g_s_tier[g_rows - 1];
    let hold_lux: i32 = g_s_lux[g_rows - 1];
    let hold_npc: i32 = g_s_npc[g_rows - 1];
    let hold_bld: i32 = g_s_bld[g_rows - 1];
    let hold_lit: i32 = g_s_lit[g_rows - 1];
    let hold_kits: i32 = g_s_kits[g_rows - 1];
    let hold_pack: i32 = g_s_pack[g_rows - 1];
    let hold_trd: i32 = g_s_trd[g_rows - 1];
    let hold_talk: i32 = g_s_talk[g_rows - 1];
    let hold_own: i32 = g_s_own[g_rows - 1];
    let hold_lvl: i32 = g_s_lvl[g_rows - 1];
    let hold_purse: i32 = g_s_purse[g_rows - 1];
    let hold_kills: i32 = g_s_kills[g_rows - 1];
    let hold_dth: i32 = g_s_dth[g_rows - 1];
    let hold_shot_lc: i32 = last_change(g_s_shot);
    let hold_kill_lc: i32 = last_change(g_s_kills);
    let hold_tier_lc: i32 = last_change(g_s_tier);
    let hold_own_lc: i32 = last_change(g_s_own);
    let hold_lvl_lc: i32 = last_change(g_s_lvl);

    // -----------------------------------------------------------------------
    print("");
    print("-----------------------------------------------------------------");
    print(" THE TWO HOURS, SIDE BY SIDE   (one module, one boolean apart)");
    print("-----------------------------------------------------------------");
    print("                            ARM HOLD    ARM LAMP");
    print("  town trips completed   " + pi(0, 10) + pi(lamp_trips, 12));
    print("  posts planted          " + pi(hold_kits, 10) + pi(lamp_kits, 12));
    print("  kits left in the pack  " + pi(hold_pack, 10) + pi(g_s_pack[g_rows - 1], 12));
    print("  conversations          " + pi(hold_talk, 10) + pi(lamp_talk, 12));
    print("  trades completed       " + pi(hold_trd, 10) + pi(lamp_trd, 12));
    print("  guns owned at the end  " + pi(hold_own, 10) + pi(lamp_own, 12));
    print("  settlement tier        " + pi(hold_tier, 10) + pi(lamp_tier, 12));
    print("  core lux               " + pi(hold_lux, 10) + pi(lamp_lux, 12));
    print("  buildings              " + pi(hold_bld, 10) + pi(lamp_bld, 12));
    print("  villagers present      " + pi(hold_npc, 10) + pi(lamp_npc, 12));
    print("  lanterns the player lit" + pi(hold_lit, 10) + pi(lamp_lit, 12));
    print("  regard (Wick)          " + pi(0, 10) + pi(lamp_regw, 12));
    print("  character level        " + pi(hold_lvl, 10) + pi(lamp_lvl, 12));
    print("  kills                  " + pi(hold_kills, 10) + pi(lamp_kills, 12));
    print("  player deaths          " + pi(hold_dth, 10) + pi(lamp_dth, 12));
    print("  salvage in the purse   " + pi(hold_purse, 10) + pi(lamp_purse, 12));
    print("");
    print("  §L THE AMMO LATCH — frames with an EMPTY MODEL over a LOADED GUN");
    print("     ARM HOLD  " + pi(a_hold.latch, 8) + " frames, worst run "
        + pi(a_hold.lrun, 7) + " (" + f1(f64(a_hold.lrun) / 60.0) + " s)");
    print("     ARM LAMP  " + pi(a_lamp.latch, 8) + " frames, worst run "
        + pi(a_lamp.lrun, 7) + " (" + f1(f64(a_lamp.lrun) / 60.0) + " s)");
    print("     Before this wave the same hour ran a 125 000-frame unbroken run");
    print("     from 25:09 to 60:00 and cost 223 player deaths.");
    print("  §E the errand layer steered " + sv(a_lamp.errf) + " of "
        + sv(g_PS_MINUTES * 3600) + " LAMP frames, and "
        + sv(a_hold.errf) + " of HOLD's.");

    lantern_geography(a_lamp);
    what_would_it_take();
    audit_offers(a_lamp);

    // -----------------------------------------------------------------------
    print("");
    print("-----------------------------------------------------------------");
    print(" THE SEED SWEEP — " + sv(g_PS_SEEDS) + " seeds x " + sv(g_PS_SWEEP_MIN)
        + " game minutes, NO FIXTURE, the shipping driver");
    print("-----------------------------------------------------------------");
    print("   seed   VILLAGE at   posts then   end tier   core     pts   fed  latch");
    let seeds: array<i32> = [1337, 2, 7, 48851, 99991, 4242, 31337, 777,
                             5, 12345, 90210, 65535, 8675309, 101, 2718, 31415];
    let got: i32 = 0;
    let sweep_latch: i32 = 0;
    let worst_run: i32 = 0;
    let min_posts: i32 = 999;
    let first_v: i32 = 0 - 1;
    let last_v: i32 = 0 - 1;
    let k: i32 = 0;
    while (k < g_PS_SEEDS && k < seeds.length) {
        let r: object = run_sweep_seed(seeds[k]);
        let stx: object = server_settle(r.sv);
        let at: string = "        -";
        if (r.vill_tick >= 0) {
            let el: i32 = (r.vill_tick - r.t0) / 60;
            at = padl(mmss(el), 9);
            got++;
            if (r.vill_kits < min_posts) { min_posts = r.vill_kits; }
            if (first_v < 0 || el < first_v) { first_v = el; }
            if (el > last_v) { last_v = el; }
        }
        sweep_latch = sweep_latch + r.latch;
        if (r.lrun > worst_run) { worst_run = r.lrun; }
        print("   " + padl(sv(seeds[k]), 5) + "   " + at
            + "   " + pi(r.vill_kits, 10)
            + "   " + pi(settle_tier(stx), 8)
            + "   " + pi(settle_core_lux(stx), 5) + "/" + sv(SET_CORE_VILLAGE)
            + "  " + pi(settle_grid_points(stx), 3) + "/" + sv(SET_PTS_VILLAGE)
            + "  " + pi(server_lan_count(r.sv), 4)
            + "  " + pi(r.latch, 5));
        k++;
    }
    let nseeds: i32 = k;
    print("   -> " + sv(got) + " of " + sv(nseeds) + " seeds promoted to VILLAGE in "
        + sv(g_PS_SWEEP_MIN) + " game minutes, driven by the thing that ships");
    if (got > 0) {
        print("      between " + mmss(first_v) + " and " + mmss(last_v)
            + " elapsed, fewest posts " + sv(min_posts));
    }

    // -----------------------------------------------------------------------
    print("");
    print("-----------------------------------------------------------------");
    print(" ASSERTIONS — every one is a STATEMENT OF WHAT IS, not of what");
    print(" ought to be.  If a number here moves, the design moved, and this");
    print(" probe must go red rather than pass quietly.");
    print("-----------------------------------------------------------------");

    // A. THE HOUR RAN AT ALL.
    ck(g_rows == g_PS_MINUTES + 1,
       "the hour sampled " + sv(g_rows) + " minutes, wanted " + sv(g_PS_MINUTES + 1));
    ck(lamp_kills > 200,
       "ARM LAMP killed " + sv(lamp_kills) + " things — the combat loop never stalls");
    ck(lamp_holds >= 1,
       "ARM LAMP survived " + sv(lamp_holds) + " nightly holds in the hour");

    // B. THE AUTHORED CONTENT IS SIXTY SECONDS LONG, AND THAT IS STILL ALL OF IT.
    ck(server_beat(a_lamp.sv) == 11,
       "an hour in, the game is still on the LAST scripted beat ("
       + server_beat_name(server_beat(a_lamp.sv)) + ", reached at 0:58). Everything"
       + " after it is caused by the player");

    // C. >>> THE SHIPPING DRIVER PLAYS THE WHOLE LOOP. <<<
    //    This is the block that did not exist. Every number is unfixtured.
    ck(lamp_kits >= 4,
       ">>> THE BOT PLANTS <<< " + sv(lamp_kits) + " posts put into the ground by"
       + " BTN_USE in a town it walked to (was 0)");
    ck(lamp_talk > 0,
       ">>> THE BOT TALKS <<< " + sv(lamp_talk) + " conversations with villagers who"
       + " moved in because of its lanterns (was 0)");
    ck(lamp_trd > 0,
       ">>> THE BOT TRADES <<< " + sv(lamp_trd) + " completed trades, "
       + sv(lamp_ref) + " refused, in a town it BUILT — not a `--town` fixture (was 0)");
    ck(lamp_tier >= SET_TIER_VILLAGE,
       ">>> AND THE TOWN IS A VILLAGE <<< tier " + sv(lamp_tier) + ", core lux "
       + sv(lamp_lux) + "/" + sv(SET_CORE_VILLAGE) + ", grid points " + sv(lamp_pts)
       + "/" + sv(SET_PTS_VILLAGE));
    ck(lamp_tier_at > 1,
       "...and it is EARNED, not given: VILLAGE first read at "
       + mmss(lamp_tier_at * 60) + ", and the town was tier " + sv(lamp_tier_1)
       + " at 1:00");
    ck(lamp_bld > 2 && lamp_npc > 0,
       "the town built " + sv(lamp_bld) + " buildings (2 at boot) and "
       + sv(lamp_npc) + " villagers moved in, " + sv(lamp_nmd) + " of them named");
    ck(lamp_trips >= 2,
       "ARM LAMP made " + sv(lamp_trips) + " completed round trips to the settlement");
    ck(lamp_lit > 4,
       "and lit " + sv(lamp_lit) + " lanterns, of which one was the tutorial post");
    ck(g_geo_in >= 4,
       ">>> AND THE POSTS ARE WHERE THEY COUNT <<< " + sv(g_geo_in)
       + " lit posts inside the " + f1(SET_RING_CAMP_M) + " m ring, surveyed off the"
       + " world's own lantern bodies");
    ck(lamp_lan > 7,
       "the settlement's lantern feed carries " + sv(lamp_lan)
       + " rows (7 is the opening's path, unaided)");

    // D. THE CONTROL. The same module with the layer switched off does none of it.
    ck(hold_kits == 0,
       "CONTROL: ARM HOLD planted " + sv(hold_kits) + " posts and finished the hour"
       + " with " + sv(hold_pack) + " kits still in its pack");
    ck(hold_tier == SET_TIER_CAMP,
       "CONTROL: ARM HOLD's town is still a CAMP at 60:00, tier " + sv(hold_tier)
       + ", last moved at " + mmss(hold_tier_lc * 60));
    ck(hold_talk == 0 && hold_trd == 0,
       "CONTROL: " + sv(hold_talk) + " conversations and " + sv(hold_trd)
       + " trades in an hour of standing at the post");
    ck(hold_npc == 0,
       "CONTROL: " + sv(hold_npc) + " villagers ever arrive — a Camp has none");
    ck(hold_own_lc == 0,
       "CONTROL: ARM HOLD's arsenal never changed: " + sv(hold_own)
       + " gun, last moved at 0:00");
    ck(lamp_lit > hold_lit,
       "THE DIFFERENCE, IN LANTERNS: " + sv(lamp_lit) + " lit against the standing"
       + " player's " + sv(hold_lit));
    ck(hold_lvl_lc <= 60,
       "CONTROL: ARM HOLD's level last moved at " + mmss(hold_lvl_lc * 60)
       + " — " + sv(hold_lvl) + " levels in an hour");

    // E. >>> §L — THE AMMO LATCH IS DEAD, AND THIS IS THE 25:00 FAILURE. <<<
    //    THE_HOUR_2 §0.4: "my town-visit driver broke at 25:00 and ARM WALK now
    //    breaks at 26:00 ... 223 deaths, XP and kills frozen, in daylight."
    //    The cause was not the movement override. It was `demobot.hml`'s
    //    reconstructed magazine desynchronising LOW and deadlocking: it will not
    //    fire while it believes the gun is empty, and the model is only repaired
    //    by firing or by a reload the authority refuses on a FULL magazine.
    //    `client_ammo` is min(authority, prediction), so a POSITIVE reading
    //    means there ARE rounds in the gun. These four are that, measured.
    ck(a_lamp.lrun < 3600,
       ">>> THE LATCH IS DEAD (LAMP) <<< worst unbroken run of an EMPTY MODEL over"
       + " a LOADED GUN is " + sv(a_lamp.lrun) + " frames ("
       + f1(f64(a_lamp.lrun) / 60.0) + " s). The hour this replaces ran 125 000.");
    ck(a_hold.lrun < 3600,
       ">>> THE LATCH IS DEAD (HOLD) <<< worst unbroken run " + sv(a_hold.lrun)
       + " frames — and HOLD is the driver that shipped, so this was never only"
       + " a probe's bug");
    ck(lamp_shot_lc >= g_PS_MINUTES - 5,
       "ARM LAMP was still firing at " + mmss(lamp_shot_lc * 60)
       + " — a frozen shot counter is the latch's signature");
    ck(hold_shot_lc >= g_PS_MINUTES - 5,
       "ARM HOLD was still firing at " + mmss(hold_shot_lc * 60));
    // AND THE OTHER HALF OF THE SIGNATURE, WHICH IS THE SHARPER ONE. A driver
    // can fire and still be broken; a driver whose KILL COUNT froze at 183 for
    // thirty-five minutes while its death count climbed to 223 is the thing
    // THE_HOUR_2 §0.4 measured. These two go red the moment that returns.
    //
    // >>> AND NOTE WHAT IS *NOT* ASSERTED HERE: A DEATH COUNT. <<<
    // The latch is dead — worst unbroken run is ONE FRAME in both arms — and
    // the standing driver STILL dies 354 times in this hour. That is the
    // director's tier ramp making the post unholdable on nights 3 and 4, it is
    // the same number with the errand layer switched off, and it is therefore
    // NOT this driver's bug and not this driver's to fix. Asserting a death
    // bound here would be this file taking the blame for a balance problem and
    // going red on a tree somebody else tuned. It is REPORTED, in the table
    // above and in this task's report, and it is the next thing to measure.
    ck(lamp_kill_lc >= g_PS_MINUTES - 5,
       "ARM LAMP was still KILLING at " + mmss(lamp_kill_lc * 60) + " — "
       + sv(lamp_kills) + " kills, " + sv(lamp_dth) + " deaths");
    // AND THE CONTROL'S OWN ENDING, ASSERTED AS THE FACT IT IS RATHER THAN
    // WISHED AWAY. ARM HOLD is still FIRING at 60:00 and its last KILL was at
    // 52:00: for the last eight minutes it respawns, fires about one round per
    // life, and dies eleven times a minute. That is NOT the latch — §L's worst
    // unbroken run in this arm is ONE FRAME — it is the director's tier ramp
    // against a player who never leaves the post, and it is the reason ARM
    // LAMP's 103 deaths against ARM HOLD's 354 is a result about the GAME and
    // not about the bot. If either half of this moves, the balance moved.
    ck(hold_kill_lc < g_PS_MINUTES - 5,
       ">>> THE CONTROL'S POST BECOMES UNHOLDABLE <<< ARM HOLD's last kill was at "
       + mmss(hold_kill_lc * 60) + " (" + sv(hold_kills) + " kills) while it was still"
       + " firing at " + mmss(hold_shot_lc * 60) + " and dying: " + sv(hold_dth)
       + " deaths against ARM LAMP's " + sv(lamp_dth));

    // F. §E — THE ERRAND LAYER IS THE ONLY DIFFERENCE BETWEEN THE ARMS.
    ck(a_hold.errf == 0,
       "§E: the errand layer steered ARM HOLD for " + sv(a_hold.errf)
       + " frames — the switch really is off, so the control really is the old driver");
    ck(a_lamp.errf > 0,
       "§E: ...and steered ARM LAMP for " + sv(a_lamp.errf) + " frames of "
       + sv(g_PS_MINUTES * 3600));

    // G. THE SEED SWEEP.
    ck(got >= nseeds - 1,
       ">>> A REAL SESSION DRIVEN BY THE SHIPPING BOT REACHES VILLAGE <<< "
       + sv(got) + " of " + sv(nseeds) + " seeds in " + sv(g_PS_SWEEP_MIN)
       + " game minutes, no fixture anywhere");
    ck(min_posts >= 4,
       "every promotion cost at least " + sv(min_posts)
       + " planted posts, and four is settle.hml's arithmetic floor");
    ck(sweep_latch >= 0 && worst_run < 3600,
       "and across the whole sweep the worst latch run is " + sv(worst_run)
       + " frames (" + sv(sweep_latch) + " frames total over " + sv(nseeds) + " seeds)");

    // H. THE SHOP AND THE ROAD OUT OF THE VILLAGE.
    ck(npc_offer_kind(13) == NPC_OFF_KIT,
       "row 13 is Wick's lantern kit — the only way to buy a new post");
    ck(npc_offer_regard(13) == NPC_BAND_T_ACQ,
       "and it is gated at regard " + sv(npc_offer_regard(13)) + " (ACQUAINTED), not "
       + sv(NPC_BAND_T_TRUSTED) + " (TRUSTED) — `4e73611` moved it");
    ck(lamp_regw > 0,
       "ARM LAMP's hour of walking to Wick's town earns " + sv(lamp_regw) + " regard");
    ck(g_unbuilt == 9,
       sv(g_unbuilt) + " of " + sv(NPC_OFF_ROWS) + " shop rows are NPC_OC_UNBUILT");
    ck(npc_offer_class(15) == NPC_OC_UNBUILT && npc_offer_class(16) == NPC_OC_UNBUILT,
       "contracts and the map are UNBUILT: there are no quests and nothing points anywhere");

    // J. AND THE SIZE OF THE NEXT HOLE, IN POSTS.
    ck(g_need_posts > 0,
       "settle.hml wants " + sv(g_need_posts) + " lit posts on a " + f1(g_need_r)
       + " m ring to call the place a Village");
    ck(lamp_pts < SET_PTS_TOWN,
       "the next tier, TOWN, wants " + sv(SET_PTS_TOWN) + " grid points and the hour"
       + " ends on " + sv(lamp_pts) + " — " + sv(SET_PTS_TOWN - lamp_pts) + " short");
    ck(lamp_lux >= SET_CORE_TOWN,
       "...but its CORE LUX threshold is ALREADY CLEARED: " + sv(lamp_lux) + " of "
       + sv(SET_CORE_TOWN) + ". TOWN is a supply problem, not a lighting one");

    // =======================================================================
    //  K.  g_HP_MAX, GUARDED BY WHAT IT DOES INSTEAD OF BY WHAT IT SAYS
    // -----------------------------------------------------------------------
    //  Gate 10: "`g_HP_MAX` is credited to `probe_mathx` AND `probe_sim` --
    //  `probe_sim` still passes 122/122 with HP at 250. It guards nothing. And
    //  `probe_mathx`'s catch is a pure value-echo ('got 250 want 100') -- it
    //  detects the edit but asserts nothing about behaviour."
    //
    //  A value-echo is a golden by another name: `eqf("health", g_HP_MAX,
    //  100.0)` goes red if the constant moves and is silent about everything
    //  the constant IS. It cannot tell you whether the number reaches the
    //  player's body, whether the death flag keys off it, or whether the HUD's
    //  bar and numeral would still read what a player expects.
    //
    //  So this is the same constant asserted through the SHIPPING damage path:
    //  a real world, a real player spawned by `sim_add_player`, real calls to
    //  `combat_apply_damage` with the same arguments `sim.hml` uses for an
    //  enemy contact hit, and `combat_is_dead` for the verdict. The numbers
    //  below are LITERALS on purpose. At g_HP_MAX = 250 the survivable-hit
    //  count and the HUD numeral both move and all four go red; a rule phrased
    //  in terms of g_HP_MAX would have passed at any value, which is the whole
    //  defect being fixed.
    print("");
    print("-----------------------------------------------------------------");
    print(" K. g_HP_MAX, through the real damage path");
    print("-----------------------------------------------------------------");
    let hw: object = sim_new(g_PS_SEED);
    let hpid: i32 = sim_add_player(hw, 1, 0.0, 0.0);
    let hslot: i32 = world_slot_of(hw, hpid);
    let hcx: object = sim_combat(hw);
    let harr = hw.hp;

    let spawn_hp: i32 = harr[hslot];
    // ONE 25-POINT CONTACT HIT, through combat_apply_damage.
    combat_apply_damage(hcx, hw, 0 - 1, hslot, 25.0, WPN_NONE, DMG_CONTACT, 0,
                        0.0, 1.0, 0.0, 1.0, 0.0);
    let after_one: i32 = harr[hslot];
    // ...and then keep hitting until the sim says the body is dead.
    let hits: i32 = 1;
    let low_at: i32 = 0;
    while (combat_is_dead(hw, hslot) == 0 && hits < 200) {
        if (low_at == 0 && f64(harr[hslot]) <= g_LOW_HP) { low_at = hits; }
        combat_apply_damage(hcx, hw, 0 - 1, hslot, 25.0, WPN_NONE, DMG_CONTACT, 0,
                            0.0, 1.0, 0.0, 1.0, 0.0);
        hits = hits + 1;
    }
    print("    spawn hp                       " + sv(spawn_hp)
          + "   (g_HP_MAX is " + f1(g_HP_MAX) + ")");
    print("    after one 25-point contact hit " + sv(after_one)
          + "   <- what the HUD numeral reads");
    print("    hits of 25 to kill a fresh player " + sv(hits));
    print("    ...the numeral turns UI_DANGER (hp <= " + f1(g_LOW_HP)
          + ") after hit " + sv(low_at));
    ck(after_one == 75,
       "one 25-point contact hit through combat_apply_damage leaves the player on "
       + sv(after_one) + " HP -- the number the HUD's health numeral prints and the "
       + "fraction its bar fills. At g_HP_MAX 250 this reads 225");
    ck(hits == 4,
       "a fresh player survives three 25-point hits and dies on the FOURTH ("
       + sv(hits) + "), measured through combat_apply_damage and combat_is_dead, "
       + "not derived from g_HP_MAX -- an assertion written in terms of the "
       + "constant passes at every value of it, which is exactly how 250 stayed "
       + "green in probe_sim");
    ck(low_at == 3,
       "and the numeral goes UI_DANGER after the THIRD hit (" + sv(low_at)
       + "): g_LOW_HP " + f1(g_LOW_HP) + " is 35 % of g_HP_MAX, so moving either "
       + "one silently moves when the player is told they are in trouble");
    ck(spawn_hp == 100,
       "the body sim_add_player puts in the world starts on " + sv(spawn_hp)
       + " HP -- the echo, kept, but now beside three assertions about what that "
       + "number DOES");

    // -----------------------------------------------------------------------
    print("");
    if (g_n != g_PS_EXPECT) {
        print("FAIL: ran " + sv(g_n) + " assertions, expected " + sv(g_PS_EXPECT));
        exit(1);
    }
    if (g_ok != g_n) {
        print("FAIL " + sv(g_ok) + " / " + sv(g_n));
        exit(1);
    }
    print("PASS " + sv(g_ok) + " / " + sv(g_n));
}

main();
