    SET_PTS_VILLAGE, SET_PTS_TOWN, SET_PTS_CITY,
    SET_CORE_VILLAGE, SET_CORE_TOWN, SET_CORE_CITY,
    SET_GL_VILLAGE, SET_GL_TOWN, SET_GL_CITY,
    SET_LUX_PER_POINT, SET_CL_MAX, SET_WICK_FULL, SET_WICK_SAFE,
    SET_GREEN_R_M, SET_CORE_FLOOR,
    SET_DECAY_MAX, SET_DECAY_SPAN, SET_DECAY_SAT_LUX,
    SET_PLOTS, SET_PLOT_W_M, SET_PLOT_D_M, SET_PLOT_PITCH_M, SET_PLOT_RANGE_M,
    SET_ROAD_STEP_M, SET_ROAD_STEPS, SET_ROAD_MESH_STEPS, SET_ROAD_PTS,
    SET_CON_STAKED, SET_CON_FRAMED, SET_CON_CLAD, SET_CON_DONE,
    SET_B_SHACK, SET_B_COTTAGE, SET_B_HOUSE, SET_B_HALL, SET_B_TOWER,
    SET_B_STACK, SET_B_WELL, SET_B_WORKS, SET_BLD_MAX,
    SET_IND_COLD, SET_IND_BROWNOUT, SET_IND_FLICKER, SET_IND_RUNNING,
    SET_FEEDER_MIN, SET_COLD_POINTS, SET_RELIGHT_EMBER, SET_SLICE,
    SET_SAVE_COLS, SET_META_COLS, SET_SITE_VETO, SET_SITE_CANDS,
    SET_EV_PROMOTED, SET_EV_BUILD_DONE,
    settle_new, settle_new_at, settle_refresh, settle_step,
    settle_cx, settle_cz, settle_deck_y, settle_bearing, settle_name,
    settle_site_x, settle_site_z, settle_site_bearing, settle_site_deck_y,
    settle_site_name, settle_site_name_at, settle_site_score, settle_site_pick,
