// ---------------------------------------------------------------------------
// EXPECTED ASSERTION COUNT — bump deliberately, never to make red go green
// ---------------------------------------------------------------------------
let g_expect_asserts = 231;

let g_asserts = 0;
let g_pass = 0;
let g_fail = 0;

fn ck(p_cond: bool, p_name: string, p_detail: string) {
    g_asserts = g_asserts + 1;
    if (p_cond) { g_pass = g_pass + 1; }
    else {
        g_fail = g_fail + 1;
        print(`  FAIL  ${p_name}  --  ${p_detail}`);
    }
}

fn approx(p_a: f64, p_b: f64, p_eps: f64): bool {
    let d: f64 = __abs(p_a - p_b);
    let out: bool = d <= p_eps;
    return out;
}

fn dist2d(p_ax: f64, p_az: f64, p_bx: f64, p_bz: f64): f64 {
    let dx: f64 = p_ax - p_bx;
    let dz: f64 = p_az - p_bz;
    let out: f64 = __sqrt(dx * dx + dz * dz);
    return out;
}

// A settlement whose lantern grid is a hex-ish ring lattice around C.  Every
// section that needs light uses this so the light is a PLACE, not a scalar
// somebody typed in.
fn light(p_st: object, p_rings: i32, p_tier: f64, p_wick: f64): i32 {
    let a: array<f64> = [];
    a.push(settle_cx(p_st)); a.push(settle_cz(p_st)); a.push(p_tier); a.push(p_wick);
    let n: i32 = 1;
    let r: i32 = 1;
    while (r <= p_rings) {
        let cnt: i32 = r * 6;
        let k: i32 = 0;
        while (k < cnt) {
            let ang: f64 = 6.283185307179586 * f64(k) / f64(cnt);
            let rad: f64 = f64(r) * 55.0;
            a.push(settle_cx(p_st) + __sin(ang) * rad);
            a.push(settle_cz(p_st) - __cos(ang) * rad);
            a.push(p_tier); a.push(p_wick);
            n++; k++;
        }
        r++;
    }
    settle_lanterns_set(p_st, a, n);
    settle_refresh(p_st);
    let out: i32 = n;
    return out;
}

fn advance(p_st: object, p_ticks: i32, p_t0: i32): i32 {
    let t: i32 = p_t0;
    let end: i32 = p_t0 + p_ticks;
    while (t < end) { settle_step(p_st, t); t = t + 60; }
    let out: i32 = end;
    return out;
}

// ===========================================================================
// A.  THE DESIGN ANCHORS — pinned with literals (CLAUDE.md rule 5)
// ===========================================================================
fn section_anchors() {
    print("A. Design anchors (SETTLEMENT.md §2, §3.1, §5.4 — literals, not config reads)");

    ck(SET_TIER_CAMP == 0 && SET_TIER_VILLAGE == 1 && SET_TIER_TOWN == 2 && SET_TIER_CITY == 3,
       "A1 tier ladder is CAMP..CITY = 0..3", `${SET_TIER_CITY}`);
    ck(approx(SET_RING_CAMP_M, 64.0, 0.0) && approx(SET_RING_VILLAGE_M, 120.0, 0.0)
       && approx(SET_RING_TOWN_M, 200.0, 0.0) && approx(SET_RING_CITY_M, 320.0, 0.0),
       "A2 rings 64 / 120 / 200 / 320 m", `${SET_RING_CITY_M}`);
    ck(SET_PTS_VILLAGE == 10 && SET_PTS_TOWN == 32 && SET_PTS_CITY == 72,
       "A3 grid points 10 / 32 / 72", `${SET_PTS_CITY}`);
    ck(SET_CORE_VILLAGE == 512 && SET_CORE_TOWN == 1024 && SET_CORE_CITY == 2048,
       "A4 CORE_LUX floors 512 / 1024 / 2048", `${SET_CORE_CITY}`);
    ck(SET_GL_VILLAGE == 1 && SET_GL_TOWN == 2 && SET_GL_CITY == 4,
       "A5 Great Lantern gates T1 / T2 / T4", `${SET_GL_CITY}`);
    ck(SET_LUX_PER_POINT == 256, "A6 LUX is 1/256 of one unlinked lit lantern", `${SET_LUX_PER_POINT}`);
    ck(SET_CL_MAX == 4096, "A7 CL_MAX = 4096 = 16 lantern-equivalents (§11.4)", `${SET_CL_MAX}`);
    ck(SET_WICK_FULL == 256 && SET_WICK_SAFE == 128,
       "A8 wick 0..256, snuff-proof at >= 128", `${SET_WICK_SAFE}`);
    ck(approx(SET_GREEN_R_M, 16.0, 0.0), "A9 green keep-out is 16 m", `${SET_GREEN_R_M}`);
    ck(SET_CORE_FLOOR == 512, "A10 the green's hard CORE_LUX floor is 512", `${SET_CORE_FLOOR}`);
    ck(SET_DECAY_MAX == 16 && SET_DECAY_SPAN == 14 && SET_DECAY_SAT_LUX == 2048,
       "A11 entropy 16 - floor(14 * min(1, LUX/2048))", `${SET_DECAY_SPAN}`);
    ck(SET_PLOTS == 72, "A12 the lattice is 72 plots", `${SET_PLOTS}`);
    ck(approx(SET_PLOT_W_M, 12.0, 0.0) && approx(SET_PLOT_D_M, 10.0, 0.0),
       "A13 a plot is 12 m x 10 m", `${SET_PLOT_W_M}x${SET_PLOT_D_M}`);
    ck(approx(SET_PLOT_PITCH_M, 14.0, 0.0), "A14 plot pitch is 14 m", `${SET_PLOT_PITCH_M}`);
    ck(approx(SET_PLOT_RANGE_M, 2.4, 0.0),
       "A15 plot corner range limit is SETTLEMENT.md §5.5's 2.4 m, UNCHANGED", `${SET_PLOT_RANGE_M}`);
    ck(approx(SET_ROAD_STEP_M, 8.0, 0.0) && SET_ROAD_MESH_STEPS == 12,
       "A16 road steps 8 m, 12 of them drawn (§5.3's 96 m)", `${SET_ROAD_MESH_STEPS}`);
    ck(SET_ROAD_PTS == SET_ROAD_STEPS + 1, "A17 road polyline has steps+1 points", `${SET_ROAD_PTS}`);
    ck(f64(SET_ROAD_STEPS) * SET_ROAD_STEP_M >= 22.0 + SET_PLOT_PITCH_M * 11.0,
       "A18 D1: the polyline reaches plot slot 11",
       `${f64(SET_ROAD_STEPS) * SET_ROAD_STEP_M} vs ${22.0 + SET_PLOT_PITCH_M * 11.0}`);
    ck(SET_CON_STAKED == 0 && SET_CON_FRAMED == 1 && SET_CON_CLAD == 2 && SET_CON_DONE == 3,
       "A19 construction STAKED < FRAMED < CLAD < DONE", `${SET_CON_DONE}`);
    ck(SET_BLD_MAX == 28, "A20 D5: a complete City is 28 buildings", `${SET_BLD_MAX}`);
    ck(SET_FEEDER_MIN == 6, "A21 F4 needs >= 6 lit lanterns", `${SET_FEEDER_MIN}`);
    ck(SET_COLD_POINTS == 58, "A22 COLD at grid points < 58 (80 % of 72)", `${SET_COLD_POINTS}`);
    ck(SET_RELIGHT_EMBER == 200, "A23 relight costs 200 Ember", `${SET_RELIGHT_EMBER}`);
    ck(SET_SLICE == 8, "A24 8 lanterns re-integrated per settle tick (§2.4)", `${SET_SLICE}`);
    ck(SET_SAVE_COLS == 4 && SET_META_COLS == 8,
       "A25 delta-log columns 4 / 8 (§8.5)", `${SET_SAVE_COLS}/${SET_META_COLS}`);

    // the lantern radii are the GDD's and must come from config, not from here
    ck(approx(settle_lantern_radius(1), g_LANTERN_R_T1, 0.0)
       && approx(settle_lantern_radius(2), g_LANTERN_R_T2, 0.0)
       && approx(settle_lantern_radius(3), g_LANTERN_R_T3, 0.0)
       && approx(settle_lantern_radius(4), g_LANTERN_R_T4, 0.0),
       "A26 lantern radii come from config (40/60/85/120)",
       `${settle_lantern_radius(4)}`);
    ck(approx(g_LANTERN_R_T1, 40.0, 0.0) && approx(g_LANTERN_R_T4, 120.0, 0.0),
       "A27 ... and config still says 40 and 120", `${g_LANTERN_R_T4}`);
    ck(approx(g_WICKLINE_M, 90.0, 0.0), "A28 Wick Line link range is 90 m", `${g_WICKLINE_M}`);

    // the tier tables agree with the anchors
    ck(settle_tier_points(SET_TIER_VILLAGE) == SET_PTS_VILLAGE
       && settle_tier_points(SET_TIER_TOWN) == SET_PTS_TOWN
       && settle_tier_points(SET_TIER_CITY) == SET_PTS_CITY
       && settle_tier_points(SET_TIER_CAMP) == 0,
       "A29 settle_tier_points matches the ladder", "-");
    ck(settle_tier_core(SET_TIER_CITY) == SET_CORE_CITY
       && settle_tier_gl(SET_TIER_CITY) == SET_GL_CITY,
       "A30 settle_tier_core / _gl match the ladder", "-");
    ck(settle_road_count(SET_TIER_CAMP) == 1 && settle_road_count(SET_TIER_VILLAGE) == 2
       && settle_road_count(SET_TIER_TOWN) == 3 && settle_road_count(SET_TIER_CITY) == 3,
       "A31 roads 1 / 2 / 3 / 3 (§5.3)", `${settle_road_count(SET_TIER_CITY)}`);
    ck(settle_ring_m(SET_TIER_CITY) > settle_ring_m(SET_TIER_TOWN)
       && settle_ring_m(SET_TIER_TOWN) > settle_ring_m(SET_TIER_VILLAGE)
       && settle_ring_m(SET_TIER_VILLAGE) > settle_ring_m(SET_TIER_CAMP),
       "A32 the ring only ever grows", "-");
    ck(settle_tier_buildings(SET_TIER_CAMP) == 2 && settle_tier_buildings(SET_TIER_VILLAGE) == 9
       && settle_tier_buildings(SET_TIER_TOWN) == 17 && settle_tier_buildings(SET_TIER_CITY) == 28,
       "A33 cumulative buildings 2 / 9 / 17 / 28 (§3.3)",
       `${settle_tier_buildings(SET_TIER_CITY)}`);
    ck(settle_born_state(SET_TIER_CAMP) == SET_CON_FRAMED
       && settle_born_state(SET_TIER_VILLAGE) == SET_CON_FRAMED
       && settle_born_state(SET_TIER_TOWN) == SET_CON_STAKED
       && settle_born_state(SET_TIER_CITY) == SET_CON_STAKED,
       "A34 §6.2: camp ruins and the village start FRAMED, town/city STAKE first", "-");
    ck(SET_B_SHACK == 0 && SET_B_WORKS == 7,
       "A35 archetypes SET_B_SHACK..SET_B_WORKS", `${SET_B_WORKS}`);
    ck(SET_IND_COLD == 0 && SET_IND_BROWNOUT == 1 && SET_IND_FLICKER == 2 && SET_IND_RUNNING == 3,
       "A36 industry COLD < BROWNOUT < FLICKER < RUNNING", `${SET_IND_RUNNING}`);
}

// ===========================================================================
// B.  SITE SELECTION — pure, total, position-parametric, and it vetoes the Fen
// ===========================================================================
fn section_site() {
    print("B. Site selection (§1)");

    // purity: the same arguments give the same answer, every time
    let s1: f64 = settle_site_score(12345, 12.0, -8.0);
    let s2: f64 = settle_site_score(12345, 12.0, -8.0);
    ck(s1 == s2, "B1 settle_site_score is pure", `${s1} vs ${s2}`);

    // position-parametric (§1.1's promise, DIRECTION.md §8 cashes it in)
    let a: f64 = settle_site_score(12345, 0.0, 0.0);
    let b: f64 = settle_site_score(12345, 4000.0, -7000.0);
    ck(a != b, "B2 the scorer is position-parametric", `${a} vs ${b}`);

    // the veto: find a Fen point and check it is refused outright
    let found: i32 = 0;
    let vx: f64 = 0.0;
    let vz: f64 = 0.0;
    let i: i32 = 0;
    while (i < 4000) {
        let x: f64 = f64((i * 137) % 4001) * 3.0 + 200.0;
        let z: f64 = f64((i * 271) % 4001) * 3.0 - 6000.0;
        let t: f64 = worldgen_temp(4242, x, z);
        let m: f64 = worldgen_moist(4242, x, z);
        let d: f64 = __sqrt(x * x + z * z);
        if (worldgen_biome_tmd(t, m, d) == WG_BIOME_FEN) {
            if (found == 0) { found = 1; vx = x; vz = z; }
        }
        i++;
    }
    ck(found == 1, "B3 the survey found a Fen point to veto", `${found}`);
    ck(settle_site_score(4242, vx, vz) <= SET_SITE_VETO,
       "B4 C6 hard-vetoes the Fen: you do not found a town in black water",
       `${settle_site_score(4242, vx, vz)}`);

    // the pick really is the argmax over the 81 candidates, ties to lowest k
    let sd: i32 = 31677;
    let k: i32 = settle_site_pick(sd, 0, 0);
    let bestv: f64 = SET_SITE_VETO - 1.0;
    let bestk: i32 = -1;
    let q: i32 = 0;
    while (q < SET_SITE_CANDS) {
        let v: f64 = settle_site_score(sd, worldgen_site_cand_x(sd, 0, 0, q),
                                           worldgen_site_cand_z(sd, 0, 0, q));
        if (v > bestv) { bestv = v; bestk = q; }
        q++;
    }
    ck(k == bestk, "B5 settle_site_pick is the argmax, lowest index on a tie",
       `${k} vs ${bestk}`);
    ck(SET_SITE_CANDS == WG_SITE_CANDIDATES && SET_SITE_CANDS == 81,
       "B6 81 candidates, the 9x9 / 12 m lattice", `${SET_SITE_CANDS}`);

    // §1.1: the home settlement's centre lies inside the +/-48 m square
    let sx: f64 = settle_site_x(sd);
    let sz: f64 = settle_site_z(sd);
    ck(__abs(sx) <= 48.0 && __abs(sz) <= 48.0,
       "B7 §1.1 the home site stays inside the +/-48 m square around origin",
       `${sx}, ${sz}`);
    ck(approx(sx / 12.0 - __floor(sx / 12.0), 0.0, 0.0000001),
       "B8 ... and on the 12 m lattice", `${sx}`);

    // the deck is a MEDIAN of the nine r<=10 m samples, never a mean
    let dy: f64 = settle_site_deck_y(sd);
    let lo: f64 = worldgen_height(sd, sx, sz);
    let hi: f64 = lo;
    let below: i32 = 0;
    let above: i32 = 0;
    let j: i32 = 0;
    while (j < 8) {
        let ang: f64 = f64(j) * 0.7853981633974483;
        let h: f64 = worldgen_height(sd, sx + __sin(ang) * 8.0, sz - __cos(ang) * 8.0);
        if (h < lo) { lo = h; }
        if (h > hi) { hi = h; }
        if (h < dy) { below++; }
        if (h > dy) { above++; }
        j++;
    }
    ck(dy >= lo && dy <= hi, "B9 the terrace height is inside the sample range",
       `${dy} in [${lo}, ${hi}]`);
    ck(below <= 4 && above <= 4,
       "B10 §1.4 the terrace height is the MEDIAN, never a mean",
       `${below} below / ${above} above`);

    // the bearing is a real bearing and it is the LOWEST 48 m sample
    let th: f64 = settle_site_bearing(sd);
    let hth: f64 = worldgen_height(sd, sx + __sin(th) * 48.0, sz - __cos(th) * 48.0);
    let worse: i32 = 0;
    let r: i32 = 0;
    while (r < 8) {
        let ang: f64 = f64(r) * 0.7853981633974483;
        let h: f64 = worldgen_height(sd, sx + __sin(ang) * 48.0, sz - __cos(ang) * 48.0);
        if (h < hth) { worse++; }
        r++;
    }
    ck(worse == 0, "B11 theta0 IS C4's view corridor: the lowest 48 m bearing",
       `${worse} lower bearings exist`);

    // the name table: index 0 is Ember Hollow, on every seed
    ck(settle_site_name(1) == 0 && settle_site_name(999983) == 0 && settle_site_name(-7) == 0,
       "B12 §5.7 index 0 is Ember Hollow and is the home cell on every seed", "-");
    let distinct: i32 = 0;
    let c: i32 = 1;
    while (c < 40) {
        let nm: i32 = settle_site_name_at(11, c, 3);
        if (nm >= 1 && nm <= 127) { distinct++; }
        c++;
    }
    ck(distinct == 39, "B13 every other cell names in 1..127", `${distinct}`);

    // C8's anchor guarantee
    let d64: f64 = settle_nearest_anchor_d(sd, sx, sz);
    ck(d64 > 64.0 && d64 < 400.0,
       "B14 C8 finds an anchor strictly outside 64 m", `${d64}`);
}

// ===========================================================================
// C.  MULTI-SITE — DIRECTION.md §8.  A world is a REGION.
// ===========================================================================
fn section_multisite() {
    print("C. Multi-site sampling (DIRECTION.md §8)");

    ck(approx(WG_SITE_CELL_M, 1200.0, 0.0),
       "C1 the cell is DIRECTION.md's typical 1200 m", `${WG_SITE_CELL_M}`);
    ck(approx(WG_SITE_MIN_SEP_M, 1000.0, 0.0),
       "C2 minimum separation is 1000 m", `${WG_SITE_MIN_SEP_M}`);
    ck(approx(settle_min_separation_m(), 1000.0, 0.0) && approx(settle_cell_m(), 1200.0, 0.0),
       "C3 settle re-exports both unchanged", "-");
    ck(WG_SITE_LAT_N == 9 && approx(WG_SITE_LAT_STEP_M, 12.0, 0.0),
       "C4 the candidate lattice is 9x9 at 12 m", `${WG_SITE_LAT_N}`);
    // THE PROOF, restated as arithmetic the probe can check
    ck(approx(WG_SITE_MAX_DEV_M, WG_SITE_JITTER_M + f64(WG_SITE_LAT_N - 1) * 0.5 * WG_SITE_LAT_STEP_M, 0.000001),
       "C5 MAX_DEV = JITTER + 4*STEP", `${WG_SITE_MAX_DEV_M}`);
    ck(approx(WG_SITE_CELL_M - 2.0 * WG_SITE_MAX_DEV_M, WG_SITE_MIN_SEP_M, 0.000001),
       "C6 CELL - 2*MAX_DEV == MIN_SEP: the separation bound is ARITHMETIC",
       `${WG_SITE_CELL_M - 2.0 * WG_SITE_MAX_DEV_M}`);

    // ... and measured, over every candidate of every cell in a 9x9 block on
    // 4 seeds.  An arithmetic bound nobody re-checks is a comment.
    let worst: f64 = 1000000.0;
    let seeds: array<i32> = [1, 31677, -7, 2146483647];
    let si: i32 = 0;
    while (si < 4) {
        let sd: i32 = seeds[si];
        let gz: i32 = -4;
        while (gz <= 4) {
            let gx: i32 = -4;
            while (gx <= 4) {
                let ax: f64 = worldgen_site_anchor_x(sd, gx, gz);
                let az: f64 = worldgen_site_anchor_z(sd, gx, gz);
                if (__abs(ax - worldgen_site_cell_cx(gx)) > WG_SITE_JITTER_M) { worst = -1.0; }
                if (__abs(az - worldgen_site_cell_cz(gz)) > WG_SITE_JITTER_M) { worst = -1.0; }
                // the extreme corner candidate of this cell against the extreme
                // corner candidate of the +X and +Z neighbours
                let bx: f64 = worldgen_site_anchor_x(sd, gx + 1, gz);
                let d1: f64 = (bx - f64(WG_SITE_LAT_N - 1) * 0.5 * WG_SITE_LAT_STEP_M)
                            - (ax + f64(WG_SITE_LAT_N - 1) * 0.5 * WG_SITE_LAT_STEP_M);
                if (d1 < worst) { worst = d1; }
                let bz: f64 = worldgen_site_anchor_z(sd, gx, gz + 1);
                let d2: f64 = (bz - f64(WG_SITE_LAT_N - 1) * 0.5 * WG_SITE_LAT_STEP_M)
                            - (az + f64(WG_SITE_LAT_N - 1) * 0.5 * WG_SITE_LAT_STEP_M);
                if (d2 < worst) { worst = d2; }
                gx++;
            }
            gz++;
        }
        si++;
    }
    print(`   C7  worst axis separation over 4 seeds x 81 cells: ${worst} m`);
    ck(worst >= WG_SITE_MIN_SEP_M,
       "C7 no two adjacent cells can ever place sites closer than 1000 m", `${worst}`);

    // the actual chosen sites, scored, on a 3x3 block — the expensive one
    let sd2: i32 = 31677;
    let sxs: array<f64> = [];
    let szs: array<f64> = [];
    let occ: i32 = 0;
    let gz2: i32 = -1;
    while (gz2 <= 1) {
        let gx2: i32 = -1;
        while (gx2 <= 1) {
            if (settle_cell_occupied(sd2, gx2, gz2) == 1) {
                sxs.push(settle_site_x_at(sd2, gx2, gz2));
                szs.push(settle_site_z_at(sd2, gx2, gz2));
                occ++;
            }
            gx2++;
        }
        gz2++;
    }
    let mind: f64 = 1000000.0;
    let i2: i32 = 0;
    while (i2 < occ) {
        let j2: i32 = i2 + 1;
        while (j2 < occ) {
            let d: f64 = dist2d(sxs[i2], szs[i2], sxs[j2], szs[j2]);
            if (d < mind) { mind = d; }
            j2++;
        }
        i2++;
    }
    print(`   C8  ${occ} of 9 cells occupied; closest real pair ${mind} m`);
    ck(occ >= 2, "C8 a 3x3 block holds at least two settlements", `${occ}`);
    ck(mind >= WG_SITE_MIN_SEP_M,
       "C9 measured: the closest real pair is at or beyond 1000 m", `${mind}`);
    ck(mind <= 3.0 * WG_SITE_CELL_M,
       "C10 ... and they are walkable, not scattered to the horizon", `${mind}`);

    // the home cell is always occupied and always at the origin
    ck(worldgen_site_occupied_roll(12345, 0, 0) == 1
       && worldgen_site_occupied_roll(-9, 0, 0) == 1,
       "C11 cell (0,0) is always occupied — the player wakes up in it", "-");
    ck(approx(worldgen_site_anchor_x(12345, 0, 0), 0.0, 0.0)
       && approx(worldgen_site_anchor_z(12345, 0, 0), 0.0, 0.0),
       "C12 the home cell does not jitter (§1.1)", "-");
    // occupancy is neither 0 nor 1
    let on: i32 = 0;
    let tot: i32 = 0;
    let gz3: i32 = -12;
    while (gz3 <= 12) {
        let gx3: i32 = -12;
        while (gx3 <= 12) {
            on = on + worldgen_site_occupied_roll(4242, gx3, gz3);
            tot++;
            gx3++;
        }
        gz3++;
    }
    let frac: f64 = f64(on) / f64(tot);
    print(`   C13 occupancy over ${tot} cells: ${frac}`);
    ck(frac > 0.45 && frac < 0.75,
       "C13 occupancy is the blue-noise term, near 0.60", `${frac}`);

    // cell lookup round-trips
    ck(worldgen_site_cell_of(0.0) == 0 && worldgen_site_cell_of(599.0) == 0
       && worldgen_site_cell_of(601.0) == 1 && worldgen_site_cell_of(-601.0) == -1,
       "C14 cell 0 spans [-600, +600): the origin is its centre", "-");
    ck(settle_cell_x_of(1300.0) == 1 && settle_cell_z_of(-1300.0) == -1,
       "C15 settle_cell_*_of agrees", "-");

    // a settlement built in another cell is a real, different settlement
    let stA = settle_new_at(31677, 0, 0);
    let stB = settle_new_at(31677, 1, 0);
    let dAB: f64 = dist2d(settle_cx(stA), settle_cz(stA), settle_cx(stB), settle_cz(stB));
    ck(dAB >= WG_SITE_MIN_SEP_M,
       "C16 two settlements of one world are >= 1000 m apart", `${dAB}`);
    ck(settle_name(stA) != settle_name(stB),
       "C17 ... and they are not the same town", `${settle_name(stA)} vs ${settle_name(stB)}`);
    ck(settle_hash(stA) != settle_hash(stB),
       "C18 ... and they do not hash the same", "-");
    // DIRECTION.md §8's walk times
    let walk_s: f64 = dAB / 4.4;
    let sprint_s: f64 = dAB / 7.0;
    print(`   C19 separation ${dAB} m = ${walk_s / 60.0} min walk / ${sprint_s / 60.0} min sprint`);
    ck(walk_s >= 180.0 && walk_s <= 900.0,
       "C19 a journey, not a commute: 3..15 min on foot", `${walk_s}`);
}

// ===========================================================================
// D.  LAYOUT — roads, plots, and "skipped, never moved"
// ===========================================================================
fn section_layout() {
    print("D. Layout passes (§5)");
    let sd: i32 = 31677;
    let st = settle_new(sd);
    let cx: f64 = settle_cx(st);
    let cz: f64 = settle_cz(st);

    ck(settle_plot_count() == 72, "D1 72 plots", `${settle_plot_count()}`);

    // pid decomposition is a bijection onto (road, side, slot)
    let seen: array<i32> = [];
    let z: i32 = 0;
    while (z < 72) { seen.push(0); z++; }
    let bad: i32 = 0;
    let p: i32 = 0;
    while (p < 72) {
        let r: i32 = settle_pid_road(p);
        let s: i32 = settle_pid_side(p);
        let sl: i32 = settle_pid_slot(p);
        if (r < 0 || r > 2 || s < 0 || s > 1 || sl < 0 || sl > 11) { bad++; }
        if (r * 24 + s * 12 + sl != p) { bad++; }
        seen[r * 24 + s * 12 + sl] = 1;
        p++;
    }
    let cover: i32 = 0;
    let q: i32 = 0;
    while (q < 72) { cover = cover + seen[q]; q++; }
    ck(bad == 0 && cover == 72,
       "D2 PLOT_ID = road*24 + side*12 + slot is a bijection", `${bad}/${cover}`);

    // road steps are exactly 8 m and the polyline never doubles back
    let maxerr: f64 = 0.0;
    let minturn: f64 = 10.0;
    let rr: i32 = 0;
    while (rr < 3) {
        let s2: i32 = 0;
        while (s2 < SET_ROAD_STEPS) {
            let d: f64 = dist2d(settle_road_pt_x(st, rr, s2), settle_road_pt_z(st, rr, s2),
                                settle_road_pt_x(st, rr, s2 + 1), settle_road_pt_z(st, rr, s2 + 1));
            let e: f64 = __abs(d - SET_ROAD_STEP_M);
            if (e > maxerr) { maxerr = e; }
            s2++;
        }
        rr++;
    }
    ck(maxerr < 0.000001, "D3 every road step is exactly 8 m", `${maxerr}`);

    // the roads start at C and diverge
    let d0: f64 = dist2d(settle_road_pt_x(st, 0, 0), settle_road_pt_z(st, 0, 0), cx, cz);
    ck(d0 < 0.000001, "D4 all three roads start at the settlement centre", `${d0}`);
    let e0: f64 = dist2d(settle_road_pt_x(st, 0, SET_ROAD_STEPS), settle_road_pt_z(st, 0, SET_ROAD_STEPS),
                         settle_road_pt_x(st, 2, SET_ROAD_STEPS), settle_road_pt_z(st, 2, SET_ROAD_STEPS));
    ck(e0 > 100.0, "D5 the High Road and the Back Lane end far apart (§5.3)", `${e0}`);

    // the greedy walk really is least-grade: compare its total climb against a
    // straight line to the same target bearing
    let climb_road: f64 = 0.0;
    let climb_str: f64 = 0.0;
    let hprev: f64 = worldgen_height(sd, cx, cz);
    let hs: f64 = hprev;
    let bear: f64 = settle_bearing(st);
    let s3: i32 = 1;
    while (s3 <= SET_ROAD_STEPS) {
        let h: f64 = worldgen_height(sd, settle_road_pt_x(st, 0, s3), settle_road_pt_z(st, 0, s3));
        climb_road = climb_road + __abs(h - hprev);
        hprev = h;
        let sx2: f64 = cx + __sin(bear) * SET_ROAD_STEP_M * f64(s3);
        let sz2: f64 = cz - __cos(bear) * SET_ROAD_STEP_M * f64(s3);
        let h2: f64 = worldgen_height(sd, sx2, sz2);
        climb_str = climb_str + __abs(h2 - hs);
        hs = h2;
        s3++;
    }
    print(`   D6  High Road total |dh| ${climb_road} m vs straight line ${climb_str} m`);
    ck(climb_road <= climb_str,
       "D6 §5.3 the greedy walk bends around the hill instead of climbing it",
       `${climb_road} vs ${climb_str}`);

    // the pure road_point form agrees with the cached one — the determinism
    // guarantee that makes the cache safe
    let out: array<f64> = [0.0, 0.0, 0.0];
    let okpt: i32 = 1;
    let rq: i32 = 0;
    while (rq < 3) {
        settle_road_point(sd, 0, 0, rq, 7, out);
        if (__abs(out[0] - settle_road_pt_x(st, rq, 7)) > 0.0) { okpt = 0; }
        if (__abs(out[1] - settle_road_pt_z(st, rq, 7)) > 0.0) { okpt = 0; }
        rq++;
    }
    ck(okpt == 1, "D7 the pure road walk and the store's cache are bit-identical", "-");
    ck(settle_road_point(sd, 0, 0, 3, 0, out) == 0
       && settle_road_point(sd, 0, 0, 0, SET_ROAD_PTS, out) == 0,
       "D8 out-of-range road/step is refused, never guessed", "-");

    // every plot faces its road, and the two sides of a street face each other
    let facing_bad: i32 = 0;
    let lateral_bad: i32 = 0;
    let pp: i32 = 0;
    while (pp < 72) {
        let px: f64 = settle_plot_x(st, pp);
        let pz: f64 = settle_plot_z(st, pp);
        let yaw: f64 = settle_plot_yaw(st, pp);
        let slot: i32 = settle_pid_slot(pp);
        let road: i32 = settle_pid_road(pp);
        // walking 9 m along the facing direction must land within a metre of
        // the road centreline sample the plot was derived from
        let arc: f64 = 22.0 + 14.0 * f64(slot);
        let seg: i32 = i32(__floor(arc / 8.0));
        if (seg > SET_ROAD_STEPS - 1) { seg = SET_ROAD_STEPS - 1; }
        let tt: f64 = arc / 8.0 - f64(seg);
        let ax: f64 = settle_road_pt_x(st, road, seg);
        let az: f64 = settle_road_pt_z(st, road, seg);
        let bx: f64 = settle_road_pt_x(st, road, seg + 1);
        let bz: f64 = settle_road_pt_z(st, road, seg + 1);
        let ox: f64 = ax + (bx - ax) * tt;
        let oz: f64 = az + (bz - az) * tt;
        if (__abs(dist2d(px, pz, ox, oz) - 9.0) > 0.000001) { lateral_bad++; }
        let fx: f64 = px + __sin(yaw) * 9.0;
        let fz: f64 = pz - __cos(yaw) * 9.0;
        if (dist2d(fx, fz, ox, oz) > 0.000001) { facing_bad++; }
        pp++;
    }
    ck(lateral_bad == 0, "D9 every plot sits exactly 9 m off its road centreline",
       `${lateral_bad} wrong`);
    ck(facing_bad == 0,
       "D10 §5.4 / D2: every building faces the road BY CONSTRUCTION",
       `${facing_bad} wrong`);

    // opposite sides of the same street face each other
    let opp_bad: i32 = 0;
    let oz2: i32 = 0;
    while (oz2 < 36) {
        let r2: i32 = oz2 / 12;
        let sl2: i32 = oz2 % 12;
        let l: i32 = r2 * 24 + sl2;
        let rgt: i32 = r2 * 24 + 12 + sl2;
        let dy: f64 = __abs(settle_plot_yaw(st, l) - settle_plot_yaw(st, rgt));
        if (__abs(dy - 3.141592653589793) > 0.000001) { opp_bad++; }
        oz2++;
    }
    ck(opp_bad == 0, "D11 the two sides of a street face each other, 180 deg apart",
       `${opp_bad} wrong`);

    // §5.5 — the three validity tests, each independently observable
    let keepout_bad: i32 = 0;
    let range_bad: i32 = 0;
    let fen_bad: i32 = 0;
    let vp: i32 = 0;
    while (vp < 72) {
        if (settle_plot_valid(st, vp) == 1) {
            let px: f64 = settle_plot_x(st, vp);
            let pz: f64 = settle_plot_z(st, vp);
            let yaw: f64 = settle_plot_yaw(st, vp);
            // reconstruct the plot rectangle from its facing yaw
            let lx: f64 = 0.0 - __sin(yaw);
            let lz: f64 = __cos(yaw);
            let ux: f64 = 0.0 - lz;
            let uz: f64 = lx;
            let lo: f64 = 0.0;
            let hi: f64 = 0.0;
            let mind: f64 = 1000000.0;
            let c: i32 = 0;
            while (c < 4) {
                let su: f64 = 1.0;
                if (c >= 2) { su = -1.0; }
                let sv: f64 = 1.0;
                if (c % 2 == 1) { sv = -1.0; }
                let qx: f64 = px + ux * 6.0 * su + lx * 5.0 * sv;
                let qz: f64 = pz + uz * 6.0 * su + lz * 5.0 * sv;
                let h: f64 = worldgen_height(sd, qx, qz);
                if (c == 0) { lo = h; hi = h; }
                if (h < lo) { lo = h; }
                if (h > hi) { hi = h; }
                let dd: f64 = dist2d(qx, qz, cx, cz);
                if (dd < mind) { mind = dd; }
                c++;
            }
            if (hi - lo > SET_PLOT_RANGE_M + 0.000001) { range_bad++; }
            if (mind < SET_GREEN_R_M - 0.000001) { keepout_bad++; }
            let t: f64 = worldgen_temp(sd, px, pz);
            let m: f64 = worldgen_moist(sd, px, pz);
            if (worldgen_biome_tmd(t, m, __sqrt(px * px + pz * pz)) == WG_BIOME_FEN) { fen_bad++; }
        }
        vp++;
    }
    ck(range_bad == 0, "D12 §5.5 no valid plot exceeds the 2.4 m corner range",
       `${range_bad}`);
    ck(keepout_bad == 0, "D13 §5.2 no valid plot intersects the 16 m green keep-out",
       `${keepout_bad}`);
    ck(fen_bad == 0, "D14 §5.5 no valid plot sits in the Fen", `${fen_bad}`);

    // SKIPPED, NEVER MOVED — an invalid plot keeps its lattice position, and its
    // position is exactly where the lattice says it should be
    let moved: i32 = 0;
    let mp: i32 = 0;
    while (mp < 72) {
        if (settle_plot_valid(st, mp) == 0) {
            let slot: i32 = settle_pid_slot(mp);
            let road: i32 = settle_pid_road(mp);
            let arc: f64 = 22.0 + 14.0 * f64(slot);
            let seg: i32 = i32(__floor(arc / 8.0));
            if (seg > SET_ROAD_STEPS - 1) { seg = SET_ROAD_STEPS - 1; }
            let tt: f64 = arc / 8.0 - f64(seg);
            let ax: f64 = settle_road_pt_x(st, road, seg);
            let az: f64 = settle_road_pt_z(st, road, seg);
            let bx: f64 = settle_road_pt_x(st, road, seg + 1);
            let bz: f64 = settle_road_pt_z(st, road, seg + 1);
            let ox: f64 = ax + (bx - ax) * tt;
            let oz: f64 = az + (bz - az) * tt;
            if (__abs(dist2d(settle_plot_x(st, mp), settle_plot_z(st, mp), ox, oz) - 9.0) > 0.000001) {
                moved++;
            }
        }
        mp++;
    }
    ck(moved == 0,
       "D15 §5.5 INVALID PLOTS ARE SKIPPED, NEVER MOVED — a nudged building reads as a bug",
       `${moved} moved`);

    // §5.6 — the accretion order is a permutation of exactly the valid plots
    let nv: i32 = settle_valid_count(st);
    let ocount: i32 = 0;
    let dup: i32 = 0;
    let inval: i32 = 0;
    let mark: array<i32> = [];
    let mz: i32 = 0;
    while (mz < 72) { mark.push(0); mz++; }
    let oi: i32 = 0;
    while (oi < 72) {
        let pid2: i32 = settle_plot_order(st, oi);
        if (pid2 >= 0) {
            ocount++;
            if (mark[pid2] == 1) { dup++; }
            mark[pid2] = 1;
            if (settle_plot_valid(st, pid2) == 0) { inval++; }
        }
        oi++;
    }
    ck(ocount == nv && dup == 0 && inval == 0,
       "D16 §5.6 the order is a permutation of exactly the valid plots",
       `${ocount} vs ${nv}, dup ${dup}, invalid ${inval}`);

    // ... and it is ring-monotone outward from the green
    let ringbad: i32 = 0;
    let prevring: i32 = -1;
    let ri: i32 = 0;
    while (ri < ocount) {
        let pid3: i32 = settle_plot_order(st, ri);
        let d: f64 = dist2d(settle_plot_x(st, pid3), settle_plot_z(st, pid3), cx, cz);
        let ring: i32 = i32(__floor(d / 24.0));
        if (ring < prevring) { ringbad++; }
        prevring = ring;
        ri++;
    }
    ck(ringbad == 0,
       "D17 §5.6 the town grows OUTWARD IN RINGS: the centre is the oldest",
       `${ringbad} inversions`);
}

// ===========================================================================
// E.  ASSIGNMENT — permanence, and the service-first refinement
// ===========================================================================
fn section_assign() {
    print("E. Accretion and assignment (§5.6, §5.7)");
    let sd: i32 = 31677;
    let st = settle_new(sd);

    // the manifest tiers are 2 / 7 / 8 / 11
    let cnt: array<i32> = [0, 0, 0, 0];
    let i: i32 = 0;
    while (i < SET_BLD_MAX) { let t: i32 = settle_man_tier(i); cnt[t] = cnt[t] + 1; i++; }
    ck(cnt[0] == 2 && cnt[1] == 7 && cnt[2] == 8 && cnt[3] == 11,
       "E1 §3.3 the manifest adds 2 / 7 / 8 / 11 buildings",
       `${cnt[0]}/${cnt[1]}/${cnt[2]}/${cnt[3]}`);
    ck(cnt[0] + cnt[1] + cnt[2] + cnt[3] == SET_BLD_MAX,
       "E2 ... summing to 28", "-");

    // §3.3's headline buildings are where the manifest says they are
    ck(settle_assign_kind(st, 2) == SET_B_HALL,
       "E3 Mabel's Bench is a Hall and is the Village's first building", "-");
    ck(settle_assign_kind(st, 4) == SET_B_WELL, "E4 the Well is in the Village manifest", "-");
    ck(settle_assign_kind(st, 11) == SET_B_TOWER,
       "E5 the Watch Tower arrives at Town", "-");
    ck(settle_assign_kind(st, 17) == SET_B_WORKS,
       "E6 THE FOUNDRY is the City's first building", "-");
    ck(settle_assign_kind(st, 18) == SET_B_STACK, "E7 the Foundry stack follows it", "-");
    ck(settle_assign_kind(st, 19) == SET_B_HALL, "E8 the Arsenal is a Hall", "-");

    // no two buildings share a plot
    let mk: array<i32> = [];
    let z: i32 = 0;
    while (z < 72) { mk.push(0); z++; }
    let clash: i32 = 0;
    let placed: i32 = 0;
    let j: i32 = 0;
    while (j < SET_BLD_MAX) {
        let pid: i32 = settle_assign_pid(st, j);
        if (pid >= 0) {
            placed++;
            if (mk[pid] == 1) { clash++; }
            mk[pid] = 1;
            if (settle_plot_valid(st, pid) == 0) { clash++; }
        }
        j++;
    }
    ck(clash == 0, "E9 no two buildings share a plot, and none sits on an invalid one",
       `${clash}`);
    print(`   E10 ${placed} of 28 buildings found a plot on seed ${sd} (${settle_valid_count(st)} valid)`);
    ck(placed == settle_valid_count(st) || placed == SET_BLD_MAX,
       "E10 assignment consumes every valid plot it needs and no more",
       `${placed} placed, ${settle_valid_count(st)} valid`);

    // services land nearest the green
    let svc_i: array<i32> = [2, 3, 4, 9, 10, 11, 17, 19];
    let hs: i32 = 0;
    let k: i32 = 0;
    while (k < 8) {
        if (settle_assign_pid(st, svc_i[k]) >= 0) { hs++; }
        k++;
    }
    ck(hs >= 1, "E11 at least one service found a plot", `${hs}`);

    // >>> PERMANENCE.  The assignment is f(seed) and tier-independent, so a
    // >>> settlement grown all the way to City has EXACTLY the assignment a
    // >>> fresh Camp already had.  This is the property SETTLEMENT.md §5.6 and
    // >>> §9.1 both rest on and it is the reason two players lighting lanterns
    // >>> in different orders on different days produce the identical town.
    let st2 = settle_new(sd);
    let n2: i32 = light(st2, 6, 4.0, 256.0);
    let t2: i32 = advance(st2, DAY_TICKS * 12, 0);
    let drift: i32 = 0;
    let m: i32 = 0;
    while (m < SET_BLD_MAX) {
        if (settle_assign_pid(st2, m) != settle_assign_pid(st, m)) { drift++; }
        if (settle_assign_kind(st2, m) != settle_assign_kind(st, m)) { drift++; }
        m++;
    }
    ck(drift == 0,
       "E12 §5.6 A PLOT ONCE ASSIGNED KEEPS ITS BUILDING FOREVER — City == Camp",
       `${drift} drifted`);
    ck(settle_tier(st2) == SET_TIER_CITY,
       "E13 ... and the settlement really did reach City", `${settle_tier(st2)}`);
    ck(settle_building_count(st2) == SET_BLD_MAX,
       "E14 ... with all 28 buildings", `${settle_building_count(st2)}`);
    ck(n2 > 0, "E15 the test grid was actually installed", `${n2}`);
    ck(t2 > 0, "E16 ... and time actually passed", `${t2}`);

    // and the two settlements agree on layout while disagreeing on state
    ck(settle_plot_order(st, 0) == settle_plot_order(st2, 0),
       "E17 the accretion order is identical for the Camp and the City", "-");
}

// ===========================================================================
// F.  THE FIELD — LUX, the cap, Wick Lines, Palls, grid points
// ===========================================================================
fn section_field() {
    print("F. CIVIC LIGHT (§2)");
    let st = settle_new(31677);
    let cx: f64 = settle_cx(st);
    let cz: f64 = settle_cz(st);

    // one unlit lantern is darkness
    let a0: array<f64> = [cx, cz, 1.0, 0.0];
    settle_lanterns_set(st, a0, 1);
    ck(settle_lux_at(st, cx, cz) == 0, "F1 an unlit lantern contributes nothing",
       `${settle_lux_at(st, cx, cz)}`);
    ck(settle_great_tier(st) == 0, "F2 an unlit Great Lantern reports tier 0",
       `${settle_great_tier(st)}`);

    // ONE lit, unlinked, full-wick lantern at its own post is EXACTLY 256 LUX
    // == 1 grid point.  This is the definition of the unit and the whole reason
    // CIVIC LIGHT and MAGIC_KINETIC's grid points are the same number.
    let a1: array<f64> = [cx, cz, 1.0, 256.0];
    settle_lanterns_set(st, a1, 1);
    settle_refresh(st);
    ck(settle_lux_at(st, cx, cz) == 256,
       "F3 ONE lit unlinked full-wick lantern at its post == 256 LUX, the unit",
       `${settle_lux_at(st, cx, cz)}`);
    ck(settle_grid_points(st) == 1,
       "F4 ... == exactly 1 grid point (MAGIC_KINETIC §6.1a)",
       `${settle_grid_points(st)}`);
    ck(settle_grid_lux(st) == settle_grid_points(st) * SET_LUX_PER_POINT,
       "F5 grid_points == GRID_LUX / 256, integer division", "-");

    // falloff is linear to the tier radius and zero beyond it
    let r1: f64 = settle_lantern_radius(1);
    ck(settle_lux_at(st, cx + r1 * 0.5, cz) == 128,
       "F6 linear falloff: half radius is half the contribution",
       `${settle_lux_at(st, cx + r1 * 0.5, cz)}`);
    ck(settle_lux_at(st, cx + r1 + 1.0, cz) == 0,
       "F7 nothing past the tier radius", `${settle_lux_at(st, cx + r1 + 1.0, cz)}`);
    ck(settle_lantern_radius(4) > settle_lantern_radius(1),
       "F8 a T4 lantern reaches further than a T1", "-");

    // A WICK LINE DOUBLES IT — two lit lanterns within 90 m
    let a2: array<f64> = [cx, cz, 1.0, 256.0, cx + 80.0, cz, 1.0, 256.0];
    settle_lanterns_set(st, a2, 2);
    settle_refresh(st);
    ck(settle_lux_at(st, cx, cz) >= 512,
       "F9 a lantern on a Wick Line is worth double", `${settle_lux_at(st, cx, cz)}`);
    let a3: array<f64> = [cx, cz, 1.0, 256.0, cx + 95.0, cz, 1.0, 256.0];
    settle_lanterns_set(st, a3, 2);
    settle_refresh(st);
    ck(settle_lux_at(st, cx, cz) == 256,
       "F10 ... and 95 m is past the 90 m link: no line, no doubling",
       `${settle_lux_at(st, cx, cz)}`);

    // THE CAP IS LOAD-BEARING (§11.4)
    let big: array<f64> = [];
    let nb: i32 = 0;
    let i: i32 = 0;
    while (i < 40) {
        big.push(cx + f64(i % 8) * 2.0);
        big.push(cz + f64(i / 8) * 2.0);
        big.push(4.0); big.push(256.0);
        nb++; i++;
    }
    settle_lanterns_set(st, big, nb);
    settle_refresh(st);
    ck(settle_lux_at(st, cx, cz) == SET_CL_MAX,
       "F11 §11.4 the field saturates at CL_MAX and no further",
       `${settle_lux_at(st, cx, cz)}`);
    ck(settle_core_lux(st) <= SET_CL_MAX, "F12 CORE_LUX obeys the same cap", "-");

    // GRID_LUX is a PLAIN SUM over the ring, not distance-weighted
    let far: array<f64> = [cx, cz, 1.0, 256.0,
                           cx + 30.0, cz, 1.0, 256.0];
    settle_lanterns_set(st, far, 2);
    settle_refresh(st);
    let g_near: i32 = settle_grid_lux(st);
    let far2: array<f64> = [cx, cz, 1.0, 256.0,
                            cx + 55.0, cz, 1.0, 256.0];
    settle_lanterns_set(st, far2, 2);
    settle_refresh(st);
    ck(settle_grid_lux(st) == g_near,
       "F13 §2.2 GRID_LUX is a plain sum: extent does not care where in the ring a post is",
       `${settle_grid_lux(st)} vs ${g_near}`);

    // a post OUTSIDE the ring contributes nothing to extent
    let outside: array<f64> = [cx, cz, 1.0, 256.0,
                               cx + 500.0, cz, 4.0, 256.0];
    settle_lanterns_set(st, outside, 2);
    settle_refresh(st);
    ck(settle_grid_lux(st) == 256,
       "F14 a post outside the tier's ring adds no extent", `${settle_grid_lux(st)}`);

    // A PALL IS A POWER OUTAGE (MAGIC_KINETIC §6.1a): -4 grid points
    let lanp: array<f64> = [cx, cz, 1.0, 256.0, cx + 40.0, cz, 1.0, 256.0,
                            cx - 40.0, cz, 1.0, 256.0, cx, cz + 40.0, 1.0, 256.0,
                            cx, cz - 40.0, 1.0, 256.0];
    settle_lanterns_set(st, lanp, 5);
    settle_refresh(st);
    let before: i32 = settle_grid_points(st);
    let pall: array<f64> = [cx + 10.0, cz, 30.0, 1024.0];
    settle_palls_set(st, pall, 1);
    settle_refresh(st);
    let after: i32 = settle_grid_points(st);
    ck(before - after == 4,
       "F15 MAGIC_KINETIC §6.1a: a standing Pall costs exactly 4 grid points",
       `${before} -> ${after}`);
    ck(settle_lux_at(st, cx + 10.0, cz) < settle_lux_at(st, cx + 10.0, cz) + 1,
       "F16 the Pall also darkens the field where it stands", "-");
    let shrunk: array<f64> = [cx + 10.0, cz, 30.0, 512.0];
    settle_palls_set(st, shrunk, 1);
    settle_refresh(st);
    ck(settle_grid_points(st) - after == 2,
       "F17 ... 2 points once shrunk below half radius",
       `${settle_grid_points(st)} vs ${after}`);
    let gone: array<f64> = [cx + 10.0, cz, 30.0, 0.0];
    settle_palls_set(st, gone, 1);
    settle_refresh(st);
    ck(settle_grid_points(st) == before,
       "F18 ... and nothing once extinguished: shrinking a Pall reconnects the grid",
       `${settle_grid_points(st)} vs ${before}`);
}

// ===========================================================================
// G.  ENTROPY — the owner's gradient
// ===========================================================================
fn section_entropy() {
    print("G. Entropy (§2.3) — cheaper near the core, expensive at the frontier");

    // the ladder, pinned with the doc's own four rows
    ck(settle_decay_of_lux(0) == 16, "G1 alone in the dark: 16 of 256 per real hour",
       `${settle_decay_of_lux(0)}`);
    ck(settle_decay_of_lux(256) == 15, "G2 frontier ~256 LUX: 15/hr",
       `${settle_decay_of_lux(256)}`);
    ck(settle_decay_of_lux(1024) == 9, "G3 maintained ring ~1024 LUX: 9/hr",
       `${settle_decay_of_lux(1024)}`);
    ck(settle_decay_of_lux(2048) == 2, "G4 saturated core >= 2048 LUX: 2/hr",
       `${settle_decay_of_lux(2048)}`);
    ck(settle_decay_of_lux(4096) == 2, "G5 ... and no lower: the gradient saturates",
       `${settle_decay_of_lux(4096)}`);

    // monotone: more light is never more decay
    let bad: i32 = 0;
    let prev: i32 = 99;
    let l: i32 = 0;
    while (l <= 4096) {
        let d: i32 = settle_decay_of_lux(l);
        if (d > prev) { bad++; }
        prev = d;
        l = l + 8;
    }
    ck(bad == 0, "G6 decay is monotone non-increasing in LUX — the owner's gradient",
       `${bad} inversions`);

    // full -> dark times, in real hours, the doc's own table
    let hrs_core: f64 = 256.0 / f64(settle_decay_of_lux(2048));
    let hrs_ring: f64 = 256.0 / f64(settle_decay_of_lux(1024));
    let hrs_frontier: f64 = 256.0 / f64(settle_decay_of_lux(256));
    print(`   G7  full->dark: core ${hrs_core / 24.0} real days, ring ${hrs_ring} h, frontier ${hrs_frontier} h`);
    ck(hrs_core / 24.0 > 5.0 && hrs_core / 24.0 < 6.0,
       "G7 the saturated core lasts 5..6 real days", `${hrs_core / 24.0}`);
    ck(hrs_ring > 24.0 && hrs_ring < 32.0,
       "G8 the maintained ring lasts 28-ish real hours", `${hrs_ring}`);
    ck(hrs_frontier > 15.0 && hrs_frontier < 19.0,
       "G9 the frontier lasts 17-ish real hours", `${hrs_frontier}`);
    ck(hrs_core > hrs_ring && hrs_ring > hrs_frontier,
       "G10 maintenance is cheap near the core and expensive at the frontier", "-");

    // THE GREEN NEVER GOES OUT
    let st = settle_new(31677);
    let cx: f64 = settle_cx(st);
    let cz: f64 = settle_cz(st);
    let dark: array<f64> = [cx, cz, 1.0, 0.0];
    settle_lanterns_set(st, dark, 1);
    settle_refresh(st);
    ck(settle_wick_decay(st, cx, cz) == 0,
       "G11 §2.3 wick_decay is 0 inside the green, even with every lamp out",
       `${settle_wick_decay(st, cx, cz)}`);
    ck(settle_wick_decay(st, cx + SET_GREEN_R_M - 0.5, cz) == 0,
       "G12 ... all the way to the 16 m boundary", "-");
    ck(settle_wick_decay(st, cx + SET_GREEN_R_M + 1.0, cz) == SET_DECAY_MAX,
       "G13 ... and full decay one metre past it",
       `${settle_wick_decay(st, cx + SET_GREEN_R_M + 1.0, cz)}`);

    // durability: neglect is what makes a post vulnerable
    ck(settle_wick_safe(SET_WICK_SAFE) == 1 && settle_wick_safe(SET_WICK_SAFE - 1) == 0,
       "G14 §2.3 a post at wick >= 128 cannot be snuffed; below it, the dark finishes it",
       "-");

    // the gradient in space: light the core and the frontier stays expensive
    let n: i32 = light(st, 1, 4.0, 256.0);
    ck(n > 1, "G15 the test grid was installed", `${n}`);
    let d_core: i32 = settle_wick_decay(st, cx + 20.0, cz);
    let d_edge: i32 = settle_wick_decay(st, cx + 300.0, cz);
    ck(d_core < d_edge,
       "G16 SPATIAL gradient: maintenance near home costs less than at the frontier",
       `${d_core} vs ${d_edge}`);
}

// ===========================================================================
// H.  THE LADDER — promotion, the hold, the high-water mark, brownout
// ===========================================================================
fn section_ladder() {
    print("H. The tier ladder (§3)");
    let st = settle_new(31677);

    ck(settle_tier(st) == SET_TIER_CAMP && settle_tier_ever(st) == SET_TIER_CAMP,
       "H1 a fresh seed is a CAMP — a LAPSED field, not an empty one", "-");
    ck(settle_building_count(st) == 2,
       "H2 §3.3 a Camp is two roofless shells", `${settle_building_count(st)}`);
    ck(settle_building_state(st, 0) == SET_CON_FRAMED
       && settle_building_state(st, 1) == SET_CON_FRAMED,
       "H3 ... with footings: FRAMED, and they read as ruin at 40 m", "-");
    ck(settle_core_lux(st) == 0,
       "H4 D6: the 512 floor does NOT apply at Camp — the Great Lantern is out",
       `${settle_core_lux(st)}`);

    // all three conditions are NECESSARY, individually
    let cx: f64 = settle_cx(st);
    let cz: f64 = settle_cz(st);
    // enough points and core, but a tier-0 Great Lantern
    let lo_gl: array<f64> = [];
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < 24) {
        let ang: f64 = 6.283185307179586 * f64(i) / 24.0;
        lo_gl.push(cx + __sin(ang) * 50.0);
        lo_gl.push(cz - __cos(ang) * 50.0);
        lo_gl.push(1.0); lo_gl.push(256.0);
        n++; i++;
    }
    // overwrite index 0 to be the Great Lantern, unlit
    lo_gl[0] = cx; lo_gl[1] = cz; lo_gl[2] = 0.0; lo_gl[3] = 0.0;
    settle_lanterns_set(st, lo_gl, n);
    settle_refresh(st);
    ck(settle_grid_points(st) >= SET_PTS_VILLAGE,
       "H5 the test grid clears the Village point threshold",
       `${settle_grid_points(st)}`);
    ck(settle_promote_check(st) == SET_TIER_CAMP,
       "H6 §3.1 an UNLIT Great Lantern blocks promotion however bright the ring is",
       `${settle_promote_check(st)}`);

    // now light it
    lo_gl[2] = 1.0; lo_gl[3] = 256.0;
    settle_lanterns_set(st, lo_gl, n);
    settle_refresh(st);
    ck(settle_promote_check(st) >= SET_TIER_VILLAGE,
       "H7 ... and lighting it unblocks exactly that",
       `${settle_promote_check(st)}`);

    // THE HOLD: one continuous in-game day
    let t: i32 = 0;
    t = advance(st, DAY_TICKS - 120, t);
    ck(settle_tier(st) == SET_TIER_CAMP,
       "H8 §3.2 promotion does not fire before a full in-game day of hold",
       `${settle_tier(st)}`);
    t = advance(st, 600, t);
    ck(settle_tier(st) == SET_TIER_VILLAGE,
       "H9 ... and fires when the day completes", `${settle_tier(st)}`);
    ck(settle_building_count(st) == 9,
       "H10 §3.3 a Village is 9 buildings", `${settle_building_count(st)}`);

    // the hold RESETS on a transient dip — it exists to stop a promotion firing
    // off a spike during a night hold
    let stH = settle_new(31677);
    let nH: i32 = light(stH, 1, 4.0, 256.0);
    let tH: i32 = advance(stH, DAY_TICKS - 600, 0);
    let dark: array<f64> = [settle_cx(stH), settle_cz(stH), 0.0, 0.0];
    settle_lanterns_set(stH, dark, 1);
    settle_refresh(stH);
    tH = advance(stH, 300, tH);
    light(stH, 1, 4.0, 256.0);
    tH = advance(stH, 900, tH);
    ck(settle_tier(stH) == SET_TIER_CAMP,
       "H11 §3.2 the hold RESETS on a dip: no promotion off a transient spike",
       `${settle_tier(stH)}`);
    ck(nH > 0, "H12 the dip test installed a grid", `${nH}`);

    // THE HIGH-WATER MARK: nothing is ever deleted
    let before_n: i32 = settle_building_count(st);
    let before_t: i32 = settle_tier_ever(st);
    let out: array<f64> = [settle_cx(st), settle_cz(st), 0.0, 0.0];
    settle_lanterns_set(st, out, 1);
    settle_refresh(st);
    t = advance(st, DAY_TICKS * 3, t);
    ck(settle_tier_ever(st) == before_t,
       "H13 §3.2 settle_tier_ever is a HIGH-WATER MARK and never drops",
       `${settle_tier_ever(st)} vs ${before_t}`);
    ck(settle_building_count(st) == before_n,
       "H14 §3.2 DEMOTION NEVER DELETES ANYTHING — no pop, no 'my town was deleted'",
       `${settle_building_count(st)} vs ${before_n}`);
    ck(settle_brownout(st) == 1,
       "H15 ... it browns out instead", `${settle_brownout(st)}`);
    ck(settle_core_lux(st) == SET_CORE_FLOOR,
       "H16 §3.2 THE GREEN NEVER BROWNS OUT: CORE_LUX floors at 512 from Village up",
       `${settle_core_lux(st)}`);

    // recovery is instant on crossing back over
    light(st, 2, 4.0, 256.0);
    t = advance(st, 60, t);
    ck(settle_brownout(st) == 0,
       "H17 §3.2 recovering from brownout is instant — one settle tick",
       `${settle_brownout(st)}`);

    // the 80 % rule, exactly
    let stB = settle_new(31677);
    light(stB, 6, 4.0, 256.0);
    advance(stB, DAY_TICKS * 12, 0);
    ck(settle_tier_ever(stB) == SET_TIER_CITY, "H18 the ladder reaches CITY",
       `${settle_tier_ever(stB)}`);
    ck(settle_brownout_check(stB) == 0, "H19 a fully lit City is not browned out", "-");
    print(`   H20 City at ${settle_grid_points(stB)} points; brownout below ${SET_PTS_CITY * 8 / 10}`);
    ck(settle_grid_points(stB) >= SET_PTS_CITY,
       "H20 ... and it is above the City threshold", `${settle_grid_points(stB)}`);

    // work sites = tier + 1
    ck(settle_worksite_count(stB) == SET_TIER_CITY + 1,
       "H21 §6.2 work sites = tier + 1: growth accelerates as the town grows",
       `${settle_worksite_count(stB)}`);
}

// ===========================================================================
// I.  THE FOUNDRY — four gates, five outputs, three failure stages
// ===========================================================================
fn section_foundry() {
    print("I. The Foundry (§4)");
    let st = settle_new(31677);
    light(st, 6, 4.0, 256.0);
    advance(st, DAY_TICKS * 12, 0);

    ck(settle_tier_ever(st) == SET_TIER_CITY, "I1 the settlement is a CITY",
       `${settle_tier_ever(st)}`);
    ck(settle_foundry_gate(st) == 15,
       "I2 all four gates F1..F4 pass on a fully lit City", `${settle_foundry_gate(st)}`);
    ck(settle_industry(st) == SET_IND_RUNNING,
       "I3 ... and the Foundry runs", `${settle_industry(st)}`);
    ck(settle_foundry_post(st) >= 1,
       "I4 the Foundry has its own post, and it is not the Great Lantern",
       `${settle_foundry_post(st)}`);
    ck(settle_feeder_lit(st) >= SET_FEEDER_MIN,
       "I5 F4: >= 6 lit lanterns on the chain", `${settle_feeder_lit(st)}`);
    ck(settle_feeder_len(st) >= 2,
       "I6 ... and the chain is a real route with a first and last node",
       `${settle_feeder_len(st)}`);
    ck(settle_feeder_node(st, 0) == 0,
       "I7 §4.1 the chain STARTS at the Great Lantern", `${settle_feeder_node(st, 0)}`);
    ck(settle_feeder_node(st, settle_feeder_len(st) - 1) == settle_foundry_post(st),
       "I8 ... and ENDS at the Foundry's post — a route the player walks", "-");
    // every hop on the chain is a real Wick Line
    let hopbad: i32 = 0;
    let h: i32 = 0;
    while (h < settle_feeder_len(st) - 1) {
        let u: i32 = settle_feeder_node(st, h);
        let v: i32 = settle_feeder_node(st, h + 1);
        if (u < 0 || v < 0) { hopbad++; }
        h++;
    }
    ck(hopbad == 0, "I9 every hop on the chain is a valid node", `${hopbad}`);
    ck(settle_feeder_node(st, -1) == -1 && settle_feeder_node(st, 9999) == -1,
       "I10 out-of-range chain queries return -1, never a guess", "-");

    // the output ladder
    print(`   I11 ${settle_grid_points(st)} points -> O${settle_output_tier(st)}, ${settle_ammo_rate(st)} rounds/in-game day`);
    ck(settle_output_tier(st) >= 1 && settle_output_tier(st) <= 5,
       "I11 output is O1..O5 while running", `${settle_output_tier(st)}`);
    let rate: i32 = settle_ammo_rate(st);
    ck(rate == 60 || rate == 120 || rate == 200 || rate == 300 || rate == 420,
       "I12 §4.2 the ammo ladder is 60/120/200/300/420", `${rate}`);

    // F2 IS NECESSARY — darken the core only
    let cx: f64 = settle_cx(st);
    let cz: f64 = settle_cz(st);
    let ring_only: array<f64> = [];
    let n: i32 = 0;
    ring_only.push(cx); ring_only.push(cz); ring_only.push(4.0); ring_only.push(0.0);
    n++;
    let i: i32 = 0;
    while (i < 40) {
        let ang: f64 = 6.283185307179586 * f64(i) / 40.0;
        ring_only.push(cx + __sin(ang) * 300.0);
        ring_only.push(cz - __cos(ang) * 300.0);
        ring_only.push(4.0); ring_only.push(256.0);
        n++; i++;
    }
    settle_lanterns_set(st, ring_only, n);
    settle_refresh(st);
    ck((settle_foundry_gate(st) & 4) == 0,
       "I13 F3 fails when the Great Lantern is out, however bright the ring",
       `${settle_foundry_gate(st)}`);
    ck(settle_ammo_rate(st) == 0 || settle_industry(st) != SET_IND_RUNNING,
       "I14 ... and the Foundry stops producing", `${settle_ammo_rate(st)}`);

    // THE PLAYER IS NEVER DISARMED — the village bench is not on this gate
    ck(settle_tier_ever(st) == SET_TIER_CITY,
       "I15 §4.3 losing the city does not lose the city's BUILDINGS", "-");
    ck(settle_building_count(st) == SET_BLD_MAX,
       "I16 ... Mabel's Bench is still standing, so the player is never disarmed",
       `${settle_building_count(st)}`);
    ck(settle_assign_kind(st, 2) == SET_B_HALL,
       "I17 ... and it is still Mabel's Bench, on the same plot", "-");

    // THE THREE STAGES: FLICKER -> BROWNOUT -> COLD
    let stS = settle_new(31677);
    light(stS, 6, 4.0, 256.0);
    let t: i32 = advance(stS, DAY_TICKS * 12, 0);
    ck(settle_industry(stS) == SET_IND_RUNNING, "I18 running before the fault", "-");
    // break F3 only: points stay high, so COLD's points rule cannot fire
    let cx2: f64 = settle_cx(stS);
    let cz2: f64 = settle_cz(stS);
    let broken: array<f64> = [];
    let n2: i32 = 0;
    broken.push(cx2); broken.push(cz2); broken.push(1.0); broken.push(256.0);   // T1, not T4
    n2++;
    let j: i32 = 1;
    while (j <= 6) {
        let cnt: i32 = j * 6;
        let k: i32 = 0;
        while (k < cnt) {
            let ang: f64 = 6.283185307179586 * f64(k) / f64(cnt);
            let rad: f64 = f64(j) * 55.0;
            broken.push(cx2 + __sin(ang) * rad);
            broken.push(cz2 - __cos(ang) * rad);
            broken.push(4.0); broken.push(256.0);
            n2++; k++;
        }
        j++;
    }
    settle_lanterns_set(stS, broken, n2);
    settle_refresh(stS);
    t = advance(stS, 600, t);
    ck(settle_grid_points(stS) >= SET_COLD_POINTS,
       "I19 the fault keeps grid points above the COLD line",
       `${settle_grid_points(stS)}`);
    ck(settle_industry(stS) == SET_IND_FLICKER,
       "I20 §4.3 stage 1 FLICKER: production halves within the first in-game day",
       `${settle_industry(stS)}`);
    let flick: i32 = settle_ammo_rate(stS);
    t = advance(stS, DAY_TICKS + 600, t);
    ck(settle_industry(stS) == SET_IND_BROWNOUT,
       "I21 §4.3 stage 2 BROWNOUT after a full in-game day",
       `${settle_industry(stS)}`);
    ck(settle_ammo_rate(stS) == 0 && flick > 0,
       "I22 ... FLICKER halves, BROWNOUT stops", `${flick} -> ${settle_ammo_rate(stS)}`);
    // stage 3: drop grid points below 58
    let cold: array<f64> = [cx2, cz2, 1.0, 256.0];
    settle_lanterns_set(stS, cold, 1);
    settle_refresh(stS);
    t = advance(stS, 600, t);
    ck(settle_industry(stS) == SET_IND_COLD,
       "I23 §4.3 stage 3 COLD below 58 grid points", `${settle_industry(stS)}`);
    ck(settle_ammo_rate(stS) == 0, "I24 a cold Foundry makes nothing", "-");

    // COLD is absorbing: relight is refused until the gates are met AND paid for
    ck(settle_relight(stS, SET_RELIGHT_EMBER) == 0,
       "I25 §4.3 a relight is refused while the feeder line is dark", "-");
    light(stS, 6, 4.0, 256.0);
    settle_feeder_eval(stS);
    ck(settle_relight(stS, SET_RELIGHT_EMBER - 1) == 0,
       "I26 ... and refused at 199 Ember", "-");
    ck(settle_relight(stS, SET_RELIGHT_EMBER) == SET_RELIGHT_EMBER,
       "I27 ... and costs exactly 200 Ember when it is earned", "-");
    ck(settle_ammo_rate(stS) == 0,
       "I28 §4.3 ... followed by one in-game day of warm-up before a round is made",
       `${settle_ammo_rate(stS)}`);
    t = advance(stS, DAY_TICKS + 600, t);
    ck(settle_ammo_rate(stS) > 0, "I29 ... and then it produces again",
       `${settle_ammo_rate(stS)}`);
}

// ===========================================================================
// J.  GROWTH IS APPEND-ONLY  (SETTLEMENT.md A9)
// ===========================================================================
fn section_appendonly() {
    print("J. Growth is append-only (A9: 10 000 ticks, grid driven up and down)");
    let st = settle_new(31677);
    let cx: f64 = settle_cx(st);
    let cz: f64 = settle_cz(st);

    let last_pid: array<i32> = [];
    let last_kind: array<i32> = [];
    let last_con: array<i32> = [];
    let i: i32 = 0;
    while (i < SET_BLD_MAX) { last_pid.push(-2); last_kind.push(-2); last_con.push(-2); i++; }

    let plot_moved: i32 = 0;
    let kind_changed: i32 = 0;
    let regressed: i32 = 0;
    let count_dropped: i32 = 0;
    let last_n: i32 = 0;
    let last_ever: i32 = 0;
    let ever_dropped: i32 = 0;
    let promotions: i32 = 0;

    let t: i32 = 0;
    let step: i32 = 0;
    while (step < 12000) {
        // a deterministic, wildly varying grid: 0..6 rings, tier 1..4, wick 0..256
        // Each phase is held for 1100 settle ticks = 66 000 sim ticks, which is
        // longer than the 57 600-tick promotion hold — otherwise the grid never
        // stands still long enough for the ladder to be exercised at all, and
        // the test would prove only that nothing happens.  Even phases are a
        // strong grid, odd phases are hashed chaos: the field is driven hard in
        // BOTH directions, which is what A9 asks for.
        if (step % 1100 == 0) {
            // A13: i32 `*` TRAPS on overflow.  All mixing in u64.
            let hu: u64 = (u64(step) * 1103515245 + 12345) & 4294967295;
            let h: i32 = i32(hu % 2147483647);
            let phase: i32 = step / 1100;
            let rings: i32 = h % 7;
            let tier: f64 = f64(1 + (h / 7) % 4);
            let wick: f64 = f64((h / 31) % 257);
            if (phase % 2 == 0) { rings = 6; tier = 4.0; wick = 256.0; }
            let a: array<f64> = [];
            let n: i32 = 0;
            a.push(cx); a.push(cz); a.push(tier); a.push(wick);
            n++;
            let r: i32 = 1;
            while (r <= rings) {
                let cnt: i32 = r * 6;
                let k: i32 = 0;
                while (k < cnt) {
                    let ang: f64 = 6.283185307179586 * f64(k) / f64(cnt);
                    let rad: f64 = f64(r) * 55.0;
                    a.push(cx + __sin(ang) * rad);
                    a.push(cz - __cos(ang) * rad);
                    a.push(tier); a.push(wick);
                    n++; k++;
                }
                r++;
            }
            settle_lanterns_set(st, a, n);
        }
        let ev: i32 = settle_step(st, t);
        if ((ev & SET_EV_PROMOTED) != 0) { promotions++; }

        let n2: i32 = settle_building_count(st);
        if (n2 < last_n) { count_dropped++; }
        last_n = n2;
        if (settle_tier_ever(st) < last_ever) { ever_dropped++; }
        last_ever = settle_tier_ever(st);

        let b: i32 = 0;
        while (b < n2) {
            let pid: i32 = settle_building_pid(st, b);
            let kd: i32 = settle_building_kind(st, b);
            let cn: i32 = settle_building_state(st, b);
            if (last_pid[b] != -2) {
                if (last_pid[b] != pid) { plot_moved++; }
                if (last_kind[b] != kd) { kind_changed++; }
                if (cn < last_con[b]) { regressed++; }
            }
            last_pid[b] = pid;
            last_kind[b] = kd;
            last_con[b] = cn;
            b++;
        }
        t = t + 60;
        step++;
    }

    print(`   J*  ${step} settle ticks (${t} sim ticks), ${promotions} promotions, ${last_n} buildings, tier ${settle_tier_ever(st)}`);
    ck(plot_moved == 0,
       "J1 A9: NO BUILDING EVER CHANGED PLOT over 12 000 driven ticks", `${plot_moved}`);
    ck(kind_changed == 0, "J2 A9: no building ever changed kind", `${kind_changed}`);
    ck(regressed == 0,
       "J3 A9: NO BUILDING EVER REGRESSED — DONE is DONE forever", `${regressed}`);
    ck(count_dropped == 0, "J4 A9: the building count never fell", `${count_dropped}`);
    ck(ever_dropped == 0, "J5 A9: tier_ever never fell", `${ever_dropped}`);
    ck(promotions >= 1, "J6 ... and the ladder was actually exercised", `${promotions}`);
    ck(settle_building_advance(st, -1) == -1 && settle_building_advance(st, 9999) == -1,
       "J7 an out-of-range advance is refused", "-");
}

// ===========================================================================
// K.  THE DELTA LOG  (SETTLEMENT.md A8)
// ===========================================================================
fn section_save() {
    print("K. The delta log (§8.5) — a whole City in a few hundred bytes");
    let st = settle_new(31677);
    light(st, 6, 4.0, 256.0);
    advance(st, DAY_TICKS * 12, 0);
    ck(settle_building_count(st) == SET_BLD_MAX, "K1 a complete City", `${settle_building_count(st)}`);

    let nrows: i32 = settle_save_rows(st);
    let rows: array<i32> = [];
    let i: i32 = 0;
    while (i < nrows * SET_SAVE_COLS) { rows.push(0); i++; }
    let meta: array<i32> = [0, 0, 0, 0, 0, 0, 0, 0];
    ck(settle_save_fill(st, rows) == nrows, "K2 save_fill writes every row", "-");
    ck(settle_meta_fill(st, meta) == SET_META_COLS, "K3 meta_fill writes 8 columns", "-");

    let bytes: i32 = nrows * SET_SAVE_COLS * 4 + SET_META_COLS * 4;
    print(`   K4  ${nrows} rows x ${SET_SAVE_COLS} i32 + ${SET_META_COLS} meta = ${bytes} bytes`);
    ck(bytes <= 600, "K4 §8.5 a complete City saves in a few hundred bytes", `${bytes}`);

    // rows are sorted by pid — the canonicalisation that makes bytes comparable
    let unsorted: i32 = 0;
    let r: i32 = 1;
    while (r < nrows) {
        if (rows[r * SET_SAVE_COLS] < rows[(r - 1) * SET_SAVE_COLS]) { unsorted++; }
        r++;
    }
    ck(unsorted == 0,
       "K5 §8.5 rows are emitted SORTED BY pid, so equal state produces equal bytes",
       `${unsorted}`);

    // ROUND TRIP: a fresh store of the same seed, loaded, must hash identically
    let st2 = settle_new(31677);
    light(st2, 6, 4.0, 256.0);
    let applied: i32 = settle_load(st2, rows, nrows, meta);
    ck(applied == nrows, "K6 every row found its building on reload", `${applied}/${nrows}`);
    ck(settle_hash(st2) == settle_hash(st),
       "K7 A8: a City survives encode -> decode with an IDENTICAL settle_hash",
       `${settle_hash(st2)} vs ${settle_hash(st)}`);

    // and re-encoding is BYTE-IDENTICAL
    let rows2: array<i32> = [];
    let j: i32 = 0;
    while (j < nrows * SET_SAVE_COLS) { rows2.push(0); j++; }
    let meta2: array<i32> = [0, 0, 0, 0, 0, 0, 0, 0];
    settle_save_fill(st2, rows2);
    settle_meta_fill(st2, meta2);
    let diff: i32 = 0;
    let k: i32 = 0;
    while (k < nrows * SET_SAVE_COLS) { if (rows2[k] != rows[k]) { diff++; } k++; }
    let m: i32 = 0;
    while (m < SET_META_COLS) { if (meta2[m] != meta[m]) { diff++; } m++; }
    ck(diff == 0, "K8 A8: the re-encode is BYTE-IDENTICAL", `${diff} bytes differ`);

    // the layout is NOT in the save — it is regenerated
    ck(settle_plot_order(st2, 0) == settle_plot_order(st, 0)
       && settle_assign_pid(st2, 5) == settle_assign_pid(st, 5)
       && approx(settle_cx(st2), settle_cx(st), 0.0),
       "K9 §8.5 the layout is REGENERATED from the seed, never persisted", "-");

    // a truncated or oversized buffer is refused, never half-written
    let tiny: array<i32> = [0, 0];
    ck(settle_save_fill(st, tiny) == -1 && settle_meta_fill(st, tiny) == -1,
       "K10 a buffer that is too small is refused, never partially written", "-");
    ck(settle_load(st2, rows, SET_BLD_MAX + 1, meta) == -1,
       "K11 a row count past the manifest is refused", "-");

    // a save from a DIFFERENT seed is dropped rather than trusted
    let st3 = settle_new(7);
    let applied3: i32 = settle_load(st3, rows, nrows, meta);
    ck(applied3 <= nrows,
       "K12 §8.5 rows whose pid is not in this seed's assignment are DROPPED, not trusted",
       `${applied3}`);
}

// ===========================================================================
// L.  DETERMINISM  (SETTLEMENT.md A7)
// ===========================================================================
fn section_determinism() {
    print("L. Determinism (A7)");

    let seeds: array<i32> = [1, 7, 31677, 999983, -7, 2146483647, 0, 12345];
    let hashes: array<i32> = [];
    let sig: array<u64> = [];
    let s: i32 = 0;
    while (s < 8) {
        let sd: i32 = seeds[s];
        let a = settle_new(sd);
        let b = settle_new(sd);
        let same: i32 = 1;
        if (settle_hash(a) != settle_hash(b)) { same = 0; }
        if (settle_cx(a) != settle_cx(b)) { same = 0; }
        if (settle_cz(a) != settle_cz(b)) { same = 0; }
        if (settle_deck_y(a) != settle_deck_y(b)) { same = 0; }
        if (settle_bearing(a) != settle_bearing(b)) { same = 0; }
        let p: i32 = 0;
        while (p < SET_PLOTS) {
            if (settle_plot_order(a, p) != settle_plot_order(b, p)) { same = 0; }
            if (settle_plot_x(a, p) != settle_plot_x(b, p)) { same = 0; }
            if (settle_plot_valid(a, p) != settle_plot_valid(b, p)) { same = 0; }
            p++;
        }
        let q: i32 = 0;
        while (q < SET_BLD_MAX) {
            if (settle_assign_pid(a, q) != settle_assign_pid(b, q)) { same = 0; }
            if (settle_assign_kind(a, q) != settle_assign_kind(b, q)) { same = 0; }
            q++;
        }
        ck(same == 1, `L${s + 1} seed ${sd}: two independent builds are bit-identical`, "-");
        hashes.push(settle_hash(a));
        // a signature over the whole layout, printed so the two backends can be
        // diffed by eye as well as by assertion
        let acc: u64 = 1469598103934665603;
        let z: i32 = 0;
        while (z < SET_PLOTS) {
            acc = (acc ^ u64(settle_plot_order(a, z) + 1)) * 1099511628211;
            z++;
        }
        sig.push(acc & 4294967295);
        s++;
    }

    // different seeds differ
    let coll: i32 = 0;
    let i: i32 = 0;
    while (i < 8) {
        let j: i32 = i + 1;
        while (j < 8) { if (hashes[i] == hashes[j]) { coll++; } j++; }
        i++;
    }
    ck(coll == 0, "L9 eight different seeds give eight different settlements",
       `${coll} collisions`);

    let line: string = "";
    let k: i32 = 0;
    while (k < 8) { line = line + `${sig[k]} `; k++; }
    print(`   L10 layout signatures (compare compiled vs interpreted): ${line}`);
    ck(sig[0] != sig[1], "L10 ... and their layouts differ, not just their hashes", "-");

    // the two i32 extremes do not throw (worldgen's `^ not +` rule)
    let ext = settle_new(2147483647);
    ck(settle_valid_count(ext) >= 0, "L11 seed 2^31-1 does not overflow", "-");
    let ext2 = settle_new(-2147483648);
    ck(settle_valid_count(ext2) >= 0, "L12 seed -2^31 does not overflow", "-");

    // stepping the same store the same way twice gives the same answer
    let r1 = settle_new(31677);
    light(r1, 3, 3.0, 200.0);
    advance(r1, DAY_TICKS * 4, 0);
    let r2 = settle_new(31677);
    light(r2, 3, 3.0, 200.0);
    advance(r2, DAY_TICKS * 4, 0);
    ck(settle_hash(r1) == settle_hash(r2),
       "L13 two identical simulations produce an identical settle_hash",
       `${settle_hash(r1)} vs ${settle_hash(r2)}`);
    ck(settle_grid_lux(r1) == settle_grid_lux(r2) && settle_core_lux(r1) == settle_core_lux(r2),
       "L14 ... including the sliced field, whose lag is deterministic", "-");
}

// ===========================================================================
// M.  COLLISION AND THE SOLIDS FILL
// ===========================================================================
fn section_solids() {
    print("M. Collision (§8.3)");
    let st = settle_new(31677);
    light(st, 6, 4.0, 256.0);
    advance(st, DAY_TICKS * 12, 0);

    let out: array<f64> = [];
    let i: i32 = 0;
    while (i < 8 * 6) { out.push(0.0); i++; }
    // the plot lattice starts 24 m out, so a query AT the green sees nothing —
    // stand on the first building instead, which is where a player would be
    let b0: i32 = settle_building_pid(st, 2);
    let qx: f64 = settle_plot_x(st, b0);
    let qz: f64 = settle_plot_z(st, b0);
    let n: i32 = settle_solids_fill(st, qx, qz, out);
    print(`   M1  ${n} solids within 22 m of the first service plot`);
    ck(n >= 1 && n <= 8, "M1 the fill returns real solids and respects capacity", `${n}`);

    let bad: i32 = 0;
    let k: i32 = 0;
    while (k < n) {
        let o: i32 = k * 6;
        if (out[o] >= out[o + 3]) { bad++; }
        if (out[o + 1] >= out[o + 4]) { bad++; }
        if (out[o + 2] >= out[o + 5]) { bad++; }
        k++;
    }
    ck(bad == 0, "M2 every AABB is well ordered (min < max on all three axes)", `${bad}`);

    // a STAKED plot is a dirt pad and must have no collider
    let stC = settle_new(31677);
    let n0: i32 = settle_solids_fill(stC, qx, qz, out);
    ck(n0 <= 2, "M3 a Camp has at most its two ruins as solids", `${n0}`);

    // the eaves table matches §7.1
    ck(approx(settle_arch_eaves(SET_B_COTTAGE), 2.8, 0.0)
       && approx(settle_arch_eaves(SET_B_HOUSE), 3.4, 0.0)
       && approx(settle_arch_eaves(SET_B_HALL), 4.2, 0.0)
       && approx(settle_arch_eaves(SET_B_WORKS), 5.4, 0.0)
       && approx(settle_arch_eaves(SET_B_TOWER), 9.0, 0.0)
       && approx(settle_arch_eaves(SET_B_STACK), 12.0, 0.0)
       && approx(settle_arch_eaves(SET_B_SHACK), 2.6, 0.0),
       "M4 §7.1 the eaves heights match the archetype table",
       `${settle_arch_eaves(SET_B_WORKS)}`);

    // a zero-capacity buffer writes nothing rather than overrunning
    let none: array<f64> = [];
    ck(settle_solids_fill(st, settle_cx(st), settle_cz(st), none) == 0,
       "M5 a zero-capacity buffer writes nothing", "-");
}

// ===========================================================================
// N.  THE PLOT-VALIDITY SURVEY — REPORTED, NOT ASSERTED.  See the header.
// ===========================================================================
fn section_survey() {
    print("N. Plot-validity survey — SETTLEMENT.md §5.4 vs the terrain worldgen makes");
    let sum: i32 = 0;
    let minv: i32 = 999;
    let maxv: i32 = 0;
    let fits_v: i32 = 0;
    let fits_t: i32 = 0;
    let fits_c: i32 = 0;
    let ns: i32 = 12;
    let s: i32 = 0;
    while (s < ns) {
        let sd: i32 = 1 + s * 7919;
        let st = settle_new(sd);
        let v: i32 = settle_valid_count(st);
        sum = sum + v;
        if (v < minv) { minv = v; }
        if (v > maxv) { maxv = v; }
        if (v >= settle_tier_buildings(SET_TIER_VILLAGE)) { fits_v++; }
        if (v >= settle_tier_buildings(SET_TIER_TOWN)) { fits_t++; }
        if (v >= settle_tier_buildings(SET_TIER_CITY)) { fits_c++; }
        s++;
    }
    let mean: f64 = f64(sum) / f64(ns);
    print(`   N1  valid plots over ${ns} seeds: mean ${mean}, min ${minv}, max ${maxv}, of 72`);
    print(`   N2  a VILLAGE (9 buildings) fits on ${fits_v}/${ns} seeds`);
    print(`   N3  a TOWN    (17 buildings) fits on ${fits_t}/${ns} seeds`);
    print(`   N4  a CITY    (28 buildings) fits on ${fits_c}/${ns} seeds`);
    print("   N5  FINDING: SETTLEMENT.md §5.4 says \"the lattice never runs out\".");
    print("       Against §5.5's 2.4 m corner-range test on worldgen's measured");
    print("       terrain (§1.2: per-chunk range mean 10.3 m) it runs out well");
    print("       before a City.  The threshold is a property of what");
    print("       sm_building's footing course can hide, which this task does");
    print("       not own, so it is REPORTED and not silently relaxed.");
    print("       Not asserted here on purpose — see this file's header.");
    ck(mean > 0.0, "N6 the survey ran and found plots at all", `${mean}`);
    ck(fits_v >= ns - 2, "N7 a VILLAGE fits on essentially every seed", `${fits_v}/${ns}`);
}

// ===========================================================================
// O.  PERFORMANCE  (RULE T: __clock CPU time, min of 7; A5, A6)
// ===========================================================================
fn section_perf() {
    print("O. Performance (RULE T: __clock CPU time, min of 7 trials)");
    let TRIALS: i32 = 7;

    // empty-loop calibration, so the same bound holds interpreted
    let NC: i32 = 200000;
    let bestc: f64 = 1000000.0;
    let sink: i32 = 0;
    let tc: i32 = 0;
    while (tc < TRIALS) {
        let t0: f64 = __clock();
        let i: i32 = 0;
        while (i < NC) { sink = sink ^ i; i = i + 1; }
        let dt: f64 = __clock() - t0;
        if (dt < bestc) { bestc = dt; }
        tc++;
    }
    let cal: f64 = bestc * 1000000000.0 / f64(NC);
    let scale: f64 = cal / 12.5;
    if (scale < 1.0) { scale = 1.0; }
    print(`   O0  empty-loop calibration ${cal} ns/iter -> bound scale x${scale}   sink=${sink}`);

    // A6 — site selection at world creation
    let bestn: f64 = 1000000.0;
    let t1: i32 = 0;
    while (t1 < TRIALS) {
        let t0: f64 = __clock();
        let s = settle_new(31677 + t1 * 7);
        let dt: f64 = __clock() - t0;
        if (dt < bestn) { bestn = dt; }
        t1++;
    }
    let ms_new: f64 = bestn * 1000.0;
    print(`   O1  settle_new_at (site + roads + 72 plots)  ${ms_new} ms  (bar: A6 <= 25 ms x${scale})`);
    ck(ms_new <= 25.0 * scale,
       "O1 A6: site selection at world creation is inside 25 ms", `${ms_new}`);

    // A5 — settle_step
    let st = settle_new(31677);
    light(st, 6, 4.0, 256.0);
    advance(st, DAY_TICKS * 12, 0);
    let N: i32 = 2000;
    let bests: f64 = 1000000.0;
    let t2: i32 = 0;
    let acc: i32 = 0;
    while (t2 < TRIALS) {
        let t0: f64 = __clock();
        let i: i32 = 0;
        while (i < N) { acc = acc + settle_step(st, 6000000 + i * 60); i++; }
        let dt: f64 = __clock() - t0;
        if (dt < bests) { bests = dt; }
        t2++;
    }
    let ms_step: f64 = bests * 1000.0 / f64(N);
    print(`   O2  settle_step (${settle_building_count(st)} buildings, grid of lanterns)  ${ms_step} ms/tick  sink=${acc}`);
    print(`       amortised over 60 frames: ${ms_step / 60.0} ms/frame  (bar: A5 <= 0.05 / 0.001)`);
    ck(ms_step <= 0.05 * scale, "O2 A5: settle_step is inside 0.05 ms", `${ms_step}`);
    ck(ms_step / 60.0 <= 0.001 * scale,
       "O3 A5: amortised, it is inside 0.001 ms/frame", `${ms_step / 60.0}`);

    // settle_lux_at is a point query and must stay one
    let NL: i32 = 20000;
    let bestl: f64 = 1000000.0;
    let t3: i32 = 0;
    let lsink: i32 = 0;
    while (t3 < TRIALS) {
        let t0: f64 = __clock();
        let i: i32 = 0;
        while (i < NL) { lsink = lsink + settle_lux_at(st, settle_cx(st) + f64(i % 97), settle_cz(st)); i++; }
        let dt: f64 = __clock() - t0;
        if (dt < bestl) { bestl = dt; }
        t3++;
    }
    let us_lux: f64 = bestl * 1000000.0 / f64(NL);
    print(`   O4  settle_lux_at  ${us_lux} us/query  sink=${lsink}`);
    ck(us_lux <= 40.0 * scale, "O4 settle_lux_at stays a point query", `${us_lux}`);
}

// ===========================================================================
fn main() {
    print("probe_settle  —  src/sim/settle.hml + worldgen multi-site");
    print("");

    if (is_dir("src/sim") != true) {
        print("FAIL  run this from the nightshade repo root: src/sim/ not found from here");
        exit(1);
    }

    section_anchors();   print("");
    section_site();      print("");
    section_multisite(); print("");
    section_layout();    print("");
    section_assign();    print("");
    section_field();     print("");
    section_entropy();   print("");
    section_ladder();    print("");
    section_foundry();   print("");
    section_appendonly();print("");
    section_save();      print("");
    section_determinism();print("");
    section_solids();    print("");
    section_survey();    print("");
    section_perf();      print("");

    print(`ASSERTIONS  ran ${g_asserts}  expected ${g_expect_asserts}  pass ${g_pass}  fail ${g_fail}`);
    if (g_asserts != g_expect_asserts) {
        print(`FAIL  assertion COUNT mismatch: ran ${g_asserts}, expected ${g_expect_asserts}`);
        exit(1);
    }
    if (g_fail != 0) {
        print(`FAIL  ${g_fail} of ${g_asserts} assertions failed`);
        exit(1);
    }
    print(`PASS  ${g_pass}/${g_asserts} assertions`);
}

main();
