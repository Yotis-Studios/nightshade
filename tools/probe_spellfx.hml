// ===========================================================================
// nightshade/tools/probe_spellfx.hml — the spell-FX gate            (spell-fx)
// ===========================================================================
//
//   hemlockc -O1 tools/probe_spellfx.hml -o /tmp/pspellfx && /tmp/pspellfx
//
// HEADLESS AND COMPILED.  No window, no SDL surface, no readback: it asserts on
// the ATLAS TEXELS that `src/art/fxgen.hml` writes and on the REGISTRY ENTRIES
// that `src/render/fx.hml` submits.  The picture is judged by
// `tools/spellfx_shot.hml` on DISPLAY=:0, which is a different instrument for a
// different question — this one is the regression gate.
//
// The exit status is the contract: 0 iff every assertion passed AND exactly
// `EXPECT_ASSERTS` of them ran.  A probe whose denominator can drift cannot be
// trusted by a gate script, so a test that silently stops running fails the
// build just as loudly as a test that fails.
// ===========================================================================

import { exit } from "@stdlib/process";
import { sqrt, divi } from "@stdlib/math";

import { atlas_get } from "../../wobbleweed/src/atlas.hml";

import { pal_r, pal_g, pal_b,
         g_NS_CORE, g_NS_HALO, g_VENOM, g_VENOM_HALO, g_MUZZLE_CORE, g_EMBER }
       from "../src/art/palette.hml";

import { fxgen_build_atlas, fxgen_selftest, fxgen_checks, fxgen_cell_name,
         FX_GRID, FX_CELL, FX_INSET, FX_CELL_COUNT,
         FX_EXPLO_0, FX_EXPLO_5, FX_EMBER, FX_GLOW_S,
         FX_MEND_RING, FX_MEND_MOTE, FX_CLOAK_0, FX_CLOAK_1,
         FX_FLARE_0, FX_FLARE_1, FX_FLARE_2, FX_BOLT_HEAD,
         FX_BEAM_SEG, FX_LANCE_CORE, FX_KINDLE_POOL, FX_SIGIL }
       from "../src/art/fxgen.hml";

import { fx_clear, fx_count, fx_streak_count, fx_registry_hash,
         fx_p_s, fx_p_cell, fx_p_kind, fx_p_r, fx_p_g, fx_p_b, fx_p_a,
         fx_p_x, fx_p_y, fx_p_z, fx_s_cell, fx_s_a,
         fx_spell_bind_cells, fx_spell_bind_tints, fx_spell_reset,
         fx_spell_update, fx_spell_emit, fx_spell_live, fx_spell_sprites,
         fx_spell_dropped, fx_spell_unbound, fx_spell_refused,
         fx_spell_spawned, fx_spell_bound,
         fx_spell_heal, fx_spell_flare, fx_spell_blast, fx_spell_lance,
         fx_spell_sigil, fx_spell_trail,
         fx_spell_cloak_now, fx_spell_beam_now, fx_spell_pool_now,
         fx_spell_bolt_now, fx_spell_windup_now,
         g_FXK_SPRITE, g_FXK_GROUND,
         g_FXSP_CAP, g_SFX_FRAME_CAP, g_FXSC_COUNT, g_FXST_COUNT,
         g_FXSC_MEND_RING, g_FXSC_MEND_MOTE, g_FXSC_CLOAK_0, g_FXSC_CLOAK_1,
         g_FXSC_FLARE_0, g_FXSC_BOLT_HEAD, g_FXSC_BEAM_SEG, g_FXSC_LANCE,
         g_FXSC_KINDLE_POOL, g_FXSC_SIGIL, g_FXSC_EXPLO_0, g_FXSC_EMBER,
         g_FXST_MEND, g_FXST_MEND_DEEP, g_FXST_MAGIC, g_FXST_MAGIC_DEEP,
         g_FXST_CLOAK, g_FXST_FIRE, g_FXST_FIRE_DEEP }
       from "../src/render/fx.hml";

// ===========================================================================
// the assertion contract
// ===========================================================================

let EXPECT_ASSERTS: i32 = 68;

let g_n: i32 = 0;
let g_pass: i32 = 0;
let g_fail: i32 = 0;

fn ck(p_name: string, p_ok: i32) {
    g_n++;
    if (p_ok == 1) { g_pass++; }
    else { g_fail++; eprint(`FAIL  ${p_name}`); }
}

fn ck_i(p_name: string, p_got: i32, p_want: i32) {
    g_n++;
    if (p_got == p_want) { g_pass++; }
    else { g_fail++; eprint(`FAIL  ${p_name}: got ${p_got}, want ${p_want}`); }
}

fn ck_ge(p_name: string, p_got: i32, p_min: i32) {
    g_n++;
    if (p_got >= p_min) { g_pass++; }
    else { g_fail++; eprint(`FAIL  ${p_name}: got ${p_got}, want >= ${p_min}`); }
}

fn ck_le(p_name: string, p_got: i32, p_max: i32) {
    g_n++;
    if (p_got <= p_max) { g_pass++; }
    else { g_fail++; eprint(`FAIL  ${p_name}: got ${p_got}, want <= ${p_max}`); }
}

// ===========================================================================
// atlas helpers
// ===========================================================================

let g_atlas = null;

fn tex_r(p_cell: i32, p_x: i32, p_y: i32): i32 {
    let ox: i32 = (p_cell % FX_GRID) * FX_CELL;
    let oy: i32 = divi(p_cell, FX_GRID) * FX_CELL;
    let p: u32 = atlas_get(g_atlas, ox + p_x, oy + p_y);
    let o: i32 = i32(p & 255);
    return o;
}
fn tex_g(p_cell: i32, p_x: i32, p_y: i32): i32 {
    let ox: i32 = (p_cell % FX_GRID) * FX_CELL;
    let oy: i32 = divi(p_cell, FX_GRID) * FX_CELL;
    let p: u32 = atlas_get(g_atlas, ox + p_x, oy + p_y);
    let o: i32 = i32((p >> 8) & 255);
    return o;
}
fn tex_b(p_cell: i32, p_x: i32, p_y: i32): i32 {
    let ox: i32 = (p_cell % FX_GRID) * FX_CELL;
    let oy: i32 = divi(p_cell, FX_GRID) * FX_CELL;
    let p: u32 = atlas_get(g_atlas, ox + p_x, oy + p_y);
    let o: i32 = i32((p >> 16) & 255);
    return o;
}

// mean luminance over the DRAWABLE area of a cell (0..255)
fn cell_mean_lum(p_cell: i32): i32 {
    let lo: i32 = FX_INSET;
    let hi: i32 = FX_CELL - 1 - FX_INSET;
    let acc: i32 = 0;
    let cnt: i32 = 0;
    for (let y = lo; y <= hi; y++) {
        for (let x = lo; x <= hi; x++) {
            let l: f64 = 0.299 * f64(tex_r(p_cell, x, y))
                       + 0.587 * f64(tex_g(p_cell, x, y))
                       + 0.114 * f64(tex_b(p_cell, x, y));
            acc = acc + i32(l);
            cnt++;
        }
    }
    if (cnt < 1) { cnt = 1; }
    let o: i32 = divi(acc, cnt);
    return o;
}

// how many texels of a cell clip in EVERY channel: the "white heart" size
fn cell_white_texels(p_cell: i32): i32 {
    let lo: i32 = FX_INSET;
    let hi: i32 = FX_CELL - 1 - FX_INSET;
    let n: i32 = 0;
    for (let y = lo; y <= hi; y++) {
        for (let x = lo; x <= hi; x++) {
            if (tex_r(p_cell, x, y) >= 250 && tex_g(p_cell, x, y) >= 250
                && tex_b(p_cell, x, y) >= 250) { n++; }
        }
    }
    let o: i32 = n;
    return o;
}

// the worst peak channel anywhere on a cell's own border ring
fn cell_border_peak(p_cell: i32): i32 {
    let lo: i32 = FX_INSET;
    let hi: i32 = FX_CELL - 1 - FX_INSET;
    let worst: i32 = 0;
    for (let k = lo; k <= hi; k++) {
        let cand: array<i32> = [
            tex_r(p_cell, k, lo), tex_g(p_cell, k, lo), tex_b(p_cell, k, lo),
            tex_r(p_cell, k, hi), tex_g(p_cell, k, hi), tex_b(p_cell, k, hi),
            tex_r(p_cell, lo, k), tex_g(p_cell, lo, k), tex_b(p_cell, lo, k),
            tex_r(p_cell, hi, k), tex_g(p_cell, hi, k), tex_b(p_cell, hi, k)
        ];
        for (let i = 0; i < 12; i++) { if (cand[i] > worst) { worst = cand[i]; } }
    }
    let o: i32 = worst;
    return o;
}

// the brightest texel of a cell, and its channels
let g_pk_r: i32 = 0;
let g_pk_g: i32 = 0;
let g_pk_b: i32 = 0;
fn cell_peak(p_cell: i32): i32 {
    let lo: i32 = FX_INSET;
    let hi: i32 = FX_CELL - 1 - FX_INSET;
    let best: i32 = 0 - 1;
    g_pk_r = 0; g_pk_g = 0; g_pk_b = 0;
    for (let y = lo; y <= hi; y++) {
        for (let x = lo; x <= hi; x++) {
            let r: i32 = tex_r(p_cell, x, y);
            let g: i32 = tex_g(p_cell, x, y);
            let b: i32 = tex_b(p_cell, x, y);
            let l: i32 = i32(0.299 * f64(r) + 0.587 * f64(g) + 0.114 * f64(b));
            if (l > best) { best = l; g_pk_r = r; g_pk_g = g; g_pk_b = b; }
        }
    }
    let o: i32 = best;
    return o;
}

// ===========================================================================
// the fx.hml binding, identical in shape to the one main.hml will do
// ===========================================================================

fn bind_all() {
    let cells: array<i32> = [];
    while (cells.length < g_FXSC_COUNT) { cells.push(0 - 1); }
    cells[g_FXSC_MEND_RING] = FX_MEND_RING;
    cells[g_FXSC_MEND_MOTE] = FX_MEND_MOTE;
    cells[g_FXSC_CLOAK_0] = FX_CLOAK_0;
    cells[g_FXSC_CLOAK_1] = FX_CLOAK_1;
    cells[g_FXSC_FLARE_0] = FX_FLARE_0;
    cells[g_FXSC_BOLT_HEAD] = FX_BOLT_HEAD;
    cells[g_FXSC_BEAM_SEG] = FX_BEAM_SEG;
    cells[g_FXSC_LANCE] = FX_LANCE_CORE;
    cells[g_FXSC_KINDLE_POOL] = FX_KINDLE_POOL;
    cells[g_FXSC_SIGIL] = FX_SIGIL;
    cells[g_FXSC_EXPLO_0] = FX_EXPLO_0;
    cells[g_FXSC_EMBER] = FX_EMBER;
    fx_spell_bind_cells(cells);

    let tints: array<i32> = [];
    while (tints.length < g_FXST_COUNT) { tints.push(16777215); }
    tints[g_FXST_MEND] = g_VENOM_HALO;
    tints[g_FXST_MEND_DEEP] = g_VENOM;
    tints[g_FXST_MAGIC] = g_NS_HALO;
    tints[g_FXST_MAGIC_DEEP] = g_NS_CORE;
    tints[g_FXST_CLOAK] = g_NS_CORE;
    tints[g_FXST_FIRE] = g_MUZZLE_CORE;
    tints[g_FXST_FIRE_DEEP] = g_EMBER;
    fx_spell_bind_tints(tints);
}

// Run one deterministic "frame": clear, age, emit.
fn step(p_dt: f64) {
    fx_clear();
    fx_spell_update(p_dt);
    fx_spell_emit();
}

let DT: f64 = 0.016666666666666666;

// ===========================================================================
// SECTION 1 — THE ATLAS
// ===========================================================================

fn sec_atlas() {
    print("-- 1. the spell cells --------------------------------------------");
    g_atlas = fxgen_build_atlas();
    ck("fxgen_build_atlas returned an atlas", (g_atlas != null) ? 1 : 0);

    // The design anchor, pinned with a literal (CLAUDE.md §1 rule 5).
    ck_i("FX_CELL_COUNT is 28 (ART_BIBLE 7.4) + 12 (the spell school)",
         FX_CELL_COUNT, 40);
    ck_i("the spell cells occupy 28..39", FX_SIGIL, 39);
    ck_i("the flare strip is three CONSECUTIVE cells",
         (FX_FLARE_1 - FX_FLARE_0) * 10 + (FX_FLARE_2 - FX_FLARE_1), 11);
    ck_i("the explosion strip is six CONSECUTIVE cells",
         FX_EXPLO_5 - FX_EXPLO_0, 5);

    // fxgen's own gate still runs, still clean, and still runs the SAME NUMBER
    // of assertions — probe_atlasgen.hml pins that count at 12 and this task
    // must not move it.
    ck_i("fxgen self-test failures", fxgen_selftest(), 0);
    ck_i("fxgen self-test assertion count is unchanged", fxgen_checks(), 12);

    let named: i32 = 1;
    for (let c = FX_MEND_RING; c <= FX_SIGIL; c++) {
        if (fxgen_cell_name(c).length == 0) { named = 0; }
    }
    ck("every spell cell has a texview label", named);

    // --- THE ONE THAT MATTERS: radial cells fade before their own edge -----
    // This is the guard against the defect that shipped twice in this project:
    // a cell cranked to saturation that renders as a hard bright SQUARE.  The
    // two BEAM cells are exempt across their long axis by design (they are
    // stretched), so they are checked separately below.
    let radial: array<i32> = [FX_MEND_RING, FX_MEND_MOTE, FX_CLOAK_0, FX_CLOAK_1,
                              FX_FLARE_0, FX_FLARE_1, FX_FLARE_2, FX_BOLT_HEAD,
                              FX_KINDLE_POOL, FX_SIGIL];
    let worst: i32 = 0;
    for (let i = 0; i < radial.length; i++) {
        let p: i32 = cell_border_peak(radial[i]);
        if (p > worst) { worst = p; }
    }
    ck_le("every radial spell cell has faded before its own border (limit 48)",
          worst, 48);

    // The two streaks must fade across their SHORT axis even though they run
    // off the top and bottom.  Column 1 and column 14, all rows.
    let sworst: i32 = 0;
    let sc: array<i32> = [FX_BEAM_SEG, FX_LANCE_CORE];
    for (let i = 0; i < 2; i++) {
        for (let y = FX_INSET; y <= FX_CELL - 1 - FX_INSET; y++) {
            let cand: array<i32> = [
                tex_r(sc[i], FX_INSET, y), tex_g(sc[i], FX_INSET, y), tex_b(sc[i], FX_INSET, y),
                tex_r(sc[i], FX_CELL - 1 - FX_INSET, y),
                tex_g(sc[i], FX_CELL - 1 - FX_INSET, y),
                tex_b(sc[i], FX_CELL - 1 - FX_INSET, y)
            ];
            for (let k = 0; k < 6; k++) { if (cand[k] > sworst) { sworst = cand[k]; } }
        }
    }
    ck_le("the beam and lance fade across their SHORT axis", sworst, 48);
    // ...and they must NOT fade along their long axis, or a stretched billboard
    // shows a soft cap where the geometry ends.
    let capmin: i32 = 255;
    for (let i = 0; i < 2; i++) {
        let a: i32 = tex_b(sc[i], 8, FX_INSET);
        let b: i32 = tex_b(sc[i], 8, FX_CELL - 1 - FX_INSET);
        if (a < capmin) { capmin = a; }
        if (b < capmin) { capmin = b; }
    }
    ck_ge("the beam and lance reach the top and bottom of their slot (no cap)",
          capmin, 200);

    // --- HUE: the three reads have to be three colours --------------------
    // Heal is the palette's only green FX; the cloak and the school are violet;
    // the fire blast is the school's one warm effect.  These are asserted on
    // the CHANNEL ORDER of the cell's brightest MANTLE texel, not on a
    // hand-copied RGB triple, so a re-tune that keeps the design passes.
    cell_peak(FX_MEND_RING);
    ck("MEND RING is green-dominant", (g_pk_g >= g_pk_r && g_pk_g >= g_pk_b) ? 1 : 0);
    cell_peak(FX_MEND_MOTE);
    ck("MEND MOTE is green-dominant", (g_pk_g >= g_pk_r && g_pk_g >= g_pk_b) ? 1 : 0);
    // a violet cell is blue-dominant with red ahead of green (palette.hml uses
    // exactly this test on NS_CORE itself)
    let violets: array<i32> = [FX_CLOAK_0, FX_CLOAK_1, FX_FLARE_2,
                               FX_BEAM_SEG, FX_LANCE_CORE, FX_KINDLE_POOL];
    let vok: i32 = 1;
    for (let i = 0; i < violets.length; i++) {
        // Measure the MANTLE, and measure it as a MEAN over every lit texel
        // that is not part of the clipped heart.  A single sampled texel is not
        // a test: the first version of this check read (3,8) and failed three
        // cells for three unrelated reasons — one texel was outside the shape
        // entirely, one was in a clipped white core where R == B == 255, and
        // only the third was a real result.  The heart is white BY THE ANCHOR
        // LAW and (255,255,255) is not a hue, so excluding it is the point.
        let ar: i32 = 0; let ag: i32 = 0; let ab: i32 = 0; let an: i32 = 0;
        for (let y = FX_INSET; y <= FX_CELL - 1 - FX_INSET; y++) {
            for (let x = FX_INSET; x <= FX_CELL - 1 - FX_INSET; x++) {
                let r: i32 = tex_r(violets[i], x, y);
                let g: i32 = tex_g(violets[i], x, y);
                let b: i32 = tex_b(violets[i], x, y);
                if (r + g + b < 24) { continue; }              // unlit
                if (r >= 250 && g >= 250 && b >= 250) { continue; }   // heart
                ar = ar + r; ag = ag + g; ab = ab + b; an++;
            }
        }
        if (an < 1) { an = 1; }
        let mr: i32 = divi(ar, an); let mg: i32 = divi(ag, an); let mb: i32 = divi(ab, an);
        if (mb <= mr || mr < mg) {
            vok = 0;
            eprint(`  mantle not violet: cell ${violets[i]} mean ${mr},${mg},${mb} over ${an} texels`);
        }
    }
    ck("every violet spell cell's mantle is blue>red>=green", vok);
    cell_peak(FX_BOLT_HEAD);
    ck("BOLT HEAD is warm (red >= green >= blue)",
       (g_pk_r >= g_pk_g && g_pk_g >= g_pk_b) ? 1 : 0);

    // --- THE ANCHOR LAW, and the cloak's documented exception --------------
    // Every emissive spell cell has a clipped white heart at least ~3 texels
    // across so minification cannot eat it (fxgen.hml's header).  The two CLOAK
    // cells deliberately have NONE: a cloak that flashes gives you away.
    let hearts: array<i32> = [FX_MEND_MOTE, FX_FLARE_0, FX_FLARE_1,
                              FX_BOLT_HEAD, FX_SIGIL];
    let hmin: i32 = 9999;
    for (let i = 0; i < hearts.length; i++) {
        let w: i32 = cell_white_texels(hearts[i]);
        if (w < hmin) { hmin = w; }
    }
    ck_ge("every emissive spell cell clips over >= 7 texels (a ~3-texel heart)",
          hmin, 7);
    ck_i("CLOAK 0 has NO white heart, by design", cell_white_texels(FX_CLOAK_0), 0);
    ck_i("CLOAK 1 has NO white heart, by design", cell_white_texels(FX_CLOAK_1), 0);

    // The cloak is the DIMMEST thing in the school.  Relative, not absolute:
    // the design is "dimmer than the burst", not "mean luminance 21".
    let lc0: i32 = cell_mean_lum(FX_CLOAK_0);
    let lc1: i32 = cell_mean_lum(FX_CLOAK_1);
    let lf: i32 = cell_mean_lum(FX_FLARE_0);
    ck("CLOAK 0 is dimmer than FLARE 0", (lc0 * 2 < lf) ? 1 : 0);
    ck("CLOAK 1 is dimmer than FLARE 0", (lc1 * 2 < lf) ? 1 : 0);

    // The Kindling pool is a BOUNDARY, not a light: its rim has to out-shine
    // its own middle, or an additive card is pretending to illuminate ground it
    // physically cannot illuminate.
    let rim: i32 = 0;
    for (let x = FX_INSET; x <= FX_CELL - 1 - FX_INSET; x++) {
        let v: i32 = tex_b(FX_KINDLE_POOL, x, 8);
        let dx: i32 = x - 8;
        if (dx < 0) { dx = 0 - dx; }
        if (dx >= 4 && v > rim) { rim = v; }
    }
    let mid: i32 = tex_b(FX_KINDLE_POOL, 8, 6);
    ck("KINDLE POOL is rim-weighted (the rim out-shines the middle in blue)",
       (rim > mid) ? 1 : 0);

    print(`   cloak mean lum ${lc0}/${lc1}, flare 0 mean lum ${lf}, worst border ${worst}`);
}

// ===========================================================================
// SECTION 2 — BINDING AND THE UNBOUND PATH
// ===========================================================================

fn sec_binding() {
    print("-- 2. binding ----------------------------------------------------");
    fx_spell_reset();
    fx_clear();
    // Before any binding, every slot is -1 and every draw is a COUNTED no-op.
    // This is the difference between a missing binding that is visible and one
    // that silently paints cell 0 all over the world.
    fx_spell_heal(0.0, 0.0, 0.0);
    step(DT);
    ck_i("an unbound school draws NOTHING", fx_count(), 0);
    ck_ge("...and says so", fx_spell_unbound(), 1);

    bind_all();
    ck_i("fx_spell_bound after binding", fx_spell_bound(), 1);
    fx_spell_reset();
    fx_clear();
    fx_spell_heal(0.0, 1.0, 0.0);
    step(DT);
    ck_i("a bound heal draws the ring plus five motes", fx_count(), 6);
    ck_i("nothing was unbound this time", fx_spell_unbound(), 0);
    ck_i("the ring uses the MEND RING cell", fx_p_cell(0), FX_MEND_RING);
    ck_i("the motes use the MEND MOTE cell", fx_p_cell(3), FX_MEND_MOTE);
    ck_i("the ring is tinted VENOM_HALO's red", fx_p_r(0), pal_r(g_VENOM_HALO));
    ck_i("the ring is tinted VENOM_HALO's green", fx_p_g(0), pal_g(g_VENOM_HALO));
}

// ===========================================================================
// SECTION 3 — THE READS
// ===========================================================================

fn sec_reads() {
    print("-- 3. the reads --------------------------------------------------");
    // HEAL: the ring must SHRINK.  That is the entire read — a growing hoop is
    // a shockwave and a shrinking hoop is a gather, and they cost the same two
    // triangles.  If this assertion ever flips, the heal has become an
    // explosion and nobody will notice from a screenshot.
    fx_spell_reset(); fx_clear();
    fx_spell_heal(0.0, 1.0, 0.0);
    step(0.0);
    let r0: f64 = fx_p_s(0);
    for (let i = 0; i < 30; i++) { step(DT); }
    let r1: f64 = fx_p_s(0);
    ck("the MEND ring CLOSES INWARD over its life", (r1 < r0 * 0.8) ? 1 : 0);

    // FLARE: the shell must GROW, and it must not out-run the spell's own reach
    // by much — a burst bigger than its hitbox is a lie the player learns to
    // distrust.
    fx_spell_reset(); fx_clear();
    fx_spell_flare(0.0, 1.0, 0.0, 6.0);
    step(0.0);
    let f0: f64 = fx_p_s(0);
    for (let i = 0; i < 20; i++) { step(DT); }
    let f1: f64 = fx_p_s(0);
    ck("the FLARE shell EXPANDS", (f1 > f0 * 2.0) ? 1 : 0);
    // A regression guard, not a certificate (CLAUDE.md §1.2): the shell
    // measures 8.7 m at the end of its life for a 6 m-radius Flare, i.e. 0.72x
    // the damaged volume's diameter, and the bound is set at 1.1x — between the
    // measurement and the defect.  The defect it guards against is real and
    // shipped once: R*1.90 put a 12 m donut over the whole 320x240 frame.
    ck("...and never out-runs 1.1x the damaged volume's diameter",
       (f1 <= 6.0 * 2.2) ? 1 : 0);
    // ...and it dims as it grows.  Bright while small, gone while big.
    ck("the FLARE dims as it expands", (fx_p_a(0) < 200) ? 1 : 0);

    // FLARE walks its three atlas frames in order and never past the third.
    fx_spell_reset(); fx_clear();
    fx_spell_flare(0.0, 1.0, 0.0, 6.0);
    let seen0: i32 = 0; let seen1: i32 = 0; let seen2: i32 = 0; let over: i32 = 0;
    for (let i = 0; i < 26; i++) {
        step(DT);
        if (fx_count() < 1) { continue; }
        let c: i32 = fx_p_cell(0);
        if (c == FX_FLARE_0) { seen0 = 1; }
        else if (c == FX_FLARE_1) { seen1 = 1; }
        else if (c == FX_FLARE_2) { seen2 = 1; }
        else { over = 1; }
    }
    ck("the FLARE plays all three of its frames", (seen0 + seen1 + seen2 == 3) ? 1 : 0);
    ck("...and never indexes past FX_FLARE_2", (over == 0) ? 1 : 0);

    // THE FIRE BLAST walks the six-frame EXPLO strip and never past it.  This
    // is the assertion the harness crash came from: the strip is indexed off
    // ONE binding slot, so an off-by-one walks into a neighbouring cell.
    fx_spell_reset(); fx_clear();
    fx_spell_blast(0.0, 1.0, 0.0, 3.5);
    let lo_ok: i32 = 1; let hi_ok: i32 = 1; let last: i32 = 0 - 1;
    for (let i = 0; i < 34; i++) {
        step(DT);
        if (fx_count() < 1) { continue; }
        let c: i32 = fx_p_cell(0);
        if (c < FX_EXPLO_0) { lo_ok = 0; }
        if (c > FX_EXPLO_5) { hi_ok = 0; }
        if (c < last) { hi_ok = 0; }        // frames never go backwards
        last = c;
    }
    ck("the fire blast stays inside FX_EXPLO_0..5", (lo_ok == 1 && hi_ok == 1) ? 1 : 0);
    ck("the fire blast reaches its last frame", (last == FX_EXPLO_5) ? 1 : 0);
    // and it is WARM: the fire blast is the school's one kinetic spell and must
    // never be mistaken for anything violet.
    fx_spell_reset(); fx_clear();
    fx_spell_blast(0.0, 1.0, 0.0, 3.5);
    step(DT);
    ck("the fire blast is tinted warm (red > blue)",
       (fx_p_r(0) > fx_p_b(0)) ? 1 : 0);

    // CLOAK: three cards, alternating frames, and DIM.
    fx_spell_reset(); fx_clear();
    fx_spell_cloak_now(0.0, 0.0, 0.0, 1.0);
    ck_i("the cloak draws three cards", fx_count(), 3);
    let cmax: i32 = 0;
    for (let i = 0; i < 3; i++) { if (fx_p_a(i) > cmax) { cmax = fx_p_a(i); } }
    ck_le("the cloak's alpha ceiling stays well under a burst's 255", cmax, 160);
    let usesboth: i32 = 0;
    if (fx_p_cell(0) != fx_p_cell(1)) { usesboth = 1; }
    ck("the cloak shows both shimmer frames at once", usesboth);
    // ...and it flickers: advancing the clock past a beat swaps them.
    let before: i32 = fx_p_cell(0);
    // one full beat of the 11 Hz shimmer is 91 ms; 0.12 s clears it
    fx_spell_update(0.12);
    fx_clear();
    fx_spell_cloak_now(0.0, 0.0, 0.0, 1.0);
    ck("the cloak FLICKERS as the clock advances",
       (fx_p_cell(0) != before) ? 1 : 0);

    // KINDLING: one GROUND card, not a billboard, plus motes.
    fx_spell_reset(); fx_clear();
    fx_spell_pool_now(0.0, 0.0, 0.0, 3.0, 1.0);
    ck_i("the Kindling pool's card lies on the GROUND", fx_p_kind(0), g_FXK_GROUND);
    ck("...at the volume's own diameter", (fx_p_s(0) == 6.0) ? 1 : 0);
    ck_ge("...with motes drifting out of it", fx_count(), 2);

    // BEAM and LANCE go to the streak registry, not the sprite registry.
    fx_spell_reset(); fx_clear();
    fx_spell_beam_now(0.0, 1.6, 0.0, 0.0, 1.6, 0.0 - 14.0, 1.0);
    ck_i("the Shutter beam is a STREAK, not a sprite", fx_streak_count(), 1);
    ck_i("...using the beam cell", fx_s_cell(0), FX_BEAM_SEG);
    ck_i("...and adds no billboards", fx_count(), 0);
    fx_spell_reset(); fx_clear();
    fx_spell_lance(0.0, 1.6, 0.0, 0.0, 1.6, 0.0 - 24.0);
    step(0.0);
    ck_i("the Lance is a STREAK plus its muzzle sigil", fx_streak_count(), 1);
    ck_i("...using the lance cell", fx_s_cell(0), FX_LANCE_CORE);
    ck_i("...and one sigil sprite", fx_p_cell(0), FX_SIGIL);
}

// ===========================================================================
// SECTION 4 — LIFETIME, CAPS, BUDGET
// ===========================================================================

fn sec_budget() {
    print("-- 4. lifetime, caps, budget -------------------------------------");
    fx_spell_reset(); fx_clear();
    fx_spell_heal(0.0, 1.0, 0.0);
    ck_i("one spawn is one live effect", fx_spell_live(), 1);
    // every retained effect must die.  A spell FX that outlives its own message
    // is litter, and one that never dies is a leak.
    for (let i = 0; i < 120; i++) { step(DT); }
    ck_i("every retained effect retires within 2 seconds", fx_spell_live(), 0);
    ck_i("...and stops drawing", fx_count(), 0);

    // THE TRAIL IS SPACED BY DISTANCE, NOT BY FRAME.  Called repeatedly at one
    // position it must lay exactly ONE node — that is what keeps a bolt's cost
    // independent of the frame rate (see `fx_spell_trail`).
    fx_spell_reset(); fx_clear();
    for (let i = 0; i < 20; i++) { fx_spell_trail(0.0, 1.0, 0.0); }
    ck_i("a stationary trail lays exactly one node", fx_spell_live(), 1);

    // the retained pool has a hard cap and refusals are counted, never silent
    fx_spell_reset(); fx_clear();
    for (let i = 0; i < g_FXSP_CAP + 8; i++) { fx_spell_trail(0.0, 1.0, f64(i)); }
    ck_i("the retained pool caps at g_FXSP_CAP", fx_spell_live(), g_FXSP_CAP);
    ck_i("...and counts what it refused", fx_spell_refused(), 8);
    ck_i("...and counts what it took", fx_spell_spawned(), g_FXSP_CAP);

    // the per-frame sprite cap is hard, counted, and never silent
    fx_spell_reset(); fx_clear();
    for (let i = 0; i < 12; i++) { fx_spell_heal(0.0, 1.0, 0.0); }
    step(DT);
    ck_le("spell sprites per frame never exceed g_SFX_FRAME_CAP",
          fx_spell_sprites(), g_SFX_FRAME_CAP);
    ck_ge("...and the overflow is counted", fx_spell_dropped(), 1);
    // 36 sprites is 72 triangles: the ceiling this file promises the budget.
    ck_i("the frame cap is 36 sprites = 72 triangles", g_SFX_FRAME_CAP, 36);

    // THE REALISTIC WORST CASE.  Not the cap — what actually happens when a
    // player heals, flares and cloaks in the same frame while a bolt is in the
    // air over a Kindling pool.  This is the number the budget cares about.
    fx_spell_reset(); fx_clear();
    fx_spell_heal(0.0, 1.0, 0.0);
    fx_spell_flare(0.0, 1.0, 0.0, 6.0);
    fx_spell_blast(4.0, 1.0, 0.0, 3.5);
    for (let i = 0; i < 8; i++) { fx_spell_trail(0.0, 1.0, f64(i)); }
    fx_clear();
    fx_spell_update(DT);
    fx_spell_emit();
    fx_spell_cloak_now(0.0, 0.0, 0.0, 1.0);
    fx_spell_pool_now(6.0, 0.0, 0.0, 3.0, 1.0);
    fx_spell_bolt_now(0.0, 1.0, 0.0 - 6.0);
    fx_spell_beam_now(0.0, 1.6, 0.0, 0.0, 1.6, 0.0 - 14.0, 1.0);
    let sp: i32 = fx_spell_sprites();
    print(`   worst realistic frame: ${sp} spell sprites, ${fx_count()} particles, ${fx_streak_count()} streaks, dropped ${fx_spell_dropped()}`);
    ck_le("the realistic worst frame fits the cap", sp, g_SFX_FRAME_CAP);
    ck_i("...with nothing dropped", fx_spell_dropped(), 0);
}

// ===========================================================================
// SECTION 5 — DETERMINISM
// ===========================================================================
//
// The claim is exactly the one `spells.hml` makes about itself: a pure function
// of the ordered sequence of calls.  No `@stdlib/random`, no `__clock()`.  So
// the same script run twice must submit the identical drawing, and a different
// script must not — a hash that never changes proves nothing.
// ===========================================================================

fn run_script(p_variant: i32): u64 {
    fx_spell_reset();
    fx_clear();
    fx_spell_heal(1.0, 1.0, 2.0);
    fx_spell_flare(0.0, 1.5, 0.0, 6.0);
    fx_spell_blast(0.0 - 3.0, 1.0, 1.0, 3.5);
    fx_spell_sigil(2.0, 1.2, 0.0, 0.5);
    if (p_variant == 1) { fx_spell_trail(0.5, 1.0, 0.5); }
    for (let i = 0; i < 9; i++) {
        fx_clear();
        fx_spell_update(DT);
        fx_spell_emit();
        fx_spell_cloak_now(0.0, 0.0, 0.0, 0.9);
        fx_spell_pool_now(4.0, 0.0, 1.0, 3.0, 0.7);
        fx_spell_beam_now(0.0, 1.6, 0.0, 1.0, 1.6, 0.0 - 12.0, 0.8);
        fx_spell_windup_now(0.4, 1.4, 0.0 - 0.8, 0.55, 1);
    }
    let out: u64 = fx_registry_hash();
    return out;
}

fn sec_determinism() {
    print("-- 5. determinism ------------------------------------------------");
    let a: u64 = run_script(0);
    let b: u64 = run_script(0);
    ck("the same call sequence submits the identical drawing", (a == b) ? 1 : 0);
    let c: u64 = run_script(1);
    ck("a different call sequence submits a different drawing", (a != c) ? 1 : 0);
    // A LITERAL. This is the value the interpreter must also produce, and it is
    // how `compiled == interpreted` is checked without a second harness: run
    // this file under `hemlock` and under `hemlockc` and compare stdout.
    print(`   registry hash, script 0 = ${a}`);
    print(`   registry hash, script 1 = ${c}`);
    ck("the drawing hash is stable across the two runs above", (a == b) ? 1 : 0);

    // The scatter itself: five motes of one heal must NOT land on top of each
    // other.  This is the regression guard for the FNV hash that did exactly
    // that (see the note on `sfx_h` in fx.hml) — it passed every other test in
    // this file and rendered as a single mote.
    fx_spell_reset(); fx_clear();
    fx_spell_heal(0.0, 1.0, 0.0);
    step(DT);
    let spread: f64 = 0.0;
    for (let i = 1; i < fx_count(); i++) {
        for (let j = i + 1; j < fx_count(); j++) {
            let dx: f64 = fx_p_x(i) - fx_p_x(j);
            let dy: f64 = fx_p_y(i) - fx_p_y(j);
            let dz: f64 = fx_p_z(i) - fx_p_z(j);
            let d: f64 = sqrt(dx * dx + dy * dy + dz * dz);
            if (d > spread) { spread = d; }
        }
    }
    print(`   widest separation between two heal motes: ${spread} m`);
    ck("the five heal motes are SPREAD, not stacked", (spread > 0.5) ? 1 : 0);
}

// ===========================================================================

fn main() {
    print("probe_spellfx — the spell school's FX, headless");
    sec_atlas();
    sec_binding();
    sec_reads();
    sec_budget();
    sec_determinism();
    print(`probe_spellfx: ${g_pass}/${g_n} passed, ${g_fail} failed (contract ${EXPECT_ASSERTS})`);
    if (g_n != EXPECT_ASSERTS) {
        eprint(`ASSERTION COUNT MISMATCH: ran ${g_n}, contract says ${EXPECT_ASSERTS}`);
        exit(1);
    }
    if (g_fail != 0) { exit(1); }
}

main();
