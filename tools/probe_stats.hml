    SK_DEMAND_MELEE, SK_DEMAND_PRIMITIVE, SK_DEMAND_MANUFACTURED, SK_DEMAND_COUNT,
    stats_demand_of_weapon,
    SK_MULT_FLOOR, SK_MULT_CEIL,
    SK_N_STEADY, SK_N_QUICKHAND, SK_N_BRACED,
    SK_N_POCKETS, SK_N_BANDOLIER, SK_N_MULE,
    SK_N_LONGWICK, SK_N_SUREFLAME, SK_N_FASTLIGHT,
    SK_N_HARDY, SK_N_SECONDWICK, SK_N_UNMOVED,
    SK_N_DEEPWELL, SK_N_QUICKEMBER, SK_N_OPENSLOT,
    SK_NODE_COUNT, SK_NODES_PER_STAT, SK_NODE_RANK_MAX, SK_BRANCH_PER,
    SK_VERSION, SKS_VER, SKS_STAT, SKS_NODE, SKS_RESPECS, SKS_FIELDS,
    stats_stat_name, stats_node_name, stats_node_stat, stats_node_req,
    stats_node_of,
    stats_new, stats_reset, stats_copy, stats_get, stats_rank, stats_respecs,
    stats_spent, stats_unspent, stats_unspent_of,
    stats_can_raise, stats_can_raise_of, stats_raise, stats_raise_of,
    stats_branch_points, stats_branch_spent, stats_node_open,
    stats_can_rank, stats_rank_up, stats_respec,
    stats_recoil_mult_at, stats_sway_mult_at, stats_ads_mult_at, stats_reload_mult_at,
    stats_recoil_mult, stats_sway_mult, stats_ads_mult, stats_reload_mult,
    stats_recoil_mult_wpn, stats_sway_mult_wpn, stats_ads_mult_wpn, stats_reload_mult_wpn,
    SK_EQ_NONE, SK_EQ_BANDOLIER, SK_EQ_POUCHES, SK_EQ_PACK, SK_EQ_ALL,
    stats_equip_kg, stats_carry_kg_at, stats_carry_kg,
    stats_overload01_at, stats_overload01, stats_move_mult_at, stats_move_mult,
    stats_ammo_mult_at, stats_ammo_mult, stats_material_cap_at, stats_material_cap,
