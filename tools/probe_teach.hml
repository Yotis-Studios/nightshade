// =============================================================================
//  probe_teach.hml — CAN A PLAYER WHO IS TOLD NOTHING LEARN THE SECOND VERB?
// =============================================================================
//
//  Run it FROM THE NIGHTSHADE REPO ROOT:
//
//      hemlockc -O1 tools/probe_teach.hml -o /tmp/pt && /tmp/pt
//      /tmp/pt --seeds 8 --minutes 40          (a wider, slower sweep)
//
//  It exits 1 on any failure AND on an assertion-count mismatch.
//
//  -------------------------------------------------------------------------
//  WHY IT EXISTS
//  -------------------------------------------------------------------------
//  `probe_lanfeed` proved the loop closes and then printed, in its own output,
//  the reason that did not make it a game:
//
//      "Four kits, and four posts inside 64 m is a Village. The game teaches
//       NEITHER. There is no map, no marker and no line of dialogue that says
//       the ring exists, so a human with these four kits has no way to learn
//       where to put them."
//
//  `probe_lanfeed`'s ARM PLANT reads `settle_cx` / `settle_cz` off the server
//  and knows a post is worth more inside 64 m. It says so itself and calls
//  itself an oracle. This probe is the other half: the same loop, driven by a
//  player who is allowed to know ONLY WHAT THE SCREEN SAYS.
//
//  -------------------------------------------------------------------------
//  >>> THE ONE RULE. ARM BLIND MAY READ SEVEN NUMBERS AND NO OTHERS. <<<
//  -------------------------------------------------------------------------
//  Every navigational decision `arm_blind` makes comes from this list, and each
//  entry names the pixels a human reads it off:
//
//    client_settle_bearing   the compass diamond (main.hml, the objective row)
//    client_settle_inside    the diamond's COLOUR: amber inside, green outside
//    client_settle_dist      the prompt's second line, "48M TO THE REACH"
//    client_pack_kits        the pack row: one lantern icon per kit
//    client_prompt           "HOLD [E] - LIGHT THE LANTERN"
//    client_dead / client_lantern_lit   the two things nobody can miss
//    teach_plant_ready(...)  "[E] PLANT A LANTERN POST" -- THE SAME FUNCTION
//                            `sv_ui_tick` uses to decide whether the key works
//
//  >>> AND AN EIGHTH WAS ADDED ON 2026-08-01, DECLARED HERE RATHER THAN
//      SMUGGLED IN. <<<  `client_speed`. It is not a HUD readout and there is
//      no pixel to point at, which is exactly why it belongs on the list
//      instead of being waved through: whether you are moving is the ENTIRE
//      SCREEN in a first-person game, and it is the one thing a player cannot
//      fail to know. The verb now requires you to be standing still unless you
//      are inside the reach or have never planted a post -- see the TEACH block
//      in `src/game/server.hml` -- so an arm that cannot tell whether it is
//      running could not obey the prompt it is supposed to be obeying.
//
//  `settle_cx` and `settle_cz` ARE NOT IMPORTED BY THIS FILE AT ALL, so
//  `arm_blind` could not read the settlement's coordinates if it tried -- the
//  symbols are not in scope. Neither is `server_world` or `server_lantern_x`.
//  The arm walks the compass bearing down to zero and plants when the screen
//  says it is inside the reach, which is exactly the procedure the HUD now
//  describes to a player.
//
//  So this probe CAN say: is the information now on screen SUFFICIENT to close
//  the loop? It CANNOT say whether the information is LEGIBLE -- whether a
//  human looking at a 320x180 frame notices the diamond change colour. That is
//  measured with eyes and screenshots, this file has none, and the task report
//  carries that half.
//
//  -------------------------------------------------------------------------
//  NO FIXTURE. `server_settle_boot_tier`, `settle_load`, `settle_lanterns_set`,
//  `server_grant_kits` and `server_teleport` appear nowhere below. Every kit
//  this probe plants was earned by surviving the beat that pays for it.
//
//  IMPORTS: `src/game/**`, `src/sim/**`, `src/core/**`, `src/net/**`,
//  `@stdlib/math`, `@stdlib/process`. No SDL, no wobbleweed, no wall clock.
// =============================================================================

import { exit } from "@stdlib/process";
import { floor } from "@stdlib/math";
// §A3 reads `src/game/main.hml` AS TEXT. It does not import it and could not
// -- that file needs a window. See §A3 for why a text check is the right shape
// of instrument for the defect it guards.
import { read_file, exists } from "@stdlib/fs";

import { sim_accum_new, sim_accum_advance, sim_accum_alpha } from "../src/sim/sim.hml";

import { day_phase, PHASE_DAWN } from "../src/sim/daycycle.hml";

import { BTN_FIRE, BTN_USE, BTN_ADS, BTN_SPRINT, BTN_RELOAD,
         BTN_BUILD, BTN_SWITCH, BTN_GRENADE, BTN_INV } from "../src/sim/command.hml";

// OUTCOME reads only -- what the town became, never where it is.
// >>> `settle_cx` AND `settle_cz` ARE NOT IMPORTED AT ALL, ANYWHERE IN THIS
//     FILE. <<< That is not tidiness, it is the claim in the header made
//     structural: `arm_blind` cannot read the settlement's coordinates even by
//     accident, because the symbols are not in scope. `probe_lanfeed`'s ARM
//     PLANT imports both and says so; this arm cannot.
import { settle_core_lux, settle_grid_points,
         settle_tier, settle_tier_ever, settle_ring_m,
         SET_TIER_CAMP, SET_TIER_VILLAGE, SET_RING_CAMP_M,
         SET_CORE_VILLAGE, SET_PTS_VILLAGE } from "../src/sim/settle.hml";

import { npc_topic, npc_topic_arg, npc_talk, npc_pack_grant, npc_present,
         NPC_WICK, NPC_T_KIT, NPC_OFF_KIT, NPC_NONE } from "../src/sim/npc.hml";

import { transport_loopback } from "../src/net/transport.hml";

import { demobot_new, demobot_frame } from "../src/game/demobot.hml";

import { server_new, server_tick, server_snapshot, server_local, server_t0,
         server_spawn_yaw, server_beat, server_settle,
         server_npcs, server_tick_now, server_kit_verdict,
         teach_plant_ready, teach_ring_show, teach_verdict,
         TEACH_V_NONE, TEACH_V_INSIDE, TEACH_V_OUTSIDE,
         teach_mark_px, teach_mark_off, teach_lantern_band, teach_help_hint,
         teach_wick01, teach_wick_alpha, teach_wick_size,
         TEACH_BAR_PX_PER_RAD, TEACH_BAR_HALF_PX, TEACH_LANTERN_SIGHT_M,
         TEACH_BAND_NONE, TEACH_BAND_SIGHTED, TEACH_BAND_REACH,
         TEACH_WICK_A_LO, TEACH_WICK_A_HI, TEACH_WICK_HZ,
         UI_PANEL_NONE, UI_PANEL_CHAR, SV_PLANT_STILL_MS,
         SV_OPEN_KITS, SV_BEAT_PATH } from "../src/game/server.hml";

import { client_new, client_set_angles, client_set_move, client_set_button,
         client_send_command, client_apply, client_frame, client_build_render,
         client_px, client_pz, client_dead, client_lantern_lit,
         client_cam_yaw, client_prompt, client_talk_who, client_ui_panel,
         client_pack_kits, client_kits_placed, client_settle_bearing,
         client_settle_inside, client_settle_dist, client_speed,
         client_settle_tier_ever, CL_PROMPT_M } from "../src/game/client.hml";

// >>> ONE CONSTANT FROM `src/core/config.hml`, AND IT IS THE HONEST ONE. <<<
// §T2 measures how long the lantern's words are on screen while you sprint
// through them, and a COPY of the sprint speed here would let this section
// pass while the game got faster. `g_SPEED_SPRINT` is the number
// `movement.hml:719` actually applies.
import { g_SPEED_SPRINT } from "../src/core/config.hml";

// ---------------------------------------------------------------------------
//  CONFIGURATION
// ---------------------------------------------------------------------------
let g_SEEDS: i32    = 4;         // --seeds N
// 30, for `probe_lanfeed`'s reason, restated because it cost that probe an
// exit(1): `settle_step` holds the threshold one continuous in-game day before
// promoting, the fourth post lands at ~9 min, and the Village therefore lands
// at ~25 min. A default that cannot reach the thing it asserts is a bug.
let g_MINUTES: i32  = 30;        // --minutes N, per seed, of GAME time
let g_DT_MS: f64    = 16.667;

// THE ASSERTION COUNT, AS A FORMULA, checked on every run: a probe that
// silently stops running half its checks is worse than no probe.
let PT_FIXED: i32    = 51;   // A 8 + A1 9 + A2 2 + A3 1 + E 3 + F 4 + D 5 + G 2
                             //   + T 17 (the-tutorial-nobody-sees: T1 3, T2 5, T3 3,
                             //   T4 3, T5 3)
let PT_PER_SEED: i32 = 9;

// The blind lamplighter's numbers. Every one is a thing a person does, not a
// coordinate: "get well inside the marker", "step off a bit", "count to three".
let PT_DEEP_M: f64     = 38.0;   // walk in until the reach readout is under this
let PT_STEP_TICKS: i32 = 150;    // ~2.5 s of walking between posts: at the run
                                 // speed that is comfortably past the 12 m
                                 // SV_KIT_MIN_GAP_M without being told what it is
let PT_CHANNEL_T: i32  = 170;    // 2.5 s of held E, plus slack for the frame the
                                 // plant itself consumed
let PT_TURN: f64       = 1.30;   // ~75 degrees. "Step off to one side."
// A person who stops to put something down does not stop INSTANTLY, and the
// prompt now waits for them. 90 ticks is a second and a half of standing there
// with the key ready -- generously past the movement code's own deceleration --
// after which the arm gives up and walks on, which is also what a person does.
let PT_STILL_WAIT: i32 = 90;
// Where in the 150-tick step ARM OUTSIDE presses E ON PURPOSE WHILE RUNNING.
// This is the state gate 9 enumerated as 1 of 8: moving, outside the reach,
// past your first post. Before this wave it spent a lantern kit and put nothing
// whatsoever on screen; §A2 asserts, in a real session on the real wire, that
// it now spends nothing -- because the prompt is down, and the prompt and the
// key are finally the same bit.
let PT_MOVE_PRESS_AT: i32 = 120;
// Ticks to wait after a press before asking whether a kit was spent. The plant
// happens on the server the same tick the command lands; the client learns it
// from the next snapshot. Six is slack, not a guess about latency.
let PT_SPEND_WAIT: i32 = 6;

// ---------------------------------------------------------------------------
//  ASSERTIONS
// ---------------------------------------------------------------------------
fn sv(p_v): string { let out: string = `${p_v}`; return out; }

let g_n: i32 = 0;
let g_ok: i32 = 0;
// The first ARM BLIND session, kept alive past its loop so section F can ask
// its villagers questions. It is a REAL, EARNED session; §F says what it then
// does to it and why.
let g_seed0 = null;

// §A2's accumulators, over every seed and both arms.
let g_ap: array = [0, 0, 0, 0, 0, 0, 0, 0];   // presses of E, per state
let g_ar: array = [0, 0, 0, 0, 0, 0, 0, 0];   // ...with the PROMPT up
let g_as: array = [0, 0, 0, 0, 0, 0, 0, 0];   // ...that SPENT a kit
let g_silent: i32 = 0;      // spent with the prompt DOWN — the gate-9 defect
let g_promised: i32 = 0;    // prompt UP, nothing spent (explicable; counted)

fn pt_fold(p_r: object) {
    let r: object = p_r;
    let pr: array = r.st_pr;
    let rd: array = r.st_rd;
    let sp: array = r.st_sp;
    for (let i = 0; i < 8; i++) {
        g_ap[i] = g_ap[i] + pr[i];
        g_ar[i] = g_ar[i] + rd[i];
        g_as[i] = g_as[i] + sp[i];
    }
    g_silent = g_silent + r.silent;
    g_promised = g_promised + r.promised;
}

fn ck(p_ok: bool, p_msg: string) {
    g_n = g_n + 1;
    if (p_ok) { g_ok = g_ok + 1; }
    if (!p_ok) { print("  FAIL [" + sv(g_n) + "] " + p_msg); }
}

fn compiled(): i32 {
    let a0: string = args[0];
    let out: i32 = 1;
    if (a0.ends_with(".hml")) { out = 0; }
    return out;
}

fn f1(p_x: f64): string { let out: string = sv(floor(p_x * 10.0) / 10.0); return out; }

fn pt_abs(p_x: f64): f64 {
    let x: f64 = p_x;
    if (x < 0.0) { let n: f64 = 0.0 - x; return n; }
    let out: f64 = x;
    return out;
}

fn padl(p_s: string, p_w: i32): string {
    let s: string = p_s;
    while (s.length < p_w) { s = " " + s; }
    let out: string = s;
    return out;
}
fn padr(p_s: string, p_w: i32): string {
    let s: string = p_s;
    while (s.length < p_w) { s = s + " "; }
    let out: string = s;
    return out;
}
fn pi(p_v: i32, p_w: i32): string { let out: string = padl(sv(p_v), p_w); return out; }
fn pf(p_v: f64, p_w: i32): string { let out: string = padl(f1(p_v), p_w); return out; }

fn mmss(p_t: i32): string {
    let s: i32 = p_t / 60;
    let m: i32 = s / 60;
    let r: i32 = s - m * 60;
    let pad: string = "";
    if (r < 10) { pad = "0"; }
    let out: string = sv(m) + ":" + pad + sv(r);
    return out;
}

// ---------------------------------------------------------------------------
//  THE EIGHT STATES, AS ONE INDEX
// ---------------------------------------------------------------------------
//  Gate 9 enumerated (moving | still) x (inside | outside the reach) x (your
//  first post | not) against the real shipped function and found one state --
//  index 5 below -- where the prompt and the action disagreed. Everything in
//  §A1 and §A2 is indexed this way so the unit table and the session table can
//  be read against each other row by row.
fn pt_state(p_moving: i32, p_inside: i32, p_placed: i32): i32 {
    let s: i32 = 0;
    if (p_moving != 0) { s = s + 1; }
    if (p_inside != 0) { s = s + 2; }
    if (p_placed > 0) { s = s + 4; }
    let out: i32 = s;
    return out;
}

fn pt_state_name(p_i: i32): string {
    let i: i32 = p_i;
    let a: string = "still";
    if ((i & 1) != 0) { a = "MOVING"; }
    let b: string = "outside";
    if ((i & 2) != 0) { b = "inside"; }
    let c: string = "first post";
    if ((i & 4) != 0) { c = "planted before"; }
    let out: string = padr(a, 7) + " " + padr(b, 8) + " " + c;
    return out;
}

// The predicate, fed EXACTLY what `main.hml`'s `teach_ready()` feeds it: the
// client's own numbers, which are the ones a player can possibly have. If this
// call ever stops matching `teach_ready()` argument for argument, the probe is
// measuring something the game does not do.
fn pt_ready(p_cl: object): i32 {
    let cl: object = p_cl;
    let out: i32 = teach_plant_ready(client_pack_kits(cl), client_prompt(cl),
                                     client_talk_who(cl), client_ui_panel(cl),
                                     client_dead(cl),
                                     client_settle_inside(cl),
                                     client_kits_placed(cl),
                                     client_speed(cl));
    return out;
}

fn vname(p_v: i32): string {
    if (p_v == TEACH_V_INSIDE) { let a: string = "INSIDE"; return a; }
    if (p_v == TEACH_V_OUTSIDE) { let b: string = "OUTSIDE"; return b; }
    let c: string = "NONE";
    return c;
}

// ---------------------------------------------------------------------------
//  THE SESSION — `main.hml`'s run_loop with the window, the renderer and the
//  wall clock removed. Identical in shape to probe_lanfeed §HARNESS on purpose.
// ---------------------------------------------------------------------------
let BL_HOLD: i32  = 0;   // the shipping demobot owns the player
let BL_HOME: i32  = 1;   // walk the compass bearing down to zero
let BL_PLANT: i32 = 2;   // tap E, then hold E
let BL_STEP: i32  = 3;   // step off to one side
let BL_OUT: i32   = 4;   // walk back out, resume the hold

fn session_new(p_seed: i32, p_arm: i32): object {
    let net: object = transport_loopback();
    let sv2: object = server_new(p_seed, net);
    let cl: object = client_new(net, p_seed);
    let s: object = {
        seed: p_seed,
        arm: p_arm,
        net: net, sv: sv2, cl: cl,
        acc: sim_accum_new(),
        t0: server_t0(sv2),
        tick: server_t0(sv2),
        bot: demobot_new(cl, sv2),
        st: BL_HOLD,
        chan: -1,
        walk: 0,
        heading: 0.0,
        // ---- what the run measured ------------------------------------
        path_tick: -1,      // the tick SV_BEAT_PATH fired
        path_kits: -1,      // ...and what was in the pack one second later
        ready_tick: -1,     // the first tick `teach_plant_ready` said yes
        ring_tick: -1,      // the first tick `teach_ring_show` said yes
        cross_tick: -1,     // the first tick the wire said "inside the reach"
        planted: 0,
        agree: 0, disagree: 0,   // HUD verdict vs authority verdict, per plant
        v_in: 0, v_out: 0,
        vill_tick: -1,
        end_core: 0, end_pts: 0, end_tier: 0,
        wick_topic: -2,
        // ---- §A2: every press of E, audited ---------------------------
        // One row per state of the eight. `pr` counts presses, `rd` counts the
        // presses where the PROMPT was up, `sp` counts the presses that SPENT a
        // kit. The finding is the comparison of the last two columns.
        st_pr: [0, 0, 0, 0, 0, 0, 0, 0],
        st_rd: [0, 0, 0, 0, 0, 0, 0, 0],
        st_sp: [0, 0, 0, 0, 0, 0, 0, 0],
        silent: 0,      // kits spent while the prompt was DOWN — the defect
        promised: 0,    // prompt UP and the key did nothing
        wait: 0,        // ticks spent standing still waiting for the prompt
        pend: 0, pend_t: 0, pend_state: 0, pend_ready: 0, pend_placed: 0,
        // section E: where the wire's `set_inside` actually flips
        edge_lo: 0.0, edge_hi: 1.0e30
    };
    client_set_angles(cl, server_spawn_yaw(sv2), 0.0);
    server_tick(sv2, s.tick);
    client_apply(cl, server_snapshot(sv2), server_local(sv2), s.tick);
    s.tick = s.tick + 1;
    let out: object = s;
    return out;
}

fn session_frame(p_s: object): i32 {
    let s: object = p_s;
    let cl: object = s.cl;
    let sv2: object = s.sv;
    let n: i32 = sim_accum_advance(s.acc, g_DT_MS);
    let i: i32 = 0;
    while (i < n) {
        client_send_command(cl, s.tick);
        server_tick(sv2, s.tick);
        client_apply(cl, server_snapshot(sv2), server_local(sv2), s.tick);
        s.tick = s.tick + 1;
        i++;
    }
    client_frame(cl, g_DT_MS * 0.001, s.tick);
    // NOT OPTIONAL: `demobot_frame` picks its target from `client_ent_*`,
    // which read the RENDER snapshot, filled only here. probe_lanfeed's header
    // records the hour it cost to find that out.
    client_build_render(cl, sim_accum_alpha(s.acc));
    let out: i32 = n;
    return out;
}

// ---------------------------------------------------------------------------
//  §A2's INSTRUMENT — RECORD A PRESS, THEN ASK WHETHER IT COST ANYTHING
// ---------------------------------------------------------------------------
//  Called by the arms on the RISING EDGE of BTN_USE and nowhere else, because
//  `sv_ui_tick` plants on the edge and a held key plants nothing. It latches
//  what the screen was saying at the instant of the press; `run_seed` collects
//  the answer `PT_SPEND_WAIT` ticks later, once the authority's `kits_placed`
//  has had time to come back down the wire.
fn pt_press_begin(p_s: object) {
    let s: object = p_s;
    let cl: object = s.cl;
    let mv: i32 = 0;
    if (client_speed(cl) >= SV_PLANT_STILL_MS) { mv = 1; }
    s.pend = 1;
    s.pend_t = 0;
    s.pend_state = pt_state(mv, client_settle_inside(cl), client_kits_placed(cl));
    s.pend_ready = pt_ready(cl);
    s.pend_placed = client_kits_placed(cl);
}

fn pt_press_settle(p_s: object) {
    let s: object = p_s;
    if (s.pend == 0) { return; }
    s.pend_t = s.pend_t + 1;
    if (s.pend_t < PT_SPEND_WAIT) { return; }
    s.pend = 0;
    let spent: i32 = 0;
    if (client_kits_placed(s.cl) > s.pend_placed) { spent = 1; }
    let i: i32 = s.pend_state;
    let pr: array = s.st_pr; pr[i] = pr[i] + 1;
    if (s.pend_ready == 1) { let rd: array = s.st_rd; rd[i] = rd[i] + 1; }
    if (spent == 1) { let sp: array = s.st_sp; sp[i] = sp[i] + 1; }
    // >>> THE ONE THAT IS NEVER EXPLICABLE. <<< A kit spent while the prompt
    // was down is the gate-9 defect exactly, and nothing else in the game can
    // produce it. The other direction (prompt up, nothing spent) IS explicable
    // -- `SV_KIT_MIN_GAP_M` refuses a post within 12 m of another one and the
    // client cannot see that refusal coming -- so it is COUNTED and printed
    // rather than asserted, which is the honest bar for it.
    if (s.pend_ready == 0 && spent == 1) { s.silent = s.silent + 1; }
    if (s.pend_ready == 1 && spent == 0) { s.promised = s.promised + 1; }
}

fn clear_ui(p_cl: object) {
    client_set_button(p_cl, BTN_BUILD, 0);
    client_set_button(p_cl, BTN_SWITCH, 0);
    client_set_button(p_cl, BTN_GRENADE, 0);
    client_set_button(p_cl, BTN_INV, 0);
}

// ---------------------------------------------------------------------------
//  ARM BLIND — THE LAMPLIGHTER WHO CAN ONLY SEE THE SCREEN
// ---------------------------------------------------------------------------
//  It reads the seven numbers in the header and nothing else. In particular it
//  does not know where the town IS -- only which way the diamond points, and
//  whether the diamond has gone amber.
//
//  HOLD  : the shipping demobot owns the player, exactly as ARM PLANT does.
//  HOME  : turn until the compass bearing is ~0, walk. Stop when the screen
//          says INSIDE THE REACH and the distance readout is under PT_DEEP_M.
//  PLANT : tap E (which the prompt says plants), then hold E for the channel
//          (which the prompt says lights).
//  STEP  : turn 75 degrees off and walk for two and a half seconds, which is
//          what "put the next one over there" looks like when nobody has told
//          you the minimum gap is twelve metres.
//  OUT   : pack empty; walk the bearing away and give the player back.
//
//  ARM OUTSIDE is the same machine with one line different: it never walks
//  home. It plants where it stands, at the post, ~275 m out. It exists so that
//  "the verdict is different" is measured against a control rather than argued.
// ---------------------------------------------------------------------------
let ARM_BLIND: i32   = 0;
let ARM_OUTSIDE: i32 = 1;

fn face_bearing(p_s: object, p_rel: f64) {
    let s: object = p_s;
    let cl: object = s.cl;
    // `client_settle_bearing` is RELATIVE to where you are looking -- it is the
    // diamond's x offset on the compass. Turning until it reads zero is what a
    // player does with a compass and it is all this needs.
    let want: f64 = client_cam_yaw(cl) + client_settle_bearing(cl) + p_rel;
    client_set_angles(cl, want, 0.0);
}

fn arm_blind(p_s: object) {
    let s: object = p_s;
    let cl: object = s.cl;

    // 1. the shipping driver runs first, always.
    demobot_frame(s.bot, client_px(cl), client_pz(cl));
    clear_ui(cl);

    if (client_dead(cl) == 1) { s.chan = -1; return; }
    // Until the first lantern is lit the opening script owns the player.
    if (client_lantern_lit(cl) == 0) { return; }

    let kits: i32 = client_pack_kits(cl);
    let inside: i32 = client_settle_inside(cl);
    let dist: f64 = client_settle_dist(cl);

    if (s.st == BL_HOLD) {
        // A lamplighter goes home at dawn, and only carrying something worth
        // the walk. Dawn is a thing you can see; the pack row is a thing you
        // can see. Nothing here is off the wire that is not on the screen.
        if (day_phase(server_tick_now(s.sv)) == PHASE_DAWN && kits > 0) {
            if (s.arm == ARM_OUTSIDE) { s.st = BL_PLANT; }
            else { s.st = BL_HOME; }
            s.chan = -1;
            s.walk = 0;
        }
        return;
    }

    if (kits <= 0 && s.chan < 0) { s.st = BL_OUT; }

    if (s.st == BL_HOME) {
        face_bearing(s, 0.0);
        client_set_button(cl, BTN_FIRE, 0);
        client_set_button(cl, BTN_ADS, 0);
        client_set_button(cl, BTN_USE, 0);
        if (inside == 1 && dist < PT_DEEP_M) {
            s.st = BL_PLANT;
            s.chan = -1;
            return;
        }
        client_set_move(cl, 1.0, 0.0);
        client_set_button(cl, BTN_SPRINT, 1);
        return;
    }

    if (s.st == BL_PLANT) {
        client_set_move(cl, 0.0, 0.0);
        client_set_button(cl, BTN_SPRINT, 0);
        client_set_button(cl, BTN_FIRE, 0);
        client_set_button(cl, BTN_ADS, 0);
        if (s.chan < 0) {
            // >>> THE PROMPT IS THE INSTRUCTION, SO THE PROBE OBEYS IT. <<<
            // If `teach_plant_ready` is 0 the HUD is not offering the verb and
            // this bot does not press the key. That is the whole point: a bot
            // that presses E regardless would pass on a tree where the prompt
            // is a lie.
            //
            // >>> AND IT NOW WAITS INSTEAD OF WALKING AWAY, WHICH IS A REAL
            //     BEHAVIOUR CHANGE IN THIS PROBE AND IS DECLARED. <<< The verb
            // requires you to be standing still (outside the reach, past your
            // first post), and `client_set_move(cl, 0, 0)` one tick ago does
            // not mean the body has stopped -- the movement code decelerates.
            // The old arm read the prompt on the frame it stopped ASKING to
            // move, found it down, and left. A person stops, sees the prompt
            // appear, and presses. `PT_STILL_WAIT` is that second and a half.
            if (pt_ready(cl) == 0) {
                client_set_button(cl, BTN_USE, 0);
                s.wait = s.wait + 1;
                if (s.wait < PT_STILL_WAIT) { return; }
                s.wait = 0;
                s.st = BL_STEP;
                s.walk = 0;
                return;
            }
            s.wait = 0;
            client_set_button(cl, BTN_USE, 1);      // the rising edge -> plant
            pt_press_begin(s);
            s.chan = 0;
            return;
        }
        client_set_button(cl, BTN_USE, 1);          // held -> sim.hml stage (g)
        s.chan = s.chan + 1;
        if (s.chan >= PT_CHANNEL_T) {
            client_set_button(cl, BTN_USE, 0);
            s.chan = -1;
            s.st = BL_STEP;
            s.walk = 0;
        }
        return;
    }

    if (s.st == BL_STEP) {
        client_set_button(cl, BTN_SPRINT, 0);
        // ARM OUTSIDE steps off but never walks home; it is planting a hedge of
        // posts in the field where it stands.
        if (s.arm == ARM_OUTSIDE) { face_bearing(s, 3.141592653589793 + PT_TURN); }
        else { face_bearing(s, PT_TURN); }
        client_set_move(cl, 1.0, 0.0);
        s.walk = s.walk + 1;
        // ---- §A2: THE PRESS THAT USED TO COST A KIT FOR NOTHING ----------
        // ARM OUTSIDE, and only ARM OUTSIDE, jabs E in the middle of the step
        // -- at a dead run, outside the reach, well past its first post. That
        // is state 5 of the eight, the one gate 9 named. ARM BLIND is left
        // alone on purpose: section B's eight-of-eight Villages are a measured
        // outcome and a probe that changes its own control arm to make a new
        // assertion pass has broken the older one.
        if (s.arm == ARM_OUTSIDE && s.walk == PT_MOVE_PRESS_AT) {
            client_set_button(cl, BTN_USE, 1);
            pt_press_begin(s);
        } else {
            client_set_button(cl, BTN_USE, 0);
        }
        if (s.walk >= PT_STEP_TICKS) {
            s.walk = 0;
            s.wait = 0;
            if (s.arm == ARM_OUTSIDE) { s.st = BL_PLANT; }
            else { s.st = BL_HOME; }
        }
        return;
    }

    // BL_OUT: the pack is empty. Walk the bearing away and hand the player back
    // to the shipping driver, which is where the next night's kits are earned.
    client_set_button(cl, BTN_USE, 0);
    if (dist < 90.0) {
        face_bearing(s, 3.141592653589793);
        client_set_move(cl, 1.0, 0.0);
        client_set_button(cl, BTN_SPRINT, 1);
        return;
    }
    s.st = BL_HOLD;
}

// ---------------------------------------------------------------------------
//  ONE SEED, ONE ARM
// ---------------------------------------------------------------------------
fn run_seed(p_seed: i32, p_arm: i32, p_minutes: i32): object {
    let s: object = session_new(p_seed, p_arm);
    let cl: object = s.cl;
    let sv2: object = s.sv;
    let st: object = server_settle(sv2);
    let stop: i32 = s.t0 + p_minutes * 3600;
    let last_placed: i32 = 0;

    while (s.tick < stop) {
        arm_blind(s);
        session_frame(s);
        pt_press_settle(s);
        let now: i32 = server_tick_now(sv2);

        // ---- the beats, and the two predicates the HUD draws off ---------
        if (s.path_tick < 0 && server_beat(sv2) == SV_BEAT_PATH) { s.path_tick = now; }
        if (s.path_tick > 0 && s.path_kits < 0 && now >= s.path_tick + 60) {
            s.path_kits = client_pack_kits(cl);
        }
        if (s.ready_tick < 0) {
            if (teach_plant_ready(client_pack_kits(cl), client_prompt(cl),
                                  client_talk_who(cl), client_ui_panel(cl),
                                  client_dead(cl)) == 1) { s.ready_tick = now; }
        }
        if (s.ring_tick < 0) {
            if (teach_ring_show(client_pack_kits(cl), client_dead(cl)) == 1) {
                s.ring_tick = now;
            }
        }
        if (s.cross_tick < 0 && client_settle_inside(cl) == 1) { s.cross_tick = now; }

        // ---- SECTION E's measurement, taken continuously -----------------
        // Where does the wire's `set_inside` actually flip? Bracket it: the
        // largest distance ever reported INSIDE, and the smallest ever reported
        // OUTSIDE. `settle_ring_m(tier_ever)` has to sit between them.
        //
        // SAMPLED ONLY AT CAMP, and the first version of this was wrong for
        // exactly the reason worth writing down: the ring is a function of
        // `tier_ever`, so the moment the player's own work promotes the town it
        // goes 64 -> 120 and a bracket that spans the promotion is comparing
        // two different rings. The tier is read off the WIRE, like everything
        // else this arm is allowed to see.
        if (client_settle_tier_ever(cl) == SET_TIER_CAMP) {
            let d_true: f64 = client_settle_dist(cl);
            if (client_settle_inside(cl) == 1) {
                if (d_true > s.edge_lo) { s.edge_lo = d_true; }
            } else {
                if (d_true < s.edge_hi) { s.edge_hi = d_true; }
            }
        }

        // ---- SECTION C: every plant, both verdicts, compared -------------
        let placed: i32 = client_kits_placed(cl);
        if (placed > last_placed) {
            last_placed = placed;
            s.planted = placed;
            // What the HUD draws, from `set_inside` and nothing else. This is
            // literally `main.hml`'s `teach_step` line.
            let hudv: i32 = teach_verdict(client_settle_inside(cl));
            // What the authority latched at the coordinates of the post.
            let authv: i32 = server_kit_verdict(sv2);
            if (hudv == authv) { s.agree = s.agree + 1; }
            else { s.disagree = s.disagree + 1; }
            if (authv == TEACH_V_INSIDE) { s.v_in = s.v_in + 1; }
            else { s.v_out = s.v_out + 1; }
        }

        if (s.vill_tick < 0 && settle_tier(st) >= SET_TIER_VILLAGE) {
            s.vill_tick = now;
        }
    }

    s.end_core = settle_core_lux(st);
    s.end_pts = settle_grid_points(st);
    s.end_tier = settle_tier(st);
    // Wick's topic, if Wick exists at all. `npc_topic` is pure -- it reads and
    // returns, it does not credit or mark met.
    s.wick_topic = -2;
    let sto: object = server_npcs(sv2);
    if (sto != null) {
        if (npc_present(sto, NPC_WICK) == 1) {
            s.wick_topic = npc_topic(sto, st, NPC_WICK, server_tick_now(sv2));
        }
    }
    let out: object = s;
    return out;
}

// ---------------------------------------------------------------------------
//  MAIN
// ---------------------------------------------------------------------------
fn main() {
    let i: i32 = 1;
    while (i < args.length) {
        let a: string = args[i];
        if (a == "--seeds" && i + 1 < args.length) { i++; g_SEEDS = i32(f64(args[i])); }
        else if (a == "--minutes" && i + 1 < args.length) { i++; g_MINUTES = i32(f64(args[i])); }
        i++;
    }

    print("");
    print("=============================================================");
    print("  probe_teach — can a player who is told nothing learn it?");
    print("=============================================================");
    print(`  compiled ${compiled()}   seeds ${g_SEEDS}   minutes ${g_MINUTES}`);
    print("");

    // =======================================================================
    //  A.  THE PROMPT AND THE VERB ARE ONE BOOLEAN
    // -----------------------------------------------------------------------
    //  `sv_ui_tick` calls `teach_plant_ready` to decide whether BTN_USE plants
    //  a post; `main.hml`'s `teach_ready()` calls it to decide whether to SAY
    //  so. This section pins the truth table both of them run on. It is the
    //  section to sabotage: invert any one of the five refusals in a scratch
    //  copy and this goes red AND section B's Village stops arriving.
    // =======================================================================
    print("A. THE PROMPT AND THE VERB ARE ONE BOOLEAN");
    // Every call below is standing still, outside the reach, past the first
    // post (`0, 1, 0.0`), so the only thing under test is the refusal named.
    ck(teach_plant_ready(1, 0, -1, UI_PANEL_NONE, 0, 0, 1, 0.0) == 1,
       "a kit, nothing in reach, nobody there, no panel, alive -> the verb is offered");
    ck(teach_plant_ready(0, 0, -1, UI_PANEL_NONE, 0, 0, 1, 0.0) == 0,
       "an empty pack is never offered the verb");
    ck(teach_plant_ready(4, 1, -1, UI_PANEL_NONE, 0, 0, 1, 0.0) == 0,
       "a lantern in reach OUTRANKS the post in your pack (sv_ui_tick's order)");
    ck(teach_plant_ready(4, 0, NPC_WICK, UI_PANEL_NONE, 0, 0, 1, 0.0) == 0,
       "a villager in reach OUTRANKS the post in your pack");
    ck(teach_plant_ready(4, 0, -1, UI_PANEL_CHAR, 0, 0, 1, 0.0) == 0,
       "a modal panel eats the key entirely");
    ck(teach_plant_ready(4, 0, -1, UI_PANEL_NONE, 1, 0, 1, 0.0) == 0,
       "a corpse presses nothing");
    ck(teach_ring_show(1, 0) == 1 && teach_ring_show(0, 0) == 0 &&
       teach_ring_show(1, 1) == 0,
       "the Great Lantern shows its reach while you carry a wick, and not otherwise");
    ck(teach_verdict(1) == TEACH_V_INSIDE && teach_verdict(0) == TEACH_V_OUTSIDE,
       "the verdict is the wire's `set_inside` and nothing else");
    print("");

    // =======================================================================
    //  A1.  THE EIGHT STATES, PINNED
    // -----------------------------------------------------------------------
    //  Gate 9's enumeration, as a table this file owns. The expected column is
    //  the DESIGN, written out once so that changing the design means changing
    //  a row here and saying so, rather than changing a `||` in the HUD and
    //  finding out from a player.
    //
    //    inside the reach              -> yes, moving or not. It is the place
    //                                     where planting is the right answer.
    //    your first post, ever         -> yes, moving or not. The verb is
    //                                     still being taught.
    //    otherwise                     -> only standing still.
    // =======================================================================
    print("A1. THE EIGHT STATES OF THE NEW CLAUSE, PINNED");
    print("     state                                  expect  got");
    let a1_bad: i32 = 0;
    for (let st8 = 0; st8 < 8; st8++) {
        let mv: f64 = 0.0;
        if ((st8 & 1) != 0) { mv = 5.6; }         // a dead run
        let ins: i32 = 0;
        if ((st8 & 2) != 0) { ins = 1; }
        let plc: i32 = 0;
        if ((st8 & 4) != 0) { plc = 3; }
        // THE DESIGN, restated independently of the implementation -- if this
        // expression is just a copy of `teach_plant_ready`'s body the row
        // proves nothing, so it is written the way the paragraph above reads.
        let want: i32 = 0;
        if (ins == 1) { want = 1; }
        else if (plc == 0) { want = 1; }
        else if (mv < SV_PLANT_STILL_MS) { want = 1; }
        let got: i32 = teach_plant_ready(2, 0, -1, UI_PANEL_NONE, 0, ins, plc, mv);
        print(`     ${pi(st8, 1)}  ${padr(pt_state_name(st8), 34)}  ${want}       ${got}`);
        ck(got == want,
           `state ${st8} (${pt_state_name(st8)}): the verb should be ${want}, the shared predicate says ${got}`);
        if (got != want) { a1_bad = 1; }
    }
    ck(teach_plant_ready(2, 0, -1, UI_PANEL_NONE, 0, 0, 3, 5.6) == 0,
       "and state 5 -- MOVING, outside, past your first post -- is the one gate 9 caught, and it is a NO");
    print("");

    // =======================================================================
    //  B.  ARM BLIND — THE WHOLE POINT
    // =======================================================================
    print("B. ARM BLIND — a lamplighter who is allowed to read only the screen");
    print("     seed  path at  kits  ready at  reach at  crossed  posts  in/out  agree  village at   core     pts");
    let promoted: i32 = 0;
    let agreed_all: i32 = 1;
    let seeds_run: i32 = 0;
    let s0: i32 = 0;
    while (s0 < g_SEEDS) {
        let seed: i32 = 1337;
        if (s0 == 1) { seed = 2; }
        if (s0 == 2) { seed = 7; }
        if (s0 == 3) { seed = 91; }
        if (s0 > 3) { seed = 1000 + s0; }
        let r: object = run_seed(seed, ARM_BLIND, g_MINUTES);
        seeds_run = seeds_run + 1;
        pt_fold(r);

        let pt: string = "-"; if (r.path_tick > 0) { pt = mmss(r.path_tick - r.t0); }
        let rt: string = "-"; if (r.ready_tick > 0) { rt = mmss(r.ready_tick - r.t0); }
        let gt: string = "-"; if (r.ring_tick > 0) { gt = mmss(r.ring_tick - r.t0); }
        let xt: string = "-"; if (r.cross_tick > 0) { xt = mmss(r.cross_tick - r.t0); }
        let vt: string = "-"; if (r.vill_tick > 0) { vt = mmss(r.vill_tick - r.t0); }
        print("  " + pi(seed, 7) + padl(pt, 9) + pi(r.path_kits, 6) +
              padl(rt, 10) + padl(gt, 10) + padl(xt, 9) + pi(r.planted, 7) +
              padl(sv(r.v_in) + "/" + sv(r.v_out), 8) + pi(r.agree, 7) +
              padl(vt, 12) + pi(r.end_core, 8) + pi(r.end_pts, 8));

        // ---- per-seed assertions (PT_PER_SEED of them) -------------------
        ck(r.path_tick > 0, `seed ${seed}: the opening reaches SV_BEAT_PATH`);
        ck(r.path_kits == SV_OPEN_KITS,
           `seed ${seed}: the beat that hands you the verb hands you ${SV_OPEN_KITS} kits; pack read ${r.path_kits}`);
        ck(r.ready_tick > 0 && r.ready_tick >= r.path_tick,
           `seed ${seed}: the plant prompt goes live, and not before the kits arrive`);
        ck(r.ring_tick > 0 && r.ring_tick >= r.path_tick,
           `seed ${seed}: the Great Lantern's reach becomes showable on the same beat`);
        ck(r.cross_tick > 0,
           `seed ${seed}: a player following the compass diamond crosses into the reach`);
        ck(r.planted >= 4,
           `seed ${seed}: four posts go into the ground with nothing but the screen to go on; got ${r.planted}`);
        ck(r.disagree == 0,
           `seed ${seed}: the HUD's verdict equals the authority's on all ${r.planted} plants; ${r.disagree} disagreed`);
        ck(r.v_out == 0,
           `seed ${seed}: a player who obeys the reach readout never wastes a post; ${r.v_out} landed outside`);
        ck(r.end_tier >= SET_TIER_VILLAGE,
           `seed ${seed}: the town promotes to VILLAGE on screen information alone; tier ${r.end_tier}`);

        if (r.end_tier >= SET_TIER_VILLAGE) { promoted = promoted + 1; }
        if (r.disagree != 0) { agreed_all = 0; }

        // ---- section E, folded in: the reach the HUD draws is the real one
        if (s0 == 0) {
            let ring: f64 = settle_ring_m(SET_TIER_CAMP);
            print("");
            print("E. THE REACH THE HUD DRAWS IS THE REACH THE SETTLEMENT USES");
            print(`     settle_ring_m(CAMP) = ${f1(ring)} m   (the tier the player plants at)`);
            print(`     furthest the wire ever said INSIDE  : ${f1(r.edge_lo)} m`);
            print(`     nearest  the wire ever said OUTSIDE : ${f1(r.edge_hi)} m`);
            ck(r.edge_lo <= ring + 0.001,
               `nothing inside the reach was further out than the ring: ${f1(r.edge_lo)} vs ${f1(ring)}`);
            ck(r.edge_hi >= ring - 0.001 || r.edge_hi > 1.0e29,
               `nothing outside the reach was nearer than the ring: ${f1(r.edge_hi)} vs ${f1(ring)}`);
            ck(ring == SET_RING_CAMP_M,
               `and at CAMP that ring is the 64 m every design document names: ${f1(ring)}`);
            g_seed0 = r;
            print("");
            print("B (continued)");
        }
        s0++;
    }
    print("");

    // =======================================================================
    //  C/D.  THE CONTROL — A PLAYER WHO IGNORES THE READOUT
    // -----------------------------------------------------------------------
    //  Same machine, same shipping combat driver, same number of kits; the ONE
    //  difference is that it never walks home. If the two arms produced the
    //  same verdicts or the same town, the signal on screen would be decoration.
    // =======================================================================
    print("D. THE CONTROL — the same lamplighter who plants where he stands");
    let c: object = run_seed(1337, ARM_OUTSIDE, g_MINUTES);
    pt_fold(c);
    print(`     posts ${c.planted}   verdicts ${c.v_in} inside / ${c.v_out} outside   agree ${c.agree}   tier ${c.end_tier}   core ${c.end_core}   pts ${c.end_pts}`);
    ck(c.planted >= 2,
       `the control arm did plant posts: ${c.planted}`);
    ck(c.v_in == 0,
       `every one of them was OUTSIDE the reach: ${c.v_in} inside`);
    ck(c.disagree == 0,
       `the HUD verdict matched the authority on all of them too: ${c.disagree} disagreed`);
    ck(c.end_tier < SET_TIER_VILLAGE,
       `and the town did NOT promote: tier ${c.end_tier}, core ${c.end_core}/${SET_CORE_VILLAGE}, pts ${c.end_pts}/${SET_PTS_VILLAGE}`);
    ck(c.end_core < SET_CORE_VILLAGE,
       `the difference is real and it is CORE_LUX: ${c.end_core} against the ${SET_CORE_VILLAGE} a Village needs`);
    print("");

    // =======================================================================
    //  A2.  EVERY PRESS OF E IN EVERY SESSION, AND WHAT IT COST
    // -----------------------------------------------------------------------
    //  §A1 pins the predicate. This pins the GAME: for every rising edge of
    //  BTN_USE either arm produced, on the real wire, with no fixture -- was
    //  the prompt up, and did a lantern kit leave the pack? Those two columns
    //  are the whole task. Before this wave, state 5 read `rd 0  sp N`, which
    //  is a resource spent with nothing on screen; the naive player found it by
    //  playing and gate 9 found it by enumerating.
    //
    //  ARM OUTSIDE jabs E at a dead run on purpose (`PT_MOVE_PRESS_AT`), which
    //  is how state 5 gets sampled at all -- ARM BLIND obeys the prompt and so
    //  can never reach it.
    //
    //  WHAT THIS SECTION CANNOT SAY, before anyone quotes it: states 3 and 7
    //  (MOVING, INSIDE the reach) are not visited by either arm and the table
    //  will print zeros for them. Both are states the predicate answers YES to,
    //  so neither can produce the failure this section guards -- a spend with
    //  the prompt down needs the prompt DOWN. They are covered by §A1's unit
    //  table and by nothing else, and that is stated rather than papered over.
    // =======================================================================
    print("A2. EVERY PRESS OF E, ON THE REAL WIRE, AND WHAT IT COST");
    print("     state                                  presses  prompt up  kit spent");
    let a2_seen5: i32 = 0;
    for (let i = 0; i < 8; i++) {
        print(`     ${pi(i, 1)}  ${padr(pt_state_name(i), 34)}  ${pi(g_ap[i], 7)}  ${pi(g_ar[i], 9)}  ${pi(g_as[i], 9)}`);
        if (i == 5 && g_ap[i] > 0) { a2_seen5 = 1; }
    }
    print(`     spent with the prompt DOWN: ${g_silent}      prompt up and nothing spent: ${g_promised}`);
    print("     (the second number is explicable — SV_KIT_MIN_GAP_M refuses a post");
    print("      within 12 m of another and the client cannot see that coming — so it");
    print("      is counted and printed, not asserted. The first cannot be explained.)");
    ck(g_silent == 0,
       `no press ever spent a lantern kit while the prompt was down: ${g_silent} did`);
    ck(a2_seen5 == 1,
       `and the state gate 9 named was actually REACHED, ${g_ap[5]} times, so this section can fail`);
    print("");

    // =======================================================================
    //  A3.  THE DRAW SITE IS A BARE CALL, AND A PROBE CAN SEE THAT
    // -----------------------------------------------------------------------
    //  §A2 catches the server drifting away from the predicate. It CANNOT catch
    //  the HUD drifting, because nothing headless can draw a HUD: `main.hml`
    //  needs a window, so this file cannot import it and there is no boolean to
    //  ask. And the HUD is precisely where the bug was -- `plant_show` was
    //  `teach_ready() && (speed < 0.6 || inside || grant_t > 0)`.
    //
    //  So this section reads the source. It is a blunt instrument and it is the
    //  RIGHT blunt instrument: the defect is a textual one -- a term appended
    //  to a shared predicate at one draw site -- and the only alternative is to
    //  trust a comment. If `main.hml` is not where this expects it (a probe run
    //  from another directory), the check SAYS SO and fails rather than quietly
    //  passing, because a guard that disables itself when it cannot find its
    //  subject is worse than no guard.
    // =======================================================================
    print("A3. THE HUD DRAWS THE PROMPT OFF THE PREDICATE AND NOTHING ELSE");
    let mp: string = "src/game/main.hml";
    if (!exists(mp)) { mp = "../src/game/main.hml"; }
    let a3_ok: i32 = 0;
    let a3_why: string = `cannot find src/game/main.hml from here (tried "src/game/main.hml" and "../src/game/main.hml") — run this probe from the repo root`;
    if (exists(mp)) {
        let src: string = read_file(mp);
        // The one line that decides whether the sentence is drawn.
        let want: string = "let plant_show: i32 = teach_ready();";
        if (src.contains(want)) {
            a3_ok = 1;
            a3_why = `"${want}" — no term appended`;
        } else {
            a3_why = `the plant-prompt gate in ${mp} is no longer the bare call "${want}". If a term was added, add it to teach_plant_ready instead — that is the whole point of §A1 and §A2.`;
        }
    }
    print(`     ${a3_why}`);
    ck(a3_ok == 1, a3_why);
    print("");

    // =======================================================================
    //  F.  WICK, AND THE GAP DIALOGUE CANNOT CLOSE
    // -----------------------------------------------------------------------
    //  >>> THE FOUR ASSERTIONS BELOW ARE A UNIT TEST OF THE TOPIC LADDER AND
    //      I AM LABELLING THEM ONE. <<<  The two SESSIONS they read were earned
    //      with no fixture; the last two calls -- `npc_pack_grant` and
    //      `npc_talk` -- reach into `src/sim/npc.hml` to construct a state a
    //      real 30-minute session CANNOT REACH, and that impossibility is the
    //      finding, not a probe defect:
    //
    //        - Wick arrives at SET_TIER_VILLAGE (`g_npc_arrive[NPC_WICK]`), so
    //          he does not exist until the town the player is building already
    //          exists. He cannot teach the FIRST ring. Asserted on the control
    //          run, which stays a Camp.
    //        - by the time he does exist the pack is empty, and THE_HOUR_2 §2.2
    //          measured that a fifth kit needs either a SECOND completed hold
    //          (which never completes on any seed) or regard 192 (the hour ends
    //          at 15). So "Wick, holding a kit" is a state the shipping game
    //          does not currently produce.
    //
    //      The line is written, correct, and reachable the day the supply is.
    //      Shipping it and saying so beats shipping it and implying it works.
    // =======================================================================
    print("F. WICK, AND THE GAP DIALOGUE CANNOT CLOSE");
    let cs: object = server_npcs(c.sv);
    let wick_at_camp: i32 = npc_present(cs, NPC_WICK);
    print(`     at CAMP (the control run, tier ${c.end_tier}): Wick present = ${wick_at_camp}`);
    ck(wick_at_camp == 0,
       "Wick does not exist at CAMP, so dialogue CANNOT teach the first ring");

    let bs: object = server_npcs(g_seed0.sv);
    let bst: object = server_settle(g_seed0.sv);
    let wick_at_vill: i32 = npc_present(bs, NPC_WICK);
    print(`     at VILLAGE (seed 1337, earned): Wick present = ${wick_at_vill}, pack kits = ${client_pack_kits(g_seed0.cl)}`);
    ck(wick_at_vill == 1,
       "he does exist at VILLAGE, so the channel is real for the SECOND ring");
    ck(client_pack_kits(g_seed0.cl) == 0,
       `...and the pack is empty when he arrives: ${client_pack_kits(g_seed0.cl)} kits`);

    // ---- THE UNIT TEST. Construct the state the session cannot. ------------
    npc_pack_grant(bs, NPC_OFF_KIT, 1);
    npc_talk(bs, bst, NPC_WICK, server_tick_now(g_seed0.sv));   // marks `met`
    let wt: i32 = npc_topic(bs, bst, NPC_WICK, server_tick_now(g_seed0.sv));
    let wa: i32 = npc_topic_arg(bs, bst, NPC_WICK, server_tick_now(g_seed0.sv));
    print(`     UNIT: met Wick, one kit in the pack -> topic ${wt} arg ${wa}  (NPC_T_KIT = ${NPC_T_KIT}, ring ${i32(settle_ring_m(settle_tier_ever(bst)))} m)`);
    ck(wt == NPC_T_KIT && wa == i32(settle_ring_m(settle_tier_ever(bst))),
       `the line fires and names the CURRENT ring: topic ${wt}, arg ${wa}`);
    print("");

    // =======================================================================
    //  T.  THE TUTORIAL NOBODY SEES
    // -----------------------------------------------------------------------
    //  `docs/design/NAIVE_PLAYER_2.md` §0.1, first paragraph, before any number:
    //
    //      "The game prints its entire tutorial to stdout at boot. ~40 lines
    //       ... I read it before I looked at the screen. So I CANNOT HONESTLY
    //       ANSWER 'how long until you understood what the game wanted'. I
    //       knew. The fact that the tutorial lives in a terminal a
    //       double-clicking player never sees is probably why Gate 9 wrote
    //       'the beacon YOU ARE TOLD to walk to'."
    //
    //  Two gates and two naive players have now read the manual before playing.
    //  The walkthrough is deleted and its content is on the screen; this
    //  section is the part of that a headless probe can hold to account.
    //
    //  >>> WHAT §T CAN AND CANNOT SAY, before anyone quotes it. <<<  It runs
    //  the PREDICATES the HUD draws off, which is sufficiency, not legibility --
    //  the same limit §G already declares for §B. It cannot see a pixel. The
    //  screenshots are in the task report and they are the other half.
    // =======================================================================
    print("T. THE TUTORIAL NOBODY SEES");

    // ---- T1. THE COMPASS MARK'S TWO STATES ------------------------------
    //  The defect, measured, §3c:
    //
    //                            panned during the wake    never touched the mouse
    //    lantern found           NEVER, in 112 s           prompt at 11.9 s
    //
    //  "When the target goes off-compass the marker clamps to the edge of the
    //  bar and sits there, reading as STUCK rather than KEEP TURNING."
    //
    //  THE PROPERTY IS NOT "off is set past 27 degrees" -- that would be a copy
    //  of the implementation and would pass no matter what the number was. It
    //  is: THE MARK SHOUTS EXACTLY WHEN IT IS LYING ABOUT WHERE THE TARGET IS.
    //  If the diamond is at the target's true bearing, silence is correct. If
    //  it has been pinned somewhere the target is not, the player must be told,
    //  or the pin is indistinguishable from arrival. Sweeping the whole circle
    //  means a threshold moved in one function and not the other is red here
    //  whichever way it moved.
    print("  T1. the compass mark shouts exactly when it is lying about the bearing");
    let t1_bad: i32 = 0;
    let t1_sign: i32 = 0;
    let t1_pin: i32 = 0;
    let t1_flip: i32 = 0;
    let t1_prev: i32 = 9;
    for (let k = 0; k < 721; k++) {
        let rel: f64 = (f64(k) / 720.0 - 0.5) * 6.283185307179586;
        let truth: f64 = rel * TEACH_BAR_PX_PER_RAD;
        let px: f64 = teach_mark_px(rel);
        let off: i32 = teach_mark_off(rel);
        let lying: i32 = 0;
        if (pt_abs(px - truth) > 0.0001) { lying = 1; }
        let shouting: i32 = 0;
        if (off != 0) { shouting = 1; }
        if (lying != shouting) { t1_bad = t1_bad + 1; }
        // The sign it shouts must be the short way round, which for a bearing
        // already wrapped to +-pi is simply its own sign.
        if (off > 0 && rel <= 0.0) { t1_sign = t1_sign + 1; }
        if (off < 0 && rel >= 0.0) { t1_sign = t1_sign + 1; }
        // And when it is pinned it is pinned at the END of the bar, not
        // somewhere arbitrary -- a mark that stopped 6 px short would read as a
        // target 4 degrees inboard of where it is.
        if (off != 0 && pt_abs(pt_abs(px) - TEACH_BAR_HALF_PX) > 0.0001) {
            t1_pin = t1_pin + 1;
        }
        if (t1_prev != 9 && off != t1_prev) { t1_flip = t1_flip + 1; }
        t1_prev = off;
    }
    print(`      721 bearings over the whole circle: ${t1_bad} where the mark was pinned and silent (or moving and shouting)`);
    print(`      the bar's half-span is ${f1(TEACH_BAR_HALF_PX / TEACH_BAR_PX_PER_RAD / 0.017453292519943295)} degrees, and the state changes ${t1_flip} times round the circle (must be 2)`);
    ck(t1_bad == 0,
       `the compass mark shouts exactly when it is pinned: ${t1_bad} of 721 bearings disagreed`);
    ck(t1_sign == 0,
       `and it shouts in the direction the target actually is: ${t1_sign} bearings sent the player the wrong way`);
    ck(t1_pin == 0 && t1_flip == 2,
       `pinned means pinned AT THE END, and there are exactly two boundaries: ${t1_pin} bad pins, ${t1_flip} boundaries`);

    // ---- T2. THE PROMPT SURVIVES BEING RUN PAST -------------------------
    //  §3c: "At sprint speed the prompt is on screen for under 1.1 s. Measured:
    //  absent at 11.56 s, present at 11.94 s, absent again at 12.68 s. I ran
    //  clean through the tutorial lantern and out the far side TWICE, and the
    //  game never mentioned it again."
    //
    //  Driven here as a straight run THROUGH the post at `g_SPEED_SPRINT`, at
    //  the sim's own tick, counting the ticks each band was live. The OLD
    //  figure is computed from `CL_PROMPT_M` -- the real constant, imported,
    //  not a copy -- so if anyone ever "fixes" this by widening that radius
    //  instead, the improvement here collapses to 1.0x and this section says so.
    print("  T2. how long the lantern's words are on screen while you sprint through them");
    let t2_old: i32 = 0;
    let t2_new: i32 = 0;
    let t2_reach: i32 = 0;
    let t2_lie: i32 = 0;
    // >>> THIS COUNTER WAS WRONG THE FIRST TIME AND IT FAILED THE PROBE, WHICH
    //     IS WHY IT IS WRITTEN OUT. <<<  The first version counted every FALLING
    //     edge and asserted 0, so it reddened on the band correctly going out at
    //     the far end of an 80 s run -- the detector, not the feature.
    //     Contiguity is a statement about RISING edges: the words must come up
    //     ONCE on the approach and stay up until the post is behind you. A
    //     flicker is a second rise.
    let t2_rise: i32 = 0;
    let t2_was: i32 = 0;
    let n_t2: i32 = 4800;        // 80 s of ticks, 560 m of running
    for (let k = 0; k < n_t2; k++) {
        // Straight through: 40 m of approach, the post, 40 m the far side.
        let d: f64 = pt_abs(40.0 - g_SPEED_SPRINT * f64(k) / 60.0);
        // `client_prompt`'s own rule, from `client.hml`'s own constant.
        let pr: i32 = 0;
        if (d <= CL_PROMPT_M) { pr = 1; }
        if (pr == 1) { t2_old = t2_old + 1; }
        let b: i32 = teach_lantern_band(0, pr, 0, UI_PANEL_NONE, 1, NPC_NONE, d);
        if (b != TEACH_BAND_NONE) { t2_new = t2_new + 1; }
        if (b == TEACH_BAND_REACH) { t2_reach = t2_reach + 1; }
        // >>> THE RULE THIS PROJECT LEARNED AT THE PLANT PROMPT. <<< The words
        // that name a key may appear ONLY where the key works. REACH is
        // `client_prompt` and nothing else, at every distance.
        if (b == TEACH_BAND_REACH && pr == 0) { t2_lie = t2_lie + 1; }
        if (b != TEACH_BAND_REACH && pr == 1) { t2_lie = t2_lie + 1; }
        // Continuity: once the words are up on the approach they must not blink
        // off before the far side. A plate that flickers is a plate a player at
        // 7 m/s reads as noise.
        if (b != TEACH_BAND_NONE && t2_was == 0) { t2_rise = t2_rise + 1; }
        if (b != TEACH_BAND_NONE) { t2_was = 1; } else { t2_was = 0; }
    }
    let t2_os: f64 = f64(t2_old) / 60.0;
    let t2_ns: f64 = f64(t2_new) / 60.0;
    print(`      sprint ${f1(g_SPEED_SPRINT)} m/s, straight through the post:`);
    print(`        the OLD rule (CL_PROMPT_M = ${f1(CL_PROMPT_M)} m)   ${f1(t2_os)} s on screen`);
    print(`        the band (SIGHTED to ${f1(TEACH_LANTERN_SIGHT_M)} m)      ${f1(t2_ns)} s on screen, ${f1(f64(t2_reach) / 60.0)} s of it naming the key`);
    print(`        continuity: the words came up ${t2_rise} time(s) over the whole pass (must be 1 — a flicker is a second rise)`);
    ck(t2_ns >= 5.0,
       `the lantern's words survive a sprint through them: ${f1(t2_ns)} s on screen, against the 1.10 s NAIVE_PLAYER_2 measured`);
    ck(t2_ns >= t2_os * 4.0,
       `and it is a real change, not a rounding one: ${f1(t2_ns)} s against ${f1(t2_os)} s`);
    ck(t2_lie == 0,
       `the words that name a key appeared ONLY where the key works: ${t2_lie} ticks disagreed with client_prompt`);
    ck(t2_rise == 1,
       `and they came up ONCE and stayed up until the post was behind you: ${t2_rise} rising edges`);
    // The five refusals, each in isolation.
    ck(teach_lantern_band(1, 1, 0, UI_PANEL_NONE, 1, NPC_NONE, 1.0) == TEACH_BAND_NONE &&
       teach_lantern_band(0, 1, 1, UI_PANEL_NONE, 1, NPC_NONE, 1.0) == TEACH_BAND_NONE &&
       teach_lantern_band(0, 1, 0, UI_PANEL_CHAR, 1, NPC_NONE, 1.0) == TEACH_BAND_NONE &&
       teach_lantern_band(0, 1, 0, UI_PANEL_NONE, 0, NPC_NONE, 1.0) == TEACH_BAND_NONE &&
       teach_lantern_band(0, 0, 0, UI_PANEL_NONE, 1, NPC_WICK, 8.0) == TEACH_BAND_NONE,
       "a lit lantern, a corpse, a modal panel, no control and somebody standing in front of you each silence the band");

    // ---- T3. THE HINT THAT REPLACED FORTY-FOUR LINES OF STDOUT ----------
    print("  T3. the screen names the key the controls card is behind");
    ck(teach_help_hint(0, 0, 0, UI_PANEL_NONE, 1, TEACH_BAND_NONE) == 1,
       "before you have pressed F1 and before the first lantern is lit, the screen says F1");
    ck(teach_help_hint(1, 0, 0, UI_PANEL_NONE, 1, TEACH_BAND_NONE) == 0 &&
       teach_help_hint(0, 1, 0, UI_PANEL_NONE, 1, TEACH_BAND_NONE) == 0,
       "and it retires on the first press, or when the opening pays off, whichever comes first");
    ck(teach_help_hint(0, 0, 1, UI_PANEL_NONE, 1, TEACH_BAND_NONE) == 0 &&
       teach_help_hint(0, 0, 0, UI_PANEL_CHAR, 1, TEACH_BAND_NONE) == 0 &&
       teach_help_hint(0, 0, 0, UI_PANEL_NONE, 0, TEACH_BAND_NONE) == 0 &&
       teach_help_hint(0, 0, 0, UI_PANEL_NONE, 1, TEACH_BAND_REACH) == 0 &&
       teach_help_hint(0, 0, 0, UI_PANEL_NONE, 1, TEACH_BAND_SIGHTED) == 1,
       "never over a corpse, a modal panel, a cutscene or an INSTRUCTION -- but a NAME is not an instruction");

    // ---- T4. THE WICK BREATHES AND THE SCENERY DOES NOT -----------------
    //  §5, the low point: "Standing at the base of a big lit-looking post,
    //  crosshair on it, holding E, nothing happening, health 100 -> 46. Wrong
    //  object; no way to know."
    print("  T4. the one interactive object in the opening moves, and nothing else does");
    let t4_lo: f64 = 9.0e9;
    let t4_hi: f64 = 0.0 - 9.0e9;
    let t4_alo: i32 = 9999;
    let t4_ahi: i32 = 0;
    let t4_period: f64 = 1.0 / TEACH_WICK_HZ;
    for (let k = 0; k < 240; k++) {
        let t: f64 = f64(k) / 240.0 * t4_period;
        let w: f64 = teach_wick01(t);
        if (w < t4_lo) { t4_lo = w; }
        if (w > t4_hi) { t4_hi = w; }
        let a: i32 = teach_wick_alpha(t);
        if (a < t4_alo) { t4_alo = a; }
        if (a > t4_ahi) { t4_ahi = a; }
    }
    print(`      over one ${f1(t4_period)} s period: phase ${f1(t4_lo)}..${f1(t4_hi)}, alpha ${t4_alo}..${t4_ahi}, swing ${f1(f64(t4_ahi) / f64(t4_alo))}x`);
    ck(t4_lo < 0.01 && t4_hi > 0.99,
       `the wick completes a whole breath inside one period: ${f1(t4_lo)}..${f1(t4_hi)}`);
    ck(f64(t4_ahi) >= f64(t4_alo) * 2.0 &&
       t4_alo >= i32(TEACH_WICK_A_LO) - 1 && t4_ahi <= i32(TEACH_WICK_A_HI) + 1,
       `and the swing is one a player can see at distance without the wick lying about being lit: ${t4_alo}..${t4_ahi} of 255`);
    ck(teach_wick_size(0.0) > 0.0 && teach_wick_size(t4_period * 0.25) > teach_wick_size(t4_period * 0.75),
       "the card grows and shrinks with it, so the signal survives an fx alpha the fog has attenuated");

    // ---- T5. THE WALKTHROUGH IS GONE, AND THE DRAW SITES ARE BARE CALLS --
    //  Same instrument and same declared bluntness as §A3: this reads
    //  `src/game/main.hml` as TEXT, because nothing headless can draw a HUD and
    //  the defect this guards is a textual one. It fails loudly rather than
    //  skipping if it cannot find the file.
    //
    //  IT IS A TRIPWIRE, NOT A PROOF. It cannot tell you the card is legible or
    //  that the sentences are good. What it CAN do is fail the day somebody
    //  puts the tutorial back in the terminal, or appends a term to a shared
    //  predicate at a draw site -- which is the exact defect §A3 exists for and
    //  the exact defect that cost this project a naive-player run.
    print("  T5. the boot walkthrough is deleted and the HUD draws off the predicates");
    let tp: string = "src/game/main.hml";
    if (!exists(tp)) { tp = "../src/game/main.hml"; }
    let t5_gone: i32 = 0;
    let t5_card: i32 = 0;
    let t5_bare: i32 = 0;
    let t5_why: string = "cannot find src/game/main.hml from here — run this probe from the repo root";
    if (exists(tp)) {
        let src2: string = read_file(tp);
        // The three lines the ~40-line boot dump was made of. Matched WITH
        // their `print(` so this cannot be reddened by the comment in
        // `controls_print` that explains why they are gone.
        let w1: string = "print(\"   THE FIRST SIXTY SECONDS\");";
        let w2: string = "print(\"   AFTER THAT\");";
        let w3: string = "print(\"   MOVE      W A S D           SPRINT    hold SHIFT\");";
        if (!src2.contains(w1) && !src2.contains(w2) && !src2.contains(w3)) { t5_gone = 1; }
        // ...and it is on the screen instead.
        if (src2.contains("fn hud_help(") && src2.contains("SC_F1")) { t5_card = 1; }
        // The three draw sites, each a bare call on the shared predicate. Any
        // `&&` appended here is the bug §A3 was written for, wearing a new hat.
        let d1: string = "used = used + hud_compass_mark(";
        let d2: string = "let lan_band: i32 = teach_lantern_band(";
        let d3: string = "teach_help_hint(g_help_seen,";
        if (src2.contains(d1) && src2.contains(d2) && src2.contains(d3)) { t5_bare = 1; }
        t5_why = `boot walkthrough gone ${t5_gone}, controls card on screen ${t5_card}, draw sites bare ${t5_bare}`;
    }
    print(`      ${t5_why}`);
    ck(t5_gone == 1,
       `the boot no longer prints the first sixty seconds to a terminal: ${t5_why}`);
    ck(t5_card == 1,
       `the keybinds are drawn by main.hml and bound to F1: ${t5_why}`);
    ck(t5_bare == 1,
       `the compass mark, the lantern band and the F1 hint all draw off the shared predicates: ${t5_why}`);
    print("");

    // =======================================================================
    //  G.  THE HEADLINE
    // =======================================================================
    print("G. THE HEADLINE");
    print(`     ${promoted} of ${seeds_run} seeds reached VILLAGE reading ONLY what the HUD shows.`);
    ck(promoted == seeds_run,
       `every seed promoted on screen information alone: ${promoted} of ${seeds_run}`);
    ck(agreed_all == 1,
       "the picture and the authority never disagreed about a single post");
    print("");
    print("     WHAT THIS PROBE CANNOT SAY, stated so nobody quotes it wrongly:");
    print("     - it measures SUFFICIENCY, not LEGIBILITY. It proves the numbers");
    print("       a player needs are now on the wire and on the HUD; it cannot");
    print("       prove a human notices a 5x5 diamond change colour at 320x180.");
    print("       That half is screenshots and eyes, in the task report.");
    print("     - Wick's line cannot teach the FIRST ring. g_npc_arrive[WICK] is");
    print("       SET_TIER_VILLAGE, so he does not exist until the town the");
    print("       player is trying to build already exists. Section F above.");
    print("     - it says nothing about whether the ring of embers is PRETTY.");
    print("");

    let expect: i32 = PT_FIXED + PT_PER_SEED * seeds_run;
    print("=============================================================");
    print(`  ASSERTIONS  ran ${g_n}  pass ${g_ok}  fail ${g_n - g_ok}   expected ${expect}`);
    print("=============================================================");
    if (g_n != expect) {
        print(`FAIL: ran ${g_n} assertions, expected ${expect}`);
        exit(1);
    }
    if (g_ok != g_n) { exit(1); }
    exit(0);
}

main();
