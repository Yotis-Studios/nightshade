// tools/probe_village.hml — W6-6.  THE VILLAGE TIER, ASSERTED.
//
//   hemlockc -O1 tools/probe_village.hml -o /tmp/pv && /tmp/pv
//
// No SDL, no renderer, no wall clock: `nm /tmp/pv | grep -c SDL_` is 0.
//
// ---------------------------------------------------------------------------
// WHAT THIS FILE IS FOR, AND WHY IT IS NOT PART OF probe_weapons
// ---------------------------------------------------------------------------
// `probe_weapons.hml` pins the SIX GDD §2.4 rows against a printed table: it
// answers "did anybody retune the Sparrow behind my back".  There is no printed
// table for DIRECTION.md §3's village tier — the four numbers-per-column were
// designed in W6-6 — so pinning them against themselves would prove nothing.
//
// This probe asserts the DESIGN CLAIMS instead: the ORDERINGS that make the
// village tier read as primitive beside the city guns, and the two behaviours
// (the stripper clip and the bolt cycle) that are the whole reason a
// bolt-action is not just a slow marksman rifle.  An ordering survives a
// retune; a literal does not.  Where a literal IS the design — 45 RPM inside
// DIRECTION's stated 40-50 band, a 5-round magazine — it is written here as a
// literal on purpose, and the comment says which document it came from.
//
// It also guards the ID SPACE, which is the thing that actually broke when the
// gun table widened: `sim.hml` swaps the held gun to `command.weapon_sel` every
// single tick, so guns, melee and spells overlapping by one id is not a naming
// clash, it is a weapon swap the player did not ask for.

import { exit } from "@stdlib/process";

import { g_TICK_DT, g_WPN_COUNT, g_SPELL_ITEM_BASE, g_SPELL_COUNT,
         g_WPN_SPARROW, g_WPN_TINKER, g_WPN_BELLOWS, g_WPN_LONGSHADOW,
         g_WPN_KESTREL, g_WPN_EMBERLANCE, g_WPN_BLACKTHORN, g_WPN_NETTLE
       } from "../src/core/config.hml";

import { CMD_MAX_WEAPON } from "../src/sim/command.hml";

import { WPN_COUNT, WPN_SPARROW, WPN_TINKER, WPN_BELLOWS, WPN_LONGSHADOW,
         WPN_KESTREL, WPN_EMBERLANCE, WPN_BLACKTHORN, WPN_NETTLE,
         WPN_TIER_VILLAGE, WPN_TIER_CITY, WPN_VILLAGE_COUNT,
         wpn_valid, wpn_tier, wpn_is_village, wpn_village_id, wpn_village_index,
         wpn_dmg_at, wpn_dmg_hit, wpn_dmg_shot, wpn_rpm, wpn_shot_interval,
         wpn_mag, wpn_reserve, wpn_reload_time, wpn_is_shell_reload,
         wpn_ads_time, wpn_sprint_to_fire, wpn_swap_in, wpn_swap_out,
         wpn_spread, wpn_jitter, wpn_recover, wpn_max_range,
         wpn_pattern_len, wpn_recoil_v, wpn_recoil_rand, wpn_ttk_shots,
         wpn_resettle_s, wpn_resettle_left,
         wpn_state_new, wpn_state_reset, wpn_step, wpn_fire, wpn_can_fire,
         wpn_cur, wpn_ammo, wpn_reserve_ammo, wpn_reload_begin,
         WS_ADS, WS_MAG0, WS_RES0, WS_FIELDS,
         MH_MELEE_BASE, MEL_COUNT, mel_to_mainhand, mel_from_mainhand
       } from "../src/sim/weapons.hml";

import { rng_new, rng_seed, RNG_SPREAD } from "../src/sim/rng.hml";

import { stats_demand_of_weapon, SK_DEMAND_MELEE } from "../src/sim/stats.hml";

import { NPC_VW_BOLT, NPC_VW_REVOLVER, NPC_VW_PUMP, NPC_VW_PIPESMG,
         NPC_VW_COUNT, npc_vw_weapon } from "../src/sim/npc.hml";

// ---------------------------------------------------------------------------
// EXPECTED ASSERTION COUNT.  Bump it deliberately, never to make red go green.
// ---------------------------------------------------------------------------
let g_expect_asserts = 91;

let g_asserts = 0;
let g_pass = 0;
let g_fail = 0;

fn ck(p_ok: bool, p_what: string, p_got: string) {
    g_asserts = g_asserts + 1;
    if (p_ok) {
        g_pass = g_pass + 1;
    } else {
        g_fail = g_fail + 1;
        print(`  FAIL  ${p_what}  --  ${p_got}`);
    }
}

fn s3(p_v: f64): string {
    let v: f64 = p_v;
    let n: i32 = i32(v * 1000.0 + 0.5);
    if (v < 0.0) { n = 0 - i32(0.0 - v * 1000.0 + 0.5); }
    return `${f64(n) / 1000.0}`;
}

// GAME_DESIGN §2.2's HP column, typed here rather than imported: this probe
// asserts that a Husk dies to one Blackthorn round, and reading the Husk's hit
// points out of the same module the claim is about would make it circular.
let HP_WISP: f64   = 15.0;
let HP_MOTE: f64   = 30.0;
let HP_HUSK: f64   = 90.0;
let HP_WARDEN: f64 = 220.0;

// ===========================================================================
// A.  THE TABLE IS EIGHT WIDE AND THE TIER COLUMN SAYS WHICH IS WHICH
// ===========================================================================
fn section_tier() {
    print("");
    print("A  the tier column — DIRECTION.md §3's ladder as a number");

    ck(WPN_COUNT == 8, "A1 eight weapons", `${WPN_COUNT}`);
    ck(WPN_COUNT == g_WPN_COUNT, "A2 weapons.hml and config.hml agree",
       `${WPN_COUNT} vs ${g_WPN_COUNT}`);
    ck(WPN_BLACKTHORN == g_WPN_BLACKTHORN && WPN_BLACKTHORN == 6,
       "A3 the Blackthorn is id 6, both sides", `${WPN_BLACKTHORN}`);
    ck(WPN_NETTLE == g_WPN_NETTLE && WPN_NETTLE == 7,
       "A4 the Nettle is id 7, both sides", `${WPN_NETTLE}`);

    // THE SIX ORIGINAL IDS DID NOT MOVE.  Everything downstream — save files,
    // the loot relic bijection, the offer table's MFG arg — is indexed by them.
    ck(WPN_SPARROW == 0 && WPN_TINKER == 1 && WPN_BELLOWS == 2
       && WPN_LONGSHADOW == 3 && WPN_KESTREL == 4 && WPN_EMBERLANCE == 5,
       "A5 no original weapon id moved", "");

    // >>> THE RECLASSIFICATION. <<<  DIRECTION.md §3's village row is
    // "bolt-action rifle, revolver, pump shotgun, crude pipe-SMG" and its city
    // row is "Sparrow AR, Tinker SMG, the LMG".  The Bellows IS the pump and
    // the Kestrel IS the revolver; neither is named in the city row.  So they
    // are village tier and there is no second revolver in the game.
    ck(wpn_tier(WPN_KESTREL) == WPN_TIER_VILLAGE,
       "A6 the Kestrel is the VILLAGE revolver, reclassified not duplicated", "");
    ck(wpn_tier(WPN_BELLOWS) == WPN_TIER_VILLAGE,
       "A7 the Bellows is the VILLAGE pump shotgun", "");
    ck(wpn_tier(WPN_BLACKTHORN) == WPN_TIER_VILLAGE, "A8 the Blackthorn is village", "");
    ck(wpn_tier(WPN_NETTLE) == WPN_TIER_VILLAGE, "A9 the Nettle is village", "");
    ck(wpn_tier(WPN_SPARROW) == WPN_TIER_CITY
       && wpn_tier(WPN_TINKER) == WPN_TIER_CITY
       && wpn_tier(WPN_LONGSHADOW) == WPN_TIER_CITY
       && wpn_tier(WPN_EMBERLANCE) == WPN_TIER_CITY,
       "A10 the other four are city", "");

    let nv: i32 = 0;
    let w: i32 = 0;
    while (w < WPN_COUNT) {
        nv = nv + wpn_is_village(w);
        w = w + 1;
    }
    ck(nv == 4, "A11 exactly four of the eight are village tier", `${nv}`);
    ck(wpn_tier(-1) == -1 && wpn_tier(8) == -1, "A12 a bad id has no tier", "");

    // The ordered mapping npc.hml's NPC_VW_* constants promised to become.
    ck(WPN_VILLAGE_COUNT == 4 && WPN_VILLAGE_COUNT == NPC_VW_COUNT,
       "A13 four village ordinals, both files", "");
    ck(wpn_village_id(NPC_VW_BOLT) == WPN_BLACKTHORN,
       "A14 ordinal 0 (bolt-action) -> Blackthorn", `${wpn_village_id(0)}`);
    ck(wpn_village_id(NPC_VW_REVOLVER) == WPN_KESTREL,
       "A15 ordinal 1 (revolver) -> Kestrel", `${wpn_village_id(1)}`);
    ck(wpn_village_id(NPC_VW_PUMP) == WPN_BELLOWS,
       "A16 ordinal 2 (pump) -> Bellows", `${wpn_village_id(2)}`);
    ck(wpn_village_id(NPC_VW_PIPESMG) == WPN_NETTLE,
       "A17 ordinal 3 (pipe-SMG) -> Nettle", `${wpn_village_id(3)}`);
    ck(wpn_village_id(-1) == -1 && wpn_village_id(4) == -1,
       "A18 a bad ordinal is -1, never a gun", "");

    // Round-trip, and every ordinal that npc.hml can put in an offer row's arg
    // column resolves to a real, village-tier weapon.
    let i: i32 = 0;
    let rt: i32 = 1;
    let all_v: i32 = 1;
    while (i < NPC_VW_COUNT) {
        let wid: i32 = npc_vw_weapon(i);
        if (wpn_valid(wid) == 0) { all_v = 0; }
        if (wpn_is_village(wid) == 0) { all_v = 0; }
        if (wpn_village_index(wid) != i) { rt = 0; }
        i = i + 1;
    }
    ck(all_v == 1, "A19 every NPC_VW_* ordinal is a real village weapon", "");
    ck(rt == 1, "A20 id -> ordinal -> id round-trips", "");
    ck(wpn_village_index(WPN_SPARROW) == -1,
       "A21 a city gun has no village index", "");
}

// ===========================================================================
// B.  THE BLACKTHORN IS A BOLT-ACTION, NOT A SLOW MARKSMAN RIFLE
// ===========================================================================
fn section_bolt() {
    print("");
    print("B  the Blackthorn — DIRECTION.md §3, 'the rhythm is the point'");

    let b: i32 = WPN_BLACKTHORN;
    let ls: i32 = WPN_LONGSHADOW;

    // DIRECTION.md §3, verbatim: "~40-50 RPM, a 5-round internal magazine,
    // stripper-clip reloads, and enough damage that one good shot matters."
    // Three of those four are literals here because the OWNER wrote them.
    ck(wpn_rpm(b) >= 40.0 && wpn_rpm(b) <= 50.0,
       "B1 RPM is inside DIRECTION §3's stated 40-50 band", s3(wpn_rpm(b)));
    ck(wpn_mag(b) == 5, "B2 a 5-round internal magazine", `${wpn_mag(b)}`);
    ck(wpn_is_shell_reload(b) == 0,
       "B3 a stripper clip is not a shell-at-a-time reload", "");

    // The shot interval lands exactly on a tick boundary at 60 Hz, so the
    // rhythm the player learns is the rhythm the sim gives them.
    let ticks: f64 = wpn_shot_interval(b) / g_TICK_DT;
    ck(ticks == 80.0, "B4 1.3333 s between shots is EXACTLY 80 ticks", s3(ticks));

    // "enough damage that one good shot matters" — measured against the enemy
    // the whole first act is made of.
    ck(wpn_ttk_shots(b, HP_HUSK, 0.0, 0) == 1,
       ">>> B5 ONE BODY SHOT KILLS A HUSK <<<",
       `${wpn_ttk_shots(b, HP_HUSK, 0.0, 0)} shots`);
    ck(wpn_ttk_shots(ls, HP_HUSK, 0.0, 0) == 2,
       "B6 ...and the city marksman rifle still takes two — they are not the same gun",
       `${wpn_ttk_shots(ls, HP_HUSK, 0.0, 0)} shots`);
    ck(wpn_ttk_shots(b, HP_WISP, 0.0, 0) == 1 && wpn_ttk_shots(b, HP_MOTE, 0.0, 0) == 1,
       "B7 and it one-shots the swarm tier", "");
    ck(wpn_ttk_shots(b, HP_WARDEN, 0.0, 0) > 1,
       "B8 but not a Warden — one good shot is not every shot", "");

    // ...and the Longshadow keeps the job it was for.  Sustained precision DPS
    // on a big target is still the city gun's, because it cycles at 75 RPM.
    let ttk_b: f64 = f64(wpn_ttk_shots(b, HP_WARDEN, 0.0, 0) - 1) * wpn_shot_interval(b);
    let ttk_l: f64 = f64(wpn_ttk_shots(ls, HP_WARDEN, 0.0, 0) - 1) * wpn_shot_interval(ls);
    print(`   Warden body TTK: Blackthorn ${s3(ttk_b)} s, Longshadow ${s3(ttk_l)} s`);
    ck(ttk_l < ttk_b,
       ">>> B9 THE LONGSHADOW STILL WINS ON A BIG TARGET — the bolt-action did not obsolete it <<<",
       `${s3(ttk_l)} vs ${s3(ttk_b)}`);

    // >>> THE STRIPPER CLIP. <<<  The empty reload is FASTER than the tactical
    // one, and it is the ONLY row in the table that way round.  That is the
    // physical fact a player can learn and then exploit: shoot it dry.
    ck(wpn_reload_time(b, 1) < wpn_reload_time(b, 0),
       ">>> B10 THE EMPTY RELOAD IS FASTER THAN THE TACTICAL ONE (a stripper clip) <<<",
       `${s3(wpn_reload_time(b, 1))} empty vs ${s3(wpn_reload_time(b, 0))} partial`);
    let others_normal: i32 = 1;
    let w: i32 = 0;
    while (w < WPN_COUNT) {
        if (w != WPN_BLACKTHORN) {
            if (wpn_reload_time(w, 1) < wpn_reload_time(w, 0)) { others_normal = 0; }
        }
        w = w + 1;
    }
    ck(others_normal == 1,
       "B11 ...and it is the ONLY weapon that way round — the rule is legible because it is unique", "");

    // Primitive means WORSE TO HANDLE than the city instrument that does the
    // same job, in every column, without exception.
    ck(wpn_ads_time(b) > wpn_ads_time(ls), "B12 slower to aim than the Longshadow",
       `${s3(wpn_ads_time(b))} vs ${s3(wpn_ads_time(ls))}`);
    ck(wpn_swap_in(b) > wpn_swap_in(ls), "B13 slower to raise", "");
    ck(wpn_sprint_to_fire(b) > wpn_sprint_to_fire(ls), "B14 slower off a sprint", "");
    ck(wpn_rpm(b) < wpn_rpm(ls), "B15 slower to cycle", "");
    ck(wpn_recover(b) < wpn_recover(ls), "B16 slower to settle after a shot", "");

    // ...and the slowest of all EIGHT in the columns that carry the weight.
    let slowest_ads: i32 = 1;
    let slowest_raise: i32 = 1;
    let biggest_kick: i32 = 1;
    let slowest_recover: i32 = 1;
    let slowest_rpm: i32 = 1;
    let w2: i32 = 0;
    while (w2 < WPN_COUNT) {
        if (w2 != WPN_BLACKTHORN) {
            if (wpn_ads_time(w2) >= wpn_ads_time(b)) { slowest_ads = 0; }
            if (wpn_swap_in(w2) >= wpn_swap_in(b)) { slowest_raise = 0; }
            if (wpn_recoil_v(w2, 0) >= wpn_recoil_v(b, 0)) { biggest_kick = 0; }
            if (wpn_recover(w2) <= wpn_recover(b)) { slowest_recover = 0; }
            // ...except the Emberlance, at 40 RPM.  It is a lobbed fire
            // blast that DIRECTION.md §2 says belongs on the spell side (and
            // already exists there as g_SPELL_EMBERLANCE); among the seven guns
            // that are actually guns, the bolt-action is the slowest.
            if (w2 != WPN_EMBERLANCE) {
                if (wpn_rpm(w2) <= wpn_rpm(b)) { slowest_rpm = 0; }
            }
        }
        w2 = w2 + 1;
    }
    ck(slowest_ads == 1, "B17 the slowest ADS in the game", s3(wpn_ads_time(b)));
    ck(slowest_raise == 1, "B18 the slowest to raise in the game", s3(wpn_swap_in(b)));
    ck(slowest_recover == 1, "B19 the slowest recoil recovery in the game", s3(wpn_recover(b)));
    ck(slowest_rpm == 1,
       "B20 the slowest rate of fire of any gun but the Emberlance (a lobbed fire blast)",
       `${s3(wpn_rpm(b))} vs Emberlance ${s3(wpn_rpm(WPN_EMBERLANCE))}`);
    ck(biggest_kick == 1, "B21 the largest single kick in the game", s3(wpn_recoil_v(b, 0)));

    // ART_BIBLE §8.5 caps the viewmodel punch at 4 deg of screen pitch with a
    // 3.5..5.0 band (`probe_viewmodel`).  `view.hml` scales kick_v by 1.6, so
    // the WEAPON has a ceiling and it is asserted here, at the source, rather
    // than only where it is felt.  3.40 was tried first and broke it.
    ck(wpn_recoil_v(b, 0) * 1.6 < 5.0,
       ">>> B22 THE KICK STAYS UNDER ART_BIBLE 8.5's VIEWMODEL PITCH CEILING <<<",
       `${s3(wpn_recoil_v(b, 0) * 1.6)} deg of screen pitch`);

    // Forgiving on ammunition — DIRECTION §3's own word for the village tier.
    ck(wpn_reserve(b) >= 40, "B23 forty rounds in reserve — eight stripper clips",
       `${wpn_reserve(b)}`);
}

// ===========================================================================
// C.  THE BOLT CYCLE — the number that used to be read by nothing
// ===========================================================================
fn section_cycle() {
    print("");
    print("C  the bolt cycle actually holds the sights off target");

    // Before W6-6, `g_wpn_resettle` was written by `wpn_fire`, decremented by
    // `wpn_step`, and READ BY NOTHING — grep for WS_SETTLE_T across src/ and
    // tools/ returned weapons.hml alone.  So this section is behavioural: it
    // drives the state machine and looks at the ADS fraction, rather than
    // reading the column back out of the table it came from.
    ck(wpn_resettle_s(WPN_BLACKTHORN) > wpn_resettle_s(WPN_LONGSHADOW),
       "C1 the bolt cycle is longer than the Longshadow's re-settle",
       `${s3(wpn_resettle_s(WPN_BLACKTHORN))} vs ${s3(wpn_resettle_s(WPN_LONGSHADOW))}`);

    let st = wpn_state_new(1);
    let rng = rng_new();
    let out = [0.0, 0.0];

    // Hold ADS until it is fully in, with no shot fired.
    wpn_state_reset(st, 0, WPN_BLACKTHORN);
    let t: i32 = 0;
    while (t < 60) { wpn_step(st, 0, 1, 0); t = t + 1; }
    ck(st[WS_ADS] == 1.0, "C2 holding ADS reaches a full sight picture", `${st[WS_ADS]}`);

    // Fire one round.  The bolt has to be worked: the ADS fraction must FALL
    // while the re-settle runs even though the button is still held.
    rng_seed(rng, 7, RNG_SPREAD, 0, 1);
    ck(wpn_fire(st, 0, rng, out) == 1, "C3 the shot goes off", "");
    ck(wpn_resettle_left(st, 0) > 0.0, "C4 and it puts the bolt cycle on the clock",
       s3(wpn_resettle_left(st, 0)));

    let lowest: f64 = 1.0;
    let t2: i32 = 0;
    while (t2 < 33) {                       // 0.55 s of cycle = 33 ticks
        wpn_step(st, 0, 1, 0);              // ADS STILL HELD, all the way
        if (st[WS_ADS] < lowest) { lowest = st[WS_ADS]; }
        t2 = t2 + 1;
    }
    print(`   ADS fell to ${s3(lowest)} across the 0.55 s cycle with the button held`);
    ck(lowest < 0.5,
       ">>> C5 THE SIGHT PICTURE IS LOST WHILE THE BOLT IS WORKED — THE RHYTHM IS REAL <<<",
       s3(lowest));

    // ...and it comes back on its own once the cycle is done.
    let t3: i32 = 0;
    while (t3 < 40) { wpn_step(st, 0, 1, 0); t3 = t3 + 1; }
    ck(st[WS_ADS] == 1.0, "C6 and it re-acquires once the bolt is closed", `${st[WS_ADS]}`);

    // A weapon with NO re-settle is untouched by any of this.  The Sparrow's
    // ADS must not so much as flicker when it fires.
    wpn_state_reset(st, 0, WPN_SPARROW);
    let t4: i32 = 0;
    while (t4 < 60) { wpn_step(st, 0, 1, 0); t4 = t4 + 1; }
    rng_seed(rng, 7, RNG_SPREAD, 1, 1);
    wpn_fire(st, 0, rng, out);
    let flick: i32 = 0;
    let t5: i32 = 0;
    while (t5 < 30) {
        wpn_step(st, 0, 1, 0);
        if (st[WS_ADS] < 1.0) { flick = 1; }
        t5 = t5 + 1;
    }
    ck(flick == 0,
       "C7 a weapon with no re-settle column is completely unaffected", "");
}

// ===========================================================================
// D.  THE NETTLE IS A PANIC BUTTON
// ===========================================================================
fn section_nettle() {
    print("");
    print("D  the Nettle — crude, inaccurate, cheap");

    let n: i32 = WPN_NETTLE;
    let tk: i32 = WPN_TINKER;

    // Worst hipfire cone in the game, both rested and bloomed out.
    let worst_base: i32 = 1;
    let worst_cap: i32 = 1;
    let most_jitter: i32 = 1;
    let most_reserve: i32 = 1;
    let fastest_raise: i32 = 1;
    let w: i32 = 0;
    while (w < WPN_COUNT) {
        if (w != WPN_NETTLE) {
            if (wpn_spread(w, 0.0, 0.0) >= wpn_spread(n, 0.0, 0.0)) { worst_base = 0; }
            if (wpn_spread(w, 999.0, 0.0) >= wpn_spread(n, 999.0, 0.0)) { worst_cap = 0; }
            if (wpn_jitter(w) >= wpn_jitter(n)) { most_jitter = 0; }
            if (wpn_is_village(w) == 1) {
                if (wpn_reserve(w) >= wpn_reserve(n)) { most_reserve = 0; }
            }
            // ...except the Kestrel, which is a SIDEARM.  A revolver clearing
            // a holster faster than a shoulder weapon comes up is correct, and
            // a probe that demanded otherwise would be asking for a wrong game.
            if (w != WPN_KESTREL) {
                if (wpn_swap_in(w) <= wpn_swap_in(n)) { fastest_raise = 0; }
            }
        }
        w = w + 1;
    }
    // >>> D1 IS A PAIR COMPARISON AND NOT A SUPERLATIVE, DELIBERATELY. <<<
    // "the widest rested hipfire cone in the game" was the first version and it
    // is FALSE twice over: the Longshadow is 9.0 (a marksman rifle nobody
    // hipfires) and the Bellows is 6.5 (a fixed shot pattern, which is its
    // ammunition rather than its inaccuracy).  A superlative that needs three
    // carve-outs is not a superlative, so this compares the Nettle with the
    // thing it is actually the primitive version OF.  `worst_base` is still
    // computed and printed so the whole column stays visible.
    print(`   rested hipfire cones: Nettle ${s3(wpn_spread(n, 0.0, 0.0))}, Tinker ${s3(wpn_spread(tk, 0.0, 0.0))}, Bellows ${s3(wpn_spread(WPN_BELLOWS, 0.0, 0.0))}, Longshadow ${s3(wpn_spread(WPN_LONGSHADOW, 0.0, 0.0))} (widest-of-all ${worst_base})`);
    ck(wpn_spread(n, 0.0, 0.0) > wpn_spread(tk, 0.0, 0.0) * 1.5,
       "D1 over 1.5x the rested hipfire cone of the machine-made SMG it stands beside",
       `${s3(wpn_spread(n, 0.0, 0.0))} vs ${s3(wpn_spread(tk, 0.0, 0.0))}`);
    ck(worst_cap == 1, "D2 ...and the widest bloomed-out cone",
       s3(wpn_spread(n, 999.0, 0.0)));
    ck(most_jitter == 1, "D3 the largest horizontal jitter in the game", s3(wpn_jitter(n)));
    ck(wpn_jitter(n) > wpn_jitter(tk) * 2.0,
       "D4 ...by more than 2x over the machine-made SMG it stands beside",
       `${s3(wpn_jitter(n))} vs ${s3(wpn_jitter(tk))}`);

    // >>> AIMING A PIPE WITH NO SIGHTS ON IT BARELY HELPS. <<<  That is what
    // makes it a hipfire panic button rather than a bad Tinker: the correct
    // play is never to aim, and the numbers say so instead of a tooltip.
    //
    // MEASURED AS WHAT ADS LEAVES BEHIND, NOT AS HOW MUCH IT REMOVES.  The
    // first version of this check compared the ABSOLUTE narrowing and failed:
    // the Nettle's cone shrinks by 4.00 deg against the Tinker's 3.45, because
    // it starts so much wider.  Absolute narrowing rewards a bad gun for being
    // bad.  The number that decides whether aiming is worth 0.26 s is the
    // FRACTION OF THE CONE STILL THERE when you are fully aimed.
    let keep_n: f64 = wpn_spread(n, 0.0, 1.0) / wpn_spread(n, 0.0, 0.0);
    let keep_t: f64 = wpn_spread(tk, 0.0, 1.0) / wpn_spread(tk, 0.0, 0.0);
    print(`   fully aimed, the cone still holds ${s3(keep_n * 100.0)} % (Nettle) vs ${s3(keep_t * 100.0)} % (Tinker)`);
    ck(keep_n > keep_t * 2.0,
       ">>> D5 AIMED, THE NETTLE KEEPS OVER TWICE THE CONE FRACTION THE TINKER DOES <<<",
       `${s3(keep_n)} vs ${s3(keep_t)}`);
    ck(wpn_spread(n, 0.0, 1.0) > wpn_spread(tk, 0.0, 1.0) * 3.0,
       "D6 its aimed cone is over 3x the Tinker's", s3(wpn_spread(n, 0.0, 1.0)));

    // Forgiving on ammunition, and it is the extreme case of it.
    // DIRECTION.md §3: the village tier is "forgiving on ammunition".  The
    // Nettle is the extreme case — a hand-welded pipe gun carries within 7 % of
    // the reserve the FACTORY SMG does, because village brass is the plentiful
    // kind and city brass is the privilege.
    ck(most_reserve == 1, "D7 the largest reserve of any village weapon",
       `${wpn_reserve(n)}`);
    ck(f64(wpn_reserve(n)) > f64(wpn_reserve(tk)) * 0.9,
       "D7b ...within 10 % of the manufactured SMG's, despite being a welded pipe",
       `${wpn_reserve(n)} vs ${wpn_reserve(tk)}`);
    ck(fastest_raise == 1,
       "D8 the fastest SHOULDER weapon to bring up — the panic button",
       `${s3(wpn_swap_in(n))} vs the Kestrel sidearm's ${s3(wpn_swap_in(WPN_KESTREL))}`);

    // The pattern is per-magazine, exactly like the Sparrow's and the Tinker's.
    ck(wpn_pattern_len(n) == wpn_mag(n),
       "D9 the recoil pattern is exactly one magazine long",
       `${wpn_pattern_len(n)} entries, ${wpn_mag(n)} rounds`);

    // >>> AND IT STOPS BEING LEARNABLE HALFWAY THROUGH. <<<  The first entries
    // are deterministic (rc_r == 0, so the horizontal kick is fixed); the tail
    // is random.  That is the design claim and it is a property of the table,
    // not a description of it.
    ck(wpn_recoil_rand(n, 0) == 0.0 && wpn_recoil_rand(n, 3) == 0.0,
       "D10 the first four rounds are DETERMINISTIC — these four are yours", "");
    ck(wpn_recoil_rand(n, 23) > 0.0,
       ">>> D11 ...AND THE LAST ONES ARE NOT — past the twelfth round, let go <<<",
       s3(wpn_recoil_rand(n, 23)));
    ck(wpn_recoil_rand(WPN_SPARROW, 3) == 0.0 && wpn_recoil_rand(WPN_TINKER, 20) == 0.0,
       "D12 the two MACHINE-MADE automatics have no such tail — their whole column is learnable", "");

    // Genuinely good, not a joke.  Contact-range single-target DPS beats the
    // revolver it replaces in a panic.
    let dps_n: f64 = wpn_dmg_at(n, 0.0) * wpn_rpm(n) / 60.0;
    let dps_k: f64 = wpn_dmg_at(WPN_KESTREL, 0.0) * wpn_rpm(WPN_KESTREL) / 60.0;
    let dps_t: f64 = wpn_dmg_at(tk, 0.0) * wpn_rpm(tk) / 60.0;
    print(`   contact DPS: Nettle ${s3(dps_n)}, Kestrel ${s3(dps_k)}, Tinker ${s3(dps_t)}`);
    ck(dps_n > dps_k, "D13 it out-damages the revolver at contact range", "");
    ck(dps_n < dps_t, "D14 ...and the manufactured SMG still beats it", "");
    ck(wpn_max_range(n) < wpn_max_range(tk),
       "D15 and it runs out of range far sooner", "");
}

// ===========================================================================
// E.  THE EXISTING SIX ARE UNTOUCHED
// ===========================================================================
fn section_regression() {
    print("");
    print("E  the six city-tier rows did not move");

    // A spot TTK matrix over the four enemy tiers, pinned to literals computed
    // from the GDD table that shipped before W6-6.  `probe_weapons` pins every
    // column of all six; this is the belt to its braces, because "do not break
    // the measured TTK tables" was the task's own hard constraint.
    ck(wpn_ttk_shots(WPN_SPARROW, HP_HUSK, 0.0, 0) == 4, "E1 Sparrow / Husk = 4",
       `${wpn_ttk_shots(WPN_SPARROW, HP_HUSK, 0.0, 0)}`);
    ck(wpn_ttk_shots(WPN_TINKER, HP_HUSK, 0.0, 0) == 5, "E2 Tinker / Husk = 5",
       `${wpn_ttk_shots(WPN_TINKER, HP_HUSK, 0.0, 0)}`);
    ck(wpn_ttk_shots(WPN_BELLOWS, HP_HUSK, 0.0, 0) == 1,
       "E3 the Bellows STILL one-shots a Husk inside 6 m — the reason to play Ashwood",
       `${wpn_ttk_shots(WPN_BELLOWS, HP_HUSK, 0.0, 0)}`);
    ck(wpn_ttk_shots(WPN_KESTREL, HP_HUSK, 0.0, 0) == 2, "E4 Kestrel / Husk = 2",
       `${wpn_ttk_shots(WPN_KESTREL, HP_HUSK, 0.0, 0)}`);
    ck(wpn_ttk_shots(WPN_LONGSHADOW, HP_WARDEN, 0.0, 1) == 2,
       "E5 Longshadow / Warden head = 2",
       `${wpn_ttk_shots(WPN_LONGSHADOW, HP_WARDEN, 0.0, 1)}`);
    ck(wpn_dmg_shot(WPN_BELLOWS, 0.0, 0) == 117.0,
       "E6 nine pellets of 13 is still 117", s3(wpn_dmg_shot(WPN_BELLOWS, 0.0, 0)));
    ck(wpn_dmg_at(WPN_LONGSHADOW, 100.0) == 68.0,
       "E7 the D2 falloff amendment survived", s3(wpn_dmg_at(WPN_LONGSHADOW, 100.0)));

    // The magazine and reserve arrays widened by two.  A fresh state must hand
    // the eight of them the eight right numbers, not the six right ones and
    // two zeroes read out of the old reserve block.
    let st = wpn_state_new(2);
    ck(WS_RES0 == WS_MAG0 + 8 && WS_FIELDS == WS_RES0 + 8,
       "E8 the state record is 16 + 8 magazines + 8 reserves",
       `MAG0 ${WS_MAG0} RES0 ${WS_RES0} FIELDS ${WS_FIELDS}`);
    let ok_m: i32 = 1;
    let ok_r: i32 = 1;
    let w: i32 = 0;
    while (w < WPN_COUNT) {
        if (wpn_ammo(st, 0, w) != wpn_mag(w)) { ok_m = 0; }
        if (wpn_reserve_ammo(st, 0, w) != wpn_reserve(w)) { ok_r = 0; }
        w = w + 1;
    }
    ck(ok_m == 1, "E9 a fresh slot has all EIGHT magazines full", "");
    ck(ok_r == 1, "E10 ...and all eight reserves", "");

    // The second slot's fields must not have been read out of the first: a
    // stride that did not move with WS_FIELDS is the classic version of this.
    let ok_s: i32 = 1;
    let w2: i32 = 0;
    while (w2 < WPN_COUNT) {
        if (wpn_ammo(st, WS_FIELDS, w2) != wpn_mag(w2)) { ok_s = 0; }
        w2 = w2 + 1;
    }
    ck(ok_s == 1, "E11 and so does the SECOND slot, at the new stride", "");

    // Live-fire both new weapons through the real state machine: ammunition
    // must leave the right magazine and the reload must refill from the right
    // reserve.  An offset that is wrong by two lands on a neighbouring gun and
    // is invisible in any single-weapon test.
    let rng = rng_new();
    let out = [0.0, 0.0];
    let vw: i32 = 0;
    let live_ok: i32 = 1;
    while (vw < WPN_VILLAGE_COUNT) {
        let g: i32 = wpn_village_id(vw);
        wpn_state_reset(st, 0, g);
        let r0: i32 = wpn_reserve_ammo(st, 0, g);
        let shots: i32 = 0;
        let t: i32 = 0;
        while (t < 2000) {
            if (wpn_can_fire(st, 0) == 1) {
                rng_seed(rng, 11, RNG_SPREAD, t, 1);
                if (wpn_fire(st, 0, rng, out) == 1) { shots = shots + 1; }
            }
            wpn_step(st, 0, 0, 0);
            t = t + 1;
        }
        if (shots < 1) { live_ok = 0; }
        if (wpn_ammo(st, 0, g) != 0) { live_ok = 0; }
        // nothing else's magazine may have moved
        let k: i32 = 0;
        while (k < WPN_COUNT) {
            if (k != g) {
                if (wpn_ammo(st, 0, k) != wpn_mag(k)) { live_ok = 0; }
                if (wpn_reserve_ammo(st, 0, k) != wpn_reserve(k)) { live_ok = 0; }
            }
            k = k + 1;
        }
        if (wpn_reserve_ammo(st, 0, g) != r0) { live_ok = 0; }
        vw = vw + 1;
    }
    ck(live_ok == 1,
       ">>> E12 EACH VILLAGE GUN EMPTIES ITS OWN MAGAZINE AND NOBODY ELSE'S <<<", "");

    // ...and reloading refills from its own reserve.
    wpn_state_reset(st, 0, WPN_BLACKTHORN);
    let rng2 = rng_new();
    rng_seed(rng2, 3, RNG_SPREAD, 0, 1);
    wpn_fire(st, 0, rng2, out);
    let before: i32 = wpn_reserve_ammo(st, 0, WPN_BLACKTHORN);
    ck(wpn_reload_begin(st, 0) == 1, "E13 a partial magazine can be topped up", "");
    let t6: i32 = 0;
    while (t6 < 400) { wpn_step(st, 0, 0, 0); t6 = t6 + 1; }
    ck(wpn_ammo(st, 0, WPN_BLACKTHORN) == wpn_mag(WPN_BLACKTHORN)
       && wpn_reserve_ammo(st, 0, WPN_BLACKTHORN) == before - 1,
       "E14 ...and exactly one round came out of ITS reserve",
       `mag ${wpn_ammo(st, 0, WPN_BLACKTHORN)}, reserve ${before} -> ${wpn_reserve_ammo(st, 0, WPN_BLACKTHORN)}`);
}

// ===========================================================================
// F.  THE MAIN-HAND ID SPACE — the thing that actually broke
// ===========================================================================
fn section_idspace() {
    print("");
    print("F  the main-hand id space: guns 0..7, melee 8..10, spells 11..17");

    // `sim.hml` does `if (want != wpn_cur(...)) wpn_swap_begin(st, o, want)`
    // with `want = command.weapon_sel`, EVERY TICK.  So an overlap between
    // these three ranges is a live weapon swap, not a naming collision.
    ck(MH_MELEE_BASE == WPN_COUNT,
       "F1 melee starts exactly where the guns stop", `${MH_MELEE_BASE}`);
    ck(g_SPELL_ITEM_BASE == MH_MELEE_BASE + MEL_COUNT,
       "F2 spells start exactly where melee stops", `${g_SPELL_ITEM_BASE}`);
    ck(g_SPELL_ITEM_BASE + g_SPELL_COUNT - 1 == CMD_MAX_WEAPON,
       "F3 the last spell lands exactly on CMD_MAX_WEAPON",
       `${g_SPELL_ITEM_BASE + g_SPELL_COUNT - 1} vs ${CMD_MAX_WEAPON}`);

    // No gun query accepts a melee or a spell id, exhaustively over the field.
    let bad: i32 = 0;
    let id: i32 = 0;
    while (id <= CMD_MAX_WEAPON) {
        let is_gun: i32 = wpn_valid(id);
        let is_mel: i32 = 0;
        if (mel_from_mainhand(id) >= 0) { is_mel = 1; }
        let is_spell: i32 = 0;
        if (id >= g_SPELL_ITEM_BASE) { is_spell = 1; }
        if (is_gun + is_mel + is_spell != 1) { bad = bad + 1; }
        id = id + 1;
    }
    ck(bad == 0,
       ">>> F4 EVERY ID 0..CMD_MAX_WEAPON BELONGS TO EXACTLY ONE OF THE THREE <<<",
       `${bad} ids belong to none or more than one`);

    // The specific collision W6-6 created and then fixed: 6 and 7 were the club
    // and the spear until this task, and `sim.hml` would have swapped a player
    // holding a club onto the Blackthorn on the next tick.
    ck(wpn_valid(6) == 1 && mel_from_mainhand(6) == -1,
       "F5 main-hand 6 is the Blackthorn and NOT the club", "");
    ck(wpn_valid(7) == 1 && mel_from_mainhand(7) == -1,
       "F6 main-hand 7 is the Nettle and NOT the spear", "");
    ck(mel_to_mainhand(0) == 8 && mel_to_mainhand(2) == 10,
       "F7 the club is 8 and the sword is 10", "");

    // DIRECTION.md §7: skill gates the EFFECTIVENESS of manufactured weapons.
    // The village tier is the rung that does not do that to you.
    let all_low: i32 = 1;
    let w: i32 = 0;
    while (w < WPN_COUNT) {
        if (wpn_is_village(w) == 1) {
            if (stats_demand_of_weapon(w) != 1) { all_low = 0; }
        }
        w = w + 1;
    }
    ck(all_low == 1,
       "F8 every village gun is low-demand — DIRECTION §3's 'forgiving'", "");
    ck(stats_demand_of_weapon(WPN_SPARROW) == 2 && stats_demand_of_weapon(WPN_TINKER) == 2,
       "F9 ...and the manufactured automatics still demand handling", "");
    ck(stats_demand_of_weapon(8) == SK_DEMAND_MELEE,
       "F10 a melee main-hand id is not accidentally a gun's demand", "");
}

// ===========================================================================
fn main() {
    print("");
    print("W6-6 VILLAGE TIER — DIRECTION.md §3's lower rung, asserted");
    section_tier();
    section_bolt();
    section_cycle();
    section_nettle();
    section_regression();
    section_idspace();

    print("");
    print(`asserts=${g_asserts} pass=${g_pass} fail=${g_fail} (expected ${g_expect_asserts})`);
    if (g_asserts != g_expect_asserts) {
        print("PROBE_VILLAGE FAIL — assertion COUNT drifted; bump it deliberately");
        exit(1);
    }
    if (g_fail != 0) {
        print("PROBE_VILLAGE FAIL");
        exit(1);
    }
    print("PROBE_VILLAGE PASS");
}

main();
