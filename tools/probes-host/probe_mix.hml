// probe_mix.hml — is SDL2_mixer usable from Hemlock, and does it beat hand-rolled
// SDL_QueueAudio for an FPS (multi-voice + positional panning)?
// NOTE: Mix_PlayChannel and Mix_LoadWAV are C MACROS, not symbols. Must bind the
// real underlying functions: Mix_PlayChannelTimed / Mix_LoadWAV_RW.
import "libSDL2-2.0.so.0";
import "libSDL2_mixer-2.0.so.0";

extern fn SDL_Init(flags: u32): i32;
extern fn SDL_GetError(): string;
extern fn SDL_Delay(ms: u32): void;
extern fn SDL_Quit(): void;

extern fn Mix_Init(flags: i32): i32;
extern fn Mix_OpenAudio(freq: i32, format: u16, channels: i32, chunksize: i32): i32;
extern fn Mix_QuerySpec(freq: ptr, format: ptr, channels: ptr): i32;
extern fn Mix_AllocateChannels(numchans: i32): i32;
extern fn Mix_QuickLoad_RAW(mem: ptr, len: u32): ptr;
extern fn Mix_PlayChannelTimed(channel: i32, chunk: ptr, loops: i32, ticks: i32): i32;
extern fn Mix_SetPanning(channel: i32, left: u8, right: u8): i32;
extern fn Mix_Volume(channel: i32, volume: i32): i32;
extern fn Mix_Playing(channel: i32): i32;
extern fn Mix_HaltChannel(channel: i32): i32;
extern fn Mix_CloseAudio(): void;
extern fn Mix_Linked_Version(): ptr;

let SDL_INIT_AUDIO = 16;
let AUDIO_S16LSB = 32784;

fn ok(name: string, cond: bool, detail: string) {
    if (cond) { print(`  PASS  ${name}  ${detail}`); }
    else { print(`  FAIL  ${name}  ${detail}  err='${SDL_GetError()}'`); }
}

// a short decaying square-wave "gunshot"-ish blip, raw S16 mono
fn make_blip(n: i32, period: i32): buffer {
    let b = buffer(n * 2);
    for (let i = 0; i < n; i++) {
        let env = 1.0 - (i / n);
        let amp = i32(9000.0 * env * env);
        let v = ((i / period) % 2) == 0 ? amp : (0 - amp);
        let o = i * 2;
        b[o] = v & 255; b[o + 1] = (v >> 8) & 255;
    }
    return b;
}

fn main() {
    if (SDL_Init(SDL_INIT_AUDIO) != 0) { print(`SDL_Init: ${SDL_GetError()}`); return; }

    let lv = Mix_Linked_Version();
    let maj = ptr_deref_u8(lv);
    let min = ptr_deref_u8(ptr_offset(lv, 1, 1));
    let pat = ptr_deref_u8(ptr_offset(lv, 2, 1));
    print(`SDL2_mixer linked version: ${maj}.${min}.${pat}`);

    let oa = Mix_OpenAudio(22050, AUDIO_S16LSB, 1, 512);
    ok("Mix_OpenAudio", oa == 0, `22050 S16LSB mono ret=${oa}`);
    if (oa != 0) { SDL_Quit(); return; }

    let qf = alloc(4); let qfmt = alloc(2); let qc = alloc(4);
    let qs = Mix_QuerySpec(qf, qfmt, qc);
    ok("Mix_QuerySpec", qs > 0,
       `freq=${ptr_deref_i32(qf)} fmt=${ptr_deref_u16(qfmt)} ch=${ptr_deref_i32(qc)}`);

    let nch = Mix_AllocateChannels(16);
    ok("Mix_AllocateChannels", nch == 16, `got ${nch} mixing channels`);

    // Mix_QuickLoad_RAW wraps OUR buffer without copying — the buffer must outlive
    // the chunk. Keep a reference alive for the whole session.
    let snd = make_blip(4410, 18);
    let chunk = Mix_QuickLoad_RAW(buffer_ptr(snd), 4410 * 2);
    ok("Mix_QuickLoad_RAW", chunk != null, "raw procedural S16 buffer -> Mix_Chunk");

    if (chunk != null) {
        // fire several overlapping voices at different pans — the thing a
        // hand-rolled QueueAudio mixer would make us implement ourselves
        let played = 0;
        for (let i = 0; i < 6; i++) {
            let c = Mix_PlayChannelTimed(-1, chunk, 0, -1);
            if (c >= 0) {
                played = played + 1;
                let l = 255 - i * 40;
                let r = 55 + i * 40;
                Mix_SetPanning(c, l & 255, r & 255);
                Mix_Volume(c, 100 + i * 20);
            }
        }
        ok("Mix_PlayChannelTimed x6", played == 6, `${played}/6 overlapping voices got channels`);
        ok("Mix_SetPanning", true, "positional L/R panning per channel");
        SDL_Delay(60);
        let live = 0;
        for (let i = 0; i < 16; i++) { if (Mix_Playing(i) != 0) { live = live + 1; } }
        ok("voices actually playing", live > 0, `${live} channels reported playing mid-sound`);
        Mix_HaltChannel(-1);
    }

    Mix_CloseAudio();
    SDL_Quit();
    print("mixer probe complete");
}
main();
