// probe_ffi_numerics.hml — how do wide integer returns survive the FFI?
//
// Motivation: SDL_GetPerformanceCounter() returns Uint64. The compiled backend
// prints FFI integer returns with a ".0" suffix, which suggests values live in
// a double. If so there is an exact-integer ceiling at 2^53 = 9007199254740992.
// This probe finds the real ceiling so the delta-time loop can be written safely.
//
// Run both:  hemlock tools/probes/probe_ffi_numerics.hml
//            hemlockc -o /tmp/p tools/probes/probe_ffi_numerics.hml && /tmp/p

import "libc.so.6";
extern fn strtoull(s: string, endptr: ptr, base: i32): u64;
extern fn strtoll(s: string, endptr: ptr, base: i32): i64;

fn probe(label: string, s: string) {
    let v = strtoull(s, null, 10);
    let ok = "EXACT";
    if (`${v}` != s) { ok = "LOSSY"; }
    print(`  ${ok}  ${label}: asked ${s} -> got ${v}`);
}

fn main() {
    print("-- u64 returns through FFI --");
    probe("small",              "1000");
    probe("~perf counter now",  "1202950931641105");   // ~13.9 days at 1 GHz
    probe("2^53 - 1",           "9007199254740991");
    probe("2^53",               "9007199254740992");
    probe("2^53 + 1",           "9007199254740993");   // first unrepresentable odd
    probe("2^53 + 3",           "9007199254740995");
    probe("100 days at 1GHz",   "8640000000000000");
    probe("110 days at 1GHz",   "9504000000000000");
    probe("u64 max",            "18446744073709551615");

    print("-- arithmetic on a perf-counter-sized value --");
    let a = strtoull("1202950931641105", null, 10);
    let b = strtoull("1202950931641145", null, 10);   // +40 ticks (40 ns)
    print(`  b - a = ${b - a}  (want 40; this is the smallest dt we must resolve)`);

    let big1 = strtoull("9007199254740992", null, 10);
    let big2 = strtoull("9007199254740993", null, 10);
    print(`  above 2^53: big2 - big1 = ${big2 - big1}  (want 1; 0 means precision is gone)`);
}

main();
