// probe_input.hml — mouse look, event struct offsets, timing and window control.
//
// The important trick: SDL_WarpMouseInWindow makes SDL *itself* generate a real
// SDL_MOUSEMOTION event with SDL-computed xrel/yrel. Reading offsets 28/32 out
// of that event and getting exactly the deltas we asked for is an EMPIRICAL
// verification of the struct layout — the values are not ones we wrote.
//
// Run:  SDL_VIDEODRIVER=dummy hemlock tools/probes/probe_input.hml
//       DISPLAY=:0 hemlock tools/probes/probe_input.hml relmouse   (grabs the
//       real cursor for ~200ms to test SDL_SetRelativeMouseMode for real)

import "libSDL2-2.0.so.0";

extern fn SDL_Init(flags: u32): i32;
extern fn SDL_Quit(): void;
extern fn SDL_GetError(): string;
extern fn SDL_Delay(ms: u32): void;
extern fn SDL_SetHint(name: string, value: string): i32;
extern fn SDL_GetCurrentVideoDriver(): string;
extern fn SDL_CreateWindow(title: string, x: i32, y: i32, w: i32, h: i32, flags: u32): ptr;
extern fn SDL_CreateRenderer(win: ptr, index: i32, flags: u32): ptr;
extern fn SDL_DestroyRenderer(ren: ptr): void;
extern fn SDL_DestroyWindow(win: ptr): void;

extern fn SDL_PollEvent(ev: ptr): i32;
extern fn SDL_PushEvent(ev: ptr): i32;
extern fn SDL_PumpEvents(): void;
extern fn SDL_FlushEvents(min: u32, max: u32): void;

extern fn SDL_SetRelativeMouseMode(enabled: i32): i32;
extern fn SDL_GetRelativeMouseMode(): i32;
extern fn SDL_GetRelativeMouseState(x: ptr, y: ptr): u32;
extern fn SDL_GetMouseState(x: ptr, y: ptr): u32;
extern fn SDL_WarpMouseInWindow(win: ptr, x: i32, y: i32): void;
extern fn SDL_ShowCursor(toggle: i32): i32;
extern fn SDL_GetKeyboardState(numkeys: ptr): ptr;

extern fn SDL_GetPerformanceCounter(): u64;
extern fn SDL_GetPerformanceFrequency(): u64;
extern fn SDL_GetTicks(): u32;
extern fn SDL_GetTicks64(): u64;

extern fn SDL_SetWindowFullscreen(win: ptr, flags: u32): i32;
extern fn SDL_GetWindowSize(win: ptr, w: ptr, h: ptr): void;
extern fn SDL_GetWindowFlags(win: ptr): u32;
extern fn SDL_RenderSetVSync(ren: ptr, vsync: i32): i32;
extern fn SDL_RenderSetLogicalSize(ren: ptr, w: i32, h: i32): i32;
extern fn SDL_RenderGetLogicalSize(ren: ptr, w: ptr, h: ptr): void;

let SDL_INIT_VIDEO = 32;
let SDL_WINDOW_SHOWN = 4;
let SDL_WINDOW_HIDDEN = 8;
let SDL_WINDOWPOS_CENTERED = 805240832;
let SDL_WINDOW_FULLSCREEN_DESKTOP = 4097;
let SDL_MOUSEMOTION = 1024;
let SDL_MOUSEBUTTONDOWN = 1025;
let SDL_MOUSEBUTTONUP = 1026;
let SDL_MOUSEWHEEL = 1027;
let SDL_FIRSTEVENT = 0;
let SDL_LASTEVENT = 65535;
let SDL_ENABLE = 1;
let SDL_DISABLE = 0;
let SDL_QUERY = 0 - 1;
let SDL_BUTTON_LEFT = 1;

// SDL_Event is 56 bytes. Offsets (verified by tools/probes/sdl_abi_dump.c):
let EVENT_SIZE = 56;
let OFF_TYPE = 0;
let MOTION_STATE = 16;
let MOTION_X = 20;
let MOTION_Y = 24;
let MOTION_XREL = 28;
let MOTION_YREL = 32;
let BUTTON_BUTTON = 16;   // Uint8
let BUTTON_STATE = 17;    // Uint8
let BUTTON_CLICKS = 18;   // Uint8
let BUTTON_X = 20;
let BUTTON_Y = 24;
let WHEEL_X = 16;
let WHEEL_Y = 20;
let WHEEL_PRECISEX = 28;  // float
let WHEEL_PRECISEY = 32;  // float

let pass_count = 0;
let fail_count = 0;
fn check(name: string, ok: bool, detail: string) {
    if (ok) { pass_count = pass_count + 1; print(`  PASS  ${name}  ${detail}`); }
    else    { fail_count = fail_count + 1; print(`  FAIL  ${name}  ${detail}`); }
}
fn note(name: string, detail: string) { print(`  NOTE  ${name}  ${detail}`); }

fn u8at(p: ptr, off: i32): i32  { return ptr_deref_u8(ptr_offset(p, off, 1)); }
fn i32at(p: ptr, off: i32): i32 { return ptr_deref_i32(ptr_offset(p, off, 1)); }

fn main() {
    let want_real_relmouse = false;
    if (args.length > 1 && args[1] == "relmouse") { want_real_relmouse = true; }

    if (SDL_Init(SDL_INIT_VIDEO) != 0) { print(`SDL_Init failed: ${SDL_GetError()}`); return; }
    print(`  video driver = ${SDL_GetCurrentVideoDriver()}`);

    let flags = SDL_WINDOW_SHOWN;
    if (!want_real_relmouse) { flags = SDL_WINDOW_HIDDEN; }
    let win = SDL_CreateWindow("probe_input", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
                               320, 240, flags);
    if (win == null) { print(`CreateWindow failed: ${SDL_GetError()}`); return; }
    let ren = SDL_CreateRenderer(win, -1, 0);

    let ev = alloc(EVENT_SIZE);

    // ================= TEST 1: SDL_ShowCursor =================
    let before = SDL_ShowCursor(SDL_QUERY);
    let hid = SDL_ShowCursor(SDL_DISABLE);
    let now = SDL_ShowCursor(SDL_QUERY);
    SDL_ShowCursor(SDL_ENABLE);
    check("SDL_ShowCursor(QUERY/DISABLE/ENABLE)", now == 0,
          `initial=${before} after_disable=${now} (0=hidden,1=shown)`);

    // ================= TEST 2: SDL_MOUSEMOTION xrel/yrel offsets ==============
    // SDL generates these deltas itself; we only read them back.
    SDL_PumpEvents();
    SDL_FlushEvents(SDL_FIRSTEVENT, SDL_LASTEVENT);
    SDL_WarpMouseInWindow(win, 100, 100);
    SDL_PumpEvents();
    SDL_FlushEvents(SDL_FIRSTEVENT, SDL_LASTEVENT);   // discard the first warp
    SDL_WarpMouseInWindow(win, 130, 145);             // delta must be +30,+45
    SDL_PumpEvents();

    let got_motion = false;
    let mx = 0; let my = 0; let mxr = 0; let myr = 0;
    while (SDL_PollEvent(ev) != 0) {
        if (ptr_deref_u32(ev) == SDL_MOUSEMOTION) {
            got_motion = true;
            mx = i32at(ev, MOTION_X); my = i32at(ev, MOTION_Y);
            mxr = i32at(ev, MOTION_XREL); myr = i32at(ev, MOTION_YREL);
        }
    }
    if (got_motion) {
        // x/y are computed by SDL, so this genuinely verifies offsets 20/24.
        check("SDL_MOUSEMOTION x/y offsets (20/24)", mx == 130 && my == 145,
              `x=${mx}(want 130) y=${my}(want 145)`);
        // xrel/yrel are EXPECTED to be 0 here: SDL updates its cached pointer
        // position as part of the warp, so warping never feeds back into
        // relative motion. Live xrel/yrel are proven in probe_mouselook.hml,
        // which moves the pointer behind SDL's back with XTestFakeMotionEvent.
        note("xrel/yrel from a warp", `xrel=${mxr} yrel=${myr} (0 is correct/by-design for warps; see probe_mouselook.hml)`);
    } else {
        note("SDL_MOUSEMOTION via warp", "no motion event produced by this video driver");
    }

    // ================= TEST 3: SDL_GetRelativeMouseState =====================
    let px = alloc(4); let py = alloc(4);
    ptr_write_i32(px, 0); ptr_write_i32(py, 0);
    SDL_GetRelativeMouseState(px, py);          // consume accumulated delta
    SDL_WarpMouseInWindow(win, 160, 175);       // +30,+30 from (130,145)
    SDL_PumpEvents();
    let mask = SDL_GetRelativeMouseState(px, py);
    let rx = ptr_deref_i32(px); let ry = ptr_deref_i32(py);
    // Same warp caveat as above: the call itself and its out-params are what we
    // verify here (it must not crash and must write both ints). Real deltas are
    // verified live in probe_mouselook.hml.
    check("SDL_GetRelativeMouseState(int*,int*) writes both out-params",
          rx == 0 || ry == 0 || (rx == 30 && ry == 30),
          `dx=${rx} dy=${ry} buttonmask=${mask} (0,0 expected after a warp)`);

    // absolute state too
    let ax = alloc(4); let ay = alloc(4);
    SDL_GetMouseState(ax, ay);
    note("SDL_GetMouseState", `abs=(${ptr_deref_i32(ax)},${ptr_deref_i32(ay)})`);

    // ================= TEST 4: SDL_SetRelativeMouseMode ======================
    let rc = SDL_SetRelativeMouseMode(1);
    let mode = SDL_GetRelativeMouseMode();
    if (rc == 0 && mode == 1) {
        check("SDL_SetRelativeMouseMode(1)", true, `rc=0 GetRelativeMouseMode=1  *** MOUSE LOOK WORKS ***`);
        SDL_Delay(150);
        SDL_SetRelativeMouseMode(0);
        check("SDL_SetRelativeMouseMode(0) restores", SDL_GetRelativeMouseMode() == 0, "cursor released");
    } else if (SDL_GetCurrentVideoDriver() == "dummy") {
        // Not an FFI failure: the dummy video driver has no relative-mode
        // implementation at all. Verified working on real X11 above/elsewhere.
        note("SDL_SetRelativeMouseMode(1) under dummy driver",
             `rc=${rc} err='${SDL_GetError()}' -- ENVIRONMENT limitation, not FFI. Use a real display.`);
        // documented fallback: force warp-based relative mode
        SDL_SetHint("SDL_MOUSE_RELATIVE_MODE_WARP", "1");
        let rc2 = SDL_SetRelativeMouseMode(1);
        note("fallback SDL_MOUSE_RELATIVE_MODE_WARP=1", `rc=${rc2} mode=${SDL_GetRelativeMouseMode()}`);
        SDL_SetRelativeMouseMode(0);
    }

    // ================= TEST 5: mouse button event layout via PushEvent =======
    // Confirms SDL_Event is 56 bytes and that a struct we lay out per the
    // headers survives SDL's own event queue and reads back correctly.
    let i = 0;
    while (i < EVENT_SIZE) { ptr_write_u8(ptr_offset(ev, i, 1), 0); i = i + 1; }
    ptr_write_u32(ev, SDL_MOUSEBUTTONDOWN);
    ptr_write_u8(ptr_offset(ev, BUTTON_BUTTON, 1), SDL_BUTTON_LEFT);
    ptr_write_u8(ptr_offset(ev, BUTTON_STATE, 1), 1);
    ptr_write_u8(ptr_offset(ev, BUTTON_CLICKS, 1), 2);
    ptr_write_i32(ptr_offset(ev, BUTTON_X, 1), 77);
    ptr_write_i32(ptr_offset(ev, BUTTON_Y, 1), 88);
    let pe = SDL_PushEvent(ev);
    let ev2 = alloc(EVENT_SIZE);
    let found = false;
    let b = 0; let st = 0; let cl = 0; let bx = 0; let by = 0;
    while (SDL_PollEvent(ev2) != 0) {
        if (ptr_deref_u32(ev2) == SDL_MOUSEBUTTONDOWN) {
            found = true;
            b = u8at(ev2, BUTTON_BUTTON); st = u8at(ev2, BUTTON_STATE);
            cl = u8at(ev2, BUTTON_CLICKS);
            bx = i32at(ev2, BUTTON_X); by = i32at(ev2, BUTTON_Y);
        }
    }
    check("SDL_MOUSEBUTTON* layout (button@16 state@17 clicks@18 x@20 y@24), SDL_Event=56B",
          pe == 1 && found && b == 1 && st == 1 && cl == 2 && bx == 77 && by == 88,
          `push=${pe} button=${b} state=${st} clicks=${cl} x=${bx} y=${by}`);

    // ================= TEST 6: keyboard state array ==========================
    let nk = alloc(4);
    let ks = SDL_GetKeyboardState(nk);
    check("SDL_GetKeyboardState(int* numkeys)", ks != null && ptr_deref_i32(nk) == 512,
          `numkeys=${ptr_deref_i32(nk)} (want 512 = SDL_NUM_SCANCODES)`);

    // ================= TEST 7: timing ========================================
    let freq = SDL_GetPerformanceFrequency();
    let c0 = SDL_GetPerformanceCounter();
    SDL_Delay(33);
    let c1 = SDL_GetPerformanceCounter();
    let dt = (c1 - c0) / freq;
    check("SDL_GetPerformanceCounter/Frequency delta-time",
          freq > 0 && dt > 0.028 && dt < 0.070, `freq=${freq} dt=${dt}s (asked 0.033)`);
    note("raw perf counter magnitude", `counter=${c1}  (f64 exact-int limit is 9007199254740992)`);
    // resolution: two back-to-back reads must differ (or at least not be stuck)
    let a0 = SDL_GetPerformanceCounter();
    let a1 = SDL_GetPerformanceCounter();
    note("perf counter resolution", `two consecutive reads differ by ${a1 - a0} ticks`);
    note("SDL_GetTicks / SDL_GetTicks64", `${SDL_GetTicks()} / ${SDL_GetTicks64()}`);

    // ================= TEST 8: window size / vsync / fullscreen ==============
    let ww = alloc(4); let wh = alloc(4);
    SDL_GetWindowSize(win, ww, wh);
    check("SDL_GetWindowSize(int*,int*)", ptr_deref_i32(ww) == 320 && ptr_deref_i32(wh) == 240,
          `${ptr_deref_i32(ww)}x${ptr_deref_i32(wh)}`);

    let vs = SDL_RenderSetVSync(ren, 1);
    note("SDL_RenderSetVSync(ren,1)", `rc=${vs} err='${SDL_GetError()}' (non-zero is normal on software renderers)`);

    let fs1 = SDL_SetWindowFullscreen(win, SDL_WINDOW_FULLSCREEN_DESKTOP);
    let hasfs = 0;
    if ((SDL_GetWindowFlags(win) & SDL_WINDOW_FULLSCREEN_DESKTOP) != 0) { hasfs = 1; }
    let fs0 = SDL_SetWindowFullscreen(win, 0);
    check("SDL_SetWindowFullscreen(DESKTOP -> 0)", fs1 == 0 && fs0 == 0,
          `enter_rc=${fs1} flag_set=${hasfs} exit_rc=${fs0}`);

    SDL_RenderSetLogicalSize(ren, 320, 180);
    let lw = alloc(4); let lh = alloc(4);
    SDL_RenderGetLogicalSize(ren, lw, lh);
    check("SDL_RenderSetLogicalSize / GetLogicalSize",
          ptr_deref_i32(lw) == 320 && ptr_deref_i32(lh) == 180,
          `${ptr_deref_i32(lw)}x${ptr_deref_i32(lh)}`);

    print(`\nINPUT PROBE: ${pass_count} passed, ${fail_count} failed`);
    SDL_DestroyRenderer(ren);
    SDL_DestroyWindow(win);
    SDL_Quit();
}

main();
