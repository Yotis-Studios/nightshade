// probe_module.hml — smoke-test docs/recon/sdl2_reference.hml as a real import:
// a complete miniature frame loop (target -> geometry -> upscale -> HUD -> audio).
import { SDL_Init, SDL_Quit, SDL_GetError, SDL_CreateWindow, SDL_CreateRenderer,
         SDL_CreateTexture, SDL_SetRenderTarget, SDL_SetRenderDrawColor, SDL_RenderClear,
         SDL_RenderGeometry, SDL_RenderCopyEx, SDL_RenderFillRect, SDL_SetRenderDrawBlendMode,
         SDL_SetTextureScaleMode, SDL_SetTextureBlendMode, SDL_RenderReadPixels,
         SDL_GetPerformanceCounter, SDL_GetPerformanceFrequency, SDL_PollEvent,
         SDL_GetKeyboardState, SDL_DestroyTexture, SDL_DestroyRenderer, SDL_DestroyWindow,
         SDL_OpenAudioDevice, SDL_QueueAudio, SDL_PauseAudioDevice, SDL_CloseAudioDevice,
         rect, rect_set, vertex_set, held, ev_type, audiospec_new, spec_freq, spec_channels,
         perf_seconds,
         SDL_INIT_VIDEO, SDL_INIT_AUDIO, SDL_WINDOWPOS_CENTERED, SDL_WINDOW_HIDDEN,
         SDL_PIXELFORMAT_RGBA32, SDL_PIXELFORMAT_RGB24, SDL_TEXTUREACCESS_TARGET,
         SDL_BLENDMODE_NONE, SDL_BLENDMODE_BLEND, SDL_FLIP_NONE, SDL_ScaleModeNearest,
         SDL_EVENT_SIZE, SC_W, AUDIO_S16SYS, SDL_AUDIOSPEC_SIZE, SDL_AUDIO_ALLOW_ANY_CHANGE,
         SDL_VERTEX_SIZE } from "../../docs/recon/sdl2_reference.hml";

fn main() {
    SDL_Init(SDL_INIT_VIDEO + SDL_INIT_AUDIO);
    let win = SDL_CreateWindow("mod", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, 640, 360, SDL_WINDOW_HIDDEN);
    let ren = SDL_CreateRenderer(win, -1, 0);
    let scene = SDL_CreateTexture(ren, SDL_PIXELFORMAT_RGBA32, SDL_TEXTUREACCESS_TARGET, 320, 180);
    SDL_SetTextureScaleMode(scene, SDL_ScaleModeNearest);
    SDL_SetTextureBlendMode(scene, SDL_BLENDMODE_NONE);

    let verts = alloc(3 * SDL_VERTEX_SIZE);
    vertex_set(verts, 0,  10.0, 170.0, 0, 220, 0, 255, 0.0, 0.0);
    vertex_set(verts, 1, 160.0,  20.0, 0, 220, 0, 255, 0.0, 0.0);
    vertex_set(verts, 2, 310.0, 170.0, 0, 220, 0, 255, 0.0, 0.0);

    let dst = rect(0, 0, 640, 360);
    let ev = alloc(SDL_EVENT_SIZE);
    let freq = SDL_GetPerformanceFrequency();
    let ks = SDL_GetKeyboardState(null);

    // audio: open a queue-mode device and push one frame of silence
    let want = audiospec_new(44100, AUDIO_S16SYS, 2, 1024);
    let got = alloc(SDL_AUDIOSPEC_SIZE);
    let dev = SDL_OpenAudioDevice(null, 0, want, got, SDL_AUDIO_ALLOW_ANY_CHANGE);
    SDL_PauseAudioDevice(dev, 0);
    let chunk = 1764 * spec_channels(got) * 2;
    let sfx = alloc(chunk);
    let z = 0; while (z < chunk) { ptr_write_u8(ptr_offset(sfx, z, 1), 0); z = z + 1; }

    let t_prev = SDL_GetPerformanceCounter();
    let frames = 0;
    let total = 0.0;
    while (frames < 60) {
        while (SDL_PollEvent(ev) != 0) { let t = ev_type(ev); }
        let moving = held(ks, SC_W);

        SDL_SetRenderTarget(ren, scene);
        SDL_SetRenderDrawBlendMode(ren, SDL_BLENDMODE_NONE);
        SDL_SetRenderDrawColor(ren, 20, 20, 40, 255);
        SDL_RenderClear(ren);
        SDL_RenderGeometry(ren, null, verts, 3, null, 0);

        SDL_SetRenderTarget(ren, null);
        SDL_SetRenderDrawColor(ren, 0, 0, 0, 255);
        SDL_RenderClear(ren);
        rect_set(dst, frames % 5, 0, 640, 360);           // screen shake
        SDL_RenderCopyEx(ren, scene, null, dst, 0.0, null, SDL_FLIP_NONE);

        SDL_SetRenderDrawBlendMode(ren, SDL_BLENDMODE_BLEND);
        SDL_SetRenderDrawColor(ren, 0, 0, 0, 128);
        SDL_RenderFillRect(ren, rect(0, 330, 640, 30));

        SDL_QueueAudio(dev, sfx, chunk);

        let t_now = SDL_GetPerformanceCounter();
        total = total + perf_seconds(t_prev, t_now, freq);
        t_prev = t_now;
        frames = frames + 1;
    }
    let buf = alloc(640 * 360 * 3);
    SDL_RenderReadPixels(ren, null, SDL_PIXELFORMAT_RGB24, buf, 640 * 3);
    let g = ptr_deref_u8(ptr_offset(buf, (240 * 640 + 320) * 3 + 1, 1));
    print(`  frames=${frames} elapsed=${total}s avg_frame_ms=${(total / frames) * 1000.0}`);
    print(`  composited green at center = ${g} (want ~220)`);
    if (g > 200) { print("  PASS  sdl2_reference.hml drives a full frame loop as an imported module"); }
    else { print("  FAIL  unexpected framebuffer content"); }
    SDL_CloseAudioDevice(dev);
    SDL_DestroyTexture(scene); SDL_DestroyRenderer(ren); SDL_DestroyWindow(win); SDL_Quit();
}
main();
