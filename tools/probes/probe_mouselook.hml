// probe_mouselook.hml — the decisive end-to-end mouse-look test.
//
// SDL_WarpMouseInWindow deliberately produces xrel/yrel == 0 (SDL updates its
// own cached position before the motion event arrives, so warps don't feed back
// into relative motion). To prove xrel/yrel actually arrive, we must move the
// pointer BEHIND SDL's back. This probe does that with XTestFakeMotionEvent
// from libXtst: SDL sees genuine hardware-style pointer motion and computes
// real relative deltas, which we then read at SDL_MouseMotionEvent offsets
// 28 (xrel) and 32 (yrel).
//
// Requires a real X11 display. Run:
//   DISPLAY=:0 hemlock tools/probes/probe_mouselook.hml
//
// NOTE: this grabs the cursor (relative mode) for under a second.

import "libSDL2-2.0.so.0";

extern fn SDL_Init(flags: u32): i32;
extern fn SDL_Quit(): void;
extern fn SDL_GetError(): string;
extern fn SDL_Delay(ms: u32): void;
extern fn SDL_CreateWindow(title: string, x: i32, y: i32, w: i32, h: i32, flags: u32): ptr;
extern fn SDL_DestroyWindow(win: ptr): void;
extern fn SDL_RaiseWindow(win: ptr): void;
extern fn SDL_PollEvent(ev: ptr): i32;
extern fn SDL_PumpEvents(): void;
extern fn SDL_FlushEvents(min: u32, max: u32): void;
extern fn SDL_SetRelativeMouseMode(enabled: i32): i32;
extern fn SDL_GetRelativeMouseMode(): i32;
extern fn SDL_GetRelativeMouseState(x: ptr, y: ptr): u32;

import "libX11.so.6";
extern fn XOpenDisplay(name: ptr): ptr;
extern fn XCloseDisplay(dpy: ptr): i32;
extern fn XFlush(dpy: ptr): i32;
import "libXtst.so.6";
extern fn XTestFakeMotionEvent(dpy: ptr, screen: i32, x: i32, y: i32, delay: u64): i32;

let SDL_INIT_VIDEO = 32;
let SDL_WINDOW_SHOWN = 4;
let SDL_WINDOWPOS_CENTERED = 805240832;
let SDL_MOUSEMOTION = 1024;
let SDL_FIRSTEVENT = 0;
let SDL_LASTEVENT = 65535;
let EVENT_SIZE = 56;
let MOTION_XREL = 28;
let MOTION_YREL = 32;

fn main() {
    if (SDL_Init(SDL_INIT_VIDEO) != 0) { print(`SDL_Init failed: ${SDL_GetError()}`); return; }
    let win = SDL_CreateWindow("mouselook", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
                               640, 480, SDL_WINDOW_SHOWN);
    if (win == null) { print(`CreateWindow failed: ${SDL_GetError()}`); return; }
    SDL_RaiseWindow(win);
    SDL_PumpEvents();
    SDL_Delay(300);   // let the WM map + focus the window

    let rc = SDL_SetRelativeMouseMode(1);
    print(`  SDL_SetRelativeMouseMode(1) rc=${rc} mode=${SDL_GetRelativeMouseMode()} err='${SDL_GetError()}'`);
    if (rc != 0) {
        print("  FAIL  cannot enter relative mode on this display");
        SDL_DestroyWindow(win); SDL_Quit(); return;
    }

    let dpy = XOpenDisplay(null);
    if (dpy == null) { print("  FAIL  XOpenDisplay failed"); SDL_Quit(); return; }

    let ev = alloc(EVENT_SIZE);
    SDL_PumpEvents();
    SDL_FlushEvents(SDL_FIRSTEVENT, SDL_LASTEVENT);

    // Move the pointer for real, in steps, behind SDL's back.
    let sum_x = 0;
    let sum_y = 0;
    let nmotion = 0;
    let biggest_x = 0;
    let step = 0;
    while (step < 8) {
        XTestFakeMotionEvent(dpy, 0, 400 + step * 12, 400 + step * 7, 0);
        XFlush(dpy);
        SDL_Delay(20);
        SDL_PumpEvents();
        while (SDL_PollEvent(ev) != 0) {
            if (ptr_deref_u32(ev) == SDL_MOUSEMOTION) {
                let xr = ptr_deref_i32(ptr_offset(ev, MOTION_XREL, 1));
                let yr = ptr_deref_i32(ptr_offset(ev, MOTION_YREL, 1));
                nmotion = nmotion + 1;
                sum_x = sum_x + xr;
                sum_y = sum_y + yr;
                if (xr > biggest_x) { biggest_x = xr; }
            }
        }
        step = step + 1;
    }

    print(`  motion events=${nmotion}  sum_xrel=${sum_x}  sum_yrel=${sum_y}  max_xrel=${biggest_x}`);
    if (nmotion > 0 && sum_x != 0 && sum_y != 0) {
        print("  PASS  LIVE xrel/yrel delivered at offsets 28/32 in relative mode -- MOUSE LOOK IS REAL");
    } else {
        print("  FAIL  no nonzero relative motion observed");
    }

    // and the polled form
    let px = alloc(4); let py = alloc(4);
    SDL_GetRelativeMouseState(px, py);
    XTestFakeMotionEvent(dpy, 0, 700, 500, 0);
    XFlush(dpy);
    SDL_Delay(60);
    SDL_PumpEvents();
    SDL_GetRelativeMouseState(px, py);
    print(`  SDL_GetRelativeMouseState after live move: dx=${ptr_deref_i32(px)} dy=${ptr_deref_i32(py)}`);

    SDL_SetRelativeMouseMode(0);
    XCloseDisplay(dpy);
    SDL_DestroyWindow(win);
    SDL_Quit();
}

main();
