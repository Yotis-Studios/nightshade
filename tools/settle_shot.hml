// ===========================================================================
// 0.  compiled-only guard
// ===========================================================================
fn running_interpreted(): bool {
    let a: i32 = 1;
    let b: bool = false;
    try { let c: i32 = a / 0; b = false; } catch (e) { b = false; }
    let out: bool = b;
    return out;
}

let g_VERSION: string = "settle_shot 2.0 (settlement-render, 16:9)";

// ---------------------------------------------------------------------------
// >>> 2026-07-31.  THIS TOOL WAS PHOTOGRAPHING A GAME THAT DOES NOT EXIST. <<<
// ---------------------------------------------------------------------------
// It carried its OWN `g_RES_W = 320, g_RES_H = 240`, its own
// `alloc(320 * 240 * 4)` and its own `g_fov = 70.0` — three hand copies of
// constants that moved to 320x180 / 58 in the 16:9 conversion (config.hml §2).
// The frame graph never agreed with them for one frame afterwards:
// `world_render.frame_render` projects at `g_RES_W x g_RES_H` = 320x180 and
// `frame_present` reads back exactly that rectangle, so
//
//     * the render was 320x180 and correct,
//     * `framebuffer_to_rgb` then read 320x240 out of the buffer, and
//     * THE BOTTOM 60 NATIVE ROWS — a quarter of every picture — WERE A DEAD
//       BLACK BAND OF UNWRITTEN MEMORY.  Reproduced on the tree at f4644f7.
//
// The seven checked-in goldens do NOT show that band, which proves the second
// half of the same failure: they are 960x720 and predate the conversion
// entirely.  Every settlement look-review on record was made against them.
//
// This is the SAME bug class as `probe_viewmodel`'s divisor of 2.4 (= 240/100),
// which turned a viewmodel regression into an apparent improvement.  A stale
// constant in an INSTRUMENT is worse than one in the code, because the
// instrument is what you would have caught the code with.  Nothing in this file
// may name a resolution or a field of view again: both are imported.
let g_upscale: i32 = 3;              // 320x180 x3 = 960x540, exact

