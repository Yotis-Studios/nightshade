// ===========================================================================
// 1. DETERMINISM — the harness RNG and the positional hash
// ---------------------------------------------------------------------------
// xorshift64. All mixing in u64: CLAUDE.md A13 — i32/i64 * + - TRAP on
// overflow. This is the tool's own stream; src/sim/rng.hml (W2-9) is the
// simulation's, and they are deliberately separate.
// ===========================================================================

let g_rng: u64 = 88172645463325252;

fn rnd_reseed(p_seed: i32) {
    let s: u64 = u64(p_seed & 2147483647);
    let x: u64 = s * 6364136223846793005 + 1442695040888963407;
    x = x ^ (x >> 33);
    x = x * 14029467366897019727;
    x = x ^ (x >> 33);
    if (x == 0) { x = 88172645463325252; }
    g_rng = x;
}

fn rnd_u64(): u64 {
    let x: u64 = g_rng;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    g_rng = x;
    let out: u64 = x;
    return out;
}

fn rnd01(): f64 {
    let v: u64 = rnd_u64() >> 11;
    let out: f64 = f64(v) * 0.00000000000000011102230246251565;   // 2^-53
    return out;
}

fn rnd_range(p_lo: f64, p_hi: f64): f64 {
    let out: f64 = p_lo + (p_hi - p_lo) * rnd01();
    return out;
}

// Position-keyed hash: same coordinate, same value, whatever the order of
// evaluation. Masked into u64 before every multiply.
fn h2(p_x: i32, p_y: i32, p_s: i32): f64 {
    let hx: u64 = u64(p_x & 1048575);
    let hy: u64 = u64(p_y & 1048575);
    let hs: u64 = u64(p_s & 1048575);
    let h: u64 = hx * 374761393 + hy * 668265263 + hs * 2246822519 + 3266489917;
    h = h ^ (h >> 13);
    h = h * 1274126177;
    h = h ^ (h >> 16);
    let out: f64 = f64(h & 65535) * 0.0000152587890625;
    return out;
}

fn vnoise2(p_x: f64, p_y: f64, p_s: i32): f64 {
    let xi: i32 = i32(floor(p_x));
    let yi: i32 = i32(floor(p_y));
    let xf: f64 = p_x - f64(xi);
    let yf: f64 = p_y - f64(yi);
    let u: f64 = xf * xf * (3.0 - 2.0 * xf);
    let v: f64 = yf * yf * (3.0 - 2.0 * yf);
    let a: f64 = h2(xi, yi, p_s);
    let b: f64 = h2(xi + 1, yi, p_s);
    let c: f64 = h2(xi, yi + 1, p_s);
    let d: f64 = h2(xi + 1, yi + 1, p_s);
    let ab: f64 = a + (b - a) * u;
    let cd: f64 = c + (d - c) * u;
    let out: f64 = ab + (cd - ab) * v;
    return out;
}

fn clamp01(p_v: f64): f64 {
    let v: f64 = p_v;
    if (v < 0.0) { v = 0.0; }
    if (v > 1.0) { v = 1.0; }
    let out: f64 = v;
    return out;
}

fn lerpf(p_a: f64, p_b: f64, p_t: f64): f64 {
    let out: f64 = p_a + (p_b - p_a) * p_t;
    return out;
}

fn clampi(p_v: i32, p_lo: i32, p_hi: i32): i32 {
    let v: i32 = p_v;
    if (v < p_lo) { v = p_lo; }
    if (v > p_hi) { v = p_hi; }
    let out: i32 = v;
    return out;
}

