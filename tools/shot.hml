// --- palette (ART_BIBLE §3 -> src/art/palette.hml, W2-3) -------------------
// Packed as 0xRRGGBB but built from decimal channels so no hex colour literal
// exists in the repo outside the eventual palette.hml.
fn pal(p_r: i32, p_g: i32, p_b: i32): i32 {
    let out: i32 = (p_r & 255) * 65536 + (p_g & 255) * 256 + (p_b & 255);
    return out;
}
fn pal_r(p_c: i32): i32 { let out: i32 = divi(p_c, 65536) & 255; return out; }
fn pal_g(p_c: i32): i32 { let out: i32 = divi(p_c, 256) & 255; return out; }
fn pal_b(p_c: i32): i32 { let out: i32 = p_c & 255; return out; }

