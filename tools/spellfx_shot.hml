let g_camy: f64 = 0.0;
let g_camz: f64 = 5.2;   // yaw 0 looks down -Z (view.hml), so stand +Z of it
let g_yaw: f64 = 0.0;
let g_pitch: f64 = 0.0 - 4.0;
let g_fov: f64 = 70.0;
let g_ground_y: f64 = 0.0;

