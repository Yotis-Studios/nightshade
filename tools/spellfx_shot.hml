// ===========================================================================
// 0. COMPILED ONLY
// ===========================================================================
// Same test shot.hml uses: interpreted, argv[0] is the .hml source path.
fn running_interpreted(): i32 {
    if (args.length < 1) { let no: i32 = 0; return no; }
    let a0: string = args[0];
    let n: i32 = 0;
    if (a0.ends_with(".hml")) { n = 1; }
    let out: i32 = n;
    return out;
}

fn num_or(p_s: string, p_d: f64): f64 {
    let s: string = p_s;
    if (s.length == 0) { let d: f64 = p_d; return d; }
    let neg: f64 = 1.0;
    let i: i32 = 0;
    if (s.slice(0, 1) == "-") { neg = 0.0 - 1.0; i = 1; }
    let whole: f64 = 0.0;
    let frac: f64 = 0.0;
    let scale: f64 = 1.0;
    let dot: i32 = 0;
    let any: i32 = 0;
    while (i < s.length) {
        let c: string = s.slice(i, i + 1);
        if (c == ".") { dot = 1; i++; continue; }
        let d: i32 = 0 - 1;
        if (c == "0") { d = 0; } if (c == "1") { d = 1; } if (c == "2") { d = 2; }
        if (c == "3") { d = 3; } if (c == "4") { d = 4; } if (c == "5") { d = 5; }
        if (c == "6") { d = 6; } if (c == "7") { d = 7; } if (c == "8") { d = 8; }
        if (c == "9") { d = 9; }
        if (d < 0) { let bad: f64 = p_d; return bad; }
        any = 1;
        if (dot == 0) { whole = whole * 10.0 + f64(d); }
        else { scale = scale * 0.1; frac = frac + f64(d) * scale; }
        i++;
    }
    if (any == 0) { let d2: f64 = p_d; return d2; }
    let out: f64 = neg * (whole + frac);
    return out;
}

