// ===========================================================================
// nightshade/tools/texview.hml — atlas inspector          (task W2-11 / W3-7)
// ===========================================================================
//
// Dumps every texture the renderer owns to PNG, magnified, with a cell grid
// and cell labels burned in, so a texture bug is visible instead of inferred.
//
//   hemlockc -O1 tools/texview.hml -o /tmp/texview
//   /tmp/texview --out docs/shots
//   /tmp/texview --tod 22.0 --weather storm --out /tmp        # TEX_SKY varies
//
// The four textures of CLAUDE.md §6 — and there are exactly four:
//   ATLAS_WORLD 256x256 (BLEND)   ATLAS_FX 128x128 (ADD)
//   ATLAS_HUD   128x128 (BLEND)   TEX_SKY  512x160 (none)
//
// No SDL window is opened and no renderer is touched: the generators write
// into an atlas.hml buffer and this tool reads that buffer straight back. It
// therefore inspects exactly the bytes that atlas_upload would have uploaded.
//
// ---------------------------------------------------------------------------
// W3-7 — THE STAND-INS ARE GONE
// ---------------------------------------------------------------------------
// Until W3-7 this file carried ~555 lines of fenced stand-in generators (a
// local palette, a local ToD table, and four local `*gen_build_*` functions)
// because W2-3..W2-7 were being written in parallel with it. Every PNG it
// produced therefore depicted throwaway art rather than the game's. The fence
// is DELETED. This tool now imports src/art/{palette,tod,texgen,fxgen,hudgen,
// skygen}.hml and photographs the shipping generators, byte for byte.
//
// The ONLY thing still local is the 3x5 overlay label font, and that is
// deliberate: the game's font is baked into ATLAS_HUD, so using it to LABEL
// ATLAS_HUD would make a font bug invisible. 40 lines of independent glyphs
// mean a broken label can never be mistaken for a broken atlas.
// ===========================================================================

import { exit } from "@stdlib/process";
import { exists, make_dirs } from "@stdlib/fs";
import { divi } from "@stdlib/math";
import { write_png } from "../../wobbleweed/src/png.hml";
import { atlas_new, atlas_base, atlas_cell_w, atlas_cell_h, atlas_cell_count }
       from "../../wobbleweed/src/atlas.hml";
import { env_new, env_field, ENV_FOG_R, ENV_FOG_G, ENV_FOG_B,
         ENV_FOG_NEAR, ENV_FOG_FAR }
       from "../../wobbleweed/src/shade.hml";

import { pal_r, pal_g, pal_b, pal_pack,
         g_UI_WHITE, g_UI_DIM, g_UI_AMBER, g_DEBUG_MAGENTA }
       from "../src/art/palette.hml";

import { tod_eval, tod_reset, tod_clock_hours, tod_sky_keys, tod_key_anchor,
         tod_key_field, tod_mist_density, tod_phase,
         TOD_KEY_COUNT, TODSKY_COUNT,
         TODSKY_ZENITH_R, TODSKY_MID_R, TODSKY_HORIZON_R,
         TODSKY_CLOUD_LIT_R, TODSKY_CLOUD_SHADOW_R,
         TODSKY_STAR_ALPHA, TODSKY_HALO, TODSKY_MOON,
         TODSKY_BODY_X, TODSKY_BODY_Y, TODSKY_BODY_Z, TODSKY_CLOUD_COVER,
         WX_CLEAR, WX_OVERCAST, WX_RAIN, WX_STORM, WX_BLOOM }
       from "../src/art/tod.hml";

import { texgen_build_world_atlas, texgen_cell_name, texgen_cell_generated }
       from "../src/art/texgen.hml";

import { fxgen_build_atlas, fxgen_atlas, fxgen_cell_name,
         FX_ATLAS_W, FX_ATLAS_H, FX_GRID, FX_CELL_COUNT }
       from "../src/art/fxgen.hml";

import { hudgen_build_atlas, hudgen_atlas, hudgen_rect, hudgen_sprite_name,
         HUD_ATLAS_W, HUD_ATLAS_H, HUD_RECT_COUNT }
       from "../src/art/hudgen.hml";

import { skygen_init, skygen_keys_new, skygen_keys_default, skygen_set_keys,
         skygen_set_clock, skygen_bake_all, skygen_atlas,
         skygen_w, skygen_h, skygen_star_count,
         SKYK_ZEN, SKYK_MID, SKYK_HOR, SKYK_CLOUD_LIT, SKYK_CLOUD_SHADOW,
         SKYK_FOG, SKYK_STAR_ALPHA, SKYK_SUN, SKYK_HALO_R, SKYK_HALO_EXP,
         SKYK_CLOUD_COVER }
       from "../src/art/skygen.hml";

// The world atlas geometry texgen.hml demands (§7.4). Named here because
// texgen exports the CELL_* ids, not the packing.
let g_WORLD_W: i32 = 256;
let g_WORLD_GRID: i32 = 8;

fn clampi(p_v: i32, p_lo: i32, p_hi: i32): i32 {
    let v: i32 = p_v;
    if (v < p_lo) { v = p_lo; }
    if (v > p_hi) { v = p_hi; }
    let out: i32 = v;
    return out;
}

// ===========================================================================
// THE VIEWER
// ===========================================================================

let g_MAG: i32 = 4;                 // integer magnification, nearest neighbour
let g_out_dir: string = ".";
let g_seed: i32 = 1337;             // ARCHITECTURE §7's harness seed

// A 3x5 glyph blitter straight into the RGB output buffer. See the header:
// the atlas font is baked into ATLAS_HUD and cannot be used to LABEL
// ATLAS_HUD, so the overlay carries its own copy.
let g_lbl: array<i32> = [];

fn lbl_add(p_cp: i32, p_a: i32, p_b: i32, p_c: i32, p_d: i32, p_e: i32) {
    g_lbl.push(p_cp);
    g_lbl.push(p_a); g_lbl.push(p_b); g_lbl.push(p_c); g_lbl.push(p_d); g_lbl.push(p_e);
}

fn lbl_build() {
    lbl_add(32, 0,0,0,0,0);
    lbl_add(48, 7,5,5,5,7); lbl_add(49, 2,6,2,2,7); lbl_add(50, 7,1,7,4,7);
    lbl_add(51, 7,1,7,1,7); lbl_add(52, 5,5,7,1,1); lbl_add(53, 7,4,7,1,7);
    lbl_add(54, 7,4,7,5,7); lbl_add(55, 7,1,1,1,1); lbl_add(56, 7,5,7,5,7);
    lbl_add(57, 7,5,7,1,7);
    lbl_add(65, 7,5,7,5,5); lbl_add(66, 6,5,6,5,6); lbl_add(67, 7,4,4,4,7);
    lbl_add(68, 6,5,5,5,6); lbl_add(69, 7,4,7,4,7); lbl_add(70, 7,4,7,4,4);
    lbl_add(71, 7,4,5,5,7); lbl_add(72, 5,5,7,5,5); lbl_add(73, 7,2,2,2,7);
    lbl_add(74, 1,1,1,5,7); lbl_add(75, 5,5,6,5,5); lbl_add(76, 4,4,4,4,7);
    lbl_add(77, 5,7,7,5,5); lbl_add(78, 5,7,7,7,5); lbl_add(79, 7,5,5,5,7);
    lbl_add(80, 7,5,7,4,4); lbl_add(81, 7,5,5,7,3); lbl_add(82, 7,5,7,6,5);
    lbl_add(83, 7,4,7,1,7); lbl_add(84, 7,2,2,2,2); lbl_add(85, 5,5,5,5,7);
    lbl_add(86, 5,5,5,5,2); lbl_add(87, 5,5,7,7,5); lbl_add(88, 5,5,2,5,5);
    lbl_add(89, 5,5,2,2,2); lbl_add(90, 7,1,2,4,7);
    lbl_add(46, 0,0,0,0,2); lbl_add(58, 0,2,0,2,0); lbl_add(47, 1,1,2,4,4);
    lbl_add(45, 0,0,7,0,0); lbl_add(95, 0,0,0,0,7); lbl_add(37, 5,1,2,4,5);
    lbl_add(40, 1,2,2,2,1); lbl_add(41, 4,2,2,2,4); lbl_add(44, 0,0,0,2,4);
    lbl_add(43, 0,2,7,2,0); lbl_add(62, 4,2,1,2,4); lbl_add(33, 2,2,2,0,2);
}
lbl_build();

let g_img: buffer = buffer(1);
let g_iw: i32 = 1;
let g_ih: i32 = 1;

fn img_new(p_w: i32, p_h: i32) {
    g_iw = p_w;
    g_ih = p_h;
    g_img = buffer(p_w * p_h * 3);
}

fn img_px(p_x: i32, p_y: i32, p_r: i32, p_g: i32, p_b: i32) {
    if (p_x < 0 || p_y < 0 || p_x >= g_iw || p_y >= g_ih) { return; }
    let o: i32 = (p_y * g_iw + p_x) * 3;
    let p: ptr = buffer_ptr(g_img);
    ptr_write_u8(ptr_offset(p, o, 1), p_r & 255);
    ptr_write_u8(ptr_offset(p, o + 1, 1), p_g & 255);
    ptr_write_u8(ptr_offset(p, o + 2, 1), p_b & 255);
}

fn img_fill(p_r: i32, p_g: i32, p_b: i32) {
    for (let y = 0; y < g_ih; y++) {
        for (let x = 0; x < g_iw; x++) { img_px(x, y, p_r, p_g, p_b); }
    }
}

fn img_hline(p_x: i32, p_y: i32, p_w: i32, p_c: i32) {
    for (let x = 0; x < p_w; x++) {
        img_px(p_x + x, p_y, pal_r(p_c), pal_g(p_c), pal_b(p_c));
    }
}

fn img_vline(p_x: i32, p_y: i32, p_h: i32, p_c: i32) {
    for (let y = 0; y < p_h; y++) {
        img_px(p_x, p_y + y, pal_r(p_c), pal_g(p_c), pal_b(p_c));
    }
}

fn img_box(p_x: i32, p_y: i32, p_w: i32, p_h: i32, p_c: i32) {
    img_hline(p_x, p_y, p_w, p_c);
    img_hline(p_x, p_y + p_h - 1, p_w, p_c);
    img_vline(p_x, p_y, p_h, p_c);
    img_vline(p_x + p_w - 1, p_y, p_h, p_c);
}

// `p_sc` is an integer text magnification: 1 for dense chrome, 2 for cell
// labels burned over a 4x-magnified atlas, where 3x5 would be unreadable.
fn img_text(p_x: i32, p_y: i32, p_s: string, p_c: i32, p_sc: i32) {
    let n: i32 = g_lbl.length;
    let sc: i32 = p_sc;
    if (sc < 1) { sc = 1; }
    let cx: i32 = p_x;
    for (let i = 0; i < p_s.length; i++) {
        let cp: i32 = i32(p_s.byte_at(i));
        if (cp >= 97 && cp <= 122) { cp = cp - 32; }
        let gi: i32 = -1;
        for (let k = 0; k < n; k = k + 6) {
            if (g_lbl[k] == cp) { gi = k; }
        }
        if (gi >= 0) {
            // 1-px UI_BLACK shadow at (+sc,+sc), always — a label over a light
            // tile must stay legible or it is not evidence.
            for (let r = 0; r < 5; r++) {
                let bits: i32 = g_lbl[gi + 1 + r];
                for (let c = 0; c < 3; c++) {
                    if (((bits >> (2 - c)) & 1) == 1) {
                        for (let sy = 0; sy < sc; sy++) {
                            for (let sx = 0; sx < sc; sx++) {
                                img_px(cx + c * sc + sx + sc, p_y + r * sc + sy + sc,
                                       10, 12, 16);
                            }
                        }
                    }
                }
            }
            for (let r2 = 0; r2 < 5; r2++) {
                let bits2: i32 = g_lbl[gi + 1 + r2];
                for (let c2 = 0; c2 < 3; c2++) {
                    if (((bits2 >> (2 - c2)) & 1) == 1) {
                        for (let sy2 = 0; sy2 < sc; sy2++) {
                            for (let sx2 = 0; sx2 < sc; sx2++) {
                                img_px(cx + c2 * sc + sx2, p_y + r2 * sc + sy2,
                                       pal_r(p_c), pal_g(p_c), pal_b(p_c));
                            }
                        }
                    }
                }
            }
        }
        cx = cx + 4 * sc;
    }
}

// Blit one RGBA atlas over an 8-px checkerboard so ALPHA IS VISIBLE rather
// than guessed, magnified p_mag times, nearest neighbour.
fn blit_atlas(p_a: object, p_dx: i32, p_dy: i32, p_w: i32, p_h: i32, p_mag: i32) {
    let base: ptr = atlas_base(p_a);
    let mag: i32 = p_mag;
    for (let y = 0; y < p_h * mag; y++) {
        let sy: i32 = divi(y, mag);
        for (let x = 0; x < p_w * mag; x++) {
            let sx: i32 = divi(x, mag);
            let o: i32 = (sy * p_w + sx) * 4;
            let r: i32 = ptr_deref_u8(ptr_offset(base, o, 1));
            let g: i32 = ptr_deref_u8(ptr_offset(base, o + 1, 1));
            let b: i32 = ptr_deref_u8(ptr_offset(base, o + 2, 1));
            let a: i32 = ptr_deref_u8(ptr_offset(base, o + 3, 1));
            let ck: i32 = 64;
            if ((divi(x, 8) + divi(y, 8)) % 2 == 0) { ck = 100; }
            let af: f64 = f64(a) / 255.0;
            img_px(p_dx + x, p_dy + y,
                   i32(f64(r) * af + f64(ck) * (1.0 - af)),
                   i32(f64(g) * af + f64(ck) * (1.0 - af)),
                   i32(f64(b) * af + f64(ck) * (1.0 - af)));
        }
    }
}

let g_pad: i32 = 12;
let g_hdr: i32 = 16;

fn finish(p_file: string, p_title: string, p_note: string): i32 {
    img_text(g_pad, 3, p_title, g_UI_WHITE, 1);
    img_text(g_pad, 10, p_note, g_UI_DIM, 1);
    write_png(p_file, g_img, g_iw, g_ih);
    if (exists(p_file) == false) {
        eprint(`texview: failed to write ${p_file}`);
        let bad: i32 = -1;
        return bad;
    }
    print(`wrote ${p_file}  (${g_iw}x${g_ih})`);
    let ok: i32 = 0;
    return ok;
}

// A cell-grid atlas: ATLAS_WORLD (8x8 of 32) and ATLAS_FX (8x8 of 16). The
// label comes from the generator's own name table, so a cell that moved shows
// up as a mislabelled tile rather than as nothing at all.
fn dump_grid(p_a: object, p_w: i32, p_h: i32, p_grid: i32, p_mag: i32,
             p_kind: i32, p_ngen: i32,
             p_title: string, p_note: string, p_file: string): i32 {
    let mag: i32 = p_mag;
    let iw: i32 = p_w * mag + g_pad * 2;
    let ih: i32 = p_h * mag + g_pad * 2 + g_hdr;
    img_new(iw, ih);
    img_fill(24, 26, 30);
    blit_atlas(p_a, g_pad, g_pad + g_hdr, p_w, p_h, mag);

    let cw: i32 = divi(p_w, p_grid) * mag;
    let ch: i32 = divi(p_h, p_grid) * mag;
    let ox: i32 = g_pad;
    let oy: i32 = g_pad + g_hdr;
    for (let j = 0; j <= p_grid; j++) {
        img_hline(ox, oy + j * ch, p_w * mag, g_DEBUG_MAGENTA);
    }
    for (let i2 = 0; i2 <= p_grid; i2++) {
        img_vline(ox + i2 * cw, oy, p_h * mag, g_DEBUG_MAGENTA);
    }

    let ncells: i32 = p_grid * p_grid;
    let sc: i32 = 1;
    if (cw >= 64) { sc = 2; }
    for (let c = 0; c < ncells; c++) {
        let cxi: i32 = c % p_grid;
        let cyi: i32 = divi(c, p_grid);
        let name: string = "-";
        let live: i32 = 0;
        if (p_kind == 0) {
            name = texgen_cell_name(c);
            live = texgen_cell_generated(c);
        } else {
            if (c < p_ngen) { name = fxgen_cell_name(c); live = 1; }
        }
        let ink: i32 = g_UI_AMBER;
        if (live == 0) { ink = g_UI_DIM; }
        img_text(ox + cxi * cw + 3, oy + cyi * ch + 3, name, ink, sc);
        img_text(ox + cxi * cw + 3, oy + cyi * ch + 3 + 6 * sc,
                 `${c}`, ink, sc);
    }
    let rc: i32 = finish(p_file, p_title, p_note);
    return rc;
}

// ATLAS_HUD has no cell grid — it is a hand-packed rect atlas. Drawing the
// 26 sprite rects hudgen actually reports is the only way to check that the
// packer and the uv table agree with the pixels.
fn dump_hud(p_a: object, p_mag: i32, p_title: string, p_note: string,
            p_file: string): i32 {
    let mag: i32 = p_mag;
    let w: i32 = HUD_ATLAS_W;
    let h: i32 = HUD_ATLAS_H;
    let iw: i32 = w * mag + g_pad * 2;
    let ih: i32 = h * mag + g_pad * 2 + g_hdr;
    img_new(iw, ih);
    img_fill(24, 26, 30);
    blit_atlas(p_a, g_pad, g_pad + g_hdr, w, h, mag);
    let ox: i32 = g_pad;
    let oy: i32 = g_pad + g_hdr;

    let r: array<i32> = [0, 0, 0, 0];
    for (let id = 0; id < HUD_RECT_COUNT; id++) {
        hudgen_rect(id, r, 0);
        if (r[2] <= 0 || r[3] <= 0) { continue; }
        img_box(ox + r[0] * mag, oy + r[1] * mag,
                r[2] * mag, r[3] * mag, g_DEBUG_MAGENTA);
        let ly: i32 = oy + r[1] * mag - 7;
        if (ly < oy) { ly = oy + r[1] * mag + 2; }
        img_text(ox + r[0] * mag + 1, ly, hudgen_sprite_name(id), g_UI_AMBER, 1);
    }
    let rc: i32 = finish(p_file, p_title, p_note);
    return rc;
}

fn dump_sky(p_a: object, p_mag: i32, p_title: string, p_note: string,
            p_file: string): i32 {
    let mag: i32 = p_mag;
    let w: i32 = skygen_w();
    let h: i32 = skygen_h();
    let iw: i32 = w * mag + g_pad * 2;
    let ih: i32 = h * mag + g_pad * 2 + g_hdr;
    img_new(iw, ih);
    img_fill(24, 26, 30);
    blit_atlas(p_a, g_pad, g_pad + g_hdr, w, h, mag);
    let ox: i32 = g_pad;
    let oy: i32 = g_pad + g_hdr;
    img_box(ox, oy, w * mag, h * mag, g_DEBUG_MAGENTA);
    // A yaw ruler: the panorama is 360 degrees of yaw, so a cloud that drifts
    // off one edge must reappear at the other.
    for (let q = 1; q < 4; q++) {
        img_vline(ox + divi(w * mag * q, 4), oy, h * mag, g_DEBUG_MAGENTA);
        img_text(ox + divi(w * mag * q, 4) + 3, oy + 3, `${q * 90}`, g_UI_AMBER, 1);
    }
    img_text(ox + 3, oy + 3, "0 YAW", g_UI_AMBER, 1);
    img_text(ox + 3, oy + h * mag - 9, "HORIZON", g_UI_AMBER, 1);
    let rc: i32 = finish(p_file, p_title, p_note);
    return rc;
}

// ===========================================================================
// tod -> skygen: the key bridge
//
// tod.hml emits TODSKY_* (0..1 colours, 22 slots); skygen.hml consumes SKYK_*
// (0..255 colours, 26 slots). NEITHER module owns the conversion and
// ARCHITECTURE §5 does not name one, so every consumer writes it — this tool,
// shot.hml and the eventual frame graph. Reported as a signature gap.
// ===========================================================================
fn sky_keys_from_tod(p_k: array<f64>, p_s: array<f64>, p_env: array<f64>) {
    let k: array<f64> = p_k;
    let s: array<f64> = p_s;
    for (let i = 0; i < 3; i++) {
        k[SKYK_ZEN + i]          = s[TODSKY_ZENITH_R + i] * 255.0;
        k[SKYK_MID + i]          = s[TODSKY_MID_R + i] * 255.0;
        k[SKYK_HOR + i]          = s[TODSKY_HORIZON_R + i] * 255.0;
        k[SKYK_CLOUD_LIT + i]    = s[TODSKY_CLOUD_LIT_R + i] * 255.0;
        k[SKYK_CLOUD_SHADOW + i] = s[TODSKY_CLOUD_SHADOW_R + i] * 255.0;
    }
    // FOG is the one key skygen wants in 0..1, and it must be the fog the
    // renderer will actually use, so it comes off the RenderEnv rather than
    // being re-derived: §11.5 requires the horizon seam and the fog to agree.
    k[SKYK_FOG]     = env_field(p_env, ENV_FOG_R);
    k[SKYK_FOG + 1] = env_field(p_env, ENV_FOG_G);
    k[SKYK_FOG + 2] = env_field(p_env, ENV_FOG_B);

    k[SKYK_STAR_ALPHA] = s[TODSKY_STAR_ALPHA];
    k[SKYK_SUN]        = s[TODSKY_BODY_X];
    k[SKYK_SUN + 1]    = s[TODSKY_BODY_Y];
    k[SKYK_SUN + 2]    = s[TODSKY_BODY_Z];
    // TODSKY_HALO is 0..1 corona strength; skygen wants a radius and a
    // falloff exponent. 34/1.8 is the default disc, 56/1.2 the big dawn and
    // golden corona the ART_BIBLE §5.1 HALO column asks for.
    k[SKYK_HALO_R]   = 34.0 + 22.0 * s[TODSKY_HALO];
    k[SKYK_HALO_EXP] = 1.8 - 0.6 * s[TODSKY_HALO];
    k[SKYK_CLOUD_COVER] = s[TODSKY_CLOUD_COVER];
}

// ===========================================================================
// hours -> day fraction. tod.hml exports the forward map (tod_clock_hours);
// the inverse is piecewise-linear over the same seven anchors, so it is exact
// rather than iterative.
// ===========================================================================
let g_KF_CLOCK: i32 = 38;

fn tod_t_from_hour(p_h: f64): f64 {
    let h: f64 = p_h;
    while (h < 0.0) { h = h + 24.0; }
    while (h >= 24.0) { h = h - 24.0; }
    let c0: f64 = tod_key_field(0, g_KF_CLOCK);
    let hh: f64 = h;
    if (hh < c0) { hh = hh + 24.0; }
    for (let i = 0; i < TOD_KEY_COUNT; i++) {
        let a0: f64 = tod_key_anchor(i);
        let k0: f64 = tod_key_field(i, g_KF_CLOCK);
        let a1: f64 = 1.0;
        let k1: f64 = c0 + 24.0;
        if (i < TOD_KEY_COUNT - 1) {
            a1 = tod_key_anchor(i + 1);
            k1 = tod_key_field(i + 1, g_KF_CLOCK);
        }
        if (hh >= k0 && hh <= k1 && k1 > k0) {
            let u: f64 = (hh - k0) / (k1 - k0);
            let out: f64 = a0 + (a1 - a0) * u;
            return out;
        }
    }
    let fallback: f64 = 0.0;
    return fallback;
}

fn wx_parse(p_s: string): i32 {
    let s: string = p_s;
    if (s == "clear") { let o: i32 = WX_CLEAR; return o; }
    if (s == "overcast") { let o: i32 = WX_OVERCAST; return o; }
    if (s == "rain") { let o: i32 = WX_RAIN; return o; }
    if (s == "storm") { let o: i32 = WX_STORM; return o; }
    if (s == "bloom") { let o: i32 = WX_BLOOM; return o; }
    let bad: i32 = -1;
    return bad;
}

fn wx_name(p_wx: i32): string {
    if (p_wx == WX_CLEAR) { return "CLEAR"; }
    if (p_wx == WX_OVERCAST) { return "OVERCAST"; }
    if (p_wx == WX_RAIN) { return "RAIN"; }
    if (p_wx == WX_STORM) { return "STORM"; }
    return "NS BLOOM";
}

fn running_interpreted(): bool {
    if (args.length < 1) { return false; }
    let a0: string = args[0];
    let out: bool = a0.ends_with(".hml");
    return out;
}

fn main() {
    if (running_interpreted()) {
        eprint("texview.hml is COMPILED-ONLY (ARCHITECTURE.md §7).");
        eprint("    hemlockc -O1 tools/texview.hml -o /tmp/texview && /tmp/texview --out docs/shots");
        exit(2);
    }
    let tod_h: f64 = 12.0;
    let wx: i32 = WX_CLEAR;
    let i: i32 = 1;
    while (i < args.length) {
        let a: string = args[i];
        if (a == "--out" && i + 1 < args.length) { i++; g_out_dir = args[i]; }
        else if (a == "--mag" && i + 1 < args.length) {
            i++;
            g_MAG = clampi(i32(f64(args[i])), 1, 8);
        }
        else if (a == "--seed" && i + 1 < args.length) { i++; g_seed = i32(f64(args[i])); }
        else if (a == "--tod" && i + 1 < args.length) { i++; tod_h = f64(args[i]); }
        else if (a == "--weather" && i + 1 < args.length) {
            i++;
            wx = wx_parse(args[i]);
            if (wx < 0) { eprint("texview: unknown weather"); exit(2); }
        }
        else if (a == "--help") {
            print("texview.hml — dump ATLAS_WORLD / ATLAS_FX / ATLAS_HUD / TEX_SKY to PNG");
            print("  --out <dir>       output directory (default .)");
            print("  --mag <n>         magnification 1..8 (default 4)");
            print("  --seed <n>        texgen seed (default 1337)");
            print("  --tod <h>         time of day, clock hours, for TEX_SKY (default 12)");
            print("  --weather <name>  clear|overcast|rain|storm|bloom");
            exit(0);
        }
        else { eprint(`texview: unknown argument '${a}'`); exit(2); }
        i++;
    }
    if (g_out_dir != "." && exists(g_out_dir) == false) { make_dirs(g_out_dir); }

    // ---- ATLAS_WORLD ------------------------------------------------------
    let world = atlas_new(g_WORLD_W, g_WORLD_W, g_WORLD_GRID, g_WORLD_GRID);
    if (world == null) { eprint("texview: atlas_new(256,256,8,8) failed"); exit(4); }
    let ncell: i32 = texgen_build_world_atlas(world, g_seed);
    if (ncell < 0) {
        eprint("texview: texgen rejected the atlas geometry");
        exit(4);
    }

    // ---- ATLAS_FX / ATLAS_HUD --------------------------------------------
    fxgen_build_atlas();
    let fx = fxgen_atlas();
    if (fx == null) { eprint("texview: fxgen_build_atlas returned null"); exit(4); }
    hudgen_build_atlas();
    let hud = hudgen_atlas();
    if (hud == null) { eprint("texview: hudgen_build_atlas returned null"); exit(4); }

    // ---- TEX_SKY through the real tod + skygen ---------------------------
    // tod_reset first: tod_eval advances a stateful weather crossfade, and a
    // tool that did not reset would photograph a half-finished fade. This is
    // what makes the same command produce the same PNG bytes.
    tod_reset();
    let day_t: f64 = tod_t_from_hour(tod_h);
    let env: array<f64> = env_new();
    tod_eval(env, day_t, wx);

    let sky: array<f64> = [];
    for (let z = 0; z < TODSKY_COUNT; z++) { sky.push(0.0); }
    tod_sky_keys(sky);

    skygen_init();
    let keys: array<f64> = skygen_keys_new();
    skygen_keys_default(keys);
    sky_keys_from_tod(keys, sky, env);
    skygen_set_keys(keys);
    skygen_set_clock(0.0);              // fixed clock: cloud drift must not vary
    skygen_bake_all();
    let skya = skygen_atlas();

    // ---- write the four ---------------------------------------------------
    let hours: f64 = tod_clock_hours(day_t);
    let wname: string = wx_name(wx);
    let mist: i32 = i32(tod_mist_density() * 100.0);
    let fnear: i32 = i32(env_field(env, ENV_FOG_NEAR));
    let ffar: i32 = i32(env_field(env, ENV_FOG_FAR));

    let rc: i32 = 0;
    rc = rc + dump_grid(world, g_WORLD_W, g_WORLD_W, g_WORLD_GRID, g_MAG, 0, 0,
                        "ATLAS WORLD 256X256 RGBA BLEND - SRC/ART/TEXGEN.HML",
                        `8X8 CELLS OF 32X32 - ${ncell} GENERATED - SEED ${g_seed} - MAGENTA IS THE MISSING TILE`,
                        g_out_dir + "/tex_world.png");
    rc = rc + dump_grid(fx, FX_ATLAS_W, FX_ATLAS_H, FX_GRID, g_MAG * 2, 1, FX_CELL_COUNT,
                        "ATLAS FX 128X128 RGBA ADD - SRC/ART/FXGEN.HML",
                        `8X8 CELLS OF 16X16 - ${FX_CELL_COUNT} GENERATED - BLACK IS THE ADDITIVE IDENTITY`,
                        g_out_dir + "/tex_fx.png");
    rc = rc + dump_hud(hud, g_MAG * 2,
                       "ATLAS HUD 128X128 RGBA BLEND - SRC/ART/HUDGEN.HML",
                       `${HUD_RECT_COUNT} SPRITE RECTS BOXED FROM HUDGEN RECT - FONT MICRO 4X6 AND FONT BIG 8X12`,
                       g_out_dir + "/tex_hud.png");
    rc = rc + dump_sky(skya, 2,
                       "TEX SKY 512X160 RGBA NONE - SRC/ART/SKYGEN.HML",
                       `${i32(hours)}H ${wname} - PHASE ${tod_phase(day_t)} - STARS ${skygen_star_count()} - FOG ${fnear} TO ${ffar}M - MIST ${mist}%`,
                       g_out_dir + "/tex_sky.png");
    if (rc != 0) { exit(4); }

    // ---- the sidecar. A screenshot without its numbers is not evidence. ---
    print("");
    print("texview stats");
    print(`  seed                ${g_seed}`);
    print(`  tod                 t=${day_t} clock=${hours}h phase=${tod_phase(day_t)}`);
    print(`  weather             ${wname}`);
    print(`  ATLAS_WORLD         256x256 8x8x32 cells=${atlas_cell_count(world)} generated=${ncell} cell=${atlas_cell_w(world)}x${atlas_cell_h(world)}`);
    print(`  ATLAS_FX            ${FX_ATLAS_W}x${FX_ATLAS_H} ${FX_GRID}x${FX_GRID} generated=${FX_CELL_COUNT}`);
    print(`  ATLAS_HUD           ${HUD_ATLAS_W}x${HUD_ATLAS_H} rects=${HUD_RECT_COUNT}`);
    print(`  TEX_SKY             ${skygen_w()}x${skygen_h()} stars=${skygen_star_count()} cover=${sky[TODSKY_CLOUD_COVER]} star_alpha=${sky[TODSKY_STAR_ALPHA]} moon=${sky[TODSKY_MOON]}`);
    print(`  fog                 near=${fnear}m far=${ffar}m mist=${mist}%`);
    print("texview: 4 textures written. There are exactly four (CLAUDE.md §6).");
    exit(0);
}

main();
