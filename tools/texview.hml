// ===========================================================================
// nightshade/tools/texview.hml — atlas inspector                  (task W2-11)
// ===========================================================================
//
// Dumps every texture the renderer owns to PNG, magnified, with a cell grid
// and cell labels burned in, so a texture bug is visible instead of inferred.
//
//   hemlockc -O1 tools/texview.hml -o /tmp/texview
//   /tmp/texview --out docs/shots
//   /tmp/texview --tod 22.0 --weather storm --out /tmp        # TEX_SKY varies
//
// The four textures of CLAUDE.md §6 — and there are exactly four:
//   ATLAS_WORLD (BLEND)  ATLAS_FX (ADD)  ATLAS_HUD (BLEND)  TEX_SKY (none)
//
// No SDL window is opened and no renderer is touched: the generators write
// into an atlas.hml buffer and this tool reads that buffer straight back. It
// therefore inspects exactly the bytes that atlas_upload would have uploaded.
//
// ---------------------------------------------------------------------------
// WAVE-2 STAND-IN CONTENT
// ---------------------------------------------------------------------------
// The palette, the ToD keyframe table and the four generators below are the
// same fenced stand-ins as in tools/shot.hml, for the same reason: W2-3..W2-7
// were being written in parallel with this file. W3-7 deletes both fences and
// replaces them with imports of src/art/{palette,tod,texgen,fxgen,hudgen,
// skygen}.hml. Until then, keep the two copies in step — `--selftest` asserts
// that this tool and shot.hml agree on the world atlas, byte for byte.
// ===========================================================================

import { exit } from "@stdlib/process";
import { exists, make_dirs } from "@stdlib/fs";
import { sin, cos, sqrt, floor, divi } from "@stdlib/math";
import { write_png } from "../../wobbleweed/src/png.hml";
import { atlas_new, atlas_px, atlas_fill, atlas_base, atlas_rect_uv }
       from "../../wobbleweed/src/atlas.hml";
import { font_new, font_add_glyph, font_bake }
       from "../../wobbleweed/src/font.hml";
import { env_new, env_set_sun, env_set_ambient, env_set_bounce, env_set_camera,
         env_set_fog, env_set_mist }
       from "../../wobbleweed/src/shade.hml";

fn h2(p_x: i32, p_y: i32, p_s: i32): f64 {
    let hx: u64 = u64(p_x & 1048575);
    let hy: u64 = u64(p_y & 1048575);
    let hs: u64 = u64(p_s & 1048575);
    let h: u64 = hx * 374761393 + hy * 668265263 + hs * 2246822519 + 3266489917;
    h = h ^ (h >> 13);
    h = h * 1274126177;
    h = h ^ (h >> 16);
    let out: f64 = f64(h & 65535) * 0.0000152587890625;
    return out;
}

fn vnoise2(p_x: f64, p_y: f64, p_s: i32): f64 {
    let xi: i32 = i32(floor(p_x));
    let yi: i32 = i32(floor(p_y));
    let xf: f64 = p_x - f64(xi);
    let yf: f64 = p_y - f64(yi);
    let u: f64 = xf * xf * (3.0 - 2.0 * xf);
    let v: f64 = yf * yf * (3.0 - 2.0 * yf);
    let a: f64 = h2(xi, yi, p_s);
    let b: f64 = h2(xi + 1, yi, p_s);
    let c: f64 = h2(xi, yi + 1, p_s);
    let d: f64 = h2(xi + 1, yi + 1, p_s);
    let ab: f64 = a + (b - a) * u;
    let cd: f64 = c + (d - c) * u;
    let out: f64 = ab + (cd - ab) * v;
    return out;
}

fn clamp01(p_v: f64): f64 {
    let v: f64 = p_v;
    if (v < 0.0) { v = 0.0; }
    if (v > 1.0) { v = 1.0; }
    let out: f64 = v;
    return out;
}

fn lerpf(p_a: f64, p_b: f64, p_t: f64): f64 {
    let out: f64 = p_a + (p_b - p_a) * p_t;
    return out;
}

fn clampi(p_v: i32, p_lo: i32, p_hi: i32): i32 {
    let v: i32 = p_v;
    if (v < p_lo) { v = p_lo; }
    if (v > p_hi) { v = p_hi; }
    let out: i32 = v;
    return out;
}

// ===========================================================================
// ##################  WAVE-2 STAND-IN CONTENT — START  ######################
// ===========================================================================

// --- palette (ART_BIBLE §3 -> src/art/palette.hml, W2-3) -------------------
// Packed as 0xRRGGBB but built from decimal channels so no hex colour literal
// exists in the repo outside the eventual palette.hml.
fn pal(p_r: i32, p_g: i32, p_b: i32): i32 {
    let out: i32 = (p_r & 255) * 65536 + (p_g & 255) * 256 + (p_b & 255);
    return out;
}
fn pal_r(p_c: i32): i32 { let out: i32 = divi(p_c, 65536) & 255; return out; }
fn pal_g(p_c: i32): i32 { let out: i32 = divi(p_c, 256) & 255; return out; }
fn pal_b(p_c: i32): i32 { let out: i32 = p_c & 255; return out; }

