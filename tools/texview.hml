// Seven keyframes. Fields per key, in one flat array<f64> of stride TOD_N.
let TOD_HOUR: i32 = 0;
let TOD_SUNX: i32 = 1;   let TOD_SUNY: i32 = 2;   let TOD_SUNZ: i32 = 3;
let TOD_SUNR: i32 = 4;   let TOD_SUNG: i32 = 5;   let TOD_SUNB: i32 = 6;
let TOD_AMBR: i32 = 7;   let TOD_AMBG: i32 = 8;   let TOD_AMBB: i32 = 9;
let TOD_BNCR: i32 = 10;  let TOD_BNCG: i32 = 11;  let TOD_BNCB: i32 = 12;
let TOD_FTR: i32 = 13;   let TOD_FTG: i32 = 14;   let TOD_FTB: i32 = 15;
let TOD_FNEAR: i32 = 16; let TOD_FFAR: i32 = 17;  let TOD_FAMAX: i32 = 18;
let TOD_ZENR: i32 = 19;  let TOD_ZENG: i32 = 20;  let TOD_ZENB: i32 = 21;
let TOD_MIDR: i32 = 22;  let TOD_MIDG: i32 = 23;  let TOD_MIDB: i32 = 24;
let TOD_HORR: i32 = 25;  let TOD_HORG: i32 = 26;  let TOD_HORB: i32 = 27;
let TOD_MIST: i32 = 28;  let TOD_STAR: i32 = 29;
let TOD_CLR: i32 = 30;   let TOD_CLG: i32 = 31;   let TOD_CLB: i32 = 32;
let TOD_CSR: i32 = 33;   let TOD_CSG: i32 = 34;   let TOD_CSB: i32 = 35;
let TOD_N: i32 = 36;

let g_tod: array<f64> = [];
let g_TOD_KEYS: i32 = 8;

fn tod_key(p_hour: f64,
           p_sx: f64, p_sy: f64, p_sz: f64,
           p_sr: f64, p_sg: f64, p_sb: f64,
           p_ar: f64, p_ag: f64, p_ab: f64,
           p_br: f64, p_bg: f64, p_bb: f64,
           p_tr: f64, p_tg: f64, p_tb: f64,
           p_fn: f64, p_ff: f64, p_fa: f64,
           p_zen: i32, p_mid: i32, p_hor: i32,
           p_mist: f64, p_star: f64,
           p_clit: i32, p_cshadow: i32) {
    g_tod.push(p_hour);
    g_tod.push(p_sx); g_tod.push(p_sy); g_tod.push(p_sz);
    g_tod.push(p_sr); g_tod.push(p_sg); g_tod.push(p_sb);
    g_tod.push(p_ar); g_tod.push(p_ag); g_tod.push(p_ab);
    g_tod.push(p_br); g_tod.push(p_bg); g_tod.push(p_bb);
    g_tod.push(p_tr); g_tod.push(p_tg); g_tod.push(p_tb);
    g_tod.push(p_fn); g_tod.push(p_ff); g_tod.push(p_fa);
    g_tod.push(f64(pal_r(p_zen))); g_tod.push(f64(pal_g(p_zen))); g_tod.push(f64(pal_b(p_zen)));
    g_tod.push(f64(pal_r(p_mid))); g_tod.push(f64(pal_g(p_mid))); g_tod.push(f64(pal_b(p_mid)));
    g_tod.push(f64(pal_r(p_hor))); g_tod.push(f64(pal_g(p_hor))); g_tod.push(f64(pal_b(p_hor)));
    g_tod.push(p_mist); g_tod.push(p_star);
    g_tod.push(f64(pal_r(p_clit))); g_tod.push(f64(pal_g(p_clit))); g_tod.push(f64(pal_b(p_clit)));
    g_tod.push(f64(pal_r(p_cshadow))); g_tod.push(f64(pal_g(p_cshadow))); g_tod.push(f64(pal_b(p_cshadow)));
}

fn tod_build() {
    // hour  sun dir          sun rgb            ambient rgb        bounce rgb         fog tint mul       near  far  amax   zenith           mid              horizon           mist star
    tod_key( 2.0,  0.20,-0.90, 0.39, 0.14,0.16,0.26, 0.14,0.15,0.26, 0.02,0.03,0.05, 0.13,0.16,0.30,  3.0, 22.0, 0.45,
             pal(8,10,30),    pal(14,18,48),   pal(22,28,52),   0.70, 1.00, pal(42,48,80), pal(18,24,44));
    tod_key( 5.5,  0.94, 0.10, 0.32, 0.80,0.50,0.28, 0.20,0.18,0.28, 0.09,0.08,0.04, 0.86,0.62,0.52,  8.0, 52.0, 1.00,
             pal(42,58,114),  pal(122,90,150), pal(232,164,104), 0.55, 0.15, pal(255,208,160), pal(142,110,136));
    tod_key( 8.0,  0.66, 0.60, 0.45, 0.72,0.64,0.48, 0.28,0.30,0.38, 0.11,0.13,0.06, 0.82,0.86,0.94, 14.0, 66.0, 1.00,
             pal(50,104,194), pal(90,150,218), pal(168,204,228), 0.18, 0.00, pal(242,240,228), pal(168,180,198));
    tod_key(12.0,  0.18, 0.96, 0.22, 0.58,0.56,0.50, 0.42,0.44,0.50, 0.13,0.16,0.07, 0.76,0.84,0.94, 20.0, 72.0, 1.00,
             pal(44,95,184),  pal(78,143,214), pal(168,210,232), 0.00, 0.00, pal(242,240,228), pal(150,163,184));
    tod_key(18.25,-0.72, 0.42,-0.55, 0.76,0.54,0.24, 0.24,0.22,0.32, 0.12,0.09,0.04, 0.96,0.72,0.44, 12.0, 64.0, 1.00,
             pal(46,74,142),  pal(138,90,130), pal(255,158,68),  0.55, 0.00, pal(255,192,112), pal(142,90,114));
    tod_key(19.5, -0.95, 0.08,-0.30, 0.44,0.24,0.30, 0.22,0.20,0.34, 0.06,0.05,0.05, 0.52,0.42,0.62,  6.0, 40.0, 0.90,
             pal(35,28,70),   pal(74,44,86),   pal(158,78,82),   0.60, 0.35, pal(180,112,122), pal(78,52,80));
    tod_key(22.0, -0.30,-0.55,-0.78, 0.22,0.24,0.34, 0.16,0.18,0.30, 0.03,0.04,0.06, 0.18,0.22,0.36,  4.0, 26.0, 0.55,
             pal(12,16,40),   pal(20,26,56),   pal(38,48,78),    0.70, 1.00, pal(58,66,96), pal(26,32,56));
    tod_key(26.0,  0.20,-0.90, 0.39, 0.14,0.16,0.26, 0.14,0.15,0.26, 0.02,0.03,0.05, 0.13,0.16,0.30,  3.0, 22.0, 0.45,
             pal(8,10,30),    pal(14,18,48),   pal(22,28,52),    0.70, 1.00, pal(42,48,80), pal(18,24,44));
}
tod_build();

let WX_CLEAR: i32 = 0;
let WX_OVERCAST: i32 = 1;
let WX_RAIN: i32 = 2;
let WX_STORM: i32 = 3;
let WX_BLOOM: i32 = 4;

fn wx_name(p_w: i32): string {
    if (p_w == WX_OVERCAST) { return "overcast"; }
    if (p_w == WX_RAIN) { return "rain"; }
    if (p_w == WX_STORM) { return "storm"; }
    if (p_w == WX_BLOOM) { return "bloom"; }
    return "clear";
}
fn wx_parse(p_s: string): i32 {
    if (p_s == "overcast") { return WX_OVERCAST; }
    if (p_s == "rain") { return WX_RAIN; }
    if (p_s == "storm") { return WX_STORM; }
    if (p_s == "bloom") { return WX_BLOOM; }
    if (p_s == "clear") { return WX_CLEAR; }
    return -1;
}

// The evaluated frame environment, one f64 per TOD_* field, after keyframe
// interpolation and the weather override. Read by the sky, the fog, the
let g_ev: array<f64> = [];
for (let i = 0; i < TOD_N; i++) { g_ev.push(0.0); }

// tod_eval: hours (0..24) + weather -> g_ev + the engine RenderEnv.
// Same shape as src/art/tod.hml's `tod_eval(env, day_t, weather)` (§5.3).
fn tod_eval(p_env: array<f64>, p_hours: f64, p_wx: i32, p_lightning: i32,
            p_fog_far_override: f64, p_mist_override: f64,
            p_camx: f64, p_camy: f64, p_camz: f64, p_ground: f64) {
    let h: f64 = p_hours;
    if (h < 2.0) { h = h + 24.0; }
    if (h > 26.0) { h = 26.0; }
    let k: i32 = 0;
    while (k < g_TOD_KEYS - 2 && g_tod[(k + 1) * TOD_N + TOD_HOUR] < h) { k++; }
    let h0: f64 = g_tod[k * TOD_N + TOD_HOUR];
    let h1: f64 = g_tod[(k + 1) * TOD_N + TOD_HOUR];
    let t: f64 = 0.0;
    if (h1 > h0) { t = clamp01((h - h0) / (h1 - h0)); }
    let a: i32 = k * TOD_N;
    let b: i32 = (k + 1) * TOD_N;
    for (let f = 0; f < TOD_N; f++) {
        g_ev[f] = lerpf(g_tod[a + f], g_tod[b + f], t);
    }

    // --- weather override (ART_BIBLE §5.2) --------------------------------
    let wx: i32 = p_wx;
    let sunmul: f64 = 1.0;
    let ambt: f64 = 0.0;
    let ambr: f64 = 0.0; let ambg: f64 = 0.0; let ambb: f64 = 0.0;
    let ftr: f64 = 1.0; let ftg: f64 = 1.0; let ftb: f64 = 1.0;
    let fnear: f64 = g_ev[TOD_FNEAR];
    let ffar: f64 = g_ev[TOD_FFAR];
    if (wx == WX_OVERCAST) {
        sunmul = 0.42; ambt = 0.65; ambr = 0.58; ambg = 0.59; ambb = 0.62;
        ftr = 0.94; ftg = 0.95; ftb = 0.97; fnear = 10.0; ffar = 48.0;
    } else if (wx == WX_RAIN) {
        sunmul = 0.30; ambt = 0.70; ambr = 0.44; ambg = 0.46; ambb = 0.52;
        ftr = 0.80; ftg = 0.84; ftb = 0.90; fnear = 6.0; ffar = 34.0;
    } else if (wx == WX_STORM) {
        sunmul = 0.20; ambt = 0.80; ambr = 0.30; ambg = 0.31; ambb = 0.38;
        ftr = 0.60; ftg = 0.62; ftb = 0.72; fnear = 3.0; ffar = 20.0;
    } else if (wx == WX_BLOOM) {
        sunmul = 0.55; ambt = 0.60; ambr = 0.22; ambg = 0.14; ambb = 0.32;
        ftr = 0.66; ftg = 0.40; ftb = 0.92; fnear = 5.0; ffar = 30.0;
    }
    g_ev[TOD_SUNR] = g_ev[TOD_SUNR] * sunmul;
    g_ev[TOD_SUNG] = g_ev[TOD_SUNG] * sunmul;
    g_ev[TOD_SUNB] = g_ev[TOD_SUNB] * sunmul;
    g_ev[TOD_AMBR] = lerpf(g_ev[TOD_AMBR], ambr, ambt);
    g_ev[TOD_AMBG] = lerpf(g_ev[TOD_AMBG], ambg, ambt);
    g_ev[TOD_AMBB] = lerpf(g_ev[TOD_AMBB], ambb, ambt);
    g_ev[TOD_FTR] = g_ev[TOD_FTR] * ftr;
    g_ev[TOD_FTG] = g_ev[TOD_FTG] * ftg;
    g_ev[TOD_FTB] = g_ev[TOD_FTB] * ftb;
    if (wx != WX_CLEAR) { g_ev[TOD_FNEAR] = fnear; g_ev[TOD_FFAR] = ffar; }

    // Lightning: two frames of flat blue-white ambient (§5.2). Two triangles
    // and one variable, for the most dramatic image in the game.
    if (p_lightning != 0) {
        g_ev[TOD_AMBR] = 0.90; g_ev[TOD_AMBG] = 0.92; g_ev[TOD_AMBB] = 1.00;
        g_ev[TOD_SUNR] = 0.10; g_ev[TOD_SUNG] = 0.08; g_ev[TOD_SUNB] = 0.00;
    }

    if (p_fog_far_override > 0.0) { g_ev[TOD_FFAR] = p_fog_far_override; }
    if (p_mist_override >= 0.0) { g_ev[TOD_MIST] = p_mist_override; }
    // CLAUDE.md §6: FOG_FAR never exceeds 72 m.
    if (g_ev[TOD_FFAR] > 72.0) { g_ev[TOD_FFAR] = 72.0; }
    if (g_ev[TOD_FNEAR] < 3.0) { g_ev[TOD_FNEAR] = 3.0; }
    if (g_ev[TOD_FNEAR] > g_ev[TOD_FFAR] - 4.0) { g_ev[TOD_FNEAR] = g_ev[TOD_FFAR] - 4.0; }

    // --- into the engine RenderEnv ----------------------------------------
    // At night SUN_DIR drives the moon term, negated (ART_BIBLE §5.1 note 1).
    let sx: f64 = g_ev[TOD_SUNX];
    let sy: f64 = g_ev[TOD_SUNY];
    let sz: f64 = g_ev[TOD_SUNZ];
    if (sy < 0.0) { sx = 0.0 - sx; sy = 0.0 - sy; sz = 0.0 - sz; }
    env_set_sun(p_env, sx, sy, sz, g_ev[TOD_SUNR], g_ev[TOD_SUNG], g_ev[TOD_SUNB]);
    env_set_ambient(p_env, g_ev[TOD_AMBR], g_ev[TOD_AMBG], g_ev[TOD_AMBB]);
    env_set_bounce(p_env, g_ev[TOD_BNCR], g_ev[TOD_BNCG], g_ev[TOD_BNCB]);
    env_set_camera(p_env, p_camx, p_camy, p_camz);
    env_set_fog(p_env, g_ev[TOD_FNEAR], g_ev[TOD_FFAR],
                g_ev[TOD_FTR], g_ev[TOD_FTG], g_ev[TOD_FTB], g_ev[TOD_FAMAX]);
    // §6.4 height fog. The literal reading of "MIST_BOTTOM = terrain height"
    // puts every ground vertex at h = 1 and drowns the whole world in mist —
    // the point is that VALLEYS fill and hilltops stand clear, so the band is
    // an absolute world-Y band pinned just BELOW the camera's own ground.
    // Walking downhill then visibly submerges you, which is the effect §6.4
    // is actually describing.
    env_set_mist(p_env, p_ground - 1.1, p_ground - 4.6, g_ev[TOD_MIST]);
}

// --- texture generation (ART_BIBLE §7 -> src/art/texgen.hml, W2-5) --------
// array lookup at every ramp boundary, always (§7.1 rule 2).
let g_bayer: array<i32> = [ 0, 8, 2,10, 12, 4,14, 6, 3,11, 1, 9, 15, 7,13, 5];

let g_ATLAS_W: i32 = 128;       // 4x4 cells of 32x32 => 12.5 cm/texel on ground
let g_CELL: i32 = 32;
let g_atlas_world = null;
let g_atlas_fx = null;
let g_atlas_hud = null;
let g_font = null;
let g_tex_world = null;
let g_tex_fx = null;
let g_tex_hud = null;

// Cell indices into ATLAS_WORLD.
let CELL_GRASS: i32 = 0;
let CELL_DIRT: i32 = 1;
let CELL_STONE: i32 = 2;
let CELL_SNOW: i32 = 3;
let CELL_BARK: i32 = 4;
let CELL_PINE: i32 = 5;
let CELL_WOOD: i32 = 6;
let CELL_CONCRETE: i32 = 7;
let CELL_METAL: i32 = 8;
let CELL_PLASTER: i32 = 9;
let CELL_ROOF: i32 = 10;
let CELL_WINDOW: i32 = 11;
let CELL_NSFLORA: i32 = 12;
let CELL_GRANITE: i32 = 13;
let CELL_GUNMETAL: i32 = 14;
let CELL_MISSING: i32 = 15;      // magenta, impossible to miss in a screenshot

// FX atlas cells (64x64, 4x4 of 16x16).
let FX_GLOW: i32 = 0;
let FX_SPARK: i32 = 1;
let FX_STREAK: i32 = 2;
let FX_MOTE: i32 = 3;

// One tile: a 3-step value ramp of one family, structure at 4-10 texels,
// Bayer at the ramp boundary, grain +/- 6 luminance. Never per-texel noise.
fn tg_tile(p_cell: i32, p_lo: i32, p_mid: i32, p_hi: i32,
           p_scale: f64, p_seed: i32, p_grain: i32) {
    let a = g_atlas_world;
    let cx: i32 = (p_cell % 4) * g_CELL;
    let cy: i32 = divi(p_cell, 4) * g_CELL;
    let lr: i32 = pal_r(p_lo);  let lg: i32 = pal_g(p_lo);  let lb: i32 = pal_b(p_lo);
    let mr: i32 = pal_r(p_mid); let mg: i32 = pal_g(p_mid); let mb: i32 = pal_b(p_mid);
    let hr: i32 = pal_r(p_hi);  let hg: i32 = pal_g(p_hi);  let hb: i32 = pal_b(p_hi);
    for (let y = 0; y < g_CELL; y++) {
        for (let x = 0; x < g_CELL; x++) {
            // structure: two octaves, coarsest at ~8 texels
            let n0: f64 = vnoise2(f64(x) * p_scale, f64(y) * p_scale, p_seed);
            let n1: f64 = vnoise2(f64(x) * p_scale * 2.0, f64(y) * p_scale * 2.0, p_seed + 7);
            let v: f64 = clamp01(n0 * 0.68 + n1 * 0.32);
            let d: f64 = f64(g_bayer[(y % 4) * 4 + (x % 4)]) * 0.0625 - 0.5;
            let vv: f64 = clamp01(v + d * 0.16);
            let r: i32 = 0; let g: i32 = 0; let b: i32 = 0;
            if (vv < 0.42) {
                let t: f64 = vv * 2.380952;
                r = i32(lerpf(f64(lr), f64(mr), t));
                g = i32(lerpf(f64(lg), f64(mg), t));
                b = i32(lerpf(f64(lb), f64(mb), t));
            } else {
                let t2: f64 = (vv - 0.42) * 1.724137;
                if (t2 > 1.0) { t2 = 1.0; }
                r = i32(lerpf(f64(mr), f64(hr), t2));
                g = i32(lerpf(f64(mg), f64(hg), t2));
                b = i32(lerpf(f64(mb), f64(hb), t2));
            }
            // grain: +/- p_grain luminance, never structure
            let gq: i32 = i32(h2(x, y, p_seed + 991) * f64(p_grain * 2 + 1)) - p_grain;
            r = clampi(r + gq, 0, 255);
            g = clampi(g + gq, 0, 255);
            b = clampi(b + gq, 0, 255);
            atlas_px(a, cx + x, cy + y, r, g, b, 255);
        }
    }
}

// Horizontal plank / brick banding on top of a tile: 4-texel structure.
fn tg_bands(p_cell: i32, p_period: i32, p_dark: i32) {
    let a = g_atlas_world;
    let cx: i32 = (p_cell % 4) * g_CELL;
    let cy: i32 = divi(p_cell, 4) * g_CELL;
    for (let y = 0; y < g_CELL; y++) {
        if (y % p_period == 0) {
            for (let x = 0; x < g_CELL; x++) {
                let base: u32 = 0;
                // read-modify-write through atlas_px only: darken the seam row
                let px: i32 = cx + x;
                let py: i32 = cy + y;
                let p: ptr = atlas_base(a);
                let o: i32 = (py * g_ATLAS_W + px) * 4;
                let r: i32 = ptr_deref_u8(ptr_offset(p, o, 1));
                let g: i32 = ptr_deref_u8(ptr_offset(p, o + 1, 1));
                let b: i32 = ptr_deref_u8(ptr_offset(p, o + 2, 1));
                atlas_px(a, px, py, clampi(r - p_dark, 0, 255),
                         clampi(g - p_dark, 0, 255), clampi(b - p_dark, 0, 255), 255);
            }
        }
    }
}

fn texgen_build_world_atlas() {
    g_atlas_world = atlas_new(g_ATLAS_W, g_ATLAS_W, 4, 4);
    atlas_fill(g_atlas_world, 0, 0, 0, 255);
    tg_tile(CELL_GRASS,    g_GRASS_LO, g_GRASS_MID, g_GRASS_HI,   0.17, 11, 5);
    tg_tile(CELL_DIRT,     g_DIRT_LO, g_DIRT_MID, g_DIRT_HI,      0.15, 23, 6);
    tg_tile(CELL_STONE,    g_STONE_LO, g_STONE_MID, g_STONE_HI,   0.13, 31, 4);
    tg_tile(CELL_SNOW,     g_SNOW_LO, g_SNOW_LO, g_SNOW_HI,       0.11, 41, 3);
    tg_tile(CELL_BARK,     g_BARK_LO, g_BARK_LO, g_BARK_HI,       0.09, 53, 5);
    tg_tile(CELL_PINE,     g_PINE_LO, g_PINE_LO, g_PINE_HI,       0.21, 61, 6);
    tg_tile(CELL_WOOD,     g_WOOD_LO, g_WOOD_MID, g_WOOD_HI,      0.10, 71, 4);
    tg_tile(CELL_CONCRETE, g_CONCRETE_LO, g_CONCRETE_MID, g_CONCRETE_HI, 0.12, 83, 4);
    tg_tile(CELL_METAL,    g_STEEL_LO, g_STEEL_MID, g_RUST,       0.14, 97, 4);
    tg_tile(CELL_PLASTER,  g_FABRIC_CREAM, g_FABRIC_CREAM, g_PAINT_OCHRE, 0.10, 103, 3);
    tg_tile(CELL_ROOF,     g_ROOF_TILE, g_ROOF_TILE, g_PAINT_OCHRE, 0.16, 109, 5);
    tg_tile(CELL_WINDOW,   g_WINDOW_WARM, g_WINDOW_WARM, g_MUZZLE_CORE, 0.08, 113, 2);
    tg_tile(CELL_NSFLORA,  g_NS_FLORA, g_NS_MID, g_NS_CORE,       0.19, 127, 5);
    tg_tile(CELL_GRANITE,  g_GRANITE_LO, g_GRANITE_LO, g_GRANITE_HI, 0.13, 131, 4);
    tg_tile(CELL_GUNMETAL, g_GUNMETAL_LO, g_GUNMETAL_LO, g_GUNMETAL_HI, 0.10, 137, 3);
    // The missing-texture tile ships MAGENTA on purpose (CLAUDE.md §9 rule 7).
    tg_tile(CELL_MISSING,  pal(255, 0, 255), pal(255, 0, 255), pal(190, 0, 190), 0.25, 149, 0);
    tg_bands(CELL_WOOD, 8, 26);
    tg_bands(CELL_ROOF, 6, 22);
    tg_bands(CELL_CONCRETE, 16, 14);
    tg_bands(CELL_PLASTER, 32, 0);
}

// One additive sprite: radial falloff to alpha 0, colour constant. Additive
// content is authored bright and small; the alpha ramp is the shape.
fn fx_sprite(p_cell: i32, p_c: i32, p_pow: f64, p_streak: i32) {
    let a = g_atlas_fx;
    let n: i32 = 16;
    let cx: i32 = (p_cell % 4) * n;
    let cy: i32 = divi(p_cell, 4) * n;
    let r: i32 = pal_r(p_c); let g: i32 = pal_g(p_c); let b: i32 = pal_b(p_c);
    for (let y = 0; y < n; y++) {
        for (let x = 0; x < n; x++) {
            let dx: f64 = (f64(x) + 0.5) / f64(n) * 2.0 - 1.0;
            let dy: f64 = (f64(y) + 0.5) / f64(n) * 2.0 - 1.0;
            if (p_streak != 0) { dx = dx * 3.2; }
            let d: f64 = sqrt(dx * dx + dy * dy);
            let f: f64 = clamp01(1.0 - d);
            let al: f64 = f;
            let k: f64 = p_pow;
            while (k > 1.0) { al = al * f; k = k - 1.0; }
            // Bayer the alpha ramp too: no banding in a 16 px sprite.
            let dd: f64 = f64(g_bayer[(y % 4) * 4 + (x % 4)]) * 0.0625 - 0.5;
            let av: i32 = clampi(i32(al * 255.0 + dd * 10.0), 0, 255);
            atlas_px(a, cx + x, cy + y, r, g, b, av);
        }
    }
}

fn fxgen_build_atlas() {
    g_atlas_fx = atlas_new(64, 64, 4, 4);
    atlas_fill(g_atlas_fx, 0, 0, 0, 0);
    fx_sprite(FX_GLOW, g_MUZZLE_CORE, 2.0, 0);
    fx_sprite(FX_SPARK, g_MUZZLE_MID, 4.0, 0);
    fx_sprite(FX_STREAK, g_UI_WHITE, 2.0, 1);
    fx_sprite(FX_MOTE, g_NS_HALO, 3.0, 0);
}

// --- FONT_MICRO 4x6 (-> src/art/hudgen.hml, W2-7) -------------------------
// 3x5 pixel glyphs inside a 4x6 cell, hand-built bitfields. Never scaled,
// never filtered (CLAUDE.md §9 rule 8).
fn g5(p_cp: i32, p_a: i32, p_b: i32, p_c: i32, p_d: i32, p_e: i32) {
    font_add_glyph(g_font, p_cp, [p_a * 2, p_b * 2, p_c * 2, p_d * 2, p_e * 2, 0]);
}

fn hudgen_build_font() {
    g_font = font_new(4, 6, 4, 7, 64);
    g5(32, 0,0,0,0,0);          // space
    g5(48, 7,5,5,5,7);          // 0
    g5(49, 2,6,2,2,7);
    g5(50, 7,1,7,4,7);
    g5(51, 7,1,7,1,7);
    g5(52, 5,5,7,1,1);
    g5(53, 7,4,7,1,7);
    g5(54, 7,4,7,5,7);
    g5(55, 7,1,1,1,1);
    g5(56, 7,5,7,5,7);
    g5(57, 7,5,7,1,7);          // 9
    g5(65, 7,5,7,5,5);          // A
    g5(66, 6,5,6,5,6);
    g5(67, 7,4,4,4,7);
    g5(68, 6,5,5,5,6);
    g5(69, 7,4,7,4,7);
    g5(70, 7,4,7,4,4);
    g5(71, 7,4,5,5,7);
    g5(72, 5,5,7,5,5);
    g5(73, 7,2,2,2,7);
    g5(74, 1,1,1,5,7);
    g5(75, 5,5,6,5,5);
    g5(76, 4,4,4,4,7);
    g5(77, 5,7,7,5,5);
    g5(78, 5,7,7,7,5);
    g5(79, 7,5,5,5,7);
    g5(80, 7,5,7,4,4);
    g5(81, 7,5,5,7,3);
    g5(82, 7,5,7,6,5);
    g5(83, 7,4,7,1,7);
    g5(84, 7,2,2,2,2);
    g5(85, 5,5,5,5,7);
    g5(86, 5,5,5,5,2);
    g5(87, 5,5,7,7,5);
    g5(88, 5,5,2,5,5);
    g5(89, 5,5,2,2,2);
    g5(90, 7,1,2,4,7);          // Z
    g5(46, 0,0,0,0,2);          // .
    g5(58, 0,2,0,2,0);          // :
    g5(47, 1,1,2,4,4);          // /
    g5(45, 0,0,7,0,0);          // -
    g5(37, 5,1,2,4,5);          // %
    g5(43, 0,2,7,2,0);          // +
}

let g_uv_white: array<f64> = [0.0, 0.0, 0.0, 0.0];

fn hudgen_build_atlas() {
    g_atlas_hud = atlas_new(128, 128, 8, 8);
    atlas_fill(g_atlas_hud, 0, 0, 0, 0);
    // a 4x4 opaque white block at (0,0): the one texel every flat HUD rect and
    // the vignette ring samples, so the whole layer is one texture run.
    for (let y = 0; y < 4; y++) {
        for (let x = 0; x < 4; x++) { atlas_px(g_atlas_hud, x, y, 255, 255, 255, 255); }
    }
    atlas_rect_uv(g_atlas_hud, 1, 1, 2, 2, g_uv_white, 0);
    hudgen_build_font();
    font_bake(g_font, atlas_base(g_atlas_hud), 128, 128, 0, 8, 16, 255, 255, 255, 255);
}

let g_SKY_W: i32 = 128;
let g_SKY_H: i32 = 128;
let g_SKY_HORIZON_V: f64 = 0.78;
let g_atlas_sky = null;
let g_tex_sky = null;

fn skygen_build() {
    if (g_atlas_sky == null) { g_atlas_sky = atlas_new(g_SKY_W, g_SKY_H, 1, 1); }
    let zr: f64 = g_ev[TOD_ZENR]; let zg: f64 = g_ev[TOD_ZENG]; let zb: f64 = g_ev[TOD_ZENB];
    let mr: f64 = g_ev[TOD_MIDR]; let mg: f64 = g_ev[TOD_MIDG]; let mb: f64 = g_ev[TOD_MIDB];
    let hr: f64 = g_ev[TOD_HORR]; let hg: f64 = g_ev[TOD_HORG]; let hb: f64 = g_ev[TOD_HORB];
    let star: f64 = g_ev[TOD_STAR];
    let hy: i32 = i32(f64(g_SKY_H) * g_SKY_HORIZON_V);
    for (let y = 0; y < g_SKY_H; y++) {
        let t: f64 = f64(y) / f64(hy);
        let r: f64 = 0.0; let g: f64 = 0.0; let b: f64 = 0.0;
        if (y <= hy) {
            if (t < 0.55) {
                let k: f64 = t / 0.55;
                r = lerpf(zr, mr, k); g = lerpf(zg, mg, k); b = lerpf(zb, mb, k);
            } else {
                let k2: f64 = (t - 0.55) / 0.45;
                r = lerpf(mr, hr, k2); g = lerpf(mg, hg, k2); b = lerpf(mb, hb, k2);
            }
        } else {
            // Below the horizon: the fog target, darkening CONTINUOUSLY from
            // the horizon band. It must start at exactly the horizon colour —
            // a step here is the visible seam at the skyline that ART_BIBLE
            // §6.6 calls the classic amateur tell.
            let k3: f64 = f64(y - hy) / f64(g_SKY_H - hy);
            let m3: f64 = 1.0 - 0.42 * k3;
            r = hr * m3; g = hg * m3; b = hb * m3;
        }
        for (let x = 0; x < g_SKY_W; x++) {
            let rr: f64 = r; let gg: f64 = g; let bb2: f64 = b;
            if (y < hy) {
                // two cloud layers, lit top / shadow bottom
                let ch: f64 = f64(y) / f64(hy);
                let c0: f64 = vnoise2(f64(x) * 0.075, f64(y) * 0.16, 5001);
                let c1: f64 = vnoise2(f64(x) * 0.031, f64(y) * 0.075, 5003);
                let cov: f64 = clamp01((c0 * 0.55 + c1 * 0.45 - 0.44) * 3.4)
                             * clamp01((ch - 0.06) * 2.4) * clamp01((0.94 - ch) * 4.0);
                if (cov > 0.02) {
                    // lit top / shadowed bottom: the vertical gradient of the
                    // noise field IS the light direction (ART_BIBLE §11).
                    let lit: f64 = clamp01((vnoise2(f64(x) * 0.075, f64(y) * 0.16 - 0.55, 5001)
                                            - c0) * 2.2 + 0.5);
                    let cr: f64 = lerpf(g_ev[TOD_CSR], g_ev[TOD_CLR], lit);
                    let cg: f64 = lerpf(g_ev[TOD_CSG], g_ev[TOD_CLG], lit);
                    let cb: f64 = lerpf(g_ev[TOD_CSB], g_ev[TOD_CLB], lit);
                    rr = lerpf(rr, cr, cov);
                    gg = lerpf(gg, cg, cov);
                    bb2 = lerpf(bb2, cb, cov);
                }
                if (star > 0.01) {
                    let sv: f64 = h2(x, y, 7717);
                    if (sv > 0.99905) {
                        // STAR_BRIGHT / STAR_DIM, faded out toward the horizon
                        let tier: f64 = h2(x, y, 7719);
                        let fade: f64 = clamp01((0.80 - ch) * 1.6);
                        let br2: f64 = star * fade * lerpf(52.0, 150.0, tier);
                        rr = rr + br2; gg = gg + br2; bb2 = bb2 + br2 * 0.92;
                    }
                }
            }
            // Bayer at every ramp boundary, always.
            let d: f64 = f64(g_bayer[(y % 4) * 4 + (x % 4)]) * 0.0625 - 0.46875;
            atlas_px(g_atlas_sky, x, y,
                     clampi(i32(rr + d * 5.0), 0, 255),
                     clampi(i32(gg + d * 5.0), 0, 255),
                     clampi(i32(bb2 + d * 5.0), 0, 255), 255);
        }
    }
}

// ===========================================================================
// ###################  WAVE-2 STAND-IN CONTENT — END  #######################
// ===========================================================================

// ===========================================================================
// THE VIEWER
// ===========================================================================

let g_MAG: i32 = 4;                 // integer magnification, nearest neighbour
let g_out_dir: string = ".";

// A 3x5 glyph blitter straight into the RGB output buffer. The atlas font is
// baked into ATLAS_HUD and cannot be used to LABEL ATLAS_HUD, so the overlay
// carries its own copy — 40 lines, and it means a label bug can never be
// mistaken for a font bug.
let g_lbl: array<i32> = [];

fn lbl_add(p_cp: i32, p_a: i32, p_b: i32, p_c: i32, p_d: i32, p_e: i32) {
    g_lbl.push(p_cp);
    g_lbl.push(p_a); g_lbl.push(p_b); g_lbl.push(p_c); g_lbl.push(p_d); g_lbl.push(p_e);
}

fn lbl_build() {
    lbl_add(32, 0,0,0,0,0);
    lbl_add(48, 7,5,5,5,7); lbl_add(49, 2,6,2,2,7); lbl_add(50, 7,1,7,4,7);
    lbl_add(51, 7,1,7,1,7); lbl_add(52, 5,5,7,1,1); lbl_add(53, 7,4,7,1,7);
    lbl_add(54, 7,4,7,5,7); lbl_add(55, 7,1,1,1,1); lbl_add(56, 7,5,7,5,7);
    lbl_add(57, 7,5,7,1,7);
    lbl_add(65, 7,5,7,5,5); lbl_add(66, 6,5,6,5,6); lbl_add(67, 7,4,4,4,7);
    lbl_add(68, 6,5,5,5,6); lbl_add(69, 7,4,7,4,7); lbl_add(70, 7,4,7,4,4);
    lbl_add(71, 7,4,5,5,7); lbl_add(72, 5,5,7,5,5); lbl_add(73, 7,2,2,2,7);
    lbl_add(74, 1,1,1,5,7); lbl_add(75, 5,5,6,5,5); lbl_add(76, 4,4,4,4,7);
    lbl_add(77, 5,7,7,5,5); lbl_add(78, 5,7,7,7,5); lbl_add(79, 7,5,5,5,7);
    lbl_add(80, 7,5,7,4,4); lbl_add(81, 7,5,5,7,3); lbl_add(82, 7,5,7,6,5);
    lbl_add(83, 7,4,7,1,7); lbl_add(84, 7,2,2,2,2); lbl_add(85, 5,5,5,5,7);
    lbl_add(86, 5,5,5,5,2); lbl_add(87, 5,5,7,7,5); lbl_add(88, 5,5,2,5,5);
    lbl_add(89, 5,5,2,2,2); lbl_add(90, 7,1,2,4,7);
    lbl_add(46, 0,0,0,0,2); lbl_add(58, 0,2,0,2,0); lbl_add(47, 1,1,2,4,4);
    lbl_add(45, 0,0,7,0,0); lbl_add(95, 0,0,0,0,7); lbl_add(37, 5,1,2,4,5);
}
lbl_build();

let g_img: buffer = buffer(1);
let g_iw: i32 = 1;
let g_ih: i32 = 1;

fn img_new(p_w: i32, p_h: i32) {
    g_iw = p_w;
    g_ih = p_h;
    g_img = buffer(p_w * p_h * 3);
}

fn img_px(p_x: i32, p_y: i32, p_r: i32, p_g: i32, p_b: i32) {
    if (p_x < 0 || p_y < 0 || p_x >= g_iw || p_y >= g_ih) { return; }
    let o: i32 = (p_y * g_iw + p_x) * 3;
    let p: ptr = buffer_ptr(g_img);
    ptr_write_u8(ptr_offset(p, o, 1), p_r & 255);
    ptr_write_u8(ptr_offset(p, o + 1, 1), p_g & 255);
    ptr_write_u8(ptr_offset(p, o + 2, 1), p_b & 255);
}

fn img_fill(p_r: i32, p_g: i32, p_b: i32) {
    for (let y = 0; y < g_ih; y++) {
        for (let x = 0; x < g_iw; x++) { img_px(x, y, p_r, p_g, p_b); }
    }
}

fn img_rect(p_x: i32, p_y: i32, p_w: i32, p_h: i32, p_c: i32) {
    for (let y = 0; y < p_h; y++) {
        for (let x = 0; x < p_w; x++) {
            img_px(p_x + x, p_y + y, pal_r(p_c), pal_g(p_c), pal_b(p_c));
        }
    }
}

fn img_text(p_x: i32, p_y: i32, p_s: string, p_c: i32) {
    let n: i32 = g_lbl.length;
    let cx: i32 = p_x;
    for (let i = 0; i < p_s.length; i++) {
        let cp: i32 = i32(p_s.byte_at(i));
        let gi: i32 = -1;
        for (let k = 0; k < n; k = k + 6) {
            if (g_lbl[k] == cp) { gi = k; }
        }
        if (gi >= 0) {
            for (let r = 0; r < 5; r++) {
                let bits: i32 = g_lbl[gi + 1 + r];
                for (let c = 0; c < 3; c++) {
                    if (((bits >> (2 - c)) & 1) == 1) {
                        // 1-px UI_BLACK shadow at (+1,+1), always
                        img_px(cx + c + 1, p_y + r + 1, 10, 12, 16);
                    }
                }
            }
            for (let r2 = 0; r2 < 5; r2++) {
                let bits2: i32 = g_lbl[gi + 1 + r2];
                for (let c2 = 0; c2 < 3; c2++) {
                    if (((bits2 >> (2 - c2)) & 1) == 1) {
                        img_px(cx + c2, p_y + r2, pal_r(p_c), pal_g(p_c), pal_b(p_c));
                    }
                }
            }
        }
        cx = cx + 4;
    }
}

// Composite one RGBA atlas over a checkerboard so alpha is VISIBLE rather than
// guessed, magnified by g_MAG, with a cell grid and a label per cell.
fn dump_atlas(p_a, p_w: i32, p_h: i32, p_cx: i32, p_cy: i32,
              p_title: string, p_names: array, p_file: string): i32 {
    let mag: i32 = g_MAG;
    let pad: i32 = 12;
    let iw: i32 = p_w * mag + pad * 2;
    let ih: i32 = p_h * mag + pad * 2 + 10;
    img_new(iw, ih);
    img_fill(24, 26, 30);
    let base: ptr = atlas_base(p_a);
    for (let y = 0; y < p_h * mag; y++) {
        for (let x = 0; x < p_w * mag; x++) {
            let sx: i32 = divi(x, mag);
            let sy: i32 = divi(y, mag);
            let o: i32 = (sy * p_w + sx) * 4;
            let r: i32 = ptr_deref_u8(ptr_offset(base, o, 1));
            let g: i32 = ptr_deref_u8(ptr_offset(base, o + 1, 1));
            let b: i32 = ptr_deref_u8(ptr_offset(base, o + 2, 1));
            let a: i32 = ptr_deref_u8(ptr_offset(base, o + 3, 1));
            // 8-px checker under the alpha
            let ck: i32 = 64;
            if ((divi(x, 8) + divi(y, 8)) % 2 == 0) { ck = 100; }
            let af: f64 = f64(a) / 255.0;
            img_px(pad + x, pad + 10 + y,
                   i32(f64(r) * af + f64(ck) * (1.0 - af)),
                   i32(f64(g) * af + f64(ck) * (1.0 - af)),
                   i32(f64(b) * af + f64(ck) * (1.0 - af)));
        }
    }
    // cell grid + labels
    let cw: i32 = divi(p_w, p_cx);
    let ch: i32 = divi(p_h, p_cy);
    for (let j = 0; j <= p_cy; j++) {
        for (let x2 = 0; x2 < p_w * mag; x2++) {
            img_px(pad + x2, pad + 10 + j * ch * mag, 255, 60, 200);
        }
    }
    for (let i2 = 0; i2 <= p_cx; i2++) {
        for (let y2 = 0; y2 < p_h * mag; y2++) {
            img_px(pad + i2 * cw * mag, pad + 10 + y2, 255, 60, 200);
        }
    }
    let nn: i32 = p_names.length;
    for (let cyi = 0; cyi < p_cy; cyi++) {
        for (let cxi = 0; cxi < p_cx; cxi++) {
            let idx: i32 = cyi * p_cx + cxi;
            if (idx < nn) {
                img_text(pad + cxi * cw * mag + 3, pad + 10 + cyi * ch * mag + 3,
                         p_names[idx], pal(255, 220, 110));
            }
        }
    }
    img_text(pad, 3, p_title, pal(244, 244, 236));
    write_png(p_file, g_img, iw, ih);
    if (exists(p_file) == false) {
        eprint(`texview: failed to write ${p_file}`);
        let bad: i32 = -1;
        return bad;
    }
    print(`wrote ${p_file}  (${p_w}x${p_h} RGBA, ${p_cx}x${p_cy} cells of ${cw}x${ch}, magnified ${mag}x)`);
    let ok: i32 = 0;
    return ok;
}

fn running_interpreted(): bool {
    if (args.length < 1) { return false; }
    let a0: string = args[0];
    let out: bool = a0.ends_with(".hml");
    return out;
}

fn main() {
    if (running_interpreted()) {
        eprint("texview.hml is COMPILED-ONLY (ARCHITECTURE.md §7).");
        eprint("    hemlockc -O1 tools/texview.hml -o /tmp/texview && /tmp/texview --out docs/shots");
        exit(2);
    }
    let tod_h: f64 = 12.0;
    let wx: i32 = WX_CLEAR;
    let i: i32 = 1;
    while (i < args.length) {
        let a: string = args[i];
        if (a == "--out" && i + 1 < args.length) { i++; g_out_dir = args[i]; }
        else if (a == "--mag" && i + 1 < args.length) {
            i++;
            g_MAG = clampi(i32(f64(args[i])), 1, 8);
        }
        else if (a == "--tod" && i + 1 < args.length) { i++; tod_h = f64(args[i]); }
        else if (a == "--weather" && i + 1 < args.length) {
            i++;
            wx = wx_parse(args[i]);
            if (wx < 0) { eprint("texview: unknown weather"); exit(2); }
        }
        else if (a == "--help") {
            print("texview.hml — dump ATLAS_WORLD / ATLAS_FX / ATLAS_HUD / TEX_SKY to PNG");
            print("  --out <dir>   output directory (default .)");
            print("  --mag <n>     magnification 1..8 (default 4)");
            print("  --tod <h>     time of day for TEX_SKY (default 12)");
            print("  --weather <name>  clear|overcast|rain|storm|bloom");
            exit(0);
        }
        else { eprint(`texview: unknown argument '${a}'`); exit(2); }
        i++;
    }
    if (g_out_dir != "." && exists(g_out_dir) == false) { make_dirs(g_out_dir); }

    texgen_build_world_atlas();
    fxgen_build_atlas();
    hudgen_build_atlas();
    let env: array<f64> = env_new();
    tod_eval(env, tod_h, wx, 0, -1.0, -1.0, 0.0, 1.7, 0.0, 0.0);
    skygen_build();

    let wnames: array = ["GRASS", "DIRT", "STONE", "SNOW",
                         "BARK", "PINE", "WOOD", "CONCR",
                         "METAL", "PLAST", "ROOF", "WINDW",
                         "NSFLR", "GRANT", "GUNMT", "MISSNG"];
    let fnames: array = ["GLOW", "SPARK", "STREAK", "MOTE",
                         "", "", "", "", "", "", "", "", "", "", "", ""];
    let hnames: array = ["WHITE", "", "", "", "", "", "", "",
                         "FONT", "", "", "", "", "", "", ""];
    let snames: array = ["TEX_SKY"];

    let rc: i32 = 0;
    rc = rc + dump_atlas(g_atlas_world, g_ATLAS_W, g_ATLAS_W, 4, 4,
                         "ATLAS_WORLD 128X128 RGBA BLEND", wnames,
                         g_out_dir + "/tex_world.png");
    rc = rc + dump_atlas(g_atlas_fx, 64, 64, 4, 4,
                         "ATLAS_FX 64X64 RGBA ADD", fnames,
                         g_out_dir + "/tex_fx.png");
    rc = rc + dump_atlas(g_atlas_hud, 128, 128, 8, 8,
                         "ATLAS_HUD 128X128 RGBA BLEND", hnames,
                         g_out_dir + "/tex_hud.png");
    rc = rc + dump_atlas(g_atlas_sky, g_SKY_W, g_SKY_H, 1, 1,
                         "TEX_SKY 128X128 RGBA NONE", snames,
                         g_out_dir + "/tex_sky.png");
    if (rc != 0) { exit(4); }
    print("texview: 4 textures written. There are exactly four (CLAUDE.md §6).");
    exit(0);
}

main();
