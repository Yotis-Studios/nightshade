let g_VERSION: string = "walk.hml W3-0b (the playable walkaround)";

let g_CHUNK_Q: i32 = 8;                 // quads per chunk edge
let g_QUAD_M: f64 = 4.0;                // metres per terrain quad (<= 4 m, §6)
let g_CHUNK_M: f64 = 32.0;              // g_CHUNK_Q * g_QUAD_M
let g_CHUNK_SLOTS: i32 = 72;            // mesh pool; a 7x7 ring is 49
let g_CHUNK_BUILD_PER_FRAME: i32 = 2;   // g_BUDGET_CHUNKGEN_MS, amortised
let g_SITE_M: f64 = 96.0;               // the landmark lattice
let g_SITE_SLOTS: i32 = 12;
let g_SITE_GLOWS: i32 = 4;              // window/lantern glows recorded per site
let g_APRON_SEGS: i32 = 24;
let g_APRON_SNAP: f64 = 0.25;           // the apron re-centres on this lattice

// GDD §2.3. The walkaround does not simulate acceleration — W3-9 owns the real
// movement model and this file must not grow a second one — but the SPEEDS are
// the GDD's, because "how fast does 4.4 m/s feel through this fog" is one of
// the questions the owner is being asked.
let g_SPEED_WALK: f64 = 4.4;
let g_SPEED_SPRINT: f64 = 7.0;
let g_SPEED_FLY: f64 = 14.0;
let g_SPEED_FLY_FAST: f64 = 44.0;
let g_EYE_H: f64 = 1.7;

// tod.hml is authored on the D6 16-minute day. This is the whole point of the
// `[` / `]` scrub: one real second is 1/960 of a game day.
let g_DAY_SECONDS: f64 = 960.0;
let g_SCRUB_H_PER_S: f64 = 3.0;         // held-key scrub, game-hours per second

// Scancodes sdl.hml does not name. SDL_SCANCODE_LEFTBRACKET/RIGHTBRACKET/
// MINUS/EQUALS/COMMA/PERIOD, from SDL_scancode.h — all far below 2.0.18.
let g_SC_LBRACKET: i32 = 47;
let g_SC_RBRACKET: i32 = 48;
let g_SC_MINUS: i32 = 45;
let g_SC_EQUALS: i32 = 46;

// ===========================================================================
// 1. POSITION-KEYED RANDOMNESS
// ---------------------------------------------------------------------------
// Everything scattered in this world is a pure function of WHERE IT IS, never
// of the order it was generated in. That is what makes walking away and coming
// back show you the same trees, and it is why there is no xorshift stream in
// this file the way there is in shot.hml. `h2` is the frame graph's own
// position hash, imported, so the harness and the walkaround agree.
// ===========================================================================

fn hrange(p_a: i32, p_b: i32, p_s: i32, p_lo: f64, p_hi: f64): f64 {
    let t: f64 = h2(p_a, p_b, p_s);
    let out: f64 = p_lo + (p_hi - p_lo) * t;
    return out;
}

// ===========================================================================
// 2. THE ART — built once at boot, straight out of src/art
// ===========================================================================

let g_atlas_world = null;
let g_atlas_fx = null;
let g_atlas_hud = null;
let g_tex_world = null;
let g_tex_fx = null;
let g_tex_hud = null;
let g_tex_sky = null;
let g_world_cells: i32 = 0;
let g_mesh_tris: i32 = 0;

let g_uvq: array<f64> = [0.0, 0.0, 0.0, 0.0];
let g_uvw: array<f64> = [0.0, 0.0, 0.0, 0.0];
let g_rect: array<i32> = [0, 0, 0, 0];
let g_skyk: array<f64> = [];
let g_todsky: array<f64> = [];

fn art_bind_materials() {
    meshgen_set_material_uv(MG_MAT_BARK, 0.0, 0.0, 0.0, 0.0);
    let pairs: array<i32> = [
        MG_MAT_BARK, 18, MG_MAT_LEAF, 20, MG_MAT_STONE, 8,
        MG_MAT_WOOD, 16, MG_MAT_METAL, 27, MG_MAT_CONCRETE, 24,
        MG_MAT_CLOTH, 35, MG_MAT_HIDE, 17, MG_MAT_DIRT, 3,
        MG_MAT_GLASS, 38
    ];
    let n: i32 = pairs.length;
    for (let i = 0; i < n; i = i + 2) {
        atlas_cell_uv(g_atlas_world, pairs[i + 1], g_uvq, 0);
        meshgen_set_material_uv(pairs[i], g_uvq[0], g_uvq[1], g_uvq[2], g_uvq[3]);
    }
}

fn art_build(p_win) {
    g_atlas_world = atlas_new(g_ATLAS_WORLD_PX, g_ATLAS_WORLD_PX,
                              g_ATLAS_WORLD_CELLS, g_ATLAS_WORLD_CELLS);
    g_world_cells = texgen_build_world_atlas(g_atlas_world, 1337);
    g_atlas_fx = fxgen_build_atlas();
    g_atlas_hud = hudgen_build_atlas();
    hudgen_uv(HUD_SOLID, g_uvw, 0);
    art_bind_materials();
    g_mesh_tris = meshgen_build_all();

    skygen_init();
    skygen_set_clock(0.0);          // no wall clock ever reaches the bake
    g_skyk = skygen_keys_new();
    g_todsky = [];
    for (let i = 0; i < TODSKY_COUNT; i++) { g_todsky.push(0.0); }

    g_tex_world = atlas_upload(p_win, g_atlas_world, BLEND_BLEND);
    g_tex_fx = atlas_upload(p_win, g_atlas_fx, BLEND_ADD);
    g_tex_hud = atlas_upload(p_win, g_atlas_hud, BLEND_BLEND);
    g_tex_sky = skygen_build(p_win);
}

